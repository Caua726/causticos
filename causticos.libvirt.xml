<domain type='qemu'>
  <name>causticos</name>
  <memory unit='MiB'>128</memory>
  <currentMemory unit='MiB'>128</currentMemory>
  <vcpu>1</vcpu>
  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <boot dev='cdrom'/>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <clock offset='utc'/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>destroy</on_reboot>
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>
    <!-- FAT32 root disk on SATA port 0 — the kernel's AHCI driver uses the first
         live port, so the disk MUST be port 0 (the CD on a higher port). -->
    <disk type='file' device='disk'>
      <driver name='qemu' type='raw'/>
      <source file='/home/caua/Documentos/Projetos-Pessoais/causticos/build/disk.img'/>
      <target dev='sda' bus='sata'/>
      <address type='drive' controller='0' bus='0' target='0' unit='0'/>
    </disk>
    <!-- boot ISO (Limine) on SATA port 1 — the firmware boots it regardless of
         port; the kernel ignores it (ATAPI on a non-first port). -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/home/caua/Documentos/Projetos-Pessoais/causticos/build/causticos.iso'/>
      <target dev='sdb' bus='sata'/>
      <address type='drive' controller='0' bus='0' target='0' unit='1'/>
      <readonly/>
    </disk>
    <interface type='user'>
      <model type='e1000'/>
    </interface>
    <serial type='pty'><target port='0'/></serial>
    <console type='pty'><target type='serial' port='0'/></console>
    <input type='keyboard' bus='ps2'/>
    <graphics type='spice' autoport='yes'>
      <listen type='none'/>
      <gl enable='no'/>
    </graphics>
    <video><model type='vga' vram='16384'/></video>
  </devices>
</domain>
