<domain type='qemu'>
  <name>causticos</name>
  <!-- 512 MiB: the live root is a 64 MiB RAM volume expanded from the ISO's
       CSVI module, and it is the largest single allocation of the boot. A
       128 MiB guest fails inside ramvol.init with the byte counts on serial. -->
  <memory unit='MiB'>512</memory>
  <currentMemory unit='MiB'>512</currentMemory>
  <vcpu>2</vcpu>
  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <boot dev='cdrom'/>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <clock offset='utc'/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>destroy</on_reboot>
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>
    <!-- OPTIONAL. The ISO below carries its own root, so this VM boots a
         complete desktop with no disk at all — delete this block and it still
         works. Keep it to exercise the AHCI driver and persistent writes: the
         live root outranks a disk (PRIO_LIVE_ROOT beats PRIO_DISK), so with
         both present the system still boots live and this is just a second
         volume the kernel saw. To boot FROM it, build the ISO with
         `caustic-mk run iso -- --no-live`.

         Create it with:
           python3 scripts/mkroot.py --profile desktop --img build/disk.img

         SATA port 0 by convention — the AHCI driver takes the first live port. -->
    <disk type='file' device='disk'>
      <driver name='qemu' type='raw'/>
      <source file='/home/caua/Documentos/Projetos-Pessoais/causticos/build/disk.img'/>
      <target dev='sda' bus='sata'/>
      <address type='drive' controller='0' bus='0' target='0' unit='0'/>
    </disk>
    <!-- boot ISO (Limine) on SATA port 1 — the firmware boots it regardless of
         port; the kernel ignores it (ATAPI on a non-first port). -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/home/caua/Documentos/Projetos-Pessoais/causticos/build/causticos.iso'/>
      <target dev='sdb' bus='sata'/>
      <address type='drive' controller='0' bus='0' target='0' unit='1'/>
      <readonly/>
    </disk>
    <interface type='user'>
      <model type='e1000'/>
    </interface>
    <serial type='pty'><target port='0'/></serial>
    <console type='pty'><target type='serial' port='0'/></console>
    <input type='keyboard' bus='ps2'/>
    <graphics type='spice' autoport='yes'>
      <listen type='none'/>
      <gl enable='no'/>
    </graphics>
    <video><model type='vga' vram='16384'/></video>
  </devices>
</domain>
