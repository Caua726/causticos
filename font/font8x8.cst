// font8x8.cst — the kernel's 8x8 font: printable ASCII, MSB = leftmost pixel.
//
// Generated by scripts/gen-font8x8.py from the IBM VGA 8x8 console font; do
// not edit by hand. 0x20..0x7E are the ASCII glyphs; every other byte draws
// the hollow box in slot 0x7F, so a stray control or UTF-8 byte in a log line
// shows up as a box instead of reading past the table.

let is [1024]u8 as font8x8_data;

let is i64 as GLYPH_FIRST = 0x20;
let is i64 as GLYPH_LAST = 0x7E;
let is i64 as GLYPH_BOX = 0x7F;

fn set8(off as i64, b0 as i64, b1 as i64, b2 as i64, b3 as i64, b4 as i64, b5 as i64, b6 as i64, b7 as i64) as void {
    font8x8_data[off + 0] = cast(u8, b0);
    font8x8_data[off + 1] = cast(u8, b1);
    font8x8_data[off + 2] = cast(u8, b2);
    font8x8_data[off + 3] = cast(u8, b3);
    font8x8_data[off + 4] = cast(u8, b4);
    font8x8_data[off + 5] = cast(u8, b5);
    font8x8_data[off + 6] = cast(u8, b6);
    font8x8_data[off + 7] = cast(u8, b7);
}

