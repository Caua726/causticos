fn get_glyph(ch as i32) as *u8 {
    let is i64 as c with mut = cast(i64, ch) & 0xFF;
    if (c < GLYPH_FIRST || c > GLYPH_LAST) { c = GLYPH_BOX; }
    return cast(*u8, cast(i64, &font8x8_data) + c * 8);
}
