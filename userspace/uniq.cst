// uniq — collapse adjacent matching lines. uniq [-c] [-d] [-u] [-i] [file].
// -c prefix the repeat count, -d only print duplicated lines, -u only print
// unique lines, -i ignore case. One input (a file or stdin) → stdout.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

let is i64 as g_fl with mut = 0;   // bit0 c, bit1 d, bit2 u, bit3 i

fn eq(a as *u8, alen as i64, b as *u8, blen as i64, ci as i64) as i64 {
    if (alen != blen) { return 0; }
    let is i64 as i with mut = 0;
    while (i < alen) {
        let is i64 as ca with mut = cast(i64, a[i]);
        let is i64 as cb with mut = cast(i64, b[i]);
        if (ci == 1) {
            if (ca >= 65 && ca <= 90) { ca = ca + 32; }
            if (cb >= 65 && cb <= 90) { cb = cb + 32; }
        }
        if (ca != cb) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn flush(line as *u8, len as i64, count as i64) as void {
    let is i64 as cflag = g_fl & 1;
    let is i64 as dflag = (g_fl >> 1) & 1;
    let is i64 as uflag = (g_fl >> 2) & 1;
    let is i64 as showit with mut = 1;
    if (dflag == 1 && count < 2) { showit = 0; }
    if (uflag == 1 && count > 1) { showit = 0; }
    if (showit == 1) {
        if (cflag == 1) { prog.pad_num(count, 7); prog.outs(" "); }
        prog.out(line, len); prog.out("\n", 1);
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "cdui");
        if (f < 0) { break; }
        if (f == 99) { g_fl = g_fl | 1; }
        else if (f == 100) { g_fl = g_fl | 2; }
        else if (f == 117) { g_fl = g_fl | 4; }
        else if (f == 105) { g_fl = g_fl | 8; }
        else { prog.outs("usage: uniq [-cdui] [file]\n"); return cast(i32, 1); }
    }
    let is i64 as ci = (g_fl >> 3) & 1;
    let is [4096]u8 as iobuf;
    let is fu.Reader as r;
    if (argc - o.ind <= 0) {
        fu.rd_open_fd(&r, cast(i64, 0), cast(*u8, &iobuf[0]), 4096);
    } else {
        let is *u8 as name = prog.arg(argv, o.ind);
        let is [256]u8 as pb;
        let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        if (fu.rd_open(&r, path, cast(*u8, &iobuf[0]), 4096) < 0) {
            prog.outs("uniq: "); prog.outs(name); prog.outs(": cannot open\n"); return cast(i32, 1);
        }
    }
    let is [65536]u8 as prev;
    let is [65536]u8 as cur;
    let is i64 as plen with mut = 0 - 1;
    let is i64 as cl with mut = 0;
    let is i64 as count with mut = 0;
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(&r);
        if (c < 0 || c == 0x0A) {
            if (c == 0x0A || cl > 0) {
                if (plen < 0) {
                    let is i64 as k with mut = 0; while (k < cl) { prev[k] = cur[k]; k = k + 1; }
                    plen = cl; count = 1;
                } else if (eq(cast(*u8, &cur[0]), cl, cast(*u8, &prev[0]), plen, ci) == 1) {
                    count = count + 1;
                } else {
                    flush(cast(*u8, &prev[0]), plen, count);
                    let is i64 as k with mut = 0; while (k < cl) { prev[k] = cur[k]; k = k + 1; }
                    plen = cl; count = 1;
                }
            }
            cl = 0;
            if (c < 0) { break; }
        } else { if (cl < 65536) { cur[cl] = cast(u8, c); cl = cl + 1; } }
    }
    if (plen >= 0) { flush(cast(*u8, &prev[0]), plen, count); }
    return 0;
}
