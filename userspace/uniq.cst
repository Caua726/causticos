// uniq — collapse adjacent identical lines. `uniq <file>`.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 2) { prog.outs("usage: uniq <file>\n"); return cast(i32, 1); }
    let is [256]u8 as pb;
    let is *u8 as path = prog.abspath(prog.arg(argv, 1), cast(*u8, &pb[0]));
    let is [4096]u8 as iobuf;
    let is fu.Reader as r;
    if (fu.rd_open(&r, path, cast(*u8, &iobuf[0]), 4096) < 0) {
        prog.outs("uniq: cannot open "); prog.outs(path); prog.out("\n", 1);
        return cast(i32, 1);
    }
    let is [8192]u8 as cur;
    let is [8192]u8 as prev;
    let is i64 as cl with mut = 0;
    let is i64 as pl with mut = 0;
    let is i64 as have_prev with mut = 0;
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(&r);
        if (c < 0 || c == 0x0A) {
            if (c == 0x0A || cl > 0) {
                let is i64 as same with mut = 0;
                if (have_prev == 1 && cl == pl) {
                    same = 1;
                    let is i64 as k with mut = 0;
                    while (k < cl) { if (cur[k] != prev[k]) { same = 0; break; } k = k + 1; }
                }
                if (same == 0) {
                    prog.out(cast(*u8, &cur[0]), cl); prog.out("\n", 1);
                    let is i64 as k2 with mut = 0;
                    while (k2 < cl) { prev[k2] = cur[k2]; k2 = k2 + 1; }
                    pl = cl;
                    have_prev = 1;
                }
            }
            cl = 0;
            if (c < 0) { break; }
        } else {
            if (cl < 8192) { cur[cl] = cast(u8, c); cl = cl + 1; }
        }
    }
    fu.rd_close(&r);
    return 0;
}
