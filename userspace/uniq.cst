// uniq — collapse adjacent matching lines.
//   uniq [-c] [-d] [-D] [-u] [-i] [-f N] [-s N] [-w N] [file]
// -c prefix repeat count   -d only duplicated (one per group)   -D all duplicated
// -u only unique           -i ignore case
// -f N skip the first N fields   -s N skip N chars (after fields)   -w N compare N chars
// One input (a file or stdin) -> stdout.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

let is i64 as g_c with mut = 0; let is i64 as g_d with mut = 0; let is i64 as g_D with mut = 0;
let is i64 as g_u with mut = 0; let is i64 as g_i with mut = 0;
let is i64 as g_f with mut = 0; let is i64 as g_s with mut = 0; let is i64 as g_w with mut = 0 - 1;
let is i64 as g_base with mut = 0;

fn is_blank(c as i64) as i64 { if (c == 32 || c == 9) { return 1; } return 0; }
fn lc(c as i64) as i64 { if (c >= 65 && c <= 90) { return c + 32; } return c; }

// start offset of the comparison key within line [lo,lo+ll): skip g_f fields then g_s chars.
fn key_start(lo as i64, ll as i64) as i64 {
    let is *u8 as p = cast(*u8, g_base);
    let is i64 as pos with mut = 0;
    let is i64 as f with mut = 0;
    while (f < g_f && pos < ll) {
        while (pos < ll && is_blank(cast(i64, p[lo + pos])) != 0) { pos = pos + 1; }
        while (pos < ll && is_blank(cast(i64, p[lo + pos])) == 0) { pos = pos + 1; }
        f = f + 1;
    }
    let is i64 as k with mut = 0;
    while (k < g_s && pos < ll) { pos = pos + 1; k = k + 1; }
    return pos;
}

// are lines a and b equal under the active field/char/case rules?
fn key_eq(ao as i64, al as i64, bo as i64, bl as i64) as i64 {
    let is *u8 as p = cast(*u8, g_base);
    let is i64 as as0 = key_start(ao, al); let is i64 as bs0 = key_start(bo, bl);
    let is i64 as ae with mut = al; let is i64 as be with mut = bl;
    if (g_w >= 0) { if (as0 + g_w < ae) { ae = as0 + g_w; } if (bs0 + g_w < be) { be = bs0 + g_w; } }
    let is i64 as ai with mut = as0; let is i64 as bi with mut = bs0;
    while (ai < ae && bi < be) {
        let is i64 as ca with mut = cast(i64, p[ao + ai]); let is i64 as cb with mut = cast(i64, p[bo + bi]);
        if (g_i != 0) { ca = lc(ca); cb = lc(cb); }
        if (ca != cb) { return 0; }
        ai = ai + 1; bi = bi + 1;
    }
    if ((ae - ai) != (be - bi)) { return 0; }
    return 1;
}

fn put_line(lo as i64, ll as i64) as void { prog.out(cast(*u8, g_base + lo), ll); prog.out("\n", 1); }

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "cdDuif:s:w:");
        if (f < 0) { break; }
        if (f == 99) { g_c = 1; } else if (f == 100) { g_d = 1; } else if (f == 68) { g_D = 1; }
        else if (f == 117) { g_u = 1; } else if (f == 105) { g_i = 1; }
        else if (f == 102) { g_f = fu.parse_uint(cast(*u8, o.optarg), 19); }
        else if (f == 115) { g_s = fu.parse_uint(cast(*u8, o.optarg), 19); }
        else if (f == 119) { g_w = fu.parse_uint(cast(*u8, o.optarg), 19); }
        else { prog.outs("usage: uniq [-cdDui] [-f N] [-s N] [-w N] [file]\n"); return cast(i32, 1); }
    }

    let is i64 as len with mut = 0;
    let is i64 as buf with mut = 0;
    if (argc - o.ind <= 0) { buf = fu.slurp_fd(cast(i64, 0), &len); }
    else {
        let is *u8 as name = prog.arg(argv, o.ind);
        let is [256]u8 as pb; let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        buf = fu.slurp(path, &len);
        if (len < 0) { prog.outs("uniq: "); prog.outs(name); prog.outs(": cannot open\n"); return cast(i32, 1); }
    }
    g_base = buf;
    if (len <= 0) { return 0; }
    let is *u8 as p = cast(*u8, buf);

    // index lines
    let is i64 as nl with mut = 0; let is i64 as t with mut = 0;
    while (t < len) { if (cast(i64, p[t]) == 0x0A) { nl = nl + 1; } t = t + 1; }
    if (cast(i64, p[len - 1]) != 0x0A) { nl = nl + 1; }
    let is i64 as isz = fu.page_round(nl * 16);
    let is i64 as iva = sys.mmap(cast(i64, 0), isz, sys.PROT_READ | sys.PROT_WRITE);
    if (iva < 0) { prog.outs("uniq: out of memory\n"); return cast(i32, 1); }
    let is *i64 as idx = cast(*i64, iva);
    let is i64 as li with mut = 0; let is i64 as start with mut = 0;
    t = 0;
    while (t < len) { if (cast(i64, p[t]) == 0x0A) { idx[li * 2] = start; idx[li * 2 + 1] = t - start; li = li + 1; start = t + 1; } t = t + 1; }
    if (start < len) { idx[li * 2] = start; idx[li * 2 + 1] = len - start; li = li + 1; }

    // walk groups of adjacent equal lines
    let is i64 as i with mut = 0;
    while (i < li) {
        let is i64 as j with mut = i + 1;
        while (j < li && key_eq(idx[i * 2], idx[i * 2 + 1], idx[j * 2], idx[j * 2 + 1]) != 0) { j = j + 1; }
        let is i64 as cnt = j - i;
        if (g_D != 0) {
            if (cnt > 1) { let is i64 as k with mut = i; while (k < j) { put_line(idx[k * 2], idx[k * 2 + 1]); k = k + 1; } }
        } else {
            let is i64 as show with mut = 1;
            if (g_d != 0 && cnt < 2) { show = 0; }
            if (g_u != 0 && cnt > 1) { show = 0; }
            if (show != 0) {
                if (g_c != 0) { prog.pad_num(cnt, 7); prog.outs(" "); }
                put_line(idx[i * 2], idx[i * 2 + 1]);
            }
        }
        i = j;
    }
    return 0;
}
