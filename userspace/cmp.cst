// cmp — compare two files byte by byte. cmp [-s] [-l] file1 file2.
// -s silent (exit status only), -l list every differing byte (decimal offset +
// the two octal values). Default reports the first difference. Exit 0 if
// identical, 1 if they differ, 2 on error.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn print_octal(v as i64) as void {
    if (v == 0) { prog.outs("0"); return; }
    let is [24]u8 as b;
    let is i64 as n with mut = 0;
    let is i64 as t with mut = v;
    while (t > 0) { b[n] = cast(u8, 48 + (t & 7)); n = n + 1; t = t / 8; }
    while (n > 0) { n = n - 1; prog.out(cast(*u8, &b[n]), 1); }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as sflag with mut = 0;
    let is i64 as lflag with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "sl");
        if (f < 0) { break; }
        if (f == 115) { sflag = 1; }
        else if (f == 108) { lflag = 1; }
        else { prog.outs("usage: cmp [-s] [-l] file1 file2\n"); return cast(i32, 2); }
    }
    if (argc - o.ind < 2) { prog.outs("usage: cmp [-s] [-l] file1 file2\n"); return cast(i32, 2); }
    let is *u8 as na = prog.arg(argv, o.ind);
    let is *u8 as nb = prog.arg(argv, o.ind + 1);
    let is [256]u8 as pa; let is [256]u8 as pbf;
    let is *u8 as pathA = prog.abspath(na, cast(*u8, &pa[0]));
    let is *u8 as pathB = prog.abspath(nb, cast(*u8, &pbf[0]));
    let is [4096]u8 as bufa; let is [4096]u8 as bufb;
    let is fu.Reader as ra; let is fu.Reader as rb;
    if (fu.rd_open(&ra, pathA, cast(*u8, &bufa[0]), 4096) < 0) {
        if (sflag == 0) { prog.outs("cmp: "); prog.outs(na); prog.outs(": cannot open\n"); } return cast(i32, 2);
    }
    if (fu.rd_open(&rb, pathB, cast(*u8, &bufb[0]), 4096) < 0) {
        if (sflag == 0) { prog.outs("cmp: "); prog.outs(nb); prog.outs(": cannot open\n"); }
        fu.rd_close(&ra); return cast(i32, 2);
    }
    let is i64 as pos with mut = 0;
    let is i64 as line with mut = 1;
    let is i32 as rc with mut = 0;
    while (1 == 1) {
        let is i64 as ca = fu.rd_byte(&ra);
        let is i64 as cb = fu.rd_byte(&rb);
        if (ca < 0 && cb < 0) { break; }
        pos = pos + 1;
        if (ca < 0) { if (sflag == 0) { prog.outs("cmp: EOF on "); prog.outs(na); prog.out("\n", 1); } rc = cast(i32, 1); break; }
        if (cb < 0) { if (sflag == 0) { prog.outs("cmp: EOF on "); prog.outs(nb); prog.out("\n", 1); } rc = cast(i32, 1); break; }
        if (ca != cb) {
            rc = cast(i32, 1);
            if (lflag == 1) {
                prog.pad_num(pos, 7); prog.outs(" "); print_octal(ca); prog.outs(" "); print_octal(cb); prog.out("\n", 1);
            } else {
                if (sflag == 0) {
                    prog.outs(na); prog.outs(" "); prog.outs(nb); prog.outs(" differ: byte ");
                    prog.out_num(pos); prog.outs(", line "); prog.out_num(line); prog.out("\n", 1);
                }
                break;
            }
        }
        if (ca == 0x0A) { line = line + 1; }
    }
    fu.rd_close(&ra); fu.rd_close(&rb);
    return rc;
}
