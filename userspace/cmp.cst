// cmp — compare two files byte by byte. `cmp <a> <b>`. Silent + exit 0 if
// identical; reports the first differing byte/line + exit 1 otherwise.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 3) { prog.outs("usage: cmp <a> <b>\n"); return cast(i32, 1); }
    let is [256]u8 as pa; let is [256]u8 as pbf;
    let is *u8 as na = prog.abspath(prog.arg(argv, 1), cast(*u8, &pa[0]));
    let is *u8 as nb = prog.abspath(prog.arg(argv, 2), cast(*u8, &pbf[0]));
    let is [4096]u8 as bufa; let is [4096]u8 as bufb;
    let is fu.Reader as ra; let is fu.Reader as rb;
    if (fu.rd_open(&ra, na, cast(*u8, &bufa[0]), 4096) < 0) {
        prog.outs("cmp: cannot open "); prog.outs(na); prog.out("\n", 1); return cast(i32, 1);
    }
    if (fu.rd_open(&rb, nb, cast(*u8, &bufb[0]), 4096) < 0) {
        prog.outs("cmp: cannot open "); prog.outs(nb); prog.out("\n", 1);
        fu.rd_close(&ra); return cast(i32, 1);
    }
    let is i64 as pos with mut = 0;
    let is i64 as line with mut = 1;
    let is i32 as rc with mut = 0;
    while (1 == 1) {
        let is i64 as ca = fu.rd_byte(&ra);
        let is i64 as cb = fu.rd_byte(&rb);
        if (ca < 0 && cb < 0) { break; }                      // identical
        pos = pos + 1;
        if (ca < 0) { prog.outs("cmp: EOF on "); prog.outs(na); prog.out("\n", 1); rc = cast(i32, 1); break; }
        if (cb < 0) { prog.outs("cmp: EOF on "); prog.outs(nb); prog.out("\n", 1); rc = cast(i32, 1); break; }
        if (ca != cb) {
            prog.outs(na); prog.outs(" "); prog.outs(nb);
            prog.outs(" differ: byte "); prog.out_num(pos);
            prog.outs(", line "); prog.out_num(line); prog.out("\n", 1);
            rc = cast(i32, 1); break;
        }
        if (ca == 0x0A) { line = line + 1; }
    }
    fu.rd_close(&ra); fu.rd_close(&rb);
    return rc;
}
