// make — a small build driver reading a Causticfile. `make [-f file] [target]`.
// Lines are either
//   VAR = value                 (a variable; $(VAR) expands anywhere after)
//   target: dep1 dep2 ...        (a rule)
// A target ending in .cse is built by compiling its first .cst prerequisite
// through the embedded /caustic.cse; any other target is a phony aggregator
// (it just builds its prerequisites, like the conventional `all:`). `make`
// with no target builds the first rule; `make foo` builds the rule for foo.
// Dependencies are built first, depth-first, each at most once. Comments start
// with '#'. There is no mtime tracking yet, so a reachable target is always
// rebuilt — stated plainly rather than faked.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/futil.cst" as fu;

let is i64 as MAXV with mut = 16;
let is i64 as MAXR with mut = 24;
let is i64 as MAXD with mut = 6;

let is [512]u8 as G_VN;     // var names   (MAXV * 32)
let is [1536]u8 as G_VV;    // var values  (MAXV * 96)
let is i64 as G_NV with mut = 0;

let is [1920]u8 as G_TG;    // rule targets (MAXR * 80)
let is [11520]u8 as G_DEP;  // rule deps    (MAXR * MAXD * 80)
let is [24]i64 as G_ND;     // deps per rule
let is [24]i64 as G_BUILT;
let is i64 as G_NR with mut = 0;

let is i64 as G_CIMG with mut = 0;
let is i64 as G_CLEN with mut = 0;
let is i64 as G_OK with mut = 0;
let is i64 as G_FAIL with mut = 0;

fn vn_ptr(i as i64) as *u8 { return cast(*u8, &G_VN[i * 32]); }
fn vv_ptr(i as i64) as *u8 { return cast(*u8, &G_VV[i * 96]); }
fn tg_ptr(r as i64) as *u8 { return cast(*u8, &G_TG[r * 80]); }
fn dep_ptr(r as i64, d as i64) as *u8 { return cast(*u8, &G_DEP[(r * 6 + d) * 80]); }

fn streq(a as *u8, b as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (cast(i64, a[i]) != 0 && cast(i64, b[i]) != 0) { if (cast(i64, a[i]) != cast(i64, b[i])) { return 0; } i = i + 1; }
    if (cast(i64, a[i]) == cast(i64, b[i])) { return 1; }
    return 0;
}
fn ends_with(s as *u8, suf as *u8) as i64 {
    let is i64 as sl = prog.slen(s); let is i64 as fl = prog.slen(suf);
    if (fl > sl) { return 0; }
    let is i64 as i with mut = 0;
    while (i < fl) { if (cast(i64, s[sl - fl + i]) != cast(i64, suf[i])) { return 0; } i = i + 1; }
    return 1;
}
fn find_var(name as *u8) as i64 { let is i64 as i with mut = 0; while (i < G_NV) { if (streq(vn_ptr(i), name) != 0) { return i; } i = i + 1; } return 0 - 1; }
fn find_rule(name as *u8) as i64 { let is i64 as i with mut = 0; while (i < G_NR) { if (streq(tg_ptr(i), name) != 0) { return i; } i = i + 1; } return 0 - 1; }

// expand text[a,b) into dst, substituting $(VAR); trims surrounding blanks.
fn expand(text as *u8, a as i64, b as i64, dst as *u8) as i64 {
    let is i64 as s with mut = a; let is i64 as e with mut = b;
    while (s < e) { let is i64 as c = cast(i64, text[s]); if (c == 32 || c == 9) { s = s + 1; } else { break; } }
    while (e > s) { let is i64 as c = cast(i64, text[e - 1]); if (c == 32 || c == 9 || c == 13) { e = e - 1; } else { break; } }
    let is i64 as n with mut = 0;
    let is i64 as i with mut = s;
    while (i < e && n < 78) {
        if (cast(i64, text[i]) == 36 && i + 1 < e && cast(i64, text[i + 1]) == 40) {   // $(
            i = i + 2;
            let is [32]u8 as nm; let is i64 as nl with mut = 0;
            while (i < e && cast(i64, text[i]) != 41 && nl < 31) { nm[nl] = text[i]; nl = nl + 1; i = i + 1; }
            nm[nl] = cast(u8, 0);
            if (i < e && cast(i64, text[i]) == 41) { i = i + 1; }
            let is i64 as vi = find_var(cast(*u8, &nm[0]));
            if (vi >= 0) { let is *u8 as vv = vv_ptr(vi); let is i64 as k with mut = 0; while (cast(i64, vv[k]) != 0 && n < 78) { dst[n] = vv[k]; n = n + 1; k = k + 1; } }
        } else { dst[n] = text[i]; n = n + 1; i = i + 1; }
    }
    dst[n] = cast(u8, 0);
    return n;
}

fn compile_one(src as *u8, out as *u8) as i64 {
    prog.outs("make: cc "); prog.outs(src); prog.outs(" -> "); prog.outs(out); prog.out("\n", 1);
    let is [10]i64 as av;
    av[0] = cast(i64, "caustic");                 av[1] = 7;
    av[2] = cast(i64, src);                       av[3] = prog.slen(src);
    av[4] = cast(i64, "-o");                      av[5] = 2;
    av[6] = cast(i64, out);                       av[7] = prog.slen(out);
    av[8] = cast(i64, "--target=caustic-x86_64"); av[9] = 23;
    let is [2]i64 as fda; fda[0] = 1; fda[1] = 1;
    let is i64 as pid = sys.spawn(cast(*u8, G_CIMG), G_CLEN, cast(*u8, &fda[0]), 1, cast(*u8, &av[0]), 5);
    if (pid < 0) { prog.outs("make: spawn failed\n"); return 1; }
    let is [1]i64 as st; let is i64 as r with mut = 0 - 8;
    while (r == (0 - 8)) { r = sys.wait(pid, cast(*i64, &st[0])); }
    if (r != 0) { prog.outs("make: target failed (exit "); prog.out_num(r); prog.outs(")\n"); return 1; }
    return 0;
}

// build `name`; returns 0 on success, 1 on failure. depth-first, once each.
fn build(name as *u8) as i64 {
    let is i64 as ri = find_rule(name);
    if (ri < 0) { return 0; }                      // a leaf (source file); assume present
    if (G_BUILT[ri] != 0) { return 0; }
    G_BUILT[ri] = 1;
    let is i64 as d with mut = 0;
    while (d < G_ND[ri]) {
        if (build(dep_ptr(ri, d)) != 0) { return 1; }
        d = d + 1;
    }
    let is *u8 as tgt = tg_ptr(ri);
    if (ends_with(tgt, ".cse") != 0) {
        let is *u8 as src with mut = cast(*u8, 0);
        d = 0; while (d < G_ND[ri]) { if (ends_with(dep_ptr(ri, d), ".cst") != 0) { src = dep_ptr(ri, d); break; } d = d + 1; }
        if (cast(i64, src) == 0) { prog.outs("make: no .cst prerequisite for "); prog.outs(tgt); prog.out("\n", 1); G_FAIL = G_FAIL + 1; return 1; }
        if (compile_one(src, tgt) != 0) { G_FAIL = G_FAIL + 1; return 1; }
        G_OK = G_OK + 1;
    }
    return 0;
}

fn main(argc as i64, argv as *u8) as i32 {
    let is [256]u8 as pb;
    let is *u8 as cfile with mut = "/Causticfile";
    let is *u8 as goal with mut = cast(*u8, 0);
    let is i64 as i with mut = 1;
    while (i < argc) {
        let is *u8 as a = prog.arg(argv, i);
        if (cast(i64, a[0]) == 45 && cast(i64, a[1]) == 102) {        // -f
            i = i + 1; if (i < argc) { cfile = prog.abspath(prog.arg(argv, i), cast(*u8, &pb[0])); }
        } else { goal = a; }
        i = i + 1;
    }

    let is i64 as tlen with mut = 0;
    let is i64 as tbase = fu.slurp(cfile, &tlen);
    if (tlen <= 0) { prog.outs("make: cannot read "); prog.outs(cfile); prog.out("\n", 1); return cast(i32, 1); }
    let is *u8 as text = cast(*u8, tbase);

    // ---- parse into vars + rules ----
    let is i64 as ls with mut = 0;
    let is i64 as q with mut = 0;
    while (q <= tlen) {
        if (q == tlen || cast(i64, text[q]) == 0x0A) {
            // line text[ls, q); find first non-blank
            let is i64 as f with mut = ls;
            while (f < q) { let is i64 as c = cast(i64, text[f]); if (c == 32 || c == 9) { f = f + 1; } else { break; } }
            if (f < q && cast(i64, text[f]) != 35) {
                let is i64 as colon with mut = 0 - 1; let is i64 as eq with mut = 0 - 1;
                let is i64 as k with mut = f;
                while (k < q) { let is i64 as c = cast(i64, text[k]); if (c == 58 && colon < 0) { colon = k; } if (c == 61 && eq < 0) { eq = k; } k = k + 1; }
                if (eq >= 0 && (colon < 0 || eq < colon)) {
                    // variable
                    if (G_NV < MAXV) {
                        expand(text, f, eq, vn_ptr(G_NV));            // name (no $ expected, but harmless)
                        expand(text, eq + 1, q, vv_ptr(G_NV));
                        G_NV = G_NV + 1;
                    }
                } else if (colon >= 0) {
                    // rule
                    if (G_NR < MAXR) {
                        expand(text, f, colon, tg_ptr(G_NR));
                        // deps: split [colon+1, q) on spaces/tabs
                        let is i64 as nd with mut = 0;
                        let is i64 as t with mut = colon + 1;
                        while (t < q && nd < MAXD) {
                            while (t < q) { let is i64 as c = cast(i64, text[t]); if (c == 32 || c == 9 || c == 13) { t = t + 1; } else { break; } }
                            if (t >= q) { break; }
                            let is i64 as ds = t;
                            while (t < q) { let is i64 as c = cast(i64, text[t]); if (c == 32 || c == 9 || c == 13) { break; } t = t + 1; }
                            expand(text, ds, t, dep_ptr(G_NR, nd));
                            nd = nd + 1;
                        }
                        G_ND[G_NR] = nd;
                        G_BUILT[G_NR] = 0;
                        G_NR = G_NR + 1;
                    }
                }
            }
            ls = q + 1;
        }
        q = q + 1;
    }

    if (G_NR == 0) { prog.outs("make: no rules in "); prog.outs(cfile); prog.out("\n", 1); fu.unslurp(tbase, tlen); return cast(i32, 1); }

    G_CIMG = fu.slurp("/caustic.cse", &G_CLEN);
    if (G_CLEN <= 0) { prog.outs("make: /caustic.cse not on disk\n"); fu.unslurp(tbase, tlen); return cast(i32, 1); }

    if (cast(i64, goal) == 0) { goal = tg_ptr(0); }
    if (find_rule(goal) < 0) { prog.outs("make: no rule to make target '"); prog.outs(goal); prog.outs("'\n"); fu.unslurp(G_CIMG, G_CLEN); fu.unslurp(tbase, tlen); return cast(i32, 1); }

    build(goal);

    fu.unslurp(G_CIMG, G_CLEN);
    fu.unslurp(tbase, tlen);
    prog.outs("make: "); prog.out_num(G_OK); prog.outs(" built, "); prog.out_num(G_FAIL); prog.outs(" failed\n");
    if (G_FAIL > 0) { return cast(i32, 1); }
    return 0;
}
