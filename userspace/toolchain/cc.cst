// cc — compile a .cst to a .cse. cc [flags...] <file.cst> [-o <out.cse>].
// Targets caustic-x86_64; the output defaults to the source with .cst -> .cse.
// Any other flags (e.g. -q) are passed through to the embedded /caustic.cse.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;
use "../lib/crash/crash.cst" as crash;

fn main(argc as i64, argv as *u8) as i32 {
    let is *u8 as src with mut = cast(*u8, 0);
    let is *u8 as outarg with mut = cast(*u8, 0);
    let is [32]i64 as extra;
    let is i64 as nextra with mut = 0;
    let is i64 as i with mut = 1;
    while (i < argc) {
        let is *u8 as a = prog.arg(argv, i);
        if (cast(i64, a[0]) == 45 && cast(i64, a[1]) == 111 && cast(i64, a[2]) == 0) {       // -o
            i = i + 1; if (i < argc) { outarg = prog.arg(argv, i); }
        } else if (cast(i64, a[0]) == 45) {                                                 // other flag → pass through
            if (nextra < 32) { extra[nextra] = i; nextra = nextra + 1; }
        } else { src = a; }
        i = i + 1;
    }
    if (cast(i64, src) == 0) { prog.errs("usage: cc [flags] <file.cst> [-o <out.cse>]\n"); return cast(i32, 1); }

    let is [256]u8 as pb;
    let is *u8 as srcpath = prog.abspath(src, cast(*u8, &pb[0]));
    let is [256]u8 as ob;
    let is *u8 as out with mut = cast(*u8, 0);
    if (cast(i64, outarg) != 0) { out = prog.abspath(outarg, cast(*u8, &ob[0])); }
    else {
        let is i64 as sl = prog.slen(srcpath);
        let is i64 as k with mut = 0; while (k < sl) { ob[k] = srcpath[k]; k = k + 1; }
        if (sl >= 4 && cast(i64, ob[sl - 1]) == 116 && cast(i64, ob[sl - 2]) == 115 && cast(i64, ob[sl - 3]) == 99 && cast(i64, ob[sl - 4]) == 46) {
            ob[sl - 1] = cast(u8, 101); ob[sl] = cast(u8, 0);
        } else { ob[sl] = cast(u8, 46); ob[sl + 1] = cast(u8, 99); ob[sl + 2] = cast(u8, 115); ob[sl + 3] = cast(u8, 101); ob[sl + 4] = cast(u8, 0); }
        out = cast(*u8, &ob[0]);
    }

    let is [4]i64 as cst;
    if (sys.stat(cast(*u8, "/caustic.cse"), cast(*u8, &cst[0])) != 0 || cst[0] <= 0) {
        prog.errs("cc: /caustic.cse not on disk (no compiler)\n"); return cast(i32, 1);
    }

    let is [48]i64 as av;
    let is i64 as ac with mut = 0;
    av[ac * 2] = cast(i64, "caustic"); av[ac * 2 + 1] = 7; ac = ac + 1;
    av[ac * 2] = cast(i64, srcpath); av[ac * 2 + 1] = prog.slen(srcpath); ac = ac + 1;
    av[ac * 2] = cast(i64, "-o"); av[ac * 2 + 1] = 2; ac = ac + 1;
    av[ac * 2] = cast(i64, out); av[ac * 2 + 1] = prog.slen(out); ac = ac + 1;
    av[ac * 2] = cast(i64, "--target=caustic-x86_64"); av[ac * 2 + 1] = 23; ac = ac + 1;
    let is i64 as e with mut = 0;
    while (e < nextra && ac < 24) {
        let is *u8 as fa = prog.arg(argv, extra[e]);
        av[ac * 2] = cast(i64, fa); av[ac * 2 + 1] = prog.slen(fa); ac = ac + 1;
        e = e + 1;
    }
    // The compiler's output on our stdout, its errors on our stderr.
    let is [4]i64 as fda;
    fda[0] = 1; fda[1] = 1;
    fda[2] = 2; fda[3] = 2;
    prog.outs("cc: "); prog.outs(srcpath); prog.outs(" -> "); prog.outs(out); prog.out("\n", 1);
    let is i64 as pid = sys.spawn_path(cast(*u8, "/caustic.cse"), cast(*u8, &fda[0]), 2, cast(*u8, &av[0]), ac);
    if (pid < 0) {
        prog.errs("cc: cannot start /caustic.cse: "); prog.errs(sys.err_text(pid)); prog.errs("\n");
        return cast(i32, 1);
    }
    let is i64 as r = crash.wait(pid);
    if (r == 0) { prog.outs("cc: ok\n"); return 0; }
    prog.errs("cc: failed (exit "); prog.err_num(r); prog.errs(")\n");
    return cast(i32, 1);
}
