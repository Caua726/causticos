// run — compile a .cst and execute it, in one command. `run <file.cst>`.
// Spawns the embedded /caustic.cse to compile the source to a temp .cse, then
// spawns the result wired to this terminal. The bridge from "source on disk" to
// "running program" — the showcase of an OS that ships its own compiler.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;
use "../lib/crash/crash.cst" as crash;

// wait for a child to really exit (SYS_WAIT returns E_AGAIN while it runs),
// saying so here if it crashed — the shell only sees `run` itself end.
fn wait_done(pid as i64) as i64 {
    return crash.wait(pid);
}

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 2) { prog.errs("usage: run <file.cst>\n"); return cast(i32, 1); }
    let is [256]u8 as pb;
    let is *u8 as src = prog.abspath(prog.arg(argv, 1), cast(*u8, &pb[0]));

    let is [4]i64 as cst;
    if (sys.stat(cast(*u8, "/caustic.cse"), cast(*u8, &cst[0])) != 0 || cst[0] <= 0) {
        prog.errs("run: /caustic.cse not on disk (no compiler)\n"); return cast(i32, 1);
    }

    // compile src -> /run.out.cse, the compiler's messages on our terminal.
    let is [12]i64 as av;
    av[0] = cast(i64, "caustic");                 av[1] = 7;
    av[2] = cast(i64, src);                       av[3] = prog.slen(src);
    av[4] = cast(i64, "-o");                      av[5] = 2;
    av[6] = cast(i64, "/run.out.cse");            av[7] = 12;
    av[8] = cast(i64, "--target=caustic-x86_64"); av[9] = 23;
    av[10] = cast(i64, "-q");                     av[11] = 2;
    // The compiler's output on our stdout, its errors on our stderr.
    let is [4]i64 as fda;
    fda[0] = 1; fda[1] = 1;
    fda[2] = 2; fda[3] = 2;
    prog.outs("run: compiling "); prog.outs(src); prog.outs(" ...\n");
    let is i64 as pid = sys.spawn_path(cast(*u8, "/caustic.cse"), cast(*u8, &fda[0]), 2, cast(*u8, &av[0]), 6);
    if (pid < 0) {
        prog.errs("run: cannot start /caustic.cse: "); prog.errs(sys.err_text(pid)); prog.errs("\n");
        return cast(i32, 1);
    }
    let is i64 as r = wait_done(pid);
    if (r != 0) { prog.errs("run: compile failed (exit "); prog.err_num(r); prog.errs(")\n"); return cast(i32, 1); }

    // load + run the result, wired to our stdin and stdout.
    let is [4]i64 as ost;
    if (sys.stat(cast(*u8, "/run.out.cse"), cast(*u8, &ost[0])) != 0 || ost[0] <= 0) {
        prog.errs("run: compiler produced no output\n"); return cast(i32, 1);
    }
    // argv for the program: ["prog", <run's extra args>...] — `run foo.cst a b`
    // runs foo with a, b.
    let is i64 as avva = sys.mmap(0, (argc * 16 + 4095) / 4096 * 4096, sys.PROT_READ | sys.PROT_WRITE);
    if (avva < 0) { prog.errs("run: out of memory\n"); return cast(i32, 1); }
    let is *i64 as av2 = cast(*i64, avva);
    av2[0] = cast(i64, "prog"); av2[1] = 4;
    let is i64 as pargc with mut = 1;
    let is i64 as ai with mut = 2;
    while (ai < argc) {
        let is *u8 as ea = prog.arg(argv, ai);
        av2[pargc * 2] = cast(i64, ea); av2[pargc * 2 + 1] = prog.slen(ea);
        pargc = pargc + 1; ai = ai + 1;
    }
    let is [6]i64 as fda2;
    fda2[0] = 0; fda2[1] = 0;                      // stdin
    fda2[2] = 1; fda2[3] = 1;                      // stdout
    fda2[4] = 2; fda2[5] = 2;                      // stderr
    prog.outs("run: ---\n");
    let is i64 as pid2 = sys.spawn_path(cast(*u8, "/run.out.cse"), cast(*u8, &fda2[0]), 3, cast(*u8, av2), pargc);
    if (pid2 < 0) {
        prog.errs("run: cannot start the compiled program: "); prog.errs(sys.err_text(pid2)); prog.errs("\n");
        return cast(i32, 1);
    }
    let is i64 as r2 = wait_done(pid2);
    prog.outs("run: --- exit "); prog.out_num(r2); prog.out("\n", 1);
    return 0;
}
