// objdump — inspect a CSE executable's structure. `objdump <file.cse>`.
// Reads the CSE header + segment table (see docs/CSE_FORMAT.md) and prints
// them. NOT an x86 disassembler — it shows the container, the header fields,
// and each segment's layout (vaddr, file/mem size, R/W/X), the honest "what is
// in this file".
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn rd_u16(p as *u8, off as i64) as i64 { return cast(i64, p[off]) | (cast(i64, p[off + 1]) << 8); }
fn rd_u32(p as *u8, off as i64) as i64 { return rd_u16(p, off) | (rd_u16(p, off + 2) << 16); }
fn rd_u64(p as *u8, off as i64) as i64 { return rd_u32(p, off) | (rd_u32(p, off + 4) << 32); }

fn hex(v as i64) as void {
    prog.outs("0x");
    let is [16]u8 as b;
    let is i64 as nd with mut = 1;
    let is i64 as t with mut = v;
    while (t >= 16) { t = t / 16; nd = nd + 1; }
    let is i64 as i with mut = nd;
    let is i64 as x with mut = v;
    while (i > 0) { i = i - 1; let is i64 as d = x & 15; if (d < 10) { b[i] = cast(u8, 48 + d); } else { b[i] = cast(u8, 87 + d); } x = x / 16; }
    prog.out(cast(*u8, &b[0]), nd);
}

fn perms_str(p as i64) as void {
    if ((p & 1) != 0) { prog.outs("R"); } else { prog.outs("-"); }
    if ((p & 2) != 0) { prog.outs("W"); } else { prog.outs("-"); }
    if ((p & 4) != 0) { prog.outs("X"); } else { prog.outs("-"); }
}

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 2) { prog.outs("usage: objdump <file.cse>\n"); return cast(i32, 1); }
    let is [256]u8 as pb;
    let is *u8 as path = prog.abspath(prog.arg(argv, 1), cast(*u8, &pb[0]));
    let is i64 as len with mut = 0;
    let is i64 as base = fu.slurp(path, &len);
    if (len <= 0) { prog.outs("objdump: cannot read "); prog.outs(path); prog.out("\n", 1); return cast(i32, 1); }
    let is *u8 as p = cast(*u8, base);

    // container: pure "CST_" at 0, or polyglot "MZ" with a "CST*" mini-header at 0x40.
    let is i64 as cst with mut = 0;
    if (cast(i64, p[0]) == 67 && cast(i64, p[1]) == 83 && cast(i64, p[2]) == 84 && cast(i64, p[3]) == 95) {
        cst = 0; prog.outs("container: pure CSE\n");
    } else if (cast(i64, p[0]) == 77 && cast(i64, p[1]) == 90) {
        cst = rd_u64(p, 0x48);
        prog.outs("container: polyglot (MZ); CST body at "); hex(cst); prog.out("\n", 1);
    } else {
        prog.outs("objdump: not a CSE (bad magic)\n"); fu.unslurp(base, len); return cast(i32, 1);
    }
    if (cast(i64, p[cst]) != 67 || cast(i64, p[cst + 1]) != 83) {
        prog.outs("objdump: CST image magic bad\n"); fu.unslurp(base, len); return cast(i32, 1);
    }

    let is i64 as ver = rd_u16(p, cst + 4);
    let is i64 as arch = cast(i64, p[cst + 6]);
    let is i64 as flags = cast(i64, p[cst + 7]);
    let is i64 as entry = rd_u64(p, cst + 8);
    let is i64 as basev = rd_u64(p, cst + 0x10);
    let is i64 as nseg = rd_u32(p, cst + 0x18);
    // Header is 0x20 in v2, 0x30 in v3 (v3 added stacksize@0x2C + import fields);
    // the segment table starts right after it.
    let is i64 as hsize with mut = 0x20;
    if (ver == 3) { hsize = 0x30; }
    prog.outs("version:  "); prog.out_num(ver); prog.out("\n", 1);
    prog.outs("arch:     "); prog.out_num(arch); if (arch == 1) { prog.outs(" (x86_64)"); } prog.out("\n", 1);
    prog.outs("flags:    "); hex(flags); if ((flags & 1) != 0) { prog.outs("  (dynamic-stack)"); } prog.out("\n", 1);
    prog.outs("entry:    "); hex(entry); prog.out("\n", 1);
    prog.outs("base:     "); hex(basev); prog.out("\n", 1);
    if (ver == 3) { prog.outs("stacksize: "); prog.out_num(rd_u32(p, cst + 0x2C)); prog.outs(" bytes\n"); }
    prog.outs("segments: "); prog.out_num(nseg); prog.out("\n", 1);
    prog.outs("  #   vaddr            f_off    f_sz     m_sz     perms\n");
    let is i64 as i with mut = 0;
    while (i < nseg) {
        let is i64 as s = cst + hsize + i * 24;
        prog.outs("  "); prog.out_num(i); prog.outs("   ");
        hex(rd_u64(p, s)); prog.outs("   ");
        prog.pad_num(rd_u32(p, s + 8), 7); prog.outs("   ");
        prog.pad_num(rd_u32(p, s + 0xC), 7); prog.outs("   ");
        prog.pad_num(rd_u32(p, s + 0x10), 7); prog.outs("   ");
        perms_str(rd_u32(p, s + 0x14));
        prog.out("\n", 1);
        i = i + 1;
    }
    prog.outs("file size: "); prog.out_num(len); prog.outs(" bytes\n");
    fu.unslurp(base, len);
    return 0;
}
