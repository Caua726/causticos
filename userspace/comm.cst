// comm — compare two sorted files line by line.
//   comm [-1] [-2] [-3] file1 file2
// Three columns: lines only in file1, only in file2, in both. -1/-2/-3 suppress
// the corresponding column. A present column is prefixed by one tab per active
// column to its left (GNU comm behaviour).
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

let is i64 as s1 with mut = 0; let is i64 as s2 with mut = 0; let is i64 as s3 with mut = 0;
let is i64 as b1 with mut = 0; let is i64 as b2 with mut = 0;

// index lines of buffer `base`[0..len) into idx (off,len pairs); returns count.
fn index_lines(base as i64, len as i64, idx as *i64) as i64 {
    let is *u8 as p = cast(*u8, base);
    let is i64 as n with mut = 0; let is i64 as start with mut = 0; let is i64 as i with mut = 0;
    while (i < len) { if (cast(i64, p[i]) == 0x0A) { idx[n * 2] = start; idx[n * 2 + 1] = i - start; n = n + 1; start = i + 1; } i = i + 1; }
    if (start < len) { idx[n * 2] = start; idx[n * 2 + 1] = len - start; n = n + 1; }
    return n;
}
fn linecmp(base_a as i64, ao as i64, al as i64, base_b as i64, bo as i64, bl as i64) as i64 {
    let is *u8 as a = cast(*u8, base_a); let is *u8 as b = cast(*u8, base_b);
    let is i64 as i with mut = 0;
    while (i < al && i < bl) { if (cast(i64, a[ao + i]) != cast(i64, b[bo + i])) { if (cast(i64, a[ao + i]) < cast(i64, b[bo + i])) { return 0 - 1; } return 1; } i = i + 1; }
    if (al < bl) { return 0 - 1; } if (al > bl) { return 1; } return 0;
}
// emit a line in column `col` (1/2/3) if not suppressed, with the right tab prefix.
fn emit_col(col as i64, base as i64, off as i64, len as i64) as void {
    if (col == 1 && s1 != 0) { return; }
    if (col == 2 && s2 != 0) { return; }
    if (col == 3 && s3 != 0) { return; }
    let is i64 as tabs with mut = 0;
    if (col >= 2 && s1 == 0) { tabs = tabs + 1; }
    if (col >= 3 && s2 == 0) { tabs = tabs + 1; }
    let is i64 as t with mut = 0; while (t < tabs) { prog.out("\t", 1); t = t + 1; }
    prog.out(cast(*u8, base + off), len); prog.out("\n", 1);
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "123");
        if (f < 0) { break; }
        if (f == 49) { s1 = 1; } else if (f == 50) { s2 = 1; } else if (f == 51) { s3 = 1; }
        else { prog.outs("usage: comm [-123] file1 file2\n"); return cast(i32, 1); }
    }
    if (argc - o.ind < 2) { prog.outs("usage: comm [-123] file1 file2\n"); return cast(i32, 1); }
    let is [256]u8 as pa; let is [256]u8 as pb;
    let is *u8 as p1 = prog.abspath(prog.arg(argv, o.ind), cast(*u8, &pa[0]));
    let is *u8 as p2 = prog.abspath(prog.arg(argv, o.ind + 1), cast(*u8, &pb[0]));
    let is i64 as l1 with mut = 0; let is i64 as l2 with mut = 0;
    b1 = fu.slurp(p1, &l1); b2 = fu.slurp(p2, &l2);
    if (l1 < 0 || l2 < 0) { prog.outs("comm: cannot open input\n"); return cast(i32, 1); }
    let is i64 as iv1 = sys.mmap(cast(i64, 0), fu.page_round((l1 + 16) * 2 + 16), sys.PROT_READ | sys.PROT_WRITE);
    let is *i64 as idx1 = cast(*i64, iv1);
    let is i64 as n1 = index_lines(b1, l1, idx1);
    let is i64 as iv2 = sys.mmap(cast(i64, 0), fu.page_round((l2 + 16) * 2 + 16), sys.PROT_READ | sys.PROT_WRITE);
    let is *i64 as idx2 = cast(*i64, iv2);
    let is i64 as n2 = index_lines(b2, l2, idx2);

    let is i64 as i with mut = 0; let is i64 as j with mut = 0;
    while (i < n1 || j < n2) {
        if (i < n1 && j < n2) {
            let is i64 as c = linecmp(b1, idx1[i * 2], idx1[i * 2 + 1], b2, idx2[j * 2], idx2[j * 2 + 1]);
            if (c == 0) { emit_col(3, b1, idx1[i * 2], idx1[i * 2 + 1]); i = i + 1; j = j + 1; }
            else if (c < 0) { emit_col(1, b1, idx1[i * 2], idx1[i * 2 + 1]); i = i + 1; }
            else { emit_col(2, b2, idx2[j * 2], idx2[j * 2 + 1]); j = j + 1; }
        } else if (i < n1) { emit_col(1, b1, idx1[i * 2], idx1[i * 2 + 1]); i = i + 1; }
        else { emit_col(2, b2, idx2[j * 2], idx2[j * 2 + 1]); j = j + 1; }
    }
    return 0;
}
