// nl — number the lines of the input.
//   nl [-b a|t|n] [-n ln|rn|rz] [-w N] [-s SEP] [-v N] [-i N] [file]
// -b body numbering: a all lines, t non-empty (default), n none.
// -n number format: ln left, rn right (default), rz right zero-filled.
// -w width (6), -s separator (TAB), -v start (1), -i increment (1).
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

// BSS (init 0), set in main: a global initialised to a non-zero value lands in
// read-only data, and writing it later (via the flags) faults.
let is i64 as g_style with mut = 0;     // 'a','t','n'
let is i64 as g_fmt with mut = 0;       // 0 ln, 1 rn, 2 rz
let is i64 as g_w with mut = 0;
let is *u8 as g_sep with mut = cast(*u8, 0);
let is i64 as g_seplen with mut = 0;

fn emit_number(n as i64, w as i64, fmt as i64) as void {
    let is [24]u8 as b; let is i64 as nd with mut = 0; let is i64 as t with mut = n;
    if (n == 0) { b[0] = cast(u8, 48); nd = 1; } else { while (t > 0) { b[nd] = cast(u8, 48 + t % 10); nd = nd + 1; t = t / 10; } }
    // b holds digits reversed
    let is i64 as pad with mut = w - nd; if (pad < 0) { pad = 0; }
    if (fmt == 0) {                                          // ln: left
        let is i64 as i with mut = nd; while (i > 0) { i = i - 1; prog.out(cast(*u8, &b[i]), 1); }
        while (pad > 0) { prog.outs(" "); pad = pad - 1; }
    } else {
        if (fmt == 2) { while (pad > 0) { prog.outs("0"); pad = pad - 1; } } else { while (pad > 0) { prog.outs(" "); pad = pad - 1; } }
        let is i64 as i with mut = nd; while (i > 0) { i = i - 1; prog.out(cast(*u8, &b[i]), 1); }
    }
}

fn nl_stream(r as *fu.Reader, start as i64, incr as i64) as void {
    let is [65536]u8 as line; let is i64 as ll with mut = 0;
    let is i64 as n with mut = start;
    let is i64 as have with mut = 0;
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(r);
        if (c < 0) { break; }
        have = 1;
        if (c == 0x0A) {
            let is i64 as number_it with mut = 0;
            if (g_style == 97) { number_it = 1; } else if (g_style == 116 && ll > 0) { number_it = 1; }
            if (number_it != 0) { emit_number(n, g_w, g_fmt); prog.out(g_sep, g_seplen); n = n + incr; }
            else { let is i64 as p with mut = 0; while (p < g_w + g_seplen) { prog.outs(" "); p = p + 1; } }
            prog.out(cast(*u8, &line[0]), ll); prog.out("\n", 1);
            ll = 0;
        } else { if (ll < 65536) { line[ll] = cast(u8, c); ll = ll + 1; } }
    }
    if (ll > 0) {                                            // last line without newline
        let is i64 as number_it with mut = 0;
        if (g_style == 97 || g_style == 116) { number_it = 1; }
        if (number_it != 0) { emit_number(n, g_w, g_fmt); prog.out(g_sep, g_seplen); } else { let is i64 as p with mut = 0; while (p < g_w + g_seplen) { prog.outs(" "); p = p + 1; } }
        prog.out(cast(*u8, &line[0]), ll);
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    g_style = 116; g_fmt = 1; g_w = 6; g_sep = "\t"; g_seplen = 1;        // defaults
    let is i64 as start with mut = 1; let is i64 as incr with mut = 1;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "b:n:w:s:v:i:");
        if (f < 0) { break; }
        let is *u8 as va = cast(*u8, o.optarg);
        if (f == 98) { g_style = cast(i64, va[0]); }
        else if (f == 110) { if (cast(i64, va[0]) == 108) { g_fmt = 0; } else if (cast(i64, va[1]) == 122) { g_fmt = 2; } else { g_fmt = 1; } }
        else if (f == 119) { g_w = fu.parse_uint(va, 19); }
        else if (f == 115) { g_sep = va; g_seplen = prog.slen(va); }
        else if (f == 118) { start = fu.parse_int(va, prog.slen(va)); }
        else if (f == 105) { incr = fu.parse_int(va, prog.slen(va)); }
        else { prog.outs("usage: nl [-b a|t|n] [-n ln|rn|rz] [-w N] [-s SEP] [-v N] [-i N] [file]\n"); return cast(i32, 1); }
    }
    if (argc - o.ind <= 0) {
        let is [4096]u8 as buf; let is fu.Reader as r;
        fu.rd_open_fd(&r, cast(i64, 0), cast(*u8, &buf[0]), 4096);
        nl_stream(&r, start, incr);
        return 0;
    }
    let is *u8 as name = prog.arg(argv, o.ind);
    let is [256]u8 as pb; let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
    let is [4096]u8 as buf; let is fu.Reader as r;
    if (fu.rd_open(&r, path, cast(*u8, &buf[0]), 4096) < 0) { prog.outs("nl: "); prog.outs(name); prog.outs(": cannot open\n"); return cast(i32, 1); }
    nl_stream(&r, start, incr); fu.rd_close(&r);
    return 0;
}
