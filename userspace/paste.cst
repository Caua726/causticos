// paste — merge lines of files side by side.
//   paste [-d LIST] [-s] file...
// Default: one line from each file per output line, joined by TAB (or the -d
// delimiter list, cycled). -s pastes each file's lines onto a single line.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

let is [8]i64 as G_BASE; let is [8]i64 as G_IDX; let is [8]i64 as G_NL;
let is [64]i64 as G_DELIM; let is i64 as G_ND with mut = 0;

fn index_lines(base as i64, len as i64, idx as *i64) as i64 {
    let is *u8 as p = cast(*u8, base);
    let is i64 as n with mut = 0; let is i64 as start with mut = 0; let is i64 as i with mut = 0;
    while (i < len) { if (cast(i64, p[i]) == 0x0A) { idx[n * 2] = start; idx[n * 2 + 1] = i - start; n = n + 1; start = i + 1; } i = i + 1; }
    if (start < len) { idx[n * 2] = start; idx[n * 2 + 1] = len - start; n = n + 1; }
    return n;
}
fn put_delim(dpos as i64) as void { let is [1]u8 as d; d[0] = cast(u8, G_DELIM[dpos % G_ND]); prog.out(cast(*u8, &d[0]), 1); }
fn put_line(k as i64, r as i64) as void { let is *i64 as idx = cast(*i64, G_IDX[k]); prog.out(cast(*u8, G_BASE[k] + idx[r * 2]), idx[r * 2 + 1]); }

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as sflag with mut = 0;
    G_DELIM[0] = 9; G_ND = 1;                          // default delimiter: TAB
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "d:s");
        if (f < 0) { break; }
        if (f == 115) { sflag = 1; }
        else if (f == 100) {                           // -d LIST (with \t \n \0 \\ escapes)
            let is *u8 as v = cast(*u8, o.optarg); let is i64 as vl = prog.slen(v);
            G_ND = 0; let is i64 as i with mut = 0;
            while (i < vl && G_ND < 64) {
                let is i64 as c with mut = cast(i64, v[i]);
                if (c == 92 && i + 1 < vl) { i = i + 1; let is i64 as d = cast(i64, v[i]); if (d == 116) { c = 9; } else if (d == 110) { c = 10; } else if (d == 48) { c = 0; } else { c = d; } }
                G_DELIM[G_ND] = c; G_ND = G_ND + 1; i = i + 1;
            }
            if (G_ND == 0) { G_DELIM[0] = 9; G_ND = 1; }
        }
        else { prog.outs("usage: paste [-d LIST] [-s] file...\n"); return cast(i32, 1); }
    }
    let is i64 as nfiles with mut = argc - o.ind;
    if (nfiles <= 0) { return 0; }
    if (nfiles > 8) { nfiles = 8; }
    let is i64 as maxl with mut = 0; let is i64 as k with mut = 0;
    while (k < nfiles) {
        let is *u8 as name = prog.arg(argv, o.ind + k);
        let is [256]u8 as pbb; let is *u8 as path = prog.abspath(name, cast(*u8, &pbb[0]));
        let is i64 as len with mut = 0; let is i64 as base = fu.slurp(path, &len);
        if (len < 0) { prog.outs("paste: "); prog.outs(name); prog.outs(": cannot open\n"); return cast(i32, 1); }
        G_BASE[k] = base;
        let is i64 as iv = sys.mmap(cast(i64, 0), fu.page_round((len + 16) * 2), sys.PROT_READ | sys.PROT_WRITE);
        G_IDX[k] = iv; G_NL[k] = index_lines(base, len, cast(*i64, iv));
        if (G_NL[k] > maxl) { maxl = G_NL[k]; }
        k = k + 1;
    }

    if (sflag != 0) {                                  // -s: each file on one line
        k = 0;
        while (k < nfiles) {
            let is i64 as r with mut = 0;
            while (r < G_NL[k]) { if (r > 0) { put_delim(r - 1); } put_line(k, r); r = r + 1; }
            prog.out("\n", 1); k = k + 1;
        }
        return 0;
    }
    let is i64 as r with mut = 0;                      // default: parallel
    while (r < maxl) {
        k = 0;
        while (k < nfiles) {
            if (k > 0) { put_delim(k - 1); }
            if (r < G_NL[k]) { put_line(k, r); }
            k = k + 1;
        }
        prog.out("\n", 1); r = r + 1;
    }
    return 0;
}
