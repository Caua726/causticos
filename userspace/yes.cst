// yes — output a string repeatedly until killed. yes [STRING...]
// With no argument it prints "y"; otherwise the arguments joined by spaces.
use "../../Caustic/std/causticos/prog.cst" as prog;

fn main(argc as i64, argv as *u8) as i32 {
    let is [1024]u8 as buf; let is i64 as len with mut = 0;
    if (argc > 1) {
        let is i64 as i with mut = 1;
        while (i < argc) {
            if (i > 1 && len < 1023) { buf[len] = cast(u8, 32); len = len + 1; }
            let is *u8 as a = prog.arg(argv, i); let is i64 as k with mut = 0;
            while (cast(i64, a[k]) != 0 && len < 1023) { buf[len] = a[k]; len = len + 1; k = k + 1; }
            i = i + 1;
        }
    } else { buf[0] = cast(u8, 121); len = 1; }
    buf[len] = cast(u8, 10); len = len + 1;
    while (1 == 1) { prog.out(cast(*u8, &buf[0]), len); }
    return 0;
}
