// df — show filesystem space. `df`. Reads SYS_STATFS:
// [total_bytes, free_bytes, block_size] for the mounted FAT32 volume.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;

fn main(argc as i64, argv as *u8) as i32 {
    let is [3]i64 as st;
    if (sys.statfs(cast(*i64, &st[0])) != 0) { prog.outs("df: SYS_STATFS failed\n"); return cast(i32, 1); }
    let is i64 as totalkb = st[0] / 1024;
    let is i64 as freekb = st[1] / 1024;
    let is i64 as usedkb = totalkb - freekb;
    prog.outs("Filesystem    size(KB)    used(KB)   avail(KB)   block\n");
    prog.outs("/           ");
    prog.pad_num(totalkb, 8); prog.pad_num(usedkb, 12); prog.pad_num(freekb, 12);
    prog.outs("   "); prog.out_num(st[2]); prog.out("\n", 1);
    return 0;
}
