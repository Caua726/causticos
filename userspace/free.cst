// free — show memory usage. `free`. Reads SYS_MEM_INFO:
// [total_pages, free_pages, page_size, committed_bytes_total].
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;

fn main(argc as i64, argv as *u8) as i32 {
    let is [4]i64 as mi;
    if (sys.mem_info(cast(*i64, &mi[0])) != 0) { prog.outs("free: SYS_MEM_INFO failed\n"); return cast(i32, 1); }
    let is i64 as pagesz = mi[2];
    let is i64 as totalkb = mi[0] * pagesz / 1024;
    let is i64 as freekb = mi[1] * pagesz / 1024;
    let is i64 as usedkb = totalkb - freekb;
    let is i64 as commitkb = mi[3] / 1024;
    prog.outs("              total        used        free\n");
    prog.outs("Mem (KB): ");
    prog.pad_num(totalkb, 10); prog.pad_num(usedkb, 12); prog.pad_num(freekb, 12);
    prog.out("\n", 1);
    prog.outs("committed: "); prog.out_num(commitkb); prog.outs(" KB across processes\n");
    return 0;
}
