// ctlib.cst — shared bits for the on-device test harnesses. load a .cse, spawn
// it from a command line (split on spaces = its argv), echo a `$ ...` banner,
// wait. A spawned child has an empty fd table, so its write(1) falls back to the
// serial console and the boot log shows everything.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;

fn ser(s as *u8) as void { sys.write_serial(s, prog.slen(s)); }
fn page_round(n as i64) as i64 { return (n + 4095) / 4096 * 4096; }

fn load(path as *u8, out_len as *i64) as i64 {
    let is [4]i64 as st;
    if (sys.stat(path, cast(*u8, &st[0])) != 0) { out_len[0] = 0; return 0; }
    let is i64 as size = st[0];
    if (size <= 0) { out_len[0] = 0; return 0; }
    let is i64 as mapped = page_round(size);
    let is i64 as va = sys.mmap(0, mapped, sys.PROT_READ | sys.PROT_WRITE);
    if (va < 0) { out_len[0] = 0; return 0; }
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { out_len[0] = 0; return 0; }
    let is i64 as got with mut = 0;
    while (got < size) { let is i64 as r = sys.read(fd, cast(*u8, va + got), size - got); if (r <= 0) { break; } got = got + r; }
    sys.close(fd);
    out_len[0] = got;
    return va;
}

// runc: spawn `path` with argv parsed from `cmdline` (space-separated). The
// cmdline doubles as the child's argv (copied so tokens can be NUL-terminated).
fn runc(path as *u8, cmdline as *u8) as void {
    ser("\n$ "); ser(cmdline); ser("\n");
    let is i64 as len with mut = 0;
    let is i64 as img = load(path, &len);
    if (img == 0) { ser("[load fail]\n"); return; }
    let is [512]u8 as cb;
    let is i64 as cl with mut = prog.slen(cmdline);
    if (cl > 510) { cl = 510; }
    let is i64 as k with mut = 0;
    while (k < cl) { cb[k] = cmdline[k]; k = k + 1; }
    cb[cl] = cast(u8, 0);
    let is [64]i64 as av;
    let is i64 as argc with mut = 0;
    let is i64 as i with mut = 0;
    while (i < cl) {
        while (i < cl && cast(i64, cb[i]) == 32) { i = i + 1; }
        if (i >= cl) { break; }
        let is i64 as start = i;
        while (i < cl && cast(i64, cb[i]) != 32) { i = i + 1; }
        cb[i] = cast(u8, 0);
        if (argc < 32) { av[argc * 2] = cast(i64, &cb[start]); av[argc * 2 + 1] = i - start; argc = argc + 1; }
        i = i + 1;
    }
    let is i64 as pid = sys.spawn(cast(*u8, img), len, cast(*u8, 0), 0, cast(*u8, &av[0]), argc);
    if (pid < 0) { ser("[spawn fail]\n"); sys.munmap(img, page_round(len)); return; }
    let is [1]i64 as stt;
    sys.wait(pid, cast(*i64, &stt[0]));
    sys.munmap(img, page_round(len));
}

fn mkfile(path as *u8, data as *u8) as void {
    let is i64 as fd = syscall(sys.SYS_OPEN, path, prog.slen(path), sys.O_WRONLY | sys.O_CREAT | sys.O_TRUNC);
    if (fd >= 0) { sys.write(fd, data, prog.slen(data)); sys.close(fd); }
}
