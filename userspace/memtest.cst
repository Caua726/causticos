// memtest — exercises the std/mem heap on CausticOS. freelist.reserve goes
// through core.mmap_anon, which on the caustic target now reserves+commits real
// pages (SYS_MMAP+MMAP_RESERVE / SYS_COMMIT) instead of returning NULL. Proves
// the cross-repo Phase E path: a userspace allocator gets memory on CausticOS.
use "../../Caustic/std/mem/freelist.cst" as fl;
use "../../Caustic/std/causticos/prog.cst" as prog;

fn main(argc as i64, argv as *u8) as i32 {
    let is *fl.Heap as h = fl.reserve(1 << 20);   // 1 MiB heap, reserve+commit
    if (cast(i64, h) == 0) { prog.outs("memtest: reserve FAIL\n"); return 1; }

    let is i32 as ok with mut = 1;
    let is i64 as i with mut = 0;
    while (i < 64) {
        let is *u8 as p = fl.alloc(h, 256);
        if (cast(i64, p) == 0) { ok = 0; }
        else {
            p[0] = cast(u8, 65);
            p[255] = cast(u8, 90);            // touch the last byte of the block
            if (p[0] != cast(u8, 65)) { ok = 0; }
            if (p[255] != cast(u8, 90)) { ok = 0; }
            fl.free(h, p);
        }
        i = i + 1;
    }
    fl.release(h);

    if (ok == 1) { prog.outs("memtest: PASS\n"); }
    else { prog.outs("memtest: FAIL\n"); }
    return 0;
}
