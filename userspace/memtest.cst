// memtest — exercises the std/mem heap on CausticOS. freelist.reserve goes
// through core.mmap_anon, which on the caustic target now reserves+commits real
// pages (SYS_MMAP+MMAP_RESERVE / SYS_COMMIT) instead of returning NULL. Proves
// the cross-repo Phase E path: a userspace allocator gets memory on CausticOS.
use "../../Caustic/std/mem/freelist.cst" as fl;
use "../../Caustic/std/causticos/prog.cst" as prog;

// 256 live 1 KiB blocks = 256 KiB > the 64 KiB initial commit chunk: the heap
// must commit ~4 more chunks as the bump grows. If commit-on-grow were broken,
// touching a block past the first chunk would #PF fatally (strict, no demand
// paging) and the program would never reach PASS — so reaching PASS proves it.
let is i64 as N with imut = 256;
let is i64 as BLK with imut = 1024;

fn main(argc as i64, argv as *u8) as i32 {
    let is *fl.Heap as h = fl.reserve(N * BLK + (1 << 16));   // window > the working set
    if (cast(i64, h) == 0) { prog.outs("memtest: reserve FAIL\n"); return 1; }

    let is [256]i64 as blocks;
    let is i32 as ok with mut = 1;

    // Grow the heap past the first chunk: allocate N live blocks, writing a
    // sentinel into the first + last byte of each (forces the page to be backed).
    let is i64 as i with mut = 0;
    while (i < N) {
        let is *u8 as p = fl.alloc(h, BLK);
        if (cast(i64, p) == 0) { ok = 0; blocks[i] = 0; }
        else {
            p[0] = cast(u8, i & 0xFF);
            p[BLK - 1] = cast(u8, 90);
            blocks[i] = cast(i64, p);
        }
        i = i + 1;
    }
    // Read every sentinel back (proves all the grown chunks stayed committed).
    i = 0;
    while (i < N) {
        let is *u8 as p = cast(*u8, blocks[i]);
        if (cast(i64, p) != 0) {
            if (p[0] != cast(u8, i & 0xFF)) { ok = 0; }
            if (p[BLK - 1] != cast(u8, 90)) { ok = 0; }
        }
        i = i + 1;
    }
    // Free them all + a small reuse check.
    i = 0;
    while (i < N) { if (blocks[i] != 0) { fl.free(h, cast(*u8, blocks[i])); } i = i + 1; }
    let is *u8 as r = fl.alloc(h, BLK);
    if (cast(i64, r) == 0) { ok = 0; }
    fl.release(h);

    if (ok == 1) { prog.outs("memtest: PASS\n"); }
    else { prog.outs("memtest: FAIL\n"); }
    return 0;
}
