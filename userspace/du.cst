// du — total bytes under a path, recursing into directories. `du [path]`.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn du_walk(path as *u8, plen as i64) as i64 {
    let is [4]i64 as st;
    if (sys.stat(path, cast(*u8, &st[0])) != 0) { return 0; }
    if (st[3] == 0) { return st[0]; }                  // a file: its own size
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { return 0; }
    let is i64 as total with mut = 0;
    let is [320]u8 as de;
    while (sys.readdir(fd, cast(*u8, &de[0])) == 0) {
        let is i64 as nl = fu.de_name_len(cast(*u8, &de[0]));
        if (fu.is_dot(cast(*u8, &de[0]), nl) == 0) {
            let is [512]u8 as child;
            let is i64 as clen = fu.path_join(cast(*u8, &child[0]), path, plen, cast(*u8, &de[0]), nl);
            total = total + du_walk(cast(*u8, &child[0]), clen);
        }
    }
    sys.close(fd);
    return total;
}

fn main(argc as i64, argv as *u8) as i32 {
    let is [256]u8 as pb;
    let is *u8 as path with mut = "/";
    if (argc >= 2) { path = prog.abspath(prog.arg(argv, 1), cast(*u8, &pb[0])); }
    let is i64 as total = du_walk(path, prog.slen(path));
    prog.out_num(total); prog.outs("  "); prog.outs(path); prog.out("\n", 1);
    return 0;
}
