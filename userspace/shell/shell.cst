// examples/causticos/shell.cst — CausticOS framebuffer shell (the /init).
//
// Fuses the terminal (architecture.md §9) and the shell: it holds the framebuffer
// surface + the keyboard, renders text (term.cst), applies the keymap, and runs a
// REPL. A command line is split into argv; a builtin runs in-process, otherwise
// the shell loads "/<cmd>.cse" from the FAT32 disk, mints a console channel,
// spawns the program with argv + its stdout wired to the channel (fd 1), pumps
// the program's output to the screen, and waits. argv is data; the kernel never
// resolves it — the child acts only through the channel key it was handed.
//
// Build: caustic --target=caustic-x86_64 examples/causticos/shell.cst -o /tmp/init.cse
use "std/causticos/gfx.cst" as gfx;
use "std/causticos/term.cst" as term;
use "std/causticos/input.cst" as input;
use "std/os/causticos.cst" as sys;
use "../lib/repl/repl.cst" as repl;
use "../lib/jobs/jobs.cst" as jobs;
use "../lib/shexec/shexec.cst" as sx;
use "../lib/shbuiltin/shbuiltin.cst" as bi;
use "../lib/shscript/shscript.cst" as ss;
use "../lib/netcli/netsvc.cst" as netsvc;
use "../lib/sndcli/sndcli.cst" as sndcli;

let is i64 as IMG_CAP   with imut = 4194304;   // 4 MiB = SPAWN_IMG_MAX (fits the 1.2 MiB compiler)

// Palette (soft Tango-ish console colours, not harsh #fff-on-#000).
let is u32 as C_TEXT   with imut = 0x00d3d7cf;   // body text — soft light grey
let is u32 as C_PROMPT with imut = 0x008bbf63;   // prompt — soft green (calmer than neon, blends with the body)
let is u32 as C_ERR    with imut = 0x00ef5350;   // errors — red
let is u32 as C_DIM    with imut = 0x00888a8c;   // secondary text — dim grey
let is u32 as C_TITLE  with imut = 0x0073d0ff;   // headings — soft cyan-blue
let is u32 as C_BG     with imut = 0x00121417;   // background

// The edit buffer, the history ring, recall and completion are lib/repl —
// the same code the windowed wterm runs.
let is repl.Repl as rl with mut;

// --- small helpers ---
fn slen(s as *u8) as i64 { return repl.slen(s); }
fn puts(t as *term.Term, s as *u8) as void { term.puts(t, s, slen(s)); }
fn _col(t as *term.Term, fg as u32) as void { term.set_color(t, fg, C_BG); }
// The prompt tells you which of the two states the shell is in: waiting for a
// command, or waiting for the rest of a block you started.
fn prompt(t as *term.Term) as void {
    _col(t, C_PROMPT);
    if (ss.pending() == 1) { puts(t, "... "); } else { puts(t, "> "); }
    _col(t, C_TEXT);
}
fn err(t as *term.Term, s as *u8) as void { _col(t, C_ERR); puts(t, s); _col(t, C_TEXT); }
// hline — draw n copies of a glyph byte (e.g. 0xC4 = CP437 '─') for separators.
fn hline(t as *term.Term, ch as i64, n as i64) as void { let is i64 as i with mut = 0; while (i < n) { term.putc(t, ch); i = i + 1; } }

// serial trace (headless): markers so a screenless boot can confirm the path.
fn _log(s as *u8) as void { sys.write_serial(s, slen(s)); }
fn _lognum(v as i64) as void {
    let is i64 as x with mut = v;
    if (x < 0) { sys.write_serial("-", 1); x = 0 - x; }
    if (x == 0) { sys.write_serial("0", 1); return; }
    let is [24]u8 as b;
    let is i64 as i with mut = 24;
    while (x > 0) { i = i - 1; b[i] = cast(u8, 48 + (x % 10)); x = x / 10; }
    sys.write_serial(cast(*u8, &b[i]), 24 - i);
}

// Read a whole file into a fresh mmap'd buffer. Returns the buffer (or null) and
// writes the byte count to *out_len.
fn read_file(path as *u8, out_len as *i64) as *u8 {
    *out_len = 0;
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { return cast(*u8, 0); }
    let is i64 as sz = sys.lseek(fd, 0, cast(i32, sys.SEEK_END));
    sys.lseek(fd, 0, cast(i32, sys.SEEK_SET));
    if (sz <= 0 || sz > IMG_CAP) { sys.close(fd); return cast(*u8, 0); }
    let is i64 as va = sys.mmap(cast(i64, 0), IMG_CAP, sys.PROT_READ | sys.PROT_WRITE);
    if (va < 0) { sys.close(fd); return cast(*u8, 0); }
    let is *u8 as buf = cast(*u8, va);
    let is i64 as got = sys.read(fd, buf, sz);
    sys.close(fd);
    *out_len = got;
    return buf;
}

// Run an external program: argv_ptr[i] = byte pointer, argv_len[i] = length
// Keyboard fd + modifier state, shared with run_program so a running TUI can
// be fed keystrokes (the shell is a fullscreen terminal: it owns DEV_KEYBOARD).
let is i64 as g_kfd with mut = 0;
let is i64 as g_shift with mut = 0;
let is i64 as g_ctrl with mut = 0;

// Reply to a TUI child's CSI 18t query: report the grid as ESC[8;rows;cols t on
// the child's stdin — the same in-band, no-ioctl size protocol the wterm uses.
fn _emit_num(buf as *u8, pos as i64, val as i64) as i64 {
    let is i64 as v with mut = val;
    if (v <= 0) { buf[pos] = cast(u8, 48); return pos + 1; }
    let is [12]u8 as tmp; let is i64 as nd with mut = 0;
    while (v > 0) { tmp[nd] = cast(u8, 48 + v - (v / 10) * 10); v = v / 10; nd = nd + 1; }
    let is i64 as k with mut = 0;
    while (k < nd) { buf[pos + k] = tmp[nd - 1 - k]; k = k + 1; }
    return pos + nd;
}
fn send_size(t as *term.Term, cin as i64) as void {
    let is [40]u8 as b;
    b[0] = cast(u8, 0x1B); b[1] = cast(u8, 0x5B); b[2] = cast(u8, 56); b[3] = cast(u8, 59);
    let is i64 as i with mut = 4;
    i = _emit_num(cast(*u8, &b[0]), i, t.rows);
    b[i] = cast(u8, 59); i = i + 1;
    i = _emit_num(cast(*u8, &b[0]), i, t.cols);
    b[i] = cast(u8, 116); i = i + 1;
    sys.write(cin, cast(*u8, &b[0]), i);
}

// ---- jobs ------------------------------------------------------------------
//
// The shell no longer nests a loop inside a foreground command. There is ONE
// loop, and it polls the keyboard, the child-exit subscription, and every
// running job's output together. A foreground job is just the job that keys are
// routed to; a background job is one that keys are not routed to. That is the
// whole difference, which is why `&` costs almost nothing here.
let is i64 as fg_job with mut = 0 - 1;

fn print_num(t as *term.Term, v as i64) as void {
    let is i64 as x with mut = v;
    if (x < 0) { term.putc(t, 45); x = 0 - x; }
    if (x == 0) { term.putc(t, 48); return; }
    let is [24]u8 as b;
    let is i64 as i with mut = 24;
    while (x > 0) { i = i - 1; b[i] = cast(u8, 48 + (x % 10)); x = x / 10; }
    term.puts(t, cast(*u8, &b[i]), 24 - i);
    return;
}

// "[2] 1234  sleep 5" — the line `jobs` prints and the one a backgrounded
// command echoes when it starts.
fn print_job(t as *term.Term, slot as i64, tail as *u8) as void {
    term.putc(t, 91); print_num(t, slot + 1); term.puts(t, "] ", 2);
    print_num(t, jobs.last_pid(slot));
    term.putc(t, 32);
    let is *jobs.Job as jb = jobs.get(slot);
    if (jb.status == jobs.JOB_DONE) { _col(t, C_DIM); puts(t, "Done   "); _col(t, C_TEXT); }
    else { puts(t, "Running "); }
    term.puts(t, jobs.cmd_ptr(slot), jobs.cmd_len(slot));
    puts(t, tail);
    return;
}

// ---- builtins --------------------------------------------------------------

// The fullscreen shell's completable builtins. No `exit`: there is no window to
// close, and this process is /init — leaving would end the session.
// Completion offers the shared table plus this shell's own job commands: one
// list, built from the same rows the dispatcher reads.
fn builtins(out as *i64) as i64 {
    let is i64 as n with mut = 0;
    while (n < bi.count() && n < 12) {
        out[n * 2] = cast(i64, bi.name_at(n));
        out[n * 2 + 1] = bi.nlen_at(n);
        n = n + 1;
    }
    out[n*2] = cast(i64, cast(*u8, "clear")); out[n*2+1] = 5; n = n + 1;
    out[n*2] = cast(i64, cast(*u8, "reset")); out[n*2+1] = 5; n = n + 1;
    out[n*2] = cast(i64, cast(*u8, "jobs"));  out[n*2+1] = 4; n = n + 1;
    out[n*2] = cast(i64, cast(*u8, "fg"));    out[n*2+1] = 2; n = n + 1;
    out[n*2] = cast(i64, cast(*u8, "kill"));  out[n*2+1] = 4; n = n + 1;
    return n;
}

fn run_line(t as *term.Term, line as *u8, len as i64) as void {
    // A construct being typed, or a line that opens one, belongs to the script
    // engine: control flow needs the WHOLE thing before any of it can run, and
    // it runs synchronously (an `if` has to know its condition's status).
    if (ss.pending() == 1 || ss.is_block_start(line, len) == 1) {
        ss.feed(t, line, len);
        return;
    }
    let is [16]i64 as argv_ptr;
    let is [16]i64 as argv_len;
    let is i64 as argc with mut = repl.parse(line, len, cast(*i64, &argv_ptr[0]), cast(*i64, &argv_len[0]));
    if (argc == 0) { return; }

    // A trailing '&' is not an argument: it says "do not wait for this". The
    // LINE is shortened too, not just the argv built here — shexec re-parses
    // the raw line, and left in place the '&' reached the program as an
    // argument (`sleep 9 &` became `sleep 9 '&'`).
    let is i64 as bg with mut = 0;
    let is i64 as len2 with mut = len;
    if (repl.streq(cast(*u8, argv_ptr[argc - 1]), argv_len[argc - 1], "&") == 1) {
        bg = 1; argc = argc - 1;
        while (len2 > 0 && line[len2 - 1] != cast(u8, 38)) { len2 = len2 - 1; }
        if (len2 > 0) { len2 = len2 - 1; }
        if (argc == 0) { return; }
    }

    let is *u8 as cmd = cast(*u8, argv_ptr[0]);
    let is i64 as cl = argv_len[0];
    if (repl.streq(cmd, cl, "clear") == 1 || repl.streq(cmd, cl, "reset") == 1) { term.clear(t); return; }
    if (repl.streq(cmd, cl, "jobs") == 1) {
        let is i64 as any with mut = 0;
        let is i64 as i with mut = 0;
        while (i < jobs.max_jobs()) {
            if (jobs.get(i).status != jobs.JOB_FREE) { print_job(t, i, "\n"); any = 1; }
            i = i + 1;
        }
        if (any == 0) { _col(t, C_DIM); puts(t, "no jobs\n"); _col(t, C_TEXT); }
        return;
    }
    if (repl.streq(cmd, cl, "kill") == 1) {
        if (argc < 2) { err(t, "usage: kill %<n>\n"); return; }
        let is i64 as j = jobs.parse_pct(cast(*u8, argv_ptr[1]), argv_len[1]);
        if (j < 0) { err(t, "no such job\n"); return; }
        jobs.kill_job(j);
        return;
    }
    if (repl.streq(cmd, cl, "fg") == 1) {
        if (argc < 2) { err(t, "usage: fg %<n>\n"); return; }
        let is i64 as j = jobs.parse_pct(cast(*u8, argv_ptr[1]), argv_len[1]);
        if (j < 0) { err(t, "no such job\n"); return; }
        if (jobs.get(j).status != jobs.JOB_RUN) { err(t, "job already finished\n"); return; }
        // Bringing a job forward is only a routing change: it is the job keys
        // now go to, and the one whose completion prints the next prompt.
        jobs.get(j).bg = 0;
        fg_job = j;
        term.puts(t, jobs.cmd_ptr(j), jobs.cmd_len(j));
        term.putc(t, 0x0A);
        return;
    }
    // The shared builtins (cd, export, set, unset, type, history, help) come
    // from one table both shells read, so `help` cannot drift out of date.
    let is i64 as bst with mut = 0;
    if (bi.dispatch(t, cast(*i64, &argv_ptr[0]), cast(*i64, &argv_len[0]), argc, &bst) == 1) {
        sx.set_status(bst);
        return;
    }

    // A function defined with `function name begin ... end` is callable by
    // name, and shadows a program of that name the way a builtin does.
    if (ss.has_fn(cmd, cl) == 1) {
        sx.set_status(ss.call_named(t, cmd, cl));
        return;
    }

    // Everything else is a pipeline: expansion, globbing, redirects and '|'
    // are shexec's job, and it hands back one job slot for the whole chain.
    let is i64 as nc = sx.prepare(line, len2);
    // A line that had to be shortened is a DIFFERENT line; running it
    // would do something other than what was typed.
    if (sx.truncated() == 1) { err(t, "line too long after expansion\n"); sx.set_status(2); return; }
    if (nc == 0 - 2) { err(t, "syntax: redirect with no target\n"); return; }
    if (nc <= 0) { err(t, "too many pipeline stages\n"); return; }
    let is i64 as slot = sx.exec(bg, line, len2, 0 - 1, cast(*i64, 0));
    if (slot < 0) {
        if (slot == 0 - 1) { _col(t, C_ERR); puts(t, "not found\n"); _col(t, C_TEXT); }
        else if (slot == 0 - 2) { err(t, "too many jobs\n"); }
        else if (slot == 0 - 3) { err(t, "spawn failed\n"); }
        else { err(t, "bad command\n"); }
        sx.set_status(127);
        return;
    }
    if (bg == 1) { print_job(t, slot, "\n"); } else { fg_job = slot; }
    return;
}

// ---- the one loop ----------------------------------------------------------

// pump_job — move whatever a job has written to the screen. Returns 1 when the
// channel reached end-of-stream, which is the shell's cue that nothing more
// will come from it.
fn pump_job(t as *term.Term, slot as i64) as i64 {
    let is *jobs.Job as jb = jobs.get(slot);
    if (jb.out_fd < 0) { return 1; }
    let is [256]u8 as pbuf;
    let is i64 as n = sys.read(jb.out_fd, cast(*u8, &pbuf[0]), 256);
    if (n <= 0) { return 1; }
    term.puts(t, cast(*u8, &pbuf[0]), n);
    if (t.want_size == 1) { t.want_size = 0; send_size(t, jb.in_fd); }   // CSI 18t reply
    term.flush(t);
    return 0;
}

// finish_job — a job is retired only after its output has been drained: the
// exit event usually arrives while its last write is still in the channel.
fn finish_job(t as *term.Term, slot as i64) as void {
    let is *jobs.Job as jb = jobs.get(slot);
    let is i64 as guard with mut = 0;
    while (jb.out_fd >= 0 && guard < 4096) {
        if (pump_job(t, slot) == 1) { guard = 4096; }
        guard = guard + 1;
    }
    let is i64 as was_fg with mut = 0;
    if (fg_job == slot) {
        was_fg = 1;
        fg_job = 0 - 1;
        // This is where '$?' comes from. Without it the status a script or an
        // `if` reads is whatever a builtin last returned, not what the command
        // the user actually ran exited with.
        sx.set_status(jb.exit_code);
    }
    if (jb.bg == 1 && jb.reported == 0) {
        // A background job finishes at a moment the user did not choose, so it
        // lands on top of a half-typed line. Break to a fresh line, report, then
        // put the prompt and whatever was typed back — otherwise the notice
        // eats the input the user was in the middle of.
        jb.reported = 1;
        term.putc(t, 0x0A);
        print_job(t, slot, "\n");
        jobs.release(slot);
        prompt(t);
        term.puts(t, repl.line_ptr(&rl), repl.line_len(&rl));
        term.flush(t);
        return;
    }
    jobs.release(slot);
    if (was_fg == 1) { prompt(t); }
    term.flush(t);
    return;
}

// A key while a job is in the foreground belongs to that job, not to the line
// editor: it is the running program the user is talking to.
fn key_to_fg(ev as *input.KeyEvent) as void {
    let is *jobs.Job as jb = jobs.get(fg_job);
    if (jb.in_fd < 0) { return; }
    if (g_ctrl == 1 && ev.scancode == 0x2E) { jobs.kill_job(fg_job); return; }   // Ctrl+C
    if (ev.extended == 1 && (ev.scancode == 0x48 || ev.scancode == 0x50
                             || ev.scancode == 0x4D || ev.scancode == 0x4B)) {
        let is [3]u8 as ek; ek[0] = cast(u8, 0x1B); ek[1] = cast(u8, 0x5B);
        if (ev.scancode == 0x48)      { ek[2] = cast(u8, 65); }
        else if (ev.scancode == 0x50) { ek[2] = cast(u8, 66); }
        else if (ev.scancode == 0x4D) { ek[2] = cast(u8, 67); }
        else                          { ek[2] = cast(u8, 68); }
        sys.write(jb.in_fd, cast(*u8, &ek[0]), 3);
        return;
    }
    let is i64 as ic = input.scancode_to_ascii(ev.scancode, g_shift);
    if (ic != 0) { let is [1]u8 as kb; kb[0] = cast(u8, ic); sys.write(jb.in_fd, cast(*u8, &kb[0]), 1); }
    return;
}

// _edit — run one editing action and repaint. Every one of them changes the
// line under the cursor, so they all repaint the same way; only the action
// differs, which is why they share this wrapper instead of each redrawing.
fn _edit(t as *term.Term, what as i64) as void {
    let is i64 as pl = repl.line_len(&rl);
    let is i64 as pc = repl.cursor(&rl);
    let is i64 as ok with mut = 0;
    if (what == 1)      { ok = repl.move_left(&rl); }
    else if (what == 2) { ok = repl.move_right(&rl); }
    else if (what == 3) { ok = repl.move_home(&rl); }
    else if (what == 4) { ok = repl.move_end(&rl); }
    else if (what == 5) { ok = repl.kill_to_end(&rl); }
    else if (what == 6) { ok = repl.kill_to_start(&rl); }
    else if (what == 7) { ok = repl.kill_word(&rl); }
    else if (what == 8) { ok = repl.yank(&rl); }
    else if (what == 9) { ok = repl.transpose(&rl); }
    if (ok == 1) { repl.redraw(&rl, t, pl, pc); term.flush(t); }
    return;
}

fn key_to_line(t as *term.Term, ev as *input.KeyEvent) as void {
    if (ev.extended == 1 && ev.scancode == 0x48) {              // Up — older history
        if (repl.nav_up(&rl, t) == 1) { term.flush(t); }
        return;
    }
    if (ev.extended == 1 && ev.scancode == 0x50) {              // Down — newer history
        if (repl.nav_down(&rl, t) == 1) { term.flush(t); }
        return;
    }
    if (ev.extended == 1 && ev.scancode == 0x4B) { _edit(t, 1); return; }   // Left
    if (ev.extended == 1 && ev.scancode == 0x4D) { _edit(t, 2); return; }   // Right
    if (ev.extended == 1 && ev.scancode == 0x47) { _edit(t, 3); return; }   // Home
    if (ev.extended == 1 && ev.scancode == 0x4F) { _edit(t, 4); return; }   // End
    // Readline's control chords. They are matched on the SCANCODE, so they do
    // not depend on what the keymap makes of Ctrl+letter.
    if (g_ctrl == 1) {
        if (ev.scancode == 0x25) { _edit(t, 5); return; }       // Ctrl+K  kill to end
        if (ev.scancode == 0x16) { _edit(t, 6); return; }       // Ctrl+U  kill to start
        if (ev.scancode == 0x11) { _edit(t, 7); return; }       // Ctrl+W  kill word
        if (ev.scancode == 0x15) { _edit(t, 8); return; }       // Ctrl+Y  yank
        if (ev.scancode == 0x14) { _edit(t, 9); return; }       // Ctrl+T  transpose
        if (ev.scancode == 0x1E) { _edit(t, 3); return; }       // Ctrl+A  start of line
        if (ev.scancode == 0x12) { _edit(t, 4); return; }       // Ctrl+E  end of line
    }
    let is i64 as c = input.scancode_to_ascii(ev.scancode, g_shift);
    if (c == 0x0A) {
        term.putc(t, 0x0A); term.flush(t);
        repl.hist_push(&rl, repl.line_ptr(&rl), repl.line_len(&rl));
        // Persisted BEFORE running: this shell is /init and has no exit path,
        // so "save on quit" would never fire, and a command that wedges the
        // machine is exactly the one worth having in the file afterwards.
        repl.file_save(&rl, cast(*u8, "/var/history"));
        run_line(t, repl.line_ptr(&rl), repl.line_len(&rl));
        repl.line_clear(&rl);
        if (fg_job < 0) { prompt(t); }      // a foreground job prints it when it ends
        term.flush(t);
    } else if (c == 0x09) {                                     // Tab — autocomplete
        let is [64]i64 as bt;
        let is i64 as nb = builtins(cast(*i64, &bt[0]));
        repl.complete(&rl, t, cast(*i64, &bt[0]), nb);
        term.flush(t);
    } else if (c == 0x08) {
        let is i64 as pl = repl.line_len(&rl);
        let is i64 as pc = repl.cursor(&rl);
        if (repl.line_backspace(&rl) == 1) { repl.redraw(&rl, t, pl, pc); term.flush(t); }
    } else if (c != 0) {
        let is i64 as pl2 = repl.line_len(&rl);
        let is i64 as pc2 = repl.cursor(&rl);
        if (repl.line_push(&rl, c) == 1) { repl.redraw(&rl, t, pl2, pc2); term.flush(t); }
    }
    return;
}

fn main() as i32 {
    let is gfx.Framebuffer as fb = gfx.open();
    if (fb.ok == 0) { sys.write_serial("shell: NO FB\n", 13); sys.exit(cast(i32, 1)); }
    let is term.Term as t = term.init(fb.base, fb.fd, fb.width, fb.height, fb.pitch, fb.bpp);
    _col(&t, C_TITLE);
    puts(&t, "Caustic Shell  v0.1\n");
    _col(&t, C_DIM);
    hline(&t, 0xC4, 36); puts(&t, "\n");                 // 0xC4 = CP437 '─'
    puts(&t, "type 'help' for commands\n\n");
    _col(&t, C_TEXT);
    sys.write_serial("shell: ready\n", 13);

    g_kfd = input.open_keyboard();
    if (g_kfd < 0) { sys.write_serial("shell: NO KBD\n", 14); sys.exit(cast(i32, 2)); }

    repl.init(&rl);
    // /var may not exist on a fresh disk; an "already exists" here is exactly
    // as good as having created it.
    sys.mkdir("/var");
    repl.file_load(&rl, cast(*u8, "/var/history"));
    jobs.init();
    bi.init();
    bi.bind_repl(&rl);

    // The network. This shell is /init in its boot flavour, so it is the one
    // process allowed to start netd — a second one would take the interface
    // away from the first (DEV_NET is preemptible) and leave two stacks on one
    // link. Every command it spawns gets its own endpoint from here.
    //
    // Offline is a state, not a failure: a disk with no /netd.cse or a machine
    // with no NIC still gets a shell, and `wget` is the thing that says so.
    if (netsvc.attach_or_start(1) == 0) {
        _log("shell: netd up\n");
    } else {
        _log("shell: no netd, offline\n");
    }

    // And soundd, on the same rule and for the same reason: DEV_AUDIO_OUT is
    // preemptible, so a second mixer would take the converter from the first
    // and leave its clients writing into a mix nobody can hear.
    //
    // No mixer is a state, not a failure — aplay can still take the device
    // for itself, which is exactly what `aplay` without -m does.
    if (sndcli.attach_or_start(1) == 0) {
        _log("shell: soundd up\n");
    } else {
        _log("shell: no soundd, unmixed\n");
    }

    let is input.KeyEvent as ev;
    prompt(&t);
    term.flush(&t);

    // 2 fixed entries (keyboard, exit events) + one per running job.
    let is [54]i64 as pe;
    while (1 == 1) {
        let is i64 as n with mut = 0;
        pe[0] = g_kfd; pe[1] = sys.POLL_READABLE; pe[2] = 0;
        n = 1;
        let is i64 as ev_e with mut = 0 - 1;
        if (jobs.event_fd() >= 0) {
            pe[n*3+0] = jobs.event_fd(); pe[n*3+1] = sys.POLL_READABLE; pe[n*3+2] = 0;
            ev_e = n; n = n + 1;
        }
        // Remember which poll entry belongs to which job: the table is sparse.
        let is [16]i64 as slot_of_entry;
        let is i64 as njp with mut = 0;
        let is i64 as jj with mut = 0;
        while (jj < jobs.max_jobs()) {
            let is *jobs.Job as jb = jobs.get(jj);
            if (jb.status != jobs.JOB_FREE && jb.out_fd >= 0) {
                pe[n*3+0] = jb.out_fd;
                pe[n*3+1] = sys.POLL_READABLE;
                pe[n*3+2] = 0;
                slot_of_entry[njp] = jj;
                njp = njp + 1;
                n = n + 1;
            }
            jj = jj + 1;
        }
        sys.poll(cast(*i64, &pe[0]), n, 0 - 1);

        if ((pe[2] & sys.POLL_READABLE) != 0) {
            if (input.read_event(g_kfd, &ev) == 1) {
                if (input.is_shift(ev.scancode) == 1) { g_shift = ev.pressed; }
                else if (input.is_ctrl(ev.scancode) == 1) { g_ctrl = ev.pressed; }
                else if (ev.pressed == 1) {
                    if (fg_job >= 0) { key_to_fg(&ev); } else { key_to_line(&t, &ev); }
                }
            }
        }

        let is i64 as k with mut = 0;
        while (k < njp) {
            if ((pe[(2 + k)*3+2] & sys.POLL_READABLE) != 0) { pump_job(&t, slot_of_entry[k]); }
            k = k + 1;
        }

        if (ev_e >= 0 && (pe[ev_e*3+2] & sys.POLL_READABLE) != 0) { jobs.poll_events(); }

        // Retire whatever finished, foreground or not.
        jj = 0;
        while (jj < jobs.max_jobs()) {
            if (jobs.get(jj).status == jobs.JOB_DONE) { finish_job(&t, jj); }
            jj = jj + 1;
        }
    }
    return 0;
}
