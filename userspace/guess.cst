// guess — a number-guessing game. The first interactive CausticOS program:
// it READS your keystrokes from stdin (fd 0, fed by the terminal one byte per
// key) and responds in a loop. Proves the windowed terminal's stdin path end
// to end — type a number, press Enter, the OS says higher/lower.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;

fn main(argc as i64, argv as *u8) as i32 {
    // No RNG yet — seed the secret from the boot clock (low digits move fast).
    let is i64 as secret = (sys.time_ns() / 131) % 100 + 1;

    prog.outs("adivinha o numero (1 a 100). digita e da Enter.\n");
    prog.outs("(Enter vazio = desisto)\n\n");

    let is i64 as tries with mut = 0;
    while (1 == 1) {
        prog.outs("palpite> ");
        let is [16]u8 as buf;
        let is i64 as n = prog.getline(cast(*u8, &buf[0]), 16);
        prog.out("\n", 1);
        if (n < 0) { return 0; }                 // stdin closed (terminal gone)
        if (n == 0) {                            // empty line = give up
            prog.outs("o numero era ");
            prog.out_num(secret);
            prog.outs(". fica pra proxima!\n");
            return 0;
        }

        // parse the typed digits
        let is i64 as g with mut = 0;
        let is i64 as i with mut = 0;
        while (i < n) {
            let is i64 as ch = cast(i64, buf[i]);
            if (ch >= 0x30 && ch <= 0x39) { g = g * 10 + (ch - 0x30); }
            i = i + 1;
        }
        tries = tries + 1;

        if (g == secret) {
            prog.outs("ACERTOU! em ");
            prog.out_num(tries);
            if (tries == 1) { prog.outs(" tentativa. craque!\n"); }
            else { prog.outs(" tentativas.\n"); }
            return 0;
        } else if (g < secret) {
            prog.outs("eh maior. ");
        } else {
            prog.outs("eh menor. ");
        }
        prog.outs("(tentativa ");
        prog.out_num(tries);
        prog.outs(")\n");
    }
    return 0;
}
