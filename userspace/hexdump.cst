// hexdump — dump file contents in several formats.
//   hexdump [-bcdox] [-C] [-n LEN] [-s SKIP] [file ...]
//   (default) two-byte hex   -C canonical hex+ascii   -b octal bytes
//   -c chars   -d unsigned decimal   -o octal   -x hex (16-bit words)
// Runs of identical 16-byte lines collapse to a single `*`; a final line gives
// the total length. -n LEN dumps at most LEN bytes, -s SKIP skips the first SKIP.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

let is i64 as M_CANON = 0; let is i64 as M_TWO = 1; let is i64 as M_OCTB = 2;
let is i64 as M_CHAR = 3; let is i64 as M_DEC = 4; let is i64 as M_OCT = 5; let is i64 as M_HEX = 6;

fn emit_base(v as i64, base as i64, digits as i64) as void {
    let is [24]u8 as b; let is i64 as i with mut = digits; let is i64 as x with mut = v;
    while (i > 0) { i = i - 1; let is i64 as d = x % base; if (d < 10) { b[i] = cast(u8, 48 + d); } else { b[i] = cast(u8, 87 + d); } x = x / base; }
    prog.out(cast(*u8, &b[0]), digits);
}
fn spaces(n as i64) as void { let is i64 as i with mut = 0; while (i < n) { prog.outs(" "); i = i + 1; } }
fn dec_rj(v as i64, w as i64) as void { let is i64 as d with mut = 1; let is i64 as t with mut = v; while (t >= 10) { t = t / 10; d = d + 1; } spaces(w - d); prog.out_num(v); }

fn print_offset(off as i64, mode as i64) as void {
    if (mode == M_CANON) { emit_base(off, 16, 8); } else { emit_base(off, 16, 7); }
}

fn print_line(mode as i64, off as i64, p as *u8, start as i64, n as i64) as void {
    print_offset(off, mode);
    if (mode == M_CANON) {
        prog.outs("  ");
        let is i64 as i with mut = 0;
        while (i < 16) {
            if (i < n) { emit_base(cast(i64, p[start + i]), 16, 2); prog.outs(" "); } else { prog.outs("   "); }
            if (i == 7) { prog.outs(" "); }
            i = i + 1;
        }
        prog.outs(" |");
        i = 0;
        while (i < n) { let is i64 as c = cast(i64, p[start + i]); let is [1]u8 as ch; if (c >= 32 && c < 127) { ch[0] = cast(u8, c); } else { ch[0] = cast(u8, 46); } prog.out(cast(*u8, &ch[0]), 1); i = i + 1; }
        prog.outs("|\n");
        return;
    }
    if (mode == M_OCTB) {                                         // -b octal bytes (field 4)
        let is i64 as i with mut = 0;
        while (i < 16) { if (i < n) { prog.outs(" "); emit_base(cast(i64, p[start + i]), 8, 3); } else { spaces(4); } i = i + 1; }
        prog.out("\n", 1); return;
    }
    if (mode == M_CHAR) {                                         // -c chars (field 4)
        let is i64 as i with mut = 0;
        while (i < 16) {
            if (i < n) {
                let is i64 as c = cast(i64, p[start + i]);
                if (c == 10) { prog.outs("  \\n"); } else if (c == 9) { prog.outs("  \\t"); } else if (c == 13) { prog.outs("  \\r"); }
                else if (c == 0) { prog.outs("  \\0"); } else if (c >= 32 && c < 127) { spaces(3); let is [1]u8 as ch; ch[0] = cast(u8, c); prog.out(cast(*u8, &ch[0]), 1); }
                else { prog.outs(" "); emit_base(c, 8, 3); }
            } else { spaces(4); }
            i = i + 1;
        }
        prog.out("\n", 1); return;
    }
    // word modes (16-bit little-endian): -x -o -d and the default two-byte
    let is i64 as i with mut = 0;
    while (i < 16) {
        if (i < n) {
            let is i64 as lo = cast(i64, p[start + i]); let is i64 as hi with mut = 0;
            if (i + 1 < n) { hi = cast(i64, p[start + i + 1]); }
            let is i64 as w = lo | (hi << 8);
            if (mode == M_TWO) { prog.outs(" "); emit_base(w, 16, 4); }
            else if (mode == M_HEX) { spaces(4); emit_base(w, 16, 4); }
            else if (mode == M_OCT) { prog.outs("  "); emit_base(w, 8, 6); }
            else if (mode == M_DEC) { spaces(3); dec_rj(w, 5); }
        } else { if (mode == M_TWO) { spaces(5); } else { spaces(8); } }
        i = i + 2;
    }
    prog.out("\n", 1);
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as mode with mut = 1;                              // default two-byte
    let is i64 as skip with mut = 0; let is i64 as limit with mut = 0 - 1;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "Cbcdoxn:s:");
        if (f < 0) { break; }
        if (f == 67) { mode = 0; } else if (f == 98) { mode = 2; } else if (f == 99) { mode = 3; }
        else if (f == 100) { mode = 4; } else if (f == 111) { mode = 5; } else if (f == 120) { mode = 6; }
        else if (f == 110) { limit = fu.parse_uint(cast(*u8, o.optarg), 19); }
        else if (f == 115) { skip = fu.parse_uint(cast(*u8, o.optarg), 19); }
        else { prog.outs("usage: hexdump [-bcCdox] [-n LEN] [-s SKIP] [file ...]\n"); return cast(i32, 1); }
    }
    let is i64 as nfiles = argc - o.ind;
    let is i64 as fi with mut = o.ind;
    let is i32 as rc with mut = 0;
    let is i64 as iters with mut = nfiles; if (iters <= 0) { iters = 1; }

    let is i64 as it with mut = 0;
    let is i64 as off with mut = skip;
    let is i64 as prevset with mut = 0; let is i64 as squeezing with mut = 0;
    let is [16]u8 as prev;
    while (it < iters) {
        let is i64 as len with mut = 0; let is i64 as base with mut = 0;
        if (nfiles <= 0) { base = fu.slurp_fd(cast(i64, 0), &len); }
        else {
            let is *u8 as name = prog.arg(argv, fi);
            let is [256]u8 as pb; let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
            base = fu.slurp(path, &len);
            if (len < 0) { prog.outs("hexdump: "); prog.outs(name); prog.outs(": cannot open\n"); rc = cast(i32, 1); fi = fi + 1; it = it + 1; continue; }
        }
        let is *u8 as p = cast(*u8, base);
        let is i64 as pos with mut = skip;
        let is i64 as endp with mut = len; if (limit >= 0 && skip + limit < endp) { endp = skip + limit; }
        while (pos < endp) {
            let is i64 as n with mut = 16; if (pos + n > endp) { n = endp - pos; }
            // squeeze full identical lines
            let is i64 as same with mut = 0;
            if (n == 16 && prevset != 0) {
                same = 1; let is i64 as k with mut = 0; while (k < 16) { if (cast(i64, p[pos + k]) != cast(i64, prev[k]) ) { same = 0; break; } k = k + 1; }
            }
            if (same != 0) { if (squeezing == 0) { prog.outs("*\n"); squeezing = 1; } }
            else { print_line(mode, off, p, pos, n); squeezing = 0; }
            if (n == 16) { let is i64 as k with mut = 0; while (k < 16) { prev[k] = p[pos + k]; k = k + 1; } prevset = 1; }
            pos = pos + n; off = off + n;
        }
        it = it + 1; fi = fi + 1;
    }
    print_offset(off, mode); prog.out("\n", 1);                  // final length
    return rc;
}
