// hexdump — canonical hex + ascii dump. hexdump [-n LEN] [-s SKIP] [file ...].
//   00000000  48 65 6c 6c 6f 20 77 6f  72 6c 64 0a              |Hello world.|
// -n LEN dump at most LEN bytes, -s SKIP skip the first SKIP bytes (the address
// column then starts at SKIP). No file (or `-`) reads stdin.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn hexn(v as i64, w as i64) as void {
    let is [16]u8 as b;
    let is i64 as i with mut = w;
    let is i64 as x with mut = v;
    while (i > 0) { i = i - 1; let is i64 as d = x & 15; if (d < 10) { b[i] = cast(u8, 48 + d); } else { b[i] = cast(u8, 87 + d); } x = x / 16; }
    prog.out(cast(*u8, &b[0]), w);
}

fn dump_row(off as i64, row as *u8, n as i64) as void {
    hexn(off, 8);
    prog.outs("  ");
    let is i64 as i with mut = 0;
    while (i < 16) {
        if (i < n) { hexn(cast(i64, row[i]), 2); prog.outs(" "); } else { prog.outs("   "); }
        if (i == 7) { prog.outs(" "); }
        i = i + 1;
    }
    prog.outs(" |");
    i = 0;
    while (i < n) {
        let is i64 as c = cast(i64, row[i]);
        let is [1]u8 as ch;
        if (c >= 32 && c < 127) { ch[0] = cast(u8, c); } else { ch[0] = cast(u8, 46); }
        prog.out(cast(*u8, &ch[0]), 1);
        i = i + 1;
    }
    prog.outs("|\n");
}

fn dump(r as *fu.Reader, skip as i64, limit as i64) as void {
    let is i64 as s with mut = 0;
    while (s < skip) { if (fu.rd_byte(r) < 0) { return; } s = s + 1; }
    let is [16]u8 as row;
    let is i64 as off with mut = skip;
    let is i64 as n with mut = 0;
    let is i64 as done with mut = 0;
    while (limit < 0 || done < limit) {
        let is i64 as c = fu.rd_byte(r);
        if (c < 0) { break; }
        row[n] = cast(u8, c); n = n + 1; done = done + 1;
        if (n == 16) { dump_row(off, cast(*u8, &row[0]), 16); off = off + 16; n = 0; }
    }
    if (n > 0) { dump_row(off, cast(*u8, &row[0]), n); }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as skip with mut = 0;
    let is i64 as limit with mut = 0 - 1;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "n:s:C");
        if (f < 0) { break; }
        let is *u8 as va = cast(*u8, o.optarg);
        if (f == 110) { limit = fu.parse_uint(va, prog.slen(va)); }
        else if (f == 115) { skip = fu.parse_uint(va, prog.slen(va)); }
        else if (f == 67) { }                       // -C canonical (the only format here)
        else { prog.outs("usage: hexdump [-n LEN] [-s SKIP] [file ...]\n"); return cast(i32, 1); }
    }
    let is i64 as nfiles = argc - o.ind;
    if (nfiles <= 0) {
        let is [4096]u8 as buf;
        let is fu.Reader as r;
        fu.rd_open_fd(&r, cast(i64, 0), cast(*u8, &buf[0]), 4096);
        dump(&r, skip, limit);
        return 0;
    }
    let is i32 as rc with mut = 0;
    let is i64 as i with mut = o.ind;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb;
        let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is [4096]u8 as buf;
        let is fu.Reader as r;
        if (fu.rd_open(&r, path, cast(*u8, &buf[0]), 4096) < 0) {
            prog.outs("hexdump: "); prog.outs(name); prog.outs(": cannot open\n"); rc = cast(i32, 1);
        } else { dump(&r, skip, limit); fu.rd_close(&r); }
        i = i + 1;
    }
    return rc;
}
