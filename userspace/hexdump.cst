// hexdump — a canonical hex + ascii dump of a file. `hexdump <file>`.
//   00000000  48 65 6c 6c 6f 20 77 6f  72 6c 64 0a              |Hello world.|
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

// print v as exactly w lowercase hex digits, zero-padded.
fn hexn(v as i64, w as i64) as void {
    let is [16]u8 as b;
    let is i64 as i with mut = w;
    let is i64 as x with mut = v;
    while (i > 0) {
        i = i - 1;
        let is i64 as d = x & 15;
        if (d < 10) { b[i] = cast(u8, 48 + d); } else { b[i] = cast(u8, 87 + d); }
        x = x / 16;
    }
    prog.out(cast(*u8, &b[0]), w);
}

fn dump_row(off as i64, row as *u8, n as i64) as void {
    hexn(off, 8);
    prog.outs("  ");
    let is i64 as i with mut = 0;
    while (i < 16) {
        if (i < n) { hexn(cast(i64, row[i]), 2); prog.outs(" "); }
        else { prog.outs("   "); }
        if (i == 7) { prog.outs(" "); }
        i = i + 1;
    }
    prog.outs(" |");
    i = 0;
    while (i < n) {
        let is i64 as c = cast(i64, row[i]);
        let is [1]u8 as ch;
        if (c >= 32 && c < 127) { ch[0] = cast(u8, c); } else { ch[0] = cast(u8, 46); }
        prog.out(cast(*u8, &ch[0]), 1);
        i = i + 1;
    }
    prog.outs("|\n");
}

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 2) { prog.outs("usage: hexdump <file>\n"); return cast(i32, 1); }
    let is [256]u8 as pb;
    let is *u8 as path = prog.abspath(prog.arg(argv, 1), cast(*u8, &pb[0]));
    let is [4096]u8 as iobuf;
    let is fu.Reader as r;
    if (fu.rd_open(&r, path, cast(*u8, &iobuf[0]), 4096) < 0) {
        prog.outs("hexdump: cannot open "); prog.outs(path); prog.out("\n", 1);
        return cast(i32, 1);
    }
    let is [16]u8 as row;
    let is i64 as off with mut = 0;
    let is i64 as n with mut = 0;
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(&r);
        if (c < 0) { break; }
        row[n] = cast(u8, c);
        n = n + 1;
        if (n == 16) { dump_row(off, cast(*u8, &row[0]), 16); off = off + 16; n = 0; }
    }
    if (n > 0) { dump_row(off, cast(*u8, &row[0]), n); }
    fu.rd_close(&r);
    return 0;
}
