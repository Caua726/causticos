// cut — select bytes or fields from each line.
//   cut -c A-B <file>      bytes A..B (1-indexed, inclusive)
//   cut -c A   <file>      a single byte
//   cut -f N [-d D] <file> field N (delimiter D, default TAB)
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn is_flag(a as *u8, ch as i64) as i64 {
    if (cast(i64, a[0]) == 45 && cast(i64, a[1]) == ch && cast(i64, a[2]) == 0) { return 1; }
    return 0;
}

fn main(argc as i64, argv as *u8) as i32 {
    let is i64 as mode with mut = 0;        // 1 = -c, 2 = -f
    let is i64 as ca with mut = 1;
    let is i64 as cb with mut = 0;
    let is i64 as field with mut = 1;
    let is i64 as delim with mut = 9;       // TAB
    let is *u8 as path with mut = cast(*u8, 0);
    let is i64 as ai with mut = 1;
    while (ai < argc) {
        let is *u8 as a = prog.arg(argv, ai);
        if (is_flag(a, 99) == 1) {                              // -c
            ai = ai + 1; if (ai >= argc) { break; }
            let is *u8 as spec = prog.arg(argv, ai);
            let is i64 as sl = prog.slen(spec);
            let is i64 as dash with mut = 0 - 1;
            let is i64 as k with mut = 0;
            while (k < sl) { if (cast(i64, spec[k]) == 45) { dash = k; break; } k = k + 1; }
            if (dash < 0) { ca = fu.parse_uint(spec, sl); cb = ca; }
            else {
                ca = fu.parse_uint(spec, dash);
                let is i64 as rl = sl - dash - 1;
                if (rl <= 0) { cb = 1073741824; }
                else { cb = fu.parse_uint(cast(*u8, cast(i64, spec) + dash + 1), rl); }
            }
            if (ca < 1) { ca = 1; }
            mode = 1;
        } else if (is_flag(a, 102) == 1) {                      // -f
            ai = ai + 1; if (ai >= argc) { break; }
            let is *u8 as fv = prog.arg(argv, ai);
            field = fu.parse_uint(fv, prog.slen(fv));
            mode = 2;
        } else if (is_flag(a, 100) == 1) {                      // -d
            ai = ai + 1; if (ai >= argc) { break; }
            delim = cast(i64, prog.arg(argv, ai)[0]);
        } else {
            path = a;
        }
        ai = ai + 1;
    }
    if (mode == 0 || cast(i64, path) == 0) {
        prog.outs("usage: cut -c A-B | -f N [-d D] <file>\n"); return cast(i32, 1);
    }
    let is [256]u8 as pbb;
    let is *u8 as fullpath = prog.abspath(path, cast(*u8, &pbb[0]));
    let is [4096]u8 as iobuf;
    let is fu.Reader as r;
    if (fu.rd_open(&r, fullpath, cast(*u8, &iobuf[0]), 4096) < 0) {
        prog.outs("cut: cannot open "); prog.outs(fullpath); prog.out("\n", 1); return cast(i32, 1);
    }
    let is [8192]u8 as line;
    let is i64 as ll with mut = 0;
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(&r);
        if (c < 0 || c == 0x0A) {
            if (c == 0x0A || ll > 0) {
                if (mode == 1) {
                    let is i64 as a0 = ca - 1;
                    let is i64 as b0 with mut = cb;
                    if (b0 > ll) { b0 = ll; }
                    if (a0 < ll && b0 > a0) { prog.out(cast(*u8, &line[a0]), b0 - a0); }
                } else {
                    let is i64 as has_delim with mut = 0;
                    let is i64 as k with mut = 0;
                    while (k < ll) { if (cast(i64, line[k]) == delim) { has_delim = 1; break; } k = k + 1; }
                    if (has_delim == 0) { prog.out(cast(*u8, &line[0]), ll); }
                    else {
                        let is i64 as fnum with mut = 1;
                        let is i64 as fs with mut = 0;
                        let is i64 as done with mut = 0;
                        k = 0;
                        while (k <= ll && done == 0) {
                            if (k == ll || cast(i64, line[k]) == delim) {
                                if (fnum == field) { prog.out(cast(*u8, &line[fs]), k - fs); done = 1; }
                                fnum = fnum + 1; fs = k + 1;
                            }
                            k = k + 1;
                        }
                    }
                }
                prog.out("\n", 1);
            }
            ll = 0;
            if (c < 0) { break; }
        } else {
            if (ll < 8192) { line[ll] = cast(u8, c); ll = ll + 1; }
        }
    }
    fu.rd_close(&r);
    return 0;
}
