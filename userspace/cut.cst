// cut — select bytes or fields from each line.
//   cut -c LIST [file ...]
//   cut -f LIST [-d D] [-s] [file ...]
// LIST is a comma list of N, N-M, N-, or -M (e.g. 1,3,5-7). -d sets the field
// delimiter (default TAB); -s drops lines with no delimiter (-f). No file (or
// `-`) reads stdin.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

let is [8192]u8 as g_sel;                 // 1-indexed column selection (BSS)
let is i64 as g_openfrom with mut = 0;    // 0 = none; else select every column >= this

fn selected(col as i64) as i64 {
    if (g_openfrom > 0 && col >= g_openfrom) { return 1; }
    if (col >= 1 && col < 8192) { if (cast(i64, g_sel[col]) == 1) { return 1; } }
    return 0;
}

fn parse_list(spec as *u8) as void {
    let is i64 as sl = prog.slen(spec);
    let is i64 as i with mut = 0;
    while (i < sl) {
        let is i64 as a with mut = 0;
        let is i64 as hasa with mut = 0;
        while (i < sl && cast(i64, spec[i]) >= 48 && cast(i64, spec[i]) <= 57) { a = a * 10 + cast(i64, spec[i]) - 48; i = i + 1; hasa = 1; }
        let is i64 as b with mut = a;
        let is i64 as openend with mut = 0;
        if (i < sl && cast(i64, spec[i]) == 45) {
            i = i + 1;
            if (i < sl && cast(i64, spec[i]) >= 48 && cast(i64, spec[i]) <= 57) {
                b = 0; while (i < sl && cast(i64, spec[i]) >= 48 && cast(i64, spec[i]) <= 57) { b = b * 10 + cast(i64, spec[i]) - 48; i = i + 1; }
            } else { openend = 1; }
            if (hasa == 0) { a = 1; }
        }
        if (openend == 1) { if (g_openfrom == 0 || a < g_openfrom) { g_openfrom = a; } }
        else { let is i64 as c with mut = a; while (c <= b) { if (c >= 1 && c < 8192) { g_sel[c] = cast(u8, 1); } c = c + 1; } }
        if (i < sl && cast(i64, spec[i]) == 44) { i = i + 1; }
        else if (i < sl && (cast(i64, spec[i]) < 48 || cast(i64, spec[i]) > 57)) { i = i + 1; }
    }
}

fn cut_line(line as *u8, ll as i64, mode as i64, delim as i64, sflag as i64) as void {
    if (mode == 1) {
        let is i64 as pos with mut = 1;
        while (pos <= ll) { if (selected(pos) == 1) { prog.out(cast(*u8, cast(i64, line) + (pos - 1)), 1); } pos = pos + 1; }
        prog.out("\n", 1);
    } else {
        let is i64 as hasd with mut = 0;
        let is i64 as k with mut = 0;
        while (k < ll) { if (cast(i64, line[k]) == delim) { hasd = 1; break; } k = k + 1; }
        if (hasd == 0) { if (sflag == 0) { prog.out(line, ll); prog.out("\n", 1); } return; }
        let is i64 as fnum with mut = 1;
        let is i64 as fs with mut = 0;
        let is i64 as first_out with mut = 1;
        let is i64 as i with mut = 0;
        while (i <= ll) {
            if (i == ll || cast(i64, line[i]) == delim) {
                if (selected(fnum) == 1) {
                    if (first_out == 0) { let is [1]u8 as d; d[0] = cast(u8, delim); prog.out(cast(*u8, &d[0]), 1); }
                    first_out = 0;
                    prog.out(cast(*u8, cast(i64, line) + fs), i - fs);
                }
                fnum = fnum + 1; fs = i + 1;
            }
            i = i + 1;
        }
        prog.out("\n", 1);
    }
}

fn cut_stream(r as *fu.Reader, mode as i64, delim as i64, sflag as i64) as void {
    let is [65536]u8 as line;
    let is i64 as ll with mut = 0;
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(r);
        if (c < 0 || c == 0x0A) {
            if (c == 0x0A || ll > 0) { cut_line(cast(*u8, &line[0]), ll, mode, delim, sflag); }
            ll = 0;
            if (c < 0) { break; }
        } else { if (ll < 65536) { line[ll] = cast(u8, c); ll = ll + 1; } }
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as mode with mut = 0;
    let is i64 as delim with mut = 9;
    let is i64 as sflag with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "c:f:d:s");
        if (f < 0) { break; }
        if (f == 99) { parse_list(cast(*u8, o.optarg)); mode = 1; }
        else if (f == 102) { parse_list(cast(*u8, o.optarg)); mode = 2; }
        else if (f == 100) { let is *u8 as dv = cast(*u8, o.optarg); delim = cast(i64, dv[0]); }
        else if (f == 115) { sflag = 1; }
        else { prog.outs("usage: cut -c LIST | -f LIST [-d D] [-s] [file ...]\n"); return cast(i32, 1); }
    }
    if (mode == 0) { prog.outs("usage: cut -c LIST | -f LIST [-d D] [-s] [file ...]\n"); return cast(i32, 1); }
    let is i64 as nfiles = argc - o.ind;
    if (nfiles <= 0) {
        let is [4096]u8 as buf;
        let is fu.Reader as r;
        fu.rd_open_fd(&r, cast(i64, 0), cast(*u8, &buf[0]), 4096);
        cut_stream(&r, mode, delim, sflag);
        return 0;
    }
    let is i32 as rc with mut = 0;
    let is i64 as i with mut = o.ind;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb;
        let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is [4096]u8 as buf;
        let is fu.Reader as r;
        if (fu.rd_open(&r, path, cast(*u8, &buf[0]), 4096) < 0) {
            prog.outs("cut: "); prog.outs(name); prog.outs(": cannot open\n"); rc = cast(i32, 1);
        } else { cut_stream(&r, mode, delim, sflag); fu.rd_close(&r); }
        i = i + 1;
    }
    return rc;
}
