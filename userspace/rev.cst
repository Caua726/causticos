// rev — reverse the characters of each line. `rev <file>`.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 2) { prog.outs("usage: rev <file>\n"); return cast(i32, 1); }
    let is [256]u8 as pb;
    let is *u8 as path = prog.abspath(prog.arg(argv, 1), cast(*u8, &pb[0]));
    let is [4096]u8 as iobuf;
    let is fu.Reader as r;
    if (fu.rd_open(&r, path, cast(*u8, &iobuf[0]), 4096) < 0) {
        prog.outs("rev: cannot open "); prog.outs(path); prog.out("\n", 1);
        return cast(i32, 1);
    }
    let is [8192]u8 as line;
    let is i64 as ll with mut = 0;
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(&r);
        if (c < 0 || c == 0x0A) {
            let is i64 as i with mut = ll;
            while (i > 0) { i = i - 1; prog.out(cast(*u8, &line[i]), 1); }
            if (c == 0x0A) { prog.out("\n", 1); }
            ll = 0;
            if (c < 0) { break; }
        } else {
            if (ll < 8192) { line[ll] = cast(u8, c); ll = ll + 1; }
        }
    }
    fu.rd_close(&r);
    return 0;
}
