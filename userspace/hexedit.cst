// hexedit — a full-screen hex editor. `hexedit <file>`. Shows the file as
// offset | 16 hex bytes | ascii, with a cursor (arrows move it). Type hex digits
// (0-9 a-f) to overwrite the byte under the cursor, 's' saves to disk, 'q'
// quits. Edits happen in a private copy (slurp's R/W mapping) and only reach the
// file on save. Screen via the framebuffer grab stack, keys raw from the kbd.
use "../../Caustic/std/causticos/gfx.cst" as gfx;
use "../../Caustic/std/causticos/font.cst" as font;
use "../../Caustic/std/causticos/input.cst" as input;
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

let is i64 as GW = 8;
let is i64 as GH = 16;
let is u32 as FG  = 0x00d3d7cf;
let is u32 as BG  = 0x00121417;
let is u32 as DIM = 0x00888a8c;
let is u32 as CUR = 0x00ffd166;        // cursor highlight (amber)
let is u32 as CURTXT = 0x00121417;
let is u32 as HFG = 0x00121417;
let is u32 as HBG = 0x0073d0ff;

let is i64 as fbbase with mut = 0;
let is i64 as fbw with mut = 0;
let is i64 as fbh with mut = 0;
let is i64 as fbpitch with mut = 0;

fn putpix(x as i64, y as i64, color as u32) as void {
    if (x < 0 || y < 0 || x >= fbw || y >= fbh) { return; }
    let is *u32 as p = cast(*u32, fbbase + y * fbpitch + x * 4);
    p[0] = color;
}
fn fill_rect(x0 as i64, y0 as i64, w as i64, h as i64, color as u32) as void {
    let is i64 as y with mut = y0;
    while (y < y0 + h) { let is i64 as x with mut = x0; while (x < x0 + w) { putpix(x, y, color); x = x + 1; } y = y + 1; }
}
fn draw_glyph(px as i64, py as i64, ch as i64, fg as u32, bg as u32) as void {
    let is *u8 as g = font.get_glyph(cast(i32, ch));
    let is i64 as row with mut = 0;
    while (row < GH) {
        let is i64 as bits = cast(i64, g[row]);
        let is i64 as col with mut = 0;
        while (col < GW) {
            if ((bits & (128 >> col)) != 0) { putpix(px + col, py + row, fg); } else { putpix(px + col, py + row, bg); }
            col = col + 1;
        }
        row = row + 1;
    }
}
fn draw_text(px as i64, py as i64, s as *u8, n as i64, fg as u32, bg as u32) as i64 {
    let is i64 as i with mut = 0;
    while (i < n) { draw_glyph(px + i * GW, py, cast(i64, s[i]), fg, bg); i = i + 1; }
    return px + n * GW;
}
fn hexd(v as i64) as i64 { if (v < 10) { return 48 + v; } return 87 + v; }   // 0-15 -> '0'..'f'

// draw v as `w` hex digits at column `col`, row pixel `py`.
fn draw_hex(col as i64, py as i64, v as i64, w as i64, fg as u32, bg as u32) as void {
    let is i64 as i with mut = 0;
    while (i < w) {
        let is i64 as sh = (w - 1 - i) * 4;
        draw_glyph((col + i) * GW, py, hexd((v >> sh) & 15), fg, bg);
        i = i + 1;
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 2) { prog.outs("usage: hexedit <file>\n"); return cast(i32, 1); }
    let is [256]u8 as pbb;
    let is *u8 as path = prog.abspath(prog.arg(argv, 1), cast(*u8, &pbb[0]));
    let is i64 as len with mut = 0;
    let is i64 as base = fu.slurp(path, &len);
    if (len < 0) { prog.outs("hexedit: cannot open "); prog.outs(path); prog.out("\n", 1); return cast(i32, 1); }
    if (len == 0) { prog.outs("hexedit: empty file\n"); return cast(i32, 1); }
    let is *u8 as p = cast(*u8, base);

    font.init();
    let is gfx.Framebuffer as fb = gfx.open();
    if (fb.ok != 1) { prog.outs("hexedit: no framebuffer\n"); fu.unslurp(base, len); return cast(i32, 1); }
    fbbase = cast(i64, fb.base); fbw = fb.width; fbh = fb.height; fbpitch = fb.pitch;
    let is i64 as kfd = input.open_keyboard();

    let is i64 as rows = (fbh / GH) - 1;
    let is i64 as cur with mut = 0;        // byte offset of the cursor
    let is i64 as nib with mut = 0;        // 0 = high nibble, 1 = low
    let is i64 as view with mut = 0;       // first byte shown (multiple of 16)
    let is i64 as modified with mut = 0;
    let is i64 as dirty with mut = 1;
    let is input.KeyEvent as ev;

    while (1 == 1) {
        // keep the cursor on screen
        if (cur < view) { view = (cur / 16) * 16; }
        if (cur >= view + rows * 16) { view = ((cur / 16) - rows + 1) * 16; }
        if (view < 0) { view = 0; }

        if (dirty == 1) {
            fill_rect(0, 0, fbw, GH, HBG);
            let is i64 as hx with mut = draw_text(4, 0, path, prog.slen(path), HFG, HBG);
            hx = draw_text(hx + GW, 0, "off ", 4, HFG, HBG);
            draw_hex((hx / GW), 0, cur, 8, HFG, HBG);
            hx = hx + 8 * GW;
            if (modified == 1) { draw_text(hx + GW, 0, "*modified", 9, HFG, HBG); }
            draw_text(fbw - 30 * GW, 0, "(s save  q quit)", 16, HFG, HBG);
            fill_rect(0, GH, fbw, fbh - GH, BG);
            let is i64 as r with mut = 0;
            while (r < rows) {
                let is i64 as row_off = view + r * 16;
                if (row_off < len) {
                    let is i64 as py = (r + 1) * GH;
                    draw_hex(0, py, row_off, 8, DIM, BG);                  // offset
                    let is i64 as k with mut = 0;
                    while (k < 16) {
                        let is i64 as off = row_off + k;
                        let is i64 as bcol = 10 + k * 3;
                        if (off < len) {
                            let is i64 as bv = cast(i64, p[off]);
                            if (off == cur) {
                                fill_rect(bcol * GW, py, 2 * GW, GH, CUR);
                                draw_hex(bcol, py, bv, 2, CURTXT, CUR);
                            } else {
                                draw_hex(bcol, py, bv, 2, FG, BG);
                            }
                            // ascii column
                            let is i64 as ac = 60 + k;
                            let is i64 as ch with mut = bv;
                            if (bv < 32 || bv >= 127) { ch = 46; }
                            if (off == cur) { fill_rect(ac * GW, py, GW, GH, CUR); draw_glyph(ac * GW, py, ch, CURTXT, CUR); }
                            else { draw_glyph(ac * GW, py, ch, DIM, BG); }
                        }
                        k = k + 1;
                    }
                }
                r = r + 1;
            }
            sys.present(fb.fd, 0, 0, fbw, fbh);
            dirty = 0;
        }

        if (input.read_event(kfd, &ev) == 1) {
            if (ev.pressed == 1) {
                let is i64 as sc = ev.scancode;
                let is i64 as ext = ev.extended;
                if (sc == 0x10) { break; }                                                   // q
                else if (sc == 0x1F) {                                                       // s = save
                    let is i64 as wfd = sys.open_write(path);
                    if (wfd >= 0) { sys.write(wfd, p, len); sys.close(wfd); modified = 0; dirty = 1; }
                }
                else if (ext == 1 && sc == 0x4B) { if (cur > 0) { cur = cur - 1; nib = 0; dirty = 1; } }       // Left
                else if (ext == 1 && sc == 0x4D) { if (cur < len - 1) { cur = cur + 1; nib = 0; dirty = 1; } } // Right
                else if (ext == 1 && sc == 0x48) { if (cur >= 16) { cur = cur - 16; dirty = 1; } }             // Up
                else if (ext == 1 && sc == 0x50) { if (cur + 16 < len) { cur = cur + 16; dirty = 1; } }        // Down
                else if (ext == 1 && sc == 0x49) { cur = cur - rows * 16; if (cur < 0) { cur = 0; } dirty = 1; }    // PgUp
                else if (ext == 1 && sc == 0x51) { cur = cur + rows * 16; if (cur > len - 1) { cur = len - 1; } dirty = 1; } // PgDn
                else {
                    // hex digit edits the nibble under the cursor
                    let is i64 as a = input.scancode_to_ascii(sc, 0);
                    let is i64 as d with mut = 0 - 1;
                    if (a >= 48 && a <= 57) { d = a - 48; }
                    else if (a >= 97 && a <= 102) { d = a - 97 + 10; }
                    if (d >= 0) {
                        let is i64 as old = cast(i64, p[cur]);
                        if (nib == 0) { p[cur] = cast(u8, (old & 15) | (d << 4)); nib = 1; }
                        else { p[cur] = cast(u8, (old & 0xF0) | d); nib = 0; if (cur < len - 1) { cur = cur + 1; } }
                        modified = 1; dirty = 1;
                    }
                }
            }
        }
    }

    fill_rect(0, 0, fbw, fbh, BG);
    sys.present(fb.fd, 0, 0, fbw, fbh);
    gfx.close(&fb);
    fu.unslurp(base, len);
    return 0;
}
