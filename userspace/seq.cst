// seq — print a sequence of numbers. `seq LAST` | `seq FIRST LAST` |
// `seq FIRST INCR LAST`. One per line.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn argnum(argv as *u8, i as i64) as i64 {
    let is *u8 as a = prog.arg(argv, i);
    return fu.parse_int(a, prog.slen(a));
}

fn main(argc as i64, argv as *u8) as i32 {
    let is i64 as first with mut = 1;
    let is i64 as incr with mut = 1;
    let is i64 as last with mut = 0;
    if (argc == 2) { last = argnum(argv, 1); }
    else if (argc == 3) { first = argnum(argv, 1); last = argnum(argv, 2); }
    else if (argc >= 4) { first = argnum(argv, 1); incr = argnum(argv, 2); last = argnum(argv, 3); }
    else { prog.outs("usage: seq [first [incr]] last\n"); return cast(i32, 1); }
    if (incr == 0) { prog.outs("seq: increment is zero\n"); return cast(i32, 1); }
    let is i64 as v with mut = first;
    if (incr > 0) {
        while (v <= last) { prog.out_num(v); prog.out("\n", 1); v = v + incr; }
    } else {
        while (v >= last) { prog.out_num(v); prog.out("\n", 1); v = v + incr; }
    }
    return 0;
}
