// seq — print a sequence of numbers. seq [-s SEP] [-w] [first [incr]] last.
// -s SEP between numbers (default newline), -w pad with leading zeros to a
// common width. seq L | seq F L | seq F INCR L.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn ndig(v as i64) as i64 {
    let is i64 as t with mut = v;
    if (t < 0) { t = 0 - t; }
    let is i64 as d with mut = 1;
    while (t >= 10) { t = t / 10; d = d + 1; }
    return d;
}

fn emit_num(v as i64, width as i64) as void {
    let is i64 as neg with mut = 0;
    let is i64 as a with mut = v;
    if (a < 0) { neg = 1; a = 0 - a; }
    let is i64 as total with mut = ndig(a);
    if (neg == 1) { total = total + 1; }
    if (neg == 1) { prog.outs("-"); }
    let is i64 as pad with mut = width - total;
    while (pad > 0) { prog.outs("0"); pad = pad - 1; }
    prog.out_num(a);
}

fn argnum(argv as *u8, i as i64) as i64 {
    let is *u8 as a = prog.arg(argv, i);
    return fu.parse_int(a, prog.slen(a));
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is *u8 as sep with mut = "\n";
    let is i64 as seplen with mut = 1;
    let is i64 as wflag with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "s:w");
        if (f < 0) { break; }
        if (f == 115) { sep = cast(*u8, o.optarg); seplen = prog.slen(sep); }
        else if (f == 119) { wflag = 1; }
        else { prog.outs("usage: seq [-s SEP] [-w] [first [incr]] last\n"); return cast(i32, 1); }
    }
    let is i64 as nops = argc - o.ind;
    let is i64 as first with mut = 1;
    let is i64 as incr with mut = 1;
    let is i64 as last with mut = 0;
    if (nops == 1) { last = argnum(argv, o.ind); }
    else if (nops == 2) { first = argnum(argv, o.ind); last = argnum(argv, o.ind + 1); }
    else if (nops >= 3) { first = argnum(argv, o.ind); incr = argnum(argv, o.ind + 1); last = argnum(argv, o.ind + 2); }
    else { prog.outs("usage: seq [-s SEP] [-w] [first [incr]] last\n"); return cast(i32, 1); }
    if (incr == 0) { prog.outs("seq: increment must be nonzero\n"); return cast(i32, 1); }

    let is i64 as width with mut = 0;
    if (wflag == 1) {
        let is i64 as wf with mut = ndig(first); if (first < 0) { wf = wf + 1; }
        let is i64 as wl with mut = ndig(last); if (last < 0) { wl = wl + 1; }
        width = wf; if (wl > width) { width = wl; }
    }
    let is i64 as v with mut = first;
    let is i64 as firstout with mut = 1;
    if (incr > 0) {
        while (v <= last) {
            if (firstout == 0) { prog.out(sep, seplen); } firstout = 0;
            emit_num(v, width); v = v + incr;
        }
    } else {
        while (v >= last) {
            if (firstout == 0) { prog.out(sep, seplen); } firstout = 0;
            emit_num(v, width); v = v + incr;
        }
    }
    if (firstout == 0) { prog.out("\n", 1); }
    return 0;
}
