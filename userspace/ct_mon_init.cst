// ct_mon_init.cst — validates the rebuilt monitors (ps/top/free/df) with named
// background workers so ps/top show real names.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "ctlib.cst" as ct;

fn main(argc as i64, argv as *u8) as i32 {
    ct.spawn_bg("/sleeper.cse", "worker-a");
    ct.spawn_bg("/sleeper.cse", "worker-b");
    sys.sleep_ns(500000000);
    ct.ser("\n##### MON begin #####\n");
    ct.runc("/ps.cse",   "ps");
    ct.runc("/ps.cse",   "ps -l");
    ct.runc("/free.cse", "free");
    ct.runc("/free.cse", "free -h");
    ct.runc("/df.cse",   "df -h");
    ct.runc("/top.cse",  "top");
    ct.ser("\n##### MON done #####\n");
    while (1 == 1) { sys.sleep_ns(1000000000); }
    return 0;
}
