name "causticos-userspace"
version "0.1.0"
author "Caua"

// Every userspace program, with its source path. This file IS the build:
//   caustic-mk build all        every program
//   caustic-mk build wterm      just one
// It is also the single source of truth for what a program is called and where
// it lives — the profile files pick from these names to decide what ships in a
// root image, and nothing else keeps a parallel list.
//
// The shell target is what the kernel launches as /init on the `shell` profile;
// on `desktop` that is the compositor.

// Every program here is a CausticOS executable, not a host binary, so the
// triple is declared once for the whole project instead of 75 times. A target
// may still override it with its own `flags`.
flags "--target=caustic-x86_64"

// core: shell + demos
target "shell" {
    src "shell/shell.cst"
    out "build/shell.cse"
    flags "--target=caustic-x86_64 -lbase -Lbuild"
    depends "base-csl"
}

