name "causticos-userspace"
version "0.1.0"
author "Caua"

// Top-level orchestrator: every userspace program target with its source path.
// build.sh compiles these by name via find; this file is the canonical
// name->src map (and the entry point for a future caustic-mk build <name>).
// The shell target is what the kernel launches as /init (copied to init.cse).

// core: shell + demos
target "shell" {
    src "shell/shell.cst"
    out "build/shell.cse"
}

target "guess" {
    src "tests/guess.cst"
    out "build/guess.cse"
}

// lib self-tests (print PASS/FAIL; run from the shell)
