// The shared-library demo. libdyndemo.csl is built with --shared through a stub
// root (see lib/dyndemo/root.cst for why), and dyntest links against it with
// -l: its .cse carries an import table instead of dyndemo's code, and the
// kernel resolves it at spawn from /lib.
//
// --base puts the library well clear of the 0x400000 a program is linked at.
// Two libraries must not overlap either, so bases are assigned here, in one
// place, rather than left to whatever the linker defaults to.

// The base runtime as ONE library: syscall bindings, program helpers and
// futil. They are one dependency closure, and a .csl cannot import from another
// one — measured, splitting them put 32 KB of duplicated code on the image and
// made it bigger than sharing futil alone.
target "base-csl" {
    src "lib/base/root.cst"
    out "build/libbase.csl"
    flags "--target=caustic-x86_64 --shared --base=0x32000000"
}

target "dyndemo-csl" {
    src "lib/dyndemo/root.cst"
    out "build/libdyndemo.csl"
    flags "--target=caustic-x86_64 --shared --base=0x30000000"
}

// A second library at its own base, so two of them in one program is a tested
// path. Bases are assigned HERE, in one place: the loader maps a .csl where it
// was linked and does not relocate it, so overlapping windows would mean the
// one mapped second quietly swallowing the first one's callers.
target "dyndemo2-csl" {
    src "lib/dyndemo2/root.cst"
    out "build/libdyndemo2.csl"
    flags "--target=caustic-x86_64 --shared --base=0x31000000"
}

// The only program that links against THREE libraries at once, which is the
// point of it: two demo libs at their own bases plus the base runtime, with
// every import attributed to the right one.
target "dyntest" {
    src "tests/dyntest.cst"
    out "build/dyntest.cse"
    flags "--target=caustic-x86_64 -lbase -ldyndemo -ldyndemo2 -Lbuild"
    depends "base-csl"
    depends "dyndemo-csl"
}
