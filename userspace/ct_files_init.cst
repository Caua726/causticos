// ct_files_init.cst — validates the rebuilt file operations on a small tree.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "ctlib.cst" as ct;

fn main(argc as i64, argv as *u8) as i32 {
    sys.mkdir("/d");
    ct.mkfile("/d/a.txt", "alpha\nbeta\n");
    ct.mkfile("/d/b.txt", "gamma\n");
    sys.mkdir("/d/sub");
    ct.mkfile("/d/sub/c.txt", "delta\n");
    ct.ser("\n##### FILES begin #####\n");
    ct.runc("/ls.cse",    "ls /d");
    ct.runc("/ls.cse",    "ls -l /d");
    ct.runc("/ls.cse",    "ls -R /d");
    ct.runc("/mkdir.cse", "mkdir -p /x/y/z");
    ct.runc("/ls.cse",    "ls -R /x");
    ct.runc("/cp.cse",    "cp /d/a.txt /d/a2.txt");
    ct.runc("/cp.cse",    "cp -r /d /dcopy");
    ct.runc("/ls.cse",    "ls -R /dcopy");
    ct.runc("/mv.cse",    "mv /d/b.txt /d/b2.txt");
    ct.runc("/ls.cse",    "ls /d");
    ct.runc("/du.cse",    "du /d");
    ct.runc("/du.cse",    "du -sh /d");
    ct.runc("/tree.cse",  "tree -d /d");
    ct.runc("/find.cse",  "find /d -name txt");
    ct.runc("/find.cse",  "find /d -type d");
    ct.runc("/rm.cse",    "rm -r /dcopy");
    ct.runc("/stat.cse",  "stat /d/a.txt");
    ct.runc("/ls.cse",    "ls /");
    ct.ser("\n##### FILES done #####\n");
    while (1 == 1) { sys.sleep_ns(1000000000); }
    return 0;
}
