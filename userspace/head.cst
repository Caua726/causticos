// head — print the first part of each file. head [-n N] [-c N] [file ...].
// -n N lines (default 10), -c N bytes. With several files, each gets a
// `==> name <==` banner. No file (or `-`) reads stdin.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn emit(r as *fu.Reader, n as i64, bymode as i64) as void {
    let is [1]u8 as b;
    if (bymode == 1) {
        let is i64 as i with mut = 0;
        while (i < n) {
            let is i64 as c = fu.rd_byte(r);
            if (c < 0) { break; }
            b[0] = cast(u8, c); prog.out(cast(*u8, &b[0]), 1);
            i = i + 1;
        }
    } else {
        let is i64 as printed with mut = 0;
        while (1 == 1) {
            let is i64 as c = fu.rd_byte(r);
            if (c < 0) { break; }
            b[0] = cast(u8, c); prog.out(cast(*u8, &b[0]), 1);
            if (c == 0x0A) { printed = printed + 1; if (printed >= n) { break; } }
        }
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as n with mut = 10;
    let is i64 as bymode with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "n:c:");
        if (f < 0) { break; }
        let is *u8 as va = cast(*u8, o.optarg);
        if (f == 110) { n = fu.parse_uint(va, prog.slen(va)); bymode = 0; }
        else if (f == 99) { n = fu.parse_uint(va, prog.slen(va)); bymode = 1; }
        else { prog.outs("usage: head [-n N] [-c N] [file ...]\n"); return cast(i32, 1); }
    }
    if (n < 0) { n = 0; }
    let is i64 as nfiles = argc - o.ind;
    if (nfiles <= 0) {
        let is [4096]u8 as buf;
        let is fu.Reader as r;
        fu.rd_open_fd(&r, cast(i64, 0), cast(*u8, &buf[0]), 4096);
        emit(&r, n, bymode);
        return 0;
    }
    let is i32 as rc with mut = 0;
    let is i64 as i with mut = o.ind;
    let is i64 as first with mut = 1;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb;
        let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is [4096]u8 as buf;
        let is fu.Reader as r;
        if (fu.rd_open(&r, path, cast(*u8, &buf[0]), 4096) < 0) {
            prog.outs("head: "); prog.outs(name); prog.outs(": cannot open\n"); rc = cast(i32, 1);
        } else {
            if (nfiles > 1) {
                if (first == 0) { prog.out("\n", 1); }
                prog.outs("==> "); prog.outs(name); prog.outs(" <==\n");
            }
            first = 0;
            emit(&r, n, bymode);
            fu.rd_close(&r);
        }
        i = i + 1;
    }
    return rc;
}
