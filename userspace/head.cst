// head — print the first N lines of a file (default 10). `head [-n N] <file>`.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 2) { prog.outs("usage: head [-n N] <file>\n"); return cast(i32, 1); }
    let is i64 as nlines with mut = 10;
    let is i64 as ai with mut = 1;
    let is *u8 as a1 = prog.arg(argv, 1);
    if (cast(i64, a1[0]) == 45 && cast(i64, a1[1]) == 110) {   // "-n"
        if (argc < 4) { prog.outs("usage: head [-n N] <file>\n"); return cast(i32, 1); }
        let is *u8 as nv = prog.arg(argv, 2);
        let is i64 as pn = fu.parse_uint(nv, prog.slen(nv));
        if (pn >= 0) { nlines = pn; }
        ai = 3;
    }
    let is [256]u8 as pb;
    let is *u8 as path = prog.abspath(prog.arg(argv, ai), cast(*u8, &pb[0]));
    let is [4096]u8 as iobuf;
    let is fu.Reader as r;
    if (fu.rd_open(&r, path, cast(*u8, &iobuf[0]), 4096) < 0) {
        prog.outs("head: cannot open "); prog.outs(path); prog.out("\n", 1);
        return cast(i32, 1);
    }
    if (nlines == 0) { fu.rd_close(&r); return 0; }
    let is i64 as printed with mut = 0;
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(&r);
        if (c < 0) { break; }
        let is [1]u8 as ch; ch[0] = cast(u8, c); prog.out(cast(*u8, &ch[0]), 1);
        if (c == 0x0A) { printed = printed + 1; if (printed >= nlines) { break; } }
    }
    fu.rd_close(&r);
    return 0;
}
