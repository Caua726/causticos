// sleep — pause for a sum of durations. `sleep NUMBER[smhd]...`
//   NUMBER may be a decimal; suffix s (default), m, h, d. Multiple operands add.
//   e.g. sleep 0.5   sleep 2m 30s
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;

let is i64 as NS = 1000000000;

// parse one operand into nanoseconds; returns -1 on a malformed number.
fn parse_dur(s as *u8) as i64 {
    let is i64 as i with mut = 0;
    let is i64 as whole with mut = 0; let is i64 as seen with mut = 0;
    while (s[i] >= 48 && s[i] <= 57) { whole = whole * 10 + (cast(i64, s[i]) - 48); i = i + 1; seen = 1; }
    let is i64 as frac with mut = 0; let is i64 as fscale with mut = 1;
    if (s[i] == 46) {                                   // '.'
        i = i + 1;
        while (s[i] >= 48 && s[i] <= 57 && fscale < 1000000000) { frac = frac * 10 + (cast(i64, s[i]) - 48); fscale = fscale * 10; i = i + 1; seen = 1; }
    }
    if (seen == 0) { return 0 - 1; }
    let is i64 as mult with mut = 1;                    // suffix -> seconds
    if (s[i] == 115) { mult = 1; i = i + 1; }           // s
    else if (s[i] == 109) { mult = 60; i = i + 1; }     // m
    else if (s[i] == 104) { mult = 3600; i = i + 1; }   // h
    else if (s[i] == 100) { mult = 86400; i = i + 1; }  // d
    if (s[i] != 0) { return 0 - 1; }                    // trailing garbage
    let is i64 as ns with mut = whole * NS * mult;
    ns = ns + frac * (NS / fscale) * mult;
    return ns;
}

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 2) { prog.outs("usage: sleep NUMBER[smhd]...\n"); return cast(i32, 1); }
    let is i64 as total with mut = 0; let is i64 as i with mut = 1;
    while (i < argc) {
        let is i64 as d = parse_dur(prog.arg(argv, i));
        if (d < 0) { prog.outs("sleep: invalid time interval '"); prog.outs(prog.arg(argv, i)); prog.outs("'\n"); return cast(i32, 1); }
        total = total + d; i = i + 1;
    }
    if (total > 0) { sys.sleep_ns(total); }
    return cast(i32, 0);
}
