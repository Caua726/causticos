// grep — print lines matching a fixed string (no regex yet).
//   grep [-i] [-n] [-v] [-c] [-l] [-w] [-q] PATTERN [file ...]
// -i ignore case, -n line numbers, -v invert, -c count only, -l names only,
// -w whole-word, -q quiet. Several files prefix matches with `name:`. Exit 0 if
// any line matched, 1 if none, 2 on error.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn lc(c as i64) as i64 { if (c >= 65 && c <= 90) { return c + 32; } return c; }
fn alnum(c as i64) as i64 {
    if (c >= 48 && c <= 57) { return 1; }
    if (c >= 65 && c <= 90) { return 1; }
    if (c >= 97 && c <= 122) { return 1; }
    if (c == 95) { return 1; }
    return 0;
}

fn matches(hay as *u8, hlen as i64, needle as *u8, nlen as i64, ci as i64, word as i64) as i64 {
    if (nlen == 0) { return 1; }
    if (nlen > hlen) { return 0; }
    let is i64 as last = hlen - nlen;
    let is i64 as i with mut = 0;
    while (i <= last) {
        let is i64 as j with mut = 0;
        while (j < nlen) {
            let is i64 as a with mut = cast(i64, hay[i + j]);
            let is i64 as b with mut = cast(i64, needle[j]);
            if (ci == 1) { a = lc(a); b = lc(b); }
            if (a != b) { break; }
            j = j + 1;
        }
        if (j == nlen) {
            if (word == 0) { return 1; }
            let is i64 as bok with mut = 1;
            let is i64 as aok with mut = 1;
            if (i > 0 && alnum(cast(i64, hay[i - 1])) == 1) { bok = 0; }
            if (i + nlen < hlen && alnum(cast(i64, hay[i + nlen])) == 1) { aok = 0; }
            if (bok == 1 && aok == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

// flags: bit0 i, bit1 n, bit2 v, bit3 c, bit4 l, bit5 w, bit6 q
fn grep_one(r as *fu.Reader, pat as *u8, plen as i64, fl as i64, name as *u8, multi as i64, any as *i64) as void {
    let is i64 as ci   = fl & 1;
    let is i64 as nflag = (fl >> 1) & 1;
    let is i64 as inv  = (fl >> 2) & 1;
    let is i64 as cflag = (fl >> 3) & 1;
    let is i64 as lflag = (fl >> 4) & 1;
    let is i64 as word = (fl >> 5) & 1;
    let is i64 as quiet = (fl >> 6) & 1;
    let is [16384]u8 as line;
    let is i64 as ll with mut = 0;
    let is i64 as lineno with mut = 0;
    let is i64 as matched_here with mut = 0;
    let is i64 as count with mut = 0;
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(r);
        if (c < 0 || c == 0x0A) {
            if (c == 0x0A || ll > 0) {
                lineno = lineno + 1;
                let is i64 as m with mut = matches(cast(*u8, &line[0]), ll, pat, plen, ci, word);
                if (inv == 1) { if (m == 0) { m = 1; } else { m = 0; } }
                if (m == 1) {
                    matched_here = 1; count = count + 1; any[0] = 1;
                    if (cflag == 0 && lflag == 0 && quiet == 0) {
                        if (multi == 1) { prog.outs(name); prog.outs(":"); }
                        if (nflag == 1) { prog.out_num(lineno); prog.outs(":"); }
                        prog.out(cast(*u8, &line[0]), ll); prog.out("\n", 1);
                    }
                }
            }
            ll = 0;
            if (c < 0) { break; }
        } else {
            if (ll < 16384) { line[ll] = cast(u8, c); ll = ll + 1; }
        }
    }
    if (cflag == 1) {
        if (multi == 1) { prog.outs(name); prog.outs(":"); }
        prog.out_num(count); prog.out("\n", 1);
    } else if (lflag == 1) {
        if (matched_here == 1) { prog.outs(name); prog.out("\n", 1); }
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as fl with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "invclwq");
        if (f < 0) { break; }
        if (f == 105) { fl = fl | 1; }
        else if (f == 110) { fl = fl | 2; }
        else if (f == 118) { fl = fl | 4; }
        else if (f == 99) { fl = fl | 8; }
        else if (f == 108) { fl = fl | 16; }
        else if (f == 119) { fl = fl | 32; }
        else if (f == 113) { fl = fl | 64; }
        else { prog.outs("usage: grep [-invclwq] PATTERN [file ...]\n"); return cast(i32, 2); }
    }
    if (o.ind >= argc) { prog.outs("usage: grep [-invclwq] PATTERN [file ...]\n"); return cast(i32, 2); }
    let is *u8 as pat = prog.arg(argv, o.ind);
    let is i64 as plen = prog.slen(pat);
    o.ind = o.ind + 1;
    let is i64 as nfiles = argc - o.ind;
    let is [1]i64 as any; any[0] = 0;
    let is i32 as rc with mut = 0;
    if (nfiles <= 0) {
        let is [4096]u8 as buf;
        let is fu.Reader as r;
        fu.rd_open_fd(&r, cast(i64, 0), cast(*u8, &buf[0]), 4096);
        grep_one(&r, pat, plen, fl, "(stdin)", 0, cast(*i64, &any[0]));
    } else {
        let is i64 as multi with mut = 0;
        if (nfiles > 1) { multi = 1; }
        let is i64 as i with mut = o.ind;
        while (i < argc) {
            let is *u8 as name = prog.arg(argv, i);
            let is [256]u8 as pb;
            let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
            let is [4096]u8 as buf;
            let is fu.Reader as r;
            if (fu.rd_open(&r, path, cast(*u8, &buf[0]), 4096) < 0) {
                prog.outs("grep: "); prog.outs(name); prog.outs(": cannot open\n"); rc = cast(i32, 2);
            } else {
                grep_one(&r, pat, plen, fl, name, multi, cast(*i64, &any[0]));
                fu.rd_close(&r);
            }
            i = i + 1;
        }
    }
    if (rc != 0) { return rc; }
    if (any[0] == 1) { return 0; }
    return cast(i32, 1);
}
