// grep — print the lines of a file that contain a substring (literal, no
// regex). `grep <pattern> <file>`. Exit 0 if any line matched, 1 otherwise.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 3) { prog.outs("usage: grep <pattern> <file>\n"); return cast(i32, 1); }
    let is *u8 as pat = prog.arg(argv, 1);
    let is i64 as patlen = prog.slen(pat);
    let is [256]u8 as pb;
    let is *u8 as path = prog.abspath(prog.arg(argv, 2), cast(*u8, &pb[0]));
    let is [4096]u8 as iobuf;
    let is fu.Reader as r;
    if (fu.rd_open(&r, path, cast(*u8, &iobuf[0]), 4096) < 0) {
        prog.outs("grep: cannot open "); prog.outs(path); prog.out("\n", 1);
        return cast(i32, 1);
    }
    let is [8192]u8 as line;
    let is i64 as ll with mut = 0;
    let is i64 as matched with mut = 0;
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(&r);
        if (c < 0 || c == 0x0A) {
            if (fu.mem_find(cast(*u8, &line[0]), ll, pat, patlen) >= 0) {
                prog.out(cast(*u8, &line[0]), ll); prog.out("\n", 1);
                matched = 1;
            }
            ll = 0;
            if (c < 0) { break; }
        } else {
            if (ll < 8192) { line[ll] = cast(u8, c); ll = ll + 1; }
        }
    }
    fu.rd_close(&r);
    if (matched == 1) { return 0; }
    return cast(i32, 1);
}
