// ctest_d_init.cst — headless harness for the category-D monitors. Booted as
// /init, it spawns ps/free/df/top; their stdout falls back to serial (empty fd
// table), so the boot log shows each monitor's output. Exercises the new
// SYS_PROC_LIST / SYS_MEM_INFO / SYS_STATFS syscalls end to end. top one-shots
// when there's no stdin (poll on fd 0 reports POLL_ERROR), so it's testable.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;

fn ser(s as *u8) as void { sys.write_serial(s, prog.slen(s)); }

fn page_round(n as i64) as i64 { return (n + 4095) / 4096 * 4096; }

fn load(path as *u8, out_len as *i64) as i64 {
    let is [4]i64 as st;
    if (sys.stat(path, cast(*u8, &st[0])) != 0) { out_len[0] = 0; return 0; }
    let is i64 as size = st[0];
    if (size <= 0) { out_len[0] = 0; return 0; }
    let is i64 as mapped = page_round(size);
    let is i64 as va = sys.mmap(0, mapped, sys.PROT_READ | sys.PROT_WRITE);
    if (va < 0) { out_len[0] = 0; return 0; }
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { out_len[0] = 0; return 0; }
    let is i64 as got with mut = 0;
    while (got < size) {
        let is i64 as r = sys.read(fd, cast(*u8, va + got), size - got);
        if (r <= 0) { break; }
        got = got + r;
    }
    sys.close(fd);
    out_len[0] = got;
    return va;
}

fn run(path as *u8, name as *u8) as void {
    ser("\n$ "); ser(name); ser("\n");
    let is i64 as len with mut = 0;
    let is i64 as img = load(path, &len);
    if (img == 0) { ser("[load fail]\n"); return; }
    let is [2]i64 as av;
    av[0] = cast(i64, name); av[1] = prog.slen(name);
    let is i64 as pid = sys.spawn(cast(*u8, img), len, cast(*u8, 0), 0, cast(*u8, &av[0]), 1);
    if (pid < 0) { ser("[spawn fail]\n"); sys.munmap(img, page_round(len)); return; }
    let is [1]i64 as stt;
    sys.wait(pid, cast(*i64, &stt[0]));
    sys.munmap(img, page_round(len));
}

fn main(argc as i64, argv as *u8) as i32 {
    ser("\n##### CTEST-D begin #####\n");
    run("/ps.cse",   "ps");
    run("/free.cse", "free");
    run("/df.cse",   "df");
    run("/top.cse",  "top");
    ser("\n##### CTEST-D done #####\n");
    while (1 == 1) { sys.sleep_ns(1000000000); }
    return 0;
}
