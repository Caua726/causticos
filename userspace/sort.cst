// sort — sort the lines of a file lexicographically. `sort <file>`.
// Maps the file, builds an index of (offset,len) per line, quicksorts it.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn linecmp(base as i64, ao as i64, al as i64, bo as i64, bl as i64) as i64 {
    let is i64 as n with mut = al;
    if (bl < n) { n = bl; }
    let is *u8 as pa = cast(*u8, base + ao);
    let is *u8 as pb = cast(*u8, base + bo);
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as x = cast(i64, pa[i]);
        let is i64 as y = cast(i64, pb[i]);
        if (x != y) { if (x < y) { return 0 - 1; } return 1; }
        i = i + 1;
    }
    if (al < bl) { return 0 - 1; }
    if (al > bl) { return 1; }
    return 0;
}

fn qsort_lines(base as i64, idx as *i64, lo as i64, hi as i64) as void {
    if (lo >= hi) { return; }
    let is i64 as mid = lo + (hi - lo) / 2;
    let is i64 as po = idx[mid * 2];
    let is i64 as pl = idx[mid * 2 + 1];
    let is i64 as i with mut = lo - 1;
    let is i64 as j with mut = hi + 1;
    while (1 == 1) {
        i = i + 1;
        while (linecmp(base, idx[i * 2], idx[i * 2 + 1], po, pl) < 0) { i = i + 1; }
        j = j - 1;
        while (linecmp(base, idx[j * 2], idx[j * 2 + 1], po, pl) > 0) { j = j - 1; }
        if (i >= j) { break; }
        let is i64 as t0 = idx[i * 2]; let is i64 as t1 = idx[i * 2 + 1];
        idx[i * 2] = idx[j * 2]; idx[i * 2 + 1] = idx[j * 2 + 1];
        idx[j * 2] = t0; idx[j * 2 + 1] = t1;
    }
    qsort_lines(base, idx, lo, j);
    qsort_lines(base, idx, j + 1, hi);
}

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 2) { prog.outs("usage: sort <file>\n"); return cast(i32, 1); }
    let is [256]u8 as pb;
    let is *u8 as path = prog.abspath(prog.arg(argv, 1), cast(*u8, &pb[0]));
    let is i64 as len with mut = 0;
    let is i64 as base = fu.slurp(path, &len);
    if (len < 0) { prog.outs("sort: cannot open "); prog.outs(path); prog.out("\n", 1); return cast(i32, 1); }
    if (len == 0) { return 0; }
    let is *u8 as p = cast(*u8, base);
    let is i64 as nlines with mut = 0;
    let is i64 as i with mut = 0;
    while (i < len) { if (cast(i64, p[i]) == 0x0A) { nlines = nlines + 1; } i = i + 1; }
    if (cast(i64, p[len - 1]) != 0x0A) { nlines = nlines + 1; }
    let is i64 as isz = fu.page_round(nlines * 16);
    let is i64 as iva = sys.mmap(0, isz, sys.PROT_READ | sys.PROT_WRITE);
    if (iva < 0) { fu.unslurp(base, len); prog.outs("sort: out of memory\n"); return cast(i32, 1); }
    let is *i64 as idx = cast(*i64, iva);
    let is i64 as li with mut = 0;
    let is i64 as start with mut = 0;
    i = 0;
    while (i < len) {
        if (cast(i64, p[i]) == 0x0A) {
            idx[li * 2] = start; idx[li * 2 + 1] = i - start; li = li + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    if (start < len) { idx[li * 2] = start; idx[li * 2 + 1] = len - start; li = li + 1; }
    qsort_lines(base, idx, 0, li - 1);
    i = 0;
    while (i < li) {
        prog.out(cast(*u8, base + idx[i * 2]), idx[i * 2 + 1]);
        prog.out("\n", 1);
        i = i + 1;
    }
    sys.munmap(iva, isz);
    fu.unslurp(base, len);
    return 0;
}
