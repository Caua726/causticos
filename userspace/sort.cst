// sort — sort lines of the input. sort [-n] [-r] [-u] [-f] [-b] [file ...].
// -n numeric, -r reverse, -u unique, -f fold case, -b ignore leading blanks.
// All inputs are merged then sorted; no file (or `-`) reads stdin.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

// globals for the comparator (the recursive sort doesn't thread context).
let is i64 as g_base with mut = 0;   // *u8 of the combined input
let is i64 as g_fl with mut = 0;     // bit0 n, bit1 r, bit2 u, bit3 f, bit4 b

fn is_blank(c as i64) as i64 { if (c == 32 || c == 9) { return 1; } return 0; }
fn lc(c as i64) as i64 { if (c >= 65 && c <= 90) { return c + 32; } return c; }

fn lead_num(off as i64, end as i64) as i64 {
    let is *u8 as p = cast(*u8, g_base);
    let is i64 as i with mut = off;
    while (i < end && is_blank(cast(i64, p[i])) == 1) { i = i + 1; }
    let is i64 as neg with mut = 0;
    if (i < end && cast(i64, p[i]) == 45) { neg = 1; i = i + 1; }
    let is i64 as v with mut = 0;
    while (i < end) { let is i64 as c = cast(i64, p[i]); if (c < 48 || c > 57) { break; } v = v * 10 + c - 48; i = i + 1; }
    if (neg == 1) { return 0 - v; }
    return v;
}

// compare lines a=[ao,ao+al) b=[bo,bo+bl); returns <0 / 0 / >0.
fn linecmp(ao as i64, al as i64, bo as i64, bl as i64) as i64 {
    let is *u8 as p = cast(*u8, g_base);
    if ((g_fl & 1) == 1) {                              // -n
        let is i64 as va = lead_num(ao, ao + al);
        let is i64 as vb = lead_num(bo, bo + bl);
        if (va < vb) { return 0 - 1; }
        if (va > vb) { return 1; }
        return 0;
    }
    let is i64 as fold = (g_fl >> 3) & 1;
    let is i64 as ai with mut = ao;
    let is i64 as bi with mut = bo;
    let is i64 as ae = ao + al;
    let is i64 as be = bo + bl;
    if (((g_fl >> 4) & 1) == 1) {                       // -b
        while (ai < ae && is_blank(cast(i64, p[ai])) == 1) { ai = ai + 1; }
        while (bi < be && is_blank(cast(i64, p[bi])) == 1) { bi = bi + 1; }
    }
    while (ai < ae && bi < be) {
        let is i64 as ca with mut = cast(i64, p[ai]);
        let is i64 as cb with mut = cast(i64, p[bi]);
        if (fold == 1) { ca = lc(ca); cb = lc(cb); }
        if (ca != cb) { if (ca < cb) { return 0 - 1; } return 1; }
        ai = ai + 1; bi = bi + 1;
    }
    let is i64 as ra = ae - ai;
    let is i64 as rb = be - bi;
    if (ra < rb) { return 0 - 1; }
    if (ra > rb) { return 1; }
    return 0;
}

fn qsort_idx(idx as *i64, lo as i64, hi as i64) as void {
    if (lo >= hi) { return; }
    let is i64 as mid = lo + (hi - lo) / 2;
    let is i64 as po = idx[mid * 2];
    let is i64 as pl = idx[mid * 2 + 1];
    let is i64 as i with mut = lo - 1;
    let is i64 as j with mut = hi + 1;
    while (1 == 1) {
        i = i + 1;
        while (linecmp(idx[i * 2], idx[i * 2 + 1], po, pl) < 0) { i = i + 1; }
        j = j - 1;
        while (linecmp(idx[j * 2], idx[j * 2 + 1], po, pl) > 0) { j = j - 1; }
        if (i >= j) { break; }
        let is i64 as t0 = idx[i * 2]; let is i64 as t1 = idx[i * 2 + 1];
        idx[i * 2] = idx[j * 2]; idx[i * 2 + 1] = idx[j * 2 + 1];
        idx[j * 2] = t0; idx[j * 2 + 1] = t1;
    }
    qsort_idx(idx, lo, j);
    qsort_idx(idx, j + 1, hi);
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "nrufb");
        if (f < 0) { break; }
        if (f == 110) { g_fl = g_fl | 1; }
        else if (f == 114) { g_fl = g_fl | 2; }
        else if (f == 117) { g_fl = g_fl | 4; }
        else if (f == 102) { g_fl = g_fl | 8; }
        else if (f == 98) { g_fl = g_fl | 16; }
        else { prog.outs("usage: sort [-nrufb] [file ...]\n"); return cast(i32, 1); }
    }

    // gather every input into one growing mapping.
    let is i64 as cap with mut = 65536;
    let is i64 as va with mut = sys.mmap(cast(i64, 0), cap, sys.PROT_READ | sys.PROT_WRITE);
    if (va < 0) { prog.outs("sort: out of memory\n"); return cast(i32, 1); }
    let is i64 as got with mut = 0;
    let is i64 as nfiles = argc - o.ind;
    let is i32 as rc with mut = 0;
    let is i64 as inputs with mut = nfiles;
    if (inputs <= 0) { inputs = 1; }
    let is i64 as di with mut = 0;
    let is i64 as fi with mut = o.ind;
    while (di < inputs) {
        let is i64 as fd with mut = 0;
        let is i64 as opened with mut = 1;
        if (nfiles > 0) {
            let is *u8 as name = prog.arg(argv, fi);
            let is [256]u8 as pb;
            let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
            fd = sys.open_read(path);
            if (fd < 0) { prog.outs("sort: "); prog.outs(name); prog.outs(": cannot open\n"); rc = cast(i32, 1); opened = 0; }
        }
        if (opened == 1) {
            while (1 == 1) {
                if (got >= cap) {
                    let is i64 as nc = cap * 2;
                    let is i64 as nva = sys.mmap(cast(i64, 0), nc, sys.PROT_READ | sys.PROT_WRITE);
                    if (nva < 0) { prog.outs("sort: out of memory\n"); return cast(i32, 1); }
                    let is *u8 as s = cast(*u8, va); let is *u8 as d = cast(*u8, nva);
                    let is i64 as k with mut = 0; while (k < got) { d[k] = s[k]; k = k + 1; }
                    sys.munmap(va, cap); va = nva; cap = nc;
                }
                let is i64 as n = sys.read(fd, cast(*u8, va + got), cap - got);
                if (n <= 0) { break; }
                got = got + n;
            }
            if (fd != 0) { sys.close(fd); }
        }
        fi = fi + 1; di = di + 1;
    }

    g_base = va;
    let is *u8 as p = cast(*u8, va);
    if (got == 0) { return rc; }
    // index line starts/lengths (a trailing newline doesn't make an empty line)
    let is i64 as nl with mut = 0;
    let is i64 as i with mut = 0;
    while (i < got) { if (cast(i64, p[i]) == 0x0A) { nl = nl + 1; } i = i + 1; }
    if (cast(i64, p[got - 1]) != 0x0A) { nl = nl + 1; }
    let is i64 as isz = fu.page_round(nl * 16);
    let is i64 as iva = sys.mmap(cast(i64, 0), isz, sys.PROT_READ | sys.PROT_WRITE);
    if (iva < 0) { prog.outs("sort: out of memory\n"); return cast(i32, 1); }
    let is *i64 as idx = cast(*i64, iva);
    let is i64 as li with mut = 0;
    let is i64 as start with mut = 0;
    i = 0;
    while (i < got) {
        if (cast(i64, p[i]) == 0x0A) { idx[li * 2] = start; idx[li * 2 + 1] = i - start; li = li + 1; start = i + 1; }
        i = i + 1;
    }
    if (start < got) { idx[li * 2] = start; idx[li * 2 + 1] = got - start; li = li + 1; }

    qsort_idx(idx, 0, li - 1);

    let is i64 as uniq = (g_fl >> 2) & 1;
    let is i64 as rev = (g_fl >> 1) & 1;
    let is i64 as k2 with mut = 0;
    while (k2 < li) {
        let is i64 as ri with mut = k2;
        if (rev == 1) { ri = li - 1 - k2; }
        let is i64 as dup with mut = 0;
        if (uniq == 1 && k2 > 0) {
            let is i64 as pi = ri;
            let is i64 as prev with mut = ri - 1;
            if (rev == 1) { prev = ri + 1; }
            if (linecmp(idx[ri * 2], idx[ri * 2 + 1], idx[prev * 2], idx[prev * 2 + 1]) == 0) { dup = 1; }
        }
        if (dup == 0) {
            prog.out(cast(*u8, va + idx[ri * 2]), idx[ri * 2 + 1]);
            prog.out("\n", 1);
        }
        k2 = k2 + 1;
    }
    return rc;
}
