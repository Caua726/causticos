// stat — show a file's metadata. `stat <file>`. Reads VfsStat
// {size, first_cluster, attr, is_dir}.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 2) { prog.outs("usage: stat <file>\n"); return cast(i32, 1); }
    let is [256]u8 as pb;
    let is *u8 as path = prog.abspath(prog.arg(argv, 1), cast(*u8, &pb[0]));
    let is [4]i64 as st;
    if (sys.stat(path, cast(*u8, &st[0])) != 0) {
        prog.outs("stat: cannot stat "); prog.outs(path); prog.out("\n", 1);
        return cast(i32, 1);
    }
    prog.outs(path); prog.out("\n", 1);
    prog.outs("  size:    "); prog.out_num(st[0]); prog.outs(" bytes\n");
    prog.outs("  type:    ");
    if (st[3] != 0) { prog.outs("directory\n"); } else { prog.outs("file\n"); }
    prog.outs("  cluster: "); prog.out_num(st[1]); prog.out("\n", 1);
    prog.outs("  attr:    "); prog.out_num(st[2]); prog.out("\n", 1);
    return 0;
}
