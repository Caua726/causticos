// fold — wrap each input line to a width. fold [-w N] [-s] [file ...].
// -w N width (default 80, capped at 8192), -s break at the last blank within
// the width when possible. No file (or `-`) reads stdin.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn fold_stream(r as *fu.Reader, width as i64, sflag as i64) as void {
    let is [8192]u8 as seg;
    let is i64 as sl with mut = 0;
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(r);
        if (c < 0) { break; }
        if (c == 0x0A) {
            prog.out(cast(*u8, &seg[0]), sl); prog.out("\n", 1); sl = 0;
        } else {
            if (sl >= width) {
                let is i64 as bp with mut = 0 - 1;
                if (sflag == 1) {
                    let is i64 as k with mut = sl - 1;
                    while (k >= 0) { let is i64 as sc = cast(i64, seg[k]); if (sc == 32 || sc == 9) { bp = k; break; } k = k - 1; }
                }
                if (bp >= 0) {
                    prog.out(cast(*u8, &seg[0]), bp + 1); prog.out("\n", 1);
                    let is i64 as m with mut = 0;
                    let is i64 as j with mut = bp + 1;
                    while (j < sl) { seg[m] = seg[j]; m = m + 1; j = j + 1; }
                    sl = m;
                } else {
                    prog.out(cast(*u8, &seg[0]), sl); prog.out("\n", 1); sl = 0;
                }
            }
            if (sl < 8192) { seg[sl] = cast(u8, c); sl = sl + 1; }
        }
    }
    if (sl > 0) { prog.out(cast(*u8, &seg[0]), sl); }       // trailing partial line, no added newline
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as width with mut = 80;
    let is i64 as sflag with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "w:s");
        if (f < 0) { break; }
        if (f == 119) { let is *u8 as va = cast(*u8, o.optarg); let is i64 as w = fu.parse_uint(va, prog.slen(va)); if (w > 0) { width = w; } }
        else if (f == 115) { sflag = 1; }
        else { prog.outs("usage: fold [-w N] [-s] [file ...]\n"); return cast(i32, 1); }
    }
    if (width > 8192) { width = 8192; }
    let is i64 as nfiles = argc - o.ind;
    if (nfiles <= 0) {
        let is [4096]u8 as buf;
        let is fu.Reader as r;
        fu.rd_open_fd(&r, cast(i64, 0), cast(*u8, &buf[0]), 4096);
        fold_stream(&r, width, sflag);
        return 0;
    }
    let is i32 as rc with mut = 0;
    let is i64 as i with mut = o.ind;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb;
        let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is [4096]u8 as buf;
        let is fu.Reader as r;
        if (fu.rd_open(&r, path, cast(*u8, &buf[0]), 4096) < 0) {
            prog.outs("fold: "); prog.outs(name); prog.outs(": cannot open\n"); rc = cast(i32, 1);
        } else { fold_stream(&r, width, sflag); fu.rd_close(&r); }
        i = i + 1;
    }
    return rc;
}
