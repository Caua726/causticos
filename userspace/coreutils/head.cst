// head — print the first part of each file.
//   head [-n [-]N] [-c [-]N] [-q] [-v] [file ...]
// -n N first N lines (default 10); -n -N all but the last N lines.
// -c N first N bytes; -c -N all but the last N bytes.
// -q never print the `==> name <==` banner; -v always. No file (or `-`) = stdin.
//
// The first N lines or bytes are read a block at a time and written as they
// arrive, and reading stops there: head of a pipe prints as soon as the lines
// come, and when it exits the writer finds its reader gone. It used to read
// all of its input before printing anything, so `yes | head -n 3` never ended
// (and ate memory until the machine crawled). All-but-the-last-N has to see
// the end before it can print, so that mode still reads everything — and says
// so when there is not enough memory, instead of printing nothing and
// reporting success.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;

// neg=0: first n units; neg=1: all but the last n units.
fn emit_head(base as i64, len as i64, n as i64, bymode as i64, neg as i64) as void {
    if (len <= 0) { return; }
    let is *u8 as p = cast(*u8, base);
    if (bymode == 1) {
        let is i64 as m with mut = n; if (neg != 0) { m = len - n; }
        if (m > len) { m = len; } if (m < 0) { m = 0; }
        prog.out(cast(*u8, base), m);
        return;
    }
    if (neg == 0) {
        let is i64 as printed with mut = 0; let is i64 as i with mut = 0;
        while (i < len) { if (cast(i64, p[i]) == 0x0A) { printed = printed + 1; if (printed >= n) { i = i + 1; break; } } i = i + 1; }
        prog.out(cast(*u8, base), i);
    } else {
        let is i64 as total with mut = 0; let is i64 as t with mut = 0;
        while (t < len) { if (cast(i64, p[t]) == 0x0A) { total = total + 1; } t = t + 1; }
        if (cast(i64, p[len - 1]) != 0x0A) { total = total + 1; }
        let is i64 as keep with mut = total - n; if (keep <= 0) { return; }
        let is i64 as printed with mut = 0; let is i64 as i with mut = 0;
        while (i < len && printed < keep) { if (cast(i64, p[i]) == 0x0A) { printed = printed + 1; } i = i + 1; }
        prog.out(cast(*u8, base), i);
    }
}

// The first n lines (bymode 0) or bytes (bymode 1) of fd, as they arrive. 0, or
// the read error.
fn head_stream(fd as i64, n as i64, bymode as i64) as i64 {
    let is [4096]u8 as buf;
    let is i64 as left with mut = n;          // lines or bytes still to print
    while (left > 0) {
        let is i64 as got = sys.read(fd, cast(*u8, &buf[0]), 4096);
        if (got < 0) { return got; }
        if (got == 0) { return 0; }
        let is i64 as take with mut = got;
        if (bymode == 1) {
            if (take > left) { take = left; }
            left = left - take;
        } else {
            let is i64 as i with mut = 0;
            while (i < got && left > 0) {
                if (buf[i] == cast(u8, 10)) { left = left - 1; }
                i = i + 1;
            }
            take = i;
        }
        prog.out(cast(*u8, &buf[0]), take);
    }
    return 0;
}

fn say(name as *u8, what as *u8) as void {
    prog.outs("head: "); prog.outs(name); prog.outs(": "); prog.outs(what); prog.outs("\n");
}

// parse an -n/-c value, which may be signed (+N or -N). Returns the magnitude;
// sets *neg=1 for a leading '-'. (head treats +N like N.)
fn parse_signed(s as *u8, neg as *i64) as i64 {
    neg[0] = 0; let is i64 as i with mut = 0;
    if (cast(i64, s[0]) == 45) { neg[0] = 1; i = 1; } else if (cast(i64, s[0]) == 43) { i = 1; }
    return fu.parse_uint(cast(*u8, cast(i64, s) + i), 19);
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as n with mut = 10; let is i64 as bymode with mut = 0; let is i64 as neg with mut = 0;
    let is i64 as q with mut = 0; let is i64 as v with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "n:c:qv");
        if (f < 0) { break; }
        if (f == 110) { let is [1]i64 as ng; n = parse_signed(cast(*u8, o.optarg), cast(*i64, &ng[0])); neg = ng[0]; bymode = 0; }
        else if (f == 99) { let is [1]i64 as ng; n = parse_signed(cast(*u8, o.optarg), cast(*i64, &ng[0])); neg = ng[0]; bymode = 1; }
        else if (f == 113) { q = 1; } else if (f == 118) { v = 1; }
        else { prog.outs("usage: head [-n [-]N] [-c [-]N] [-qv] [file ...]\n"); return cast(i32, 1); }
    }
    if (n < 0) { n = 0; }
    let is i64 as nfiles = argc - o.ind;
    if (nfiles <= 0) {
        if (neg == 0) {
            if (head_stream(cast(i64, 0), n, bymode) < 0) { say("standard input", "read error"); return cast(i32, 1); }
            return 0;
        }
        let is i64 as len with mut = 0; let is i64 as base = fu.slurp_fd(cast(i64, 0), &len);
        if (len < 0) { say("standard input", "out of memory"); return cast(i32, 1); }
        if (len > 0) { emit_head(base, len, n, bymode, neg); }
        return 0;
    }
    let is i64 as banner with mut = 0; if (nfiles > 1) { banner = 1; } if (q != 0) { banner = 0; } if (v != 0) { banner = 1; }
    let is i32 as rc with mut = 0; let is i64 as i with mut = o.ind; let is i64 as first with mut = 1;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb; let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is i64 as fd with mut = 0;
        if (fu.is_dash(name) == 0) { fd = sys.open_read(path); }
        if (fd < 0) { say(name, "cannot open"); rc = cast(i32, 1); }
        else {
            if (banner != 0) { if (first == 0) { prog.out("\n", 1); } prog.outs("==> "); prog.outs(name); prog.outs(" <==\n"); }
            first = 0;
            if (neg == 0) {
                if (head_stream(fd, n, bymode) < 0) { say(name, "read error"); rc = cast(i32, 1); }
            } else {
                let is i64 as len with mut = 0; let is i64 as base with mut = 0;
                if (fd == 0) { base = fu.slurp_fd(fd, &len); } else { base = fu.slurp(path, &len); }
                if (len < 0) { say(name, "cannot read (out of memory?)"); rc = cast(i32, 1); }
                else if (len > 0) { emit_head(base, len, n, bymode, neg); if (fd != 0) { fu.unslurp(base, len); } }
            }
            if (fd > 0) { sys.close(fd); }
        }
        i = i + 1;
    }
    return rc;
}
