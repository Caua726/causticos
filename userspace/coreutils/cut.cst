// cut — select bytes/characters or fields from each line.
//   cut -b LIST [file ...]        cut -c LIST [file ...]
//   cut -f LIST [-d D] [-s] [file ...]
// LIST is a comma list of N, N-M, N-, or -M (e.g. 1,3,5-7). -d sets the field
// delimiter (TAB default); -s drops lines with no delimiter (-f). Also supports
// --complement (invert the selection) and --output-delimiter=STR. stdin if no file.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;

let is [8192]u8 as g_sel;
let is i64 as g_openfrom with mut = 0;
let is i64 as g_compl with mut = 0;
let is [256]u8 as g_od;                 // output delimiter string
let is i64 as g_odlen with mut = 0 - 1; // -1 = not set (default to input delim / none)

fn raw_selected(col as i64) as i64 {
    if (g_openfrom > 0 && col >= g_openfrom) { return 1; }
    if (col >= 1 && col < 8192) { if (cast(i64, g_sel[col]) == 1) { return 1; } }
    return 0;
}
fn selected(col as i64) as i64 {
    let is i64 as b = raw_selected(col);
    if (g_compl != 0) { if (b != 0) { return 0; } return 1; }
    return b;
}

fn parse_list(spec as *u8) as void {
    let is i64 as sl = prog.slen(spec);
    let is i64 as i with mut = 0;
    while (i < sl) {
        let is i64 as a with mut = 0; let is i64 as hasa with mut = 0;
        while (i < sl && cast(i64, spec[i]) >= 48 && cast(i64, spec[i]) <= 57) { a = a * 10 + cast(i64, spec[i]) - 48; i = i + 1; hasa = 1; }
        let is i64 as b with mut = a; let is i64 as openend with mut = 0;
        if (i < sl && cast(i64, spec[i]) == 45) {
            i = i + 1;
            if (i < sl && cast(i64, spec[i]) >= 48 && cast(i64, spec[i]) <= 57) { b = 0; while (i < sl && cast(i64, spec[i]) >= 48 && cast(i64, spec[i]) <= 57) { b = b * 10 + cast(i64, spec[i]) - 48; i = i + 1; } }
            else { openend = 1; }
            if (hasa == 0) { a = 1; }
        }
        if (openend == 1) { if (g_openfrom == 0 || a < g_openfrom) { g_openfrom = a; } }
        else { let is i64 as c with mut = a; while (c <= b) { if (c >= 1 && c < 8192) { g_sel[c] = cast(u8, 1); } c = c + 1; } }
        if (i < sl && cast(i64, spec[i]) == 44) { i = i + 1; }
        else if (i < sl && (cast(i64, spec[i]) < 48 || cast(i64, spec[i]) > 57)) { i = i + 1; }
    }
}

fn put_odelim(in_delim as i64) as void {
    if (g_odlen >= 0) { prog.out(cast(*u8, &g_od[0]), g_odlen); }
    else { let is [1]u8 as d; d[0] = cast(u8, in_delim); prog.out(cast(*u8, &d[0]), 1); }
}

fn cut_line(line as *u8, ll as i64, mode as i64, delim as i64, sflag as i64) as void {
    if (mode == 1) {                                       // -b / -c: positions
        let is i64 as pos with mut = 1; let is i64 as prev_sel with mut = 0; let is i64 as didout with mut = 0;
        while (pos <= ll) {
            if (selected(pos) == 1) {
                if (g_odlen >= 0 && prev_sel == 0 && didout == 1) { prog.out(cast(*u8, &g_od[0]), g_odlen); }
                prog.out(cast(*u8, cast(i64, line) + (pos - 1)), 1); didout = 1; prev_sel = 1;
            } else { prev_sel = 0; }
            pos = pos + 1;
        }
        prog.out("\n", 1);
    } else {                                               // -f: fields
        let is i64 as hasd with mut = 0; let is i64 as k with mut = 0;
        while (k < ll) { if (cast(i64, line[k]) == delim) { hasd = 1; break; } k = k + 1; }
        if (hasd == 0) { if (sflag == 0) { prog.out(line, ll); prog.out("\n", 1); } return; }
        let is i64 as fnum with mut = 1; let is i64 as fs with mut = 0; let is i64 as first_out with mut = 1;
        let is i64 as i with mut = 0;
        while (i <= ll) {
            if (i == ll || cast(i64, line[i]) == delim) {
                if (selected(fnum) == 1) {
                    if (first_out == 0) { put_odelim(delim); }
                    first_out = 0;
                    prog.out(cast(*u8, cast(i64, line) + fs), i - fs);
                }
                fnum = fnum + 1; fs = i + 1;
            }
            i = i + 1;
        }
        prog.out("\n", 1);
    }
}

fn cut_stream(r as *fu.Reader, mode as i64, delim as i64, sflag as i64) as void {
    let is [65536]u8 as line; let is i64 as ll with mut = 0;
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(r);
        if (c < 0 || c == 0x0A) {
            if (c == 0x0A || ll > 0) { cut_line(cast(*u8, &line[0]), ll, mode, delim, sflag); }
            ll = 0;
            if (c < 0) { break; }
        } else { if (ll < 65536) { line[ll] = cast(u8, c); ll = ll + 1; } }
    }
}

fn streq(a as *u8, b as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (cast(i64, a[i]) != 0 && cast(i64, b[i]) != 0) { if (cast(i64, a[i]) != cast(i64, b[i])) { return 0; } i = i + 1; }
    if (cast(i64, a[i]) == cast(i64, b[i])) { return 1; }
    return 0;
}
fn starts(a as *u8, pre as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (cast(i64, pre[i]) != 0) { if (cast(i64, a[i]) != cast(i64, pre[i])) { return 0; } i = i + 1; }
    return 1;
}

fn usage() as i32 { prog.outs("usage: cut -b LIST | -c LIST | -f LIST [-d D] [-s] [--complement] [--output-delimiter=S] [file ...]\n"); return cast(i32, 1); }

fn main(argc as i64, argv as *u8) as i32 {
    let is i64 as mode with mut = 0; let is i64 as delim with mut = 9; let is i64 as sflag with mut = 0;
    let is i64 as i with mut = 1; let is i64 as fstart with mut = 0;
    while (i < argc) {
        let is *u8 as a = prog.arg(argv, i);
        if (streq(a, "--complement") != 0) { g_compl = 1; i = i + 1; }
        else if (starts(a, "--output-delimiter=") != 0) {
            let is i64 as k with mut = 19; g_odlen = 0;
            while (cast(i64, a[k]) != 0 && g_odlen < 255) { g_od[g_odlen] = a[k]; g_odlen = g_odlen + 1; k = k + 1; }
            i = i + 1;
        }
        else if (streq(a, "--") != 0) { i = i + 1; fstart = i; break; }
        else if (cast(i64, a[0]) == 45 && cast(i64, a[1]) != 0) {
            let is i64 as c = cast(i64, a[1]);
            if (c == 99 || c == 102 || c == 98) {                          // -c / -f / -b
                if (c == 102) { mode = 2; } else { mode = 1; }
                let is *u8 as val with mut = cast(*u8, cast(i64, a) + 2);
                if (cast(i64, a[2]) == 0) { i = i + 1; if (i < argc) { val = prog.arg(argv, i); } }
                parse_list(val); i = i + 1;
            } else if (c == 100) {                                         // -d
                let is *u8 as val with mut = cast(*u8, cast(i64, a) + 2);
                if (cast(i64, a[2]) == 0) { i = i + 1; if (i < argc) { val = prog.arg(argv, i); } }
                delim = cast(i64, val[0]); i = i + 1;
            } else if (c == 115) { sflag = 1; i = i + 1; }                  // -s
            else if (c == 110) { i = i + 1; }                              // -n (no-op, ASCII)
            else { return usage(); }
        }
        else { fstart = i; break; }
        if (fstart != 0) { break; }
    }
    if (mode == 0) { return usage(); }
    if (fstart == 0) { fstart = i; }

    let is i64 as nfiles = argc - fstart;
    if (nfiles <= 0) {
        let is [4096]u8 as buf; let is fu.Reader as r;
        fu.rd_open_fd(&r, cast(i64, 0), cast(*u8, &buf[0]), 4096);
        cut_stream(&r, mode, delim, sflag);
        return 0;
    }
    let is i32 as rc with mut = 0; let is i64 as fi with mut = fstart;
    while (fi < argc) {
        let is *u8 as name = prog.arg(argv, fi);
        let is [256]u8 as pb; let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is [4096]u8 as buf; let is fu.Reader as r;
        if (fu.rd_open(&r, path, cast(*u8, &buf[0]), 4096) < 0) { prog.outs("cut: "); prog.outs(name); prog.outs(": cannot open\n"); rc = cast(i32, 1); }
        else { cut_stream(&r, mode, delim, sflag); fu.rd_close(&r); }
        fi = fi + 1;
    }
    return rc;
}
