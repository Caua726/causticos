// tail — print the last part of each file.
//   tail [-n [+]N] [-c [+]N] [-q] [-v] [-f] [file ...]
//   tail [-N | +N][b|c|l][f] [file]       (the classic form, see obsolete())
// -n N last N lines (default 10); -n +N from line N onward (1-based).
// -c N last N bytes; -c +N from byte N onward. -q never banner; -v always.
// -f follow: after the initial tail, keep polling the file's size and
//   print whatever is appended (until EOF on the fd, which is rare for
//   a regular file; in practice the user aborts via the shell).
//   Polling-by-design — files always report READABLE on SYS_POLL, so a
//   stat-every-100ms loop is the honest way to detect growth. -f is
//   only meaningful for a single file; with multiple files it follows
//   the last one (GNU behaviour).
// No file (or `-`) reads stdin.
//
// From-N-onward (+N) is read and written as it arrives, so it works on a pipe
// that never ends. The last N lines or bytes cannot be known before the input
// ends; that mode reads all of it first, as it must, and says so when there is
// not enough memory instead of printing nothing.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;

// Everything from line (bymode 0) or byte (bymode 1) n onward (1-based), as it
// arrives. 0, or the read error.
fn tail_from(fd as i64, n as i64, bymode as i64) as i64 {
    let is [4096]u8 as buf;
    let is i64 as skip with mut = n - 1;     // lines or bytes still to pass over
    if (skip < 0) { skip = 0; }
    while (1 == 1) {
        let is i64 as got = sys.read(fd, cast(*u8, &buf[0]), 4096);
        if (got < 0) { return got; }
        if (got == 0) { return 0; }
        let is i64 as i with mut = 0;
        if (bymode == 1) {
            i = skip;
            if (i > got) { i = got; }
            skip = skip - i;
        } else {
            while (i < got && skip > 0) {
                if (buf[i] == cast(u8, 10)) { skip = skip - 1; }
                i = i + 1;
            }
        }
        if (i < got) { prog.out(cast(*u8, cast(i64, &buf[0]) + i), got - i); }
    }
    return 0;
}

// plus=0: last n units; plus=1: from unit N (1-based) to the end.
fn emit_tail(base as i64, len as i64, n as i64, bymode as i64, plus as i64) as void {
    if (len <= 0) { return; }
    let is *u8 as p = cast(*u8, base);
    if (bymode == 1) {
        let is i64 as start with mut = len - n;
        if (plus != 0) { start = n - 1; }
        if (start < 0) { start = 0; } if (start > len) { start = len; }
        prog.out(cast(*u8, base + start), len - start);
        return;
    }
    if (plus != 0) {
        let is i64 as skipped with mut = 0; let is i64 as i with mut = 0;
        while (i < len && skipped < n - 1) { if (cast(i64, p[i]) == 0x0A) { skipped = skipped + 1; } i = i + 1; }
        prog.out(cast(*u8, base + i), len - i);
        return;
    }
    // The last zero lines are none: the scan below would find no zeroth
    // newline and print everything.
    if (n <= 0) { return; }
    let is i64 as i with mut = len - 1;
    if (cast(i64, p[i]) == 0x0A) { i = i - 1; }      // ignore one trailing newline
    let is i64 as seen with mut = 0; let is i64 as start with mut = 0;
    while (i >= 0) { if (cast(i64, p[i]) == 0x0A) { seen = seen + 1; if (seen == n) { start = i + 1; break; } } i = i - 1; }
    prog.out(cast(*u8, base + start), len - start);
}

// parse an -n/-c value; sets *plus=1 for a leading '+'.
fn parse_signed(s as *u8, plus as *i64) as i64 {
    plus[0] = 0; let is i64 as i with mut = 0;
    if (cast(i64, s[0]) == 43) { plus[0] = 1; i = 1; } else if (cast(i64, s[0]) == 45) { i = 1; }
    return fu.parse_uint(cast(*u8, cast(i64, s) + i), 19);
}

// follow_loop: after the initial tail, keep polling path's size and
// print whatever is appended. Sleeps 100ms between polls. Reads via
// mmap_fd when the delta is large (> 4096 bytes — mmap overhead is
// worth it), read-loop otherwise. Stops when the fd reports E_PIPE
// (peer closed — rare on a regular file) or E_BADF (file unlinked).
fn follow_loop(path as *u8) as void {
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { return; }
    // Start at the current end-of-file.
    let is [4]i64 as st;
    if (sys.stat(path, cast(*u8, &st[0])) != 0) { sys.close(fd); return; }
    let is i64 as pos with mut = st[0];
    let is [4096]u8 as buf;
    while (1 == 1) {
        sys.sleep_ns(100000000);                       // 100 ms
        if (sys.stat(path, cast(*u8, &st[0])) != 0) { sys.close(fd); return; }
        let is i64 as sz = st[0];
        if (sz < pos) { pos = sz; }                   // truncation → reset
        if (sz == pos) { continue; }                  // no growth yet
        let is i64 as delta = sz - pos;
        if (delta < 4096) {
            // Read the small delta via sys.lseek + sys.read.
            sys.lseek(fd, pos, sys.SEEK_SET);
            let is i64 as got = sys.read(fd, cast(*u8, &buf[0]), delta);
            if (got > 0) { prog.out(cast(*u8, &buf[0]), got); pos = pos + got; }
        } else {
            // Big delta: mmap the new range, print, munmap.
            sys.lseek(fd, pos, sys.SEEK_SET);
            let is i64 as va = sys.mmap_fd(sys.PROT_READ, fd);
            if (va > 0) {
                prog.out(cast(*u8, va), delta);
                sys.munmap(va, fu.page_round(delta));
            }
            pos = pos + delta;
        }
    }
}

// obsolete — GNU's classic form: the first argument is [-+][N][b|c|l][f],
// with at most one file after it (or `--` and one file). -5 is the last five
// lines and +5 from the fifth on; c counts bytes, b 512-byte blocks, l lines,
// and f follows. No number means 10, and a number too large to hold means as
// many as there are (GNU saturates it too). Anything else — another option, a
// second file, a suffix GNU does not know — is not this form, and the digits
// are then an ordinary option, which is an error (as in GNU). 1 when argv[1]
// was it, 0 otherwise.
fn obsolete(argc as i64, argv as *u8, n as *i64, bymode as *i64, plus as *i64, follow as *i64) as i64 {
    if (argc < 2) { return 0; }
    let is i64 as ok with mut = 0;
    if (argc == 2) { ok = 1; }
    if (argc >= 3) {
        let is *u8 as a2 = prog.arg(argv, 2);
        if (argc == 3 && (a2[0] != cast(u8, 45) || a2[1] == cast(u8, 0))) { ok = 1; }
        if (argc <= 4 && a2[0] == cast(u8, 45) && a2[1] == cast(u8, 45) && a2[2] == cast(u8, 0)) { ok = 1; }
    }
    if (ok == 0) { return 0; }
    let is *u8 as p = prog.arg(argv, 1);
    let is i64 as from with mut = 0;
    if (p[0] == cast(u8, 43)) { from = 1; }                                    // '+'
    else if (p[0] == cast(u8, 45)) {                                           // '-'
        // "-" is standard input and "-c" wants its value: neither is this form.
        if (p[1] == cast(u8, 0)) { return 0; }
        if (p[1] == cast(u8, 99) && p[2] == cast(u8, 0)) { return 0; }
    } else { return 0; }
    let is i64 as k with mut = 1;
    let is i64 as v with mut = 0;
    let is i64 as digits with mut = 0;
    let is i64 as max = 0x7fffffffffffffff;
    while (p[k] >= cast(u8, 48) && p[k] <= cast(u8, 57)) {
        let is i64 as d = cast(i64, p[k]) - 48;
        if (v > (max - d) / 10) { v = max; } else { v = v * 10 + d; }
        digits = digits + 1;
        k = k + 1;
    }
    let is i64 as bytes with mut = 0;
    let is i64 as unit with mut = 1;
    if (p[k] == cast(u8, 98)) { bytes = 1; unit = 512; k = k + 1; }           // 'b'
    else if (p[k] == cast(u8, 99)) { bytes = 1; k = k + 1; }                  // 'c'
    else if (p[k] == cast(u8, 108)) { k = k + 1; }                            // 'l'
    let is i64 as f with mut = 0;
    if (p[k] == cast(u8, 102)) { f = 1; k = k + 1; }                          // 'f'
    if (p[k] != cast(u8, 0)) { return 0; }
    if (digits == 0) { v = 10; }
    if (v > max / unit) { n[0] = max; } else { n[0] = v * unit; }
    bymode[0] = bytes;
    plus[0] = from;
    follow[0] = f;
    return 1;
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as n with mut = 10; let is i64 as bymode with mut = 0; let is i64 as plus with mut = 0;
    let is i64 as q with mut = 0; let is i64 as v with mut = 0;
    let is i64 as follow with mut = 0;
    let is [4]i64 as ob;
    if (obsolete(argc, argv, &ob[0], &ob[1], &ob[2], &ob[3]) == 1) {
        n = ob[0]; bymode = ob[1]; plus = ob[2]; follow = ob[3]; o.ind = 2;
    }
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "n:c:qvf");
        if (f < 0) { break; }
        if (f == 110) { let is [1]i64 as pl; n = parse_signed(cast(*u8, o.optarg), cast(*i64, &pl[0])); plus = pl[0]; bymode = 0; }
        else if (f == 99) { let is [1]i64 as pl; n = parse_signed(cast(*u8, o.optarg), cast(*i64, &pl[0])); plus = pl[0]; bymode = 1; }
        else if (f == 113) { q = 1; } else if (f == 118) { v = 1; }
        else if (f == 102) { follow = 1; }
        else { prog.errs("usage: tail [-n [+]N] [-c [+]N] [-qvf] [file ...]\n       tail [-N | +N][b|c|l][f] [file]\n"); return cast(i32, 1); }
    }
    if (n < 0) { n = 0; }
    let is i64 as nfiles = argc - o.ind;
    if (nfiles <= 0) {
        if (plus != 0) {
            if (tail_from(cast(i64, 0), n, bymode) < 0) { prog.errs("tail: standard input: read error\n"); return cast(i32, 1); }
            return 0;
        }
        let is i64 as len with mut = 0; let is i64 as base = fu.slurp_fd(cast(i64, 0), &len);
        if (len < 0) { prog.errs("tail: standard input: out of memory\n"); return cast(i32, 1); }
        if (len > 0) { emit_tail(base, len, n, bymode, plus); }
        return 0;
    }
    let is i64 as banner with mut = 0; if (nfiles > 1) { banner = 1; } if (q != 0) { banner = 0; } if (v != 0) { banner = 1; }
    let is i32 as rc with mut = 0; let is i64 as i with mut = o.ind; let is i64 as first with mut = 1;
    let is [256]u8 as last_pb;
    let is *u8 as last_path with mut = cast(*u8, 0);
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb; let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is i64 as len with mut = 0; let is i64 as base = fu.slurp(path, &len);
        if (len < 0) { prog.errs("tail: "); prog.errs(name); prog.errs(": cannot open\n"); rc = cast(i32, 1); }
        else {
            if (banner != 0) { if (first == 0) { prog.out("\n", 1); } prog.outs("==> "); prog.outs(name); prog.outs(" <==\n"); }
            first = 0;
            if (len > 0) { emit_tail(base, len, n, bymode, plus); fu.unslurp(base, len); }
            // Remember the last file for -f (GNU convention).
            let is i64 as k with mut = 0;
            while (k < 256 && cast(i64, path[k]) != 0) { last_pb[k] = path[k]; k = k + 1; }
            last_pb[k] = cast(u8, 0);
            last_path = cast(*u8, &last_pb[0]);
        }
        i = i + 1;
    }
    if (follow != 0 && cast(i64, last_path) != 0) { follow_loop(last_path); }
    return rc;
}
