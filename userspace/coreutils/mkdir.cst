// mkdir — create directories. mkdir [-p] dir ...
// -p make parent directories as needed, and succeed if the target exists.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;

fn mkdir_p(path as *u8, plen as i64) as void {
    let is [512]u8 as b;
    let is i64 as k with mut = 0;
    while (k < plen) { b[k] = path[k]; k = k + 1; }
    b[plen] = cast(u8, 0);
    let is i64 as i with mut = 1;
    while (i <= plen) {
        if (i == plen || cast(i64, b[i]) == 47) {
            let is i64 as save = cast(i64, b[i]);
            b[i] = cast(u8, 0);
            if (i > 1) { sys.mkdir(cast(*u8, &b[0])); }        // ignore errors (already-exists is fine)
            b[i] = cast(u8, save);
        }
        i = i + 1;
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as pflag with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "p");
        if (f < 0) { break; }
        if (f == 112) { pflag = 1; } else { prog.outs("usage: mkdir [-p] dir ...\n"); return cast(i32, 1); }
    }
    if (argc - o.ind <= 0) { prog.outs("usage: mkdir [-p] dir ...\n"); return cast(i32, 1); }
    let is i32 as rc with mut = 0;
    let is i64 as i with mut = o.ind;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb;
        let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        if (pflag == 1) { mkdir_p(path, prog.slen(path)); }
        else if (sys.mkdir(path) != 0) { prog.outs("mkdir: "); prog.outs(name); prog.outs(": cannot create\n"); rc = cast(i32, 1); }
        i = i + 1;
    }
    return rc;
}
