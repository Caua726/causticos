// basename — strip directory and optional suffix from a path.
//   basename PATH [SUFFIX]
// Prints the final path component; trailing slashes are removed first, and if
// SUFFIX is given and is a proper suffix of the name it is stripped too.
use "std/causticos/prog.cst" as prog;

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 2) { prog.outs("usage: basename PATH [SUFFIX]\n"); return cast(i32, 1); }
    let is *u8 as path = prog.arg(argv, 1);
    let is i64 as len with mut = prog.slen(path);
    while (len > 1 && cast(i64, path[len - 1]) == 47) { len = len - 1; }     // strip trailing '/'
    if (len == 1 && cast(i64, path[0]) == 47) { prog.outs("/\n"); return 0; }
    let is i64 as start with mut = 0; let is i64 as i with mut = 0;
    while (i < len) { if (cast(i64, path[i]) == 47) { start = i + 1; } i = i + 1; }
    let is i64 as nlen with mut = len - start;
    if (argc >= 3) {
        let is *u8 as suf = prog.arg(argv, 2); let is i64 as sl = prog.slen(suf);
        if (sl < nlen) {
            let is i64 as matched with mut = 1; let is i64 as k with mut = 0;
            while (k < sl) { if (cast(i64, path[start + nlen - sl + k]) != cast(i64, suf[k])) { matched = 0; break; } k = k + 1; }
            if (matched != 0) { nlen = nlen - sl; }
        }
    }
    prog.out(cast(*u8, cast(i64, path) + start), nlen); prog.out("\n", 1);
    return 0;
}
