// tree — print the directory tree under a path. tree [-d] [-L N] [path].
// -d only directories, -L N descend at most N levels. Default path is /.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/futil.cst" as fu;

let is i64 as g_dflag with mut = 0;
let is i64 as g_maxd with mut = 0 - 1;

fn tree_walk(path as *u8, plen as i64, depth as i64) as void {
    if (g_maxd >= 0 && depth > g_maxd) { return; }
    let is [8192]u8 as names;
    let is [256]i64 as off; let is [256]i64 as nl; let is [256]i64 as isd;
    let is i64 as cnt = fu.read_dir(path, cast(*u8, &names[0]), 8192, cast(*i64, &off[0]), cast(*i64, &nl[0]), cast(*i64, &isd[0]), 256);
    let is i64 as k with mut = 0;
    while (k < cnt) {
        let is *u8 as nm = cast(*u8, cast(i64, &names[0]) + off[k]);
        if (g_dflag == 0 || isd[k] != 0) {
            let is i64 as d with mut = 0;
            while (d <= depth) { prog.outs("  "); d = d + 1; }
            prog.out(nm, nl[k]);
            if (isd[k] != 0) { prog.outs("/"); }
            prog.out("\n", 1);
        }
        if (isd[k] != 0) {
            let is [512]u8 as child;
            let is i64 as clen = fu.path_join(cast(*u8, &child[0]), path, plen, nm, nl[k]);
            tree_walk(cast(*u8, &child[0]), clen, depth + 1);
        }
        k = k + 1;
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "dL:");
        if (f < 0) { break; }
        if (f == 100) { g_dflag = 1; }
        else if (f == 76) { let is *u8 as va = cast(*u8, o.optarg); g_maxd = fu.parse_uint(va, prog.slen(va)); }
        else { prog.outs("usage: tree [-d] [-L N] [path]\n"); return cast(i32, 1); }
    }
    let is [256]u8 as pb;
    let is *u8 as path with mut = "/";
    if (argc - o.ind > 0) { path = prog.abspath(prog.arg(argv, o.ind), cast(*u8, &pb[0])); }
    prog.outs(path); prog.out("\n", 1);
    tree_walk(path, prog.slen(path), 0);
    return 0;
}
