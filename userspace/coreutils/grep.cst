// grep — print lines matching a pattern: POSIX regular expressions, basic
// unless -E, through lib/regex (linear time for anything without \1).
//
//   grep [options] PATTERN [file ...]
//   grep [options] -e PAT [-e PAT ...] [-f FILE] [file ...]
//
//   -G  basic regexp (the default)   -E  extended regexp   -F  fixed strings
//   -i  ignore case        -v  invert        -w  whole word    -x  whole line
//   -n  line numbers       -o  only matches  -c  count         -m N  stop after N
//   -l  files with matches -L  files without -H  show filename -h  hide filename
//   -r  recurse into dirs  -s  no error msgs -q  quiet (exit only)
//   -A N after  -B N before  -C N around (context, groups split by "--")
//   -e PAT  a pattern (repeatable)   -f FILE  a pattern per line of FILE
//
// A line matches if any pattern does. Each pattern is its own expression — a
// \1 in one refers to its own group — and one with newlines in it is one
// pattern per line, as GNU's.
//
// Exit 0 if a line matched, 1 if none, 2 on error.
//
// Input is read a line at a time and matches are written as they are found:
// grep on a pipe prints as its input arrives (and -m, -q, -l stop reading once
// the answer is known). It used to read each input whole before looking at the
// first line.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;
use "../lib/regex/regex.cst" as re;

// ---- flags / state (globals to keep the per-line path lean) ----
let is i64 as G_i with mut = 0; let is i64 as G_v with mut = 0; let is i64 as G_c with mut = 0;
let is i64 as G_l with mut = 0; let is i64 as G_L with mut = 0; let is i64 as G_n with mut = 0;
let is i64 as G_H with mut = 0; let is i64 as G_h with mut = 0; let is i64 as G_o with mut = 0;
let is i64 as G_w with mut = 0; let is i64 as G_x with mut = 0; let is i64 as G_q with mut = 0;
let is i64 as G_s with mut = 0; let is i64 as G_r with mut = 0;
let is i64 as G_A with mut = 0; let is i64 as G_B with mut = 0; let is i64 as G_m with mut = 0;
let is i64 as G_multi with mut = 0; let is i64 as G_any with mut = 0; let is i64 as G_exit with mut = 0;

// The patterns as given: (address, length) pairs in a mapping that grows, and
// then each one compiled.
let is i64 as P_VA with mut = 0;           // [P_CAP][2]i64
let is i64 as P_CAP with mut = 0;
let is i64 as P_N with mut = 0;
let is i64 as RX_VA with mut = 0;          // [P_N]re.Regex
let is i64 as G_SYNTAX with mut = 0;       // re.RE_EXTENDED / re.RE_FIXED, or 0 for BRE
let is i64 as G_XF with mut = 0;           // the search flags -w and -x make
let is i64 as G_SEARCH_ERR with mut = 0;   // a search failed (said once)

// The line being looked at, and the before-context ring: copies of the last
// G_B lines that did not match, G_B Lines in one mapping. (It held offsets into
// the whole input, which had to be in memory for that; and it was capped at 64
// lines without a word — -B 100 printed 64.)
let is fu.Line as G_LN;
let is i64 as RB_VA with mut = 0;           // [G_B]fu.Line
let is i64 as RB_N with mut = 0;
let is i64 as RB_HEAD with mut = 0;
let is i64 as G_GROUPED with mut = 0;       // 1 if A or B > 0 (print "--" separators)

fn rb_line(i as i64) as *fu.Line { return cast(*fu.Line, RB_VA + i * sizeof(fu.Line)); }

fn rx(i as i64) as *re.Regex { return cast(*re.Regex, RX_VA + i * sizeof(re.Regex)); }

// Add the pattern p[0..n) — one per line of it.
fn pat_add(p as *u8, n as i64) as i64 {
    let is i64 as a with mut = 0;
    while (1 == 1) {
        let is i64 as b with mut = a;
        while (b < n && p[b] != cast(u8, 10)) { b = b + 1; }
        if (P_N == P_CAP) {
            let is i64 as nc with mut = P_CAP * 2; if (nc < 64) { nc = 64; }
            let is i64 as va = sys.mmap(0, fu.page_round(nc * 16), sys.PROT_READ | sys.PROT_WRITE);
            if (va < 0) { return sys.E_NOMEM; }
            let is *i64 as d = cast(*i64, va);
            let is i64 as k with mut = 0;
            if (P_VA != 0) {
                let is *i64 as o = cast(*i64, P_VA);
                while (k < P_N * 2) { d[k] = o[k]; k = k + 1; }
                sys.munmap(P_VA, fu.page_round(P_CAP * 16));
            }
            P_VA = va; P_CAP = nc;
        }
        let is *i64 as pl = cast(*i64, P_VA);
        pl[P_N * 2] = cast(i64, p) + a; pl[P_N * 2 + 1] = b - a;
        P_N = P_N + 1;
        if (b >= n) { return 0; }
        a = b + 1;
        if (a == n) { return 0; }            // a final newline ends the last pattern, it does not start one
    }
    return 0;
}

// A search that failed (back-references on a line too long to search, or no
// memory): said once; the line counts as not matching and grep exits 2.
fn search_failed(rc as i64) as void {
    if (G_SEARCH_ERR == 0) { prog.errs("grep: "); prog.errs(re.err_text(rc)); prog.errs("\n"); }
    G_SEARCH_ERR = 1;
    G_exit = 2;
}

// Does s[0..llen) match any pattern? -w and -x are search flags (G_XF).
fn line_hit(s as *u8, llen as i64) as i64 {
    let is [2]i64 as m;
    let is i64 as i with mut = 0;
    while (i < P_N) {
        let is i64 as rc = re.search(rx(i), s, llen, 0, G_XF, cast(*i64, &m[0]), 1);
        if (rc == 1) { return 1; }
        if (rc < 0) { search_failed(rc); }
        i = i + 1;
    }
    return 0;
}

fn put_prefix(name as *u8, lineno as i64, sep as i64) as void {
    if (G_multi != 0 && G_h == 0) { prog.outs(name); prog.out(cast(*u8, &sep), 1); }
    if (G_n != 0) { prog.out_num(lineno); prog.out(cast(*u8, &sep), 1); }
}

// -o: every match on the line, left to right, without overlaps: at each point
// the leftmost of all the patterns' matches, the longest of those. Empty
// matches are not printed.
fn print_only(name as *u8, lineno as i64, s as *u8, llen as i64) as void {
    if (G_x != 0) {                     // the match is the line
        if (llen > 0) { let is i64 as colon0 = 58; put_prefix(name, lineno, colon0); prog.out(s, llen); prog.out("\n", 1); }
        return;
    }
    let is i64 as pos with mut = 0;
    let is [2]i64 as m;
    while (pos <= llen) {
        let is i64 as a with mut = 0 - 1; let is i64 as b with mut = 0 - 1;
        let is i64 as i with mut = 0;
        while (i < P_N) {
            let is i64 as rc = re.search(rx(i), s, llen, pos, G_XF & re.X_WORDS, cast(*i64, &m[0]), 1);
            if (rc < 0) { search_failed(rc); }
            if (rc == 1 && (a < 0 || m[0] < a || (m[0] == a && m[1] > b))) { a = m[0]; b = m[1]; }
            i = i + 1;
        }
        if (a < 0) { return; }
        if (b > a) {
            let is i64 as colon = 58; put_prefix(name, lineno, colon);
            prog.out(cast(*u8, &s[a]), b - a); prog.out("\n", 1);
            pos = b;
        } else {
            if (a >= llen) { return; }
            pos = re.char_end(s, llen, a);
        }
    }
}

fn print_line(name as *u8, lineno as i64, s as *u8, llen as i64, sep as i64) as void {
    put_prefix(name, lineno, sep);
    prog.out(s, llen); prog.out("\n", 1);
}

// Every line of fd, for matches, with context. 0, or the error that stopped it
// (a read error, or no memory for a line).
fn grep_fd(name as *u8, fd as i64) as i64 {
    let is [4096]u8 as stage;
    let is fu.Reader as r;
    fu.rd_open_fd(&r, fd, cast(*u8, &stage[0]), 4096);
    RB_N = 0; RB_HEAD = 0;
    let is i64 as lineno with mut = 0;
    let is i64 as after with mut = 0;            // remaining after-context lines to print
    let is i64 as last_end with mut = 0 - 1;     // lineno last printed (for "--")
    let is i64 as fcount with mut = 0;           // matches in this file
    let is i64 as going with mut = 1;
    while (going == 1) {
        let is i64 as got = fu.rd_line(&r, &G_LN);
        if (got < 0) { return got; }
        if (got == 0) { going = 0; }
        else {
            lineno = lineno + 1;
            let is *u8 as ls = cast(*u8, G_LN.va);
            let is i64 as llen = G_LN.len;
            let is i64 as hit with mut = line_hit(ls, llen);
            if (G_v != 0) { if (hit == 0) { hit = 1; } else { hit = 0; } }
            if (hit != 0) {
                G_any = 1; fcount = fcount + 1;
                if (G_q != 0) { return 0; }                  // the exit status is decided
                if (G_c == 0 && G_l == 0 && G_L == 0) {
                    if (G_o != 0) { print_only(name, lineno, ls, llen); }
                    else {
                        // before-context: print the ring, with a "--" if there is a gap
                        if (G_GROUPED != 0 && last_end >= 0) {
                            let is i64 as firstctx with mut = lineno - RB_N;
                            if (firstctx > last_end + 1) { prog.outs("--\n"); }
                        }
                        let is i64 as k with mut = 0;
                        while (k < RB_N) {
                            let is *fu.Line as cl = rb_line((RB_HEAD - RB_N + k + G_B) % G_B);
                            print_line(name, lineno - RB_N + k, cast(*u8, cl.va), cl.len, 45);
                            k = k + 1;
                        }
                        print_line(name, lineno, ls, llen, 58);
                        last_end = lineno;
                        after = G_A;
                    }
                    RB_N = 0; RB_HEAD = 0;            // ring consumed
                }
                if (G_l != 0 || G_L != 0) { going = 0; }   // this file's answer is in
                if (G_m != 0 && fcount >= G_m) { going = 0; }
            } else {
                if (after > 0 && G_o == 0 && G_c == 0 && G_l == 0 && G_L == 0) {
                    print_line(name, lineno, ls, llen, 45);
                    last_end = lineno; after = after - 1;
                } else if (G_B > 0 && G_o == 0) {
                    if (fu.line_copy(rb_line(RB_HEAD), &G_LN) != 0) { return sys.E_NOMEM; }
                    RB_HEAD = (RB_HEAD + 1) % G_B;
                    if (RB_N < G_B) { RB_N = RB_N + 1; }
                }
            }
        }
    }
    if (G_c != 0) {
        if (G_multi != 0 && G_h == 0) { prog.outs(name); prog.outs(":"); }
        prog.out_num(fcount); prog.out("\n", 1);
    } else if (G_l != 0) {
        if (fcount > 0) { prog.outs(name); prog.out("\n", 1); }
    } else if (G_L != 0) {
        if (fcount == 0) { prog.outs(name); prog.out("\n", 1); }
    }
    return 0;
}

fn read_failed(name as *u8, rc as i64) as void {
    if (G_s == 0) { prog.errs("grep: "); prog.errs(name); prog.errs(": "); prog.errs(sys.err_text(rc)); prog.errs("\n"); }
    G_exit = 2;
}

fn do_path(name as *u8, path as *u8) as void {
    let is i64 as fd with mut = 0;
    if (fu.is_dash(name) == 0) { fd = sys.open_read(path); }
    if (fd < 0) {
        if (G_s == 0) { prog.errs("grep: "); prog.errs(name); prog.errs(": "); prog.errs(sys.err_text(fd)); prog.errs("\n"); }
        G_exit = 2; return;
    }
    let is i64 as rc = grep_fd(name, fd);
    if (fd > 0) { sys.close(fd); }
    if (rc < 0) { read_failed(name, rc); }
}

// a path is a directory iff opening it and calling readdir succeeds (a regular
// file's readdir fails). Returns 1 dir, 0 file, -1 cannot open.
fn path_is_dir(path as *u8) as i64 {
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { return 0 - 1; }
    let is [320]u8 as de;
    let is i64 as rr = sys.readdir(fd, cast(*u8, &de[0]));
    sys.close(fd);
    if (rr == 0) { return 1; }
    return 0;
}

// recursive descent: grep every regular file under `path`.
fn do_recursive(name as *u8, path as *u8) as void {
    let is i64 as d = path_is_dir(path);
    if (d < 0) {
        if (G_s == 0) { prog.errs("grep: "); prog.errs(name); prog.errs(": "); prog.errs(sys.err_text(sys.E_NOENT)); prog.errs("\n"); }
        G_exit = 2; return;
    }
    if (d == 0) { do_path(name, path); return; }
    let is [4096]u8 as names; let is [128]i64 as off; let is [128]i64 as nlen; let is [128]i64 as isdir;
    let is i64 as nent = fu.read_dir(path, cast(*u8, &names[0]), 4096, cast(*i64, &off[0]), cast(*i64, &nlen[0]), cast(*i64, &isdir[0]), 128);
    let is i64 as i with mut = 0;
    while (i < nent) {
        let is [512]u8 as childp; let is [512]u8 as childn;
        fu.path_join(cast(*u8, &childp[0]), path, prog.slen(path), cast(*u8, &names[off[i]]), nlen[i]);
        fu.path_join(cast(*u8, &childn[0]), name, prog.slen(name), cast(*u8, &names[off[i]]), nlen[i]);
        do_recursive(cast(*u8, &childn[0]), cast(*u8, &childp[0]));
        i = i + 1;
    }
}

fn usage() as i32 { prog.errs("usage: grep [-GEFivwxnoclLHhrsq] [-A n] [-B n] [-C n] [-m n] [-e pat] [-f file] PATTERN [file ...]\n"); return cast(i32, 2); }

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as npat with mut = 0;
    let is i64 as want_C with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "GEFivwxnoclLHhrsqA:B:C:m:e:f:");
        if (f < 0) { break; }
        if (f == 71) { G_SYNTAX = 0; }                                       // -G
        else if (f == 69) { G_SYNTAX = re.RE_EXTENDED; }                     // -E
        else if (f == 70) { G_SYNTAX = re.RE_FIXED; }                        // -F
        else if (f == 105) { G_i = 1; }
        else if (f == 118) { G_v = 1; }
        else if (f == 119) { G_w = 1; }
        else if (f == 120) { G_x = 1; }
        else if (f == 110) { G_n = 1; }
        else if (f == 111) { G_o = 1; }
        else if (f == 99) { G_c = 1; }
        else if (f == 108) { G_l = 1; }
        else if (f == 76) { G_L = 1; }
        else if (f == 72) { G_H = 1; }
        else if (f == 104) { G_h = 1; }
        else if (f == 114) { G_r = 1; }
        else if (f == 115) { G_s = 1; }
        else if (f == 113) { G_q = 1; }
        else if (f == 65) { G_A = fu.parse_uint(cast(*u8, o.optarg), 19); }   // -A
        else if (f == 66) { G_B = fu.parse_uint(cast(*u8, o.optarg), 19); }   // -B
        else if (f == 67) { want_C = fu.parse_uint(cast(*u8, o.optarg), 19); } // -C
        else if (f == 109) { G_m = fu.parse_uint(cast(*u8, o.optarg), 19); }  // -m
        else if (f == 101) {                                                 // -e
            let is *u8 as p = cast(*u8, o.optarg);
            if (pat_add(p, prog.slen(p)) != 0) { prog.errs("grep: out of memory\n"); return cast(i32, 2); }
            npat = npat + 1;
        }
        else if (f == 102) {                                                 // -f
            let is *u8 as fname = cast(*u8, o.optarg);
            let is [256]u8 as fpb;
            let is [1]i64 as flen;
            let is i64 as fva with mut = 0;
            let is *u8 as fpath = prog.abspath(fname, cast(*u8, &fpb[0]));
            if (fu.is_dash(fname) == 1) { fva = fu.slurp_fd(0, cast(*i64, &flen[0])); }
            else { fva = fu.slurp(fpath, cast(*i64, &flen[0])); }
            if (flen[0] < 0) {
                // slurp keeps no error code: opening again names what is wrong
                let is i64 as why with mut = sys.E_IO;
                if (fu.is_dash(fname) == 0) { let is i64 as fd = sys.open_read(fpath); if (fd < 0) { why = fd; } else { sys.close(fd); } }
                prog.errs("grep: "); prog.errs(fname); prog.errs(": "); prog.errs(sys.err_text(why)); prog.errs("\n");
                return cast(i32, 2);
            }
            // an empty file is no patterns at all (it matches nothing), not one empty pattern
            if (flen[0] > 0 && pat_add(cast(*u8, fva), flen[0]) != 0) { prog.errs("grep: out of memory\n"); return cast(i32, 2); }
            npat = npat + 1;
        }
        else { return usage(); }
    }
    if (want_C > 0) { if (G_A == 0) { G_A = want_C; } if (G_B == 0) { G_B = want_C; } }
    // -C/-A/-B sanity
    if (G_A < 0) { G_A = 0; } if (G_B < 0) { G_B = 0; }
    if (G_A > 0 || G_B > 0) { G_GROUPED = 1; }
    if (G_B > 0) {
        RB_VA = sys.mmap(0, fu.page_round(G_B * sizeof(fu.Line)), sys.PROT_READ | sys.PROT_WRITE);
        if (RB_VA < 0) { prog.outs("grep: out of memory for -B/-C\n"); return cast(i32, 2); }
    }

    // pattern: from -e (already collected) or the first operand
    if (npat == 0) {
        if (o.ind >= argc) { return usage(); }
        let is *u8 as p = prog.arg(argv, o.ind);
        if (pat_add(p, prog.slen(p)) != 0) { prog.errs("grep: out of memory\n"); return cast(i32, 2); }
        o.ind = o.ind + 1;
    }
    let is i64 as cfl with mut = G_SYNTAX;
    if (G_i != 0) { cfl = cfl | re.RE_ICASE; }
    if (G_w != 0) { G_XF = G_XF | re.X_WORDS; }
    if (G_x != 0) { G_XF = G_XF | re.X_ANCHOR | re.X_FULL; }
    if (P_N > 0) {
        RX_VA = sys.mmap(0, fu.page_round(P_N * sizeof(re.Regex)), sys.PROT_READ | sys.PROT_WRITE);
        if (RX_VA < 0) { prog.errs("grep: out of memory\n"); return cast(i32, 2); }
    }
    let is i64 as pi with mut = 0;
    while (pi < P_N) {
        let is *i64 as pl = cast(*i64, P_VA);
        let is i64 as rc = re.compile(rx(pi), cast(*u8, pl[pi * 2]), pl[pi * 2 + 1], cfl);
        if (rc != 0) { prog.errs("grep: "); prog.errs(re.err_text(rc)); prog.errs("\n"); return cast(i32, 2); }
        pi = pi + 1;
    }

    let is i64 as nfiles = argc - o.ind;
    if (nfiles <= 0 && G_r == 0) {
        // stdin
        let is i64 as rc0 = grep_fd("(standard input)", cast(i64, 0));
        if (rc0 < 0) { read_failed("(standard input)", rc0); }
    } else {
        if (nfiles > 1 || G_r != 0) { G_multi = 1; }
        if (G_H != 0) { G_multi = 1; }
        let is i64 as i with mut = o.ind;
        if (nfiles <= 0 && G_r != 0) {
            // grep -r with no path: search "."
            do_recursive(".", ".");
        }
        while (i < argc) {
            let is *u8 as name = prog.arg(argv, i);
            let is [256]u8 as pb;
            let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
            if (G_r != 0) { do_recursive(name, path); } else { do_path(name, path); }
            i = i + 1;
            if (G_q != 0 && G_any != 0) { i = argc; }        // -q: the status is decided
        }
    }

    if (G_exit == 2) { return cast(i32, 2); }
    if (G_any != 0) { return 0; }
    return cast(i32, 1);
}
