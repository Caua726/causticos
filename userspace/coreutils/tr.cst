// tr — translate, squeeze, or delete characters.
//   tr [-cds] SET1 [SET2]
//   -d delete chars in SET1   -s squeeze repeats of the last SET   -c complement SET1
// SET syntax: literals, ranges a-z, escapes \n \t \r \\ \0, repeat [c*n] / [c*],
// and POSIX classes [:alpha:] [:digit:] [:alnum:] [:upper:] [:lower:] [:space:]
// [:blank:] [:punct:] [:print:] [:cntrl:]. Reads stdin, writes stdout.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;

let is [512]i64 as SET1; let is i64 as N1 with mut = 0;
let is [512]i64 as SET2; let is i64 as N2 with mut = 0; let is i64 as FILL2 with mut = 0;

fn emit1(b as i64) as void { if (N1 < 512) { SET1[N1] = b & 255; N1 = N1 + 1; } }
fn emit2(b as i64) as void { if (N2 < 512) { SET2[N2] = b & 255; N2 = N2 + 1; } }

fn esc(spec as *u8, i as *i64) as i64 {
    i[0] = i[0] + 1;                                  // past backslash
    let is i64 as c = cast(i64, spec[i[0]]); i[0] = i[0] + 1;
    if (c == 110) { return 10; } if (c == 116) { return 9; } if (c == 114) { return 13; }
    if (c == 102) { return 12; } if (c == 118) { return 11; } if (c == 48) { return 0; } if (c == 97) { return 7; }
    return c;
}

// add a POSIX class's members (to set 1 or 2 depending on `which`).
fn add_class(name as *u8, which as i64) as void {
    let is i64 as c with mut = 0;
    while (c < 256) {
        let is i64 as m with mut = 0;
        if (streq(name, "alpha") != 0) { if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122)) { m = 1; } }
        else if (streq(name, "digit") != 0) { if (c >= 48 && c <= 57) { m = 1; } }
        else if (streq(name, "alnum") != 0) { if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)) { m = 1; } }
        else if (streq(name, "upper") != 0) { if (c >= 65 && c <= 90) { m = 1; } }
        else if (streq(name, "lower") != 0) { if (c >= 97 && c <= 122) { m = 1; } }
        else if (streq(name, "space") != 0) { if (c == 32 || c == 9 || c == 10 || c == 11 || c == 12 || c == 13) { m = 1; } }
        else if (streq(name, "blank") != 0) { if (c == 32 || c == 9) { m = 1; } }
        else if (streq(name, "cntrl") != 0) { if (c < 32 || c == 127) { m = 1; } }
        else if (streq(name, "print") != 0) { if (c >= 32 && c < 127) { m = 1; } }
        else if (streq(name, "punct") != 0) { if (c >= 33 && c < 127 && (c < 48 || c > 57) && (c < 65 || c > 90) && (c < 97 || c > 122)) { m = 1; } }
        if (m != 0) { if (which == 1) { emit1(c); } else { emit2(c); } }
        c = c + 1;
    }
}
fn streq(a as *u8, b as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (cast(i64, a[i]) != 0 && cast(i64, b[i]) != 0) { if (cast(i64, a[i]) != cast(i64, b[i])) { return 0; } i = i + 1; }
    if (cast(i64, a[i]) == cast(i64, b[i])) { return 1; }
    return 0;
}

// expand `spec` into the given set (which=1 or 2).
fn expand_set(spec as *u8, which as i64) as void {
    let is i64 as sl = prog.slen(spec);
    let is [1]i64 as ip; ip[0] = 0;
    while (ip[0] < sl) {
        let is i64 as i = ip[0];
        let is i64 as c = cast(i64, spec[i]);
        if (c == 91 && i + 1 < sl && cast(i64, spec[i + 1]) == 58) {        // [:class:]
            let is [16]u8 as nm; let is i64 as k with mut = 0; let is i64 as j with mut = i + 2;
            while (j < sl && cast(i64, spec[j]) != 58 && k < 15) { nm[k] = spec[j]; k = k + 1; j = j + 1; }
            nm[k] = cast(u8, 0);
            add_class(cast(*u8, &nm[0]), which);
            while (j < sl && cast(i64, spec[j]) != 93) { j = j + 1; }       // to ']'
            ip[0] = j + 1;
        } else if (c == 91 && i + 2 < sl && cast(i64, spec[i + 2]) == 42) {  // [c*n] or [c*]
            let is i64 as rc = cast(i64, spec[i + 1]); let is i64 as j with mut = i + 3;
            let is i64 as cnt with mut = 0; let is i64 as hasn with mut = 0;
            while (j < sl && cast(i64, spec[j]) >= 48 && cast(i64, spec[j]) <= 57) { cnt = cnt * 10 + (cast(i64, spec[j]) - 48); j = j + 1; hasn = 1; }
            if (j < sl && cast(i64, spec[j]) == 93) { j = j + 1; }
            if (hasn == 0) { if (which == 2) { FILL2 = rc; } }              // [c*] -> fill set2 with rc
            else { let is i64 as r with mut = 0; while (r < cnt) { if (which == 1) { emit1(rc); } else { emit2(rc); } r = r + 1; } }
            ip[0] = j;
        } else {
            let is i64 as ch with mut = c;
            if (c == 92) { ch = esc(spec, cast(*i64, &ip[0])); } else { ip[0] = ip[0] + 1; }
            // range?
            if (ip[0] < sl && cast(i64, spec[ip[0]]) == 45 && ip[0] + 1 < sl) {
                ip[0] = ip[0] + 1;
                let is i64 as hi with mut = cast(i64, spec[ip[0]]);
                if (hi == 92) { hi = esc(spec, cast(*i64, &ip[0])); } else { ip[0] = ip[0] + 1; }
                let is i64 as r with mut = ch; while (r <= hi) { if (which == 1) { emit1(r); } else { emit2(r); } r = r + 1; }
            } else { if (which == 1) { emit1(ch); } else { emit2(ch); } }
        }
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as cflag with mut = 0; let is i64 as dflag with mut = 0; let is i64 as sflag with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "cds");
        if (f < 0) { break; }
        if (f == 99) { cflag = 1; } else if (f == 100) { dflag = 1; } else if (f == 115) { sflag = 1; }
        else { prog.outs("usage: tr [-cds] SET1 [SET2]\n"); return cast(i32, 1); }
    }
    if (o.ind >= argc) { prog.outs("usage: tr [-cds] SET1 [SET2]\n"); return cast(i32, 1); }
    expand_set(prog.arg(argv, o.ind), 1);
    let is i64 as have2 with mut = 0;
    if (o.ind + 1 < argc) { expand_set(prog.arg(argv, o.ind + 1), 2); have2 = 1; }

    // membership of SET1 (after complement)
    let is [256]i64 as in1;
    let is i64 as b with mut = 0; while (b < 256) { in1[b] = 0; b = b + 1; }
    let is i64 as k with mut = 0; while (k < N1) { in1[SET1[k]] = 1; k = k + 1; }
    if (cflag != 0) { b = 0; while (b < 256) { if (in1[b] != 0) { in1[b] = 0; } else { in1[b] = 1; } b = b + 1; } }

    // translation map
    let is [256]i64 as map;
    b = 0; while (b < 256) { map[b] = b; b = b + 1; }
    let is i64 as translate with mut = 0;
    if (have2 != 0 && dflag == 0) {
        translate = 1;
        // build the SET1-in-order list under complement, mapped positionally to SET2
        let is i64 as src with mut = 0; let is i64 as bb with mut = 0;
        while (bb < 256) {
            if (in1[bb] != 0) {
                let is i64 as s2 with mut = 0;
                if (src < N2) { s2 = SET2[src]; } else if (N2 > 0) { s2 = SET2[N2 - 1]; } else { s2 = FILL2; }
                if (FILL2 != 0 && src >= N2) { s2 = FILL2; }
                map[bb] = s2; src = src + 1;
            }
            bb = bb + 1;
        }
    }
    // squeeze set: the LAST set given — SET2 when present (translate or -d cases),
    // else SET1 (post-complement membership).
    let is [256]i64 as sq;
    b = 0; while (b < 256) { sq[b] = 0; b = b + 1; }
    if (sflag != 0) {
        if (have2 != 0) { k = 0; while (k < N2) { sq[SET2[k]] = 1; k = k + 1; } }
        else { b = 0; while (b < 256) { if (in1[b] != 0) { sq[b] = 1; } b = b + 1; } }
    }

    let is [4096]u8 as ibuf; let is fu.Reader as r;
    fu.rd_open_fd(&r, cast(i64, 0), cast(*u8, &ibuf[0]), 4096);
    let is [4096]u8 as ob; let is i64 as on with mut = 0;
    let is i64 as last with mut = 0 - 1;
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(&r);
        if (c < 0) { break; }
        if (dflag != 0 && in1[c] != 0) {  }                                 // deleted
        else {
            let is i64 as out with mut = c; if (translate != 0) { out = map[c]; }
            let is i64 as drop with mut = 0;
            if (sflag != 0 && sq[out] != 0 && out == last) { drop = 1; }
            if (drop == 0) { ob[on] = cast(u8, out); on = on + 1; if (on >= 4096) { prog.out(cast(*u8, &ob[0]), on); on = 0; } last = out; }
        }
    }
    if (on > 0) { prog.out(cast(*u8, &ob[0]), on); }
    return 0;
}
