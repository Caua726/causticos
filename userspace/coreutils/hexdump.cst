// hexdump — dump file contents in several formats.
//   hexdump [-bcdox] [-C] [-n LEN] [-s SKIP] [file ...]
//   (default) two-byte hex   -C canonical hex+ascii   -b octal bytes
//   -c chars   -d unsigned decimal   -o octal   -x hex (16-bit words)
// Runs of identical 16-byte lines collapse to a single `*`; a final line gives
// the total length. -n LEN dumps at most LEN bytes, -s SKIP skips the first SKIP.
//
// The inputs are one stream, read a block at a time and dumped as they come: a
// line can hold the end of one file and the start of the next, and -s/-n count
// across all of them. hexdump on a pipe prints as its input arrives and stops
// reading once -n is satisfied. It used to read each input whole first, and
// apply -s and -n to every file separately.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;

let is i64 as M_CANON = 0; let is i64 as M_TWO = 1; let is i64 as M_OCTB = 2;
let is i64 as M_CHAR = 3; let is i64 as M_DEC = 4; let is i64 as M_OCT = 5; let is i64 as M_HEX = 6;

fn emit_base(v as i64, base as i64, digits as i64) as void {
    let is [24]u8 as b; let is i64 as i with mut = digits; let is i64 as x with mut = v;
    while (i > 0) { i = i - 1; let is i64 as d = x % base; if (d < 10) { b[i] = cast(u8, 48 + d); } else { b[i] = cast(u8, 87 + d); } x = x / base; }
    prog.out(cast(*u8, &b[0]), digits);
}
fn spaces(n as i64) as void { let is i64 as i with mut = 0; while (i < n) { prog.outs(" "); i = i + 1; } }
fn dec_rj(v as i64, w as i64) as void { let is i64 as d with mut = 1; let is i64 as t with mut = v; while (t >= 10) { t = t / 10; d = d + 1; } spaces(w - d); prog.out_num(v); }

fn print_offset(off as i64, mode as i64) as void {
    if (mode == M_CANON) { emit_base(off, 16, 8); } else { emit_base(off, 16, 7); }
}

fn print_line(mode as i64, off as i64, p as *u8, start as i64, n as i64) as void {
    print_offset(off, mode);
    if (mode == M_CANON) {
        prog.outs("  ");
        let is i64 as i with mut = 0;
        while (i < 16) {
            if (i < n) { emit_base(cast(i64, p[start + i]), 16, 2); prog.outs(" "); } else { prog.outs("   "); }
            if (i == 7) { prog.outs(" "); }
            i = i + 1;
        }
        let is [19]u8 as asc;
        asc[0] = cast(u8, 32); asc[1] = cast(u8, 124);           // " |"
        i = 0;
        while (i < n) {
            let is i64 as c = cast(i64, p[start + i]);
            if (c >= 32 && c < 127) { asc[2 + i] = cast(u8, c); } else { asc[2 + i] = cast(u8, 46); }
            i = i + 1;
        }
        prog.out(cast(*u8, &asc[0]), 2 + n);
        prog.outs("|\n");
        return;
    }
    if (mode == M_OCTB) {                                         // -b octal bytes (field 4)
        let is i64 as i with mut = 0;
        while (i < 16) { if (i < n) { prog.outs(" "); emit_base(cast(i64, p[start + i]), 8, 3); } else { spaces(4); } i = i + 1; }
        prog.out("\n", 1); return;
    }
    if (mode == M_CHAR) {                                         // -c chars (field 4)
        let is i64 as i with mut = 0;
        while (i < 16) {
            if (i < n) {
                let is i64 as c = cast(i64, p[start + i]);
                if (c == 10) { prog.outs("  \\n"); } else if (c == 9) { prog.outs("  \\t"); } else if (c == 13) { prog.outs("  \\r"); }
                else if (c == 0) { prog.outs("  \\0"); } else if (c >= 32 && c < 127) { spaces(3); let is [1]u8 as ch; ch[0] = cast(u8, c); prog.out(cast(*u8, &ch[0]), 1); }
                else { prog.outs(" "); emit_base(c, 8, 3); }
            } else { spaces(4); }
            i = i + 1;
        }
        prog.out("\n", 1); return;
    }
    // word modes (16-bit little-endian): -x -o -d and the default two-byte
    let is i64 as i with mut = 0;
    while (i < 16) {
        if (i < n) {
            let is i64 as lo = cast(i64, p[start + i]); let is i64 as hi with mut = 0;
            if (i + 1 < n) { hi = cast(i64, p[start + i + 1]); }
            let is i64 as w = lo | (hi << 8);
            if (mode == M_TWO) { prog.outs(" "); emit_base(w, 16, 4); }
            else if (mode == M_HEX) { spaces(4); emit_base(w, 16, 4); }
            else if (mode == M_OCT) { prog.outs("  "); emit_base(w, 8, 6); }
            else if (mode == M_DEC) { spaces(3); dec_rj(w, 5); }
        } else { if (mode == M_TWO) { spaces(5); } else { spaces(8); } }
        i = i + 2;
    }
    prog.out("\n", 1);
}

// The dump, as state carried from block to block and file to file.
let is i64 as G_mode with mut = 1;
let is i64 as G_skip_left with mut = 0;      // input bytes still to skip
let is i64 as G_limit_left with mut = 0 - 1; // bytes still to dump; -1 = no limit
let is i64 as G_off with mut = 0;            // offset of the first byte in `row`
let is [16]u8 as row;
let is i64 as G_rown with mut = 0;
let is [16]u8 as prev;
let is i64 as G_prevset with mut = 0;
let is i64 as G_squeezing with mut = 0;

// The n bytes in `row` as a line — or as part of a `*` run when they repeat the
// previous full line.
fn flush_row(n as i64) as void {
    if (n <= 0) { return; }
    let is i64 as same with mut = 0;
    if (n == 16 && G_prevset != 0) {
        same = 1;
        let is i64 as k with mut = 0;
        while (k < 16) { if (row[k] != prev[k]) { same = 0; } k = k + 1; }
    }
    if (same != 0) {
        if (G_squeezing == 0) { prog.outs("*\n"); G_squeezing = 1; }
    } else {
        print_line(G_mode, G_off, cast(*u8, &row[0]), 0, n);
        G_squeezing = 0;
    }
    if (n == 16) {
        let is i64 as k with mut = 0;
        while (k < 16) { prev[k] = row[k]; k = k + 1; }
        G_prevset = 1;
    }
    G_off = G_off + n;
    G_rown = 0;
}

// Dump fd until it ends or -n is used up. 1 = -n used up (stop reading), 0 = the
// input ended, negative = read error.
fn dump_fd(fd as i64) as i64 {
    let is [4096]u8 as buf;
    while (1 == 1) {
        if (G_limit_left == 0) { return 1; }
        let is i64 as got = sys.read(fd, cast(*u8, &buf[0]), 4096);
        if (got < 0) { return got; }
        if (got == 0) { return 0; }
        let is i64 as i with mut = 0;
        while (i < got) {
            if (G_skip_left > 0) {
                let is i64 as take with mut = got - i;
                if (take > G_skip_left) { take = G_skip_left; }
                G_skip_left = G_skip_left - take;
                i = i + take;
            } else if (G_limit_left == 0) {
                i = got;
            } else {
                row[G_rown] = buf[i];
                G_rown = G_rown + 1;
                i = i + 1;
                if (G_limit_left > 0) { G_limit_left = G_limit_left - 1; }
                if (G_rown == 16) { flush_row(16); }
            }
        }
    }
    return 0;
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as skip with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "Cbcdoxn:s:");
        if (f < 0) { break; }
        if (f == 67) { G_mode = 0; } else if (f == 98) { G_mode = 2; } else if (f == 99) { G_mode = 3; }
        else if (f == 100) { G_mode = 4; } else if (f == 111) { G_mode = 5; } else if (f == 120) { G_mode = 6; }
        else if (f == 110) { G_limit_left = fu.parse_uint(cast(*u8, o.optarg), 19); }
        else if (f == 115) { skip = fu.parse_uint(cast(*u8, o.optarg), 19); }
        else { prog.errs("usage: hexdump [-bcCdox] [-n LEN] [-s SKIP] [file ...]\n"); return cast(i32, 1); }
    }
    G_skip_left = skip;
    G_off = skip;
    let is i32 as rc with mut = 0;
    let is i64 as nfiles = argc - o.ind;
    if (nfiles <= 0) {
        if (dump_fd(cast(i64, 0)) < 0) { prog.errs("hexdump: standard input: read error\n"); rc = cast(i32, 1); }
    } else {
        let is i64 as fi with mut = o.ind;
        let is i64 as done with mut = 0;
        while (fi < argc && done == 0) {
            let is *u8 as name = prog.arg(argv, fi);
            let is [256]u8 as pb; let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
            let is i64 as fd with mut = 0;
            if (fu.is_dash(name) == 0) { fd = sys.open_read(path); }
            if (fd < 0) { prog.errs("hexdump: "); prog.errs(name); prog.errs(": cannot open\n"); rc = cast(i32, 1); }
            else {
                let is i64 as r = dump_fd(fd);
                if (r < 0) { prog.errs("hexdump: "); prog.errs(name); prog.errs(": read error\n"); rc = cast(i32, 1); }
                if (r == 1) { done = 1; }
                if (fd > 0) { sys.close(fd); }
            }
            fi = fi + 1;
        }
    }
    flush_row(G_rown);
    print_offset(G_off, G_mode); prog.out("\n", 1);                  // final length
    return rc;
}
