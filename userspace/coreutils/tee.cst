// tee — copy stdin to stdout and to each file. tee [-a] file...
// -a append to the files instead of truncating.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;

fn main(argc as i64, argv as *u8) as i32 {
    let is i64 as aflag with mut = 0; let is i64 as ind with mut = 1;
    while (ind < argc) {
        let is *u8 as a = prog.arg(argv, ind);
        if (cast(i64, a[0]) == 45 && cast(i64, a[1]) == 97 && cast(i64, a[2]) == 0) { aflag = 1; ind = ind + 1; }
        else if (cast(i64, a[0]) == 45 && cast(i64, a[1]) == 45 && cast(i64, a[2]) == 0) { ind = ind + 1; break; }
        else { break; }
    }
    let is [16]i64 as fds; let is i64 as nf with mut = 0;
    let is i64 as i with mut = ind;
    while (i < argc && nf < 16) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb; let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is i64 as fd with mut = 0; if (aflag != 0) { fd = sys.open_append(path); } else { fd = sys.open_write(path); }
        if (fd >= 0) { fds[nf] = fd; nf = nf + 1; } else { prog.outs("tee: "); prog.outs(name); prog.outs(": cannot open\n"); }
        i = i + 1;
    }
    let is [4096]u8 as buf;
    while (1 == 1) {
        let is i64 as n = sys.read(cast(i64, 0), cast(*u8, &buf[0]), 4096);
        if (n <= 0) { break; }
        sys.write(cast(i64, 1), cast(*u8, &buf[0]), n);
        let is i64 as k with mut = 0; while (k < nf) { sys.write(fds[k], cast(*u8, &buf[0]), n); k = k + 1; }
    }
    let is i64 as k with mut = 0; while (k < nf) { sys.close(fds[k]); k = k + 1; }
    return 0;
}
