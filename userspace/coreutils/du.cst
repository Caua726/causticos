// du — disk usage. du [-s] [-a] [-h] [path ...].
// Prints the total bytes under each directory (post-order) and the top-level
// total. -s only the top-level total, -a also list each file, -h human-readable
// (K/M). Default path is /.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/futil.cst" as fu;

fn psize(v as i64, hflag as i64) as void {
    if (hflag == 0) { prog.pad_num(v, 9); return; }
    if (v >= 1048576) { prog.pad_num(v / 1048576, 7); prog.outs("M"); }
    else if (v >= 1024) { prog.pad_num(v / 1024, 7); prog.outs("K"); }
    else { prog.pad_num(v, 7); prog.outs("B"); }
}

fn du_walk(path as *u8, plen as i64, fl as i64, is_top as i64) as i64 {
    let is i64 as sflag = fl & 1;
    let is i64 as aflag = (fl >> 1) & 1;
    let is i64 as hflag = (fl >> 2) & 1;
    let is [4]i64 as st;
    if (sys.stat(path, cast(*u8, &st[0])) != 0) { return 0; }
    if (st[3] == 0) {
        if (aflag == 1 && sflag == 0) { psize(st[0], hflag); prog.outs("  "); prog.outs(path); prog.out("\n", 1); }
        return st[0];
    }
    let is i64 as total with mut = 0;
    let is i64 as fd = sys.open_read(path);
    if (fd >= 0) {
        let is [320]u8 as de;
        while (sys.readdir(fd, cast(*u8, &de[0])) == 0) {
            let is i64 as nl = fu.de_name_len(cast(*u8, &de[0]));
            if (fu.is_dot(cast(*u8, &de[0]), nl) == 0) {
                let is [512]u8 as child;
                let is i64 as clen = fu.path_join(cast(*u8, &child[0]), path, plen, cast(*u8, &de[0]), nl);
                total = total + du_walk(cast(*u8, &child[0]), clen, fl, 0);
            }
        }
        sys.close(fd);
    }
    let is i64 as do_print with mut = 0;
    if (is_top == 1) { do_print = 1; } else if (sflag == 0) { do_print = 1; }
    if (do_print == 1) { psize(total, hflag); prog.outs("  "); prog.outs(path); prog.out("\n", 1); }
    return total;
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as fl with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "sah");
        if (f < 0) { break; }
        if (f == 115) { fl = fl | 1; } else if (f == 97) { fl = fl | 2; } else if (f == 104) { fl = fl | 4; }
        else { prog.outs("usage: du [-sah] [path ...]\n"); return cast(i32, 1); }
    }
    if (argc - o.ind <= 0) { du_walk("/", 1, fl, 1); return 0; }
    let is i64 as i with mut = o.ind;
    while (i < argc) {
        let is [256]u8 as pb;
        let is *u8 as path = prog.abspath(prog.arg(argv, i), cast(*u8, &pb[0]));
        du_walk(path, prog.slen(path), fl, 1);
        i = i + 1;
    }
    return 0;
}
