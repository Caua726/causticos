// wc — count lines, words, bytes/chars, and longest-line length, with GNU's
// column alignment (width = digits of the largest printed count, or 7 for a
// pipe). A `total` line follows when several files are given.
//   wc [-l] [-w] [-c] [-m] [-L] [file ...]
// -l lines  -w words  -c bytes  -m chars (UTF-8)  -L longest line  (default -lwc)
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;

// counts: [0]=lines [1]=words [2]=bytes [3]=chars [4]=max line width
fn count(r as *fu.Reader, out as *i64) as void {
    let is i64 as lines with mut = 0; let is i64 as words with mut = 0;
    let is i64 as bytes with mut = 0; let is i64 as chars with mut = 0;
    let is i64 as maxw with mut = 0; let is i64 as inword with mut = 0;
    let is i64 as col with mut = 0;                  // display width of the current line
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(r);
        if (c < 0) { break; }
        bytes = bytes + 1;
        let is i64 as cont with mut = 0;
        if ((c & 0xC0) == 0x80) { cont = 1; }        // UTF-8 continuation byte
        if (cont == 0) { chars = chars + 1; }
        if (c == 0x0A) {
            lines = lines + 1;
            if (col > maxw) { maxw = col; }
            col = 0;
        } else if (c == 0x09) { col = (col / 8 + 1) * 8; }   // tab → next multiple of 8
        else if (cont == 0) { col = col + 1; }
        let is i64 as sp with mut = 0;
        if (c == 0x20 || c == 0x09 || c == 0x0A || c == 0x0B || c == 0x0C || c == 0x0D) { sp = 1; }
        if (sp == 1) { inword = 0; } else { if (inword == 0) { words = words + 1; inword = 1; } }
    }
    if (col > maxw) { maxw = col; }                  // last line without trailing newline
    out[0] = lines; out[1] = words; out[2] = bytes; out[3] = chars; out[4] = maxw;
}

fn digits(v as i64) as i64 { let is i64 as n with mut = 1; let is i64 as x with mut = v; while (x >= 10) { x = x / 10; n = n + 1; } return n; }

// print the selected columns of `cnt` padded to `width`, then the name.
fn show(cnt as *i64, sl as i64, sw as i64, sc as i64, sm as i64, sL as i64, width as i64, name as *u8) as void {
    let is i64 as first with mut = 1;
    if (sl != 0) { if (first == 0) { prog.outs(" "); } prog.pad_num(cnt[0], width); first = 0; }
    if (sw != 0) { if (first == 0) { prog.outs(" "); } prog.pad_num(cnt[1], width); first = 0; }
    if (sc != 0) { if (first == 0) { prog.outs(" "); } prog.pad_num(cnt[2], width); first = 0; }
    if (sm != 0) { if (first == 0) { prog.outs(" "); } prog.pad_num(cnt[3], width); first = 0; }
    if (sL != 0) { if (first == 0) { prog.outs(" "); } prog.pad_num(cnt[4], width); first = 0; }
    if (cast(i64, name) != 0) { prog.outs(" "); prog.outs(name); }
    prog.out("\n", 1);
}
fn maxsel(cnt as *i64, sl as i64, sw as i64, sc as i64, sm as i64, sL as i64) as i64 {
    let is i64 as m with mut = 0;
    if (sl != 0 && cnt[0] > m) { m = cnt[0]; }
    if (sw != 0 && cnt[1] > m) { m = cnt[1]; }
    if (sc != 0 && cnt[2] > m) { m = cnt[2]; }
    if (sm != 0 && cnt[3] > m) { m = cnt[3]; }
    if (sL != 0 && cnt[4] > m) { m = cnt[4]; }
    return m;
}

let is [5120]i64 as G_CNT;          // per-file counts (up to 1024 files * 5)

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as sl with mut = 0; let is i64 as sw with mut = 0; let is i64 as sc with mut = 0;
    let is i64 as sm with mut = 0; let is i64 as sL with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "lwcmL");
        if (f < 0) { break; }
        if (f == 108) { sl = 1; } else if (f == 119) { sw = 1; } else if (f == 99) { sc = 1; }
        else if (f == 109) { sm = 1; } else if (f == 76) { sL = 1; }
        else { prog.outs("usage: wc [-lwcmL] [file ...]\n"); return cast(i32, 1); }
    }
    if (sl == 0 && sw == 0 && sc == 0 && sm == 0 && sL == 0) { sl = 1; sw = 1; sc = 1; }

    let is i64 as nfiles = argc - o.ind;
    if (nfiles <= 0) {
        let is [4096]u8 as buf; let is fu.Reader as r;
        fu.rd_open_fd(&r, cast(i64, 0), cast(*u8, &buf[0]), 4096);
        let is [5]i64 as cnt; count(&r, cast(*i64, &cnt[0]));
        show(cast(*i64, &cnt[0]), sl, sw, sc, sm, sL, 7, cast(*u8, 0));   // pipe → width 7
        return 0;
    }

    // pass 1: count every file, remember the largest printed value for the width
    let is [5]i64 as total; total[0] = 0; total[1] = 0; total[2] = 0; total[3] = 0; total[4] = 0;
    let is i64 as biggest with mut = 0;
    let is i32 as rc with mut = 0;
    let is i64 as nstored with mut = 0;
    let is i64 as i with mut = o.ind;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb; let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is [4096]u8 as buf; let is fu.Reader as r;
        let is i64 as slot = nstored * 5;
        if (fu.rd_open(&r, path, cast(*u8, &buf[0]), 4096) < 0) {
            prog.outs("wc: "); prog.outs(name); prog.outs(": cannot open\n"); rc = cast(i32, 1);
            G_CNT[slot] = 0 - 1;                       // mark error
        } else {
            count(&r, cast(*i64, &G_CNT[slot])); fu.rd_close(&r);
            total[0] = total[0] + G_CNT[slot]; total[1] = total[1] + G_CNT[slot + 1];
            total[2] = total[2] + G_CNT[slot + 2]; total[3] = total[3] + G_CNT[slot + 3];
            if (G_CNT[slot + 4] > total[4]) { total[4] = G_CNT[slot + 4]; }
            let is i64 as mx = maxsel(cast(*i64, &G_CNT[slot]), sl, sw, sc, sm, sL);
            if (mx > biggest) { biggest = mx; }
        }
        nstored = nstored + 1; i = i + 1;
        if (nstored >= 1024) { break; }
    }
    if (nfiles > 1) { let is i64 as tm = maxsel(cast(*i64, &total[0]), sl, sw, sc, sm, sL); if (tm > biggest) { biggest = tm; } }
    let is i64 as width = digits(biggest);

    // pass 2: print aligned
    let is i64 as j with mut = 0; i = o.ind;
    while (j < nstored) {
        let is *u8 as name = prog.arg(argv, i);
        if (G_CNT[j * 5] != (0 - 1)) { show(cast(*i64, &G_CNT[j * 5]), sl, sw, sc, sm, sL, width, name); }
        j = j + 1; i = i + 1;
    }
    if (nfiles > 1) { show(cast(*i64, &total[0]), sl, sw, sc, sm, sL, width, "total"); }
    return rc;
}
