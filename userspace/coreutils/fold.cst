// fold — wrap each input line to a width. fold [-b] [-w N] [-s] [file ...].
// -w N width (default 80); -b count bytes instead of display columns (so a tab
// counts 1, not up to 8); -s break at the last blank within the width. Display
// mode advances a tab to the next multiple of 8, a backspace backs up, and a
// carriage return resets the column — like GNU fold. stdin if no file.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;

// display column after appending byte c at column `col`.
fn next_col(col as i64, c as i64, bflag as i64) as i64 {
    if (bflag != 0) { return col + 1; }
    if (c == 9) { return (col / 8 + 1) * 8; }
    if (c == 8) { if (col > 0) { return col - 1; } return 0; }
    if (c == 13) { return 0; }
    return col + 1;
}
// display column of a whole segment.
fn seg_col(seg as *u8, sl as i64, bflag as i64) as i64 {
    let is i64 as col with mut = 0; let is i64 as i with mut = 0;
    while (i < sl) { col = next_col(col, cast(i64, seg[i]), bflag); i = i + 1; }
    return col;
}

fn fold_stream(r as *fu.Reader, width as i64, sflag as i64, bflag as i64) as void {
    let is [8192]u8 as seg;
    let is i64 as sl with mut = 0; let is i64 as col with mut = 0;
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(r);
        if (c < 0) { break; }
        if (c == 0x0A) { prog.out(cast(*u8, &seg[0]), sl); prog.out("\n", 1); sl = 0; col = 0; }
        else {
            let is i64 as nc with mut = next_col(col, c, bflag);
            if (nc > width && sl > 0) {
                let is i64 as bp with mut = 0 - 1;
                if (sflag != 0) { let is i64 as k with mut = sl - 1; while (k >= 0) { let is i64 as sc = cast(i64, seg[k]); if (sc == 32 || sc == 9) { bp = k; break; } k = k - 1; } }
                if (bp >= 0) {
                    prog.out(cast(*u8, &seg[0]), bp + 1); prog.out("\n", 1);
                    let is i64 as m with mut = 0; let is i64 as j with mut = bp + 1;
                    while (j < sl) { seg[m] = seg[j]; m = m + 1; j = j + 1; }
                    sl = m; col = seg_col(cast(*u8, &seg[0]), sl, bflag);
                } else { prog.out(cast(*u8, &seg[0]), sl); prog.out("\n", 1); sl = 0; col = 0; }
                nc = next_col(col, c, bflag);
            }
            if (sl < 8192) { seg[sl] = cast(u8, c); sl = sl + 1; col = nc; }
        }
    }
    if (sl > 0) { prog.out(cast(*u8, &seg[0]), sl); }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as width with mut = 80; let is i64 as sflag with mut = 0; let is i64 as bflag with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "w:sb");
        if (f < 0) { break; }
        if (f == 119) { let is *u8 as va = cast(*u8, o.optarg); let is i64 as w = fu.parse_uint(va, prog.slen(va)); if (w > 0) { width = w; } }
        else if (f == 115) { sflag = 1; } else if (f == 98) { bflag = 1; }
        else { prog.outs("usage: fold [-bs] [-w N] [file ...]\n"); return cast(i32, 1); }
    }
    if (width > 8192) { width = 8192; }
    let is i64 as nfiles = argc - o.ind;
    if (nfiles <= 0) {
        let is [4096]u8 as buf; let is fu.Reader as r;
        fu.rd_open_fd(&r, cast(i64, 0), cast(*u8, &buf[0]), 4096);
        fold_stream(&r, width, sflag, bflag);
        return 0;
    }
    let is i32 as rc with mut = 0; let is i64 as i with mut = o.ind;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb; let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is [4096]u8 as buf; let is fu.Reader as r;
        if (fu.rd_open(&r, path, cast(*u8, &buf[0]), 4096) < 0) { prog.outs("fold: "); prog.outs(name); prog.outs(": cannot open\n"); rc = cast(i32, 1); }
        else { fold_stream(&r, width, sflag, bflag); fu.rd_close(&r); }
        i = i + 1;
    }
    return rc;
}
