// mv — move or rename files. mv src ... dst.
// With several sources, or when dst is an existing directory, each source is
// moved to dst/<basename>.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/futil.cst" as fu;

fn basename(path as *u8) as *u8 {
    let is i64 as last with mut = 0;
    let is i64 as i with mut = 0;
    while (path[i] != 0) { if (cast(i64, path[i]) == 47) { last = i + 1; } i = i + 1; }
    return cast(*u8, cast(i64, path) + last);
}
fn isdir(path as *u8) as i64 {
    let is [4]i64 as st;
    if (sys.stat(path, cast(*u8, &st[0])) != 0) { return 0; }
    if (st[3] != 0) { return 1; }
    return 0;
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "");
        if (f < 0) { break; }
        prog.outs("usage: mv src ... dst\n"); return cast(i32, 1);
    }
    let is i64 as nops = argc - o.ind;
    if (nops < 2) { prog.outs("usage: mv src ... dst\n"); return cast(i32, 1); }
    let is [256]u8 as db;
    let is *u8 as dst = prog.abspath(prog.arg(argv, argc - 1), cast(*u8, &db[0]));
    let is i64 as dstdir = isdir(dst);
    if (nops > 2 && dstdir == 0) { prog.outs("mv: target must be a directory\n"); return cast(i32, 1); }
    let is i32 as rc with mut = 0;
    let is i64 as i with mut = o.ind;
    while (i < argc - 1) {
        let is *u8 as sname = prog.arg(argv, i);
        let is [256]u8 as sb;
        let is *u8 as src = prog.abspath(sname, cast(*u8, &sb[0]));
        let is [512]u8 as tb;
        let is *u8 as target with mut = dst;
        if (dstdir == 1) {
            let is *u8 as bn = basename(src);
            fu.path_join(cast(*u8, &tb[0]), dst, prog.slen(dst), bn, prog.slen(bn));
            target = cast(*u8, &tb[0]);
        }
        if (sys.rename(src, target) != 0) { prog.outs("mv: cannot move "); prog.outs(sname); prog.out("\n", 1); rc = cast(i32, 1); }
        i = i + 1;
    }
    return rc;
}
