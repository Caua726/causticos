// cp — copy files. cp [-r] src ... dst.
// -r copy directories recursively. With several sources, or when dst is an
// existing directory, each source is copied to dst/<basename>.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;

fn basename(path as *u8) as *u8 {
    let is i64 as last with mut = 0;
    let is i64 as i with mut = 0;
    while (path[i] != 0) { if (cast(i64, path[i]) == 47) { last = i + 1; } i = i + 1; }
    return cast(*u8, cast(i64, path) + last);
}
fn isdir(path as *u8) as i64 {
    let is [4]i64 as st;
    if (sys.stat(path, cast(*u8, &st[0])) != 0) { return 0; }
    if (st[3] != 0) { return 1; }
    return 0;
}

fn copy_file(src as *u8, dst as *u8) as i32 {
    let is i64 as sfd = sys.open_read(src);
    if (sfd < 0) { prog.outs("cp: "); prog.outs(src); prog.outs(": cannot open\n"); return cast(i32, 1); }
    let is i64 as dfd = sys.open_write(dst);
    if (dfd < 0) { prog.outs("cp: "); prog.outs(dst); prog.outs(": cannot create\n"); sys.close(sfd); return cast(i32, 1); }
    let is [4096]u8 as buf;
    let is i32 as rc with mut = 0;
    let is i64 as n with mut = sys.read(sfd, cast(*u8, &buf[0]), 4096);
    while (n > 0) {
        if (sys.write(dfd, cast(*u8, &buf[0]), n) != n) { prog.outs("cp: write error\n"); rc = cast(i32, 1); break; }
        n = sys.read(sfd, cast(*u8, &buf[0]), 4096);
    }
    sys.close(sfd); sys.close(dfd);
    return rc;
}

fn cp_r(src as *u8, slen as i64, dst as *u8, dlen as i64) as i32 {
    let is [4]i64 as st;
    if (sys.stat(src, cast(*u8, &st[0])) != 0) { prog.outs("cp: "); prog.outs(src); prog.outs(": no such file\n"); return cast(i32, 1); }
    if (st[3] == 0) { return copy_file(src, dst); }
    sys.mkdir(dst);
    let is i32 as rc with mut = 0;
    let is i64 as fd = sys.open_read(src);
    if (fd >= 0) {
        let is [320]u8 as de;
        while (sys.readdir(fd, cast(*u8, &de[0])) == 0) {
            let is i64 as nl = fu.de_name_len(cast(*u8, &de[0]));
            if (fu.is_dot(cast(*u8, &de[0]), nl) == 0) {
                let is [512]u8 as sc; let is [512]u8 as dc;
                let is i64 as scl = fu.path_join(cast(*u8, &sc[0]), src, slen, cast(*u8, &de[0]), nl);
                let is i64 as dcl = fu.path_join(cast(*u8, &dc[0]), dst, dlen, cast(*u8, &de[0]), nl);
                if (cp_r(cast(*u8, &sc[0]), scl, cast(*u8, &dc[0]), dcl) != 0) { rc = cast(i32, 1); }
            }
        }
        sys.close(fd);
    }
    return rc;
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as rflag with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "r");
        if (f < 0) { break; }
        if (f == 114) { rflag = 1; } else { prog.outs("usage: cp [-r] src ... dst\n"); return cast(i32, 1); }
    }
    let is i64 as nops = argc - o.ind;
    if (nops < 2) { prog.outs("usage: cp [-r] src ... dst\n"); return cast(i32, 1); }
    let is [256]u8 as db;
    let is *u8 as dst = prog.abspath(prog.arg(argv, argc - 1), cast(*u8, &db[0]));
    let is i64 as dstdir = isdir(dst);
    if (nops > 2 && dstdir == 0) { prog.outs("cp: target must be a directory\n"); return cast(i32, 1); }
    let is i32 as rc with mut = 0;
    let is i64 as i with mut = o.ind;
    while (i < argc - 1) {
        let is *u8 as sname = prog.arg(argv, i);
        let is [256]u8 as sb;
        let is *u8 as src = prog.abspath(sname, cast(*u8, &sb[0]));
        let is [512]u8 as tb;
        let is *u8 as target with mut = dst;
        let is i64 as tlen with mut = prog.slen(dst);
        if (dstdir == 1) {
            let is *u8 as bn = basename(src);
            tlen = fu.path_join(cast(*u8, &tb[0]), dst, prog.slen(dst), bn, prog.slen(bn));
            target = cast(*u8, &tb[0]);
        }
        if (rflag == 1) { if (cp_r(src, prog.slen(src), target, tlen) != 0) { rc = cast(i32, 1); } }
        else { if (copy_file(src, target) != 0) { rc = cast(i32, 1); } }
        i = i + 1;
    }
    return rc;
}
