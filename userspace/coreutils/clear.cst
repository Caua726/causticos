// clear — clear the terminal screen. `clear`. Emits form-feed (0x0C); the
// terminal wipes to its background colour and homes the cursor (term.cst's
// putc handler). Run with no terminal it's simply a no-op byte on serial.
use "../../../Caustic/std/causticos/prog.cst" as prog;

fn main(argc as i64, argv as *u8) as i32 {
    let is [1]u8 as ff;
    ff[0] = cast(u8, 12);                  // 0x0C form feed
    prog.out(cast(*u8, &ff[0]), 1);
    return 0;
}
