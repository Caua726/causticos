// seq — print a sequence of numbers. seq [-s SEP] [-w] [first [incr]] last.
// -s SEP between numbers (default newline); -w pad with leading zeros to a
// common width. Supports decimals (seq 1 0.5 3 -> 1.0 1.5 2.0 2.5 3.0) via
// fixed-point: the number of fraction digits is the max across the arguments.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/futil.cst" as fu;

fn pow10(d as i64) as i64 { let is i64 as p with mut = 1; let is i64 as i with mut = 0; while (i < d) { p = p * 10; i = i + 1; } return p; }
fn ndig(v as i64) as i64 { let is i64 as t with mut = v; if (t < 0) { t = 0 - t; } let is i64 as d with mut = 1; while (t >= 10) { t = t / 10; d = d + 1; } return d; }

// parse a decimal string into a scaled integer + the number of fraction digits.
fn parse_dec(s as *u8, out_scaled as *i64, out_dec as *i64) as void {
    let is i64 as i with mut = 0; let is i64 as neg with mut = 0;
    if (cast(i64, s[0]) == 45) { neg = 1; i = 1; } else if (cast(i64, s[0]) == 43) { i = 1; }
    let is i64 as v with mut = 0;
    while (cast(i64, s[i]) >= 48 && cast(i64, s[i]) <= 57) { v = v * 10 + (cast(i64, s[i]) - 48); i = i + 1; }
    let is i64 as dec with mut = 0;
    if (cast(i64, s[i]) == 46) { i = i + 1; while (cast(i64, s[i]) >= 48 && cast(i64, s[i]) <= 57) { v = v * 10 + (cast(i64, s[i]) - 48); dec = dec + 1; i = i + 1; } }
    if (neg != 0) { v = 0 - v; }
    out_scaled[0] = v; out_dec[0] = dec;
}

// length of the formatted value with `d` fraction digits.
fn fmt_len(v as i64, d as i64) as i64 {
    let is i64 as a with mut = v; let is i64 as neg with mut = 0; if (a < 0) { neg = 1; a = 0 - a; }
    let is i64 as pw = pow10(d); let is i64 as ip = a / pw;
    let is i64 as len with mut = ndig(ip);
    if (neg != 0) { len = len + 1; }
    if (d > 0) { len = len + 1 + d; }
    return len;
}
// print a scaled value with `d` fraction digits, zero-padded to total `width` (0 = none).
fn print_val(v as i64, d as i64, width as i64) as void {
    let is i64 as a with mut = v; let is i64 as neg with mut = 0; if (a < 0) { neg = 1; a = 0 - a; }
    let is i64 as pw = pow10(d); let is i64 as ip = a / pw; let is i64 as fp = a % pw;
    let is i64 as natural = fmt_len(v, d);
    if (neg != 0) { prog.outs("-"); }
    let is i64 as pad with mut = width - natural; while (pad > 0) { prog.outs("0"); pad = pad - 1; }
    prog.out_num(ip);
    if (d > 0) {
        prog.outs(".");
        let is i64 as scale with mut = pw / 10; let is i64 as f with mut = fp;
        while (scale >= 1) { let is i64 as digit = f / scale; prog.out_num(digit); f = f - digit * scale; scale = scale / 10; }
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is *u8 as sep with mut = "\n"; let is i64 as seplen with mut = 1; let is i64 as wflag with mut = 0;
    // parse flags by hand: a "-<digit>" / "-." is a negative-number operand, not a flag.
    let is i64 as ind with mut = 1;
    while (ind < argc) {
        let is *u8 as a = prog.arg(argv, ind);
        let is i64 as c0 = cast(i64, a[0]); let is i64 as c1 = cast(i64, a[1]);
        if (c0 != 45 || c1 == 0) { break; }                                   // operand
        if ((c1 >= 48 && c1 <= 57) || c1 == 46) { break; }                    // -N / -. operand
        if (c1 == 115) { if (cast(i64, a[2]) != 0) { sep = cast(*u8, cast(i64, a) + 2); } else { ind = ind + 1; if (ind < argc) { sep = prog.arg(argv, ind); } } seplen = prog.slen(sep); ind = ind + 1; }
        else if (c1 == 119) { wflag = 1; ind = ind + 1; }
        else { prog.outs("usage: seq [-s SEP] [-w] [first [incr]] last\n"); return cast(i32, 1); }
    }
    let is i64 as nops = argc - ind;
    let is [1]i64 as fv; let is [1]i64 as fd; let is [1]i64 as iv; let is [1]i64 as id; let is [1]i64 as lv; let is [1]i64 as ld;
    fv[0] = 1; fd[0] = 0; iv[0] = 1; id[0] = 0; lv[0] = 0; ld[0] = 0;
    if (nops == 1) { parse_dec(prog.arg(argv, ind), cast(*i64, &lv[0]), cast(*i64, &ld[0])); }
    else if (nops == 2) { parse_dec(prog.arg(argv, ind), cast(*i64, &fv[0]), cast(*i64, &fd[0])); parse_dec(prog.arg(argv, ind + 1), cast(*i64, &lv[0]), cast(*i64, &ld[0])); }
    else if (nops >= 3) { parse_dec(prog.arg(argv, ind), cast(*i64, &fv[0]), cast(*i64, &fd[0])); parse_dec(prog.arg(argv, ind + 1), cast(*i64, &iv[0]), cast(*i64, &id[0])); parse_dec(prog.arg(argv, ind + 2), cast(*i64, &lv[0]), cast(*i64, &ld[0])); }
    else { prog.outs("usage: seq [-s SEP] [-w] [first [incr]] last\n"); return cast(i32, 1); }

    // common fraction-digit count, then rescale every value to it
    let is i64 as d with mut = fd[0]; if (id[0] > d) { d = id[0]; } if (ld[0] > d) { d = ld[0]; }
    let is i64 as first = fv[0] * pow10(d - fd[0]);
    let is i64 as incr = iv[0] * pow10(d - id[0]);
    let is i64 as last = lv[0] * pow10(d - ld[0]);
    if (incr == 0) { prog.outs("seq: increment must be nonzero\n"); return cast(i32, 1); }

    let is i64 as width with mut = 0;
    if (wflag != 0) { let is i64 as wf = fmt_len(first, d); let is i64 as wl = fmt_len(last, d); width = wf; if (wl > width) { width = wl; } }

    let is i64 as v with mut = first; let is i64 as firstout with mut = 1;
    if (incr > 0) { while (v <= last) { if (firstout == 0) { prog.out(sep, seplen); } firstout = 0; print_val(v, d, width); v = v + incr; } }
    else { while (v >= last) { if (firstout == 0) { prog.out(sep, seplen); } firstout = 0; print_val(v, d, width); v = v + incr; } }
    if (firstout == 0) { prog.out("\n", 1); }
    return 0;
}
