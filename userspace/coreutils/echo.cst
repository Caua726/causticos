// echo — print the arguments, space-separated, + newline, the way GNU's does.
//
// Leading arguments made only of the letters n, e and E after a '-' are
// options: -n leaves the newline off, -e reads backslash escapes, -E does not
// (the default). The first argument that is anything else — "-", "--",
// "-x", "-nx" — starts the text, and is printed. It took no option at all:
// `echo -n x` printed "-n x" and the newline, and a script had no way to
// write without one.
//
// -e: \\ \a \b \e \f \n \r \t \v, \0NNN and \NNN (octal, up to three digits),
// \xHH (hex, one or two); \c stops all output there, the newline too. A
// backslash before anything else is printed as is, with what follows it.
use "std/causticos/prog.cst" as prog;

let is [4096]u8 as buf with mut;
let is i64 as fill with mut = 0;

fn put(c as i64) as void {
    if (fill == 4096) { prog.out(cast(*u8, &buf[0]), fill); fill = 0; }
    buf[fill] = cast(u8, c);
    fill = fill + 1;
    return;
}

fn flush() as void {
    if (fill > 0) { prog.out(cast(*u8, &buf[0]), fill); fill = 0; }
    return;
}

// Whether a is an option argument: '-' and then one or more of n, e, E.
fn is_opt(a as *u8) as i64 {
    if (a[0] != cast(u8, 45) || a[1] == cast(u8, 0)) { return 0; }
    let is i64 as i with mut = 1;
    while (a[i] != cast(u8, 0)) {
        let is i64 as c = cast(i64, a[i]);
        if (c != 110 && c != 101 && c != 69) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn hex(c as i64) as i64 {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return 0 - 1;
}

fn octal(c as i64) as i64 {
    if (c >= 48 && c <= 55) { return 1; }
    return 0;
}

// One argument with -e's escapes read. 1 when a \c said to stop.
fn put_escaped(a as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (a[i] != cast(u8, 0)) {
        let is i64 as c with mut = cast(i64, a[i]);
        i = i + 1;
        if (c == 92 && a[i] != cast(u8, 0)) {
            let is i64 as e = cast(i64, a[i]);
            i = i + 1;
            if (e == 97) { c = 7; }
            else if (e == 98) { c = 8; }
            else if (e == 99) { return 1; }                          // \c
            else if (e == 101) { c = 27; }
            else if (e == 102) { c = 12; }
            else if (e == 110) { c = 10; }
            else if (e == 114) { c = 13; }
            else if (e == 116) { c = 9; }
            else if (e == 118) { c = 11; }
            else if (e == 92) { c = 92; }
            else if (e == 120 && hex(cast(i64, a[i])) >= 0) {        // \xHH
                c = hex(cast(i64, a[i]));
                i = i + 1;
                if (hex(cast(i64, a[i])) >= 0) { c = c * 16 + hex(cast(i64, a[i])); i = i + 1; }
            }
            else if (e >= 48 && e <= 55) {                            // \0NNN, \NNN
                // After a 0, up to three digits follow; after 1-7, up to two.
                let is i64 as more with mut = 2;
                c = e - 48;
                if (e == 48) { more = 3; }
                while (more > 0 && octal(cast(i64, a[i])) == 1) {
                    c = c * 8 + (cast(i64, a[i]) - 48);
                    i = i + 1;
                    more = more - 1;
                }
                c = c & 255;
            }
            else { put(92); c = e; }                                 // not an escape
        }
        put(c);
    }
    return 0;
}

fn main(argc as i64, argv as *u8) as i32 {
    let is i64 as newline with mut = 1;
    let is i64 as escapes with mut = 0;
    let is i64 as i with mut = 1;
    while (i < argc && is_opt(prog.arg(argv, i)) == 1) {
        let is *u8 as a = prog.arg(argv, i);
        let is i64 as k with mut = 1;
        while (a[k] != cast(u8, 0)) {
            if (a[k] == cast(u8, 110)) { newline = 0; }
            else if (a[k] == cast(u8, 101)) { escapes = 1; }
            else { escapes = 0; }
            k = k + 1;
        }
        i = i + 1;
    }
    let is i64 as first = i;
    while (i < argc) {
        if (i > first) { put(32); }
        let is *u8 as a = prog.arg(argv, i);
        if (escapes == 1) {
            if (put_escaped(a) == 1) { flush(); return 0; }
        } else {
            let is i64 as k with mut = 0;
            while (a[k] != cast(u8, 0)) { put(cast(i64, a[k])); k = k + 1; }
        }
        i = i + 1;
    }
    if (newline == 1) { put(10); }
    flush();
    return 0;
}
