// expand — convert tabs to spaces. expand [-t N] [-i] [file ...].
// -t N tab stops every N columns (default 8); -i only convert leading tabs
// (those before the first non-blank on a line). No file (or `-`) = stdin.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/futil.cst" as fu;

fn expand_stream(r as *fu.Reader, ts as i64, iflag as i64) as void {
    let is i64 as col with mut = 0; let is i64 as leading with mut = 1;
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(r);
        if (c < 0) { break; }
        if (c == 9) {
            if (iflag == 0 || leading != 0) { let is i64 as stop = (col / ts + 1) * ts; while (col < stop) { prog.outs(" "); col = col + 1; } }
            else { prog.out("\t", 1); col = (col / ts + 1) * ts; }
        } else if (c == 0x0A) { prog.out("\n", 1); col = 0; leading = 1; }
        else if (c == 8) { prog.out("\x08", 1); if (col > 0) { col = col - 1; } }
        else { let is [1]u8 as o; o[0] = cast(u8, c); prog.out(cast(*u8, &o[0]), 1); col = col + 1; if (c != 32) { leading = 0; } }
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as ts with mut = 8; let is i64 as iflag with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "t:i");
        if (f < 0) { break; }
        if (f == 116) { let is i64 as v = fu.parse_uint(cast(*u8, o.optarg), 19); if (v > 0) { ts = v; } }
        else if (f == 105) { iflag = 1; }
        else { prog.outs("usage: expand [-t N] [-i] [file ...]\n"); return cast(i32, 1); }
    }
    let is i64 as nfiles = argc - o.ind;
    if (nfiles <= 0) {
        let is [4096]u8 as buf; let is fu.Reader as r;
        fu.rd_open_fd(&r, cast(i64, 0), cast(*u8, &buf[0]), 4096);
        expand_stream(&r, ts, iflag);
        return 0;
    }
    let is i32 as rc with mut = 0; let is i64 as i with mut = o.ind;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb; let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is [4096]u8 as buf; let is fu.Reader as r;
        if (fu.rd_open(&r, path, cast(*u8, &buf[0]), 4096) < 0) { prog.outs("expand: "); prog.outs(name); prog.outs(": cannot open\n"); rc = cast(i32, 1); }
        else { expand_stream(&r, ts, iflag); fu.rd_close(&r); }
        i = i + 1;
    }
    return rc;
}
