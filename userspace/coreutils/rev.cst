// rev — reverse the characters of each line. rev [file ...]. No file (or `-`)
// reads stdin. Lines may be any length (the file is mapped whole).
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;

fn rev_buf(base as i64, len as i64) as void {
    let is *u8 as p = cast(*u8, base);
    let is i64 as ls with mut = 0;
    let is i64 as i with mut = 0;
    while (i <= len) {
        if (i == len || cast(i64, p[i]) == 0x0A) {
            if (i > ls || i < len) {                       // a real line (content or an empty line before \n)
                let is i64 as j with mut = i;
                while (j > ls) { j = j - 1; prog.out(cast(*u8, base + j), 1); }
                if (i < len) { prog.out("\n", 1); }
            }
            ls = i + 1;
        }
        i = i + 1;
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "");
        if (f < 0) { break; }
        prog.outs("usage: rev [file ...]\n"); return cast(i32, 1);
    }
    let is i64 as nfiles = argc - o.ind;
    if (nfiles <= 0) {
        let is i64 as len with mut = 0;
        let is i64 as base = fu.slurp_fd(cast(i64, 0), &len);
        if (len > 0) { rev_buf(base, len); }
        return 0;
    }
    let is i32 as rc with mut = 0;
    let is i64 as i with mut = o.ind;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb;
        let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is i64 as len with mut = 0;
        let is i64 as base = fu.slurp(path, &len);
        if (len < 0) { prog.outs("rev: "); prog.outs(name); prog.outs(": cannot open\n"); rc = cast(i32, 1); }
        else { rev_buf(base, len); fu.unslurp(base, len); }
        i = i + 1;
    }
    return rc;
}
