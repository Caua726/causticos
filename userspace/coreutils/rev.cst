// rev — reverse the characters of each line. rev [file ...]. No file (or `-`)
// reads stdin. Lines may be any length.
//
// A line at a time, written as it is read: rev on a pipe keeps up with its
// input instead of waiting for all of it, and each line goes out in one write
// (it used to be one write per character).
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;

// Every line of fd, reversed. 0, or the error that stopped it.
fn rev_fd(fd as i64, ln as *fu.Line, out as *fu.Line) as i64 {
    let is [4096]u8 as stage;
    let is fu.Reader as r;
    fu.rd_open_fd(&r, fd, cast(*u8, &stage[0]), 4096);
    while (1 == 1) {
        let is i64 as got = fu.rd_line(&r, ln);
        if (got <= 0) { return got; }
        if (fu.line_reserve(out, ln.len + 1) != 0) { return sys.E_NOMEM; }
        let is *u8 as s = cast(*u8, ln.va);
        let is *u8 as d = cast(*u8, out.va);
        let is i64 as k with mut = 0;
        while (k < ln.len) { d[k] = s[ln.len - 1 - k]; k = k + 1; }
        let is i64 as n with mut = ln.len;
        if (ln.nl != 0) { d[n] = cast(u8, 10); n = n + 1; }
        prog.out(d, n);
    }
    return 0;
}

fn fail(name as *u8, rc as i64) as void {
    prog.errs("rev: "); prog.errs(name);
    if (rc == sys.E_NOMEM) { prog.errs(": out of memory\n"); } else { prog.errs(": read error\n"); }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "");
        if (f < 0) { break; }
        prog.errs("usage: rev [file ...]\n"); return cast(i32, 1);
    }
    let is fu.Line as ln;
    let is fu.Line as out;
    ln.va = 0; ln.cap = 0; ln.len = 0; ln.nl = 0;
    out.va = 0; out.cap = 0; out.len = 0; out.nl = 0;
    let is i64 as nfiles = argc - o.ind;
    if (nfiles <= 0) {
        let is i64 as rc0 = rev_fd(cast(i64, 0), &ln, &out);
        if (rc0 < 0) { fail("standard input", rc0); return cast(i32, 1); }
        return 0;
    }
    let is i32 as rc with mut = 0;
    let is i64 as i with mut = o.ind;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb;
        let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is i64 as fd with mut = 0;
        if (fu.is_dash(name) == 0) { fd = sys.open_read(path); }
        if (fd < 0) { prog.errs("rev: "); prog.errs(name); prog.errs(": cannot open\n"); rc = cast(i32, 1); }
        else {
            let is i64 as r1 = rev_fd(fd, &ln, &out);
            if (r1 < 0) { fail(name, r1); rc = cast(i32, 1); }
            if (fd > 0) { sys.close(fd); }
        }
        i = i + 1;
    }
    return rc;
}
