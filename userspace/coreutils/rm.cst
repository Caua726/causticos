// rm — remove files and directories. rm [-r] [-f] file ...
// -r remove directories and their contents recursively, -f ignore nonexistent
// files and suppress errors.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;

fn rm_r(path as *u8, plen as i64, fflag as i64) as i32 {
    let is [4]i64 as st;
    if (sys.stat(path, cast(*u8, &st[0])) != 0) {
        if (fflag == 0) { prog.outs("rm: "); prog.outs(path); prog.outs(": no such file\n"); return cast(i32, 1); }
        return cast(i32, 0);
    }
    if (st[3] != 0) {
        let is i32 as rc with mut = 0;
        // Delete children in snapshot batches: read_dir gives a closed snapshot,
        // we remove those, then re-read the now-smaller directory until empty —
        // so we never unlink entries out from under a live readdir cursor.
        while (1 == 1) {
            let is [8192]u8 as names;
            let is [256]i64 as off; let is [256]i64 as nl; let is [256]i64 as isd;
            let is i64 as cnt = fu.read_dir(path, cast(*u8, &names[0]), 8192, cast(*i64, &off[0]), cast(*i64, &nl[0]), cast(*i64, &isd[0]), 256);
            if (cnt == 0) { break; }
            let is i64 as k with mut = 0;
            while (k < cnt) {
                let is [512]u8 as child;
                let is i64 as clen = fu.path_join(cast(*u8, &child[0]), path, plen, cast(*u8, cast(i64, &names[0]) + off[k]), nl[k]);
                if (rm_r(cast(*u8, &child[0]), clen, fflag) != 0) { rc = cast(i32, 1); }
                k = k + 1;
            }
            if (cnt < 256) { break; }
        }
        if (sys.rmdir(path) != 0) { if (fflag == 0) { prog.outs("rm: "); prog.outs(path); prog.outs(": cannot remove directory\n"); } rc = cast(i32, 1); }
        return rc;
    }
    if (sys.unlink(path) != 0) { if (fflag == 0) { prog.outs("rm: "); prog.outs(path); prog.outs(": cannot remove\n"); } return cast(i32, 1); }
    return cast(i32, 0);
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as rflag with mut = 0;
    let is i64 as fflag with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "rf");
        if (f < 0) { break; }
        if (f == 114) { rflag = 1; } else if (f == 102) { fflag = 1; }
        else { prog.outs("usage: rm [-r] [-f] file ...\n"); return cast(i32, 1); }
    }
    if (argc - o.ind <= 0) { if (fflag == 1) { return 0; } prog.outs("usage: rm [-r] [-f] file ...\n"); return cast(i32, 1); }
    let is i32 as rc with mut = 0;
    let is i64 as i with mut = o.ind;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb;
        let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        if (rflag == 1) { if (rm_r(path, prog.slen(path), fflag) != 0) { rc = cast(i32, 1); } }
        else if (sys.unlink(path) != 0) {
            if (fflag == 0) { prog.outs("rm: "); prog.outs(name); prog.outs(": cannot remove (use -r for a directory)\n"); rc = cast(i32, 1); }
        }
        i = i + 1;
    }
    return rc;
}
