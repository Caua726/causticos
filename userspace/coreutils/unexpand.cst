// unexpand — convert runs of spaces to tabs. unexpand [-a] [-t N] [file ...].
// By default only leading blanks are converted; -a converts blank runs anywhere.
// -t N tab stops every N columns (default 8). No file (or `-`) reads stdin.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;

// process one line (without its newline) from buf[0..len).
fn unexpand_line(line as *u8, len as i64, ts as i64, aflag as i64) as void {
    let is i64 as col with mut = 0; let is i64 as i with mut = 0; let is i64 as seen_nb with mut = 0;
    while (i < len) {
        let is i64 as c = cast(i64, line[i]);
        if (c == 32 || c == 9) {
            let is i64 as j with mut = i; let is i64 as endcol with mut = col;
            while (j < len && (cast(i64, line[j]) == 32 || cast(i64, line[j]) == 9)) {
                if (cast(i64, line[j]) == 9) { endcol = (endcol / ts + 1) * ts; } else { endcol = endcol + 1; }
                j = j + 1;
            }
            let is i64 as convertible with mut = 0; if (aflag != 0 || seen_nb == 0) { convertible = 1; }
            if (convertible != 0) {
                let is i64 as c2 with mut = col; let is i64 as next with mut = (c2 / ts + 1) * ts;
                while (next <= endcol) { prog.out("\t", 1); c2 = next; next = c2 + ts; }
                while (c2 < endcol) { prog.outs(" "); c2 = c2 + 1; }
            } else { let is i64 as c2 with mut = col; while (c2 < endcol) { prog.outs(" "); c2 = c2 + 1; } }
            col = endcol; i = j;
        } else { let is [1]u8 as o; o[0] = cast(u8, c); prog.out(cast(*u8, &o[0]), 1); col = col + 1; seen_nb = 1; i = i + 1; }
    }
}

fn unexpand_stream(r as *fu.Reader, ts as i64, aflag as i64) as void {
    let is [65536]u8 as line; let is i64 as ll with mut = 0;
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(r);
        if (c < 0) { break; }
        if (c == 0x0A) { unexpand_line(cast(*u8, &line[0]), ll, ts, aflag); prog.out("\n", 1); ll = 0; }
        else { if (ll < 65536) { line[ll] = cast(u8, c); ll = ll + 1; } }
    }
    if (ll > 0) { unexpand_line(cast(*u8, &line[0]), ll, ts, aflag); }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as ts with mut = 8; let is i64 as aflag with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "t:a");
        if (f < 0) { break; }
        if (f == 116) { let is i64 as v = fu.parse_uint(cast(*u8, o.optarg), 19); if (v > 0) { ts = v; } aflag = 1; }
        else if (f == 97) { aflag = 1; }
        else { prog.outs("usage: unexpand [-a] [-t N] [file ...]\n"); return cast(i32, 1); }
    }
    let is i64 as nfiles = argc - o.ind;
    if (nfiles <= 0) {
        let is [4096]u8 as buf; let is fu.Reader as r;
        fu.rd_open_fd(&r, cast(i64, 0), cast(*u8, &buf[0]), 4096);
        unexpand_stream(&r, ts, aflag);
        return 0;
    }
    let is i32 as rc with mut = 0; let is i64 as i with mut = o.ind;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb; let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is [4096]u8 as buf; let is fu.Reader as r;
        if (fu.rd_open(&r, path, cast(*u8, &buf[0]), 4096) < 0) { prog.outs("unexpand: "); prog.outs(name); prog.outs(": cannot open\n"); rc = cast(i32, 1); }
        else { unexpand_stream(&r, ts, aflag); fu.rd_close(&r); }
        i = i + 1;
    }
    return rc;
}
