// sed — the stream editor: a script of commands run on every line of input.
//
//   sed [OPTION]... SCRIPT [FILE]...
//   sed [OPTION]... {-e SCRIPT | -f FILE}... [FILE]...
//
//   -n, --quiet, --silent      do not print the pattern space at each cycle's end
//   -e S, --expression=S       add the commands in S
//   -f F, --file=F             add the commands in file F ("-": standard input)
//   -E, -r, --regexp-extended  extended regular expressions (basic otherwise)
//   -i[SUF], --in-place[=SUF]  edit the files themselves; with SUF keep the old
//                              one as FILE+SUF (a '*' in SUF is the file's name)
//   -s, --separate             each file on its own: line numbers and $ per file
//   -z, --null-data            records end in NUL rather than newline
//   -l N, --line-length=N      where `l` wraps its output (70; 0: never)
//   -u, --unbuffered           (output is written at the end of every cycle anyway)
//
// Addresses: N, $, /RE/ or \cREc (then I: either case, M: ^ $ at every line of
// the pattern space), FIRST~STEP; ranges A,B where B may also be +N (N more
// lines) or ~N (up to the next line number that is a multiple of N); 0,/RE/
// ends at the first line that matches, the first line included. A '!' after
// the addresses selects the lines they do not.
//
// Commands:
//   { ... }    a block               =   print the line number   # comment
//   a TEXT     append TEXT after the cycle  (a\ then TEXT on the next lines)
//   i TEXT     print TEXT now        c TEXT  replace the line(s) with TEXT
//   b L  t L  T L   branch to label L (:L): always, if a s/// succeeded since
//              the last line was read or t taken, if none did; no L: the end
//   d  D       delete the pattern space (D: through its first newline, then
//              run the script again on the rest without reading)
//   g G h H x  the hold space: copy to/from, append to/from (after a
//              newline), exchange
//   l [N]      print the pattern space unambiguously, wrapped at N
//   n  N       print (unless -n) and read the next line; N appends it after
//              a newline. With no line left, the script ends.
//   p  P       print the pattern space (P: up to its first newline)
//   q [C] Q [C]  quit with exit code C: q prints the pattern space first
//   r F  R F   append file F / its next line after the cycle
//   w F  W F   write the pattern space / its first line to file F
//   s/RE/REPL/FLAGS  substitute: flags g (all), N (the Nth), p (print),
//              w F (write), i/I (either case), m/M (multi-line). REPL: & or \0
//              the match, \1-\9 its groups, \n newline, \t tab, \L \U lower or
//              upper case from here, \l \u the next character only, \E stop
//   y/SRC/DST/ transliterate characters      z  empty the pattern space
//   F          print the input file's name   v  (accepted, does nothing)
//
// Regular expressions are POSIX (lib/regex): \n and \t mean newline and tab
// everywhere, inside [ ] too; the delimiter inside a [ ] needs no backslash;
// an empty RE is the last one used. A line, a script, its text and the number
// of commands have no fixed limit. Errors name where in the script they are.
//
// Exit status: 0; 1 for a bad script or option; 2 if an input file could not
// be read; 4 for an I/O error while running; q's or Q's code.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "std/unicode/utf8.cst" as utf8;
use "../lib/futil/futil.cst" as fu;
use "../lib/regex/regex.cst" as re;
use "../lib/ucase/ucase.cst" as ucase;

// ---- address kinds ----
let is i64 as A_NONE with imut = 0;
let is i64 as A_LINE with imut = 1;
let is i64 as A_LAST with imut = 2;
let is i64 as A_RE   with imut = 3;
let is i64 as A_STEP with imut = 4;    // FIRST~STEP
let is i64 as A_ZERO with imut = 5;    // the 0 of 0,/RE/
let is i64 as A_PLUS with imut = 6;    // ,+N
let is i64 as A_MULT with imut = 7;    // ,~N

// ---- the pieces of a replacement (RITEMS triples) ----
let is i64 as R_LIT   with imut = 1;   // POOL[a .. a+b)
let is i64 as R_GROUP with imut = 2;   // group a; 0 is the whole match
let is i64 as R_CASE  with imut = 3;   // a = 'U' 'L' 'E' 'u' 'l'

// ---- how a run of the script ended ----
let is i64 as RUN_END     with imut = 0;   // the end: print, next cycle
let is i64 as RUN_DEL     with imut = 1;   // d, c: next cycle without printing
let is i64 as RUN_AGAIN   with imut = 2;   // D: again on what is left, without reading
let is i64 as RUN_QUIT    with imut = 3;   // q: print, then stop
let is i64 as RUN_QUITNOW with imut = 4;   // Q: stop

struct Buf {
    va as i64;
    cap as i64;
    len as i64;
}

struct Arr {
    va as i64;
    cap as i64;        // elements
    n as i64;
}

struct Cmd {
    op as i64;
    a1 as i64; v1 as i64; s1 as i64; r1 as i64;   // first address: kind, line, step, regex
    a2 as i64; v2 as i64; r2 as i64;              // second address
    neg as i64;                                   // '!'
    active as i64;                                // inside its range
    end as i64;                                   // the last line of a +N / ~N range
    rx as i64;                                    // s: its regex (-1: the last one used)
    ri as i64; rn as i64;                         // s: replacement pieces RITEMS[ri .. ri+rn)
    gflag as i64; nth as i64; pflag as i64;       // s: g, N, p
    out as i64;                                   // s///w, w, W: OUTS index, or -1
    txt as i64; tlen as i64;                      // a i c: text; r R w W: file; b t T ':': label
    jump as i64;                                  // b t T: where to; '{': its '}'
    num as i64;                                   // q Q: exit code; l: width (-1: -l's); R: RINS index
    yi as i64; yn as i64;                         // y: YPAIRS[yi .. yi + 2yn)
    pos as i64;                                   // where in the script it starts
}

// Somewhere output goes: stdout, stderr, a w file, the -i temporary.
struct Out {
    fd as i64;
    va as i64; cap as i64; len as i64;            // written, not yet sent
    missing as i64;                               // the last record went out without its separator
    name as i64; nlen as i64;                     // POOL: the file's name (w files)
}

// A file R reads a line at a time.
struct RIn {
    name as i64; nlen as i64;                     // POOL
    state as i64;                                 // 0 not opened yet, 1 open, 2 done or unreadable
    stage as i64;
    r as fu.Reader;
    line as fu.Line;
}

// Where each piece of the script came from, for error messages.
struct Chunk {
    start as i64;                                 // in SCRIPT
    kind as i64;                                  // 0: -e (or the script operand), 1: -f
    num as i64;                                   // -e: which one
    name as i64;                                  // -f: *u8
}

// ---- options ----
let is i64 as G_N with mut = 0;
let is i64 as G_EXT with mut = 0;
let is i64 as G_SEP with mut = 0;
let is i64 as G_INPLACE with mut = 0;
let is i64 as G_SUFFIX with mut = 0;              // *u8, 0 for none
let is i64 as G_LWIDTH with mut = 70;
let is i64 as SEPC with mut = 10;                 // the record separator

// ---- the compiled script ----
let is Buf as SCRIPT;
let is Arr as CHUNKS;
let is i64 as P with mut = 0;                     // where the parser is in SCRIPT
let is Arr as CMDS;
let is Arr as RXS;                                // re.Regex
let is Arr as OUTS;
let is Arr as RINS;
let is Buf as POOL;                               // texts, labels, file names, literals
let is Arr as RITEMS;                             // i64 triples
let is Arr as YPAIRS;                             // i64 pairs: from, to
let is Arr as BLOCKS;                             // the '{'s not yet closed
let is Arr as FILES;                              // *u8 operands
let is Buf as TMPB;                               // parser scratch
let is Arr as YS; let is Arr as YD;               // parser scratch for y

// ---- running ----
let is Buf as PS;                                 // the pattern space
let is Buf as HS;                                 // the hold space
let is Buf as TMP;
let is i64 as PS_NL with mut = 1;                 // the pattern space's last record ended with a separator
let is i64 as HS_NL with mut = 1;
let is i64 as LINENO with mut = 0;
let is i64 as TFLAG with mut = 0;
let is i64 as LAST_RX with mut = 0 - 1;
let is i64 as CUR_OUT with mut = 0;
let is i64 as QUIT with mut = 0;
let is i64 as QCODE with mut = 0;
let is i64 as BADFILES with mut = 0;
let is Arr as AQI;                                // the append queue: (1, AQ off, len) text, (2, POOL off, len) a file
let is Buf as AQ;

// ---- input ----
let is fu.Reader as RD;
let is i64 as RD_OPEN with mut = 0;
let is i64 as RD_NAME with mut = 0;               // *u8: the file RD reads
let is i64 as RD_ERR with mut = 0;                // a read failed on this file
let is [65536]u8 as STAGE;
let is fu.Line as LOOK;                           // the next record, once something needed it
let is i64 as LOOK_ST with mut = 0;               // 0 not read yet, 1 in LOOK, 2 there is none
let is i64 as LOOK_NAME with mut = 0;
let is i64 as CUR_NAME with mut = 0;              // the file the pattern space's line came from
let is i64 as FI with mut = 0;                    // the next FILES entry to open

// ======================================================================
// memory

fn oom() as void { prog.errs("sed: out of memory\n"); sys.exit(cast(i32, 4)); }

fn mcopy(dst as i64, src as i64, n as i64) as void {
    let is *u8 as d = cast(*u8, dst);
    let is *u8 as s = cast(*u8, src);
    let is i64 as i with mut = 0;
    while (i < n) { d[i] = s[i]; i = i + 1; }
}

fn b_room(b as *Buf, need as i64) as void {
    if (need <= b.cap) { return; }
    let is i64 as nc with mut = b.cap * 2;
    if (nc < 4096) { nc = 4096; }
    while (nc < need) { nc = nc * 2; }
    let is i64 as va = sys.mmap(0, nc, sys.PROT_READ | sys.PROT_WRITE);
    if (va < 0) { oom(); }
    if (b.va != 0) {
        mcopy(va, b.va, b.len);
        sys.munmap(b.va, b.cap);
    }
    b.va = va;
    b.cap = nc;
}

fn b_add(b as *Buf, p as *u8, n as i64) as void {
    if (n <= 0) { return; }
    b_room(b, b.len + n);
    mcopy(b.va + b.len, cast(i64, p), n);
    b.len = b.len + n;
}

fn b_addc(b as *Buf, c as i64) as void {
    b_room(b, b.len + 1);
    let is *u8 as d = cast(*u8, b.va);
    d[b.len] = cast(u8, c);
    b.len = b.len + 1;
}

fn b_swap(a as *Buf, b as *Buf) as void {
    let is i64 as va = a.va; let is i64 as cap = a.cap; let is i64 as len = a.len;
    a.va = b.va; a.cap = b.cap; a.len = b.len;
    b.va = va; b.cap = cap; b.len = len;
}

fn arr_add(a as *Arr, esz as i64) as i64 {
    if (a.n >= a.cap) {
        let is i64 as nc with mut = a.cap * 2;
        if (nc < 16) { nc = 16; }
        let is i64 as bytes = fu.page_round(nc * esz);
        let is i64 as va = sys.mmap(0, bytes, sys.PROT_READ | sys.PROT_WRITE);
        if (va < 0) { oom(); }
        if (a.va != 0) {
            mcopy(va, a.va, a.n * esz);
            sys.munmap(a.va, fu.page_round(a.cap * esz));
        }
        a.va = va;
        a.cap = bytes / esz;
    }
    a.n = a.n + 1;
    return a.n - 1;
}

fn ai(a as *Arr, i as i64) as i64 { let is *i64 as p = cast(*i64, a.va); return p[i]; }
fn ai_set(a as *Arr, i as i64, v as i64) as void { let is *i64 as p = cast(*i64, a.va); p[i] = v; }
fn ai_push(a as *Arr, v as i64) as void { let is i64 as k = arr_add(a, 8); ai_set(a, k, v); }

fn cmd(i as i64) as *Cmd { return cast(*Cmd, CMDS.va + i * sizeof(Cmd)); }
fn rx(i as i64) as *re.Regex { return cast(*re.Regex, RXS.va + i * sizeof(re.Regex)); }
fn outp(i as i64) as *Out { return cast(*Out, OUTS.va + i * sizeof(Out)); }
fn rin(i as i64) as *RIn { return cast(*RIn, RINS.va + i * sizeof(RIn)); }
fn chunk(i as i64) as *Chunk { return cast(*Chunk, CHUNKS.va + i * sizeof(Chunk)); }
fn pool(off as i64) as *u8 { return cast(*u8, POOL.va + off); }

fn slen(s as *u8) as i64 { let is i64 as n with mut = 0; while (s[n] != 0) { n = n + 1; } return n; }

fn same(a as *u8, an as i64, b as *u8, bn as i64) as i64 {
    if (an != bn) { return 0; }
    let is i64 as i with mut = 0;
    while (i < an) { if (a[i] != b[i]) { return 0; } i = i + 1; }
    return 1;
}

fn streq(a as *u8, b as *u8) as i64 { return same(a, slen(a), b, slen(b)); }

// Whether s starts with the NUL-terminated prefix p.
fn starts(s as *u8, p as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (p[i] != 0) { if (s[i] != p[i]) { return 0; } i = i + 1; }
    return 1;
}

fn errnum(v as i64) as void {
    let is [24]u8 as d;
    let is i64 as n with mut = 0;
    let is i64 as x with mut = v;
    if (x < 0) { prog.errs("-"); x = 0 - x; }
    if (x == 0) { d[0] = cast(u8, 48); n = 1; }
    while (x > 0) { d[n] = cast(u8, 48 + x % 10); x = x / 10; n = n + 1; }
    let is [24]u8 as o;
    let is i64 as k with mut = 0;
    while (n > 0) { n = n - 1; o[k] = d[n]; k = k + 1; }
    prog.err(cast(*u8, &o[0]), k);
}

// ======================================================================
// characters

fn cp_at(s as *u8, n as i64, i as i64, len as *i64) as i64 {
    let is i32 as c with mut = 0;
    let is i64 as k = utf8.decode1(s, n, i, &c);
    if (k <= 0) { len[0] = 1; return 0x110000 + cast(i64, s[i]); }
    len[0] = k;
    return cast(i64, c);
}

fn add_cp(b as *Buf, c as i64) as void {
    if (c >= 0x110000) { b_addc(b, c - 0x110000); return; }
    let is [4]u8 as e;
    let is i64 as k = utf8.encode1(cast(i32, c), cast(*u8, &e[0]));
    if (k > 0) { b_add(b, cast(*u8, &e[0]), k); }
}

// ======================================================================
// script errors

// Where SCRIPT[at] is, said as GNU says it, then msg; exits 1.
fn say_where(at as i64) as void {
    let is i64 as k with mut = 0;
    let is i64 as best with mut = 0;
    while (k < CHUNKS.n) { if (chunk(k).start <= at) { best = k; } k = k + 1; }
    let is *Chunk as c = chunk(best);
    prog.errs("sed: ");
    if (c.kind == 0) {
        prog.errs("-e expression #"); errnum(c.num);
        prog.errs(", char "); errnum(at - c.start + 1);
    } else {
        let is i64 as line with mut = 1;
        let is *u8 as s = cast(*u8, SCRIPT.va);
        let is i64 as i with mut = c.start;
        while (i < at && i < SCRIPT.len) { if (s[i] == cast(u8, 10)) { line = line + 1; } i = i + 1; }
        prog.errs("file "); prog.errs(cast(*u8, c.name)); prog.errs(" line "); errnum(line);
    }
    prog.errs(": ");
}

fn bad(at as i64, msg as *u8) as void {
    say_where(at);
    prog.errs(msg); prog.errs("\n");
    sys.exit(cast(i32, 1));
}

// bad() with a name in the message: pre`name'post.
fn bad_named(at as i64, pre as *u8, name as *u8, nlen as i64, post as *u8) as void {
    say_where(at);
    prog.errs(pre); prog.err(name, nlen); prog.errs(post); prog.errs("\n");
    sys.exit(cast(i32, 1));
}

// A failure while running: says it, writes what is pending, exits 4.
fn die_run(msg as *u8) as void {
    flush_all();
    prog.errs("sed: "); prog.errs(msg); prog.errs("\n");
    sys.exit(cast(i32, 4));
}

// ======================================================================
// parsing the script

fn ch() as i64 {
    if (P >= SCRIPT.len) { return 0 - 1; }
    let is *u8 as s = cast(*u8, SCRIPT.va);
    return cast(i64, s[P]);
}
fn ch_at(k as i64) as i64 {
    if (P + k >= SCRIPT.len) { return 0 - 1; }
    let is *u8 as s = cast(*u8, SCRIPT.va);
    return cast(i64, s[P + k]);
}
fn adv() as void { P = P + 1; }
fn is_blank(c as i64) as i64 { if (c == 32 || c == 9) { return 1; } return 0; }
fn is_digit(c as i64) as i64 { if (c >= 48 && c <= 57) { return 1; } return 0; }
fn skip_blanks() as void { while (is_blank(ch()) == 1) { adv(); } }

fn number() as i64 {
    let is i64 as v with mut = 0;
    while (is_digit(ch()) == 1) {
        if (v > 100000000000000000) { bad(P, "number too large"); }
        v = v * 10 + ch() - 48;
        adv();
    }
    return v;
}

// SCRIPT[at .. at+n) into POOL; its offset.
fn pool_put(at as i64, n as i64) as i64 {
    let is i64 as off = POOL.len;
    b_add(&POOL, cast(*u8, SCRIPT.va + at), n);
    return off;
}

// Inside a bracket expression that opens at SCRIPT[i]: the offset of its
// closing ']', or -1 when there is none on this line (the '[' is then the
// regex's to complain about).
fn bracket_end(i as i64) as i64 {
    let is *u8 as s = cast(*u8, SCRIPT.va);
    let is i64 as n = SCRIPT.len;
    let is i64 as j with mut = i + 1;
    if (j < n && s[j] == cast(u8, 94)) { j = j + 1; }
    if (j < n && s[j] == cast(u8, 93)) { j = j + 1; }
    while (j < n) {
        let is i64 as c = cast(i64, s[j]);
        if (c == 10) { return 0 - 1; }
        if (c == 93) { return j; }
        if (c == 91 && j + 1 < n && (s[j + 1] == cast(u8, 58) || s[j + 1] == cast(u8, 61) || s[j + 1] == cast(u8, 46))) {
            let is u8 as kind = s[j + 1];
            let is i64 as k with mut = j + 2;
            while (k + 1 < n && s[k] != cast(u8, 10) && (s[k] != kind || s[k + 1] != cast(u8, 93))) { k = k + 1; }
            if (k + 1 >= n || s[k] == cast(u8, 10)) { return 0 - 1; }
            j = k + 2;
            continue;
        }
        j = j + 1;
    }
    return 0 - 1;
}

// One character of a regular expression at P, into out: \DELIM is the
// delimiter itself, \n and \<newline> a newline; anything else as it is.
fn rx_char(delim as i64, out as *Buf) as i64 {
    let is i64 as c = ch();
    if (c == 92) {
        let is i64 as d = ch_at(1);
        if (d < 0) { return 0 - 1; }
        P = P + 2;
        if (d == delim) { b_addc(out, d); }
        else if (d == 110 || d == 10) { b_addc(out, 10); }
        else { b_addc(out, 92); b_addc(out, d); }
        return 0;
    }
    b_addc(out, c);
    adv();
    return 0;
}

// The regex text after an opening delimiter, up to the closing one (consumed)
// into out. 0, or -1 when the line or the script ends first.
fn scan_regex(delim as i64, out as *Buf) as i64 {
    out.len = 0;
    while (1 == 1) {
        let is i64 as c = ch();
        if (c < 0 || c == 10) { return 0 - 1; }
        if (c == delim) { adv(); return 0; }
        if (c == 91) {
            let is i64 as e = bracket_end(P);
            if (e > 0) {
                while (P <= e) { if (rx_char(delim, out) != 0) { return 0 - 1; } }
                continue;
            }
        }
        if (rx_char(delim, out) != 0) { return 0 - 1; }
    }
    return 0 - 1;
}

// Compile the regex in TMPB with these extra flags: its RXS index, or -1 for an
// empty one (the last regex used).
fn add_rx(at as i64, flags as i64) as i64 {
    if (TMPB.len == 0) {
        if (flags != 0) { bad(at, "no modifiers are allowed on an empty regular expression"); }
        if (RXS.n == 0) { bad(at, "no previous regular expression"); }
        return 0 - 1;
    }
    let is i64 as fl with mut = re.RE_ESCAPES | flags;
    if (G_EXT == 1) { fl = fl | re.RE_EXTENDED; }
    let is i64 as k = arr_add(&RXS, sizeof(re.Regex));
    let is i64 as rc = re.compile(rx(k), cast(*u8, TMPB.va), TMPB.len, fl);
    if (rc != 0) { bad(at, re.err_text(rc)); }
    return k;
}

// An address at P. 1 with its kind etc. set, or 0 when there is none.
fn parse_addr(second as i64, kind as *i64, v as *i64, step as *i64, rxi as *i64) as i64 {
    let is i64 as c = ch();
    if (is_digit(c) == 1) {
        let is i64 as n = number();
        if (second == 0 && ch() == 126) {                     // FIRST~STEP
            adv();
            let is i64 as st with mut = 0;
            if (is_digit(ch()) == 1) { st = number(); }
            kind[0] = A_STEP; v[0] = n; step[0] = st;
            return 1;
        }
        if (n == 0 && second == 0) { kind[0] = A_ZERO; return 1; }
        if (n == 0) { bad(P, "invalid usage of line address 0"); }
        kind[0] = A_LINE; v[0] = n;
        return 1;
    }
    if (c == 36) { adv(); kind[0] = A_LAST; return 1; }
    if (second == 1 && (c == 43 || c == 126)) {               // +N ~N
        adv();
        if (is_digit(ch()) == 0) { bad(P, "expected a number after + or ~"); }
        v[0] = number();
        if (c == 43) { kind[0] = A_PLUS; } else { kind[0] = A_MULT; }
        return 1;
    }
    if (c == 47 || c == 92) {
        let is i64 as at = P;
        let is i64 as delim with mut = 47;
        if (c == 92) {
            adv();
            delim = ch();
            if (delim < 0 || delim == 10 || delim == 92) { bad(P, "unexpected end of the address regex"); }
        }
        adv();
        if (scan_regex(delim, &TMPB) != 0) { bad(P, "unterminated address regex"); }
        let is i64 as fl with mut = 0;
        while (ch() == 73 || ch() == 77) {                     // I M
            if (ch() == 73) { fl = fl | re.RE_ICASE; } else { fl = fl | re.RE_NEWLINE; }
            adv();
        }
        rxi[0] = add_rx(at, fl);
        kind[0] = A_RE;
        return 1;
    }
    return 0;
}

// After a command: blanks, then the end of the line, ';', '}', '#' or the
// end of the script.
fn end_cmd() as void {
    skip_blanks();
    let is i64 as c = ch();
    if (c < 0) { return; }
    if (c == 10 || c == 59) { adv(); return; }
    if (c == 125 || c == 35) { return; }
    bad(P, "extra characters after command");
}

// An escaped character in text (a i c, y): \t a tab and so on; the rest as
// themselves.
fn esc_char(d as i64) as i64 {
    if (d == 110) { return 10; }
    if (d == 116) { return 9; }
    if (d == 97) { return 7; }
    if (d == 102) { return 12; }
    if (d == 118) { return 11; }
    if (d == 114) { return 13; }
    return d;
}

// The text of a, i, c: "a text" on one line, or "a\" with the text on the
// lines that follow, a line ending in '\' continuing it.
fn read_text(ci as i64) as void {
    skip_blanks();
    let is i64 as c0 = ch();
    if (c0 < 0 || c0 == 10 || c0 == 59) { bad(P, "expected \\ after `a', `c' or `i'"); }
    if (c0 == 92) {
        adv();
        if (ch() == 10) { adv(); }
    }
    let is i64 as start = POOL.len;
    while (1 == 1) {
        let is i64 as c = ch();
        if (c < 0) { break; }
        if (c == 10) { adv(); break; }
        if (c == 92) {
            let is i64 as d = ch_at(1);
            if (d < 0) { adv(); break; }
            P = P + 2;
            if (d == 10) { b_addc(&POOL, 10); } else { b_addc(&POOL, esc_char(d)); }
            continue;
        }
        b_addc(&POOL, c);
        adv();
    }
    b_addc(&POOL, 10);
    cmd(ci).txt = start;
    cmd(ci).tlen = POOL.len - start;
}

// A label: after blanks, up to the end of the line, ';', a blank, or (for a
// branch) '}'.
fn read_label(ci as i64, branch as i64) as void {
    skip_blanks();
    let is i64 as start = P;
    while (1 == 1) {
        let is i64 as c = ch();
        if (c < 0 || c == 10 || c == 59 || is_blank(c) == 1) { break; }
        if (branch == 1 && c == 125) { break; }
        adv();
    }
    cmd(ci).txt = pool_put(start, P - start);
    cmd(ci).tlen = P - start;
}

// A file name: after blanks, the rest of the line.
fn read_fname(ci as i64) as void {
    skip_blanks();
    let is i64 as start = P;
    while (ch() >= 0 && ch() != 10) { adv(); }
    if (P == start) { bad(P, "missing filename in r/R/w/W commands"); }
    cmd(ci).txt = pool_put(start, P - start);
    cmd(ci).tlen = P - start;
    if (ch() == 10) { adv(); }
}

// name[0..n) as a NUL-terminated absolute path in buf (512 bytes). 0, or -1
// when it is too long to be a path.
fn path_of(name as *u8, n as i64, buf as *u8) as i64 {
    if (n > 250) { return 0 - 1; }
    let is [256]u8 as raw;
    let is i64 as i with mut = 0;
    while (i < n) { raw[i] = name[i]; i = i + 1; }
    raw[n] = cast(u8, 0);
    let is *u8 as p = prog.abspath(cast(*u8, &raw[0]), cast(*u8, &buf[256]));
    i = 0;
    while (p[i] != 0) { buf[i] = p[i]; i = i + 1; }
    buf[i] = cast(u8, 0);
    return 0;
}

// The output a w file name refers to: opened (emptied) the first time.
fn open_out(at as i64, off as i64, n as i64) as i64 {
    let is *u8 as name = pool(off);
    if (same(name, n, "/dev/stdout", 11) == 1) { return 0; }
    if (same(name, n, "/dev/stderr", 11) == 1) { return 1; }
    let is i64 as k with mut = 2;
    while (k < OUTS.n) {
        let is *Out as o = outp(k);
        if (o.nlen > 0 && same(pool(o.name), o.nlen, name, n) == 1) { return k; }
        k = k + 1;
    }
    let is [512]u8 as pb;
    if (path_of(name, n, cast(*u8, &pb[0])) != 0) { bad_named(at, "file name too long: `", name, n, "'"); }
    let is i64 as fd = sys.open_write(cast(*u8, &pb[0]));
    if (fd < 0) {
        say_where(at);
        prog.errs("couldn't open file "); prog.err(name, n); prog.errs(": "); prog.errs(sys.err_text(fd)); prog.errs("\n");
        sys.exit(cast(i32, 4));
    }
    let is i64 as idx = arr_add(&OUTS, sizeof(Out));
    let is *Out as o = outp(idx);
    o.fd = fd; o.name = off; o.nlen = n;
    return idx;
}

// The R reader for a file name (one per name, shared).
fn open_rin(off as i64, n as i64) as i64 {
    let is i64 as k with mut = 0;
    while (k < RINS.n) {
        if (same(pool(rin(k).name), rin(k).nlen, pool(off), n) == 1) { return k; }
        k = k + 1;
    }
    let is i64 as idx = arr_add(&RINS, sizeof(RIn));
    rin(idx).name = off; rin(idx).nlen = n;
    return idx;
}

// The replacement of an s command, after the regex's closing delimiter, up
// to and through the replacement's.
fn parse_repl(ci as i64, delim as i64) as void {
    let is i64 as first = RITEMS.n / 3;
    let is i64 as lit with mut = POOL.len;      // literal bytes not yet made an item
    while (1 == 1) {
        let is i64 as c = ch();
        if (c < 0 || c == 10) { bad(P, "unterminated `s' command"); }
        if (c == delim) { adv(); break; }
        let is i64 as item with mut = 0;
        let is i64 as iv with mut = 0;
        if (c == 38) { item = R_GROUP; iv = 0; adv(); }               // &
        else if (c == 92) {
            let is i64 as d = ch_at(1);
            if (d < 0) { bad(P, "unterminated `s' command"); }
            P = P + 2;
            if (d == delim) { b_addc(&POOL, d); }
            else if (is_digit(d) == 1) { item = R_GROUP; iv = d - 48; }
            else if (d == 76 || d == 85 || d == 69 || d == 108 || d == 117) { item = R_CASE; iv = d; }   // L U E l u
            else if (d == 10) { b_addc(&POOL, 10); }
            else if (d == 99) {                                         // \cX: control-X
                let is i64 as x = ch();
                if (x < 0 || x == 10) { bad(P, "stray \\c"); }
                adv();
                let is i64 as up with mut = x;
                if (up >= 97 && up <= 122) { up = up - 32; }
                b_addc(&POOL, up ^ 64);
            }
            else if (d == 100 || d == 111 || d == 120) {                // \dNNN \oNNN \xHH
                let is i64 as base with mut = 10; let is i64 as most with mut = 3;
                if (d == 111) { base = 8; }
                if (d == 120) { base = 16; most = 2; }
                let is i64 as v with mut = 0; let is i64 as got with mut = 0;
                while (got < most) {
                    let is i64 as x = ch();
                    let is i64 as dv with mut = 0 - 1;
                    if (x >= 48 && x <= 57) { dv = x - 48; }
                    else if (x >= 97 && x <= 102) { dv = x - 87; }
                    else if (x >= 65 && x <= 70) { dv = x - 55; }
                    if (dv < 0 || dv >= base) { break; }
                    v = v * base + dv; got = got + 1; adv();
                }
                if (got == 0) { b_addc(&POOL, d); } else { b_addc(&POOL, v & 255); }
            }
            else { b_addc(&POOL, esc_char(d)); }
        } else {
            b_addc(&POOL, c);
            adv();
        }
        if (item != 0) {
            if (POOL.len > lit) { ai_push(&RITEMS, R_LIT); ai_push(&RITEMS, lit); ai_push(&RITEMS, POOL.len - lit); }
            ai_push(&RITEMS, item); ai_push(&RITEMS, iv); ai_push(&RITEMS, 0);
            lit = POOL.len;
        }
    }
    if (POOL.len > lit) { ai_push(&RITEMS, R_LIT); ai_push(&RITEMS, lit); ai_push(&RITEMS, POOL.len - lit); }
    cmd(ci).ri = first;
    cmd(ci).rn = RITEMS.n / 3 - first;
}

fn parse_s(ci as i64) as void {
    let is i64 as delim = ch();
    if (delim < 0 || delim == 10 || delim == 92) { bad(P, "unterminated `s' command"); }
    if (delim >= 0x80) { bad(P, "delimiter character is not a single-byte character"); }
    adv();
    let is i64 as at = P;
    if (scan_regex(delim, &TMPB) != 0) { bad(P, "unterminated `s' command"); }
    parse_repl(ci, delim);
    let is i64 as fl with mut = 0;
    let is *Cmd as c with mut = cmd(ci);
    c.nth = 0; c.out = 0 - 1;
    while (1 == 1) {
        let is i64 as f = ch();
        if (f == 103) {                                                    // g
            if (c.gflag == 1) { bad(P, "multiple `g' options to `s' command"); }
            c.gflag = 1; adv();
        } else if (f == 112) {                                             // p
            if (c.pflag == 1) { bad(P, "multiple `p' options to `s' command"); }
            c.pflag = 1; adv();
        } else if (is_digit(f) == 1) {
            if (c.nth != 0) { bad(P, "multiple number options to `s' command"); }
            c.nth = number();
            if (c.nth == 0) { bad(P, "number option to `s' command may not be zero"); }
        } else if (f == 105 || f == 73) { fl = fl | re.RE_ICASE; adv(); }   // i I
        else if (f == 109 || f == 77) { fl = fl | re.RE_NEWLINE; adv(); }  // m M
        else if (f == 101) { bad(P, "the `e' flag (run the pattern space as a command) is not supported"); }
        else if (f == 119) {                                               // w FILE
            adv();
            read_fname(ci);
            c = cmd(ci);
            c.out = open_out(P, c.txt, c.tlen);
            c.txt = 0; c.tlen = 0;
            break;
        } else {
            if (f < 0 || f == 10 || f == 59 || f == 125 || f == 35 || is_blank(f) == 1) { end_cmd(); break; }
            bad(P, "unknown option to `s'");
        }
    }
    c = cmd(ci);
    if (c.nth == 0) { c.nth = 1; }
    c.rx = add_rx(at, fl);
    if (c.rx >= 0) {
        let is i64 as ng = re.groups(rx(c.rx));
        let is i64 as k with mut = c.ri;
        while (k < c.ri + c.rn) {
            if (ai(&RITEMS, k * 3) == R_GROUP && ai(&RITEMS, k * 3 + 1) > ng) {
                let is [32]u8 as m;
                m[0] = cast(u8, 92); m[1] = cast(u8, 48 + ai(&RITEMS, k * 3 + 1));
                bad_named(at, "invalid reference ", cast(*u8, &m[0]), 2, " on `s' command's RHS");
            }
            k = k + 1;
        }
    }
}

// One string of a y command into out (bytes): \\ \DELIM \n \t and the like
// are the characters they name.
fn scan_y(delim as i64, out as *Buf) as i64 {
    out.len = 0;
    while (1 == 1) {
        let is i64 as c = ch();
        if (c < 0 || c == 10) { return 0 - 1; }
        if (c == delim) { adv(); return 0; }
        if (c == 92) {
            let is i64 as d = ch_at(1);
            if (d < 0) { return 0 - 1; }
            P = P + 2;
            if (d == delim || d == 92) { b_addc(out, d); }
            else if (d == 10) { b_addc(out, 10); }
            else { b_addc(out, esc_char(d)); }
            continue;
        }
        b_addc(out, c);
        adv();
    }
    return 0 - 1;
}

fn to_cps(b as *Buf, out as *Arr) as void {
    out.n = 0;
    let is *u8 as s = cast(*u8, b.va);
    let is i64 as i with mut = 0;
    while (i < b.len) {
        let is i64 as k with mut = 0;
        ai_push(out, cp_at(s, b.len, i, &k));
        i = i + k;
    }
}

fn parse_y(ci as i64) as void {
    let is i64 as delim = ch();
    if (delim < 0 || delim == 10 || delim == 92) { bad(P, "unterminated `y' command"); }
    adv();
    if (scan_y(delim, &TMPB) != 0) { bad(P, "unterminated `y' command"); }
    to_cps(&TMPB, &YS);
    if (scan_y(delim, &TMPB) != 0) { bad(P, "unterminated `y' command"); }
    to_cps(&TMPB, &YD);
    if (YS.n != YD.n) { bad(P, "strings for `y' command are different lengths"); }
    let is i64 as first = YPAIRS.n;
    let is i64 as k with mut = 0;
    while (k < YS.n) { ai_push(&YPAIRS, ai(&YS, k)); ai_push(&YPAIRS, ai(&YD, k)); k = k + 1; }
    cmd(ci).yi = first;
    cmd(ci).yn = YS.n;
}

// An optional number argument (q Q l): -1 when there is none.
fn opt_num() as i64 {
    skip_blanks();
    if (is_digit(ch()) == 1) { return number(); }
    return 0 - 1;
}

fn compile_script() as void {
    let is *u8 as s0 = cast(*u8, SCRIPT.va);
    // "#n" as the script's first line is -n
    if (SCRIPT.len >= 2 && s0[0] == cast(u8, 35) && s0[1] == cast(u8, 110) && (SCRIPT.len == 2 || s0[2] == cast(u8, 10))) { G_N = 1; }
    P = 0;
    while (1 == 1) {
        while (is_blank(ch()) == 1 || ch() == 10 || ch() == 59) { adv(); }
        if (ch() < 0) { break; }
        if (ch() == 35) { while (ch() >= 0 && ch() != 10) { adv(); } continue; }
        let is i64 as pos0 = P;
        let is i64 as ci = arr_add(&CMDS, sizeof(Cmd));
        let is i64 as k1 with mut = 0; let is i64 as v1 with mut = 0; let is i64 as s1 with mut = 0; let is i64 as r1 with mut = 0 - 1;
        let is i64 as k2 with mut = 0; let is i64 as v2 with mut = 0; let is i64 as s2 with mut = 0; let is i64 as r2 with mut = 0 - 1;
        if (parse_addr(0, &k1, &v1, &s1, &r1) == 1) {
            skip_blanks();
            if (ch() == 44) {
                adv();
                skip_blanks();
                if (parse_addr(1, &k2, &v2, &s2, &r2) == 0) { bad(P, "unexpected `,'"); }
            }
        }
        if (k1 == A_ZERO && k2 != A_RE) { bad(P, "invalid usage of line address 0"); }
        skip_blanks();
        let is i64 as neg with mut = 0;
        while (ch() == 33) {
            if (neg == 1) { bad(P, "multiple `!'s"); }
            neg = 1; adv(); skip_blanks();
        }
        let is i64 as op = ch();
        if (op < 0 || op == 10 || op == 59) { bad(P, "missing command"); }
        let is i64 as opat = P;
        adv();
        let is *Cmd as c with mut = cmd(ci);
        c.op = op; c.pos = pos0; c.neg = neg;
        c.a1 = k1; c.v1 = v1; c.s1 = s1; c.r1 = r1;
        c.a2 = k2; c.v2 = v2; c.r2 = r2;
        c.out = 0 - 1; c.num = 0 - 1; c.jump = 0 - 1; c.rx = 0 - 1;
        if (op == 123) { ai_push(&BLOCKS, ci); }                                   // {
        else if (op == 125) {                                                      // }
            if (k1 != A_NONE || neg == 1) { bad(opat, "`}' doesn't want any addresses"); }
            if (BLOCKS.n == 0) { bad(opat, "unexpected `}'"); }
            BLOCKS.n = BLOCKS.n - 1;
            cmd(ai(&BLOCKS, BLOCKS.n)).jump = ci;
            end_cmd();
        }
        else if (op == 35) { bad(opat, "comments don't accept any addresses"); }
        else if (op == 61 || op == 100 || op == 68 || op == 103 || op == 71 || op == 104 || op == 72
                 || op == 110 || op == 78 || op == 112 || op == 80 || op == 120 || op == 122 || op == 70) {
            end_cmd();                                                            // = d D g G h H n N p P x z F
        }
        else if (op == 108) { c.num = opt_num(); end_cmd(); }                      // l [N]
        else if (op == 113 || op == 81) {                                          // q Q [code]
            if (k2 != A_NONE) { bad(opat, "command only uses one address"); }
            let is i64 as code = opt_num();
            c = cmd(ci);
            if (code < 0) { c.num = 0; } else { c.num = code; }
            end_cmd();
        }
        else if (op == 97 || op == 105 || op == 99) { read_text(ci); }            // a i c
        else if (op == 58) {                                                       // :label
            if (k1 != A_NONE) { bad(opat, ": doesn't want any addresses"); }
            read_label(ci, 0);
            c = cmd(ci);
            if (c.tlen == 0) { bad(opat, "\":\" lacks a label"); }
            let is i64 as k with mut = 0;
            while (k < ci) {
                let is *Cmd as o = cmd(k);
                if (o.op == 58 && same(pool(o.txt), o.tlen, pool(c.txt), c.tlen) == 1) { bad_named(opat, "duplicate label `", pool(c.txt), c.tlen, "'"); }
                k = k + 1;
            }
            end_cmd();
        }
        else if (op == 98 || op == 116 || op == 84) { read_label(ci, 1); end_cmd(); }   // b t T
        else if (op == 114) { read_fname(ci); }                                    // r
        else if (op == 82) { read_fname(ci); c = cmd(ci); c.num = open_rin(c.txt, c.tlen); }   // R
        else if (op == 119 || op == 87) { read_fname(ci); c = cmd(ci); c.out = open_out(opat, c.txt, c.tlen); }   // w W
        else if (op == 115) { parse_s(ci); }                                       // s
        else if (op == 121) { parse_y(ci); end_cmd(); }                            // y
        else if (op == 118) {                                                      // v [version]
            skip_blanks();
            while (ch() >= 0 && ch() != 10 && ch() != 59 && ch() != 125 && is_blank(ch()) == 0) { adv(); }
            end_cmd();
        }
        else if (op == 101) { bad(opat, "the `e' command (run a shell command) is not supported"); }
        else {
            let is i64 as k0 with mut = 0;
            cp_at(cast(*u8, SCRIPT.va), SCRIPT.len, opat, &k0);       // the whole character, if it is not ASCII
            bad_named(opat, "unknown command: `", cast(*u8, SCRIPT.va + opat), k0, "'");
        }
    }
    if (BLOCKS.n > 0) { bad(cmd(ai(&BLOCKS, BLOCKS.n - 1)).pos, "unmatched `{'"); }
    // the branches' labels
    let is i64 as i with mut = 0;
    while (i < CMDS.n) {
        let is *Cmd as c = cmd(i);
        if (c.op == 98 || c.op == 116 || c.op == 84) {
            if (c.tlen == 0) { c.jump = CMDS.n; }
            else {
                let is i64 as k with mut = 0;
                while (k < CMDS.n && c.jump < 0) {
                    let is *Cmd as o = cmd(k);
                    if (o.op == 58 && same(pool(o.txt), o.tlen, pool(c.txt), c.tlen) == 1) { c.jump = k; }
                    k = k + 1;
                }
                if (c.jump < 0) { bad_named(c.pos, "can't find label for jump to `", pool(c.txt), c.tlen, "'"); }
            }
        }
        i = i + 1;
    }
}

// ======================================================================
// output

fn o_raw(o as *Out, p as *u8, n as i64) as void {
    if (n <= 0) { return; }
    if (o.cap == 0) {
        let is i64 as va = sys.mmap(0, 16384, sys.PROT_READ | sys.PROT_WRITE);
        if (va < 0) { oom(); }
        o.va = va; o.cap = 16384;
    }
    if (o.len + n > o.cap) { o_flush(o); }
    if (n > o.cap) { o_send(o, cast(i64, p), n); return; }
    mcopy(o.va + o.len, cast(i64, p), n);
    o.len = o.len + n;
}

fn o_send(o as *Out, va as i64, n as i64) as void {
    let is i64 as off with mut = 0;
    while (off < n) {
        let is i64 as r = sys.write(o.fd, cast(*u8, va + off), n - off);
        if (r <= 0) {
            prog.errs("sed: couldn't write to ");
            if (o.nlen > 0) { prog.err(pool(o.name), o.nlen); }
            else if (o.fd == 1) { prog.errs("stdout"); } else if (o.fd == 2) { prog.errs("stderr"); } else { prog.errs("the output file"); }
            prog.errs(": "); prog.errs(sys.err_text(r)); prog.errs("\n");
            sys.exit(cast(i32, 4));
        }
        off = off + r;
    }
}

fn o_flush(o as *Out) as void {
    if (o.len == 0) { return; }
    let is i64 as n = o.len;
    o.len = 0;
    o_send(o, o.va, n);
}

fn flush_all() as void {
    let is i64 as k with mut = 0;
    while (k < OUTS.n) { o_flush(outp(k)); k = k + 1; }
}

fn o_sepc(o as *Out) as void {
    let is [1]u8 as b;
    b[0] = cast(u8, SEPC);
    o_raw(o, cast(*u8, &b[0]), 1);
}

// Output that follows a record which went out without its separator puts the
// separator first: `printf a | sed p` prints "a\na", as GNU's does.
fn o_write(o as *Out, p as *u8, n as i64) as void {
    if (o.missing == 1) { o.missing = 0; o_sepc(o); }
    o_raw(o, p, n);
}

// A record, ended with the separator unless the input's last one had none.
fn o_record(o as *Out, p as *u8, n as i64, nl as i64) as void {
    o_write(o, p, n);
    if (nl == 1) { o_sepc(o); } else { o.missing = 1; }
}

fn o_ps(o as *Out) as void { o_record(o, cast(*u8, PS.va), PS.len, PS_NL); }

// The pattern space up to its first newline (P, W): a record of its own.
fn o_first(o as *Out) as void {
    let is *u8 as s = cast(*u8, PS.va);
    let is i64 as j with mut = 0;
    while (j < PS.len && s[j] != cast(u8, 10)) { j = j + 1; }
    if (j == PS.len) { o_ps(o); return; }
    o_record(o, s, j, 1);
}

fn o_num(o as *Out, v as i64) as void {
    let is [24]u8 as d;
    let is i64 as n with mut = 0;
    let is i64 as x with mut = v;
    if (x == 0) { d[0] = cast(u8, 48); n = 1; }
    while (x > 0) { d[n] = cast(u8, 48 + x % 10); x = x / 10; n = n + 1; }
    let is [25]u8 as t;
    let is i64 as k with mut = 0;
    while (n > 0) { n = n - 1; t[k] = d[n]; k = k + 1; }
    t[k] = cast(u8, 10);
    o_write(o, cast(*u8, &t[0]), k + 1);
}

fn cur() as *Out { return outp(CUR_OUT); }

// l: the pattern space with \\ \a \b \f \n \r \t \v, octal for any other byte
// that is not printable ASCII, lines wrapped with a '\' before `width`
// columns, and a '$' at the end.
fn list(width as i64) as void {
    let is *Out as o = cur();
    let is *u8 as s = cast(*u8, PS.va);
    let is i64 as col with mut = 0;
    let is i64 as i with mut = 0;
    while (i < PS.len) {
        let is [16]u8 as r;
        let is i64 as rn with mut = 0;
        let is i64 as c = cast(i64, s[i]);
        let is i64 as esc with mut = 0;
        if (c == 92) { esc = 92; }
        else if (c == 7) { esc = 97; } else if (c == 8) { esc = 98; } else if (c == 12) { esc = 102; }
        else if (c == 10) { esc = 110; } else if (c == 13) { esc = 114; } else if (c == 9) { esc = 116; }
        else if (c == 11) { esc = 118; }
        if (esc != 0) { r[0] = cast(u8, 92); r[1] = cast(u8, esc); rn = 2; }
        else if (c >= 32 && c < 127) { r[0] = cast(u8, c); rn = 1; }
        else {
            // every other byte in octal, those of UTF-8 characters too: what
            // `l` is for is seeing the bytes (GNU's does the same)
            r[0] = cast(u8, 92);
            r[1] = cast(u8, 48 + ((c >> 6) & 7)); r[2] = cast(u8, 48 + ((c >> 3) & 7)); r[3] = cast(u8, 48 + (c & 7));
            rn = 4;
        }
        if (width > 1 && col + rn > width - 1) { o_write(o, "\\\n", 2); col = 0; }
        o_write(o, cast(*u8, &r[0]), rn);
        col = col + rn;
        i = i + 1;
    }
    o_write(o, "$", 1);
    o_sepc(o);                                    // with -z, a NUL like every record
}

// ======================================================================
// input

fn close_input() as void {
    if (RD_OPEN == 1 && RD.fd > 0) { sys.close(RD.fd); }
    RD_OPEN = 0;
}

// Start reading the file operand `name`. 1, or 0 (said why) when it cannot be read.
fn open_file(name as *u8) as i64 {
    let is i64 as fd with mut = 0;
    if (fu.is_dash(name) == 0) {
        let is [256]u8 as pb;
        fd = sys.open_read(prog.abspath(name, cast(*u8, &pb[0])));
        if (fd < 0) {
            prog.errs("sed: can't read "); prog.errs(name); prog.errs(": "); prog.errs(sys.err_text(fd)); prog.errs("\n");
            BADFILES = 1;
            return 0;
        }
    }
    fu.rd_open_fd(&RD, fd, cast(*u8, &STAGE[0]), 65536);
    RD_OPEN = 1;
    RD_NAME = cast(i64, name);
    RD_ERR = 0;
    return 1;
}

fn open_next() as i64 {
    while (FI < FILES.n) {
        let is *u8 as name = cast(*u8, ai(&FILES, FI));
        FI = FI + 1;
        if (open_file(name) == 1) { return 1; }
    }
    return 0;
}

// The next record of the input: across files, or (separately) of this one.
fn next_any(l as *fu.Line) as i64 {
    while (1 == 1) {
        if (RD_OPEN == 1) {
            let is i64 as rc = fu.rd_rec(&RD, l, SEPC);
            if (rc > 0) { return 1; }
            if (rc < 0) {
                prog.errs("sed: read error on "); prog.errs(cast(*u8, RD_NAME)); prog.errs(": "); prog.errs(sys.err_text(rc)); prog.errs("\n");
                BADFILES = 1;
                RD_ERR = 1;
            }
            close_input();
        }
        if (G_SEP == 1) { return 0; }
        if (open_next() == 0) { return 0; }
    }
    return 0;
}

// Read ahead: only when something asks ($, n, N, the next cycle), so a sed on
// a terminal answers each line as it is typed.
fn peek() as void {
    flush_all();
    if (next_any(&LOOK) == 1) { LOOK_ST = 1; LOOK_NAME = RD_NAME; } else { LOOK_ST = 2; }
}

fn is_last() as i64 {
    if (LOOK_ST == 0) { peek(); }
    if (LOOK_ST == 2) { return 1; }
    return 0;
}

// The next record into the pattern space (after a newline, for N). 0 when the
// input is done.
fn read_line(append as i64) as i64 {
    if (LOOK_ST == 0) { peek(); }
    if (LOOK_ST == 2) { return 0; }
    if (append == 1) { b_addc(&PS, 10); } else { PS.len = 0; }
    b_add(&PS, cast(*u8, LOOK.va), LOOK.len);
    PS_NL = LOOK.nl;
    CUR_NAME = LOOK_NAME;
    LINENO = LINENO + 1;
    TFLAG = 0;
    LOOK_ST = 0;
    return 1;
}

// R: the next line of its file onto the append queue.
fn rin_line(i as i64) as void {
    let is *RIn as f = rin(i);
    if (f.state == 2) { return; }
    if (f.state == 0) {
        let is i64 as fd with mut = 0;
        if (same(pool(f.name), f.nlen, "/dev/stdin", 10) == 0) {
            let is [512]u8 as pb;
            if (path_of(pool(f.name), f.nlen, cast(*u8, &pb[0])) != 0) { f.state = 2; return; }
            fd = sys.open_read(cast(*u8, &pb[0]));
            if (fd < 0) { f.state = 2; return; }
        }
        let is i64 as st = sys.mmap(0, 4096, sys.PROT_READ | sys.PROT_WRITE);
        if (st < 0) { oom(); }
        f.stage = st;
        fu.rd_open_fd(&f.r, fd, cast(*u8, st), 4096);
        f.state = 1;
    }
    if (fu.rd_rec(&f.r, &f.line, SEPC) <= 0) {
        if (f.r.fd > 0) { sys.close(f.r.fd); }
        f.state = 2;
        return;
    }
    let is i64 as off = AQ.len;
    b_add(&AQ, cast(*u8, f.line.va), f.line.len);
    b_addc(&AQ, SEPC);
    ai_push(&AQI, 1); ai_push(&AQI, off); ai_push(&AQI, f.line.len + 1);
}

// What a and r and R queued, written out: at the end of the cycle, or before
// n and N read the next line.
fn dump_append() as void {
    let is *Out as o = cur();
    let is i64 as k with mut = 0;
    while (k < AQI.n) {
        let is i64 as kind = ai(&AQI, k);
        let is i64 as a = ai(&AQI, k + 1);
        let is i64 as n = ai(&AQI, k + 2);
        if (kind == 1) { o_write(o, cast(*u8, AQ.va + a), n); }
        else {
            let is i64 as fd with mut = 0 - 1;
            if (same(pool(a), n, "/dev/stdin", 10) == 1) { fd = 0; }
            else {
                let is [512]u8 as pb;
                if (path_of(pool(a), n, cast(*u8, &pb[0])) == 0) { fd = sys.open_read(cast(*u8, &pb[0])); }
            }
            if (fd >= 0) {
                let is [4096]u8 as buf;
                while (1 == 1) {
                    let is i64 as r = sys.read(fd, cast(*u8, &buf[0]), 4096);
                    if (r <= 0) { break; }
                    o_write(o, cast(*u8, &buf[0]), r);
                }
                if (fd > 0) { sys.close(fd); }
            }
        }
        k = k + 3;
    }
    AQI.n = 0;
    AQ.len = 0;
}

// ======================================================================
// running the script

fn rx_hit(i as i64) as i64 {
    let is i64 as k with mut = i;
    if (k < 0) { k = LAST_RX; if (k < 0) { die_run("no previous regular expression"); } }
    LAST_RX = k;
    let is i64 as rc = re.matches(rx(k), cast(*u8, PS.va), PS.len, 0);
    if (rc < 0) { die_run(re.err_text(rc)); }
    return rc;
}

fn match1(c as *Cmd) as i64 {
    let is i64 as k = c.a1;
    if (k == A_LINE) { if (LINENO == c.v1) { return 1; } return 0; }
    if (k == A_LAST) { return is_last(); }
    if (k == A_RE) { return rx_hit(c.r1); }
    if (k == A_STEP) {
        if (c.s1 <= 0) { if (LINENO == c.v1) { return 1; } return 0; }
        if (LINENO >= c.v1 && (LINENO - c.v1) % c.s1 == 0) { return 1; }
        return 0;
    }
    return 0;
}

// The first address matched this line: does the range go on past it?
fn range_from(c as *Cmd) as void {
    let is i64 as k = c.a2;
    if (k == A_LINE) { if (c.v2 > LINENO) { c.active = 1; } }
    else if (k == A_PLUS) { if (c.v2 > 0) { c.end = LINENO + c.v2; c.active = 1; } }
    else if (k == A_MULT) {
        if (c.v2 > 0 && LINENO % c.v2 != 0) { c.end = (LINENO / c.v2 + 1) * c.v2; c.active = 1; }
    }
    else if (k == A_LAST) { if (is_last() == 0) { c.active = 1; } }
    else if (k == A_RE) { c.active = 1; }               // the end is looked for from the next line
}

fn selected(c as *Cmd) as i64 {
    let is i64 as hit with mut = 0;
    if (c.a1 == A_NONE) { hit = 1; }
    else if (c.a2 == A_NONE) { hit = match1(c); }
    else if (c.active == 1) {
        hit = 1;
        let is i64 as k = c.a2;
        if (k == A_LINE || k == A_PLUS || k == A_MULT) {
            let is i64 as e with mut = c.end;
            if (k == A_LINE) { e = c.v2; }
            if (LINENO >= e) { c.active = 0; }
            if (LINENO > e) {                             // N took the range past its end
                hit = match1(c);
                if (hit == 1) { range_from(c); }
            }
        }
        else if (k == A_LAST) { if (is_last() == 1) { c.active = 0; } }
        else if (k == A_RE) { if (rx_hit(c.r2) == 1) { c.active = 0; } }
    }
    else if (match1(c) == 1) { hit = 1; range_from(c); }
    if (c.neg == 1) { return 1 - hit; }
    return hit;
}

// Text in case mode: mode 1 upper, 2 lower; once (1 upper, 2 lower) for the
// next character only.
fn add_cased(dst as *Buf, p as *u8, n as i64, mode as *i64, once as *i64) as void {
    if (mode[0] == 0 && once[0] == 0) { b_add(dst, p, n); return; }
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as k with mut = 0;
        let is i64 as c with mut = cp_at(p, n, i, &k);
        if (once[0] == 1) { c = ucase.upper(c); once[0] = 0; }
        else if (once[0] == 2) { c = ucase.lower(c); once[0] = 0; }
        else if (mode[0] == 1) { c = ucase.upper(c); }
        else if (mode[0] == 2) { c = ucase.lower(c); }
        add_cp(dst, c);
        i = i + k;
    }
}

fn expand(c as *Cmd, m as *i64, dst as *Buf) as void {
    let is i64 as mode with mut = 0;
    let is i64 as once with mut = 0;
    let is i64 as k with mut = c.ri;
    while (k < c.ri + c.rn) {
        let is i64 as t = ai(&RITEMS, k * 3);
        let is i64 as a = ai(&RITEMS, k * 3 + 1);
        let is i64 as b = ai(&RITEMS, k * 3 + 2);
        if (t == R_LIT) { add_cased(dst, pool(a), b, &mode, &once); }
        else if (t == R_GROUP) {
            let is i64 as gs = m[a * 2];
            let is i64 as ge = m[a * 2 + 1];
            if (gs >= 0 && ge >= gs) { add_cased(dst, cast(*u8, PS.va + gs), ge - gs, &mode, &once); }
        }
        else if (t == R_CASE) {
            // \U and \L drop a \u or \l still waiting (GNU's \u\L is all
            // lower case; \L\u is how to capitalise)
            if (a == 85) { mode = 1; once = 0; }
            else if (a == 76) { mode = 2; once = 0; }
            else if (a == 69) { mode = 0; once = 0; }
            else if (a == 117) { once = 1; }
            else if (a == 108) { once = 2; }
        }
        k = k + 1;
    }
}

fn subst(c as *Cmd) as void {
    let is i64 as k with mut = c.rx;
    if (k < 0) { k = LAST_RX; if (k < 0) { die_run("no previous regular expression"); } }
    LAST_RX = k;
    let is *re.Regex as r = rx(k);
    let is *u8 as s = cast(*u8, PS.va);
    let is i64 as n = PS.len;
    TMP.len = 0;
    let is [20]i64 as m;
    let is i64 as count with mut = 0;
    let is i64 as pos with mut = 0;
    let is i64 as prev with mut = 0 - 1;
    let is i64 as did with mut = 0;
    while (pos <= n) {
        let is i64 as rc = re.search(r, s, n, pos, 0, cast(*i64, &m[0]), 10);
        if (rc < 0) { die_run(re.err_text(rc)); }
        if (rc == 0) { break; }
        let is i64 as a = m[0];
        let is i64 as b = m[1];
        if (a == b && a == prev) {
            // empty, right where the last match ended: not a match ("baaac",
            // s/a*/x/g, is "xbxcx")
            if (a >= n) { break; }
            let is i64 as e = re.char_end(s, n, a);
            b_add(&TMP, cast(*u8, cast(i64, s) + pos), e - pos);
            pos = e;
            continue;
        }
        count = count + 1;
        b_add(&TMP, cast(*u8, cast(i64, s) + pos), a - pos);
        if (count >= c.nth && (c.gflag == 1 || count == c.nth)) { expand(c, cast(*i64, &m[0]), &TMP); did = 1; }
        else { b_add(&TMP, cast(*u8, cast(i64, s) + a), b - a); }
        prev = b;
        pos = b;
        if (did == 1 && c.gflag == 0) { break; }
        if (b == a) {
            if (a >= n) { break; }
            let is i64 as e2 = re.char_end(s, n, a);
            b_add(&TMP, cast(*u8, cast(i64, s) + a), e2 - a);
            pos = e2;
        }
    }
    if (did == 0) { return; }
    if (pos < n) { b_add(&TMP, cast(*u8, cast(i64, s) + pos), n - pos); }
    b_swap(&PS, &TMP);
    TFLAG = 1;
    if (c.pflag == 1) { o_ps(cur()); }
    if (c.out >= 0) { o_ps(outp(c.out)); }
}

fn translit(c as *Cmd) as void {
    let is *u8 as s = cast(*u8, PS.va);
    TMP.len = 0;
    let is i64 as i with mut = 0;
    while (i < PS.len) {
        let is i64 as k with mut = 0;
        let is i64 as x with mut = cp_at(s, PS.len, i, &k);
        let is i64 as j with mut = 0;
        while (j < c.yn) {
            if (ai(&YPAIRS, c.yi + j * 2) == x) { x = ai(&YPAIRS, c.yi + j * 2 + 1); j = c.yn; }
            j = j + 1;
        }
        add_cp(&TMP, x);
        i = i + k;
    }
    b_swap(&PS, &TMP);
}

fn exec_script() as i64 {
    let is i64 as pc with mut = 0;
    while (pc < CMDS.n) {
        let is *Cmd as c = cmd(pc);
        let is i64 as op = c.op;
        if (selected(c) == 0) {
            if (op == 123) { pc = c.jump + 1; } else { pc = pc + 1; }
            continue;
        }
        pc = pc + 1;
        if (op == 123 || op == 125 || op == 58 || op == 118) { continue; }
        if (op == 61) { o_num(cur(), LINENO); }                                         // =
        else if (op == 97) {                                                            // a
            let is i64 as off = AQ.len;
            b_add(&AQ, pool(c.txt), c.tlen);
            ai_push(&AQI, 1); ai_push(&AQI, off); ai_push(&AQI, c.tlen);
        }
        else if (op == 105) { o_write(cur(), pool(c.txt), c.tlen); }                   // i
        else if (op == 99) {                                                            // c
            if (c.a2 == A_NONE || c.neg == 1 || c.active == 0) { o_write(cur(), pool(c.txt), c.tlen); }
            return RUN_DEL;
        }
        else if (op == 98) { pc = c.jump; }                                             // b
        else if (op == 116) { if (TFLAG == 1) { TFLAG = 0; pc = c.jump; } }             // t
        else if (op == 84) { if (TFLAG == 0) { pc = c.jump; } else { TFLAG = 0; } }     // T
        else if (op == 100) { return RUN_DEL; }                                         // d
        else if (op == 68) {                                                            // D
            let is *u8 as s = cast(*u8, PS.va);
            let is i64 as j with mut = 0;
            while (j < PS.len && s[j] != cast(u8, 10)) { j = j + 1; }
            if (j == PS.len) { return RUN_DEL; }
            mcopy(PS.va, PS.va + j + 1, PS.len - j - 1);
            PS.len = PS.len - j - 1;
            return RUN_AGAIN;
        }
        else if (op == 70) {                                                            // F
            let is *u8 as nm with mut = cast(*u8, CUR_NAME);
            if (CUR_NAME == 0) { nm = "-"; }
            o_write(cur(), nm, slen(nm)); o_write(cur(), "\n", 1);
        }
        else if (op == 103) { PS.len = 0; b_add(&PS, cast(*u8, HS.va), HS.len); PS_NL = HS_NL; }   // g
        else if (op == 71) { b_addc(&PS, 10); b_add(&PS, cast(*u8, HS.va), HS.len); }    // G
        else if (op == 104) { HS.len = 0; b_add(&HS, cast(*u8, PS.va), PS.len); HS_NL = PS_NL; }   // h
        else if (op == 72) { b_addc(&HS, 10); b_add(&HS, cast(*u8, PS.va), PS.len); }    // H
        else if (op == 120) { b_swap(&PS, &HS); let is i64 as t = PS_NL; PS_NL = HS_NL; HS_NL = t; }   // x
        else if (op == 108) { if (c.num >= 0) { list(c.num); } else { list(G_LWIDTH); } }   // l
        else if (op == 110) {                                                           // n
            if (is_last() == 1) { return RUN_END; }
            if (G_N == 0) { o_ps(cur()); }
            dump_append();
            read_line(0);
        }
        else if (op == 78) {                                                            // N
            if (is_last() == 1) { return RUN_END; }
            dump_append();
            read_line(1);
        }
        else if (op == 112) { o_ps(cur()); }                                            // p
        else if (op == 80) { o_first(cur()); }                                          // P
        else if (op == 113) { QCODE = c.num; return RUN_QUIT; }                         // q
        else if (op == 81) { QCODE = c.num; return RUN_QUITNOW; }                       // Q
        else if (op == 114) { ai_push(&AQI, 2); ai_push(&AQI, c.txt); ai_push(&AQI, c.tlen); }   // r
        else if (op == 82) { rin_line(c.num); }                                         // R
        else if (op == 115) { subst(c); }                                               // s
        else if (op == 119) { o_ps(outp(c.out)); }                                      // w
        else if (op == 87) { o_first(outp(c.out)); }                                    // W
        else if (op == 121) { translit(c); }                                            // y
        else if (op == 122) { PS.len = 0; }                                             // z
    }
    return RUN_END;
}

fn cycle() as void {
    while (1 == 1) {
        let is i64 as r = exec_script();
        if (r == RUN_QUITNOW) { QUIT = 1; return; }
        if ((r == RUN_END || r == RUN_QUIT) && G_N == 0) { o_ps(cur()); }
        dump_append();
        if (r == RUN_QUIT) { QUIT = 1; return; }
        if (r != RUN_AGAIN) { return; }
    }
}

// One input stream (all the files, or one with -s/-i) through the script.
fn run() as void {
    let is i64 as i with mut = 0;
    while (i < CMDS.n) {
        let is *Cmd as c = cmd(i);
        c.active = 0;
        if (c.a1 == A_ZERO) { c.active = 1; }         // 0,/RE/: in the range before line 1
        i = i + 1;
    }
    LOOK_ST = 0;
    while (QUIT == 0) {
        if (read_line(0) == 0) { break; }
        cycle();
        flush_all();
    }
}

// -i: FILE's output into a temporary next to it, renamed over it at the end
// (the old one first renamed to its backup name, with a suffix).
fn in_place(name as *u8, tmp_out as i64) as void {
    if (fu.is_dash(name) == 1) { prog.errs("sed: couldn't edit -: not a regular file\n"); BADFILES = 1; return; }
    let is [256]u8 as pb;
    let is *u8 as ap = prog.abspath(name, cast(*u8, &pb[0]));
    let is [320]u8 as path;
    let is i64 as pl = slen(ap);
    let is i64 as i with mut = 0;
    while (i <= pl) { path[i] = ap[i]; i = i + 1; }
    if (open_file(name) == 0) { return; }
    // the temporary: PATH.sedPID, in the same directory, so the rename stays on the volume
    let is [320]u8 as tmp;
    i = 0;
    while (i < pl) { tmp[i] = path[i]; i = i + 1; }
    tmp[i] = cast(u8, 46); tmp[i + 1] = cast(u8, 115); tmp[i + 2] = cast(u8, 101); tmp[i + 3] = cast(u8, 100);
    let is i64 as t with mut = i + 4;
    let is [24]u8 as d; let is i64 as dn with mut = 0; let is i64 as pid with mut = sys.getpid();
    if (pid <= 0) { pid = 1; }
    while (pid > 0) { d[dn] = cast(u8, 48 + pid % 10); pid = pid / 10; dn = dn + 1; }
    while (dn > 0) { dn = dn - 1; tmp[t] = d[dn]; t = t + 1; }
    tmp[t] = cast(u8, 0);
    let is i64 as fd = sys.open_write(cast(*u8, &tmp[0]));
    if (fd < 0) {
        close_input();
        prog.errs("sed: couldn't open temporary file "); prog.errs(cast(*u8, &tmp[0])); prog.errs(": "); prog.errs(sys.err_text(fd)); prog.errs("\n");
        sys.exit(cast(i32, 4));
    }
    let is *Out as o = outp(tmp_out);
    o.fd = fd; o.len = 0; o.missing = 0;
    CUR_OUT = tmp_out;
    LINENO = 0;
    run();
    close_input();
    o_flush(outp(tmp_out));
    sys.close(fd);
    CUR_OUT = 0;
    if (RD_ERR == 1) {                      // the file was not read whole: leave it as it was
        sys.unlink(cast(*u8, &tmp[0]));
        return;
    }
    if (G_SUFFIX != 0) {
        let is [640]u8 as bak;
        backup_name(cast(*u8, &path[0]), pl, cast(*u8, G_SUFFIX), cast(*u8, &bak[0]));
        let is i32 as rb = sys.rename(cast(*u8, &path[0]), cast(*u8, &bak[0]));
        if (rb != 0) {
            sys.unlink(cast(*u8, &tmp[0]));
            prog.errs("sed: cannot rename "); prog.errs(cast(*u8, &path[0])); prog.errs(": "); prog.errs(sys.err_text(cast(i64, rb))); prog.errs("\n");
            sys.exit(cast(i32, 4));
        }
    }
    let is i32 as rr = sys.rename(cast(*u8, &tmp[0]), cast(*u8, &path[0]));
    if (rr != 0) {
        prog.errs("sed: cannot rename "); prog.errs(cast(*u8, &tmp[0])); prog.errs(": "); prog.errs(sys.err_text(cast(i64, rr))); prog.errs("\n");
        sys.exit(cast(i32, 4));
    }
}

// The backup's path: PATH+SUFFIX, or, when SUFFIX has a '*', SUFFIX with each
// '*' made the file's name — in the file's directory unless it names one.
fn backup_name(path as *u8, pl as i64, suf as *u8, out as *u8) as void {
    let is i64 as star with mut = 0;
    let is i64 as slash with mut = 0;
    let is i64 as i with mut = 0;
    while (suf[i] != 0) {
        if (suf[i] == cast(u8, 42)) { star = 1; }
        if (suf[i] == cast(u8, 47)) { slash = 1; }
        i = i + 1;
    }
    let is i64 as o with mut = 0;
    if (star == 0) {
        i = 0; while (i < pl && o < 600) { out[o] = path[i]; o = o + 1; i = i + 1; }
        i = 0; while (suf[i] != 0 && o < 600) { out[o] = suf[i]; o = o + 1; i = i + 1; }
        out[o] = cast(u8, 0);
        return;
    }
    let is i64 as base with mut = 0;          // where the file's own name starts
    i = 0;
    while (i < pl) { if (path[i] == cast(u8, 47)) { base = i + 1; } i = i + 1; }
    if (slash == 0) { i = 0; while (i < base && o < 600) { out[o] = path[i]; o = o + 1; i = i + 1; } }
    else if (suf[0] != cast(u8, 47)) { out[o] = cast(u8, 47); o = o + 1; }
    i = 0;
    while (suf[i] != 0 && o < 600) {
        if (suf[i] == cast(u8, 42)) {
            let is i64 as k with mut = base;
            while (k < pl && o < 600) { out[o] = path[k]; o = o + 1; k = k + 1; }
        } else { out[o] = suf[i]; o = o + 1; }
        i = i + 1;
    }
    out[o] = cast(u8, 0);
}

// ======================================================================
// options

fn usage(fd as i64) as void {
    let is *u8 as u = "Usage: sed [OPTION]... {script-only-if-no-other-script} [input-file]...\n\n  -n, --quiet, --silent\n                 suppress automatic printing of pattern space\n  -e script, --expression=script\n                 add the script to the commands to be executed\n  -f script-file, --file=script-file\n                 add the contents of script-file to the commands to be executed\n  -i[SUFFIX], --in-place[=SUFFIX]\n                 edit files in place (makes backup if SUFFIX supplied)\n  -l N, --line-length=N\n                 specify the desired line-wrap length for the `l' command\n  -E, -r, --regexp-extended\n                 use extended regular expressions in the script\n  -s, --separate\n                 consider files as separate rather than as a single\n                 continuous long stream.\n  -u, --unbuffered\n                 (output is written at the end of every cycle anyway)\n  -z, --null-data\n                 separate lines by NUL characters\n      --help     display this help and exit\n";
    if (fd == 1) { prog.outs(u); } else { prog.errs(u); }
}

fn add_chunk(p as *u8, n as i64, kind as i64, num as i64, name as *u8) as void {
    let is i64 as k = arr_add(&CHUNKS, sizeof(Chunk));
    let is *Chunk as c = chunk(k);
    c.start = SCRIPT.len; c.kind = kind; c.num = num; c.name = cast(i64, name);
    b_add(&SCRIPT, p, n);
    b_addc(&SCRIPT, 10);
}

let is i64 as NEXPR with mut = 0;

fn add_expr(s as *u8) as void {
    NEXPR = NEXPR + 1;
    add_chunk(s, slen(s), 0, NEXPR, cast(*u8, 0));
}

fn add_file(name as *u8) as void {
    let is [1]i64 as len;
    let is i64 as va with mut = 0;
    if (fu.is_dash(name) == 1) { va = fu.slurp_fd(0, cast(*i64, &len[0])); }
    else {
        let is [256]u8 as pb;
        let is *u8 as ap = prog.abspath(name, cast(*u8, &pb[0]));
        va = fu.slurp(ap, cast(*i64, &len[0]));
        if (len[0] < 0) {
            let is i64 as why with mut = sys.E_IO;
            let is i64 as fd = sys.open_read(ap);
            if (fd < 0) { why = fd; } else { sys.close(fd); }
            prog.errs("sed: couldn't open file "); prog.errs(name); prog.errs(": "); prog.errs(sys.err_text(why)); prog.errs("\n");
            sys.exit(cast(i32, 1));
        }
    }
    if (len[0] < 0) { prog.errs("sed: couldn't read the script from standard input\n"); sys.exit(cast(i32, 1)); }
    add_chunk(cast(*u8, va), len[0], 1, 0, name);
}

fn bad_option(s as *u8) as void {
    prog.errs("sed: "); prog.errs(s); prog.errs("\n");
    usage(2);
    sys.exit(cast(i32, 1));
}

fn set_lwidth(v as *u8) as void {
    if (v == cast(*u8, 0) || v[0] == 0) { bad_option("option requires an argument -- 'l'"); }
    let is i64 as n = fu.parse_uint(v, slen(v));
    if (n < 0) { prog.errs("sed: invalid line length: "); prog.errs(v); prog.errs("\n"); sys.exit(cast(i32, 1)); }
    G_LWIDTH = n;
}

fn main(argc as i64, argv as *u8) as i32 {
    let is i64 as so = arr_add(&OUTS, sizeof(Out));
    outp(so).fd = 1;
    let is i64 as se = arr_add(&OUTS, sizeof(Out));
    outp(se).fd = 2;
    let is Arr as oper;
    oper.va = 0; oper.cap = 0; oper.n = 0;
    let is i64 as nscripts with mut = 0;
    let is i64 as done with mut = 0;
    let is i64 as i with mut = 1;
    while (i < argc) {
        let is *u8 as a = prog.arg(argv, i);
        i = i + 1;
        if (done == 1 || a[0] != cast(u8, 45) || a[1] == cast(u8, 0)) { ai_push(&oper, cast(i64, a)); continue; }
        if (a[1] == cast(u8, 45)) {
            if (a[2] == cast(u8, 0)) { done = 1; continue; }
            // --long[=value]
            let is *u8 as lv with mut = cast(*u8, 0);
            let is i64 as eq with mut = 2;
            while (a[eq] != 0 && a[eq] != cast(u8, 61)) { eq = eq + 1; }
            if (a[eq] == cast(u8, 61)) { lv = cast(*u8, cast(i64, a) + eq + 1); }
            let is [64]u8 as nm; let is i64 as q with mut = 0;
            while (q < eq && q < 63) { nm[q] = a[q]; q = q + 1; }
            nm[q] = cast(u8, 0);
            let is *u8 as name = cast(*u8, &nm[0]);
            if (streq(name, "--quiet") == 1 || streq(name, "--silent") == 1) { G_N = 1; }
            else if (streq(name, "--expression") == 1 || streq(name, "--file") == 1) {
                if (lv == cast(*u8, 0)) {
                    if (i >= argc) { prog.errs("sed: option '"); prog.errs(name); prog.errs("' requires an argument\n"); usage(2); return cast(i32, 1); }
                    lv = prog.arg(argv, i); i = i + 1;
                }
                if (streq(name, "--expression") == 1) { add_expr(lv); } else { add_file(lv); }
                nscripts = nscripts + 1;
            }
            else if (streq(name, "--regexp-extended") == 1) { G_EXT = 1; }
            else if (streq(name, "--in-place") == 1) { G_INPLACE = 1; G_SEP = 1; if (lv != cast(*u8, 0) && lv[0] != 0) { G_SUFFIX = cast(i64, lv); } }
            else if (streq(name, "--separate") == 1) { G_SEP = 1; }
            else if (streq(name, "--null-data") == 1 || streq(name, "--zero-terminated") == 1) { SEPC = 0; }
            else if (streq(name, "--line-length") == 1) {
                if (lv == cast(*u8, 0) && i < argc) { lv = prog.arg(argv, i); i = i + 1; }
                set_lwidth(lv);
            }
            else if (streq(name, "--unbuffered") == 1) { }
            else if (streq(name, "--help") == 1) { usage(1); return cast(i32, 0); }
            else if (streq(name, "--version") == 1) { prog.outs("sed (CausticOS)\n"); return cast(i32, 0); }
            else { prog.errs("sed: unrecognized option '"); prog.errs(a); prog.errs("'\n"); usage(2); return cast(i32, 1); }
            continue;
        }
        let is i64 as j with mut = 1;
        while (a[j] != 0) {
            let is i64 as f = cast(i64, a[j]);
            j = j + 1;
            if (f == 110) { G_N = 1; }
            else if (f == 69 || f == 114) { G_EXT = 1; }
            else if (f == 115) { G_SEP = 1; }
            else if (f == 122) { SEPC = 0; }
            else if (f == 117) { }
            else if (f == 105) {                                      // -i[SUFFIX]: the rest of this argument
                G_INPLACE = 1; G_SEP = 1;
                if (a[j] != 0) { G_SUFFIX = cast(i64, a) + j; }
                j = slen(a);
            }
            else if (f == 101 || f == 102 || f == 108) {              // -e S, -f F, -l N
                let is *u8 as v with mut = cast(*u8, 0);
                if (a[j] != 0) { v = cast(*u8, cast(i64, a) + j); j = slen(a); }
                else if (i < argc) { v = prog.arg(argv, i); i = i + 1; }
                else {
                    let is [48]u8 as em;
                    let is *u8 as t = "option requires an argument -- 'x'";
                    let is i64 as q with mut = 0;
                    while (t[q] != 0) { em[q] = t[q]; q = q + 1; }
                    em[q - 2] = cast(u8, f); em[q] = cast(u8, 0);
                    bad_option(cast(*u8, &em[0]));
                }
                if (f == 101) { add_expr(v); nscripts = nscripts + 1; }
                else if (f == 102) { add_file(v); nscripts = nscripts + 1; }
                else { set_lwidth(v); }
            }
            else {
                let is [40]u8 as em;
                let is *u8 as t = "invalid option -- 'x'";
                let is i64 as q with mut = 0;
                while (t[q] != 0) { em[q] = t[q]; q = q + 1; }
                em[q - 2] = cast(u8, f); em[q] = cast(u8, 0);
                bad_option(cast(*u8, &em[0]));
            }
        }
    }
    let is i64 as first with mut = 0;
    if (nscripts == 0) {
        if (oper.n == 0) { usage(2); return cast(i32, 1); }
        NEXPR = 1;
        let is *u8 as sc = cast(*u8, ai(&oper, 0));
        add_chunk(sc, slen(sc), 0, 1, cast(*u8, 0));
        first = 1;
    }
    while (first < oper.n) { ai_push(&FILES, ai(&oper, first)); first = first + 1; }
    if (FILES.n == 0) {
        if (G_INPLACE == 1) { prog.errs("sed: no input files\n"); return cast(i32, 1); }
        ai_push(&FILES, cast(i64, "-"));
    }
    compile_script();

    if (G_INPLACE == 1) {
        let is i64 as tmp_out = arr_add(&OUTS, sizeof(Out));
        let is i64 as k with mut = 0;
        while (k < FILES.n && QUIT == 0) { in_place(cast(*u8, ai(&FILES, k)), tmp_out); k = k + 1; }
    } else if (G_SEP == 1) {
        let is i64 as k with mut = 0;
        while (k < FILES.n && QUIT == 0) {
            if (open_file(cast(*u8, ai(&FILES, k))) == 1) { LINENO = 0; run(); close_input(); }
            k = k + 1;
        }
    } else {
        FI = 0;
        open_next();
        run();
        close_input();
    }
    flush_all();
    let is i64 as k2 with mut = 2;
    while (k2 < OUTS.n) { if (outp(k2).fd > 2) { sys.close(outp(k2).fd); } k2 = k2 + 1; }
    if (QCODE != 0) { return cast(i32, QCODE); }
    if (BADFILES == 1) { return cast(i32, 2); }
    return cast(i32, 0);
}
