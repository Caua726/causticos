// cmp — compare two files byte by byte.
//   cmp [-s] [-l] [-b] [-i SKIP] [-n LIMIT] file1 file2
// -s silent (status only); -l list every differing byte (offset + two octal
// values); -b also show the bytes; -i SKIP skip SKIP bytes of each (or N:M);
// -n LIMIT compare at most LIMIT bytes. Exit 0 same, 1 differ, 2 error.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;

fn digits(v as i64) as i64 { let is i64 as n with mut = 1; let is i64 as x with mut = v; while (x >= 10) { x = x / 10; n = n + 1; } return n; }
// right-justify an octal value to width w.
fn print_octal_w(v as i64, w as i64) as void {
    let is [24]u8 as b; let is i64 as n with mut = 0; let is i64 as t with mut = v;
    if (v == 0) { b[0] = cast(u8, 48); n = 1; } else { while (t > 0) { b[n] = cast(u8, 48 + (t & 7)); n = n + 1; t = t / 8; } }
    let is i64 as pad with mut = w - n; while (pad > 0) { prog.outs(" "); pad = pad - 1; }
    while (n > 0) { n = n - 1; prog.out(cast(*u8, &b[n]), 1); }
}
// the cmp -b character notation (^X, M-x, ^?), like cat -v; returns chars written.
fn print_char(c as i64) as i64 {
    if (c >= 32 && c < 127) { let is [1]u8 as o; o[0] = cast(u8, c); prog.out(cast(*u8, &o[0]), 1); return 1; }
    if (c == 127) { prog.outs("^?"); return 2; }
    if (c >= 128) {
        prog.outs("M-"); let is i64 as d = c - 128;
        if (d == 127) { prog.outs("^?"); return 4; }
        if (d < 32) { let is [2]u8 as o; o[0] = cast(u8, 94); o[1] = cast(u8, d + 64); prog.out(cast(*u8, &o[0]), 2); return 4; }
        let is [1]u8 as o; o[0] = cast(u8, d); prog.out(cast(*u8, &o[0]), 1); return 3;
    }
    let is [2]u8 as o; o[0] = cast(u8, 94); o[1] = cast(u8, c + 64); prog.out(cast(*u8, &o[0]), 2); return 2;
}
// print the char repr left-justified in width 4 (for cmp -lb).
fn print_char4(c as i64) as void { let is i64 as w = print_char(c); let is i64 as pad with mut = 4 - w; while (pad > 0) { prog.outs(" "); pad = pad - 1; } }
fn file_size(path as *u8) as i64 { let is [4]i64 as st; if (sys.stat(path, cast(*u8, &st[0])) != 0) { return 0; } return st[0]; }

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as sflag with mut = 0; let is i64 as lflag with mut = 0; let is i64 as bflag with mut = 0;
    let is i64 as skipA with mut = 0; let is i64 as skipB with mut = 0; let is i64 as limit with mut = 0 - 1;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "slbi:n:");
        if (f < 0) { break; }
        if (f == 115) { sflag = 1; } else if (f == 108) { lflag = 1; } else if (f == 98) { bflag = 1; }
        else if (f == 105) {                                       // -i SKIP or SKIP:SKIP
            let is *u8 as v = cast(*u8, o.optarg); let is i64 as cl = prog.slen(v);
            let is i64 as colon with mut = 0 - 1; let is i64 as k with mut = 0;
            while (k < cl) { if (cast(i64, v[k]) == 58) { colon = k; break; } k = k + 1; }
            if (colon >= 0) { skipA = fu.parse_uint(v, colon); skipB = fu.parse_uint(cast(*u8, cast(i64, v) + colon + 1), cl - colon - 1); }
            else { skipA = fu.parse_uint(v, cl); skipB = skipA; }
        }
        else if (f == 110) { limit = fu.parse_uint(cast(*u8, o.optarg), 19); }
        else { prog.outs("usage: cmp [-slb] [-i SKIP] [-n LIMIT] file1 file2\n"); return cast(i32, 2); }
    }
    if (argc - o.ind < 2) { prog.outs("usage: cmp [-slb] [-i SKIP] [-n LIMIT] file1 file2\n"); return cast(i32, 2); }
    let is *u8 as na = prog.arg(argv, o.ind); let is *u8 as nb = prog.arg(argv, o.ind + 1);
    let is [256]u8 as pa; let is [256]u8 as pbf;
    let is *u8 as pathA = prog.abspath(na, cast(*u8, &pa[0])); let is *u8 as pathB = prog.abspath(nb, cast(*u8, &pbf[0]));
    let is [4096]u8 as bufa; let is [4096]u8 as bufb;
    let is fu.Reader as ra; let is fu.Reader as rb;
    if (fu.rd_open(&ra, pathA, cast(*u8, &bufa[0]), 4096) < 0) { if (sflag == 0) { prog.outs("cmp: "); prog.outs(na); prog.outs(": cannot open\n"); } return cast(i32, 2); }
    if (fu.rd_open(&rb, pathB, cast(*u8, &bufb[0]), 4096) < 0) { if (sflag == 0) { prog.outs("cmp: "); prog.outs(nb); prog.outs(": cannot open\n"); } fu.rd_close(&ra); return cast(i32, 2); }
    let is i64 as s with mut = 0; while (s < skipA) { if (fu.rd_byte(&ra) < 0) { break; } s = s + 1; }
    s = 0; while (s < skipB) { if (fu.rd_byte(&rb) < 0) { break; } s = s + 1; }

    // -l aligns the offset to the digit width of the smaller file's size.
    let is i64 as szA = file_size(pathA); let is i64 as szB = file_size(pathB);
    let is i64 as msz with mut = szA; if (szB < msz) { msz = szB; }
    let is i64 as owidth = digits(msz);

    let is i64 as pos with mut = 0; let is i64 as line with mut = 1; let is i32 as rc with mut = 0;
    while (limit < 0 || pos < limit) {
        let is i64 as ca = fu.rd_byte(&ra); let is i64 as cb = fu.rd_byte(&rb);
        if (ca < 0 && cb < 0) { break; }
        pos = pos + 1;
        if (ca < 0) { if (sflag == 0) { prog.outs("cmp: EOF on "); prog.outs(na); prog.out("\n", 1); } rc = cast(i32, 1); break; }
        if (cb < 0) { if (sflag == 0) { prog.outs("cmp: EOF on "); prog.outs(nb); prog.out("\n", 1); } rc = cast(i32, 1); break; }
        if (ca != cb) {
            rc = cast(i32, 1);
            if (lflag == 1) {
                prog.pad_num(pos, owidth); prog.outs(" "); print_octal_w(ca, 3);
                if (bflag != 0) { prog.outs(" "); print_char4(ca); } prog.outs(" "); print_octal_w(cb, 3);
                if (bflag != 0) { prog.outs(" "); print_char(cb); }       // last char: no padding
                prog.out("\n", 1);
            } else {
                if (sflag == 0) {
                    prog.outs(na); prog.outs(" "); prog.outs(nb);
                    if (bflag != 0) { prog.outs(" differ: byte "); } else { prog.outs(" differ: char "); }
                    prog.out_num(pos); prog.outs(", line "); prog.out_num(line);
                    if (bflag != 0) { prog.outs(" is "); print_octal_w(ca, 0); prog.outs(" "); print_char(ca); prog.outs(" "); print_octal_w(cb, 0); prog.outs(" "); print_char(cb); }
                    prog.out("\n", 1);
                }
                break;
            }
        }
        if (ca == 0x0A) { line = line + 1; }
    }
    fu.rd_close(&ra); fu.rd_close(&rb);
    return rc;
}
