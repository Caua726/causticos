// dirname — strip the last component from a path.
//   dirname PATH
// Prints everything up to (but not including) the final '/'. A path with no
// slash gives ".", and "/" stays "/".
use "std/causticos/prog.cst" as prog;

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 2) { prog.outs("usage: dirname PATH\n"); return cast(i32, 1); }
    let is *u8 as path = prog.arg(argv, 1);
    let is i64 as len with mut = prog.slen(path);
    while (len > 1 && cast(i64, path[len - 1]) == 47) { len = len - 1; }     // strip trailing '/'
    let is i64 as slash with mut = 0 - 1; let is i64 as i with mut = 0;
    while (i < len) { if (cast(i64, path[i]) == 47) { slash = i; } i = i + 1; }
    if (slash < 0) { prog.outs(".\n"); return 0; }
    while (slash > 0 && cast(i64, path[slash - 1]) == 47) { slash = slash - 1; }   // collapse repeated '/'
    if (slash == 0) { prog.outs("/\n"); return 0; }
    prog.out(path, slash); prog.out("\n", 1);
    return 0;
}
