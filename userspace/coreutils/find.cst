// find — walk directory trees, printing paths that pass the tests.
//   find [path ...] [-name PAT] [-type f|d]
// -name = substring match on the entry name, -type f (file) / d (directory).
// Default path is /. (Tests combine with AND, like find's defaults.)
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;

let is i64 as g_namep with mut = 0;   // *u8 (held as address); 0 = no -name
let is i64 as g_nlen with mut = 0;
let is i64 as g_type with mut = 0;    // 0 any, 1 file, 2 dir

fn streq(a as *u8, b as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (cast(i64, a[i]) != 0 && cast(i64, b[i]) != 0) { if (a[i] != b[i]) { return 0; } i = i + 1; }
    if (cast(i64, a[i]) == 0 && cast(i64, b[i]) == 0) { return 1; }
    return 0;
}

fn matches(name as *u8, nl as i64, isdir as i64) as i64 {
    if (g_nlen > 0) { if (fu.mem_find(name, nl, cast(*u8, g_namep), g_nlen) < 0) { return 0; } }
    if (g_type == 1 && isdir != 0) { return 0; }
    if (g_type == 2 && isdir == 0) { return 0; }
    return 1;
}

fn find_walk(path as *u8, plen as i64) as void {
    let is [8192]u8 as names;
    let is [256]i64 as off; let is [256]i64 as nl; let is [256]i64 as isd;
    let is i64 as cnt = fu.read_dir(path, cast(*u8, &names[0]), 8192, cast(*i64, &off[0]), cast(*i64, &nl[0]), cast(*i64, &isd[0]), 256);
    let is i64 as k with mut = 0;
    while (k < cnt) {
        let is *u8 as nm = cast(*u8, cast(i64, &names[0]) + off[k]);
        let is [512]u8 as child;
        let is i64 as clen = fu.path_join(cast(*u8, &child[0]), path, plen, nm, nl[k]);
        if (matches(nm, nl[k], isd[k]) == 1) { prog.out(cast(*u8, &child[0]), clen); prog.out("\n", 1); }
        if (isd[k] != 0) { find_walk(cast(*u8, &child[0]), clen); }
        k = k + 1;
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    // paths come first, up to the first argument beginning with '-'.
    let is i64 as i with mut = 1;
    while (i < argc) { let is *u8 as a = prog.arg(argv, i); if (cast(i64, a[0]) == 45) { break; } i = i + 1; }
    let is i64 as pathend = i;
    while (i < argc) {
        let is *u8 as a = prog.arg(argv, i);
        if (streq(a, "-name") == 1) { i = i + 1; if (i < argc) { let is *u8 as v = prog.arg(argv, i); g_namep = cast(i64, v); g_nlen = prog.slen(v); i = i + 1; } }
        else if (streq(a, "-type") == 1) { i = i + 1; if (i < argc) { let is *u8 as v = prog.arg(argv, i); if (cast(i64, v[0]) == 102) { g_type = 1; } else if (cast(i64, v[0]) == 100) { g_type = 2; } i = i + 1; } }
        else { i = i + 1; }
    }
    if (pathend <= 1) { find_walk("/", 1); return 0; }
    let is i64 as k with mut = 1;
    while (k < pathend) {
        let is [256]u8 as pb;
        let is *u8 as path = prog.abspath(prog.arg(argv, k), cast(*u8, &pb[0]));
        find_walk(path, prog.slen(path));
        k = k + 1;
    }
    return 0;
}
