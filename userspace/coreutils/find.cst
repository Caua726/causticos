// find — walk directory trees and act on the names that pass an expression.
//
//   find [PATH...] [EXPRESSION]
//
// PATHs come first, up to the first word that starts with '-', '(' or '!'; with
// none the walk starts at ".". Each is printed as it was given, then everything
// under it — a directory before what is in it, or after it with -depth. (A
// relative PATH is resolved the way every program here resolves one: against
// /, since a program is not told the shell's directory.)
//
// The expression is GNU find's:
//   ( EXPR )   ! EXPR   -not EXPR   EXPR [-a|-and] EXPR   EXPR -o|-or EXPR
// Options, anywhere, for the whole walk:
//   -maxdepth N   -mindepth N   -depth
// Tests:
//   -name PATTERN  -iname PATTERN   the last component, a shell pattern
//   -path PATTERN  -ipath PATTERN   the path as printed ('*' takes '/' too)
//   -type T          f (file) or d (directory); several as f,d
//   -size [+|-]N[c|w|b|k|M|G]   the size in those units, rounded up (b = 512
//                    bytes, the default); +N more than N, -N fewer
//   -empty           an empty file, or a directory with nothing in it
//   -newer FILE      modified after FILE was
//   -mtime [+|-]N    modified N whole days ago; -mmin [+|-]N in minutes
//   -true  -false
// Actions — with none in the expression, -print is done for what passes:
//   -print  -print0  -prune  -quit  -delete
//   -exec COMMAND ... ;      run it for each, every {} the path; true if it
//                            exits 0
//   -exec COMMAND ... {} +   run it with as many paths at once as fit
//   -ok COMMAND ... ;        as -exec ..., ;, but asks first
//
// Exit status 1 when a path could not be read or an action failed, 0 else.
//
// This replaces a find whose -name was a substring search (so "*.txt" looked
// for a literal star), which did not print the PATH it started from, and which
// stopped at 256 names a directory.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;
use "../lib/glob/glob.cst" as glob;
use "../lib/crash/crash.cst" as crash;

// ---- the expression ----------------------------------------------------------

let is i64 as K_AND     with imut = 1;
let is i64 as K_OR      with imut = 2;
let is i64 as K_NOT     with imut = 3;
let is i64 as K_TRUE    with imut = 4;
let is i64 as K_FALSE   with imut = 5;
let is i64 as K_NAME    with imut = 6;    // nv = glob flags
let is i64 as K_PATH    with imut = 7;    // nv = glob flags
let is i64 as K_TYPE    with imut = 8;    // nv = mask: 1 file, 2 directory
let is i64 as K_SIZE    with imut = 9;    // nv = N, nw = sign, nu = unit
let is i64 as K_EMPTY   with imut = 10;
let is i64 as K_NEWER   with imut = 11;   // nv = the other file's mtime
let is i64 as K_AGE     with imut = 12;   // nv = N, nw = sign, nu = seconds a unit
let is i64 as K_PRINT   with imut = 13;
let is i64 as K_PRINT0  with imut = 14;
let is i64 as K_PRUNE   with imut = 15;
let is i64 as K_QUIT    with imut = 16;
let is i64 as K_DELETE  with imut = 17;
let is i64 as K_EXEC    with imut = 18;   // na = first word, nb = how many
let is i64 as K_EXECALL with imut = 19;   // the same, {} + form; nv = its batch
let is i64 as K_OK      with imut = 20;

// What an argument costs a command -exec starts: its bytes, plus its NUL and
// its pointer on the child's stack. Spawn takes sys.ARGV_MAX of that.
fn arg_cost(len as i64) as i64 { return len + 9; }

// The expression's nodes. A word makes at most one node, and so does each
// implied -a between two of them, plus the -print an expression without an
// action gets: main sizes these from argc.
let is i64 as MAXN with mut = 0;
let is *i64 as nk with mut = cast(*i64, 0);
let is *i64 as na with mut = cast(*i64, 0);
let is *i64 as nb with mut = cast(*i64, 0);
let is *i64 as nv with mut = cast(*i64, 0);
let is *i64 as nw with mut = cast(*i64, 0);
let is *i64 as nu with mut = cast(*i64, 0);
let is *i64 as np with mut = cast(*i64, 0);   // a pattern: its word
let is i64 as nn with mut = 0;

let is i64 as g_argv with mut = 0;
let is i64 as g_argc with mut = 0;
let is i64 as g_pos with mut = 0;         // the parser's next word

let is i64 as g_maxdepth with mut = 0x7FFFFFFF;
let is i64 as g_mindepth with mut = 0;
let is i64 as g_post with mut = 0;        // -depth: a directory after its contents
let is i64 as g_action with mut = 0;      // the expression has an action of its own
let is i64 as g_quit with mut = 0;
let is i64 as g_status with mut = 0;
let is i64 as g_now with mut = 0;

fn word(i as i64) as *u8 { return prog.arg(cast(*u8, g_argv), i); }

fn streq(a as *u8, b as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (a[i] != 0 && b[i] != 0) { if (a[i] != b[i]) { return 0; } i = i + 1; }
    if (a[i] == 0 && b[i] == 0) { return 1; }
    return 0;
}

fn die(a as *u8, b as *u8, c as *u8) as void {
    flush();
    prog.errs("find: "); prog.errs(a); prog.errs(b); prog.errs(c); prog.errs("\n");
    sys.exit(cast(i32, 1));
}

fn node(k as i64) as i64 {
    if (nn >= MAXN) { die("the expression is too long", "", ""); }
    nk[nn] = k; na[nn] = 0; nb[nn] = 0; nv[nn] = 0; nw[nn] = 0; nu[nn] = 0; np[nn] = 0;
    nn = nn + 1;
    return nn - 1;
}

fn bin(k as i64, l as i64, r as i64) as i64 {
    let is i64 as n = node(k);
    na[n] = l; nb[n] = r;
    return n;
}

// The word after an option that needs one.
fn operand(opt as *u8) as *u8 {
    if (g_pos >= g_argc) { die("missing argument to '", opt, "'"); }
    let is *u8 as w = word(g_pos);
    g_pos = g_pos + 1;
    return w;
}

// [+|-]N, with an optional unit letter when units is 1: returns N, sets sign
// (1 more, -1 less, 0 exactly) and the unit's letter (0 if none).
fn number(opt as *u8, w as *u8, sign as *i64, unit as *i64, units as i64) as i64 {
    let is i64 as i with mut = 0;
    sign[0] = 0; unit[0] = 0;
    if (w[0] == cast(u8, 43)) { sign[0] = 1; i = 1; }
    else if (w[0] == cast(u8, 45)) { sign[0] = 0 - 1; i = 1; }
    let is i64 as v with mut = 0;
    let is i64 as digits with mut = 0;
    while (w[i] >= cast(u8, 48) && w[i] <= cast(u8, 57)) {
        v = v * 10 + (cast(i64, w[i]) - 48);
        i = i + 1; digits = digits + 1;
    }
    if (units == 1 && w[i] != 0 && w[i + 1] == 0) { unit[0] = cast(i64, w[i]); i = i + 1; }
    if (digits == 0 || w[i] != 0) { die("invalid argument '", w, "' to that option"); }
    return v;
}

fn _ends(w as *u8, lit as *u8) as i64 {
    if (streq(w, lit) == 1) { return 1; }
    return 0;
}

// -exec / -ok: the words up to ';' (or "{} +"), and checks on them.
fn exec_words(k as i64, opt as *u8) as i64 {
    let is i64 as start = g_pos;
    while (g_pos < g_argc) {
        let is *u8 as w = word(g_pos);
        if (streq(w, ";") == 1) {
            if (g_pos == start) { die("missing command for '", opt, "'"); }
            let is i64 as n = node(k);
            na[n] = start; nb[n] = g_pos - start;
            g_pos = g_pos + 1;
            return n;
        }
        if (streq(w, "+") == 1 && k == K_EXEC && g_pos > start && streq(word(g_pos - 1), "{}") == 1) {
            if (g_pos - 1 == start) { die("missing command for '", opt, "'"); }
            let is i64 as n = node(K_EXECALL);
            na[n] = start; nb[n] = g_pos - 1 - start;        // the command, without the {}
            nv[n] = batch_new(n);
            g_pos = g_pos + 1;
            return n;
        }
        g_pos = g_pos + 1;
    }
    die("missing ';' after '", opt, "' (or {} + at the end)");
    return 0 - 1;
}

fn primary() as i64 {
    if (g_pos >= g_argc) { die("an expression ends where it needs more", "", ""); }
    let is *u8 as w = word(g_pos);
    g_pos = g_pos + 1;
    if (streq(w, "(") == 1) {
        let is i64 as e = parse_or();
        if (g_pos >= g_argc || streq(word(g_pos), ")") == 0) { die("missing ')'", "", ""); }
        g_pos = g_pos + 1;
        return e;
    }
    if (streq(w, ")") == 1) { die("')' with no '(' before it", "", ""); }
    if (streq(w, "-name") == 1 || streq(w, "-iname") == 1) {
        let is i64 as n = node(K_NAME);
        np[n] = cast(i64, operand(w));
        if (w[1] == cast(u8, 105)) { nv[n] = glob.FL_CASEFOLD; }
        return n;
    }
    if (streq(w, "-path") == 1 || streq(w, "-ipath") == 1 || streq(w, "-wholename") == 1 || streq(w, "-iwholename") == 1) {
        let is i64 as n = node(K_PATH);
        np[n] = cast(i64, operand(w));
        if (w[1] == cast(u8, 105)) { nv[n] = glob.FL_CASEFOLD; }
        return n;
    }
    if (streq(w, "-type") == 1) {
        let is *u8 as t = operand(w);
        let is i64 as n = node(K_TYPE);
        let is i64 as i with mut = 0;
        while (t[i] != 0) {
            let is i64 as c = cast(i64, t[i]);
            if (c == 102) { nv[n] = nv[n] | 1; }                       // f
            else if (c == 100) { nv[n] = nv[n] | 2; }                  // d
            else if (c == 108 || c == 98 || c == 99 || c == 112 || c == 115 || c == 68) { }  // l b c p s D: none here
            else { die("unknown type '", t, "' for -type (f or d)"); }
            i = i + 1;
            if (t[i] == cast(u8, 44)) { i = i + 1; }                   // f,d
            else if (t[i] != 0) { die("unknown type '", t, "' for -type (f or d)"); }
        }
        return n;
    }
    if (streq(w, "-size") == 1) {
        let is *u8 as v = operand(w);
        let is [1]i64 as sg; let is [1]i64 as un;
        let is i64 as n = node(K_SIZE);
        nv[n] = number(w, v, cast(*i64, &sg[0]), cast(*i64, &un[0]), 1);
        nw[n] = sg[0];
        let is i64 as u = un[0];
        if (u == 0 || u == 98) { nu[n] = 512; }
        else if (u == 99) { nu[n] = 1; }
        else if (u == 119) { nu[n] = 2; }
        else if (u == 107) { nu[n] = 1024; }
        else if (u == 77) { nu[n] = 1048576; }
        else if (u == 71) { nu[n] = 1073741824; }
        else { die("invalid unit in '", v, "' for -size (c w b k M G)"); }
        return n;
    }
    if (streq(w, "-empty") == 1) { return node(K_EMPTY); }
    if (streq(w, "-newer") == 1) {
        let is *u8 as f = operand(w);
        let is [256]u8 as fb;
        let is *u8 as fp = prog.abspath(f, cast(*u8, &fb[0]));
        let is [5]i64 as sx;
        if (sys.statx(fp, cast(*u8, &sx[0])) != 0) { die("'", f, "': no such file, for -newer"); }
        let is i64 as n = node(K_NEWER);
        nv[n] = sx[4];
        return n;
    }
    if (streq(w, "-mtime") == 1 || streq(w, "-mmin") == 1) {
        let is *u8 as v = operand(w);
        let is [1]i64 as sg; let is [1]i64 as un;
        let is i64 as n = node(K_AGE);
        nv[n] = number(w, v, cast(*i64, &sg[0]), cast(*i64, &un[0]), 0);
        nw[n] = sg[0];
        if (w[2] == cast(u8, 109) && w[3] == cast(u8, 105)) { nu[n] = 60; } else { nu[n] = 86400; }   // -mmin
        if (g_now == 0) { g_now = fu.epoch_now(); }
        return n;
    }
    if (streq(w, "-maxdepth") == 1 || streq(w, "-mindepth") == 1) {
        let is *u8 as v = operand(w);
        let is [1]i64 as sg; let is [1]i64 as un;
        let is i64 as d = number(w, v, cast(*i64, &sg[0]), cast(*i64, &un[0]), 0);
        if (sg[0] != 0) { die("'", v, "' is not a depth"); }
        if (w[2] == cast(u8, 97)) { g_maxdepth = d; } else { g_mindepth = d; }
        return node(K_TRUE);
    }
    if (streq(w, "-depth") == 1 || streq(w, "-d") == 1) { g_post = 1; return node(K_TRUE); }
    if (streq(w, "-true") == 1) { return node(K_TRUE); }
    if (streq(w, "-false") == 1) { return node(K_FALSE); }
    if (streq(w, "-print") == 1) { g_action = 1; return node(K_PRINT); }
    if (streq(w, "-print0") == 1) { g_action = 1; return node(K_PRINT0); }
    if (streq(w, "-prune") == 1) { return node(K_PRUNE); }
    if (streq(w, "-quit") == 1) { g_action = 1; return node(K_QUIT); }
    if (streq(w, "-delete") == 1) { g_action = 1; g_post = 1; return node(K_DELETE); }
    if (streq(w, "-exec") == 1) { g_action = 1; return exec_words(K_EXEC, w); }
    if (streq(w, "-ok") == 1) { g_action = 1; return exec_words(K_OK, w); }
    if (w[0] == cast(u8, 45)) { die("unknown predicate '", w, "'"); }
    die("paths must come before the expression: '", w, "'");
    return 0 - 1;
}

fn parse_not() as i64 {
    if (g_pos < g_argc && (streq(word(g_pos), "!") == 1 || streq(word(g_pos), "-not") == 1)) {
        g_pos = g_pos + 1;
        return bin(K_NOT, parse_not(), 0);
    }
    return primary();
}

fn parse_and() as i64 {
    let is i64 as l with mut = parse_not();
    while (g_pos < g_argc) {
        let is *u8 as w = word(g_pos);
        if (streq(w, "-o") == 1 || streq(w, "-or") == 1 || streq(w, ")") == 1) { return l; }
        if (streq(w, "-a") == 1 || streq(w, "-and") == 1) { g_pos = g_pos + 1; }
        l = bin(K_AND, l, parse_not());
    }
    return l;
}

fn parse_or() as i64 {
    let is i64 as l with mut = parse_and();
    while (g_pos < g_argc && (streq(word(g_pos), "-o") == 1 || streq(word(g_pos), "-or") == 1)) {
        g_pos = g_pos + 1;
        l = bin(K_OR, l, parse_and());
    }
    return l;
}

// ---- output ------------------------------------------------------------------

let is [8192]u8 as obuf with mut;
let is i64 as ofill with mut = 0;

fn flush() as void {
    if (ofill > 0) { prog.out(cast(*u8, &obuf[0]), ofill); ofill = 0; }
    return;
}

fn put(p as *u8, n as i64) as void {
    if (ofill + n > 8192) { flush(); }
    if (n > 8192) { prog.out(p, n); return; }
    let is i64 as i with mut = 0;
    while (i < n) { obuf[ofill + i] = p[i]; i = i + 1; }
    ofill = ofill + n;
    return;
}

// ---- the entry being looked at -----------------------------------------------

let is [4096]u8 as sbuf with mut;         // its path as printed
let is i64 as slen with mut = 0;
let is [4096]u8 as abuf with mut;         // and as the filesystem knows it
let is i64 as alen with mut = 0;
let is i64 as e_name with mut = 0;        // *u8, its last component
let is i64 as e_nlen with mut = 0;
let is i64 as e_dir with mut = 0;
let is i64 as e_size with mut = 0;
let is i64 as e_mtime with mut = 0 - 1;   // -1 = not asked yet
let is i64 as e_prune with mut = 0;
let is i64 as e_start with mut = 0;       // 1 = a PATH from the command line

fn mtime() as i64 {
    if (e_mtime < 0) { e_mtime = fu.statx_mtime(cast(*u8, &abuf[0])); }
    return e_mtime;
}

// Nothing in a directory but "." and "..".
fn dir_empty() as i64 {
    let is i64 as fd = sys.open_read(cast(*u8, &abuf[0]));
    if (fd < 0) { return 0; }
    let is [320]u8 as de;
    let is i64 as empty with mut = 1;
    while (empty == 1 && sys.readdir(fd, cast(*u8, &de[0])) == 0) {
        if (fu.is_dot(cast(*u8, &de[0]), fu.de_name_len(cast(*u8, &de[0]))) == 0) { empty = 0; }
    }
    sys.close(fd);
    return empty;
}

fn cmp(have as i64, want as i64, sign as i64) as i64 {
    if (sign > 0) { if (have > want) { return 1; } return 0; }
    if (sign < 0) { if (have < want) { return 1; } return 0; }
    if (have == want) { return 1; }
    return 0;
}

fn eval(n as i64) as i64 {
    let is i64 as k = nk[n];
    // After -quit nothing more of the expression runs: `-quit -print` prints
    // nothing, `-print -quit` the one name.
    if (k == K_AND) {
        if (eval(na[n]) == 0) { return 0; }
        if (g_quit == 1) { return 1; }
        return eval(nb[n]);
    }
    if (k == K_OR) {
        if (eval(na[n]) == 1) { return 1; }
        if (g_quit == 1) { return 0; }
        return eval(nb[n]);
    }
    if (k == K_NOT) { return 1 - eval(na[n]); }
    if (k == K_TRUE) { return 1; }
    if (k == K_FALSE) { return 0; }
    if (k == K_NAME) {
        let is *u8 as pat = cast(*u8, np[n]);
        return glob.fnmatch(pat, prog.slen(pat), cast(*u8, e_name), e_nlen, nv[n]);
    }
    if (k == K_PATH) {
        let is *u8 as pat = cast(*u8, np[n]);
        return glob.fnmatch(pat, prog.slen(pat), cast(*u8, &sbuf[0]), slen, nv[n]);
    }
    if (k == K_TYPE) {
        if (e_dir != 0) { if ((nv[n] & 2) != 0) { return 1; } return 0; }
        if ((nv[n] & 1) != 0) { return 1; }
        return 0;
    }
    if (k == K_SIZE) {
        let is i64 as u = nu[n];
        let is i64 as units with mut = e_size;
        if (u > 1) { units = (e_size + u - 1) / u; }
        return cmp(units, nv[n], nw[n]);
    }
    if (k == K_EMPTY) {
        if (e_dir != 0) { return dir_empty(); }
        if (e_size == 0) { return 1; }
        return 0;
    }
    if (k == K_NEWER) {
        let is i64 as t = mtime();
        if (t <= 0 || nv[n] <= 0) { return 0; }   // no stamp: not after anything
        if (t > nv[n]) { return 1; }
        return 0;
    }
    if (k == K_AGE) {
        let is i64 as t = mtime();
        if (t <= 0 || g_now <= 0) { return 0; }   // no stamp, or no clock: no age
        let is i64 as age with mut = g_now - t;
        if (age < 0) { age = 0; }
        return cmp(age / nu[n], nv[n], nw[n]);
    }
    if (k == K_PRINT) {
        put(cast(*u8, &sbuf[0]), slen); put("\n", 1);
        return 1;
    }
    if (k == K_PRINT0) {
        put(cast(*u8, &sbuf[0]), slen);
        let is [1]u8 as z; z[0] = cast(u8, 0);
        put(cast(*u8, &z[0]), 1);
        return 1;
    }
    if (k == K_PRUNE) { e_prune = 1; return 1; }
    if (k == K_QUIT) { g_quit = 1; return 1; }
    if (k == K_DELETE) { return remove(); }
    if (k == K_EXEC) { return run_each(n, 0); }
    if (k == K_OK) { return run_each(n, 1); }
    if (k == K_EXECALL) { batch_add(n); return 1; }
    return 0;
}

// -delete. The directory itself after what was in it (-delete implies -depth),
// and never "." or "/": GNU find does not remove the place it started from.
fn remove() as i64 {
    if (e_start == 1 && (streq(cast(*u8, &sbuf[0]), ".") == 1 || streq(cast(*u8, &abuf[0]), "/") == 1)) { return 1; }
    let is i32 as rc with mut = cast(i32, 0);
    if (e_dir != 0) { rc = sys.rmdir(cast(*u8, &abuf[0])); } else { rc = sys.unlink(cast(*u8, &abuf[0])); }
    if (cast(i64, rc) == 0) { return 1; }
    flush();
    prog.errs("find: cannot delete '"); prog.err(cast(*u8, &sbuf[0]), slen);
    prog.errs("': "); prog.errs(sys.err_text(cast(i64, rc))); prog.errs("\n");
    g_status = 1;
    return 0;
}

// ---- running commands ----------------------------------------------------------

// Where a command word's program is: a bare name where programs live
// ("/name.cse"), a word with a '/' as the path it is, with ".cse" tried after
// it — the shell's rule, so -exec runs what typing the name would.
fn prog_path(cmd as *u8, out as *u8) as i64 {
    let is i64 as n = prog.slen(cmd);
    let is i64 as slash with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) { if (cmd[i] == cast(u8, 47)) { slash = 1; } i = i + 1; }
    let is [4]i64 as st;
    if (slash == 0) {
        if (n > 240) { return 0; }
        out[0] = cast(u8, 47);
        i = 0;
        while (i < n) { out[1 + i] = cmd[i]; i = i + 1; }
        out[1 + n] = cast(u8, 46); out[2 + n] = cast(u8, 99); out[3 + n] = cast(u8, 115); out[4 + n] = cast(u8, 101);
        out[5 + n] = cast(u8, 0);
        if (sys.stat(out, cast(*u8, &st[0])) == 0) { return 1; }
        return 0;
    }
    let is [256]u8 as tmp;
    let is *u8 as p = prog.abspath(cmd, cast(*u8, &tmp[0]));
    let is i64 as pl = prog.slen(p);
    if (pl > 240) { return 0; }
    i = 0;
    while (i <= pl) { out[i] = p[i]; i = i + 1; }
    if (sys.stat(out, cast(*u8, &st[0])) == 0 && st[3] == 0) { return 1; }
    out[pl] = cast(u8, 46); out[pl + 1] = cast(u8, 99); out[pl + 2] = cast(u8, 115); out[pl + 3] = cast(u8, 101);
    out[pl + 4] = cast(u8, 0);
    if (sys.stat(out, cast(*u8, &st[0])) == 0) { return 1; }
    return 0;
}

// Start argv (pairs of pointer and length) with our stdin, stdout and stderr,
// and wait: 1 when it exited 0.
fn run(av as *i64, ac as i64) as i64 {
    let is [256]u8 as path;
    let is *u8 as cmd = cast(*u8, av[0]);
    if (prog_path(cmd, cast(*u8, &path[0])) == 0) {
        flush();
        prog.errs("find: '"); prog.errs(cmd); prog.errs("': no such command\n");
        g_status = 1;
        return 0;
    }
    flush();                                         // what we printed comes first
    let is [6]i64 as fda;
    fda[0] = 0; fda[1] = 0; fda[2] = 1; fda[3] = 1; fda[4] = 2; fda[5] = 2;
    let is i64 as pid = sys.spawn_path(cast(*u8, &path[0]), cast(*u8, &fda[0]), 3, cast(*u8, av), ac);
    if (pid < 0) {
        prog.errs("find: cannot start '"); prog.errs(cmd); prog.errs("': "); prog.errs(sys.err_text(pid)); prog.errs("\n");
        g_status = 1;
        return 0;
    }
    if (crash.wait(pid) == 0) { return 1; }
    return 0;
}

// -exec ... ; arguments with {} replaced, and the vector handed to spawn:
// both grow to what a command needs.
let is fu.Line as XB;
let is fu.Line as AVL;

fn room(l as *fu.Line, need as i64) as void {
    if (fu.line_reserve(l, need) != 0) { die("out of memory", "", ""); }
}

// -exec / -ok, once for this entry. Every "{}" in a word becomes the path.
fn run_each(n as i64, ask as i64) as i64 {
    XB.len = 0;
    let is i64 as cost with mut = 0;
    room(&AVL, nb[n] * 16);
    let is *i64 as offs = cast(*i64, AVL.va);      // where each word starts in XB, for now
    let is i64 as w with mut = 0;
    while (w < nb[n]) {
        let is *u8 as src = word(na[n] + w);
        offs[w * 2] = XB.len;
        let is i64 as i with mut = 0;
        while (src[i] != 0) {
            if (src[i] == cast(u8, 123) && src[i + 1] == cast(u8, 125)) {      // {}
                room(&XB, XB.len + slen);
                let is *u8 as d = cast(*u8, XB.va);
                let is i64 as k with mut = 0;
                while (k < slen) { d[XB.len + k] = sbuf[k]; k = k + 1; }
                XB.len = XB.len + slen;
                i = i + 2;
            } else {
                room(&XB, XB.len + 1);
                let is *u8 as d1 = cast(*u8, XB.va);
                d1[XB.len] = src[i]; XB.len = XB.len + 1; i = i + 1;
            }
        }
        offs[w * 2 + 1] = XB.len - offs[w * 2];
        cost = cost + arg_cost(offs[w * 2 + 1]);
        room(&XB, XB.len + 1);
        let is *u8 as d2 = cast(*u8, XB.va);
        d2[XB.len] = cast(u8, 0); XB.len = XB.len + 1;
        w = w + 1;
    }
    if (cost > sys.ARGV_MAX) { return too_long(); }
    // offsets into pointers, now that XB is done growing
    let is i64 as ac = nb[n];
    let is i64 as j0 with mut = 0;
    while (j0 < ac) { offs[j0 * 2] = XB.va + offs[j0 * 2]; j0 = j0 + 1; }
    let is *i64 as av = offs;
    if (ask == 1) {
        flush();
        prog.errs_raw("< ");
        let is i64 as j with mut = 0;
        while (j < ac) { prog.err_raw(cast(*u8, av[j * 2]), av[j * 2 + 1]); prog.errs_raw(" "); j = j + 1; }
        prog.errs_raw("> ? ");
        let is [16]u8 as ans;
        let is i64 as got = prog.getline(cast(*u8, &ans[0]), 16);
        prog.errs_raw("\n");
        if (got <= 0 || (ans[0] != cast(u8, 121) && ans[0] != cast(u8, 89))) { return 0; }
    }
    return run(av, ac);
}

fn too_long() as i64 {
    flush();
    prog.errs("find: the command for '"); prog.err(cast(*u8, &sbuf[0]), slen); prog.errs("' is too long to run\n");
    g_status = 1;
    return 0;
}

// -exec ... {} +: paths gathered per such action, and run whenever the next
// would take the command past what spawn takes (sys.ARGV_MAX).
struct Batch {
    node as i64;
    count as i64;        // paths gathered
    cost as i64;         // what they cost as arguments
    bytes as fu.Line;    // the paths, each NUL-terminated
    offs as fu.Line;     // [count]i64: where each starts
}
let is fu.Line as BATCHES;                // [nbatch]Batch
let is i64 as nbatch with mut = 0;

fn batch(i as i64) as *Batch { return cast(*Batch, BATCHES.va + i * sizeof(Batch)); }

fn batch_new(n as i64) as i64 {
    room(&BATCHES, (nbatch + 1) * sizeof(Batch));
    BATCHES.len = (nbatch + 1) * sizeof(Batch);
    let is *Batch as b = batch(nbatch);
    b.node = n; b.count = 0; b.cost = 0;
    b.bytes.va = 0; b.bytes.cap = 0; b.bytes.len = 0;
    b.offs.va = 0; b.offs.cap = 0; b.offs.len = 0;
    nbatch = nbatch + 1;
    return nbatch - 1;
}

// What the command's own words cost.
fn batch_fixed(n as i64) as i64 {
    let is i64 as w with mut = 0;
    let is i64 as c with mut = 0;
    while (w < nb[n]) { c = c + arg_cost(prog.slen(word(na[n] + w))); w = w + 1; }
    return c;
}

fn batch_add(n as i64) as void {
    let is i64 as fixed = batch_fixed(n);
    if (fixed + arg_cost(slen) > sys.ARGV_MAX) { too_long(); return; }
    if (fixed + batch(nv[n]).cost + arg_cost(slen) > sys.ARGV_MAX) { batch_run(n); }
    let is *Batch as b = batch(nv[n]);
    let is i64 as off = b.bytes.len;
    room(&b.bytes, off + slen + 1);
    let is *u8 as d = cast(*u8, b.bytes.va);
    let is i64 as k with mut = 0;
    while (k < slen) { d[off + k] = sbuf[k]; k = k + 1; }
    d[off + slen] = cast(u8, 0);
    b.bytes.len = off + slen + 1;
    room(&b.offs, (b.count + 1) * 8);
    let is *i64 as o = cast(*i64, b.offs.va);
    o[b.count] = off;
    b.count = b.count + 1;
    b.cost = b.cost + arg_cost(slen);
    return;
}

fn batch_run(n as i64) as void {
    let is *Batch as b = batch(nv[n]);
    if (b.count == 0) { return; }
    let is i64 as total = nb[n] + b.count;
    room(&AVL, total * 16);
    let is *i64 as av = cast(*i64, AVL.va);
    let is i64 as ac with mut = 0;
    while (ac < nb[n]) {
        let is *u8 as w = word(na[n] + ac);
        av[ac * 2] = cast(i64, w); av[ac * 2 + 1] = prog.slen(w);
        ac = ac + 1;
    }
    let is *i64 as o = cast(*i64, b.offs.va);
    let is i64 as j with mut = 0;
    while (j < b.count) {
        let is *u8 as p = cast(*u8, b.bytes.va + o[j]);
        av[ac * 2] = cast(i64, p); av[ac * 2 + 1] = prog.slen(p);
        ac = ac + 1; j = j + 1;
    }
    if (run(av, ac) == 0) { g_status = 1; }
    b.bytes.len = 0; b.count = 0; b.cost = 0;
    return;
}

// ---- the walk ------------------------------------------------------------------

// A directory's names are read into this before any is looked at — a -delete
// while the directory is still being read would move what is left of it — and
// the walk uses it as a stack: a directory's names sit above its parent's
// until it is done. Reserved once and committed as it fills, so a directory
// may hold any number of names.
let is i64 as ARENA with imut = 268435456;
let is i64 as a_base with mut = 0;
let is i64 as a_top with mut = 0;
let is i64 as a_commit with mut = 0;

fn arena_need(n as i64) as void {
    while (a_top + n > a_commit) {
        if (a_commit + 65536 > ARENA ||
            sys.commit(a_base + a_commit, 65536, sys.PROT_READ | sys.PROT_WRITE) != 0) {
            die("out of memory for the names of a directory", "", "");
        }
        a_commit = a_commit + 65536;
    }
    return;
}

// Records: name length, is-directory, size, then the name and its NUL, padded
// to 8 bytes.
fn list(dir_fd as i64) as i64 {
    let is [320]u8 as de;
    let is i64 as count with mut = 0;
    while (sys.readdir(dir_fd, cast(*u8, &de[0])) == 0) {
        let is i64 as nl = fu.de_name_len(cast(*u8, &de[0]));
        if (fu.is_dot(cast(*u8, &de[0]), nl) == 0) {
            let is i64 as rec = 24 + ((nl + 8) / 8) * 8;
            arena_need(rec);
            let is *i64 as r = cast(*i64, a_base + a_top);
            r[0] = nl;
            r[1] = fu.de_is_dir(cast(*u8, &de[0]));
            r[2] = fu.de_size(cast(*u8, &de[0]));
            let is *u8 as nm = cast(*u8, a_base + a_top + 24);
            let is i64 as k with mut = 0;
            while (k < nl) { nm[k] = de[k]; k = k + 1; }
            nm[nl] = cast(u8, 0);
            a_top = a_top + rec;
            count = count + 1;
        }
    }
    return count;
}

// Append "/name" to both paths; returns where they were, for truncate().
fn push_name(nm as *u8, nl as i64) as i64 {
    if (slen + nl + 2 >= 4096 || alen + nl + 2 >= 4096) { return 0 - 1; }
    let is i64 as was = slen * 65536 + alen;
    if (slen == 0 || sbuf[slen - 1] != cast(u8, 47)) { sbuf[slen] = cast(u8, 47); slen = slen + 1; }
    if (alen == 0 || abuf[alen - 1] != cast(u8, 47)) { abuf[alen] = cast(u8, 47); alen = alen + 1; }
    let is i64 as k with mut = 0;
    while (k < nl) { sbuf[slen + k] = nm[k]; abuf[alen + k] = nm[k]; k = k + 1; }
    slen = slen + nl; alen = alen + nl;
    sbuf[slen] = cast(u8, 0); abuf[alen] = cast(u8, 0);
    return was;
}

fn truncate(was as i64) as void {
    slen = was / 65536; alen = was - slen * 65536;
    sbuf[slen] = cast(u8, 0); abuf[alen] = cast(u8, 0);
    return;
}

// Look at the entry now in sbuf/abuf (its facts in e_*), then into it.
fn visit(root as i64, depth as i64) as void {
    let is i64 as name = e_name;
    let is i64 as nlen = e_nlen;
    let is i64 as isdir = e_dir;
    let is i64 as size = e_size;
    let is i64 as start = e_start;
    e_prune = 0;
    e_mtime = 0 - 1;
    if (g_post == 0 && depth >= g_mindepth) { eval(root); }
    let is i64 as pruned = e_prune;
    if (isdir != 0 && depth < g_maxdepth && (pruned == 0 || g_post == 1) && g_quit == 0) {
        let is i64 as fd = sys.open_read(cast(*u8, &abuf[0]));
        if (fd < 0) {
            flush();
            prog.errs("find: '"); prog.err(cast(*u8, &sbuf[0]), slen); prog.errs("': ");
            prog.errs(sys.err_text(fd)); prog.errs("\n");
            g_status = 1;
        } else {
            let is i64 as mark = a_top;
            let is i64 as count = list(fd);
            sys.close(fd);
            let is i64 as at with mut = mark;
            let is i64 as i with mut = 0;
            while (i < count && g_quit == 0) {
                let is *i64 as r = cast(*i64, a_base + at);
                let is i64 as nl = r[0];
                let is i64 as was = push_name(cast(*u8, a_base + at + 24), nl);
                if (was < 0) {
                    flush();
                    prog.errs("find: '"); prog.err(cast(*u8, &sbuf[0]), slen); prog.errs("/...': path too long\n");
                    g_status = 1;
                } else {
                    e_name = a_base + at + 24; e_nlen = nl;
                    e_dir = r[1]; e_size = r[2]; e_start = 0;
                    visit(root, depth + 1);
                    truncate(was);
                }
                at = at + 24 + ((nl + 8) / 8) * 8;
                i = i + 1;
            }
            a_top = mark;
        }
    }
    if (g_post == 1 && depth >= g_mindepth && g_quit == 0) {
        e_name = name; e_nlen = nlen; e_dir = isdir; e_size = size; e_start = start;
        e_prune = 0; e_mtime = 0 - 1;
        eval(root);
    }
    return;
}

// Fold "." and ".." out of an absolute path, in place: the filesystem knows
// neither. Returns the new length.
fn normalize(p as *u8, n as i64) as i64 {
    let is i64 as o with mut = 0;            // write position
    let is i64 as i with mut = 0;
    while (i < n) {
        while (i < n && p[i] == cast(u8, 47)) { i = i + 1; }
        let is i64 as s = i;
        while (i < n && p[i] != cast(u8, 47)) { i = i + 1; }
        let is i64 as len = i - s;
        if (len == 0 || (len == 1 && p[s] == cast(u8, 46))) { }
        else if (len == 2 && p[s] == cast(u8, 46) && p[s + 1] == cast(u8, 46)) {
            while (o > 0 && p[o - 1] != cast(u8, 47)) { o = o - 1; }
            if (o > 0) { o = o - 1; }
        } else {
            p[o] = cast(u8, 47); o = o + 1;
            let is i64 as k with mut = 0;
            while (k < len) { p[o] = p[s + k]; o = o + 1; k = k + 1; }
        }
    }
    if (o == 0) { p[0] = cast(u8, 47); o = 1; }
    p[o] = cast(u8, 0);
    return o;
}

fn start_at(root as i64, path as *u8) as void {
    let is i64 as pl = prog.slen(path);
    if (pl == 0 || pl >= 4000) {
        flush();
        prog.errs("find: '"); prog.errs(path); prog.errs("': not a path\n");
        g_status = 1;
        return;
    }
    let is i64 as i with mut = 0;
    while (i <= pl) { sbuf[i] = path[i]; i = i + 1; }
    slen = pl;
    // Absolute: as given, or under / for a relative one.
    alen = 0;
    if (path[0] != cast(u8, 47)) { abuf[0] = cast(u8, 47); alen = 1; }
    i = 0;
    while (i < pl) { abuf[alen + i] = path[i]; i = i + 1; }
    alen = normalize(cast(*u8, &abuf[0]), alen + pl);
    let is i64 as isdir with mut = 1;
    let is i64 as size with mut = 0;
    if (alen > 1) {
        let is [4]i64 as st;
        let is i32 as rc = sys.stat(cast(*u8, &abuf[0]), cast(*u8, &st[0]));
        if (cast(i64, rc) != 0) {
            flush();
            prog.errs("find: '"); prog.errs(path); prog.errs("': "); prog.errs(sys.err_text(cast(i64, rc))); prog.errs("\n");
            g_status = 1;
            return;
        }
        size = st[0];
        isdir = st[3];
    }
    // The name a -name test sees: the last component as given ("dir" for
    // "a/dir/", "/" for "/", "." for ".").
    let is i64 as e with mut = slen;
    while (e > 1 && sbuf[e - 1] == cast(u8, 47)) { e = e - 1; }
    let is i64 as b with mut = e;
    while (b > 0 && sbuf[b - 1] != cast(u8, 47)) { b = b - 1; }
    if (b == e) { b = 0; }
    let is [4096]u8 as nm;
    let is i64 as k with mut = 0;
    while (b + k < e) { nm[k] = sbuf[b + k]; k = k + 1; }
    nm[k] = cast(u8, 0);
    e_name = cast(i64, &nm[0]); e_nlen = k;
    e_dir = isdir; e_size = size; e_start = 1;
    visit(root, 0);
    return;
}

fn usage() as void {
    prog.outs("usage: find [PATH...] [EXPRESSION]\n");
    prog.outs("  ( EXPR )  ! EXPR  EXPR -a EXPR  EXPR -o EXPR\n");
    prog.outs("  options: -maxdepth N -mindepth N -depth\n");
    prog.outs("  tests:   -name P -iname P -path P -ipath P -type f|d -size [+-]N[cwbkMG]\n");
    prog.outs("           -empty -newer FILE -mtime [+-]N -mmin [+-]N -true -false\n");
    prog.outs("  actions: -print -print0 -prune -quit -delete -exec CMD ... ; -exec CMD ... {} + -ok CMD ... ;\n");
    return;
}

fn main(argc as i64, argv as *u8) as i32 {
    g_argv = cast(i64, argv);
    g_argc = argc;
    MAXN = argc * 2 + 8;
    let is i64 as nva = sys.mmap(0, fu.page_round(MAXN * 8 * 7), sys.PROT_READ | sys.PROT_WRITE);
    if (nva < 0) { die("out of memory", "", ""); }
    nk = cast(*i64, nva); na = cast(*i64, nva + MAXN * 8); nb = cast(*i64, nva + MAXN * 16);
    nv = cast(*i64, nva + MAXN * 24); nw = cast(*i64, nva + MAXN * 32); nu = cast(*i64, nva + MAXN * 40);
    np = cast(*i64, nva + MAXN * 48);
    if (argc >= 2 && (streq(prog.arg(argv, 1), "--help") == 1 || streq(prog.arg(argv, 1), "-help") == 1)) {
        usage();
        return 0;
    }
    // -H -L -P first: there are no symbolic links here to follow or not.
    let is i64 as i with mut = 1;
    while (i < argc && (streq(prog.arg(argv, i), "-H") == 1 || streq(prog.arg(argv, i), "-L") == 1
                        || streq(prog.arg(argv, i), "-P") == 1)) { i = i + 1; }
    let is i64 as first = i;
    while (i < argc) {
        let is *u8 as a = prog.arg(argv, i);
        if (a[0] == cast(u8, 45) || streq(a, "(") == 1 || streq(a, "!") == 1) { break; }
        i = i + 1;
    }
    let is i64 as pathend = i;

    let is i64 as root with mut = 0 - 1;
    if (pathend < argc) {
        g_pos = pathend;
        root = parse_or();
        if (g_pos < argc) { die("unexpected '", word(g_pos), "'"); }
    }
    if (g_action == 0) {
        let is i64 as pr = node(K_PRINT);
        if (root < 0) { root = pr; } else { root = bin(K_AND, root, pr); }
    }

    a_base = sys.reserve(0, ARENA, sys.PROT_READ | sys.PROT_WRITE);
    if (a_base <= 0) { die("no memory to walk with", "", ""); }

    if (pathend == first) { start_at(root, "."); }
    let is i64 as k with mut = first;
    while (k < pathend && g_quit == 0) {
        start_at(root, prog.arg(argv, k));
        k = k + 1;
    }
    let is i64 as b with mut = 0;
    while (b < nbatch) { batch_run(batch(b).node); b = b + 1; }
    flush();
    return cast(i32, g_status);
}
