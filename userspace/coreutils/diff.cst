// diff — compare two files line by line. `diff [-u] FILE1 FILE2`
//   default: normal output (NaM / NcM / NdM with < and > lines)
//   -u:      unified output (@@ -a,b +c,d @@ with -, +, space)
// LCS via dynamic programming (capped at 1024 lines per file).
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;

let is i64 as MAXL = 1024;
let is [262144]u8 as gA; let is [262144]u8 as gB;
let is [1024]i64 as aoff; let is [1024]i64 as alen; let is i64 as na with mut = 0;
let is [1024]i64 as boff; let is [1024]i64 as blen; let is i64 as nb with mut = 0;
let is [1050625]i64 as L;                          // (1024+1)^2 LCS table
let is [4096]i64 as op; let is i64 as nop with mut = 0;   // 0 keep, 1 del(A), 2 add(B)
let is [4096]i64 as opi; let is [4096]i64 as opj;        // line indices
let is i64 as g_u with mut = 0;

fn streq(a as *u8, b as *u8) as i64 { let is i64 as i with mut = 0; while (a[i] != 0 && b[i] != 0) { if (a[i] != b[i]) { return 0; } i = i + 1; } if (a[i] == b[i]) { return 1; } return 0; }
fn load(path as *u8, buf as i64, off as *i64, len as *i64, nout as *i64) as i64 {
    let is [256]u8 as pb; let is i64 as fd = sys.open_read(prog.abspath(path, cast(*u8, &pb[0])));
    if (fd < 0) { return 0 - 1; }
    let is i64 as n with mut = 0;
    let is i64 as r with mut = sys.read(fd, cast(*u8, buf + n), 65536);
    while (r > 0) { n = n + r; if (n + 65536 > 262144) { break; } r = sys.read(fd, cast(*u8, buf + n), 65536); }
    sys.close(fd);
    let is *u8 as b = cast(*u8, buf); let is i64 as cnt with mut = 0; let is i64 as ls with mut = 0; let is i64 as i with mut = 0;
    while (i < n && cnt < MAXL) { if (b[i] == 0x0A) { off[cnt] = ls; len[cnt] = i - ls; cnt = cnt + 1; ls = i + 1; } i = i + 1; }
    if (ls < n && cnt < MAXL) { off[cnt] = ls; len[cnt] = n - ls; cnt = cnt + 1; }
    nout[0] = cnt;
    return 0;
}
fn line_eq(ai as i64, bi as i64) as i64 {
    if (alen[ai] != blen[bi]) { return 0; }
    let is *u8 as pa = cast(*u8, cast(i64, &gA[0]) + aoff[ai]); let is *u8 as pb = cast(*u8, cast(i64, &gB[0]) + boff[bi]);
    let is i64 as k with mut = 0; while (k < alen[ai]) { if (pa[k] != pb[k]) { return 0; } k = k + 1; }
    return 1;
}
fn emit_aline(ai as i64, pre as *u8) as void { prog.outs(pre); prog.out(cast(*u8, cast(i64, &gA[0]) + aoff[ai]), alen[ai]); prog.out("\n", 1); }
fn emit_bline(bi as i64, pre as *u8) as void { prog.outs(pre); prog.out(cast(*u8, cast(i64, &gB[0]) + boff[bi]), blen[bi]); prog.out("\n", 1); }

fn build_ops() as void {
    // LCS table
    let is i64 as i with mut = na; let is i64 as W = nb + 1;
    while (i >= 0) { let is i64 as j with mut = nb; while (j >= 0) {
        if (i == na || j == nb) { L[i * W + j] = 0; }
        else if (line_eq(i, j) == 1) { L[i * W + j] = L[(i + 1) * W + (j + 1)] + 1; }
        else { let is i64 as x = L[(i + 1) * W + j]; let is i64 as y = L[i * W + (j + 1)]; if (x >= y) { L[i * W + j] = x; } else { L[i * W + j] = y; } }
        j = j - 1; } i = i - 1; }
    // forward walk producing keep/del/add
    nop = 0; let is i64 as a with mut = 0; let is i64 as b with mut = 0;
    while (a < na || b < nb) {
        if (a < na && b < nb && line_eq(a, b) == 1) { op[nop] = 0; opi[nop] = a; opj[nop] = b; nop = nop + 1; a = a + 1; b = b + 1; }
        else if (a < na && (b >= nb || L[(a + 1) * W + b] >= L[a * W + (b + 1)])) { op[nop] = 1; opi[nop] = a; nop = nop + 1; a = a + 1; }   // prefer DEL on ties (- before +)
        else { op[nop] = 2; opj[nop] = b; nop = nop + 1; b = b + 1; }
    }
}

fn put_range(lo as i64, hi as i64) as void { prog.out_num(lo); if (hi > lo) { prog.outs(","); prog.out_num(hi); } }

fn output_normal() as void {
    let is i64 as k with mut = 0; let is i64 as acur with mut = 0; let is i64 as bcur with mut = 0;
    while (k < nop) {
        if (op[k] == 0) { acur = acur + 1; bcur = bcur + 1; k = k + 1; }
        else {
            let is i64 as ds with mut = 0 - 1; let is i64 as de with mut = 0 - 1; let is i64 as as_ with mut = 0 - 1; let is i64 as ae with mut = 0 - 1;
            let is i64 as a_before = acur; let is i64 as b_before = bcur;
            while (k < nop && op[k] != 0) {
                if (op[k] == 1) { if (ds < 0) { ds = opi[k]; } de = opi[k]; acur = acur + 1; } else { if (as_ < 0) { as_ = opj[k]; } ae = opj[k]; bcur = bcur + 1; }
                k = k + 1;
            }
            if (ds >= 0 && as_ >= 0) { put_range(ds + 1, de + 1); prog.outs("c"); put_range(as_ + 1, ae + 1); prog.out("\n", 1); }
            else if (ds >= 0) { put_range(ds + 1, de + 1); prog.outs("d"); prog.out_num(b_before); prog.out("\n", 1); }
            else { prog.out_num(a_before); prog.outs("a"); put_range(as_ + 1, ae + 1); prog.out("\n", 1); }
            let is i64 as t with mut = ds; while (t >= 0 && t <= de) { emit_aline(t, "< "); t = t + 1; }
            if (ds >= 0 && as_ >= 0) { prog.outs("---\n"); }
            t = as_; while (t >= 0 && t <= ae) { emit_bline(t, "> "); t = t + 1; }
        }
    }
}

// unified: each changed region becomes one @@ hunk with up to 3 context lines.
fn output_unified(f1 as *u8, f2 as *u8) as void {
    prog.outs("--- "); prog.outs(f1); prog.out("\n", 1); prog.outs("+++ "); prog.outs(f2); prog.out("\n", 1);
    let is i64 as k with mut = 0;
    while (k < nop) {
        if (op[k] == 0) { k = k + 1; }
        else {
            let is i64 as hs with mut = k; let is i64 as c with mut = 0; while (hs > 0 && op[hs - 1] == 0 && c < 3) { hs = hs - 1; c = c + 1; }
            // extend the hunk, merging later changes separated by <= 6 context lines
            let is i64 as he with mut = k;
            while (he < nop && op[he] != 0) { he = he + 1; }                                      // through this change run
            let is i64 as more with mut = 1;
            while (more == 1) {
                let is i64 as cc with mut = 0; let is i64 as q with mut = he;
                while (q < nop && op[q] == 0) { cc = cc + 1; q = q + 1; }
                if (q < nop && cc <= 6) { he = q; while (he < nop && op[he] != 0) { he = he + 1; } }   // merge
                else { let is i64 as tail with mut = cc; if (tail > 3) { tail = 3; } he = he + tail; more = 0; }
            }
            let is i64 as ai with mut = 0; let is i64 as bj with mut = 0; let is i64 as t with mut = 0;
            while (t < hs) { if (op[t] == 0) { ai = ai + 1; bj = bj + 1; } else if (op[t] == 1) { ai = ai + 1; } else { bj = bj + 1; } t = t + 1; }
            let is i64 as ac with mut = 0; let is i64 as bc with mut = 0; t = hs; while (t < he) { if (op[t] == 0) { ac = ac + 1; bc = bc + 1; } else if (op[t] == 1) { ac = ac + 1; } else { bc = bc + 1; } t = t + 1; }
            prog.outs("@@ -"); prog.out_num(ai + 1); prog.outs(","); prog.out_num(ac); prog.outs(" +"); prog.out_num(bj + 1); prog.outs(","); prog.out_num(bc); prog.outs(" @@\n");
            t = hs; while (t < he) { if (op[t] == 0) { emit_aline(opi[t], " "); } else if (op[t] == 1) { emit_aline(opi[t], "-"); } else { emit_bline(opj[t], "+"); } t = t + 1; }
            k = he;
        }
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is i64 as i with mut = 1; let is *u8 as f1 with mut; let is *u8 as f2 with mut; f1 = cast(*u8, 0); f2 = cast(*u8, 0);
    while (i < argc) {
        let is *u8 as a = prog.arg(argv, i);
        if (streq(a, "-u") == 1) { g_u = 1; }
        else if (a[0] == 45 && a[1] != 0) { prog.outs("usage: diff [-u] FILE1 FILE2\n"); return cast(i32, 2); }
        else { if (cast(i64, f1) == 0) { f1 = a; } else { f2 = a; } }
        i = i + 1;
    }
    if (cast(i64, f1) == 0 || cast(i64, f2) == 0) { prog.outs("usage: diff [-u] FILE1 FILE2\n"); return cast(i32, 2); }
    if (load(f1, cast(i64, &gA[0]), cast(*i64, &aoff[0]), cast(*i64, &alen[0]), cast(*i64, &na)) != 0) { prog.outs("diff: cannot open "); prog.outs(f1); prog.out("\n", 1); return cast(i32, 2); }
    if (load(f2, cast(i64, &gB[0]), cast(*i64, &boff[0]), cast(*i64, &blen[0]), cast(*i64, &nb)) != 0) { prog.outs("diff: cannot open "); prog.outs(f2); prog.out("\n", 1); return cast(i32, 2); }
    build_ops();
    let is i64 as diffs with mut = 0; let is i64 as z with mut = 0; while (z < nop) { if (op[z] != 0) { diffs = 1; } z = z + 1; }
    if (diffs == 0) { return cast(i32, 0); }
    if (g_u == 1) { output_unified(f1, f2); } else { output_normal(); }
    return cast(i32, 1);
}
