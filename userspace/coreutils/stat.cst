// stat — show file metadata. stat [-f] file ...
// Reads VfsStat {size, first_cluster, attr, is_dir}. (FAT32 carries no
// owner/permissions.) With -f, prints the FILESYSTEM info (SYS_STATFS)
// instead of the per-file stat — mirrors POSIX `stat -f file`.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;

fn do_statfs(name as *u8) as i32 {
    let is [3]i64 as st;
    if (sys.statfs(cast(*i64, &st[0])) != 0) {
        prog.outs("stat: statfs failed\n"); return cast(i32, 1);
    }
    prog.outs(name); prog.out("\n", 1);
    prog.outs("  Filesystem:     fat32\n");
    prog.outs("  BlockSize:      "); prog.out_num(st[2]); prog.out("\n", 1);
    prog.outs("  TotalBlocks:    "); prog.out_num(st[0] / st[2]); prog.out("\n", 1);
    prog.outs("  FreeBlocks:     "); prog.out_num(st[1] / st[2]); prog.out("\n", 1);
    prog.outs("  TotalBytes:     "); prog.out_num(st[0]); prog.out("\n", 1);
    prog.outs("  FreeBytes:      "); prog.out_num(st[1]); prog.out("\n", 1);
    return 0;
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as fs_flag with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "f");
        if (f < 0) { break; }
        if (f == 102) { fs_flag = 1; }
        else { prog.outs("usage: stat [-f] file ...\n"); return cast(i32, 1); }
    }
    if (argc - o.ind <= 0) { prog.outs("usage: stat [-f] file ...\n"); return cast(i32, 1); }
    if (fs_flag == 1) { return do_statfs(prog.arg(argv, o.ind)); }
    let is i32 as rc with mut = 0;
    let is i64 as i with mut = o.ind;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb;
        let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is [4]i64 as st;
        if (sys.stat(path, cast(*u8, &st[0])) != 0) {
            prog.outs("stat: "); prog.outs(name); prog.outs(": no such file\n"); rc = cast(i32, 1);
        } else {
            prog.outs(name); prog.out("\n", 1);
            prog.outs("  size:    "); prog.out_num(st[0]); prog.outs(" bytes\n");
            prog.outs("  type:    "); if (st[3] != 0) { prog.outs("directory\n"); } else { prog.outs("file\n"); }
            prog.outs("  cluster: "); prog.out_num(st[1]); prog.out("\n", 1);
            prog.outs("  attr:    "); prog.out_num(st[2]); prog.out("\n", 1);
        }
        i = i + 1;
    }
    return rc;
}
