// stat — show file metadata. stat file ... Reads VfsStat {size, first_cluster,
// attr, is_dir}. (FAT32 carries no owner/permissions/timestamps.)
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/futil.cst" as fu;

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "");
        if (f < 0) { break; }
        prog.outs("usage: stat file ...\n"); return cast(i32, 1);
    }
    if (argc - o.ind <= 0) { prog.outs("usage: stat file ...\n"); return cast(i32, 1); }
    let is i32 as rc with mut = 0;
    let is i64 as i with mut = o.ind;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb;
        let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is [4]i64 as st;
        if (sys.stat(path, cast(*u8, &st[0])) != 0) {
            prog.outs("stat: "); prog.outs(name); prog.outs(": no such file\n"); rc = cast(i32, 1);
        } else {
            prog.outs(name); prog.out("\n", 1);
            prog.outs("  size:    "); prog.out_num(st[0]); prog.outs(" bytes\n");
            prog.outs("  type:    "); if (st[3] != 0) { prog.outs("directory\n"); } else { prog.outs("file\n"); }
            prog.outs("  cluster: "); prog.out_num(st[1]); prog.out("\n", 1);
            prog.outs("  attr:    "); prog.out_num(st[2]); prog.out("\n", 1);
        }
        i = i + 1;
    }
    return rc;
}
