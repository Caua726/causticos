// cat — concatenate files to stdout.
//   cat [-n] [-b] [-s] [-E] [-T] [-v] [-A] [-e] [-t] [file ...]
// -n number all lines  -b number nonempty lines  -s squeeze blank runs
// -E end-of-line as `$`  -T tabs as `^I`  -v show non-printing (^X, M-x)
// -A = -vET   -e = -vE   -t = -vT.   No file (or `-`) reads stdin.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;

let is i64 as FN = 1; let is i64 as FB = 2; let is i64 as FS = 4; let is i64 as FE = 8;
let is i64 as FT = 16; let is i64 as FV = 32;

fn put_caret(c as i64) as void { let is [2]u8 as b; b[0] = cast(u8, 94); b[1] = cast(u8, c + 64); prog.out(cast(*u8, &b[0]), 2); }

// emit one byte (never '\n') applying -v and -T.
fn emit_vis(c as i64, fl as i64) as void {
    if (c == 9) { if ((fl & FT) != 0) { prog.outs("^I"); } else { prog.out("\t", 1); } return; }
    if ((fl & FV) == 0) { let is [1]u8 as o; o[0] = cast(u8, c); prog.out(cast(*u8, &o[0]), 1); return; }
    if (c == 127) { prog.outs("^?"); return; }
    if (c >= 128) {
        prog.outs("M-"); let is i64 as d = c - 128;
        if (d == 127) { prog.outs("^?"); } else if (d < 32) { put_caret(d); } else { let is [1]u8 as o; o[0] = cast(u8, d); prog.out(cast(*u8, &o[0]), 1); }
        return;
    }
    if (c < 32) { put_caret(c); return; }
    let is [1]u8 as o; o[0] = cast(u8, c); prog.out(cast(*u8, &o[0]), 1);
}

// st[0]=next line number, st[1]=consecutive blank count (persist across files).
fn cat_one(r as *fu.Reader, fl as i64, st as *i64) as void {
    let is i64 as at_bol with mut = 1;
    let is i64 as skip with mut = 0;
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(r);
        if (c < 0) { break; }
        if (at_bol == 1) {
            at_bol = 0;
            let is i64 as blank with mut = 0;
            if (c == 0x0A) { blank = 1; }
            skip = 0;
            if ((fl & FS) != 0) {
                if (blank == 1) { st[1] = st[1] + 1; if (st[1] > 1) { skip = 1; } } else { st[1] = 0; }
            }
            if (skip == 0 && ((fl & FN) != 0 || ((fl & FB) != 0 && blank == 0))) {
                prog.pad_num(st[0], 6); prog.out("\t", 1); st[0] = st[0] + 1;
            }
        }
        if (skip == 0) {
            if (c == 0x0A) { if ((fl & FE) != 0) { prog.outs("$"); } prog.out("\n", 1); }
            else { emit_vis(c, fl); }
        }
        if (c == 0x0A) { at_bol = 1; }
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as fl with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "nbsETvAet");
        if (f < 0) { break; }
        if (f == 110) { fl = fl | FN; }
        else if (f == 98) { fl = fl | FB; }
        else if (f == 115) { fl = fl | FS; }
        else if (f == 69) { fl = fl | FE; }
        else if (f == 84) { fl = fl | FT; }
        else if (f == 118) { fl = fl | FV; }
        else if (f == 65) { fl = fl | FV | FE | FT; }              // -A = -vET
        else if (f == 101) { fl = fl | FV | FE; }                  // -e = -vE
        else if (f == 116) { fl = fl | FV | FT; }                  // -t = -vT
        else { prog.outs("usage: cat [-nbsETvAet] [file ...]\n"); return cast(i32, 1); }
    }
    let is [2]i64 as st; st[0] = 1; st[1] = 0;
    let is i64 as nfiles = argc - o.ind;
    if (nfiles <= 0) {
        let is [4096]u8 as buf; let is fu.Reader as r;
        fu.rd_open_fd(&r, cast(i64, 0), cast(*u8, &buf[0]), 4096);
        cat_one(&r, fl, cast(*i64, &st[0]));
        return 0;
    }
    let is i32 as rc with mut = 0; let is i64 as i with mut = o.ind;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb; let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is [4096]u8 as buf; let is fu.Reader as r;
        if (fu.rd_open(&r, path, cast(*u8, &buf[0]), 4096) < 0) { prog.outs("cat: "); prog.outs(name); prog.outs(": cannot open\n"); rc = cast(i32, 1); }
        else { cat_one(&r, fl, cast(*i64, &st[0])); fu.rd_close(&r); }
        i = i + 1;
    }
    return rc;
}
