// make — build the targets in a Causticfile. `make [Causticfile]` (default
// /Causticfile). Each non-blank, non-# line is "output.cse: source.cst"; make
// compiles each through the embedded /caustic.cse. A minimal build driver for
// projects with several executables.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

// copy text[a,b) into dst with surrounding spaces/tabs trimmed; NUL-terminate.
// returns the trimmed length.
fn trim_copy(dst as *u8, text as *u8, a as i64, b as i64) as i64 {
    let is i64 as s with mut = a;
    let is i64 as e with mut = b;
    while (s < e) { let is i64 as c = cast(i64, text[s]); if (c == 32 || c == 9) { s = s + 1; } else { break; } }
    while (e > s) { let is i64 as c = cast(i64, text[e - 1]); if (c == 32 || c == 9 || c == 13) { e = e - 1; } else { break; } }
    let is i64 as n with mut = 0;
    while (s < e) { dst[n] = text[s]; n = n + 1; s = s + 1; }
    dst[n] = cast(u8, 0);
    return n;
}

fn main(argc as i64, argv as *u8) as i32 {
    let is [256]u8 as pb;
    let is *u8 as cfile with mut = "/Causticfile";
    if (argc >= 2) { cfile = prog.abspath(prog.arg(argv, 1), cast(*u8, &pb[0])); }
    let is i64 as tlen with mut = 0;
    let is i64 as tbase = fu.slurp(cfile, &tlen);
    if (tlen <= 0) { prog.outs("make: cannot read "); prog.outs(cfile); prog.out("\n", 1); return cast(i32, 1); }
    let is *u8 as text = cast(*u8, tbase);

    let is i64 as clen with mut = 0;
    let is i64 as cimg = fu.slurp("/caustic.cse", &clen);
    if (clen <= 0) { prog.outs("make: /caustic.cse not on disk\n"); fu.unslurp(tbase, tlen); return cast(i32, 1); }

    let is i64 as built with mut = 0;
    let is i64 as failed with mut = 0;
    let is i64 as ls with mut = 0;                       // line start
    let is i64 as i with mut = 0;
    while (i <= tlen) {
        if (i == tlen || cast(i64, text[i]) == 0x0A) {
            // line is text[ls, i)
            if (i > ls) {
                // skip leading spaces to find first non-space
                let is i64 as f with mut = ls;
                while (f < i) { let is i64 as c = cast(i64, text[f]); if (c == 32 || c == 9) { f = f + 1; } else { break; } }
                if (f < i && cast(i64, text[f]) != 35) {     // not blank, not '#'
                    // find ':' in [f, i)
                    let is i64 as colon with mut = 0 - 1;
                    let is i64 as k with mut = f;
                    while (k < i) { if (cast(i64, text[k]) == 58) { colon = k; break; } k = k + 1; }
                    if (colon >= 0) {
                        let is [128]u8 as outb; let is [128]u8 as srcb;
                        trim_copy(cast(*u8, &outb[0]), text, f, colon);
                        trim_copy(cast(*u8, &srcb[0]), text, colon + 1, i);
                        prog.outs("make: "); prog.outs(cast(*u8, &srcb[0])); prog.outs(" -> "); prog.outs(cast(*u8, &outb[0])); prog.out("\n", 1);
                        let is [10]i64 as av;
                        av[0] = cast(i64, "caustic");                 av[1] = 7;
                        av[2] = cast(i64, &srcb[0]);                  av[3] = prog.slen(cast(*u8, &srcb[0]));
                        av[4] = cast(i64, "-o");                      av[5] = 2;
                        av[6] = cast(i64, &outb[0]);                  av[7] = prog.slen(cast(*u8, &outb[0]));
                        av[8] = cast(i64, "--target=caustic-x86_64"); av[9] = 23;
                        let is [2]i64 as fda; fda[0] = 1; fda[1] = 1;
                        let is i64 as pid = sys.spawn(cast(*u8, cimg), clen, cast(*u8, &fda[0]), 1, cast(*u8, &av[0]), 5);
                        if (pid < 0) { prog.outs("make: spawn failed\n"); failed = failed + 1; }
                        else {
                            let is [1]i64 as st;
                            let is i64 as r with mut = 0 - 8;
                            while (r == (0 - 8)) { r = sys.wait(pid, cast(*i64, &st[0])); }
                            if (r == 0) { built = built + 1; } else { prog.outs("make: target failed (exit "); prog.out_num(r); prog.outs(")\n"); failed = failed + 1; }
                        }
                    }
                }
            }
            ls = i + 1;
        }
        i = i + 1;
    }
    fu.unslurp(cimg, clen);
    fu.unslurp(tbase, tlen);
    prog.outs("make: "); prog.out_num(built); prog.outs(" built, "); prog.out_num(failed); prog.outs(" failed\n");
    if (failed > 0) { return cast(i32, 1); }
    return 0;
}
