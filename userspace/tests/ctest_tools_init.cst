// ctest_tools_init.cst — proves the standalone toolchain runs ON CausticOS.
// Booted as /init, it drives the split pipeline inside the OS:
//   caustic-as /hello.cst.s              -> /hello.cst.s.o
//   caustic-ld --target=... .o -o .cse   -> /hello.cse
//   /hello.cse                            -> prints its line
// The .s is generated on the host (caustic -c) and seeded on the disk. Each
// tool's progress goes to serial (empty fd table → write(1) falls back).
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;

fn ser(s as *u8) as void { sys.write_serial(s, prog.slen(s)); }
fn page_round(n as i64) as i64 { return (n + 4095) / 4096 * 4096; }

fn load(path as *u8, out_len as *i64) as i64 {
    let is [4]i64 as st;
    if (sys.stat(path, cast(*u8, &st[0])) != 0) { out_len[0] = 0; return 0; }
    let is i64 as size = st[0];
    if (size <= 0) { out_len[0] = 0; return 0; }
    let is i64 as mapped = page_round(size);
    let is i64 as va = sys.mmap(0, mapped, sys.PROT_READ | sys.PROT_WRITE);
    if (va < 0) { out_len[0] = 0; return 0; }
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { out_len[0] = 0; return 0; }
    let is i64 as got with mut = 0;
    while (got < size) {
        let is i64 as r = sys.read(fd, cast(*u8, va + got), size - got);
        if (r <= 0) { break; }
        got = got + r;
    }
    sys.close(fd);
    out_len[0] = got;
    return va;
}

fn probe(path as *u8) as void {
    let is [4]i64 as st;
    ser("  -> "); ser(path);
    if (sys.stat(path, cast(*u8, &st[0])) == 0) { ser(" exists, "); /* size */
        let is [24]u8 as b; let is i64 as v with mut = st[0]; let is i64 as p with mut = 23;
        if (v == 0) { ser("0"); } else { while (v > 0) { b[p] = cast(u8, (v % 10) + 48); v = v / 10; p = p - 1; } sys.write_serial(cast(*u8, cast(i64, &b[0]) + p + 1), 23 - p); }
        ser(" bytes\n");
    } else { ser(" MISSING\n"); }
}

// runv: spawn `path` with up to 6 argv words (trailing 0s ignored), wait.
fn runv(path as *u8, a0 as *u8, a1 as *u8, a2 as *u8, a3 as *u8, a4 as *u8, a5 as *u8) as void {
    ser("\n$ "); ser(a0);
    if (cast(i64, a1) != 0) { ser(" "); ser(a1); }
    if (cast(i64, a2) != 0) { ser(" "); ser(a2); }
    if (cast(i64, a3) != 0) { ser(" "); ser(a3); }
    if (cast(i64, a4) != 0) { ser(" "); ser(a4); }
    if (cast(i64, a5) != 0) { ser(" "); ser(a5); }
    ser("\n");
    let is i64 as len with mut = 0;
    let is i64 as img = load(path, &len);
    if (img == 0) { ser("[load fail]\n"); return; }
    let is [12]i64 as av;
    let is i64 as argc with mut = 1;
    av[0] = cast(i64, a0); av[1] = prog.slen(a0);
    if (cast(i64, a1) != 0) { av[2] = cast(i64, a1); av[3] = prog.slen(a1); argc = 2; }
    if (cast(i64, a2) != 0) { av[4] = cast(i64, a2); av[5] = prog.slen(a2); argc = 3; }
    if (cast(i64, a3) != 0) { av[6] = cast(i64, a3); av[7] = prog.slen(a3); argc = 4; }
    if (cast(i64, a4) != 0) { av[8] = cast(i64, a4); av[9] = prog.slen(a4); argc = 5; }
    if (cast(i64, a5) != 0) { av[10] = cast(i64, a5); av[11] = prog.slen(a5); argc = 6; }
    let is i64 as pid = sys.spawn(cast(*u8, img), len, cast(*u8, 0), 0, cast(*u8, &av[0]), argc);
    if (pid < 0) { ser("[spawn fail]\n"); sys.munmap(img, page_round(len)); return; }
    let is [1]i64 as stt;
    sys.wait(pid, cast(*i64, &stt[0]));
    sys.munmap(img, page_round(len));
}

fn main(argc as i64, argv as *u8) as i32 {
    let is *u8 as z = cast(*u8, 0);
    ser("\n##### CTEST-TOOLS begin (split toolchain on CausticOS) #####\n");
    runv("/caustic-as.cse", "caustic-as", "/hello.cst.s", z, z, z, z);
    probe("/hello.cst.s.o");
    runv("/caustic-ld.cse", "caustic-ld", "--target=caustic-x86_64", "/hello.cst.s.o", "-o", "/hello.cse", z);
    probe("/hello.cse");
    runv("/hello.cse", "hello", z, z, z, z, z);
    ser("\n##### CTEST-TOOLS done #####\n");
    while (1 == 1) { sys.sleep_ns(1000000000); }
    return 0;
}
