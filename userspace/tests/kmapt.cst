// kmapt.cst — lib/keymap: what each key types, in each layout the image ships.
//
// The keymap is fed scancodes the way the compositor feeds it the keyboard's
// events, and what comes out is checked: letters and Shift and CapsLock, the
// keypad with and without NumLock, dead keys (an accent and a letter make one
// character; an accent and a letter it does not go on make both), AltGr and
// its Ctrl+Alt stand-in, which modifiers are left for the program once AltGr
// has chosen a character, and the bytes a terminal sends a program for a key.
//
// Then every map in /etc/keymaps is loaded: a layout file with a typo would
// otherwise only be found by the person who picks it, as a keyboard that stays
// US with a line on the serial port saying why.

use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/keymap/keymap.cst" as km;
use "../lib/keymap/keysym.cst" as ks;

let is km.Keymap as k with mut;
let is i64 as checks with mut = 0;
let is i64 as bad with mut = 0;
let is [2]i64 as out;
let is i64 as pmods with mut = 0;           // ev_mods() of the last tap's press

fn say(s as *u8) as void { prog.outs(s); }

fn hex(v as i64) as void {
    let is *u8 as hx = "0123456789abcdef";
    let is [18]u8 as b;
    let is i64 as i with mut = 17;
    let is i64 as x with mut = v;
    b[17] = cast(u8, 0);
    if (x < 0) { say("-"); x = 0 - x; }
    if (x == 0) { i = 16; b[16] = cast(u8, 48); }
    while (x > 0 && i > 0) { i = i - 1; b[i] = hx[x & 15]; x = x >> 4; }
    say(cast(*u8, &b[i]));
}

fn check(name as *u8, got as i64, want as i64) as void {
    checks = checks + 1;
    if (got == want) { return; }
    bad = bad + 1;
    say("  FAIL "); say(name); say(": got 0x"); hex(got); say(" want 0x"); hex(want); say("\n");
}

// A key pressed and released; what the press typed. -1 = nothing, -2 = two
// symbols (then out[0], out[1]).
fn tap(sc as i64, ext as i64) as i64 {
    let is i64 as n = km.key(&k, sc, ext, 1, cast(*i64, &out[0]));
    pmods = km.ev_mods(&k);
    let is [2]i64 as junk;
    km.key(&k, sc, ext, 0, cast(*i64, &junk[0]));
    if (n == 0) { return 0 - 1; }
    if (n == 2) { return 0 - 2; }
    return out[0];
}

fn down(sc as i64, ext as i64) as void { km.key(&k, sc, ext, 1, cast(*i64, &out[0])); }
fn up(sc as i64, ext as i64) as void { km.key(&k, sc, ext, 0, cast(*i64, &out[0])); }

fn load(name as *u8) as i64 { return km.load(&k, name, prog.slen(name)); }

// What a terminal sends for (sym, mods), packed big-endian into an i64.
fn tb(sym as i64, mods as i64) as i64 {
    let is [16]u8 as b;
    let is i64 as n = ks.term_bytes(sym, mods, cast(*u8, &b[0]));
    let is i64 as v with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n && i < 7) { v = (v << 8) | cast(i64, b[i]); i = i + 1; }
    return v;
}

fn t_us() as void {
    km.init(&k);
    check("us a", tap(0x1E, 0), 0x61);
    down(0x2A, 0); check("us Shift+a", tap(0x1E, 0), 0x41); check("us Shift+2", tap(0x03, 0), 0x40); up(0x2A, 0);
    check("us `", tap(0x29, 0), 0x60);
    check("us 102nd key", tap(0x56, 0), 0x5C);
    tap(0x3A, 0);                                            // CapsLock on
    check("us CapsLock a", tap(0x1E, 0), 0x41);
    check("us CapsLock 1 is still 1", tap(0x02, 0), 0x31);
    down(0x36, 0); check("us CapsLock+Shift a", tap(0x1E, 0), 0x61); up(0x36, 0);
    tap(0x3A, 0);                                            // CapsLock off
    check("us keypad 7, NumLock on", tap(0x47, 0), 0x37);
    check("us keypad decimal", tap(0x53, 0), 0x2E);
    tap(0x45, 0);                                            // NumLock off
    check("us keypad 7, NumLock off", tap(0x47, 0), ks.KEY_HOME);
    check("us keypad decimal, NumLock off", tap(0x53, 0), ks.KEY_DEL);
    check("us keypad 5, NumLock off", tap(0x4C, 0), 0 - 1);
    tap(0x45, 0);
    check("us locks: NumLock", km.locks(&k), 2);
    check("us Up", tap(0x48, 1), ks.KEY_UP);
    check("us keypad Enter", tap(0x1C, 1), ks.KEY_ENTER);
    check("us keypad /", tap(0x35, 1), 0x2F);
    check("us F1", tap(0x3B, 0), ks.KEY_F1);
    check("us F12", tap(0x58, 0), ks.KEY_F1 + 11);
    check("us Insert", tap(0x52, 1), ks.KEY_INSERT);
    // No AltGr on US: Right Alt is Alt.
    down(0x38, 1); check("us Right Alt+q", tap(0x10, 0), 0x71); check("us Right Alt is Alt", pmods, ks.MOD_ALT); up(0x38, 1);
    down(0x1D, 0); check("us Ctrl+c", tap(0x2E, 0), 0x63); check("us Ctrl mods", pmods, ks.MOD_CTRL); up(0x1D, 0);
    check("us mods after release", km.mods(&k), 0);
    check("us is builtin", km.file_len(&k), 2);
}

fn t_abnt2() as void {
    km.init(&k);
    check("load br-abnt2", load("br-abnt2"), 0);
    check("abnt2 ç", tap(0x27, 0), 0xE7);
    down(0x2A, 0); check("abnt2 Shift+ç", tap(0x27, 0), 0xC7); up(0x2A, 0);
    tap(0x3A, 0); check("abnt2 CapsLock ç", tap(0x27, 0), 0xC7); tap(0x3A, 0);
    check("abnt2 '", tap(0x29, 0), 0x27);
    check("abnt2 ;", tap(0x35, 0), 0x3B);
    check("abnt2 /", tap(0x73, 0), 0x2F);
    check("abnt2 \\", tap(0x56, 0), 0x5C);
    check("abnt2 ]", tap(0x2B, 0), 0x5D);
    // Dead keys.
    check("abnt2 ´ waits", tap(0x1A, 0), 0 - 1);
    check("abnt2 ´ a", tap(0x1E, 0), 0xE1);
    tap(0x1A, 0); check("abnt2 ´ c is ç", tap(0x2E, 0), 0xE7);
    tap(0x1A, 0); down(0x2A, 0); check("abnt2 ´ C is Ç", tap(0x2E, 0), 0xC7); up(0x2A, 0);
    tap(0x1A, 0); check("abnt2 ´ space", tap(0x39, 0), 0xB4);
    tap(0x1A, 0); check("abnt2 ´ ´", tap(0x1A, 0), 0xB4);
    check("abnt2 ´ ´ leaves nothing waiting", tap(0x1E, 0), 0x61);
    tap(0x28, 0); check("abnt2 ~ a", tap(0x1E, 0), 0xE3);
    tap(0x28, 0); check("abnt2 ~ o", tap(0x18, 0), 0xF5);
    tap(0x28, 0); check("abnt2 ~ n", tap(0x31, 0), 0xF1);
    down(0x2A, 0); tap(0x28, 0); up(0x2A, 0); check("abnt2 ^ e", tap(0x12, 0), 0xEA);
    down(0x2A, 0); tap(0x1A, 0); up(0x2A, 0); check("abnt2 ` a", tap(0x1E, 0), 0xE0);
    down(0x2A, 0); tap(0x07, 0); up(0x2A, 0); check("abnt2 ¨ u", tap(0x16, 0), 0xFC);
    tap(0x1A, 0);
    check("abnt2 ´ q types both", tap(0x10, 0), 0 - 2);
    check("abnt2 ´ q: the accent", out[0], 0xB4);
    check("abnt2 ´ q: the q", out[1], 0x71);
    tap(0x1A, 0);
    check("abnt2 ´ then ~", tap(0x28, 0), 0xB4);
    check("abnt2 ~ still waits after ´ ~", tap(0x1E, 0), 0xE3);
    tap(0x1A, 0);
    check("abnt2 Backspace takes the dead key back", tap(0x0E, 0), 0 - 1);
    check("abnt2 nothing waits after Backspace", tap(0x1E, 0), 0x61);
    tap(0x1A, 0);
    check("abnt2 Enter after a dead key", tap(0x1C, 0), ks.KEY_ENTER);
    check("abnt2 the dead key was dropped", tap(0x1E, 0), 0x61);
    tap(0x1A, 0); tap(0x3A, 0);
    check("abnt2 CapsLock keeps the dead key", tap(0x1E, 0), 0xC1);
    tap(0x3A, 0);
    // AltGr.
    down(0x38, 1);
    check("abnt2 AltGr+q", tap(0x10, 0), 0x2F);
    check("abnt2 AltGr is no modifier", pmods, 0);
    check("abnt2 AltGr+w", tap(0x11, 0), 0x3F);
    check("abnt2 AltGr+e", tap(0x12, 0), 0xB0);
    check("abnt2 AltGr+c", tap(0x2E, 0), 0x20A2);
    check("abnt2 AltGr+2", tap(0x03, 0), 0xB2);
    check("abnt2 AltGr+6", tap(0x07, 0), 0xAC);
    check("abnt2 AltGr+=", tap(0x0D, 0), 0xA7);
    check("abnt2 AltGr+/", tap(0x73, 0), 0xB0);
    check("abnt2 AltGr+[", tap(0x1B, 0), 0xAA);
    check("abnt2 AltGr+t, no AltGr symbol", tap(0x14, 0), 0x74);
    down(0x2A, 0); check("abnt2 Shift+AltGr+e", tap(0x12, 0), 0x20AC); up(0x2A, 0);
    up(0x38, 1);
    check("abnt2 AltGr up", km.mods(&k), 0);
    // Ctrl+Left Alt stands in for AltGr on a key that has an AltGr symbol;
    // on one that has none it is the chord it always was.
    down(0x1D, 0); down(0x38, 0);
    check("abnt2 Ctrl+Alt+q", tap(0x10, 0), 0x2F);
    check("abnt2 Ctrl+Alt+q is no chord", pmods, 0);
    check("abnt2 Ctrl+Alt+t", tap(0x14, 0), 0x74);
    check("abnt2 Ctrl+Alt+t is a chord", pmods, ks.MOD_CTRL | ks.MOD_ALT);
    up(0x38, 0); up(0x1D, 0);
    // A dead key in a chord is its accent, and drops a waiting one.
    down(0x1D, 0); check("abnt2 Ctrl+´", tap(0x1A, 0), 0xB4); up(0x1D, 0);
    check("abnt2 nothing waits after Ctrl+´", tap(0x1E, 0), 0x61);
    // The keypad: its decimal key types a comma, the extra key a point.
    check("abnt2 keypad decimal", tap(0x53, 0), 0x2C);
    check("abnt2 keypad point", tap(0x7E, 0), 0x2E);
    check("abnt2 keypad 1", tap(0x4F, 0), 0x31);
    check("abnt2 file name", km.file_len(&k), 8);
    // A layout that is not there leaves the one in use alone.
    check("load nosuch", load("nosuch"), 0 - 1);
    check("load ../etc/x is not a name", load("../x"), 0 - 1);
    check("abnt2 still in use", tap(0x27, 0), 0xE7);
}

fn t_intl() as void {
    km.init(&k);
    check("load us-intl", load("us-intl"), 0);
    tap(0x28, 0); check("intl ' e", tap(0x12, 0), 0xE9);
    tap(0x28, 0); check("intl ' c", tap(0x2E, 0), 0xE7);
    tap(0x28, 0); check("intl ' space", tap(0x39, 0), 0x27);
    down(0x2A, 0); tap(0x28, 0); up(0x2A, 0); check("intl \" u", tap(0x16, 0), 0xFC);
    tap(0x29, 0); check("intl ` a", tap(0x1E, 0), 0xE0);
    down(0x2A, 0); tap(0x29, 0); up(0x2A, 0); check("intl ~ n", tap(0x31, 0), 0xF1);
    down(0x38, 1);
    check("intl AltGr+e", tap(0x12, 0), 0xE9);
    check("intl AltGr+,", tap(0x33, 0), 0xE7);
    check("intl AltGr+5", tap(0x06, 0), 0x20AC);
    check("intl AltGr+\\", tap(0x2B, 0), 0xAC);
    down(0x2A, 0); check("intl Shift+AltGr+\\", tap(0x2B, 0), 0xA6); up(0x2A, 0);
    up(0x38, 1);
    tap(0x3A, 0); down(0x38, 1); check("intl CapsLock AltGr+q", tap(0x10, 0), 0xC4); up(0x38, 1); tap(0x3A, 0);
}

// Maps checked as text: a mistake is refused with its line, and the layout in
// use stays.
fn t_text() as void {
    km.init(&k);
    check("text loads", km.load_text(&k, "name T\n0x10 x X\n", 16, "t", 1), 0);
    check("text key", tap(0x10, 0), 0x78);
    check("text two chars", km.load_text(&k, "0x10 qq\n", 8, "t", 1), 1);
    check("text bad scancode", km.load_text(&k, "\n0xZZ a\n", 8, "t", 1), 2);
    check("text no scancode", km.load_text(&k, "foo\n", 4, "t", 1), 1);
    check("text scancode past 0x7F", km.load_text(&k, "0x80 a\n", 7, "t", 1), 1);
    check("text bad accent", km.load_text(&k, "0x10 dead:x\n", 12, "t", 1), 1);
    check("text compose", km.load_text(&k, "compose a b c\n", 14, "t", 1), 1);
    check("text U+", km.load_text(&k, "0x10 U+00E7\n", 12, "t", 1), 0);
    check("text U+ key", tap(0x10, 0), 0xE7);
    check("text surrogate", km.load_text(&k, "0x10 U+D800\n", 12, "t", 1), 1);
    check("text after a refusal", tap(0x10, 0), 0xE7);
}

fn t_term() as void {
    check("tb a", tb(0x61, 0), 0x61);
    check("tb ç", tb(0xE7, 0), 0xC3A7);
    check("tb €", tb(0x20AC, 0), 0xE282AC);
    check("tb Enter", tb(ks.KEY_ENTER, 0), 0x0A);
    check("tb Backspace", tb(ks.KEY_BACKSPACE, 0), 0x08);
    check("tb Up", tb(ks.KEY_UP, 0), 0x1B5B41);
    check("tb Ctrl+Up", tb(ks.KEY_UP, ks.MOD_CTRL), 0x1B5B313B3541);
    check("tb Home", tb(ks.KEY_HOME, 0), 0x1B5B48);
    check("tb Delete", tb(ks.KEY_DEL, 0), 0x1B5B337E);
    check("tb Shift+PgDn", tb(ks.KEY_PGDN, ks.MOD_SHIFT), 0x1B5B363B327E);
    check("tb F1", tb(ks.KEY_F1, 0), 0x1B5B31317E);
    check("tb F12", tb(ks.KEY_F1 + 11, 0), 0x1B5B32347E);
    check("tb Shift+Tab", tb(ks.KEY_TAB, ks.MOD_SHIFT), 0x1B5B5A);
    check("tb Ctrl+c", tb(0x63, ks.MOD_CTRL), 0x03);
    check("tb Ctrl+[", tb(0x5B, ks.MOD_CTRL), 0x1B);
    check("tb Alt+x", tb(0x78, ks.MOD_ALT), 0x1B78);
    check("tb Alt+ç", tb(0xE7, ks.MOD_ALT), 0x1BC3A7);
}

// Every map the image ships loads.
fn t_shipped() as void {
    let is i64 as fd = sys.open_read("/etc/keymaps");
    if (fd < 0) { check("/etc/keymaps is there", fd, 0); return; }
    let is i64 as n with mut = 0;
    let is [320]u8 as de;
    while (sys.readdir(fd, cast(*u8, &de[0])) == 0) {
        let is *i64 as nlp = cast(*i64, cast(i64, &de[0]) + 256);
        let is i64 as nl = nlp[0];
        if (nl > 4 && de[nl - 4] == cast(u8, 46) && de[nl - 3] == cast(u8, 109)) {
            let is i64 as rc = km.load(&k, cast(*u8, &de[0]), nl - 4);
            if (rc != 0) {
                say("  FAIL "); sys.write(1, cast(*u8, &de[0]), nl); say(": line 0x"); hex(rc);
                say(": "); sys.write(1, km.why_ptr(), km.why_len()); say("\n");
                bad = bad + 1;
            }
            checks = checks + 1;
            n = n + 1;
        }
    }
    sys.close(fd);
    check("maps shipped", n, 7);
}

fn main(argc as i64, argv as *u8) as i32 {
    t_us();
    t_abnt2();
    t_intl();
    t_text();
    t_term();
    t_shipped();
    say("kmapt: "); prog.out_num(checks); say(" checks, "); prog.out_num(bad); say(" failed\n");
    if (bad != 0) { return cast(i32, 1); }
    return cast(i32, 0);
}
