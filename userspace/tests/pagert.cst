// pagert — pager input transitions, including fragmented SGR wheel reports.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../editors/pager.cst" as pager;

let is i64 as checks with mut = 0;
let is i64 as bad with mut = 0;

fn say(s as *u8) as void {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    sys.write_serial(s, n);
}
fn check(ok as i64, label as *u8) as void {
    checks = checks + 1;
    if (ok == 0) { bad = bad + 1; say("pagert: FAIL "); say(label); say("\n"); }
}
fn reset(view as i64) as void {
    pager.g_view = view; pager.g_nlines = 120;
    pager.g_searching = 0; pager.g_tlen = 0; pager.g_quit = 0;
    pager.in_esc = 0; pager.in_np = 0;
    pager.g_rows = 24; pager.g_cols = 80;
}
fn bytes(s as *u8) as void {
    let is i64 as i with mut = 0;
    while (s[i] != 0) { pager.feed(cast(i64, s[i])); i = i + 1; }
}
fn report(s as *u8) as void { pager.feed(0x1B); bytes(s); }

fn main(argc as i64, argv as *u8) as i32 {
    reset(10);
    report("[<65;12;3M"); check(pager.g_view == 13, "wheel down advances three lines");
    report("[<64;12;3M"); check(pager.g_view == 10, "wheel up reverses the scroll");
    reset(0);
    report("[<64;1;1M"); check(pager.g_view == 0, "wheel clamps at the first line");
    reset(118);
    report("[<65;1;1M"); check(pager.g_view == 119, "wheel clamps at the last line");

    reset(20);
    report("[<65;12;3"); check(pager.g_view == 20, "partial report does not scroll early");
    bytes("M"); check(pager.g_view == 23, "final byte completes a fragmented report");
    reset(20);
    report("[<0;12;3M"); report("[<65;12;3m");
    check(pager.g_view == 20, "ordinary clicks and release reports do not scroll");
    bytes("g"); check(pager.g_view == 0, "ordinary input works after mouse reports");

    reset(10); bytes("/q");
    report("[<65;12;3M");
    check(pager.g_view == 13 && pager.g_searching == 1 && pager.g_tlen == 1 && pager.g_term[0] == 113,
          "wheel preserves the active search term");
    bytes("g");
    check(pager.g_view == 13 && pager.g_searching == 1 && pager.g_tlen == 2 && pager.g_term[1] == 103,
          "typing continues in search mode after a wheel report");
    report("[8;40;100t");
    check(pager.g_rows == 40 && pager.g_cols == 100 && pager.g_searching == 1 && pager.g_tlen == 2,
          "size reports do not become search text");

    reset(10);
    report("[A"); check(pager.g_view == 9 && pager.g_quit == 0, "arrow up scrolls without quitting");
    report("[B"); check(pager.g_view == 10 && pager.g_quit == 0, "arrow down scrolls without quitting");

    reset(10); pager.escape_key();
    check(pager.g_quit == 1, "standalone Escape exits the viewer");
    reset(10); bytes("/q"); pager.escape_key();
    check(pager.g_searching == 0 && pager.g_tlen == 0 && pager.g_quit == 0,
          "Escape cancels a pending search without exiting");
    pager.escape_key();
    check(pager.g_quit == 1, "Escape exits after the search has been cancelled");
    prog.outs("pagert: "); prog.out_num(checks); prog.outs(" checks, ");
    prog.out_num(bad); prog.outs(" failed\n");
    if (bad == 0) { say("pagert: PASS\n"); return cast(i32, 0); }
    say("pagert: FAIL\n"); return cast(i32, 1);
}
