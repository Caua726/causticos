// runall — every userspace self-test, in one boot.
//
// The suite used to boot a machine per test. That is the cleanest possible
// isolation and it cost a boot each time: nineteen boots to run about twenty
// seconds of actual testing, and a suite slow enough to skip is a suite that
// is not run before a commit, which is the only moment it is for.
//
// The isolation those separate boots bought is worth naming, because this
// gives some of it up. A self-test that corrupts memory can now take the
// runner down with it and the tests after it never run. That is the honest
// cost, and it is bounded: each test is a separate PROCESS with its own
// address space, so the only shared thing is the kernel — and a test that
// breaks the kernel was going to be reported by verify.sh anyway. What is
// gained is that the whole set finishes in one boot.
//
// Failures stay attributable. Every test prints its own name in its own
// verdict, this prints a line before and after each one, and the exit code of
// each child is reported — so "which test" is never a question, and a test
// that dies without printing anything is visible as a name with no verdict
// rather than as silence.

use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;

// The order matters only in that the cheap ones come first: a broken build
// shows up in a second rather than after the crypto vectors.
let is [11]i64 as names;
let is [11]i64 as nlens;

let is [24]u8 as numbuf;

fn num(v as i64) as *u8 {
    let is i64 as x with mut = v;
    let is i64 as i with mut = 23;
    numbuf[23] = cast(u8, 0);
    if (x == 0) { i = 22; numbuf[22] = cast(u8, 48); }
    while (x > 0 && i > 0) {
        i = i - 1;
        numbuf[i] = cast(u8, 48 + (x % 10));
        x = x / 10;
    }
    return cast(*u8, &numbuf[i]);
}

fn say(m as *u8) as void {
    let is i64 as n with mut = 0;
    while (m[n] != cast(u8, 0)) { n = n + 1; }
    sys.write_serial(m, n);
    return;
}

let is [64]u8 as pathbuf;

// "/<name>.cse", built rather than stored: the list is names, and a name is
// what a person reads in the output.
fn path_of(name as *u8, len as i64) as *u8 {
    pathbuf[0] = cast(u8, 47);                 // '/'
    let is i64 as i with mut = 0;
    while (i < len && i < 48) { pathbuf[1 + i] = name[i]; i = i + 1; }
    pathbuf[1 + i] = cast(u8, 46);             // '.'
    pathbuf[2 + i] = cast(u8, 99);             // 'c'
    pathbuf[3 + i] = cast(u8, 115);            // 's'
    pathbuf[4 + i] = cast(u8, 101);            // 'e'
    pathbuf[5 + i] = cast(u8, 0);
    return cast(*u8, &pathbuf[0]);
}

fn load(path as *u8, out_len as *i64) as i64 {
    out_len[0] = 0;
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { return 0; }
    let is i64 as sz = sys.lseek(fd, 0, cast(i32, sys.SEEK_END));
    sys.lseek(fd, 0, cast(i32, sys.SEEK_SET));
    if (sz <= 0) { sys.close(fd); return 0; }
    let is i64 as alloc = (sz + 4095) & (0 - 4096);
    let is i64 as va = sys.mmap(cast(i64, 0), alloc, sys.PROT_READ | sys.PROT_WRITE);
    if (va < 0) { sys.close(fd); return 0; }
    let is i64 as got = sys.read(fd, cast(*u8, va), sz);
    sys.close(fd);
    if (got != sz) { sys.munmap(va, alloc); return 0; }
    out_len[0] = got;
    return va;
}

fn main(argc as i64, argv as *u8) as i32 {
    names[0]  = cast(i64, "u64t");    nlens[0]  = 4;
    names[1]  = cast(i64, "kabi");    nlens[1]  = 4;
    names[2]  = cast(i64, "nett");    nlens[2]  = 4;
    names[3]  = cast(i64, "tcpt");    nlens[3]  = 4;
    names[4]  = cast(i64, "cryptot"); nlens[4]  = 7;
    names[5]  = cast(i64, "x509t");   nlens[5]  = 5;
    // appt BEFORE the other network tests. It is the one that takes the port
    // away from a running netd and counts what arrives afterwards, so it is
    // the one test here whose subject is the machine's network state — and
    // running it after three tests that have each raised and torn down their
    // own stack means counting frames somebody else's ARP left in flight.
    // Ordering is the honest fix: the test is not wrong, it just has to go
    // first to be measuring what it says it measures.
    names[6]  = cast(i64, "appt");    nlens[6]  = 4;
    names[7]  = cast(i64, "pingt");   nlens[7]  = 5;
    names[8]  = cast(i64, "netdt");   nlens[8]  = 5;
    names[9]  = cast(i64, "httpt");   nlens[9]  = 5;
    names[10] = cast(i64, "tlst");    nlens[10] = 4;

    let is i64 as ran with mut = 0;
    let is i64 as bad with mut = 0;

    let is i64 as i with mut = 0;
    while (i < 11) {
        let is *u8 as nm = cast(*u8, names[i]);
        say("runall: >>> ");
        sys.write_serial(nm, nlens[i]);
        say("\n");

        let is [1]i64 as ilen;
        let is i64 as img = load(path_of(nm, nlens[i]), cast(*i64, &ilen[0]));
        if (img == 0) {
            // Missing is not the same as failing, and saying so keeps a build
            // that dropped a program from reading as a test that broke.
            say("runall: <<< ");
            sys.write_serial(nm, nlens[i]);
            say(" MISSING\n");
        } else {
            let is [2]i64 as av;
            av[0] = names[i]; av[1] = nlens[i];
            let is i64 as pid = sys.spawn(cast(*u8, img), ilen[0],
                                          cast(*u8, 0), 0, cast(*u8, &av[0]), 1);
            sys.munmap(img, (ilen[0] + 4095) & (0 - 4096));
            if (pid < 0) {
                say("runall: <<< ");
                sys.write_serial(nm, nlens[i]);
                say(" SPAWNFAIL\n");
                bad = bad + 1;
            } else {
                let is [1]i64 as code;
                sys.wait(pid, cast(*i64, &code[0]));
                ran = ran + 1;
                say("runall: <<< ");
                sys.write_serial(nm, nlens[i]);
                say(" exit=");
                say(num(code[0]));
                say("\n");
                if (code[0] != 0) { bad = bad + 1; }
            }
        }
        i = i + 1;
    }

    say("runall: ");
    say(num(ran));
    say(" ran, ");
    say(num(bad));
    say(" failed\n");
    // The marker the host waits for. Printed whatever happened, so a run that
    // ends is never mistaken for a machine that hung.
    say("runall: DONE\n");
    return cast(i32, 0);
}
