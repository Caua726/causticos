// globt.cst — lib/glob: what a wildcard pattern matches.
//
// The shell expands patterns with it, ls --ignore and find -name test names
// with it, so its answer is the one a user sees in three places. Covered: the
// three wildcards, sets with ranges, negation, a ']' or '-' as a member and the
// POSIX classes; escapes; code points rather than bytes; FL_PATHNAME,
// FL_PERIOD and FL_CASEFOLD; and patterns that would take exponential time by
// recursion.

use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/glob/glob.cst" as glob;

let is i64 as checks with mut = 0;
let is i64 as bad with mut = 0;

fn say(s as *u8) as void { prog.outs(s); }

fn slen(s as *u8) as i64 { let is i64 as n with mut = 0; while (s[n] != 0) { n = n + 1; } return n; }

// m — pattern p against name s with flags fl must give want.
fn m(p as *u8, s as *u8, fl as i64, want as i64) as void {
    checks = checks + 1;
    let is i64 as got = glob.fnmatch(p, slen(p), s, slen(s), fl);
    if (got == want) { return; }
    bad = bad + 1;
    say("  FAIL '"); say(p); say("' vs '"); say(s); say("'");
    if (want == 1) { say(": should match\n"); } else { say(": should not match\n"); }
    return;
}

fn magic(p as *u8, want as i64) as void {
    checks = checks + 1;
    if (glob.has_magic(p, slen(p), 0) == want) { return; }
    bad = bad + 1;
    say("  FAIL has_magic '"); say(p); say("'\n");
    return;
}

fn main(argc as i64, argv as *u8) as i32 {
    let is i64 as P = glob.FL_PATHNAME;
    let is i64 as D = glob.FL_PERIOD;
    let is i64 as C = glob.FL_CASEFOLD;
    let is i64 as N = glob.FL_NOESCAPE;

    // the wildcards
    m("*.txt", "a.txt", 0, 1);
    m("*.txt", "a.txt.bak", 0, 0);
    m("*.txt", ".txt", 0, 1);
    m("a?c", "abc", 0, 1);
    m("a?c", "ac", 0, 0);
    m("", "", 0, 1);
    m("*", "", 0, 1);
    m("?", "", 0, 0);
    m("abc", "abc", 0, 1);
    m("abc", "abcd", 0, 0);
    m("*a*b", "xaxxb", 0, 1);
    m("*ab", "aab", 0, 1);
    m("a*b*c", "abbbc", 0, 1);
    m("a*b*c", "abbb", 0, 0);
    m("**x", "yyx", 0, 1);

    // code points, not bytes
    m("?", "\xc3\xa7", 0, 1);                       // ç is one character
    m("??", "\xc3\xa7", 0, 0);
    m("a\xc3\xa7?o", "a\xc3\xa7\xc3\xa3o", 0, 1);   // ação
    m("*\xc3\xa3o", "constru\xc3\xa7\xc3\xa3o", 0, 1);
    m("?", "\xe7", 0, 1);                           // a stray byte is a character too
    m("\xc3\xa7", "\xe7", 0, 0);                    // and not U+00E7

    // sets
    m("[abc]x", "bx", 0, 1);
    m("[abc]x", "dx", 0, 0);
    m("[!abc]x", "bx", 0, 0);
    m("[!abc]x", "dx", 0, 1);
    m("[^a]", "b", 0, 1);
    m("[a-z]", "m", 0, 1);
    m("[a-z]", "M", 0, 0);
    m("[]a]", "]", 0, 1);
    m("[!]a]", "]", 0, 0);
    m("[a-]", "-", 0, 1);
    m("[-a]", "-", 0, 1);
    m("[\xc3\xa0-\xc3\xbc]", "\xc3\xa9", 0, 1);      // [à-ü] has é
    m("[[:digit:]]*", "9lives", 0, 1);
    m("[[:digit:]]*", "lives", 0, 0);
    m("[[:alpha:]][[:alnum:]]", "x7", 0, 1);
    m("[[:upper:]]", "\xc3\x87", 0, 1);             // Ç
    m("[[:space:]]", "\t", 0, 1);
    m("[[:xdigit:]][[:xdigit:]]", "fF", 0, 1);
    m("[[:punct:]]", "!", 0, 1);
    m("[ab", "[ab", 0, 1);                          // no ']': an ordinary '['
    m("[ab", "a", 0, 0);

    // escapes
    m("\\*", "*", 0, 1);
    m("\\*", "a", 0, 0);
    m("a\\?", "a?", 0, 1);
    m("[\\]]", "]", 0, 1);
    m("\\*", "\\a", N, 1);                          // with NOESCAPE, '\' is just a character

    // FL_PATHNAME: '/' is not a wildcard's to take
    m("*.c", "dir/a.c", 0, 1);
    m("*.c", "dir/a.c", P, 0);
    m("*/*.c", "dir/a.c", P, 1);
    m("dir?a.c", "dir/a.c", P, 0);
    m("dir[/]a.c", "dir/a.c", P, 0);
    m("dir/a.c", "dir/a.c", P, 1);

    // FL_PERIOD: a leading dot only by a dot
    m("*", ".hidden", D, 0);
    m(".*", ".hidden", D, 1);
    m("?hidden", ".hidden", D, 0);
    m("[.]hidden", ".hidden", D, 0);
    m("a*", "a.b", D, 1);                           // not leading: anything goes
    m("*/*", "a/.b", P | D, 0);
    m("*/.*", "a/.b", P | D, 1);
    m("*", ".hidden", 0, 1);

    // FL_CASEFOLD
    m("*.TXT", "a.txt", C, 1);
    m("*.TXT", "a.txt", 0, 0);
    m("\xc3\x87*", "\xc3\xa7\xc3\xa3o", C, 1);      // Ç* has ção
    m("[A-Z]x", "qx", C, 1);
    m("[[:upper:]]", "q", C, 1);

    // what recursion would make exponential: answered at once
    m("*a*a*a*a*a*a*a*a*a*a*b", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 0, 0);
    m("*a*a*a*a*a*a*a*a*a*a*b", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab", 0, 1);

    magic("a*b", 1);
    magic("a?b", 1);
    magic("[x", 1);
    magic("a\\*b", 0);
    magic("plain", 0);

    prog.outs("globt: "); prog.out_num(checks); prog.outs(" checks, "); prog.out_num(bad); prog.outs(" failed\n");
    sys.write_serial(cast(*u8, "globt: done\n"), 12);
    if (bad == 0) { return cast(i32, 0); }
    return cast(i32, 1);
}
