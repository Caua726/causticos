// ct_text_init.cst — validates every rebuilt text filter with flags, multiple
// files, and edge cases. Booted as /init.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/ctlib/ctlib.cst" as ct;

fn main(argc as i64, argv as *u8) as i32 {
    ct.mkfile("/nums.txt", "3\n1\n2\n10\n2\n");
    ct.mkfile("/words.txt", "banana\napple\ncherry\napple\n");
    ct.mkfile("/sorted.txt", "apple\napple\nbanana\ncherry\n");
    ct.mkfile("/tab.txt", "a\tb\tc\nd\te\tf\n");
    ct.mkfile("/long.txt", "one two three four five six seven eight nine ten\n");
    ct.ser("\n##### TEXT begin #####\n");
    ct.runc("/wc.cse",   "wc -l /nums.txt /words.txt");
    ct.runc("/sort.cse", "sort /words.txt");
    ct.runc("/sort.cse", "sort -n /nums.txt");
    ct.runc("/sort.cse", "sort -nr /nums.txt");
    ct.runc("/sort.cse", "sort -nu /nums.txt");
    ct.runc("/uniq.cse", "uniq -c /sorted.txt");
    ct.runc("/uniq.cse", "uniq -d /sorted.txt");
    ct.runc("/cut.cse",  "cut -f 1,3 /tab.txt");
    ct.runc("/cut.cse",  "cut -c 1-3 /words.txt");
    ct.runc("/fold.cse", "fold -w 20 /long.txt");
    ct.runc("/fold.cse", "fold -sw 20 /long.txt");
    ct.runc("/seq.cse",  "seq -s , 1 5");
    ct.runc("/seq.cse",  "seq -w 8 11");
    ct.runc("/rev.cse",  "rev /words.txt");
    ct.runc("/tac.cse",  "tac /words.txt");
    ct.runc("/cat.cse",  "cat -n /nums.txt");
    ct.runc("/tail.cse", "tail -n 2 /words.txt");
    ct.runc("/hexdump.cse", "hexdump -n 12 /words.txt");
    ct.ser("\n##### TEXT done #####\n");
    while (1 == 1) { sys.sleep_ns(1000000000); }
    return 0;
}
