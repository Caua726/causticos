// ctest_c2_init.cst — exercises the rebuilt text filters with flags + multiple
// files, to validate the getopt foundation. Booted as /init.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/ctlib/ctlib.cst" as ct;

fn main(argc as i64, argv as *u8) as i32 {
    ct.mkfile("/ct.txt", "banana\napple\ncherry\napple\ndate\n");
    ct.mkfile("/ct2.txt", "kiwi\nmango\n");
    ct.ser("\n##### CTEST-C2 begin #####\n");
    ct.runc("/wc.cse",   "wc /ct.txt");
    ct.runc("/wc.cse",   "wc -l /ct.txt");
    ct.runc("/wc.cse",   "wc -lw /ct.txt");
    ct.runc("/wc.cse",   "wc /ct.txt /ct2.txt");
    ct.runc("/head.cse", "head -n 2 /ct.txt");
    ct.runc("/head.cse", "head -c 5 /ct.txt");
    ct.runc("/grep.cse", "grep apple /ct.txt");
    ct.runc("/grep.cse", "grep -n apple /ct.txt");
    ct.runc("/grep.cse", "grep -c apple /ct.txt");
    ct.runc("/grep.cse", "grep -i APPLE /ct.txt");
    ct.runc("/grep.cse", "grep -v apple /ct.txt");
    ct.runc("/grep.cse", "grep apple /ct.txt /ct2.txt");
    ct.ser("\n##### CTEST-C2 done #####\n");
    while (1 == 1) { sys.sleep_ns(1000000000); }
    return 0;
}
