// inflt.cst — runs caustic-compact's inflate in RING 3, on the same image the
// kernel fails to decompress on. One question only: is the decoder wrong, or is
// the kernel's environment wrong? A pass here says the decoder is fine.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "caustic-compact/formats/inflate.cst" as inflate;
use "caustic-compact/core/bytes.cst" as czbytes;

fn main(argc as i64, argv as *u8) as i32 {
    let is i64 as fd = sys.open_read(cast(*u8, "/inflate-test.z"));
    if (fd < 0) { prog.outs("inflt: open failed\n"); return 1; }
    let is i64 as cap = 65536;
    let is i64 as src = sys.mmap(0, cap, 3);
    let is i64 as n = sys.read(fd, cast(*u8, src), cap);
    sys.close(fd);
    prog.outs("inflt: read "); prog.out_num(n); prog.outs(" compressed bytes\n");

    let is i64 as dst = sys.mmap(0, cap, 3);
    let is czbytes.Bytes as out;
    out.ptr = cast(*u8, dst); out.len = 0; out.cap = cap;
    let is i64 as rc = inflate.inflate(cast(*u8, src), n, &out);
    prog.outs("inflt: rc="); prog.out_num(rc);
    prog.outs(" len="); prog.out_num(out.len); prog.outs("\n");
    if (rc == 0 && out.len == 5800) { prog.outs("inflt: PASS\n"); }
    else { prog.outs("inflt: FAIL\n"); }
    return 0;
}
