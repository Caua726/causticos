// regext.cst — lib/regex: what a pattern matches, and where its groups are.
//
// grep, sed, expr and the pager all search with it. Covered: BRE and ERE
// syntax side by side (groups, alternation, the repetitions and intervals,
// where '*' '^' '$' '{' ')' are ordinary characters), leftmost-longest,
// groups that take no part, back-references, sets with classes over UTF-8,
// the GNU escapes and word anchors, case folding, fixed strings, RE_NEWLINE,
// searching from the middle of a subject, the X_* search flags, every error
// compile reports, and patterns that would take exponential time by
// backtracking.

use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/regex/regex.cst" as re;

let is i64 as checks with mut = 0;
let is i64 as bad with mut = 0;

let is i64 as E with imut = 1;      // re.RE_EXTENDED
let is i64 as I with imut = 2;      // re.RE_ICASE
let is i64 as F with imut = 4;      // re.RE_FIXED
let is i64 as N with imut = 8;      // re.RE_NEWLINE
let is i64 as S with imut = 16;     // re.RE_ESCAPES

fn say(s as *u8) as void { prog.outs(s); }

fn slen(s as *u8) as i64 { let is i64 as n with mut = 0; while (s[n] != 0) { n = n + 1; } return n; }

fn put_num(b as *u8, at as i64, v as i64) as i64 {
    let is i64 as i with mut = at;
    let is i64 as x with mut = v;
    if (x < 0) { b[i] = cast(u8, 45); i = i + 1; x = 0 - x; }
    let is [24]u8 as d;
    let is i64 as n with mut = 0;
    if (x == 0) { d[0] = cast(u8, 48); n = 1; }
    while (x > 0) { d[n] = cast(u8, 48 + x % 10); x = x / 10; n = n + 1; }
    while (n > 0) { n = n - 1; b[i] = d[n]; i = i + 1; }
    return i;
}

fn same(a as *u8, b as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (a[i] != 0 && a[i] == b[i]) { i = i + 1; }
    if (a[i] == b[i]) { return 1; }
    return 0;
}

// What search() reported, written as "s,e s,e ..." for the match and each
// group, "-" for no match, "E<n>" for an error.
fn render(rc as i64, m as *i64, ng as i64, out as *u8) as void {
    let is i64 as i with mut = 0;
    if (rc < 0) { out[0] = cast(u8, 69); i = put_num(out, 1, 0 - rc); out[i] = cast(u8, 0); return; }
    if (rc == 0) { out[0] = cast(u8, 45); out[1] = cast(u8, 0); return; }
    let is i64 as k with mut = 0;
    while (k <= ng) {
        if (k > 0) { out[i] = cast(u8, 32); i = i + 1; }
        i = put_num(out, i, m[k * 2]);
        out[i] = cast(u8, 44); i = i + 1;
        i = put_num(out, i, m[k * 2 + 1]);
        k = k + 1;
    }
    out[i] = cast(u8, 0);
}

fn fail_line(fl as i64, p as *u8, s as *u8, got as *u8, want as *u8) as void {
    bad = bad + 1;
    say("  FAIL /"); say(p); say("/ fl="); prog.out_num(fl); say(" on '"); say(s);
    say("': got "); say(got); say(", want "); say(want); say("\n");
}

// pattern p (flags fl) searched in s from `start` with search flags xf must
// report want.
fn tx(fl as i64, p as *u8, s as *u8, start as i64, xf as i64, want as *u8) as void {
    checks = checks + 1;
    let is re.Regex as r;
    let is [256]u8 as got;
    let is i64 as rc = re.compile(&r, p, slen(p), fl);
    if (rc != 0) {
        render(rc, cast(*i64, 0), 0, cast(*u8, &got[0]));
        fail_line(fl, p, s, cast(*u8, &got[0]), want);
        return;
    }
    let is [40]i64 as m;
    let is i64 as ng = re.groups(&r);
    let is i64 as found = re.search(&r, s, slen(s), start, xf, cast(*i64, &m[0]), ng + 1);
    render(found, cast(*i64, &m[0]), ng, cast(*u8, &got[0]));
    if (same(cast(*u8, &got[0]), want) == 0) { fail_line(fl, p, s, cast(*u8, &got[0]), want); }
    re.release(&r);
}

fn t(fl as i64, p as *u8, s as *u8, want as *u8) as void { tx(fl, p, s, 0, 0, want); }

// p must not compile, with error e.
fn err(fl as i64, p as *u8, e as i64) as void {
    checks = checks + 1;
    let is re.Regex as r;
    let is i64 as rc = re.compile(&r, p, slen(p), fl);
    if (rc == 0 - e) { return; }
    bad = bad + 1;
    say("  FAIL /"); say(p); say("/ should not compile: error "); prog.out_num(e);
    say(" ("); say(re.err_text(0 - e)); say("), got "); prog.out_num(rc); say("\n");
    if (rc == 0) { re.release(&r); }
}

// n copies of c, then tail.
fn rep(buf as *u8, c as i64, n as i64, tail as *u8) as *u8 {
    let is i64 as i with mut = 0;
    while (i < n) { buf[i] = cast(u8, c); i = i + 1; }
    let is i64 as k with mut = 0;
    while (tail[k] != 0) { buf[i] = tail[k]; i = i + 1; k = k + 1; }
    buf[i] = cast(u8, 0);
    return buf;
}

fn main(argc as i64, argv as *u8) as i32 {
    // ---- BRE ----
    t(0, "abc", "xabcy", "1,4");
    t(0, "a.c", "abc", "0,3");
    t(0, "a*", "baaa", "0,0");                      // leftmost first, then longest
    t(0, "a*", "aaab", "0,3");
    t(0, "^a", "ba", "-");
    t(0, "a$", "ba", "1,2");
    t(0, "\\(ab\\)*c", "ababc", "0,5 2,4");
    t(0, "\\(a\\)\\(b\\)", "ab", "0,2 0,1 1,2");
    t(0, "a\\{2\\}", "aaa", "0,2");
    t(0, "a\\{2,\\}", "aaaa", "0,4");
    t(0, "a\\{,2\\}", "aaaa", "0,2");
    t(0, "a\\{1,2\\}b", "aaab", "1,4");
    t(0, "a\\+", "baa", "1,3");
    t(0, "a\\?b", "ab", "0,2");
    t(0, "a\\|b", "xb", "1,2");
    t(0, "a|b", "a|b", "0,3");                      // ERE operators are characters in a BRE
    t(0, "a+", "aa+", "1,3");
    t(0, "a{2}", "a{2}", "0,4");
    t(0, "(a)", "(a)", "0,3");
    t(0, "*a", "*a", "0,2");                        // '*' with nothing before it
    t(0, "\\(*a\\)", "*a", "0,2 0,2");
    t(0, "^*", "*", "0,1");
    t(0, "a\\|*b", "*b", "0,2");
    t(0, "a^b", "a^b", "0,3");                      // '^' not first, '$' not last
    t(0, "a$b", "a$b", "0,3");
    t(0, "x\\(a$\\)", "xa", "0,2 1,2");
    t(0, "\\(^a\\)", "a", "0,1 0,1");
    t(0, "a\\|^b", "b", "0,1");
    t(0, "\\+", "+", "0,1");

    // ---- ERE ----
    t(E, "a|b", "xb", "1,2");
    t(E, "(a)(b)?", "ac", "0,1 0,1 -1,-1");         // a group that took no part
    t(E, "(a|ab)(c|bcd)", "abcd", "0,4 0,1 1,4");
    t(E, "(x|xy)(z|yz)", "xyz", "0,3 0,1 1,3");     // the documented departure from POSIX
    t(E, "a{2,3}", "aaaa", "0,3");
    t(E, "a{,2}", "aaa", "0,2");
    t(E, "a{", "a{", "0,2");                        // no interval: an ordinary '{'
    t(E, "a{1", "a{1", "0,3");
    t(E, "a{x}", "a{x}", "0,4");
    t(E, "a)", "a)", "0,2");                        // no '(': an ordinary ')'
    t(E, "*a", "*a", "0,2");
    t(E, "()", "x", "0,0 0,0");
    t(E, "(a*)+", "b", "0,0 0,0");
    t(E, "^$", "", "0,0");
    t(E, "x*", "", "0,0");
    t(E, "$", "abc", "3,3");
    t(E, "a|ab|abc", "abcd", "0,3");                // longest of the leftmost
    t(E, "xy*|x", "xyy", "0,3");
    t(E, "abcd|c", "abcd", "0,4");                  // leftmost, though c matched first
    t(E, "bc|abcd", "abcd", "0,4");
    t(E, "(a|b)*c", "abac", "0,4 2,3");
    t(E, "((a)|b)+", "ab", "0,2 1,2 0,1");
    t(E, "a\\|b", "a|b", "0,3");                    // \| is a character in an ERE
    t(E, "\\(a\\)", "(a)", "0,3");

    // ---- back-references ----
    t(0, "\\(a\\)\\1", "aa", "0,2 0,1");
    t(0, "\\(a*\\)\\1", "aaaa", "0,4 0,2");
    t(0, "\\(a\\|b\\)*\\1", "abb", "0,3 1,2");
    t(0, "\\(.\\)\\1", "abccd", "2,4 2,3");
    t(E, "(.)(.)\\2\\1", "xabba", "1,5 1,2 2,3");
    t(I, "\\(a\\)\\1", "aA", "0,2 0,1");
    t(0, "\\(a\\)\\1", "aA", "-");
    t(E, "(a)|b\\1", "b", "-");                     // \1 of a group that took no part
    t(0, "^\\(.*\\)\\1$", "abcabc", "0,6 0,3");
    t(0, "\\(a*\\)*\\1", "b", "0,0 0,0");

    // ---- sets, classes, characters ----
    t(E, "\\bfoo\\b", "a foo b", "2,5");
    t(E, "\\bfoo\\b", "afoo", "-");
    t(E, "\\<f", "of fo", "3,4");
    t(E, "o\\>", "of fo", "4,5");
    t(E, "\\Bo", "of fo", "4,5");
    t(E, "\\w+", "  h\xc3\xa9llo!", "2,8");
    t(E, "\\W", "ab!", "2,3");
    t(E, "\\s+", "a \t b", "1,4");
    t(E, "\\S+", "  ab ", "2,4");
    t(E, "\\d+", "ab123", "2,5");
    t(E, "\\D", "12x", "2,3");
    t(E, "[[:alpha:]]+", "12\xc3\xa7\xc3\xa3oX9", "2,8");
    t(E, "[[:upper:]]", "a\xc3\x87", "1,3");
    t(E, "[[:lower:]]+", "AbcD", "1,3");
    t(E, "[[:digit:]]+", "a42", "1,3");
    t(E, "[[:space:]]", "a\tb", "1,2");
    t(E, "[[:blank:]]", "a\tb", "1,2");
    t(E, "[[:punct:]]", "ab,", "2,3");
    t(E, "[[:xdigit:]]+", "xFfz", "1,3");
    t(E, "[[:alnum:]_]+", "-a_1-", "1,4");
    t(E, "[[:cntrl:]]", "a\x01", "1,2");
    t(E, "[[:print:]]+", "\x01ab\x02", "1,3");
    t(E, "[[:graph:]]+", " ab ", "1,3");
    t(E, "[^a]", "aab", "2,3");
    t(E, "[]a]+", "]a]", "0,3");
    t(E, "[^]a]", "]ab", "2,3");
    t(E, "[a-]+", "-a-", "0,3");
    t(E, "[-a]", "-", "0,1");
    t(E, "[\xc3\xa0-\xc3\xbc]", "\xc3\xa9", "0,2");   // [à-ü] has é
    t(E, ".", "\xc3\xa7", "0,2");                     // ç is one character
    t(E, "..", "\xc3\xa7", "-");
    t(E, "[[=a=]]", "a", "0,1");
    t(E, "[[.-.]]", "-", "0,1");
    t(E, "[\\n]", "n", "0,1");                        // a backslash is a member of a set
    t(E, "[\\n]", "\\", "0,1");
    t(E | S, "x[\\n]", "x\n", "0,2");                 // unless RE_ESCAPES (sed)
    t(E, ".", "\xff", "0,1");                         // a stray byte is a character
    t(E, "\\xff", "\xff", "0,1");
    t(E, "\\xc3\\xa7", "\xc3\xa7", "0,2");            // \x bytes that spell ç are ç
    t(E, "\\x41", "A", "0,1");
    t(E, "\\n", "a\nb", "1,2");
    t(E, "\\t", "a\tb", "1,2");
    t(E, "\\.", "a.", "1,2");

    // ---- case ----
    t(E | I, "\xc3\x87\xc3\x83O", "a\xc3\xa7\xc3\xa3o", "1,6");   // ÇÃO in ação
    t(E | I, "[A-Z]+", "abc", "0,3");
    t(E | I, "[[:upper:]]", "q", "0,1");
    t(E | I, "x", "X", "0,1");
    t(E | I, "\xd0\x96", "\xd0\xb6", "0,2");          // Ж ж
    t(E | I, "[^a]", "A", "-");

    // ---- fixed strings, newlines ----
    t(F, "a.b*", "xa.b*", "1,5");
    t(F, "a.b", "axb", "-");
    t(F | I, "A.B", "a.b", "0,3");
    t(E | N, "^b", "a\nb", "2,3");
    t(E, "^b", "a\nb", "-");
    t(E | N, "a$", "a\nb", "0,1");
    t(E | N, "\\`b", "a\nb", "-");                    // \` is the subject's start, always
    t(E | N, "b\\'", "b\na", "-");

    // ---- from the middle, and the search flags ----
    tx(E, "^a", "aXa", 1, 0, "-");                    // ^ only at the subject's start
    tx(E, "a", "aXa", 1, 0, "2,3");
    tx(E, "\\bX", "aXa", 1, 0, "-");                  // \b sees the character before start
    tx(E, "^a", "a", 0, re.X_NOTBOL, "-");
    tx(E, "a$", "a", 0, re.X_NOTEOL, "-");
    tx(E, "b", "ab", 0, re.X_ANCHOR, "-");
    tx(E, "b", "ab", 1, re.X_ANCHOR, "1,2");
    tx(E, "a|ab", "ab", 0, re.X_FULL, "0,2");
    tx(E, "a", "ab", 0, re.X_ANCHOR | re.X_FULL, "-");
    tx(E, "foo", "foobar foo", 0, re.X_WORDS, "7,10");
    tx(E, "foo", "a_foo", 0, re.X_WORDS, "-");
    tx(E, "fo*", "fooo fo", 0, re.X_WORDS, "0,4");
    tx(E, "ab|abc", "abcd abc", 0, re.X_WORDS, "5,8");
    tx(0, "\\(a\\)\\1", "aab aa", 0, re.X_WORDS, "4,6 4,5");

    // ---- errors ----
    err(0, "\\(a", re.RE_EPAREN);
    err(0, "a\\)", re.RE_ERPAREN);
    err(E, "(a", re.RE_EPAREN);
    err(E, "[a", re.RE_EBRACK);
    err(E, "[[:alpha:]", re.RE_EBRACK);
    err(E, "[[:foo:]]", re.RE_ECTYPE);
    err(0, "a\\{1", re.RE_EBRACE);
    err(0, "a\\{2,1\\}", re.RE_EBADBR);
    err(E, "a{2,1}", re.RE_EBADBR);
    err(0, "a\\{x\\}", re.RE_EBRACE);
    err(E, "[z-a]", re.RE_ERANGE);
    err(0, "\\1", re.RE_ESUBREG);
    err(0, "\\(a\\)\\2", re.RE_ESUBREG);
    err(0, "\\(a\\1\\)", re.RE_ESUBREG);              // a group may not refer to itself
    err(0, "\\{1\\}", re.RE_EBADRPT);
    err(0, "a\\", re.RE_EESCAPE);
    err(E, "a{40000}", re.RE_ESIZE);
    err(E, "(a{1000}){1000}", re.RE_ESIZE);

    // ---- what backtracking would take exponential time on ----
    let is [8192]u8 as big;
    t(E, "(a*)*b", rep(cast(*u8, &big[0]), 97, 5000, ""), "-");
    t(E, "(a|aa)*c", rep(cast(*u8, &big[0]), 97, 5000, ""), "-");
    t(E, "(x+x+)+y", rep(cast(*u8, &big[0]), 120, 3000, ""), "-");
    t(E, "a*a*a*a*a*b", rep(cast(*u8, &big[0]), 97, 3000, "b"), "0,3001");
    // with a back-reference it has to backtrack; it must stop, not hang
    checks = checks + 1;
    let is re.Regex as rb;
    let is [4]i64 as mb;
    re.compile(&rb, "\\(\\(a*\\)*\\)*\\1x", 22, 0);
    let is i64 as brc = re.search(&rb, rep(cast(*u8, &big[0]), 97, 40, ""), 40, 0, 0, cast(*i64, &mb[0]), 1);
    if (brc != 0 && brc != 0 - re.RE_ECOMPLEX) {
        bad = bad + 1;
        say("  FAIL runaway back-reference search returned "); prog.out_num(brc); say("\n");
    }
    re.release(&rb);

    prog.outs("regext: "); prog.out_num(checks); prog.outs(" checks, "); prog.out_num(bad); prog.outs(" failed\n");
    sys.write_serial(cast(*u8, "regext: done\n"), 13);
    if (bad == 0) { return cast(i32, 0); }
    return cast(i32, 1);
}
