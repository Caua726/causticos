// tzt.cst — lib/tz: what an instant is on each zone's wall clock.
//
// /tzt/cases holds instants with the answers CPython's zoneinfo gives for the
// same compiled files the image ships (scripts/gen-tzt.py): every zone name in
// both halves of 2026, every distinct file from 1900 to 2100, and every
// transition from 1970 to 2045, one second either side, for the zones whose
// rules use the format's corners. Each is converted and compared field by
// field — offset, daylight flag, abbreviation and the calendar.
//
// Then what must NOT load: names that would leave /etc/zoneinfo, files that
// are not zones, and POSIX rules that are malformed or say too little. A zone
// that fails to load must leave the one in use as it was. Last, the choice: a
// name in /var/timezone wins over /etc/timezone, and changing it moves the
// stamp the desktop watches.

use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;
use "../lib/tz/tz.cst" as tz;

let is tz.Zone as z with mut;
let is tz.Local as L with mut;
let is i64 as checks with mut = 0;
let is i64 as bad with mut = 0;
let is i64 as shown with mut = 0;

fn say(s as *u8) as void { prog.outs(s); }

fn snum(v as i64) as void {
    if (v < 0) { say("-"); prog.out_num(0 - v); return; }
    prog.out_num(v);
}

// Counts a failure; 1 when it is still worth printing (the first 40).
fn fail_head() as i64 {
    bad = bad + 1;
    shown = shown + 1;
    if (shown > 40) { return 0; }
    say("  FAIL ");
    return 1;
}

fn check(name as *u8, got as i64, want as i64) as void {
    checks = checks + 1;
    if (got == want) { return; }
    if (fail_head() == 0) { return; }
    say(name); say(": got "); snum(got); say(" want "); snum(want); say("\n");
}

fn same(a as *u8, an as i64, b as *u8, bn as i64) as i64 {
    if (an != bn) { return 0; }
    let is i64 as i with mut = 0;
    while (i < an) { if (a[i] != b[i]) { return 0; } i = i + 1; }
    return 1;
}

fn check_abbr(name as *u8, want as *u8) as void {
    checks = checks + 1;
    if (same(cast(*u8, &L.abbr[0]), L.abbr_len, want, prog.slen(want)) == 1) { return; }
    if (fail_head() == 0) { return; }
    say(name); say(": abbreviation "); prog.out(cast(*u8, &L.abbr[0]), L.abbr_len);
    say(" want "); say(want); say("\n");
}

// ---- the cases --------------------------------------------------------------

let is [16]i64 as ts;          // token starts
let is [16]i64 as tl;          // token lengths
let is [64]u8 as cur;          // the zone loaded for the lines that follow
let is i64 as cur_len with mut = 0;
let is i64 as cur_ok with mut = 0;
let is i64 as want_lines with mut = 0 - 1;

fn tok_int(p as *u8, k as i64) as i64 {
    let is i64 as i with mut = ts[k];
    let is i64 as e = ts[k] + tl[k];
    let is i64 as neg with mut = 0;
    if (p[i] == cast(u8, 45)) { neg = 1; i = i + 1; }
    let is i64 as v with mut = 0;
    while (i < e) { v = v * 10 + (cast(i64, p[i]) & 0xFF) - 48; i = i + 1; }
    if (neg == 1) { return 0 - v; }
    return v;
}

fn one_case(p as *u8, n as i64) as void {
    let is i64 as nt with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n && nt < 16) {
        while (i < n && p[i] == cast(u8, 32)) { i = i + 1; }
        if (i >= n) { break; }
        ts[nt] = i;
        while (i < n && p[i] != cast(u8, 32)) { i = i + 1; }
        tl[nt] = i - ts[nt];
        nt = nt + 1;
    }
    if (nt == 0) { return; }
    // "END <count>": the generator's own count, so a file cut short by the
    // image builder is a failure rather than fewer passing lines.
    if (nt == 2 && same(cast(*u8, cast(i64, p) + ts[0]), tl[0], "END", 3) == 1) {
        want_lines = tok_int(p, 1);
        return;
    }
    if (nt != 13) {
        checks = checks + 1;
        if (fail_head() == 1) { say("a case line does not have 13 fields: "); prog.out(p, n); say("\n"); }
        return;
    }
    let is *u8 as name = cast(*u8, cast(i64, p) + ts[0]);
    if (same(name, tl[0], cast(*u8, &cur[0]), cur_len) == 0) {
        let is i64 as k with mut = 0;
        while (k < tl[0] && k < 63) { cur[k] = name[k]; k = k + 1; }
        cur_len = k;
        checks = checks + 1;
        cur_ok = 1;
        if (tz.load(&z, name, tl[0]) != 0) {
            cur_ok = 0;
            if (fail_head() == 1) {
                say("zone "); prog.out(name, tl[0]); say(" does not load: ");
                prog.out(tz.why_ptr(), tz.why_len()); say("\n");
            }
        }
    }
    if (cur_ok == 0) { return; }
    tz.at(&z, tok_int(p, 1), &L);
    checks = checks + 1;
    let is *u8 as ab = cast(*u8, cast(i64, p) + ts[12]);
    if (L.year == tok_int(p, 2) && L.month == tok_int(p, 3) && L.day == tok_int(p, 4)
        && L.hour == tok_int(p, 5) && L.min == tok_int(p, 6) && L.sec == tok_int(p, 7)
        && L.wday == tok_int(p, 8) && L.yday == tok_int(p, 9) && L.utoff == tok_int(p, 10)
        && L.isdst == tok_int(p, 11) && same(cast(*u8, &L.abbr[0]), L.abbr_len, ab, tl[12]) == 1) {
        return;
    }
    if (fail_head() == 0) { return; }
    prog.out(p, n); say("\n         got ");
    snum(L.year); say(" "); snum(L.month); say(" "); snum(L.day); say(" ");
    snum(L.hour); say(" "); snum(L.min); say(" "); snum(L.sec); say(" ");
    snum(L.wday); say(" "); snum(L.yday); say(" "); snum(L.utoff); say(" ");
    snum(L.isdst); say(" "); prog.out(cast(*u8, &L.abbr[0]), L.abbr_len); say("\n");
}

fn t_cases() as void {
    let is fu.Reader as r;
    let is [8192]u8 as staging;
    let is fu.Line as ln;
    ln.va = 0; ln.cap = 0; ln.len = 0;
    if (fu.rd_open(&r, "/tzt/cases", cast(*u8, &staging[0]), 8192) < 0) {
        checks = checks + 1;
        if (fail_head() == 1) { say("/tzt/cases is missing\n"); }
        return;
    }
    let is i64 as lines with mut = 0;
    while (1 == 1) {
        let is i64 as got = fu.rd_line(&r, &ln);
        if (got < 0) {
            checks = checks + 1;
            if (fail_head() == 1) { say("reading /tzt/cases failed\n"); }
            break;
        }
        if (got == 0) { break; }
        one_case(cast(*u8, ln.va), ln.len);
        lines = lines + 1;
    }
    fu.rd_close(&r);
    fu.line_free(&ln);
    say("tzt: "); prog.out_num(lines - 1); say(" instants converted\n");
    let is i64 as ended with mut = 0;
    if (want_lines >= 0) { ended = 1; }
    check("the END line was read", ended, 1);
    check("every case was read", lines - 1, want_lines);
}

// ---- names and files that must not load -------------------------------------

fn valid(s as *u8) as i64 { return tz.valid_name(s, prog.slen(s)); }

fn t_names() as void {
    check("Area/City", valid("America/Sao_Paulo"), 1);
    check("three levels", valid("America/Argentina/Buenos_Aires"), 1);
    check("a sign", valid("Etc/GMT+3"), 1);
    check("one word", valid("UTC"), 1);
    check("parent", valid("../etc/passwd"), 0);
    check("a dot", valid("Europe/../UTC"), 0);
    check("absolute", valid("/etc/passwd"), 0);
    check("empty component", valid("America//Sao_Paulo"), 0);
    check("trailing slash", valid("America/"), 0);
    check("empty", tz.valid_name("", 0), 0);
    check("a space", valid("America/Sao Paulo"), 0);
    check("64 bytes", valid("Aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), 0);
}

// A whole TZif file with one type (UTC) and no transitions, ending in footer f:
// the shape every rule case below needs.
let is [256]u8 as img;

fn be32(o as i64, v as i64) as void {
    img[o] = cast(u8, (v >> 24) & 0xFF); img[o + 1] = cast(u8, (v >> 16) & 0xFF);
    img[o + 2] = cast(u8, (v >> 8) & 0xFF); img[o + 3] = cast(u8, v & 0xFF);
}

// A header and its data block at o: 44 + 6 + 4 bytes.
fn header(o as i64) as void {
    let is i64 as i with mut = 0;
    while (i < 50) { img[o + i] = cast(u8, 0); i = i + 1; }
    img[o] = cast(u8, 84); img[o + 1] = cast(u8, 90); img[o + 2] = cast(u8, 105); img[o + 3] = cast(u8, 102);
    img[o + 4] = cast(u8, 50);
    be32(o + 36, 1);                               // one type: offset 0, standard, abbreviation 0
    be32(o + 40, 4);                               // "UTC\0"
    img[o + 50] = cast(u8, 85); img[o + 51] = cast(u8, 84); img[o + 52] = cast(u8, 67); img[o + 53] = cast(u8, 0);
}

fn image(f as *u8) as i64 {
    header(0);
    header(54);
    let is i64 as o with mut = 108;
    img[o] = cast(u8, 10); o = o + 1;
    let is i64 as i with mut = 0;
    while (f[i] != cast(u8, 0)) { img[o] = f[i]; o = o + 1; i = i + 1; }
    img[o] = cast(u8, 10);
    return o + 1;
}

fn rule_loads(f as *u8) as i64 {
    let is i64 as n = image(f);
    return tz.load_image(&z, "Test", 4, cast(*u8, &img[0]), n);
}

fn t_bad() as void {
    // The zone in use before every failure below, and after it.
    check("Sao_Paulo loads", tz.load(&z, "America/Sao_Paulo", 17), 0);
    check("not a zone file", tz.load(&z, "+VERSION", 8), 0 - 1);
    check("no such zone", tz.load(&z, "Nowhere/City", 12), 0 - 1);
    check("a name outside", tz.load(&z, "../ca.pem", 9), 0 - 1);
    check("the zone in use is untouched", same(tz.name_ptr(&z), tz.name_len(&z), "America/Sao_Paulo", 17), 1);
    tz.at(&z, 1768478400, &L);
    check("and still converts", L.utoff, 0 - 10800);

    check("daylight time with no rule", rule_loads("EST5EDT"), 0 - 1);
    check("no offset", rule_loads("XYZ"), 0 - 1);
    check("a two-letter name", rule_loads("<-0>3"), 0 - 1);
    check("month 13", rule_loads("EST5EDT,M13.1.0,M11.1.0"), 0 - 1);
    check("one switch", rule_loads("EST5EDT,M3.2.0"), 0 - 1);
    check("trailing text", rule_loads("EST5EDT,M3.2.0,M11.1.0x"), 0 - 1);
    check("more than a day from UTC", rule_loads("EST25"), 0 - 1);
    let is i64 as n = image("<-03>3");
    check("a cut-off footer", tz.load_image(&z, "Test", 4, cast(*u8, &img[0]), n - 1), 0 - 1);
    check("a cut-off header", tz.load_image(&z, "Test", 4, cast(*u8, &img[0]), 40), 0 - 1);
    check("still Sao_Paulo after all of them", same(tz.name_ptr(&z), tz.name_len(&z), "America/Sao_Paulo", 17), 1);
    check("the image itself loads", tz.load_image(&z, "Test", 4, cast(*u8, &img[0]), n), 0);
    tz.at(&z, 1768478400, &L);
    check("<-03>3 offset", L.utoff, 0 - 10800);
    check_abbr("<-03>3", "-03");

    // The rule forms tzdata does not use today, but a TZ string may.
    check("Jn loads", rule_loads("AAA3BBB,J60,J300"), 0);
    tz.at(&z, 1709208000, &L);                    // 2024-02-29 12:00Z: J60 is March 1
    check("J60 skips February 29", L.utoff, 0 - 10800);
    check_abbr("J60 std", "AAA");
    tz.at(&z, 1740805199, &L);                    // 2025-03-01 04:59:59Z
    check("J60 a second before", L.utoff, 0 - 10800);
    tz.at(&z, 1740805200, &L);
    check("J60 at 02:00 local", L.utoff, 0 - 7200);
    check_abbr("J60 dst", "BBB");
    check("n loads", rule_loads("AAA3BBB,59,299"), 0);
    tz.at(&z, 1709182799, &L);                    // 2024-02-29 04:59:59Z: n=59 is Feb 29
    check("n a second before", L.utoff, 0 - 10800);
    tz.at(&z, 1709182800, &L);
    check("n counts February 29", L.utoff, 0 - 7200);
    // Negative daylight saving: winter is the daylight time.
    check("negative DST loads", rule_loads("IST-1GMT0,M10.5.0,M3.5.0/1"), 0);
    tz.at(&z, 1768478400, &L);
    check("winter offset", L.utoff, 0);
    check("winter is daylight time", L.isdst, 1);
    check_abbr("winter", "GMT");
    tz.at(&z, 1784116800, &L);
    check("summer offset", L.utoff, 3600);
    check("summer is standard time", L.isdst, 0);
    check_abbr("summer", "IST");
}

// ---- the choice -------------------------------------------------------------

fn put(path as *u8, text as *u8) as i64 {
    let is i64 as fd = sys.open_write(path);
    if (fd < 0) { return fd; }
    let is i64 as n = prog.slen(text);
    let is i64 as w = sys.write(fd, text, n);
    sys.close(fd);
    if (w != n) { return 0 - 1; }
    return 0;
}

fn t_choice() as void {
    let is [64]u8 as nm;
    let is [1]i64 as src;
    sys.unlink("/var/timezone");
    let is i64 as n0 = tz.chosen_src(cast(*u8, &nm[0]), cast(*i64, &src[0]));
    check("the image's default is /etc/timezone", src[0], 2);
    check("which says UTC", same(cast(*u8, &nm[0]), n0, "UTC", 3), 1);
    let is i64 as st0 = tz.config_stamp();
    sys.mkdir("/var");
    check("write /var/timezone", put("/var/timezone", "  Asia/Tokyo  \n"), 0);
    let is i64 as n1 = tz.chosen_src(cast(*u8, &nm[0]), cast(*i64, &src[0]));
    check("/var/timezone wins", src[0], 1);
    check("its name, trimmed", same(cast(*u8, &nm[0]), n1, "Asia/Tokyo", 10), 1);
    let is i64 as moved with mut = 0;
    if (tz.config_stamp() != st0) { moved = 1; }
    check("the stamp moves", moved, 1);
    check("the chosen zone loads", tz.load_chosen(&z), 0);
    tz.at(&z, 1768478400, &L);
    check("Tokyo is UTC+9", L.utoff, 32400);
    check_abbr("Tokyo", "JST");
    check("a broken choice", put("/var/timezone", "Nowhere/City\n"), 0);
    check("does not load", tz.load_chosen(&z), 0 - 1);
    check("and leaves Tokyo in use", same(tz.name_ptr(&z), tz.name_len(&z), "Asia/Tokyo", 10), 1);
    sys.unlink("/var/timezone");
    check("the stamp comes back", tz.config_stamp(), st0);
}

fn main(argc as i64, argv as *u8) as i32 {
    tz.init(&z);
    tz.at(&z, 0, &L);
    check("built-in UTC epoch year", L.year, 1970);
    check_abbr("built-in UTC", "UTC");
    t_names();
    t_bad();
    t_choice();
    t_cases();
    say("tzt: "); prog.out_num(checks); say(" checks, "); prog.out_num(bad); say(" failed\n");
    if (bad != 0) { return cast(i32, 1); }
    say("tzt: ALL PASS\n");
    return cast(i32, 0);
}
