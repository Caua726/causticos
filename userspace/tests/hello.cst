// hello — the smallest CausticOS program, used to prove the split toolchain:
//   caustic -S hello.cst       (or -c)  -> hello.cst.s   (assembly)
//   caustic-as hello.cst.s               -> hello.cst.s.o (object)
//   caustic-ld --target=caustic-x86_64 hello.cst.s.o -o hello.cse  (executable)
// The one-shot `caustic hello.cst -o hello.cse` does all three in-process; the
// staged path must agree byte for byte.
use "../../../Caustic/std/causticos/prog.cst" as prog;

fn main(argc as i64, argv as *u8) as i32 {
    prog.outs("hello from the split toolchain!\n");
    return 0;
}
