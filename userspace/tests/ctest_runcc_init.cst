// ctest_runcc_init.cst — proves `run` and `cc` (the compiler front-ends) work
// ON CausticOS. Booted as /init, it spawns run.cse and cc.cse, giving each a
// stdout channel (so the embedded compiler's messages + the program's output
// have somewhere to go) and echoing that channel to serial.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;

fn ser(s as *u8) as void { sys.write_serial(s, prog.slen(s)); }
fn page_round(n as i64) as i64 { return (n + 4095) / 4096 * 4096; }

fn load(path as *u8, out_len as *i64) as i64 {
    let is [4]i64 as st;
    if (sys.stat(path, cast(*u8, &st[0])) != 0) { out_len[0] = 0; return 0; }
    let is i64 as size = st[0];
    if (size <= 0) { out_len[0] = 0; return 0; }
    let is i64 as mapped = page_round(size);
    let is i64 as va = sys.mmap(0, mapped, sys.PROT_READ | sys.PROT_WRITE);
    if (va < 0) { out_len[0] = 0; return 0; }
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { out_len[0] = 0; return 0; }
    let is i64 as got with mut = 0;
    while (got < size) {
        let is i64 as r = sys.read(fd, cast(*u8, va + got), size - got);
        if (r <= 0) { break; }
        got = got + r;
    }
    sys.close(fd);
    out_len[0] = got;
    return va;
}

fn probe(path as *u8) as void {
    let is [4]i64 as st;
    ser("  -> "); ser(path);
    if (sys.stat(path, cast(*u8, &st[0])) == 0) { ser(" exists\n"); } else { ser(" MISSING\n"); }
}

// run a program with up to 3 argv words, giving it fd 1 = a channel we drain to
// serial. Blocks reading the channel until the child (and its grandchildren)
// close it, then reaps.
fn run_echo(path as *u8, a0 as *u8, a1 as *u8, a2 as *u8) as void {
    ser("\n$ "); ser(a0);
    if (cast(i64, a1) != 0) { ser(" "); ser(a1); }
    if (cast(i64, a2) != 0) { ser(" "); ser(a2); }
    ser("\n");
    let is i64 as len with mut = 0;
    let is i64 as img = load(path, &len);
    if (img == 0) { ser("[load fail]\n"); return; }
    let is [2]i64 as ch;
    if (sys.channel_create(cast(*i64, &ch[0])) != 0) { ser("[chan fail]\n"); sys.munmap(img, page_round(len)); return; }
    let is [2]i64 as fda; fda[0] = 1; fda[1] = ch[1];          // child fd 1 = channel far end
    let is [6]i64 as av;
    let is i64 as argc with mut = 1;
    av[0] = cast(i64, a0); av[1] = prog.slen(a0);
    if (cast(i64, a1) != 0) { av[2] = cast(i64, a1); av[3] = prog.slen(a1); argc = 2; }
    if (cast(i64, a2) != 0) { av[4] = cast(i64, a2); av[5] = prog.slen(a2); argc = 3; }
    let is i64 as pid = sys.spawn(cast(*u8, img), len, cast(*u8, &fda[0]), 1, cast(*u8, &av[0]), argc);
    sys.close(ch[1]);                                          // we only read our end
    if (pid < 0) { ser("[spawn fail]\n"); sys.close(ch[0]); sys.munmap(img, page_round(len)); return; }
    let is [512]u8 as buf;
    while (1 == 1) {
        let is i64 as r = sys.read(ch[0], cast(*u8, &buf[0]), 512);
        if (r <= 0) { break; }                                // EOF when the child tree closes fd 1
        sys.write_serial(cast(*u8, &buf[0]), r);
    }
    sys.close(ch[0]);
    let is [1]i64 as st;
    sys.wait(pid, cast(*i64, &st[0]));
    sys.munmap(img, page_round(len));
}

fn main(argc as i64, argv as *u8) as i32 {
    let is *u8 as z = cast(*u8, 0);
    ser("\n##### CTEST-F begin (compiler showcase on device) #####\n");
    run_echo("/run.cse", "run", "/greet.cst", z);       // compile + run
    run_echo("/cc.cse",  "cc",  "/greet.cst", z);       // compile -> /greet.cse
    run_echo("/objdump.cse", "objdump", "/greet.cse", z);  // inspect what cc made
    run_echo("/make.cse", "make", "/Causticfile", z);   // build from a Causticfile
    probe("/g2.cse");
    ser("\n##### CTEST-F done #####\n");
    while (1 == 1) { sys.sleep_ns(1000000000); }
    return 0;
}
