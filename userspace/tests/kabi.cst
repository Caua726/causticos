// kabi — ring-3 self-test for the syscalls added in phase A. The kernel has its
// own boot smokes for these, but those run in ring 0 against the internal
// functions: they prove the mechanism, not that a userspace program can reach
// it through the stdlib binding. This closes that gap from the other side.
//
// Covers SYS_THREAD_SPAWN/EXIT (and each thread's own block and stack),
// SYS_EVENT_SUBSCRIBE, SYS_QUERY_DEVS and SYS_DEV_INFO, and what SYS_SPAWN
// carries in an argument vector. Runs from the shell like any other program.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;

let is i64 as fails with mut = 0;

// Everything goes to the terminal AND to the serial line: this test is most
// useful on a headless boot, where the framebuffer nobody is looking at is the
// only other place the result would land.
fn say(t as *u8) as void {
    prog.outs(t);
    let is i64 as n with mut = 0;
    while (t[n] != cast(u8, 0)) { n = n + 1; }
    sys.write_serial(t, n);
    return;
}

fn say_num(v as i64) as void {
    prog.out_num(v);
    let is i64 as x with mut = v;
    if (x < 0) { sys.write_serial(cast(*u8, "-"), 1); x = 0 - x; }
    if (x == 0) { sys.write_serial(cast(*u8, "0"), 1); return; }
    let is [24]u8 as b;
    let is i64 as i with mut = 24;
    while (x > 0) { i = i - 1; b[i] = cast(u8, 48 + (x % 10)); x = x / 10; }
    sys.write_serial(cast(*u8, &b[i]), 24 - i);
    return;
}

// The worker writes here and exits; main spins until it changes. One writer,
// one reader, one word — and the write happens before thread_exit, which is a
// syscall, so the store is visible by the time the thread is gone.
let is i64 as worker_mark with mut = 0;

fn check(name as *u8, ok as i64, got as i64, want as i64) as void {
    if (ok == 1) { say("  ok   "); } else { say("  FAIL "); fails = fails + 1; }
    say(name);
    say(" got="); say_num(got);
    say(" want="); say_num(want);
    say("\n");
    return;
}

// The calling thread's block: the word at fs:[8] is the block's own address.
fn thread_block() as *i64 with naked {
    asm("mov rax, QWORD PTR fs:[8]\nret\n");
}

// Thread entry: `arg` arrives in rdi. It just returns: thread_start runs it
// from a frame that ends the thread when it does, so returning must end THIS
// thread and not take the process down — main is still running and has to
// observe the mark.
fn worker(arg as i64) as i64 {
    worker_mark = arg + 1;
    return 0;
}

fn wait_mark(flag as *i64, ms as i64) as i64 {
    let is i64 as spins with mut = 0;
    while (flag[0] == 0 && spins < ms) { sys.sleep_ns(1000000); spins = spins + 1; }
    return flag[0];
}

fn test_thread() as void {
    say("threads:\n");
    // The first thread's block is the loader's: it says how far this stack is
    // committed, and the frame we are in is inside that.
    let is *i64 as mb = thread_block();
    let is i64 as here with mut = 0;
    let is i64 as here_va = cast(i64, &here);
    check(cast(*u8, "main block points at itself"), mb[1] == cast(i64, mb), mb[1], cast(i64, mb));
    check(cast(*u8, "main stack: floor <= low <= this frame"),
          mb[2] <= mb[0] && mb[0] <= here_va, mb[0], here_va);

    let is sys.ThreadStack as ts;
    let is i64 as rc = sys.thread_start(&ts, cast(i64, fn_ptr(worker)), 41, 65536, 65536);
    check(cast(*u8, "thread_start"), rc == 0, rc, 0);
    if (rc != 0) { return; }
    // Bounded wait: a thread that never runs must fail the test, not hang it.
    wait_mark(&worker_mark, 2000);
    check(cast(*u8, "worker ran (arg+1), then returned"), worker_mark == 42, worker_mark, 42);
    // The process is still alive to report that — which is itself the proof
    // that returning ended one thread and not the whole process. Give the
    // thread a moment to finish leaving before its stack goes.
    sys.sleep_ns(10000000);
    sys.thread_stack_free(&ts);
    return;
}

// --- a syscall gives the argument registers back ----------------------------
// Six recognisable values in rdi, rsi, rdx, r10, r8 and r9 around a getpid;
// what comes back is OR-ed with what went in XOR-ed out, so 0 means all six
// survived. They used to come back as the kernel's dispatch code left them —
// its own values, addresses included — and the stack grow helper, which kept
// the new bottom in rdi across SYS_COMMIT, recorded garbage there.
fn regs_after_syscall() as i64 with naked {
    asm("mov rdi, 0x1111\nmov rsi, 0x2222\nmov rdx, 0x3333\nmov r10, 0x4444\nmov r8, 0x5555\nmov r9, 0x6666\nmov rax, 4\nsyscall\nmov rax, rdi\nxor rax, 0x1111\nmov rcx, rsi\nxor rcx, 0x2222\nor rax, rcx\nmov rcx, rdx\nxor rcx, 0x3333\nor rax, rcx\nmov rcx, r10\nxor rcx, 0x4444\nor rax, rcx\nmov rcx, r8\nxor rcx, 0x5555\nor rax, rcx\nmov rcx, r9\nxor rcx, 0x6666\nor rax, rcx\nret\n");
}

fn test_syscall_regs() as void {
    let is i64 as diff = regs_after_syscall();
    check(cast(*u8, "a syscall leaves rdi rsi rdx r10 r8 r9 alone"), diff == 0, diff, 0);
    return;
}

// --- every thread has its own block --------------------------------------
// Each looks at fs:[8] again and again with sleeps between, so the threads
// and main trade cpus many times over; what each sees must never change and
// must be the block it was started with. A scheduler that switched threads
// without switching fs would show one thread another's block.
let is [2]i64 as seen with mut;       // the block each thread saw first
let is [2]i64 as drift with mut;      // times it saw a different one later
let is [2]i64 as looked with mut;     // 1 once it is done looking

fn looker(i as i64) as i64 {
    let is i64 as first = cast(i64, thread_block());
    seen[i] = first;
    let is i64 as k with mut = 0;
    while (k < 200) {
        if (cast(i64, thread_block()) != first) { drift[i] = drift[i] + 1; }
        if ((k & 7) == 0) { sys.sleep_ns(100000); } else { sys.getpid(); }
        k = k + 1;
    }
    looked[i] = 1;
    return 0;
}

fn test_thread_blocks() as void {
    let is *i64 as mine = thread_block();
    let is sys.ThreadStack as a;
    let is sys.ThreadStack as b;
    let is i64 as ra = sys.thread_start(&a, cast(i64, fn_ptr(looker)), 0, 65536, 65536);
    let is i64 as rb = sys.thread_start(&b, cast(i64, fn_ptr(looker)), 1, 65536, 65536);
    check(cast(*u8, "two lookers started"), ra == 0 && rb == 0, ra + rb, 0);
    if (ra != 0 || rb != 0) { return; }
    let is i64 as k with mut = 0;
    let is i64 as mine_drift with mut = 0;
    while (k < 200) {
        if (cast(i64, thread_block()) != cast(i64, mine)) { mine_drift = mine_drift + 1; }
        sys.sleep_ns(100000);
        k = k + 1;
    }
    wait_mark(cast(*i64, &looked[0]), 3000);
    wait_mark(cast(*i64, &looked[1]), 3000);
    check(cast(*u8, "thread 0 saw its own block"), seen[0] == a.block, seen[0], a.block);
    check(cast(*u8, "thread 1 saw its own block"), seen[1] == b.block, seen[1], b.block);
    check(cast(*u8, "and only it, across switches"), drift[0] + drift[1] == 0, drift[0] + drift[1], 0);
    check(cast(*u8, "main kept its own"), mine_drift == 0, mine_drift, 0);
    sys.sleep_ns(10000000);
    sys.thread_stack_free(&a);
    sys.thread_stack_free(&b);
    return;
}

// --- a thread's stack grows ----------------------------------------------
// This recursion is also what makes kabi a dynamic-stack program — every
// function probes fs:[0] — so every thread test here runs the way a real
// program's threads do. 400 frames of over half a KiB is ~240 KiB, far past
// the 64 KiB committed to start with: the probes must commit the rest, in the
// thread's own reservation, and move ITS block's low mark.
let is i64 as deep_sum with mut = 0;
let is i64 as deep_low with mut = 0;
let is i64 as deep_done with mut = 0;

fn deep(n as i64) as i64 {
    let is [512]u8 as pad;
    pad[0] = cast(u8, n & 255);
    pad[511] = cast(u8, (n >> 1) & 255);
    if (n == 0) { return 0; }
    return deep(n - 1) + cast(i64, pad[0]) + cast(i64, pad[511]) - cast(i64, pad[511]);
}

fn diver(arg as i64) as i64 {
    deep_sum = deep(arg);
    let is *i64 as tb = thread_block();
    deep_low = tb[0];
    deep_done = 1;
    return 0;
}

fn test_thread_stack_growth() as void {
    let is sys.ThreadStack as t;
    let is i64 as rc = sys.thread_start(&t, cast(i64, fn_ptr(diver)), 400, 1048576, 65536);
    check(cast(*u8, "diver started"), rc == 0, rc, 0);
    if (rc != 0) { return; }
    wait_mark(&deep_done, 3000);
    // sum of (n & 255) for n = 1..400
    let is i64 as want with mut = 0;
    let is i64 as n with mut = 1;
    while (n <= 400) { want = want + (n & 255); n = n + 1; }
    check(cast(*u8, "deep recursion in a thread came back"), deep_done == 1 && deep_sum == want, deep_sum, want);
    let is i64 as start_low = t.base + t.size - 65536;
    check(cast(*u8, "its stack grew below the first commit"), deep_low < start_low, deep_low, start_low);
    check(cast(*u8, "inside its own reservation"), deep_low >= t.base, deep_low, t.base);
    sys.sleep_ns(10000000);
    sys.thread_stack_free(&t);
    return;
}

fn test_events() as void {
    let is i64 as me = sys.getpid();
    let is i64 as fd = sys.event_subscribe(me, 0);
    check(cast(*u8, "event_subscribe fd>=0"), fd >= 0, fd, 0);
    if (fd < 0) { return; }
    // Nothing has exited yet: a read must report "nothing queued", which is 0
    // bytes and NOT end-of-stream. Anything negative would be an error.
    let is [3]i64 as rec;
    let is i64 as n = sys.read(fd, cast(*u8, &rec[0]), 24);
    check(cast(*u8, "empty read == 0"), n == 0, n, 0);
    // Subscribing to a pid that is not ours must be refused: the spawn tree is
    // the authority, so this is the whole access rule for the object.
    let is i64 as bad = sys.event_subscribe(me + 4242, 0);
    check(cast(*u8, "foreign pid refused"), bad < 0, bad, 0 - 1);
    sys.close(fd);
    return;
}

fn test_devs() as void {
    let is [32]i64 as devs;
    let is i64 as total = sys.query_devs(cast(*i64, &devs[0]), 16);
    check(cast(*u8, "query_devs total>0"), total > 0, total, 1);
    if (total <= 0) { return; }
    let is i64 as n with mut = total;
    if (n > 16) { n = 16; }

    // Every enumerated pair must resolve to an identity that echoes it back.
    let is i64 as i with mut = 0;
    let is i64 as agree with mut = 1;
    while (i < n) {
        let is [8]i64 as inf;
        if (sys.dev_info(devs[i*2], devs[i*2+1], cast(*i64, &inf[0])) != 0) { agree = 0; }
        else if (inf[0] != devs[i*2] || inf[1] != devs[i*2+1]) { agree = 0; }
        i = i + 1;
    }
    check(cast(*u8, "dev_info echoes pair"), agree == 1, agree, 1);

    // dev_count must agree with what enumeration reported for that class.
    let is i64 as cls = devs[0];
    let is i64 as counted with mut = 0;
    i = 0;
    while (i < n) { if (devs[i*2] == cls) { counted = counted + 1; } i = i + 1; }
    let is i64 as dc = sys.dev_count(cls);
    check(cast(*u8, "dev_count == enum"), dc == counted, dc, counted);

    // An index past the end is E_NOENT, never a silent alias of instance 0.
    let is [8]i64 as bad;
    let is i64 as rc = sys.dev_info(cls, 999, cast(*i64, &bad[0]));
    check(cast(*u8, "index 999 refused"), rc < 0, rc, 0 - 1);
    return;
}

// fd 0, 1 and 2 belong to stdin, stdout and stderr, and nothing that hands
// out a descriptor may put anything there — not even when the slots are empty,
// which they are for any program launched without a shell to fill them.
//
// This is checked from ring 3 rather than left to the kernel's own smoke
// because the kernel's runs only in the smoke boot flavour, which is off. It
// earns its place: an fd that landed on 1 once made every print in a test go
// down a daemon's channel instead, and what failed was a program three steps
// away that never got an answer.
fn test_fd_reservation() as void {
    say("reserved descriptors:\n");

    // A negative fd fails this too, which is what we want: it means the open
    // itself broke and the number is meaningless.
    let is i64 as f = sys.open_read(cast(*u8, "/init.cse"));
    check(cast(*u8, "open never returns 0, 1 or 2"), f >= 3, f, 3);
    if (f >= 0) { sys.close(f); }

    let is [2]i64 as ch;
    let is i64 as cr = sys.channel_create(cast(*i64, &ch[0]));
    check(cast(*u8, "a channel pair is made"), cr == 0, cr, 0);
    if (cr == 0) {
        check(cast(*u8, "neither end is reserved"), ch[0] >= 3 && ch[1] >= 3, 1, 1);
        check(cast(*u8, "and they are distinct"), ch[0] != ch[1], 1, 1);
        sys.close(ch[0]);
        sys.close(ch[1]);
    }

    // And the slot really is still free afterwards: a write to it falls back
    // to serial rather than reaching anything, which is what makes leaving it
    // empty safe in the first place.
    let is i64 as g = sys.open_read(cast(*u8, "/init.cse"));
    check(cast(*u8, "a reused slot is still not reserved"), g >= 3, g, 3);
    if (g >= 0) { sys.close(g); }
    return;
}

// ------------------------------------------------------------------
// Descriptor races between threads of one process.
//
// The kernel looked an fd up and then used the object with no reference of
// its own, so a sibling thread closing the fd in between could free it under
// a syscall that was still using it. And close itself read the object, then
// cleared the slot, then dropped the reference — two threads closing one fd
// could both get that far and drop it twice.
// ------------------------------------------------------------------

let is i64 as race_fd with mut = 0 - 1;
let is i64 as race_go with mut = 0;
let is i64 as race_rc with mut = 0;
let is i64 as race_done with mut = 0;

fn closer(arg as i64) as void {
    // getpid in the spin: a call the compiler cannot hoist the load out of.
    while (race_go == 0) { sys.getpid(); }
    race_rc = cast(i64, sys.close(race_fd));
    race_done = 1;
    sys.thread_exit(0);
    return;
}

let is i64 as reader_fd with mut = 0 - 1;
let is i64 as reader_n with mut = 0;
let is i64 as reader_done with mut = 0;
let is [8]u8 as reader_buf with mut;

fn reader(arg as i64) as void {
    reader_n = sys.read(reader_fd, cast(*u8, &reader_buf[0]), 8);
    reader_done = 1;
    sys.thread_exit(0);
    return;
}

fn wait_flag(flag as *i64, ms as i64) as i64 {
    let is i64 as spins with mut = 0;
    while (flag[0] == 0 && spins < ms) { sys.sleep_ns(1000000); spins = spins + 1; }
    return flag[0];
}

fn test_fd_races() as void {
    say("descriptor races:\n");
    // Three stacks: the closers alternate between two, so a round's thread
    // never starts on the stack the previous one may still be leaving on; the
    // reader gets the third.
    let is i64 as STACK = 65536;
    let is i64 as sp = sys.mmap(cast(i64, 0), STACK * 3, sys.PROT_READ | sys.PROT_WRITE);
    if (sp < 0) { check(cast(*u8, "race stacks"), 0, sp, 0); return; }

    // Two threads close one fd at the same moment, many times over: exactly
    // one close may succeed, every time.
    let is i64 as ROUNDS = 200;
    let is i64 as bad_rounds with mut = 0;
    let is i64 as both_ok with mut = 0;
    let is i64 as r with mut = 0;
    while (r < ROUNDS) {
        let is [2]i64 as ch;
        if (sys.channel_create(cast(*i64, &ch[0])) != 0) { bad_rounds = bad_rounds + 1; r = ROUNDS; }
        else {
            race_fd = ch[0];
            race_go = 0;
            race_done = 0;
            race_rc = 99;
            let is i64 as sb = sp + STACK * (r & 1);
            let is i64 as blk = sys.thread_block_init(sb, STACK, sb);
            if (sys.thread_run(cast(i64, fn_ptr(closer)), 0, blk) <= 0) { bad_rounds = bad_rounds + 1; }
            sys.sleep_ns(200000);
            race_go = 1;
            let is i64 as mine = cast(i64, sys.close(ch[0]));
            if (wait_flag(&race_done, 2000) == 0) {
                say("    round "); say_num(r); say(": the closer never finished\n");
                bad_rounds = bad_rounds + 1;
                r = ROUNDS;
            }
            let is i64 as wins with mut = 0;
            if (mine == 0) { wins = wins + 1; }
            if (race_rc == 0) { wins = wins + 1; }
            if (wins == 2) { both_ok = both_ok + 1; }
            if (wins != 1) {
                bad_rounds = bad_rounds + 1;
                say("    round "); say_num(r); say(": mine="); say_num(mine);
                say(" theirs="); say_num(race_rc); say(" done="); say_num(race_done); say("\n");
            }
            sys.close(ch[1]);
        }
        r = r + 1;
    }
    check(cast(*u8, "a racing double close succeeds exactly once"), bad_rounds == 0, bad_rounds, 0);
    check(cast(*u8, "never both"), both_ok == 0, both_ok, 0);

    // A thread blocked reading an fd that another thread closes: the read
    // still holds the object, so it completes when data comes — on memory
    // that is still the channel — and the endpoint goes away once it returns.
    let is [2]i64 as c2;
    if (sys.channel_create(cast(*i64, &c2[0])) != 0) { check(cast(*u8, "channel"), 0, 0, 1); sys.munmap(sp, STACK * 3); return; }
    reader_fd = c2[0];
    reader_done = 0;
    reader_n = 0;
    let is i64 as rblk = sys.thread_block_init(sp + STACK * 2, STACK, sp + STACK * 2);
    let is i64 as rt = sys.thread_run(cast(i64, fn_ptr(reader)), 0, rblk);
    check(cast(*u8, "reader thread"), rt > 0, rt, 1);
    sys.sleep_ns(30000000);                       // let it block in read
    let is i64 as cr = cast(i64, sys.close(c2[0]));
    check(cast(*u8, "close under a blocked read"), cr == 0, cr, 0);
    let is i64 as wr = sys.write(c2[1], cast(*u8, "x"), 1);
    check(cast(*u8, "the held endpoint still takes a write"), wr == 1, wr, 1);
    wait_flag(&reader_done, 2000);
    check(cast(*u8, "the blocked read completes with it"), reader_n == 1, reader_n, 1);
    // The read returned, its reference went with it, and that was the last:
    // the peer now finds the other side gone.
    let is i64 as gone with mut = 0;
    let is i64 as tries with mut = 0;
    while (gone == 0 && tries < 200) {
        if (sys.write(c2[1], cast(*u8, "y"), 1) == sys.E_PIPE) { gone = 1; }
        else { sys.sleep_ns(1000000); }
        tries = tries + 1;
    }
    check(cast(*u8, "and the endpoint is released after"), gone == 1, gone, 1);
    sys.close(c2[1]);
    sys.sleep_ns(10000000);                       // the last threads finish leaving
    sys.munmap(sp, STACK * 3);
    return;
}

// A mapping outlives its fd. Closing the fd of a mapped segment used to free
// the segment's frames while the process still had them mapped: its stores
// went on landing in pages the allocator had handed to someone else. Here the
// "someone else" is ourselves — a fresh anonymous mapping, which the kernel
// zeroes — so a leak shows up as our pattern inside memory we never wrote.
fn test_mapping_outlives_fd() as void {
    say("a mapping outlives its fd:\n");
    let is i64 as NP = 256;                       // 1 MiB
    let is i64 as fd = sys.seg_create(NP, 0);
    check(cast(*u8, "segment created"), fd >= 0, fd, 3);
    if (fd < 0) { return; }
    let is i64 as va = sys.mmap_fd(sys.PROT_READ | sys.PROT_WRITE, fd);
    check(cast(*u8, "segment mapped"), va > 0, va, 1);
    if (va <= 0) { sys.close(fd); return; }
    let is i64 as cr = cast(i64, sys.close(fd));
    check(cast(*u8, "fd closed while mapped"), cr == 0, cr, 0);

    // Still ours: write a pattern through the mapping...
    let is *i64 as m = cast(*i64, va);
    let is i64 as words = NP * 512;
    let is i64 as i with mut = 0;
    while (i < words) { m[i] = 0x5EC7A11A5EC7A11A; i = i + 1; }
    // ...then take fresh memory several times the size and look for it.
    let is i64 as ALEN = NP * 4096 * 4;
    let is i64 as an = sys.mmap(cast(i64, 0), ALEN, sys.PROT_READ | sys.PROT_WRITE);
    check(cast(*u8, "fresh memory"), an > 0, an, 1);
    let is i64 as hits with mut = 0;
    if (an > 0) {
        let is *i64 as q = cast(*i64, an);
        let is i64 as j with mut = 0;
        while (j < ALEN / 8) {
            if (q[j] == 0x5EC7A11A5EC7A11A) { hits = hits + 1; }
            j = j + 1;
        }
        sys.munmap(an, ALEN);
    }
    check(cast(*u8, "the closed segment's pages were not handed out"), hits == 0, hits, 0);
    // And the mapping still reads back what was written.
    let is i64 as bad with mut = 0;
    i = 0;
    while (i < words) { if (m[i] != 0x5EC7A11A5EC7A11A) { bad = bad + 1; } i = i + 1; }
    check(cast(*u8, "the mapping still holds what was written"), bad == 0, bad, 0);
    sys.munmap(va, NP * 4096);
    return;
}

// ---- the argument vector ----

// A sum over an argument vector's lengths and bytes, from argument `from` on:
// the spawner and the spawned compute it the same way, so a vector that
// arrives cut short, reordered or with a byte wrong shows.
fn argv_sum(av as *i64, n as i64) as i64 {
    let is i64 as s with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is *u8 as a = cast(*u8, av[i * 2]);
        let is i64 as len = av[i * 2 + 1];
        s = s * 31 + len;
        let is i64 as j with mut = 0;
        while (j < len) { s = s * 7 + cast(i64, a[j]); j = j + 1; }
        i = i + 1;
    }
    return s;
}

fn put_dec(b as *u8, v0 as i64) as i64 {
    let is i64 as v with mut = v0;
    let is i64 as n with mut = 0;
    if (v < 0) { b[0] = cast(u8, 45); n = 1; v = 0 - v; }
    let is [24]u8 as d;
    let is i64 as k with mut = 0;
    if (v == 0) { d[0] = cast(u8, 48); k = 1; }
    while (v > 0) { d[k] = cast(u8, 48 + v % 10); v = v / 10; k = k + 1; }
    while (k > 0) { k = k - 1; b[n] = d[k]; n = n + 1; }
    return n;
}

fn get_dec(s as *u8) as i64 {
    let is i64 as i with mut = 0;
    let is i64 as neg with mut = 0;
    if (s[0] == cast(u8, 45)) { neg = 1; i = 1; }
    let is i64 as v with mut = 0;
    while (s[i] >= cast(u8, 48) && s[i] <= cast(u8, 57)) { v = v * 10 + cast(i64, s[i]) - 48; i = i + 1; }
    if (neg == 1) { return 0 - v; }
    return v;
}

// Spawn a second kabi with n generated arguments, lens[i] long each (after the
// four it needs to check them); it exits 0 when argc and the sum agree. The
// spawn's own result: the child's exit code, or spawn's errno.
fn spawn_argv(n as i64, lens as *i64) as i64 {
    let is i64 as total with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) { total = total + lens[i]; i = i + 1; }
    let is i64 as avbytes = (n + 4) * 16;
    let is i64 as mem = sys.mmap(0, (avbytes + total + 4096 + 4095) / 4096 * 4096, sys.PROT_READ | sys.PROT_WRITE);
    if (mem < 0) { return mem; }
    let is *i64 as av = cast(*i64, mem);
    let is *u8 as bytes = cast(*u8, mem + avbytes);
    let is i64 as at with mut = 0;
    i = 0;
    while (i < n) {
        let is i64 as j with mut = 0;
        while (j < lens[i]) { bytes[at + j] = cast(u8, 97 + (i * 3 + j) % 26); j = j + 1; }
        av[(i + 4) * 2] = cast(i64, &bytes[at]); av[(i + 4) * 2 + 1] = lens[i];
        at = at + lens[i];
        i = i + 1;
    }
    let is i64 as sum = argv_sum(cast(*i64, mem + 64), n);
    let is *u8 as hdr = cast(*u8, cast(i64, bytes) + at);
    av[0] = cast(i64, "kabi"); av[1] = 4;
    av[2] = cast(i64, "--argv"); av[3] = 6;
    let is i64 as l1 = put_dec(hdr, n + 4);
    av[4] = cast(i64, hdr); av[5] = l1;
    let is i64 as l2 = put_dec(cast(*u8, cast(i64, hdr) + 32), sum);
    av[6] = cast(i64, hdr) + 32; av[7] = l2;
    let is i64 as pid = sys.spawn_path(cast(*u8, "/kabi.cse"), cast(*u8, 0), 0, cast(*u8, av), n + 4);
    let is i64 as rc with mut = pid;
    if (pid >= 0) {
        let is [1]i64 as code;
        sys.wait(pid, cast(*i64, &code[0]));
        rc = code[0];
    }
    sys.munmap(mem, (avbytes + total + 4096 + 4095) / 4096 * 4096);
    return rc;
}

fn test_argv() as void {
    // three thousand arguments: the bound used to be 32
    let is i64 as ln = sys.mmap(0, 65536, sys.PROT_READ | sys.PROT_WRITE);
    let is *i64 as lens = cast(*i64, ln);
    let is i64 as i with mut = 0;
    while (i < 3000) { lens[i] = i % 13 + 1; i = i + 1; }
    let is i64 as r1 = spawn_argv(3000, lens);
    check(cast(*u8, "3000 arguments arrive whole"), r1 == 0, r1, 0);
    // one argument of 200000 bytes: it was 256 at most, 2048 in all
    lens[0] = 200000;
    let is i64 as r2 = spawn_argv(1, lens);
    check(cast(*u8, "a 200000-byte argument arrives whole"), r2 == 0, r2, 0);
    // past ARGV_MAX, in bytes and in count: E_2BIG, not a child with less
    lens[0] = sys.ARGV_MAX;
    let is i64 as r3 = spawn_argv(1, lens);
    check(cast(*u8, "an argument past ARGV_MAX is E_2BIG"), r3 == sys.E_2BIG, r3, sys.E_2BIG);
    i = 0;
    while (i < 8000) { lens[i] = 30; i = i + 1; }
    let is i64 as r4 = spawn_argv(8000, lens);
    check(cast(*u8, "8000 arguments of 30 bytes are E_2BIG"), r4 == sys.E_2BIG, r4, sys.E_2BIG);
    sys.munmap(ln, 65536);
    return;
}

// ---- SYS_PROC_LIST: every process, and what each is doing ----
// 80 children asleep and one spinning. The list held 64 records at most, and
// said "run" for a process whose every thread was waiting.
let is i64 as PL_KIDS with imut = 80;
fn spawn_mode(mode as *u8, ml as i64) as i64 {
    let is [4]i64 as av;
    av[0] = cast(i64, "kabi"); av[1] = 4;
    av[2] = cast(i64, mode); av[3] = ml;
    return sys.spawn_path(cast(*u8, "/kabi.cse"), cast(*u8, 0), 0, cast(*u8, &av[0]), 2);
}
fn pl_find(buf as *i64, n as i64, pid as i64) as *i64 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (buf[i * 10] == pid) { return cast(*i64, cast(i64, buf) + i * 80); }
        i = i + 1;
    }
    return cast(*i64, 0);
}
fn test_proc_list() as void {
    let is i64 as pv = sys.mmap(0, PL_KIDS * 8, sys.PROT_READ | sys.PROT_WRITE);
    let is *i64 as pids = cast(*i64, pv);
    let is i64 as started with mut = 0;
    while (started < PL_KIDS) {
        let is i64 as p = spawn_mode("--sleep", 7);
        if (p < 0) { check(cast(*u8, "proc_list: spawn a sleeper"), 0, p, 0); started = PL_KIDS + 1; }
        else { pids[started] = p; started = started + 1; }
    }
    let is i64 as spin = spawn_mode("--spin", 6);
    sys.sleep_ns(300000000);                     // they start, and the sleepers block

    let is i64 as total = sys.proc_list(cast(*i64, 0), 0);
    check(cast(*u8, "proc_list: max 0 counts every process"), total >= PL_KIDS + 3, total, PL_KIDS + 3);
    check(cast(*u8, "proc_list: no array and max > 0 is E_FAULT"),
          sys.proc_list(cast(*i64, 0), 1) == sys.E_FAULT, sys.proc_list(cast(*i64, 0), 1), sys.E_FAULT);
    let is i64 as cap = total + 16;
    let is i64 as bv = sys.mmap(0, cap * 80, sys.PROT_READ | sys.PROT_WRITE);
    let is *i64 as buf = cast(*i64, bv);
    let is i64 as got = sys.proc_list(buf, cap);
    check(cast(*u8, "proc_list: the whole list fits"), got <= cap, got, cap);
    let is i64 as seen with mut = 0;
    let is i64 as asleep with mut = 0;
    let is i64 as k with mut = 0;
    while (k < PL_KIDS) {
        let is *i64 as r = pl_find(buf, got, pids[k]);
        if (cast(i64, r) != 0) {
            seen = seen + 1;
            if (r[2] == 1 && r[9] == 0) { asleep = asleep + 1; }
        }
        k = k + 1;
    }
    check(cast(*u8, "proc_list: all 80 children are listed"), seen == PL_KIDS, seen, PL_KIDS);
    check(cast(*u8, "proc_list: a sleeping child runs no thread"), asleep == PL_KIDS, asleep, PL_KIDS);
    let is *i64 as sr = pl_find(buf, got, spin);
    let is i64 as sready with mut = 0 - 1;
    if (cast(i64, sr) != 0) { sready = sr[9]; }
    check(cast(*u8, "proc_list: a spinning child has a thread running"), sready == 1, sready, 1);
    check(cast(*u8, "proc_list: row 0 is the kernel"), buf[0] == 0, buf[0], 0);
    // a short array: the first records, and the total still
    let is i64 as t5 = sys.proc_list(buf, 5);
    check(cast(*u8, "proc_list: a short array still gets the total"), t5 >= PL_KIDS + 3, t5, PL_KIDS + 3);

    k = 0;
    // and all of them end when killed, the spinner still running: a cpu
    // that never went idle never freed a dead thread, and wait() timed out
    let is i64 as ended with mut = 0;
    while (k < PL_KIDS) {
        sys.kill(pids[k]);
        let is [1]i64 as c;
        if (sys.wait(pids[k], cast(*i64, &c[0])) == sys.EXIT_KILLED) { ended = ended + 1; }
        k = k + 1;
    }
    check(cast(*u8, "proc_list: 80 killed children are collected beside a spinner"), ended == PL_KIDS, ended, PL_KIDS);
    if (spin >= 0) { sys.kill(spin); let is [1]i64 as c2; sys.wait(spin, cast(*i64, &c2[0])); }
    sys.munmap(bv, cap * 80);
    sys.munmap(pv, PL_KIDS * 8);
    return;
}

// The second kabi: argc and the sum must be what the first one said.
fn argv_child(argc as i64, argv as *u8) as i32 {
    let is *i64 as av = cast(*i64, sys.mmap(0, (argc * 16 + 4095) / 4096 * 4096, sys.PROT_READ | sys.PROT_WRITE));
    let is i64 as i with mut = 0;
    while (i < argc) { let is *u8 as a = prog.arg(argv, i); av[i * 2] = cast(i64, a); av[i * 2 + 1] = prog.slen(a); i = i + 1; }
    if (argc != get_dec(prog.arg(argv, 2))) { return cast(i32, 2); }
    if (argv_sum(cast(*i64, cast(i64, av) + 64), argc - 4) != get_dec(prog.arg(argv, 3))) { return cast(i32, 3); }
    return cast(i32, 0);
}
// The filesystem answers with the reason, not a bare failure: mkdir on what
// exists is E_EXIST, unlink on a directory is E_ISDIR, rmdir on a nonempty
// one is E_NOTEMPTY. The tools print these words; this pins the kernel side.
fn test_fs_errno() as void {
    // A scratch directory of its own: leftovers from an earlier run must not
    // change what this sees (a first run that died halfway leaves /kabi-e/d).
    sys.unlink("/kabi-e/d/file.txt");
    sys.unlink("/kabi-e/d/second.txt");
    sys.rmdir("/kabi-e/d");
    sys.rmdir("/kabi-e");
    let is i64 as m0 = sys.mkdir("/kabi-e");
    check(cast(*u8, "mkdir the scratch directory"), m0 == 0, m0, 0);
    let is i64 as m1 = sys.mkdir("/kabi-e/d");
    check(cast(*u8, "mkdir makes the directory"), m1 == 0, m1, 0);
    let is i64 as m2 = sys.mkdir("/kabi-e/d");
    check(cast(*u8, "mkdir again is E_EXIST"), m2 == sys.E_EXIST, m2, sys.E_EXIST);
    let is i64 as fd = sys.open_write("/kabi-e/d/file.txt");
    check(cast(*u8, "create a file in it"), fd >= 0, fd, 0);
    if (fd >= 0) { sys.close(fd); }
    let is i64 as r0 = sys.rmdir("/kabi-e/d");
    check(cast(*u8, "rmdir right after create+close is E_NOTEMPTY"), r0 == sys.E_NOTEMPTY, r0, sys.E_NOTEMPTY);
    let is i64 as fd3 = sys.open_write("/kabi-e/d/second.txt");
    check(cast(*u8, "create a second file"), fd3 >= 0, fd3, 0);
    if (fd3 >= 0) { sys.close(fd3); }
    let is i64 as u3 = sys.unlink("/kabi-e/d/second.txt");
    check(cast(*u8, "unlink the second file"), u3 == 0, u3, 0);
    let is [4]i64 as st;
    let is i64 as first = sys.stat("/kabi-e/d/file.txt", cast(*u8, &st[0]));
    check(cast(*u8, "removing the second empty file preserves the first"), first == 0, first, 0);
    let is i64 as second = sys.stat("/kabi-e/d/second.txt", cast(*u8, &st[0]));
    check(cast(*u8, "the second empty file is gone"), second == sys.E_NOENT, second, sys.E_NOENT);
    let is i64 as missing = sys.unlink("/kabi-e/d/absent");
    check(cast(*u8, "unlink missing file is E_NOENT"), missing == sys.E_NOENT, missing, sys.E_NOENT);
    let is i64 as parent = sys.mkdir("/kabi-e/missing/child");
    check(cast(*u8, "mkdir missing parent is E_NOENT"), parent == sys.E_NOENT, parent, sys.E_NOENT);
    let is i64 as notdir = sys.mkdir("/kabi-e/d/file.txt/child");
    check(cast(*u8, "mkdir through a file is E_NOTDIR"), notdir == sys.E_NOTDIR, notdir, sys.E_NOTDIR);
    let is i64 as fd4 = sys.open_write("/kabi-e/d/second.txt");
    if (fd4 >= 0) { sys.close(fd4); }
    let is i64 as renamed = sys.rename("/kabi-e/d/file.txt", "/kabi-e/d/second.txt");
    check(cast(*u8, "rename over another empty file succeeds"), renamed == 0, renamed, 0);
    let is i64 as source = sys.stat("/kabi-e/d/file.txt", cast(*u8, &st[0]));
    check(cast(*u8, "rename removes the source empty file"), source == sys.E_NOENT, source, sys.E_NOENT);
    let is i64 as restored = sys.rename("/kabi-e/d/second.txt", "/kabi-e/d/file.txt");
    check(cast(*u8, "rename keeps the destination reachable"), restored == 0, restored, 0);
    let is i64 as u1 = sys.unlink("/kabi-e/d");
    check(cast(*u8, "unlink on a directory is E_ISDIR"), u1 == sys.E_ISDIR, u1, sys.E_ISDIR);
    let is i64 as dir = sys.stat("/kabi-e/d", cast(*u8, &st[0]));
    check(cast(*u8, "refused unlink preserves the directory"), dir == 0 && st[3] != 0, dir, 0);
    let is i64 as r1 = sys.rmdir("/kabi-e/d");
    check(cast(*u8, "rmdir on a nonempty directory is E_NOTEMPTY"), r1 == sys.E_NOTEMPTY, r1, sys.E_NOTEMPTY);
    let is i64 as u2 = sys.unlink("/kabi-e/d/file.txt");
    check(cast(*u8, "unlink the file"), u2 == 0, u2, 0);
    let is i64 as r2 = sys.rmdir("/kabi-e/d");
    check(cast(*u8, "rmdir once empty"), r2 == 0, r2, 0);
    let is i64 as r3 = sys.rmdir("/kabi-e");
    check(cast(*u8, "rmdir the scratch directory"), r3 == 0, r3, 0);
    return;
}

fn main(argc as i64, argv as *u8) as i32 {
    if (argc == 2) {
        let is *u8 as m = prog.arg(argv, 1);
        if (prog.slen(m) == 7 && m[2] == cast(u8, 115) && m[3] == cast(u8, 108)) { sys.sleep_ns(60000000000); return cast(i32, 0); }   // --sleep
        if (prog.slen(m) == 6 && m[2] == cast(u8, 115) && m[3] == cast(u8, 112)) {                                                    // --spin
            let is i64 as x with mut = 0;
            while (1 == 1) { x = x + 1; }
        }
    }
    if (argc >= 4) {
        let is *u8 as a1 = prog.arg(argv, 1);
        if (a1[0] == cast(u8, 45) && a1[1] == cast(u8, 45) && a1[2] == cast(u8, 97)) { return argv_child(argc, argv); }   // --argv
    }
    say("kabi: phase-A syscalls from ring 3\n");
    test_argv();
    test_fs_errno();
    test_proc_list();
    test_syscall_regs();
    test_thread();
    test_thread_blocks();
    test_thread_stack_growth();
    test_events();
    test_devs();
    test_fd_reservation();
    test_fd_races();
    test_mapping_outlives_fd();
    if (fails == 0) { say("kabi: PASS\n"); return cast(i32, 0); }
    say("kabi: FAIL n="); say_num(fails); say("\n");
    return cast(i32, 1);
}
