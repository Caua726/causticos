// kabi — ring-3 self-test for the syscalls added in phase A. The kernel has its
// own boot smokes for these, but those run in ring 0 against the internal
// functions: they prove the mechanism, not that a userspace program can reach
// it through the stdlib binding. This closes that gap from the other side.
//
// Covers SYS_THREAD_SPAWN/EXIT, SYS_EVENT_SUBSCRIBE, SYS_QUERY_DEVS and
// SYS_DEV_INFO. Runs from the shell like any other program.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;

let is i64 as fails with mut = 0;

// Everything goes to the terminal AND to the serial line: this test is most
// useful on a headless boot, where the framebuffer nobody is looking at is the
// only other place the result would land.
fn say(t as *u8) as void {
    prog.outs(t);
    let is i64 as n with mut = 0;
    while (t[n] != cast(u8, 0)) { n = n + 1; }
    sys.write_serial(t, n);
    return;
}

fn say_num(v as i64) as void {
    prog.out_num(v);
    let is i64 as x with mut = v;
    if (x < 0) { sys.write_serial(cast(*u8, "-"), 1); x = 0 - x; }
    if (x == 0) { sys.write_serial(cast(*u8, "0"), 1); return; }
    let is [24]u8 as b;
    let is i64 as i with mut = 24;
    while (x > 0) { i = i - 1; b[i] = cast(u8, 48 + (x % 10)); x = x / 10; }
    sys.write_serial(cast(*u8, &b[i]), 24 - i);
    return;
}

// The worker writes here and exits; main spins until it changes. One writer,
// one reader, one word — and the write happens before thread_exit, which is a
// syscall, so the store is visible by the time the thread is gone.
let is i64 as worker_mark with mut = 0;

fn check(name as *u8, ok as i64, got as i64, want as i64) as void {
    if (ok == 1) { say("  ok   "); } else { say("  FAIL "); fails = fails + 1; }
    say(name);
    say(" got="); say_num(got);
    say(" want="); say_num(want);
    say("\n");
    return;
}

// Thread entry: `arg` arrives in rdi. Ending with thread_exit must NOT take the
// process down — main is still running and has to observe the mark.
fn worker(arg as i64) as void {
    worker_mark = arg + 1;
    sys.thread_exit(0);
    return;
}

fn test_thread() as void {
    let is i64 as STACK = 65536;
    let is i64 as sp = sys.mmap(cast(i64, 0), STACK, sys.PROT_READ | sys.PROT_WRITE);
    if (sp < 0) { check(cast(*u8, "thread stack"), 0, sp, 0); return; }
    // The stack grows down, so the thread starts at the TOP of the mapping.
    // 16-byte aligned: the ABI expects it and a misaligned frame faults on the
    // first aligned store.
    let is i64 as top = (sp + STACK) & (0 - 16);
    let is i64 as tid = sys.thread_spawn(cast(i64, fn_ptr(worker)), 41, top);
    check(cast(*u8, "thread_spawn tid>0"), tid > 0, tid, 1);
    if (tid <= 0) { sys.munmap(sp, STACK); return; }

    // Bounded wait: a thread that never runs must fail the test, not hang it.
    let is i64 as spins with mut = 0;
    while (worker_mark == 0 && spins < 2000) {
        sys.sleep_ns(1000000);
        spins = spins + 1;
    }
    check(cast(*u8, "worker ran (arg+1)"), worker_mark == 42, worker_mark, 42);
    // The process is still alive to report that — which is itself the proof
    // that thread_exit ended one thread and not the whole process.
    sys.munmap(sp, STACK);
    return;
}

fn test_events() as void {
    let is i64 as me = sys.getpid();
    let is i64 as fd = sys.event_subscribe(me, 0);
    check(cast(*u8, "event_subscribe fd>=0"), fd >= 0, fd, 0);
    if (fd < 0) { return; }
    // Nothing has exited yet: a read must report "nothing queued", which is 0
    // bytes and NOT end-of-stream. Anything negative would be an error.
    let is [3]i64 as rec;
    let is i64 as n = sys.read(fd, cast(*u8, &rec[0]), 24);
    check(cast(*u8, "empty read == 0"), n == 0, n, 0);
    // Subscribing to a pid that is not ours must be refused: the spawn tree is
    // the authority, so this is the whole access rule for the object.
    let is i64 as bad = sys.event_subscribe(me + 4242, 0);
    check(cast(*u8, "foreign pid refused"), bad < 0, bad, 0 - 1);
    sys.close(fd);
    return;
}

fn test_devs() as void {
    let is [32]i64 as devs;
    let is i64 as total = sys.query_devs(cast(*i64, &devs[0]), 16);
    check(cast(*u8, "query_devs total>0"), total > 0, total, 1);
    if (total <= 0) { return; }
    let is i64 as n with mut = total;
    if (n > 16) { n = 16; }

    // Every enumerated pair must resolve to an identity that echoes it back.
    let is i64 as i with mut = 0;
    let is i64 as agree with mut = 1;
    while (i < n) {
        let is [8]i64 as inf;
        if (sys.dev_info(devs[i*2], devs[i*2+1], cast(*i64, &inf[0])) != 0) { agree = 0; }
        else if (inf[0] != devs[i*2] || inf[1] != devs[i*2+1]) { agree = 0; }
        i = i + 1;
    }
    check(cast(*u8, "dev_info echoes pair"), agree == 1, agree, 1);

    // dev_count must agree with what enumeration reported for that class.
    let is i64 as cls = devs[0];
    let is i64 as counted with mut = 0;
    i = 0;
    while (i < n) { if (devs[i*2] == cls) { counted = counted + 1; } i = i + 1; }
    let is i64 as dc = sys.dev_count(cls);
    check(cast(*u8, "dev_count == enum"), dc == counted, dc, counted);

    // An index past the end is E_NOENT, never a silent alias of instance 0.
    let is [8]i64 as bad;
    let is i64 as rc = sys.dev_info(cls, 999, cast(*i64, &bad[0]));
    check(cast(*u8, "index 999 refused"), rc < 0, rc, 0 - 1);
    return;
}

// fd 0, 1 and 2 belong to stdin, stdout and stderr, and nothing that hands
// out a descriptor may put anything there — not even when the slots are empty,
// which they are for any program launched without a shell to fill them.
//
// This is checked from ring 3 rather than left to the kernel's own smoke
// because the kernel's runs only in the smoke boot flavour, which is off. It
// earns its place: an fd that landed on 1 once made every print in a test go
// down a daemon's channel instead, and what failed was a program three steps
// away that never got an answer.
fn test_fd_reservation() as void {
    say("reserved descriptors:\n");

    // A negative fd fails this too, which is what we want: it means the open
    // itself broke and the number is meaningless.
    let is i64 as f = sys.open_read(cast(*u8, "/init.cse"));
    check(cast(*u8, "open never returns 0, 1 or 2"), f >= 3, f, 3);
    if (f >= 0) { sys.close(f); }

    let is [2]i64 as ch;
    let is i64 as cr = sys.channel_create(cast(*i64, &ch[0]));
    check(cast(*u8, "a channel pair is made"), cr == 0, cr, 0);
    if (cr == 0) {
        check(cast(*u8, "neither end is reserved"), ch[0] >= 3 && ch[1] >= 3, 1, 1);
        check(cast(*u8, "and they are distinct"), ch[0] != ch[1], 1, 1);
        sys.close(ch[0]);
        sys.close(ch[1]);
    }

    // And the slot really is still free afterwards: a write to it falls back
    // to serial rather than reaching anything, which is what makes leaving it
    // empty safe in the first place.
    let is i64 as g = sys.open_read(cast(*u8, "/init.cse"));
    check(cast(*u8, "a reused slot is still not reserved"), g >= 3, g, 3);
    if (g >= 0) { sys.close(g); }
    return;
}

// ------------------------------------------------------------------
// Descriptor races between threads of one process.
//
// The kernel looked an fd up and then used the object with no reference of
// its own, so a sibling thread closing the fd in between could free it under
// a syscall that was still using it. And close itself read the object, then
// cleared the slot, then dropped the reference — two threads closing one fd
// could both get that far and drop it twice.
// ------------------------------------------------------------------

let is i64 as race_fd with mut = 0 - 1;
let is i64 as race_go with mut = 0;
let is i64 as race_rc with mut = 0;
let is i64 as race_done with mut = 0;

fn closer(arg as i64) as void {
    // getpid in the spin: a call the compiler cannot hoist the load out of.
    while (race_go == 0) { sys.getpid(); }
    race_rc = cast(i64, sys.close(race_fd));
    race_done = 1;
    sys.thread_exit(0);
    return;
}

let is i64 as reader_fd with mut = 0 - 1;
let is i64 as reader_n with mut = 0;
let is i64 as reader_done with mut = 0;
let is [8]u8 as reader_buf with mut;

fn reader(arg as i64) as void {
    reader_n = sys.read(reader_fd, cast(*u8, &reader_buf[0]), 8);
    reader_done = 1;
    sys.thread_exit(0);
    return;
}

fn wait_flag(flag as *i64, ms as i64) as i64 {
    let is i64 as spins with mut = 0;
    while (flag[0] == 0 && spins < ms) { sys.sleep_ns(1000000); spins = spins + 1; }
    return flag[0];
}

fn test_fd_races() as void {
    say("descriptor races:\n");
    // Three stacks: the closers alternate between two, so a round's thread
    // never starts on the stack the previous one may still be leaving on; the
    // reader gets the third.
    let is i64 as STACK = 65536;
    let is i64 as sp = sys.mmap(cast(i64, 0), STACK * 3, sys.PROT_READ | sys.PROT_WRITE);
    if (sp < 0) { check(cast(*u8, "race stacks"), 0, sp, 0); return; }

    // Two threads close one fd at the same moment, many times over: exactly
    // one close may succeed, every time.
    let is i64 as ROUNDS = 200;
    let is i64 as bad_rounds with mut = 0;
    let is i64 as both_ok with mut = 0;
    let is i64 as r with mut = 0;
    while (r < ROUNDS) {
        let is [2]i64 as ch;
        if (sys.channel_create(cast(*i64, &ch[0])) != 0) { bad_rounds = bad_rounds + 1; r = ROUNDS; }
        else {
            race_fd = ch[0];
            race_go = 0;
            race_done = 0;
            race_rc = 99;
            let is i64 as top = (sp + STACK * ((r & 1) + 1)) & (0 - 16);
            if (sys.thread_spawn(cast(i64, fn_ptr(closer)), 0, top) <= 0) { bad_rounds = bad_rounds + 1; }
            sys.sleep_ns(200000);
            race_go = 1;
            let is i64 as mine = cast(i64, sys.close(ch[0]));
            if (wait_flag(&race_done, 2000) == 0) {
                say("    round "); say_num(r); say(": the closer never finished\n");
                bad_rounds = bad_rounds + 1;
                r = ROUNDS;
            }
            let is i64 as wins with mut = 0;
            if (mine == 0) { wins = wins + 1; }
            if (race_rc == 0) { wins = wins + 1; }
            if (wins == 2) { both_ok = both_ok + 1; }
            if (wins != 1) {
                bad_rounds = bad_rounds + 1;
                say("    round "); say_num(r); say(": mine="); say_num(mine);
                say(" theirs="); say_num(race_rc); say(" done="); say_num(race_done); say("\n");
            }
            sys.close(ch[1]);
        }
        r = r + 1;
    }
    check(cast(*u8, "a racing double close succeeds exactly once"), bad_rounds == 0, bad_rounds, 0);
    check(cast(*u8, "never both"), both_ok == 0, both_ok, 0);

    // A thread blocked reading an fd that another thread closes: the read
    // still holds the object, so it completes when data comes — on memory
    // that is still the channel — and the endpoint goes away once it returns.
    let is [2]i64 as c2;
    if (sys.channel_create(cast(*i64, &c2[0])) != 0) { check(cast(*u8, "channel"), 0, 0, 1); sys.munmap(sp, STACK * 3); return; }
    reader_fd = c2[0];
    reader_done = 0;
    reader_n = 0;
    let is i64 as rt = sys.thread_spawn(cast(i64, fn_ptr(reader)), 0, (sp + STACK * 3) & (0 - 16));
    check(cast(*u8, "reader thread"), rt > 0, rt, 1);
    sys.sleep_ns(30000000);                       // let it block in read
    let is i64 as cr = cast(i64, sys.close(c2[0]));
    check(cast(*u8, "close under a blocked read"), cr == 0, cr, 0);
    let is i64 as wr = sys.write(c2[1], cast(*u8, "x"), 1);
    check(cast(*u8, "the held endpoint still takes a write"), wr == 1, wr, 1);
    wait_flag(&reader_done, 2000);
    check(cast(*u8, "the blocked read completes with it"), reader_n == 1, reader_n, 1);
    // The read returned, its reference went with it, and that was the last:
    // the peer now finds the other side gone.
    let is i64 as gone with mut = 0;
    let is i64 as tries with mut = 0;
    while (gone == 0 && tries < 200) {
        if (sys.write(c2[1], cast(*u8, "y"), 1) == sys.E_PIPE) { gone = 1; }
        else { sys.sleep_ns(1000000); }
        tries = tries + 1;
    }
    check(cast(*u8, "and the endpoint is released after"), gone == 1, gone, 1);
    sys.close(c2[1]);
    sys.sleep_ns(10000000);                       // the last threads finish leaving
    sys.munmap(sp, STACK * 3);
    return;
}

fn main() as i32 {
    say("kabi: phase-A syscalls from ring 3\n");
    test_thread();
    test_events();
    test_devs();
    test_fd_reservation();
    test_fd_races();
    if (fails == 0) { say("kabi: PASS\n"); return cast(i32, 0); }
    say("kabi: FAIL n="); say_num(fails); say("\n");
    return cast(i32, 1);
}
