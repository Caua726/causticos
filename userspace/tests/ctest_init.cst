// ctest_init.cst — a headless test harness for the category-C tools. Booted as
// /init.cse, it writes a known file and then spawns each tool with argv. A
// spawned child starts with an EMPTY fd table, so its write(1) returns E_BADF
// and the sys.write facade falls back to the serial console — every tool's
// stdout lands in the boot log, deterministic, no GUI to drive.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;

fn ser(s as *u8) as void { sys.write_serial(s, prog.slen(s)); }

fn page_round(n as i64) as i64 { return (n + 4095) / 4096 * 4096; }

// load a .cse image off the disk into a fresh mapping; returns base, sets *len.
fn load(path as *u8, out_len as *i64) as i64 {
    let is [4]i64 as st;
    if (sys.stat(path, cast(*u8, &st[0])) != 0) { out_len[0] = 0; return 0; }
    let is i64 as size = st[0];
    if (size <= 0) { out_len[0] = 0; return 0; }
    let is i64 as mapped = page_round(size);
    let is i64 as va = sys.mmap(0, mapped, sys.PROT_READ | sys.PROT_WRITE);
    if (va < 0) { out_len[0] = 0; return 0; }
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { out_len[0] = 0; return 0; }
    let is i64 as got with mut = 0;
    while (got < size) {
        let is i64 as r = sys.read(fd, cast(*u8, va + got), size - got);
        if (r <= 0) { break; }
        got = got + r;
    }
    sys.close(fd);
    out_len[0] = got;
    return va;
}

// runv: spawn `path` with up to 4 argv words (a1..a3 may be 0 = absent), echo
// the command line to serial, wait for it to finish.
fn runv(path as *u8, a0 as *u8, a1 as *u8, a2 as *u8, a3 as *u8) as void {
    ser("\n$ "); ser(a0);
    if (cast(i64, a1) != 0) { ser(" "); ser(a1); }
    if (cast(i64, a2) != 0) { ser(" "); ser(a2); }
    if (cast(i64, a3) != 0) { ser(" "); ser(a3); }
    ser("\n");
    let is i64 as len with mut = 0;
    let is i64 as img = load(path, &len);
    if (img == 0) { ser("[load fail]\n"); return; }
    let is [8]i64 as av;
    let is i64 as argc with mut = 1;
    av[0] = cast(i64, a0); av[1] = prog.slen(a0);
    if (cast(i64, a1) != 0) { av[2] = cast(i64, a1); av[3] = prog.slen(a1); argc = 2; }
    if (cast(i64, a2) != 0) { av[4] = cast(i64, a2); av[5] = prog.slen(a2); argc = 3; }
    if (cast(i64, a3) != 0) { av[6] = cast(i64, a3); av[7] = prog.slen(a3); argc = 4; }
    let is i64 as pid = sys.spawn(cast(*u8, img), len, cast(*u8, 0), 0, cast(*u8, &av[0]), argc);
    if (pid < 0) { ser("[spawn fail]\n"); sys.munmap(img, page_round(len)); return; }
    let is [1]i64 as stt;
    sys.wait(pid, cast(*i64, &stt[0]));
    sys.munmap(img, page_round(len));
}

fn main(argc as i64, argv as *u8) as i32 {
    ser("\n##### CTEST-C begin #####\n");
    let is i64 as fd = syscall(sys.SYS_OPEN, "/ct.txt", 7, sys.O_WRONLY | sys.O_CREAT | sys.O_TRUNC);
    if (fd >= 0) {
        let is *u8 as data = "banana\napple\ncherry\napple\ndate\n";
        sys.write(fd, data, prog.slen(data));
        sys.close(fd);
        ser("[wrote /ct.txt: 5 lines]\n");
    } else { ser("[/ct.txt create FAILED]\n"); }

    let is *u8 as z = cast(*u8, 0);
    runv("/wc.cse",      "wc",      "/ct.txt", z, z);
    runv("/head.cse",    "head",    "-n", "2", "/ct.txt");
    runv("/tail.cse",    "tail",    "-n", "2", "/ct.txt");
    runv("/sort.cse",    "sort",    "/ct.txt", z, z);
    runv("/uniq.cse",    "uniq",    "/ct.txt", z, z);
    runv("/grep.cse",    "grep",    "apple", "/ct.txt", z);
    runv("/rev.cse",     "rev",     "/ct.txt", z, z);
    runv("/tac.cse",     "tac",     "/ct.txt", z, z);
    runv("/cut.cse",     "cut",     "-c", "1-3", "/ct.txt");
    runv("/seq.cse",     "seq",     "1", "5", z);
    runv("/hexdump.cse", "hexdump", "/ct.txt", z, z);
    runv("/stat.cse",    "stat",    "/ct.txt", z, z);
    runv("/du.cse",      "du",      "/", z, z);
    runv("/find.cse",    "find",    "/", "txt", z);
    runv("/cp.cse",      "cp",      "/ct.txt", "/c2.txt", z);
    runv("/cat.cse",     "cat",     "/c2.txt", z, z);
    runv("/mkdir.cse",   "mkdir",   "/td", z, z);
    runv("/ls.cse",      "ls",      "/", z, z);
    runv("/rmdir.cse",   "rmdir",   "/td", z, z);

    ser("\n##### CTEST-C done #####\n");
    while (1 == 1) { sys.sleep_ns(1000000000); }   // stay alive; the harness kills qemu
    return 0;
}
