// csiftest — load a .csif, print its dims + an additive pixel checksum.
// The checksum cross-checks against scripts/png2csif.py's own sum so a live run
// proves the in-OS decoder matches the host reference byte-for-byte.
//   csiftest [/path.csif]     (defaults to /test.csif)
use "std/causticos/img/csif.cst" as csif;
use "std/causticos/prog.cst" as prog;

fn main(argc as i64, argv as *u8) as i32 {
    let is *u8 as path with mut = cast(*u8, "/test.csif");
    if (argc > 1) { path = prog.arg(argv, 1); }

    let is csif.Image as im = csif.load(path);
    if (im.ok == 0) {
        prog.outs("csiftest: FAIL err="); prog.out_num(im.err); prog.outs("\n");
        return cast(i32, 1);
    }

    let is i64 as total = im.width * im.height * im.nchan;
    let is *u8 as px = im.pixels;
    let is i64 as sum with mut = 0;
    let is i64 as i with mut = 0;
    while (i < total) { sum = (sum + cast(i64, px[i])) & 0x7FFFFFFF; i = i + 1; }

    prog.outs("csiftest: ok ");
    prog.out_num(im.width); prog.outs("x"); prog.out_num(im.height);
    prog.outs(" nchan="); prog.out_num(im.nchan);
    prog.outs(" bytes="); prog.out_num(total);
    prog.outs(" sum="); prog.out_num(sum); prog.outs("\n");

    csif.free(&im);
    return cast(i32, 0);
}
