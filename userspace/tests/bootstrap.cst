// bootstrap.cst — one round of the self-host bootstrap, run as /init.
//
// scripts/bootstrap.sh boots causticos from a disk holding this as /init, the
// round's compiler as /caustic.cse, and the compiler's own source at /src,
// /std, /caustic-assembler and /caustic-linker. This has that compiler build
// /src/main.cst into /out.cse — on CausticOS, as an ordinary process — and the
// script lifts /out.cse off the disk as the next round's compiler. Every round
// must come out byte-identical to the compiler the dev profile ships.
//
// The compile gets the flags the host build gave the shipped compiler: the
// script writes them to /etc/bootstrap.args, one per line, because a flag that
// stamps the binary (--app-version) is part of its bytes. The compiler's
// stdout and stderr come back here over a channel and go to the serial line —
// the only thing the script can read while the machine runs — so a failed
// round shows the compiler's own error instead of just an exit code.
//
// The round ends by powering the machine off, pass or fail: that is what makes
// the kernel write /out.cse and the FAT behind it out to the disk before the
// script reads the image. Killing the VM at the marker could catch a file still
// in the write-behind buffer.
use "std/os/causticos.cst" as sys;

fn slen(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn log(s as *u8) as void { sys.write_serial(s, slen(s)); }

fn lognum(n as i64) as void {
    if (n == 0) { sys.write_serial("0", 1); return; }
    let is [24]u8 as b;
    let is i64 as v with mut = n;
    let is i64 as neg with mut = 0;
    if (v < 0) { neg = 1; v = 0 - v; }
    let is i64 as p with mut = 23;
    while (v > 0) { b[p] = cast(u8, (v % 10) + 48); v = v / 10; p = p - 1; }
    if (neg == 1) { b[p] = 45; p = p - 1; }
    sys.write_serial(cast(*u8, cast(i64, &b[0]) + p + 1), 23 - p);
}

fn power_off() as void {
    sys.power_request(sys.POWER_OFF);
}

fn fail(why as *u8) as i32 {
    log("bootstrap: FAILED: "); log(why); log("\n");
    power_off();
    return 1;
}

// Free memory right now, in KiB — logged with each heartbeat so a round that
// runs out says how close it came, and the script can size the machine.
fn free_kb() as i64 {
    let is [8]i64 as mi;
    if (sys.mem_info(cast(*i64, &mi[0])) != 0) { return 0 - 1; }
    return mi[1] * mi[2] / 1024;
}

// /etc/bootstrap.args, one argument per line, split in place.
let is [1024]u8 as argsbuf with mut;

// Copy what the compiler wrote to the serial line. 0 once its end is closed.
fn drain(fd as i64) as i64 {
    let is [3]i64 as pe;
    pe[0] = fd; pe[1] = sys.POLL_READABLE; pe[2] = 0;
    sys.poll(cast(*i64, &pe[0]), 1, 1000000000);
    if (pe[2] == 0) { return 1; }
    let is [512]u8 as b;
    let is i64 as n = sys.read(fd, cast(*u8, &b[0]), 512);
    if (n > 0) { sys.write_serial(cast(*u8, &b[0]), n); return 1; }
    if (n == sys.E_AGAIN) { return 1; }
    return 0;
}

// ── Assembly beside a source ─────────────────────────────────────
// A `.s` used to appear next to EVERY source a build compiled, asked for or
// not — written as a "debug cache" that nothing read back. It is written only
// when `--emit-asm` asks now, and that is checked here, on CausticOS, with a
// program small enough to compile in a blink: once without the flag, once with
// it, and the file beside the source has to follow.
fn tiny_source() as i32 {
    let is *u8 as text = "fn main() as i32 { return 0; }\n";
    let is i64 as fd = sys.open_write("/t.cst");
    if (fd < 0) { return 0 - 1; }
    let is i64 as n = sys.write(fd, text, slen(text));
    sys.close(fd);
    if (n != slen(text)) { return 0 - 1; }
    return 0;
}

// The round's compiler on /t.cst, `with_asm` asking for the assembly. Returns
// the compiler's exit code, or -1 when it could not be started.
fn tiny_compile(with_asm as i32) as i64 {
    let is [16]i64 as av;
    av[0] = cast(i64, "caustic");                av[1] = 7;
    av[2] = cast(i64, "/t.cst");                 av[3] = 6;
    av[4] = cast(i64, "-o");                     av[5] = 2;
    av[6] = cast(i64, "/t.cse");                 av[7] = 6;
    av[8] = cast(i64, "--target=caustic-x86_64"); av[9] = 23;
    let is i32 as ac with mut = 5;
    if (with_asm == 1) { av[10] = cast(i64, "--emit-asm"); av[11] = 10; ac = 6; }

    let is [2]i64 as ch;
    if (sys.channel_create(cast(*i64, &ch[0])) != 0) { return 0 - 1; }
    let is [4]i64 as fda;
    fda[0] = 1; fda[1] = ch[1];
    fda[2] = 2; fda[3] = ch[1];
    let is i64 as pid = sys.spawn_path("/caustic.cse", cast(*u8, &fda[0]), 2, cast(*u8, &av[0]), ac);
    sys.close(ch[1]);
    if (pid < 0) { sys.close(ch[0]); return 0 - 1; }
    while (drain(ch[0]) == 1) { }
    sys.close(ch[0]);
    let is i64 as status with mut = 0;
    return sys.wait_exit(pid, &status);
}

// Both halves of it: no assembly unless it is asked for, and the assembly when
// it is. The file has to be gone before each compile, or the check would pass
// on a leftover.
fn check_assembly_is_asked_for() as i32 {
    if (tiny_source() != 0) { return fail("cannot write /t.cst"); }
    sys.unlink("/t.cst.s");
    let is [4]i64 as st;
    if (tiny_compile(0) != 0) { return fail("the compile without --emit-asm"); }
    if (sys.stat("/t.cst.s", cast(*u8, &st[0])) == 0) {
        return fail("a .s appeared beside the source without --emit-asm");
    }
    log("bootstrap: no assembly beside the source, unasked\n");
    if (tiny_compile(1) != 0) { return fail("the compile with --emit-asm"); }
    if (sys.stat("/t.cst.s", cast(*u8, &st[0])) != 0) {
        return fail("--emit-asm wrote no assembly beside the source");
    }
    log("bootstrap: --emit-asm wrote "); lognum(st[0]); log(" bytes beside the source\n");
    return 0;
}

fn main(argc as i64, argv as *u8) as i32 {
    log("bootstrap: compiling /src/main.cst on CausticOS\n");

    let is [64]i64 as av;
    let is i64 as ac with mut = 0;
    av[0] = cast(i64, "caustic");        av[1] = 7;
    av[2] = cast(i64, "/src/main.cst");  av[3] = 13;
    av[4] = cast(i64, "-o");             av[5] = 2;
    av[6] = cast(i64, "/out.cse");       av[7] = 8;
    // -q: the per-function progress would pour ~90 KB onto the serial line.
    // No --emit-asm: the .s is not written unless it is asked for, and this
    // compile wants only the executable.
    av[8] = cast(i64, "-q");             av[9] = 2;
    ac = 5;

    let is i64 as afd = sys.open_read("/etc/bootstrap.args");
    if (afd < 0) { return fail("no /etc/bootstrap.args (the flags the shipped compiler was built with)"); }
    let is i64 as an = sys.read(afd, cast(*u8, &argsbuf[0]), 1023);
    sys.close(afd);
    if (an < 0) { return fail("cannot read /etc/bootstrap.args"); }
    argsbuf[an] = cast(u8, 0);
    let is i64 as i with mut = 0;
    while (i < an && ac < 32) {
        let is i64 as st = i;
        while (i < an && argsbuf[i] != cast(u8, 10)) { i = i + 1; }
        let is i64 as len = i - st;
        argsbuf[i] = cast(u8, 0);
        if (len > 0) {
            av[ac * 2] = cast(i64, &argsbuf[st]);
            av[ac * 2 + 1] = len;
            log("bootstrap: flag "); sys.write_serial(cast(*u8, &argsbuf[st]), len); log("\n");
            ac = ac + 1;
        }
        i = i + 1;
    }

    let is [2]i64 as ch;
    if (sys.channel_create(cast(*i64, &ch[0])) != 0) { return fail("no channel for the compiler's output"); }
    let is [4]i64 as fda;
    fda[0] = 1; fda[1] = ch[1];
    fda[2] = 2; fda[3] = ch[1];

    let is i64 as t0 = sys.time_ns();
    log("bootstrap: free before the compile: "); lognum(free_kb()); log(" KB\n");
    let is i64 as pid = sys.spawn_path("/caustic.cse", cast(*u8, &fda[0]), 2, cast(*u8, &av[0]), ac);
    sys.close(ch[1]);
    if (pid < 0) {
        log("bootstrap: cannot start /caustic.cse: "); log(sys.err_text(pid)); log("\n");
        return fail("spawn");
    }

    // Until the compiler's end of the channel closes — it exited — copy its
    // output and say every 10 s that it is still going.
    let is i64 as next_beat with mut = t0 + 10000000000;
    let is i64 as low with mut = free_kb();
    while (drain(ch[0]) == 1) {
        let is i64 as f = free_kb();
        if (f >= 0 && f < low) { low = f; }
        let is i64 as now = sys.time_ns();
        if (now >= next_beat) {
            log("bootstrap: still compiling, "); lognum((now - t0) / 1000000000);
            log(" s, "); lognum(f); log(" KB free\n");
            next_beat = next_beat + 10000000000;
        }
    }
    sys.close(ch[0]);

    // The output has ended, so the child is gone or about to be; wait_exit
    // waits past SYS_WAIT's window for it either way.
    let is i64 as status with mut = 0;
    let is i64 as r = sys.wait_exit(pid, &status);
    let is i64 as secs = (sys.time_ns() - t0) / 1000000000;
    log("bootstrap: compiler exited code="); lognum(r);
    log(" after "); lognum(secs); log(" s; least free memory "); lognum(low); log(" KB\n");
    if (r != 0) { return fail("the compile"); }

    let is [4]i64 as st2;
    if (sys.stat("/out.cse", cast(*u8, &st2[0])) != 0) { return fail("/out.cse not written"); }
    log("bootstrap: /out.cse written, "); lognum(st2[0]); log(" bytes\n");
    let is i32 as asmrc = check_assembly_is_asked_for();
    if (asmrc != 0) { return asmrc; }
    log("bootstrap: ROUND DONE\n");
    power_off();
    return 0;
}
