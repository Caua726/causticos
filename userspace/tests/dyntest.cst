// dyntest.cst — calls into TWO shared libraries. None of their code is in this
// binary: the kernel maps both at spawn and patches every call site.
use "std/causticos/prog.cst" as prog;
use "../lib/dyndemo/dyndemo.cst" as d;
use "../lib/dyndemo2/dyndemo2.cst" as d2;

fn main(argc as i64, argv as *u8) as i32 {
    prog.outs("dyntest: calling into the shared libraries\n");
    d.greet();
    prog.outs("dyntest: add(20,22) = ");
    prog.out_num(d.add(20, 22));
    prog.outs("\ndyntest: mul(6,7)   = ");
    prog.out_num(d2.mul(6, 7));
    prog.outs("\n");
    return 0;
}
