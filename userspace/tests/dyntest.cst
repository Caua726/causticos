// dyntest.cst — calls into /lib/libdyndemo.csl. Nothing of dyndemo's code is
// in this binary: the kernel resolves both calls at spawn.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../lib/dyndemo/dyndemo.cst" as d;

fn main(argc as i64, argv as *u8) as i32 {
    prog.outs("dyntest: calling into the shared library\n");
    d.greet();
    let is i64 as n = d.add(20, 22);
    prog.outs("dyntest: add(20,22) = ");
    prog.out_num(n);
    prog.outs("\n");
    return 0;
}
