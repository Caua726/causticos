// pingt — the network, end to end, as a gate.
//
// nett proves the protocol libraries against a table of known packets, with no
// hardware. This proves the other half, which no table can: that frames really
// leave the machine, that something on the other side really answers, and that
// what comes back is what was sent.
//
// It spawns the REAL ping binary rather than reimplementing its logic. A test
// that reimplements what it tests can pass while the shipped program is
// broken, and the two drift apart the moment one of them is fixed. So this
// runs `ping -c N -i PORT GATEWAY`, waits, and reads its exit status — which
// is already the honest summary, since ping exits non-zero when nothing came
// back.
//
// Each port is on a network of its own, and each pings the gateway DHCP gave
// IT: this starts netd, waits for both leases, and hands ping the gate, so
// ping takes its address from the same lease. The test used to ping 10.0.2.2
// from both ports — the first network's gateway, unreachable from the second.
// Nothing here names an address: what answers is whatever the lease says.

use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;
use "../lib/netproto/netproto.cst" as np;
use "../lib/netcli/netcli.cst" as nc;
use "../lib/netcli/netsvc.cst" as netsvc;

let is i64 as fails with mut = 0;

fn say(t as *u8) as void {
    prog.outs(t);
    let is i64 as n with mut = 0;
    while (t[n] != cast(u8, 0)) { n = n + 1; }
    sys.write_serial(t, n);
    return;
}

fn say_num(v as i64) as void {
    prog.out_num(v);
    let is i64 as x with mut = v;
    if (x < 0) { sys.write_serial(cast(*u8, "-"), 1); x = 0 - x; }
    if (x == 0) { sys.write_serial(cast(*u8, "0"), 1); return; }
    let is [24]u8 as b;
    let is i64 as i with mut = 24;
    while (x > 0) { i = i - 1; b[i] = cast(u8, 48 + (x % 10)); x = x / 10; }
    sys.write_serial(cast(*u8, &b[i]), 24 - i);
    return;
}

fn check(name as *u8, got as i64, want as i64) as void {
    if (got == want) { say("  ok   "); } else { say("  FAIL "); fails = fails + 1; }
    say(name);
    say(" got="); say_num(got);
    say(" want="); say_num(want);
    say("\n");
    return;
}

fn wait_done(pid as i64) as i64 {
    let is [1]i64 as st;
    st[0] = 0;
    let is i64 as r = sys.wait_exit(pid, cast(*i64, &st[0]));
    if (r < 0) { return r; }
    return st[0];
}

// The dotted form of an address, for ping's command line.
fn ip_text(v as i64, out as *u8) as *u8 {
    let is i64 as o with mut = 0;
    let is i64 as k with mut = 3;
    while (k >= 0) {
        let is i64 as part = (v >> (k * 8)) & 255;
        if (part >= 100) { out[o] = cast(u8, 48 + part / 100); o = o + 1; }
        if (part >= 10) { out[o] = cast(u8, 48 + (part / 10) % 10); o = o + 1; }
        out[o] = cast(u8, 48 + part % 10); o = o + 1;
        if (k > 0) { out[o] = cast(u8, 46); o = o + 1; }
        k = k - 1;
    }
    out[o] = cast(u8, 0);
    return out;
}

// Run ping against `dst` from network port `port`, returning its exit status.
// The child gets our stdout, so its output lands in the same log as ours —
// what the round trip actually measured is worth seeing, not just whether it
// happened — and netd's gate, so it takes the port's address from the lease.
fn run_ping(port_str as *u8, dst as i64, count as *u8) as i64 {
    let is [20]u8 as dtext;
    let is *u8 as d = ip_text(dst, cast(*u8, &dtext[0]));
    let is [12]i64 as av;
    av[0] = cast(i64, "ping");  av[1] = 4;
    av[2] = cast(i64, "-c");    av[3] = 2;
    av[4] = cast(i64, count);   av[5] = prog.slen(count);
    av[6] = cast(i64, "-i");    av[7] = 2;
    av[8] = cast(i64, port_str); av[9] = prog.slen(port_str);
    av[10] = cast(i64, d);      av[11] = prog.slen(d);
    let is [4]i64 as fda;
    fda[0] = 1; fda[1] = 1;                     // child fd 1 = our fd 1
    fda[2] = np.NET_FD; fda[3] = netsvc.gate(); // and netd's gate
    let is i64 as pid = sys.spawn_path(cast(*u8, "/ping.cse"), cast(*u8, &fda[0]), 2,
                                       cast(*u8, &av[0]), 6);
    if (pid < 0) { return pid; }
    return wait_done(pid);
}

// Port `port`'s lease into out[0..2] (address, netmask, gateway): 1 once netd
// has one, 0 when none came within 15 s. DHCP takes a few round trips.
fn lease(port as i64, out as *i64) as i64 {
    let is i64 as deadline = sys.time_ns() + 15000000000;
    while (sys.time_ns() < deadline) {
        let is [4]i64 as info;
        if (nc.iface_info(port, cast(*i64, &info[0])) == 0 && info[0] != 0 && info[2] != 0) {
            out[0] = info[0]; out[1] = info[1]; out[2] = info[2];
            return 1;
        }
        sys.sleep_ns(100000000);
    }
    return 0;
}

fn main() as i32 {
    say("pingt: icmp round trip over real frames\n");

    let is [4]i64 as ist;
    if (sys.stat(cast(*u8, "/ping.cse"), cast(*u8, &ist[0])) != 0 || ist[0] <= 0) {
        say("pingt: /ping.cse not on disk\n");
        return cast(i32, 1);
    }

    let is i64 as ports = sys.dev_count(sys.DEV_NET);
    check(cast(*u8, "network ports present"), ports, 2);

    // The network this boot has, the way /init gets it: netd, and its gate.
    let is i64 as rc = netsvc.start();
    check(cast(*u8, "netd answers"), rc, 0);
    if (rc != 0) { say("pingt: FAIL n="); say_num(fails); say("\n"); return cast(i32, 1); }

    let is [3]i64 as l0;
    let is [3]i64 as l1;
    l0[0] = 0; l0[1] = 0; l0[2] = 0;
    l1[0] = 0; l1[1] = 0; l1[2] = 0;
    check(cast(*u8, "e1000 has a lease"), lease(0, cast(*i64, &l0[0])), 1);
    check(cast(*u8, "virtio-net has a lease"), lease(1, cast(*i64, &l1[0])), 1);

    // Both NICs, each to its own gateway. They are different drivers over
    // different transports — the e1000's DMA rings and virtio's split queues —
    // and a round trip that works on one proves nothing about the other. Two
    // gateways are also two different ARP answers.
    if (l0[2] != 0) {
        check(cast(*u8, "e1000 reaches its gateway"), run_ping(cast(*u8, "0"), l0[2], cast(*u8, "3")), 0);
    }
    if (l1[2] != 0) {
        check(cast(*u8, "virtio-net reaches its gateway"), run_ping(cast(*u8, "1"), l1[2], cast(*u8, "3")), 0);
    }

    // Nothing answers at host 99 of the first port's network. This must FAIL,
    // and failing is the point: a ping that reports success for an address
    // with nothing behind it is worse than no ping, and it is what happens
    // when replies are matched loosely.
    if (l0[0] != 0) {
        let is i64 as dead = (l0[0] & l0[1]) | 99;
        if (dead != l0[0] && dead != l0[2]) {
            check(cast(*u8, "unused address times out"), run_ping(cast(*u8, "0"), dead, cast(*u8, "1")), 1);
        }
    }

    let is i64 as npid = netsvc.pid();
    if (npid > 0) {
        sys.kill(npid);
        let is [1]i64 as st;
        sys.wait_exit(npid, cast(*i64, &st[0]));
    }

    if (fails == 0) { say("pingt: ALL PASS\n"); return cast(i32, 0); }
    say("pingt: FAIL n="); say_num(fails); say("\n");
    return cast(i32, 1);
}
