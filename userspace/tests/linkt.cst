// linkt — watch a port's link state while the host pulls the cable.
//
// nd_link_up returning 0 is a path no test had ever taken: every boot so far
// has had a link that was up before the driver looked and stayed up. A driver
// that returns a plausible constant is indistinguishable from one that reads
// STATUS, and the difference only shows up on the day someone is trying to
// work out why a machine is not talking.
//
// So the host drives it. scripts/test-link.sh boots this with a QEMU monitor
// attached, waits for the marker below, sends `set_link ... off`, then `on`,
// and this reports what the register said. Neither side can fake the result:
// the guest cannot know when the link was cut, and the host cannot see the
// register.

use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;

let is i64 as SAMPLE_NS = 100000000;      // 100 ms
let is i64 as RUN_NS    = 9000000000;     // 9 s, comfortably past the host's script

fn say(t as *u8) as void {
    prog.outs(t);
    let is i64 as n with mut = 0;
    while (t[n] != cast(u8, 0)) { n = n + 1; }
    sys.write_serial(t, n);
    return;
}

fn say_num(v as i64) as void {
    prog.out_num(v);
    let is i64 as x with mut = v;
    if (x < 0) { sys.write_serial(cast(*u8, "-"), 1); x = 0 - x; }
    if (x == 0) { sys.write_serial(cast(*u8, "0"), 1); return; }
    let is [24]u8 as b;
    let is i64 as i with mut = 24;
    while (x > 0) { i = i - 1; b[i] = cast(u8, 48 + (x % 10)); x = x / 10; }
    sys.write_serial(cast(*u8, &b[i]), 24 - i);
    return;
}
struct Port {
    fd as i64;
    last as i64;
    saw_down as i64;
    saw_up_again as i64;
    transitions as i64;
}


fn main() as i32 {
    let is i64 as n = sys.dev_count(sys.DEV_NET);
    if (n <= 0) { say("linkt: no network ports FAIL\n"); return cast(i32, 1); }
    let is i64 as va = sys.mmap(0, n * sizeof(Port), sys.PROT_READ | sys.PROT_WRITE);
    if (va < 0) { say("linkt: cannot allocate port state FAIL\n"); return cast(i32, 1); }
    let is *Port as ports = cast(*Port, va);
    let is [16]i64 as inf;
    let is i64 as i with mut = 0;
    let is i64 as bad with mut = 0;
    while (i < n) {
        ports[i].fd = sys.dev_open(sys.DEV_NET, i, 0);
        ports[i].last = 1;
        ports[i].saw_down = 0; ports[i].saw_up_again = 0;
        ports[i].transitions = 0;
        if (ports[i].fd < 0 || sys.net_info(ports[i].fd, cast(*i64, &inf[0])) != 0) {
            say("linkt: cannot query port "); say_num(i); say(" FAIL\n");
            bad = bad + 1;
        } else if (inf[2] == 0) {
            say("linkt: port "); say_num(i); say(" already down at start FAIL\n");
            bad = bad + 1;
        }
        i = i + 1;
    }
    if (bad == 0) {
        // The host waits for this baseline before cutting either link.
        say("linkt: watching\n");
        let is i64 as deadline = sys.time_ns() + RUN_NS;
        while (sys.time_ns() < deadline) {
            i = 0;
            while (i < n) {
                if (sys.net_info(ports[i].fd, cast(*i64, &inf[0])) != 0) {
                    say("linkt: net_info failed FAIL\n"); bad = bad + 1;
                } else if (inf[2] != ports[i].last) {
                    ports[i].transitions = ports[i].transitions + 1;
                    say("linkt: port "); say_num(i); say(" link ");
                    if (inf[2] != 0) { say("UP\n"); } else { say("DOWN\n"); }
                    if (inf[2] == 0) {
                        ports[i].saw_down = 1;
                        if (inf[3] != 0) {
                            say("linkt: speed reported while down FAIL\n"); bad = bad + 1;
                        }
                    } else if (ports[i].saw_down != 0) {
                        ports[i].saw_up_again = 1;
                    }
                    ports[i].last = inf[2];
                }
                i = i + 1;
            }
            sys.sleep_ns(SAMPLE_NS);
        }
    }
    i = 0;
    while (i < n) {
        if (ports[i].fd >= 0) { sys.close(ports[i].fd); }
        say("linkt: port "); say_num(i); say(" transitions=");
        say_num(ports[i].transitions); say("\n");
        if (ports[i].saw_down == 0 || ports[i].saw_up_again == 0) {
            say("linkt: missing down/up transition FAIL\n"); bad = bad + 1;
        }
        i = i + 1;
    }
    sys.munmap(va, n * sizeof(Port));
    if (bad == 0) { say("linkt: ALL PASS\n"); return cast(i32, 0); }
    return cast(i32, 1);
}
