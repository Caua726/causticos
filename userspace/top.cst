// top — a live process/memory monitor. `top`. Redraws the process table and a
// memory summary, then waits up to 2s for a key (q to quit). Run inside a
// terminal it loops; run bare (no stdin) it draws one frame and exits — so it's
// the same program either way. Clears with form-feed (the terminal homes).
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;

fn state_name(s as i64) as *u8 {
    if (s == 1) { return "alive"; }
    if (s == 2) { return "exiting"; }
    if (s == 3) { return "zombie"; }
    if (s == 4) { return "dead"; }
    return "?";
}

fn draw() as void {
    let is [1]u8 as ff; ff[0] = cast(u8, 12); prog.out(cast(*u8, &ff[0]), 1);   // clear
    let is [4]i64 as mi;
    if (sys.mem_info(cast(*i64, &mi[0])) == 0) {
        let is i64 as pagesz = mi[2];
        let is i64 as totalkb = mi[0] * pagesz / 1024;
        let is i64 as freekb = mi[1] * pagesz / 1024;
        prog.outs("top - mem ");
        prog.out_num(totalkb - freekb); prog.outs("/"); prog.out_num(totalkb);
        prog.outs(" KB used\n");
    }
    let is [384]i64 as ents;
    let is i64 as total = sys.proc_list(cast(*i64, &ents[0]), 64);
    prog.outs("  PID  PPID  STATE      THR        MEM\n");
    let is i64 as n with mut = total;
    if (n > 64) { n = 64; }
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as b = i * 6;
        prog.pad_num(ents[b + 0], 5); prog.outs("  ");
        prog.pad_num(ents[b + 1], 4); prog.outs("  ");
        let is *u8 as st = state_name(ents[b + 2]);
        prog.outs(st);
        let is i64 as k with mut = prog.slen(st);
        while (k < 9) { prog.outs(" "); k = k + 1; }
        prog.pad_num(ents[b + 4], 3); prog.outs("  ");
        prog.pad_num(ents[b + 5], 9);
        prog.out("\n", 1);
        i = i + 1;
    }
    prog.outs("[q to quit]\n");
}

fn main(argc as i64, argv as *u8) as i32 {
    while (1 == 1) {
        draw();
        let is [3]i64 as pe;
        pe[0] = 0;                              // fd 0 = stdin
        pe[1] = sys.POLL_READABLE;
        pe[2] = 0;
        sys.poll(cast(*i64, &pe[0]), 1, 2000000000);   // 2s frame
        let is i64 as got = pe[2];
        if ((got & sys.POLL_ERROR) != 0 || (got & sys.POLL_CLOSED) != 0) { return 0; }  // no terminal → one-shot
        if ((got & sys.POLL_READABLE) != 0) {
            let is [1]u8 as bb;
            let is i64 as r = sys.read(cast(i64, 0), cast(*u8, &bb[0]), 1);
            if (r > 0 && cast(i64, bb[0]) == 113) { return 0; }   // 'q'
        }
    }
    return 0;
}
