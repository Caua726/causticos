// accel.cst — pointer acceleration + cursor position, extracted from
// comp_input. The gain curve is a libinput-style smoothstep ramp: slow and
// precise below a threshold, easing up to a max multiplier with zero slope at
// both ends (no jerk at the transitions), saturating past the top speed.
// All fixed-point; gain is in units of ACCEL_UNIT (256 = 1.0x).
use "comp_state.cst" as s;
use "comp_render.cst" as r;
use "comp_damage.cst" as dmg;

fn clamp_cursor() as void {
    if (s.mx < 0) { s.mx = 0; }
    if (s.my < 0) { s.my = 0; }
    if (s.mx >= s.scr_w) { s.mx = s.scr_w - 1; }
    if (s.my >= s.scr_h) { s.my = s.scr_h - 1; }
    return;
}

// accel_gain — the fixed-point gain (base ACCEL_UNIT) for a packet whose L1
// speed is v, using THIS device's curve. FLAT ignores v. ADAPTIVE: gain sits
// at p.base up to p.threshold (precise slow tracking), then follows smoothstep
// t²(3-2t) from base to p.max across [threshold, vmax], then saturates. The
// cubic has zero derivative at t=0 and t=1, so the feel ramps in and out
// smoothly instead of the old linear kink.
fn accel_gain(p as *s.Ptr, v as i64) as i64 {
    if (p.profile == 0) { return p.flat; }
    if (v <= p.threshold) { return p.base; }
    if (v >= p.vmax) { return p.max; }
    // t in [0, 256] across the ramp window.
    let is i64 as t = (v - p.threshold) * 256 / (p.vmax - p.threshold);
    // smoothstep(t) = t²(3-2t), scaled to 256: st = t²(768 - 2t) / 65536.
    let is i64 as st = t * t * (768 - 2 * t) / 65536;
    return p.base + (p.max - p.base) * st / 256;
}

// accel_move — dy already in screen orientation: caller passes -dy so + = down.
// The sub-pixel remainder is carried per axis AND per device: two mice moving
// at once must not steal each other's fraction.
fn accel_move(p as *s.Ptr, dx as i64, dy as i64) as void {
    let is i64 as v = r.iabs(dx) + r.iabs(dy);
    let is i64 as g = accel_gain(p, v);
    let is i64 as ax = r.iabs(dx) * g + p.rem_x;
    let is i64 as mvx = ax / s.ACCEL_UNIT;
    p.rem_x = ax - mvx * s.ACCEL_UNIT;
    if (dx < 0) { s.mx = s.mx - mvx; } else { s.mx = s.mx + mvx; }
    let is i64 as ay = r.iabs(dy) * g + p.rem_y;
    let is i64 as mvy = ay / s.ACCEL_UNIT;
    p.rem_y = ay - mvy * s.ACCEL_UNIT;
    if (dy < 0) { s.my = s.my - mvy; } else { s.my = s.my + mvy; }
    clamp_cursor();
    return;
}

// Cursor moved: damage the OLD + NEW boxes so the next compose redraws it.
fn cursor_moved() as void {
    if (s.mx == s.cur_last_x && s.my == s.cur_last_y) { return; }
    dmg.damage(s.cur_last_x - 13, s.cur_last_y - 13, 28, 32);
    dmg.damage(s.mx - 13, s.my - 13, 28, 32);
    s.cur_last_x = s.mx;
    s.cur_last_y = s.my;
    return;
}
