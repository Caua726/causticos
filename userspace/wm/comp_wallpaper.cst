// compositor/comp_wallpaper.cst — load + blit the desktop wallpaper. Falls back
// to the solid COL_DESKTOP fill when absent.
use "comp_state.cst" as s;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../../../Caustic/std/causticos/img/csif.cst" as csif;
use "../lib/wmproto/wmproto.cst" as wmp;
use "../lib/compo_proto/compo_proto.cst" as cp;

let is i64 as GEN_W    with imut = 96;
let is i64 as GEN_H    with imut = 54;
let is i64 as PARALLAX with imut = 4;    // max px the desktop slides either way

// wallpaper_init — decode a CSIF background once at startup. Tries /etc/
// first, then the root. On any failure wp_ok stays 0 and the desktop uses
// COL_DESKTOP. The decoded pixels live for the compositor's lifetime.
fn wallpaper_init() as void {
    let is csif.Image as im with mut = csif.load(cast(*u8, "/etc/wallpaper.csif"));
    if (im.ok == 0) { im = csif.load(cast(*u8, "/wallpaper.csif")); }
    if (im.ok == 0) {
        // No image on disk: generate one. A stock system gets a live gradient
        // desktop instead of a flat fill, with no asset to ship.
        s.wp_gen_on = 1;
        wp_generate(0);
        s.wp_w = GEN_W; s.wp_h = GEN_H; s.wp_nchan = 3;
        s.wp_pix = cast(i64, &s.wp_gen[0]);
        s.wp_ok = 1;
        sys.write_serial(cast(*u8, "comp: wallpaper generated\n"), 26);
        return;
    }
    s.wp_w = im.width;
    s.wp_h = im.height;
    s.wp_nchan = im.nchan;
    s.wp_pix = cast(i64, im.pixels);
    s.wp_ok = 1;
    wmp.log_kv(cast(*u8, "comp: wallpaper w="), 19, s.wp_w);
    return;
}

// hsl_to_rgb — integer HSL, h in 0..359, s/l in 0..100. Called once per COLUMN
// of the generated tile, never per pixel: a helper call in a per-pixel loop is
// what crashes the compiler's codegen.
fn hsl_to_rgb(h as i64, sa as i64, l as i64) as i64 {
    let is i64 as c = (100 - iabs(2 * l - 100)) * sa * 255 / 10000;
    let is i64 as hp = h * 100 / 60;                       // 0..599, x100
    let is i64 as m2 = hp % 200;
    let is i64 as x = c * (100 - iabs(m2 - 100)) / 100;
    let is i64 as m = l * 255 / 100 - c / 2;
    let is i64 as seg = h / 60;
    let is i64 as r with mut = 0; let is i64 as g with mut = 0; let is i64 as b with mut = 0;
    if (seg == 0)      { r = c; g = x; }
    else if (seg == 1) { r = x; g = c; }
    else if (seg == 2) { g = c; b = x; }
    else if (seg == 3) { g = x; b = c; }
    else if (seg == 4) { r = x; b = c; }
    else               { r = c; b = x; }
    return (((r + m) & 0xFF) << 16) | (((g + m) & 0xFF) << 8) | ((b + m) & 0xFF);
}
fn iabs(v as i64) as i64 { if (v < 0) { return 0 - v; } return v; }

// wp_generate — bake the procedural tile at a hue phase. Hue runs along x and
// lightness along y, so the expensive HSL conversion happens once per column
// and the rows are a plain multiply.
fn wp_generate(phase as i64) as void {
    let is i64 as x with mut = 0;
    while (x < GEN_W) {
        let is i64 as hue = (phase + x * 300 / GEN_W) % 360;
        let is i64 as base = hsl_to_rgb(hue, 42, 46);
        let is i64 as br = (base >> 16) & 0xFF;
        let is i64 as bg = (base >> 8) & 0xFF;
        let is i64 as bb = base & 0xFF;
        let is i64 as y with mut = 0;
        while (y < GEN_H) {
            let is i64 as f = 100 - y * 45 / GEN_H;         // darker toward the bottom
            let is i64 as o = (y * GEN_W + x) * 3;
            s.wp_gen[o]     = cast(u8, br * f / 100);
            s.wp_gen[o + 1] = cast(u8, bg * f / 100);
            s.wp_gen[o + 2] = cast(u8, bb * f / 100);
            y = y + 1;
        }
        x = x + 1;
    }
    return;
}

// wp_anim_tick — re-bake once a second, drifting the hue through a 60 s cycle.
// Returns 1 when the pixels changed (the caller full-damages).
fn wp_anim_tick(now as i64) as i64 {
    if (s.wp_gen_on == 0) { return 0; }
    if (now < s.wp_gen_next) { return 0; }
    s.wp_gen_next = now + 1000000000;
    wp_generate((now / 1000000) % 60000 * 360 / 60000);
    return 1;
}

// wp_parallax — slide the sampled window a few px against the cursor. Returns 1
// when the (quantised) offset actually moved, so the caller only full-damages
// on the few crossings instead of every pointer event.
fn wp_parallax() as i64 {
    if (s.wp_ok == 0 || s.scr_w <= 0 || s.scr_h <= 0) { return 0; }
    let is i64 as ox = s.mx * (2 * PARALLAX) / s.scr_w - PARALLAX;
    let is i64 as oy = s.my * (2 * PARALLAX) / s.scr_h - PARALLAX;
    if (ox == s.wp_off_x && oy == s.wp_off_y) { return 0; }
    s.wp_off_x = ox; s.wp_off_y = oy;
    return 1;
}

// wp_blit — fill the current clip box from the wallpaper, nearest-neighbor
// scaled. XRGB8888 (alpha ignored, opaque base). Same cost as the solid fill.
fn wp_blit() as void {
    let is i64 as x0 = s.clip_x0;
    let is i64 as y0 = s.clip_y0;
    let is i64 as x1 = s.clip_x1;
    let is i64 as y1 = s.clip_y1;
    if (x1 <= x0 || y1 <= y0) { return; }
    let is *u8 as src = cast(*u8, s.wp_pix);
    let is i64 as yy with mut = y0;
    while (yy < y1) {
        let is i64 as py with mut = yy + s.wp_off_y;
        if (py < 0) { py = 0; }
        if (py >= s.scr_h) { py = s.scr_h - 1; }
        let is i64 as sy = py * s.wp_h / s.scr_h;
        let is i64 as srow = sy * s.wp_w * s.wp_nchan;
        let is *u32 as row = cast(*u32, s.fb_base + yy * s.scr_pitch);
        let is i64 as xx with mut = x0;
        while (xx < x1) {
            let is i64 as px with mut = xx + s.wp_off_x;
            if (px < 0) { px = 0; }
            if (px >= s.scr_w) { px = s.scr_w - 1; }
            let is i64 as sp = srow + (px * s.wp_w / s.scr_w) * s.wp_nchan;
            let is i64 as r with mut = cast(i64, src[sp]);
            let is i64 as g with mut = cast(i64, src[sp + 1]);
            let is i64 as b with mut = cast(i64, src[sp + 2]);
            // Night light applies to the desktop too — it is the largest
            // surface on screen. Three LUT reads, inlined: a helper call in a
            // per-pixel loop is what crashes the compiler's codegen.
            if (s.gam_on == 1) {
                r = s.gam_lut[r]; g = s.gam_lut[256 + g]; b = s.gam_lut[512 + b];
            }
            row[xx] = cast(u32, (r << 16) | (g << 8) | b);
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    return;
}
