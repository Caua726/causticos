// compositor/comp_wc.cst — drain the WM's WC channel. The channel carries the
// scene snapshot, surface/decoration attach/detach, damage rects and the
// cursor shape. Reads/mutates scene state in state.cst.
use "comp_state.cst" as s;
use "comp_damage.cst" as dmg;
use "comp_scene.cst" as scn;
use "comp_fx.cst" as fx;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/wmproto/wmproto.cst" as wmp;
use "../lib/compo_proto/compo_proto.cst" as cp;

// apply_style — one metric or colour from the WM's config. A metric change
// moves every frame edge on screen, so it damages everything; the compositor
// has no other way to know which pixels a titlebar height owns.
fn apply_style(key as i64, v as i64) as void {
    if (key == cp.STY_TITLE_H) {
        if (v < 8 || v > 64) { return; }
        s.TITLE_H = v;
    } else if (key == cp.STY_BORDER) {
        if (v < 0 || v > 8) { return; }
        s.BORDER = v;
    } else if (key == cp.STY_BAR_H) {
        if (v < 16 || v > 64) { return; }
        s.BAR_H = v;
    } else if (key == cp.STY_BTN_W) {
        if (v < 8 || v > 64) { return; }
        s.BTN_W = v;
    } else if (key == cp.STY_WALLPAPER) {
        // Off is not only a look: with no image there is nothing to re-bake
        // once a second and nothing for the parallax to slide, and both of
        // those full-damage the screen — a full recompose the desktop was
        // paying for a gradient nobody asked to move.
        if (v == 0) {
            s.wp_ok = 0;
            s.wp_gen_on = 0;
        } else {
            s.wp_ok = s.wp_have;
            if (s.wp_have == 1 && s.wp_pix == cast(i64, &s.wp_gen[0])) { s.wp_gen_on = 1; }
        }
    } else if (key == cp.STY_COL_BORDER_F) { s.COL_BORDER_F = v & 0xFFFFFF; }
    else if (key == cp.STY_COL_BORDER_U) { s.COL_BORDER_U = v & 0xFFFFFF; }
    else if (key == cp.STY_COL_TITLE_F)  { s.COL_TITLE_F = v & 0xFFFFFF; }
    else if (key == cp.STY_COL_TITLE_U)  { s.COL_TITLE_U = v & 0xFFFFFF; }
    else if (key == cp.STY_COL_TEXT)     { s.COL_TEXT = v & 0xFFFFFF; }
    else if (key == cp.STY_COL_BAR)      { s.COL_BAR = v & 0xFFFFFF; }
    else if (key == cp.STY_COL_BAR_ITEM) { s.COL_BAR_ITEM = v & 0xFFFFFF; }
    else if (key == cp.STY_COL_DESKTOP)  { s.COL_DESKTOP = v & 0xFFFFFF; }
    else { return; }
    dmg.damage_all();
    s.needs_compose = 1;
    return;
}

fn handle_wc(m as *i64) as void {
    if (m[0] == cp.MSG_WC_SCENE) {
        let is i64 as i with mut = 0;
        while (i < s.MAX_WIN) { s.cwins[i].used = 0; i = i + 1; }
        s.comp_nz = 0;
        s.scene_pending = m[1];
    } else if (m[0] == cp.MSG_WC_SCENE_ENTRY) {
        let is i64 as win = cp.entry_win(m[1]);
        let is i64 as flags = cp.entry_flags(m[1]);
        if (win >= 0 && win < s.MAX_WIN) {
            s.cwins[win].used = 1;
            s.cwins[win].flags = flags;
            s.cwins[win].x = cp.unpack_x(m[2]);
            s.cwins[win].y = cp.unpack_y(m[2]);
            s.cwins[win].w = cp.unpack_w(m[3]);
            s.cwins[win].h = cp.unpack_h(m[3]);
            // 255 (the WM's "opaque") becomes 256 so the fast path is exact —
            // blending at 255/256 would tint every settled window forever.
            let is i64 as al with mut = cp.entry_alpha(flags);
            if (al >= 255) { al = 256; }
            s.cwins[win].alpha = al;
            s.cwins[win].fblend = cp.entry_fblend(flags);
            // A new window taking focus pulses the screen edge. The WM never
            // asks for this; the compositor reads it off the scene it is given.
            if ((flags & cp.ENTRY_FOCUSED) != 0 && win != s.edge_last) {
                s.edge_last = win;
                fx.focus_pulse(sys.time_ns());
            }
            if (s.comp_nz < s.MAX_WIN) { s.comp_z[s.comp_nz] = win; s.comp_nz = s.comp_nz + 1; }
        }
        if (s.scene_pending > 0) { s.scene_pending = s.scene_pending - 1; }
    } else if (m[0] == cp.MSG_WC_ATTACH_SURFACE) {
        let is i64 as win = m[1];
        if (win >= 0 && win < s.MAX_WIN) {
            let is i64 as seg = sys.fd_recv(s.wc_fd);
            if (seg >= 0) {
                let is i64 as va = sys.mmap_fd(sys.PROT_READ, seg);
                if (va >= 0) {
                    if (s.surfs[win].has == 1) {
                        sys.munmap(s.surfs[win].seg_base, s.surfs[win].seg_pages * 4096);
                        sys.close(s.surfs[win].seg_fd);
                    }
                    s.surfs[win].has = 1;
                    s.surfs[win].seg_fd = seg;
                    s.surfs[win].seg_base = va;
                    s.surfs[win].seg_pages = m[2];
                    s.surfs[win].seg_stride = (m[3] >> 32) & 0xFFFFFFFF;
                    s.surfs[win].is_text = m[3] & 1;
                    s.needs_compose = 1;
                } else {
                    sys.close(seg);
                }
            }
        }
    } else if (m[0] == cp.MSG_WC_DETACH_SURFACE) {
        let is i64 as win = m[1];
        if (win >= 0 && win < s.MAX_WIN && s.surfs[win].has == 1) {
            sys.munmap(s.surfs[win].seg_base, s.surfs[win].seg_pages * 4096);
            sys.close(s.surfs[win].seg_fd);
            s.surfs[win].has = 0;
            s.surfs[win].seg_base = 0;
        }
    } else if (m[0] == cp.MSG_WC_DEC_SURFACE) {
        let is i64 as win = m[1];
        let is i64 as seg = sys.fd_recv(s.wc_fd);
        if (seg >= 0) {
            let is i64 as va = sys.mmap_fd(sys.PROT_READ, seg);
            if (va >= 0) {
                if (win == cp.DEC_TASKBAR_ID) {
                    if (s.tb_dec.has == 1) {
                        sys.munmap(s.tb_dec.seg_base, s.tb_dec.seg_pages * 4096);
                        sys.close(s.tb_dec.seg_fd);
                    }
                    s.tb_dec.has = 1;
                    s.tb_dec.seg_fd = seg;
                    s.tb_dec.seg_base = va;
                    s.tb_dec.seg_pages = m[2];
                    s.needs_compose = 1;
                } else if (win >= 0 && win < s.MAX_WIN) {
                    if (s.decs[win].has == 1) {
                        sys.munmap(s.decs[win].seg_base, s.decs[win].seg_pages * 4096);
                        sys.close(s.decs[win].seg_fd);
                    }
                    s.decs[win].has = 1;
                    s.decs[win].seg_fd = seg;
                    s.decs[win].seg_base = va;
                    s.decs[win].seg_pages = m[2];
                    s.needs_compose = 1;
                } else {
                    sys.munmap(va, m[2] * 4096);
                    sys.close(seg);
                }
            } else {
                sys.close(seg);
            }
        }
    } else if (m[0] == cp.MSG_WC_DEC_DETACH) {
        let is i64 as win = m[1];
        if (win >= 0 && win < s.MAX_WIN && s.decs[win].has == 1) {
            sys.munmap(s.decs[win].seg_base, s.decs[win].seg_pages * 4096);
            sys.close(s.decs[win].seg_fd);
            s.decs[win].has = 0;
            s.decs[win].seg_base = 0;
        }
    } else if (m[0] == cp.MSG_WC_DAMAGE) {
        if (m[1] < 0) { dmg.damage_all(); }
        else { dmg.damage(m[1], m[2], cp.unpack_w(m[3]), cp.unpack_h(m[3])); }
    } else if (m[0] == cp.MSG_WC_OVERLAY) {
        let is i64 as sl = m[1];
        if (sl >= 0 && sl < cp.OVL_SLOTS) {
            let is i64 as ow = cp.unpack_w(m[3]);
            let is i64 as oh = cp.unpack_h(m[3]);
            if (ow <= 0 || oh <= 0) { s.ovl_on[sl] = 0; }
            else {
                s.ovl_on[sl] = 1;
                s.ovl_rect[sl*4+0] = cp.unpack_x(m[2]);
                s.ovl_rect[sl*4+1] = cp.unpack_y(m[2]);
                s.ovl_rect[sl*4+2] = ow;
                s.ovl_rect[sl*4+3] = oh;
            }
            s.needs_compose = 1;
        }
    } else if (m[0] == cp.MSG_WC_STYLE) {
        apply_style(m[1], m[2]);
    } else if (m[0] == cp.MSG_WC_CURSOR) {
        s.cur_shape = m[1];
        s.needs_compose = 1;
    } else if (m[0] == cp.MSG_WC_SHUTDOWN) {
        sys.write_serial(cast(*u8, "comp: shutdown -> poweroff\n"), 26);
        scn.shutdown_screen();
        sys.poweroff();
    }
    return;
}

fn service_wc() as i64 {
    let is [4]i64 as m;
    let is i64 as guard with mut = 0;
    while (1 == 1) {
        let is i64 as r = cp.msg_read(s.wc_fd, &s.wc_fill, cast(*u8, &s.wc_acc[0]), &m[0]);
        if (r < 0) { return 0 - 1; }
        if (r == 0) { return 0; }
        handle_wc(&m[0]);
        guard = guard + 1;
        if (guard > 128) { return 0; }
        let is [3]i64 as pe2;
        pe2[0] = s.wc_fd;
        pe2[1] = sys.POLL_READABLE;
        pe2[2] = 0;
        sys.poll(&pe2[0], 1, 0);
        if ((pe2[2] & sys.POLL_READABLE) == 0) { return 0; }
    }
    return 0;
}
