// wm/scene.cst — push the scene + damage + cursor to the compositor over the
// WC channel. State lives in state.cst (scene_dirty / dmg* / cur_shape, etc.).

use "state.cst" as s;
use "damage.cst" as dmg;
use "../lib/compo_proto/compo_proto.cst" as cp;

fn scene_send(mtype as i64, a as i64, b as i64, c as i64) as i64 {
    return cp.msg_send(s.wc_fd, mtype, a, b, c);
}

// Send the back-to-front snapshot of windows. SCENE_ENTRY order: bottom (last
// in zord) first; top (zord[0]) last. Minimised windows are included — they
// have to be, since their taskbar entry depends on them being in the scene —
// with the minimised flag set so the compositor draws them as a button.
fn send_scene() as void {
    let is i64 as count with mut = 0;
    let is i64 as i with mut = 0;
    while (i < s.MAX_WIN) {
        if (s.wins[i].used == 1 && s.wins[i].state == 2) { count = count + 1; }
        i = i + 1;
    }
    scene_send(cp.MSG_WC_SCENE, count, 0, 0);
    let is i64 as zi with mut = s.nz - 1;
    while (zi >= 0) {
        let is i64 as w = s.zord[zi];
        if (s.wins[w].used == 1 && s.wins[w].state == 2) {
            let is i64 as flags with mut = 0;
            if (zi == 0 && s.wins[w].minimized == 0) { flags = flags | cp.ENTRY_FOCUSED; }
            if (s.wins[w].minimized == 1) { flags = flags | 2; }
            scene_send(cp.MSG_WC_SCENE_ENTRY,
                       cp.entry_a(w, flags),
                       cp.pack_xy(s.wins[w].x, s.wins[w].y),
                       cp.pack_wh(s.wins[w].w, s.wins[w].h));
        }
        zi = zi - 1;
    }
    return;
}

fn flush_to_compositor() as void {
    if (s.scene_dirty == 1) {
        send_scene();
        s.scene_dirty = 0;
    }
    if (s.cur_shape != s.cur_last_shape) {
        scene_send(cp.MSG_WC_CURSOR, s.cur_shape, s.mx, s.my);
        s.cur_last_shape = s.cur_shape;
    }
    if (s.dmg_full == 1) {
        scene_send(cp.MSG_WC_DAMAGE, 0 - 1, 0, 0);
    } else {
        let is i64 as k with mut = 0;
        while (k < s.dmg_n) {
            scene_send(cp.MSG_WC_DAMAGE, s.dmg[k*4+0], s.dmg[k*4+1],
                       cp.pack_wh(s.dmg[k*4+2], s.dmg[k*4+3]));
            k = k + 1;
        }
    }
    s.dmg_n = 0;
    s.dmg_full = 0;
    return;
}

// True when something needs flushing: scene dirty, dmg pending, or cursor
// shape change pending.
fn needs_flush() as i64 {
    if (s.scene_dirty == 1) { return 1; }
    if (s.dmg_full == 1) { return 1; }
    if (s.dmg_n > 0) { return 1; }
    if (s.cur_shape != s.cur_last_shape) { return 1; }
    return 0;
}
