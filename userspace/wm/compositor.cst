// compositor.cst — the CausticOS compositor, MARCO 1 (dumb launcher).
//
// This is the new /init. Today the window manager (wm.cst) is monolithic: it
// opens the framebuffer + input devices itself, composites, and runs policy.
// The compositor/WM split peels that apart in stages; M1 is the smallest, least
// risky step — it ONLY moves device ownership up one level:
//
//   kernel → compositor (/init) → wm → wterm → app
//
// The compositor opens the four hardware device keys it will eventually own
// (framebuffer + keyboard + mouse + tablet), then spawns /wm.cse and HANDS THOSE
// FDS to the WM via spawn fdacts at FIXED fd numbers. The WM does everything
// exactly as before — composition, input, policy — except its device fds now
// arrive as inherited keys instead of dev_open()/gfx.open() calls. No new
// protocol, no input normalization, no compositor-side composition yet. This
// just proves the WM can run as a child of the compositor over passed devices.
//
// FIXED fd map handed to the WM (must match wm.cst's FB_FD/KBD_FD/...):
//   fd 3 = framebuffer surface (DEV_FB)
//   fd 4 = keyboard            (DEV_KEYBOARD)
//   fd 5 = mouse               (DEV_MOUSE)
//   fd 6 = tablet              (DEV_TABLET)
//
// After the spawn the compositor is a dumb launcher: it just waits on the WM so
// it stays alive and reaps it if it ever exits. Later marcos turn this loop into
// the real input-pump + compositor.

use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/wmproto.cst" as wmp;

// Child-side fd numbers the WM expects (see the comment block above).
let is i64 as WM_FB_FD    with imut = 3;
let is i64 as WM_KBD_FD   with imut = 4;
let is i64 as WM_MOUSE_FD with imut = 5;
let is i64 as WM_TAB_FD   with imut = 6;

let is i64 as IMG_CAP with imut = 4194304;   // 4 MiB ceiling (matches SPAWN_IMG_MAX)

// load_image — read /wm.cse off the FAT32 disk into a fresh anonymous mapping.
// Mirrors wterm.cst's read_file: size the file, allocate page-rounded, slurp it.
// Returns the image VA (0 on failure) and writes the byte length to *out_len.
fn load_image(path as *u8, out_len as *i64) as i64 {
    *out_len = 0;
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { return 0; }
    let is i64 as sz = sys.lseek(fd, 0, cast(i32, sys.SEEK_END));
    sys.lseek(fd, 0, cast(i32, sys.SEEK_SET));
    if (sz <= 0 || sz > IMG_CAP) { sys.close(fd); return 0; }
    let is i64 as alloc = (sz + 4095) & (0 - 4096);
    let is i64 as va = sys.mmap(cast(i64, 0), alloc, sys.PROT_READ | sys.PROT_WRITE);
    if (va < 0) { sys.close(fd); return 0; }
    let is i64 as got = sys.read(fd, cast(*u8, va), sz);
    sys.close(fd);
    if (got <= 0) { return 0; }
    *out_len = got;
    return va;
}

fn main() as i32 {
    // 1. Take ownership of the hardware device keys. DEV_FB becomes a surface
    //    fd; the input classes become event-stream fds. We don't touch them
    //    here (no surface_info/mmap, no reads) — they're just handed downward.
    let is i64 as fb_fd    = sys.dev_open(sys.DEV_FB, 0, 0);
    let is i64 as kbd_fd   = sys.dev_open(sys.DEV_KEYBOARD, 0, 0);
    let is i64 as mouse_fd = sys.dev_open(sys.DEV_MOUSE, 0, 0);
    let is i64 as tab_fd   = sys.dev_open(sys.DEV_TABLET, 0, 0);
    if (fb_fd < 0) {
        sys.write_serial(cast(*u8, "comp: no framebuffer\n"), 21);
        return 1;
    }
    if (kbd_fd < 0)   { sys.write_serial(cast(*u8, "comp: no keyboard\n"), 18); }
    if (mouse_fd < 0) { sys.write_serial(cast(*u8, "comp: no mouse\n"), 15); }
    if (tab_fd < 0)   { sys.write_serial(cast(*u8, "comp: no tablet\n"), 16); }

    // 2. Load the WM image from disk.
    let is i64 as img_len with mut = 0;
    let is i64 as img = load_image(cast(*u8, "/wm.cse"), &img_len);
    if (img == 0) {
        sys.write_serial(cast(*u8, "comp: /wm.cse missing\n"), 22);
        return 1;
    }

    // 3. Spawn the WM, installing each device fd at its FIXED child slot via
    //    fdacts (pairs of {child_fd, src_fd}). Only the devices we actually
    //    have are passed; a missing input class is simply not installed (the WM
    //    already tolerates a negative input fd, but here the slot just stays
    //    empty — the WM's KBD_FD/... constants point at it regardless).
    let is [8]i64 as acts;     // up to 4 pairs
    let is i64 as nacts with mut = 0;
    acts[nacts * 2 + 0] = WM_FB_FD;    acts[nacts * 2 + 1] = fb_fd;    nacts = nacts + 1;
    if (kbd_fd >= 0) {
        acts[nacts * 2 + 0] = WM_KBD_FD;   acts[nacts * 2 + 1] = kbd_fd;   nacts = nacts + 1;
    }
    if (mouse_fd >= 0) {
        acts[nacts * 2 + 0] = WM_MOUSE_FD; acts[nacts * 2 + 1] = mouse_fd; nacts = nacts + 1;
    }
    if (tab_fd >= 0) {
        acts[nacts * 2 + 0] = WM_TAB_FD;   acts[nacts * 2 + 1] = tab_fd;   nacts = nacts + 1;
    }

    let is i64 as pid = sys.spawn(cast(*u8, img), img_len,
                                  cast(*u8, &acts[0]), nacts, cast(*u8, 0), 0);
    if (pid < 0) {
        wmp.log_kv(cast(*u8, "comp: spawn wm FAIL rc="), 23, pid);
        return 1;
    }
    wmp.log_kv(cast(*u8, "comp: launched wm pid="), 22, pid);

    // The compositor keeps the device fds open (it owns them; the child got its
    // own inherited copies). We don't close them — later marcos read/compose
    // through them. For now we just stay alive as the WM's parent.

    // 4. Dumb launcher: block on the WM so we remain its live parent and reap it
    //    when it exits. sys.wait() is BOUNDED (the kernel's proc_wait polls for a
    //    zombie for 5 s, then returns E_AGAIN so a wedged child can't pin the
    //    waiter forever) — for a long-lived WM that's not an exit, it's "still
    //    running", so we loop and wait again. Only a real exit code (>= 0) or a
    //    hard error (a negative that ISN'T E_AGAIN) ends the launcher.
    let is i64 as st with mut = 0;
    while (1 == 1) {
        let is i64 as rc = sys.wait(pid, &st);
        if (rc == sys.E_AGAIN) { }                  // WM still alive — keep waiting
        else if (rc < 0) {
            wmp.log_kv(cast(*u8, "comp: wait err rc="), 18, rc);
            return 1;
        } else {
            wmp.log_kv(cast(*u8, "comp: wm exited st="), 19, rc);
            return 0;
        }
    }
    return 0;
}
