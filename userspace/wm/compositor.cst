// compositor.cst — orchestrator (/init). Imports state + per-domain modules;
// owns main(). Boot-time device acquisition, channel pair, WM spawn, main
// poll loop, frame tick + dirty flush all live here.

use "../../../Caustic/std/causticos/font.cst" as font;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/wmproto/wmproto.cst" as wmp;
use "../lib/compo_proto/compo_proto.cst" as cp;
use "../lib/anim/anim.cst" as anim;

use "comp_state.cst" as s;
use "comp_render.cst" as r;
use "comp_damage.cst" as dmg;
use "comp_wallpaper.cst" as wp;
use "comp_input.cst" as inp;
use "comp_scene.cst" as scn;
use "comp_wc.cst" as wc;
use "pointer_conf.cst" as pconf;
use "comp_fx.cst" as fx;

fn load_image(path as *u8, out_len as *i64) as i64 {
    *out_len = 0;
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { return 0; }
    let is i64 as sz = sys.lseek(fd, 0, cast(i32, sys.SEEK_END));
    sys.lseek(fd, 0, cast(i32, sys.SEEK_SET));
    if (sz <= 0 || sz > s.IMG_CAP) { sys.close(fd); return 0; }
    let is i64 as alloc = (sz + 4095) & (0 - 4096);
    let is i64 as va = sys.mmap(cast(i64, 0), alloc, sys.PROT_READ | sys.PROT_WRITE);
    if (va < 0) { sys.close(fd); return 0; }
    let is i64 as got = sys.read(fd, cast(*u8, va), sz);
    sys.close(fd);
    if (got <= 0) { return 0; }
    *out_len = got;
    return va;
}

// Frame profiling: one serial line a second with frames, rects, kilopixels and
// the microseconds spent composing vs presenting. Off by default (it is log
// noise on a healthy system); flip to 1 when a frame feels expensive, because
// guessing which effect costs what has a poor track record.
let is i64 as PROF with imut = 0;

fn main() as i32 {
    s.fb_fd    = sys.dev_open(sys.DEV_FB, 0, 0);
    s.kbd_fd   = sys.dev_open(sys.DEV_KEYBOARD, 0, 0);
    if (s.fb_fd < 0) {
        sys.write_serial(cast(*u8, "comp: no framebuffer\n"), 21);
        return 1;
    }
    if (s.kbd_fd < 0) { sys.write_serial(cast(*u8, "comp: no keyboard\n"), 18); }
    // Pointers are discovered, not assumed: every registered mouse/tablet is
    // adopted with its own identity, then the config binds a curve to each.
    pconf.open_all();
    pconf.load();
    if (s.ptr_n == 0) { sys.write_serial(cast(*u8, "comp: no pointer\n"), 17); }
    else { wmp.log_kv(cast(*u8, "comp: pointers n="), 17, s.ptr_n); pconf.dump(); }

    let is [5]i64 as fbinfo;
    if (sys.surface_info(s.fb_fd, cast(*u8, &fbinfo[0])) != 0) {
        sys.write_serial(cast(*u8, "comp: no surface info\n"), 22);
        return 1;
    }
    let is i64 as fbva = sys.mmap_fd(sys.PROT_READ | sys.PROT_WRITE, s.fb_fd);
    if (fbva < 0) {
        sys.write_serial(cast(*u8, "comp: fb mmap fail\n"), 19);
        return 1;
    }
    font.init();
    s.scr_w = fbinfo[0];
    s.scr_h = fbinfo[1];
    s.scr_pitch = fbinfo[2];
    s.fb_base = fbva;
    s.mx = s.scr_w / 2;
    s.my = s.scr_h / 2;
    s.cur_last_x = s.mx;
    s.cur_last_y = s.my;
    r.cursor_init();
    anim.init();
    wp.wallpaper_init();

    let is [2]i64 as cmd_ch;
    let is [2]i64 as wc_ch;
    if (sys.channel_create(&cmd_ch[0]) != 0) {
        sys.write_serial(cast(*u8, "comp: no cmd chan\n"), 18);
        return 1;
    }
    if (sys.channel_create(&wc_ch[0]) != 0) {
        sys.write_serial(cast(*u8, "comp: no wc chan\n"), 17);
        return 1;
    }
    s.cmd_fd = cmd_ch[0];
    let is i64 as cmd_wm = cmd_ch[1];
    s.wc_fd = wc_ch[0];
    let is i64 as wc_wm = wc_ch[1];

    let is i64 as img_len with mut = 0;
    let is i64 as img = load_image(cast(*u8, "/wm.cse"), &img_len);
    if (img == 0) {
        sys.write_serial(cast(*u8, "comp: /wm.cse missing\n"), 22);
        return 1;
    }
    let is [6]i64 as acts;
    acts[0] = cp.CP_FB_FD;  acts[1] = s.fb_fd;
    acts[2] = cp.CP_CMD_FD; acts[3] = cmd_wm;
    acts[4] = cp.CP_WC_FD;  acts[5] = wc_wm;
    let is *u8 as wm_name = "wm";
    let is [2]i64 as av;
    av[0] = cast(i64, wm_name); av[1] = 2;
    let is i64 as pid = sys.spawn(cast(*u8, img), img_len,
                                  cast(*u8, &acts[0]), 3, cast(*u8, &av[0]), 1);
    sys.close(cmd_wm);
    sys.close(wc_wm);
    if (pid < 0) {
        wmp.log_kv(cast(*u8, "comp: spawn wm FAIL rc="), 23, pid);
        return 1;
    }
    wmp.log_kv(cast(*u8, "comp: launched wm pid="), 22, pid);

    dmg.damage_all();
    scn.flush_damage();

    inp.cmd_send(cp.MSG_CP_SCR_READY, s.scr_w, s.scr_h, 0);

    // 6 entries x 3 words: keyboard + PTR_MAX pointers + the WC channel. Sized
    // off PTR_MAX, so raising that bound means raising this too.
    let is [18]i64 as pe;
    let is i64 as st with mut = 0;
    let is i64 as next_frame with mut = sys.time_ns() + s.FRAME_NS;
    while (1 == 1) {
        let is i64 as n with mut = 0;
        let is i64 as kbd_e   with mut = 0 - 1;
        let is i64 as ptr_e0  with mut = 0 - 1;    // first pointer entry; the rest follow in order
        let is i64 as wc_e    with mut = 0 - 1;
        if (s.kbd_fd >= 0) {
            pe[n*3+0] = s.kbd_fd; pe[n*3+1] = sys.POLL_READABLE; pe[n*3+2] = 0;
            kbd_e = n; n = n + 1;
        }
        let is i64 as pi with mut = 0;
        while (pi < s.ptr_n) {
            if (pi == 0) { ptr_e0 = n; }
            pe[n*3+0] = s.ptrs[pi].fd; pe[n*3+1] = sys.POLL_READABLE; pe[n*3+2] = 0;
            n = n + 1;
            pi = pi + 1;
        }
        pe[n*3+0] = s.wc_fd; pe[n*3+1] = sys.POLL_READABLE; pe[n*3+2] = 0;
        wc_e = n; n = n + 1;

        // A still desktop needs no frame clock. Waking 60 times a second to
        // find nothing damaged and nothing animating is the whole idle cost of
        // a compositor: the work per wake is microseconds, but the wake itself
        // is a scheduler round trip on every cpu it touches.
        //
        // So the timeout is the frame deadline only while something is
        // MOVING; otherwise it is the slowest periodic effect (the cursor's
        // 4 Hz shimmer), and real input wakes the poll immediately anyway.
        let is i64 as now with mut = sys.time_ns();
        let is i64 as busy with mut = 0;
        if (s.anim_live > 0 || s.needs_compose == 1 || s.dmg_full == 1 || s.dmg_n > 0) {
            busy = 1;
        }
        let is i64 as tmo with mut = 250000000;
        if (busy == 1) {
            tmo = next_frame - now;
            if (tmo < 0) { tmo = 0; }
        }
        sys.poll(&pe[0], n, tmo);

        if (kbd_e >= 0 && (pe[kbd_e*3+2] & sys.POLL_READABLE) != 0) { inp.pump_kbd(); }
        if (ptr_e0 >= 0) {
            pi = 0;
            while (pi < s.ptr_n) {
                if ((pe[(ptr_e0 + pi)*3+2] & sys.POLL_READABLE) != 0) {
                    if (s.ptrs[pi].is_abs == 1) { inp.pump_tablet(&s.ptrs[pi]); }
                    else { inp.pump_mouse(&s.ptrs[pi]); }
                }
                pi = pi + 1;
            }
        }

        if (wc_e >= 0) {
            let is i64 as wgot = pe[wc_e*3+2];
            if ((wgot & sys.POLL_READABLE) != 0) {
                if (wc.service_wc() < 0) {
                    sys.write_serial(cast(*u8, "comp: wm gone (wc)\n"), 19);
                    sys.wait(pid, &st);
                    return 0;
                }
            }
            if ((wgot & (sys.POLL_CLOSED | sys.POLL_ERROR)) != 0) {
                sys.write_serial(cast(*u8, "comp: wm gone (wc)\n"), 19);
                sys.wait(pid, &st);
                return 0;
            }
        }

        if (s.shutdown_sent == 0 && sys.power_pending() == 1) {
            inp.cmd_send(cp.MSG_CP_SHUTDOWN_REQ, 0, 0, 0);
            s.shutdown_sent = 1;
        }

        now = sys.time_ns();
        if (now >= next_frame) {
            // Effects advance first, against ONE clock: each damages its own
            // rects here, so the compose below picks them up in the same frame
            // instead of a frame late.
            fx.tick(now);
            if (s.needs_compose == 1 || s.dmg_full == 1 || s.dmg_n > 0) { scn.flush_damage(); }
            next_frame = now + s.FRAME_NS;
            // Once a second: what the frame actually cost. Reasoning about
            // composition from the code is how three wrong guesses happen in
            // a row; this is the number.
            if (PROF == 1 && now >= s.prof_next) {
                if (s.prof_next > 0) {
                    wmp.log_kv(cast(*u8, "prof: frames="), 14, s.prof_frames);
                    wmp.log_kv(cast(*u8, "prof: rects="), 13, s.prof_rects);
                    wmp.log_kv(cast(*u8, "prof: kpx="), 11, s.prof_px / 1000);
                    wmp.log_kv(cast(*u8, "prof: compose_us="), 18, s.prof_compose_ns / 1000);
                    wmp.log_kv(cast(*u8, "prof: present_us="), 18, s.prof_present_ns / 1000);
                }
                s.prof_next = now + 1000000000;
                s.prof_frames = 0; s.prof_rects = 0; s.prof_px = 0;
                s.prof_compose_ns = 0; s.prof_present_ns = 0;
            }
        }
    }
    return 0;
}
