// wm/gesture.cst — pointer gestures, kept pure so they can be tested without a
// desktop. State is this module's own; the caller feeds motion and reads the
// verdict.
//
// Shake: three direction REVERSALS inside a time window, each preceded by a leg
// long enough to be a deliberate sweep. Counting reversals as they arrive is
// what makes this work at any event rate — a fixed-size history of the last few
// samples spans ~50 ms at mouse speeds and could never hold the gesture at all.

let is i64 as SHAKE_LEG    with imut = 120;          // px a leg must cover to count
let is i64 as SHAKE_REVS   with imut = 3;
let is i64 as SHAKE_WIN_NS with imut = 800000000;

let is i64 as dir  with mut = 0;    // -1 / 0 / +1, direction of the current leg
let is i64 as leg  with mut = 0;    // px travelled in the current direction
let is i64 as revs with mut = 0;    // qualifying reversals in the open run
let is i64 as t0   with mut = 0;    // when that run opened

fn _abs(v as i64) as i64 { if (v < 0) { return 0 - v; } return v; }

fn reset() as void { dir = 0; leg = 0; revs = 0; t0 = 0; return; }

// shake_feed — one motion event. Returns 1 exactly on the event that completes
// a shake, and rearms.
fn shake_feed(dx as i64, now as i64) as i64 {
    if (dx == 0) { return 0; }
    let is i64 as d with mut = 1;
    if (dx < 0) { d = 0 - 1; }
    if (d == dir) { leg = leg + _abs(dx); return 0; }
    // Direction changed. The leg that just ended counts only if it was long
    // enough to be a sweep rather than a wobble; a short one neither counts nor
    // breaks the run.
    if (dir != 0 && leg >= SHAKE_LEG) {
        if (revs == 0 || now - t0 > SHAKE_WIN_NS) {
            revs = 1;
            t0 = now;
        } else {
            revs = revs + 1;
        }
        if (revs >= SHAKE_REVS) {
            reset();
            return 1;
        }
    }
    dir = d;
    leg = _abs(dx);
    return 0;
}

fn shake_revs() as i64 { return revs; }
