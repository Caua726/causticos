use "state.cst" as s;
use "window.cst" as win;
use "tags.cst" as tags;
use "client.cst" as cli;
use "../lib/wmproto/wmproto.cst" as wmp;

// The launcher is a single transient window: restore and focus it instead of
// creating another process for each shortcut or taskbar click.
fn focus_launcher() as i64 {
    let is [2]i64 as nm;
    wmp.title_pack(cast(*u8, "launcher.cse"), 12, &nm[0], &nm[1]);
    let is i64 as i with mut = 0;
    while (i < s.MAX_WIN) {
        if (s.wins[i].used == 1 && s.wins[i].closing == 0
            && s.wins[i].name_len == 12
            && s.wins[i].n0 == nm[0] && s.wins[i].n1 == nm[1]) {
            if (s.wins[i].tags != s.sel_tags) {
                s.wins[i].tags = s.sel_tags;
                tags._after_change();
            }
            if (s.wins[i].minimized == 1) { win.win_unminimize(i); }
            win.win_focus(i);
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn open_launcher() as void {
    if (focus_launcher() == 0) { cli.spawn_named(cast(*u8, "launcher.cse"), 12); }
    return;
}
