// wterm/wterm_repl.cst — what the windowed shell does with a finished line.
// The line editor (buffer, history, recall, completion) is lib/repl and the job
// table is lib/jobs, both shared with the fullscreen shell; this file is only
// the wterm's policy: its builtin set and how it renders them.
use "wterm_state.cst" as s;
use "wterm_child.cst" as cli;
use "wterm_grid.cst" as g;
use "../lib/repl/repl.cst" as repl;
use "../lib/jobs/jobs.cst" as jobs;
use "../lib/shexec/shexec.cst" as sx;
use "../lib/shbuiltin/shbuiltin.cst" as bi;
use "../lib/shscript/shscript.cst" as ss;
use "std/os/causticos.cst" as sys;
use "std/causticos/term.cst" as term;

// The wterm's completable builtins. `exit` is here and not in the fullscreen
// shell: closing the window is only meaningful when there is a window.
// Completion offers the shared table plus this terminal's own commands: one
// list, built from the same rows the dispatcher reads.
fn builtins(out as *i64) as i64 {
    let is i64 as n with mut = 0;
    while (n < bi.count() && n < 12) {
        out[n * 2] = cast(i64, bi.name_at(n));
        out[n * 2 + 1] = bi.nlen_at(n);
        n = n + 1;
    }
    out[n*2] = cast(i64, cast(*u8, "clear")); out[n*2+1] = 5; n = n + 1;
    out[n*2] = cast(i64, cast(*u8, "reset")); out[n*2+1] = 5; n = n + 1;
    out[n*2] = cast(i64, cast(*u8, "exit"));  out[n*2+1] = 4; n = n + 1;
    out[n*2] = cast(i64, cast(*u8, "jobs"));  out[n*2+1] = 4; n = n + 1;
    out[n*2] = cast(i64, cast(*u8, "fg"));    out[n*2+1] = 2; n = n + 1;
    out[n*2] = cast(i64, cast(*u8, "kill"));  out[n*2+1] = 4; n = n + 1;
    return n;
}

fn print_num(t as *term.Term, v as i64) as void {
    let is i64 as x with mut = v;
    if (x < 0) { term.putc(t, 45); x = 0 - x; }
    if (x == 0) { term.putc(t, 48); return; }
    let is [24]u8 as b;
    let is i64 as i with mut = 24;
    while (x > 0) { i = i - 1; b[i] = cast(u8, 48 + (x % 10)); x = x / 10; }
    term.puts(t, cast(*u8, &b[i]), 24 - i);
    return;
}

fn print_job(t as *term.Term, slot as i64) as void {
    term.putc(t, 91); print_num(t, slot + 1); term.puts(t, "] ", 2);
    print_num(t, jobs.last_pid(slot));
    term.putc(t, 32);
    let is [32]u8 as sw;
    let is i64 as swn = jobs.state_word(slot, cast(*u8, &sw[0]));
    if (jobs.get(slot).status != jobs.JOB_RUN) {
        if (jobs.get(slot).crashed == 1) { g._col(t, s.C_ERR); } else { g._col(t, s.C_DIM); }
    }
    term.puts(t, cast(*u8, &sw[0]), swn);
    g._col(t, s.C_TEXT);
    term.puts(t, jobs.cmd_ptr(slot), jobs.cmd_len(slot));
    g.puts(t, "\n");
    return;
}

// The background jobs that ended while a program had the terminal
// (jobs.JOB_ENDED), told now that the prompt is back, and let go.
fn report_ended(t as *term.Term) as void {
    let is i64 as i with mut = 0;
    while (i < jobs.max_jobs()) {
        if (jobs.get(i).status == jobs.JOB_ENDED) {
            print_job(t, i);
            sx.crash_line(t, i, s.C_ERR);
            jobs.release(i);
        }
        i = i + 1;
    }
    return;
}

// run_line — returns 1 when the window should close, 0 otherwise.
//
// The line is a list (`a ; b`, `a && b`, `a || b`, `a & b` — see shexec): its
// parts run one at a time, and the terminal comes back to list_run when the
// foreground job ends (wterm.finish_job).
fn run_line(t as *term.Term, line as *u8, len as i64) as i64 {
    // A construct being typed, or a line that opens one, belongs to the script
    // engine: control flow needs the WHOLE thing before any of it can run.
    if (ss.pending() == 1 || ss.is_block_start(line, len) == 1) {
        ss.feed(t, line, len);
        return 0;
    }
    let is i64 as n = sx.list_begin(line, len);
    if (n == 0 - 1) { g.err(t, "syntax: ; && || or & with no command on one side\n"); sx.set_status(2); return 0; }
    if (n == 0 - 2) { g.err(t, "line has too many commands\n"); sx.set_status(2); return 0; }
    return list_run(t);
}

// Run the list's next parts until one is left running in the foreground or the
// list is done. 1 if a part was `exit`.
fn list_run(t as *term.Term) as i64 {
    let is i64 as p with mut = 0;
    let is i64 as n with mut = 0;
    let is i64 as bg with mut = 0;
    while (sx.list_next(&p, &n, &bg) == 1) {
        if (run_part(t, cast(*u8, p), n, bg) == 1) { sx.list_cancel(); return 1; }
        if (s.fg_job >= 0) { return 0; }
    }
    return 0;
}

// One part of the list: a builtin, a function, or a pipeline (bg = 1: not
// waited for). Returns 1 when the window should close.
fn run_part(t as *term.Term, line as *u8, len as i64, bg as i64) as i64 {
    let is [16]i64 as argv_ptr;
    let is [16]i64 as argv_len;
    let is i64 as argc with mut = repl.parse(line, len, cast(*i64, &argv_ptr[0]), cast(*i64, &argv_len[0]));
    if (argc == 0) { return 0; }
    let is i64 as len2 = len;

    let is *u8 as cmd = cast(*u8, argv_ptr[0]);
    let is i64 as cl = argv_len[0];
    if (repl.streq(cmd, cl, "clear") == 1 || repl.streq(cmd, cl, "reset") == 1) { term.clear(t); return 0; }
    if (repl.streq(cmd, cl, "exit") == 1) { return 1; }
    if (repl.streq(cmd, cl, "jobs") == 1) {
        let is i64 as any with mut = 0;
        let is i64 as i with mut = 0;
        while (i < jobs.max_jobs()) {
            if (jobs.get(i).status != jobs.JOB_FREE) {
                print_job(t, i); any = 1;
                if (jobs.get(i).status == jobs.JOB_ENDED) { jobs.release(i); }   // told now
            }
            i = i + 1;
        }
        if (any == 0) { g._col(t, s.C_DIM); g.puts(t, "no jobs\n"); g._col(t, s.C_TEXT); }
        return 0;
    }
    if (repl.streq(cmd, cl, "kill") == 1) {
        if (argc < 2) { g.err(t, "usage: kill %<job> | <pid> ...\n"); sx.set_status(2); return 0; }
        // A job by number, or a process by pid. A process goes with
        // everything it started. $? is 1 when any of them could not be ended.
        let is i64 as kst with mut = 0;
        let is i64 as ka with mut = 1;
        while (ka < argc) {
            let is *u8 as kw = cast(*u8, argv_ptr[ka]);
            let is i64 as kl = argv_len[ka];
            if (kl > 0 && kw[0] == cast(u8, 37)) {                 // '%'
                let is i64 as j = jobs.parse_pct(kw, kl);
                if (j < 0) { g.err(t, "kill: no such job\n"); kst = 1; } else { jobs.kill_job(j); }
            } else {
                let is i64 as kp = jobs.parse_pid(kw, kl);
                if (kp < 0) { g.err(t, "kill: not a job (%n) or a pid\n"); kst = 1; }
                else if (sys.kill(kp) != 0) {
                    // Not one this terminal started: the WM started every
                    // window, so it ends anything in the session.
                    let is i64 as krc = cli.kill_via_wm(kp);
                    if (krc == sys.E_AGAIN) { g.err(t, "kill: the desktop did not answer\n"); kst = 1; }
                    else if (krc != 0) { g.err(t, "kill: no such process in this session\n"); kst = 1; }
                }
            }
            ka = ka + 1;
        }
        sx.set_status(kst);
        return 0;
    }
    if (repl.streq(cmd, cl, "fg") == 1) {
        if (argc < 2) { g.err(t, "usage: fg %<n>\n"); return 0; }
        let is i64 as j = jobs.parse_pct(cast(*u8, argv_ptr[1]), argv_len[1]);
        if (j < 0) { g.err(t, "no such job\n"); return 0; }
        if (jobs.get(j).status != jobs.JOB_RUN) { g.err(t, "job already finished\n"); return 0; }
        // Bringing a job forward is only a routing change: it is the job keys
        // now go to, and the one whose completion prints the next prompt.
        jobs.get(j).bg = 0;
        s.fg_job = j;
        s.ta_end = 0;
        cli.set_title(jobs.cmd_ptr(j), jobs.cmd_len(j));
        term.puts(t, jobs.cmd_ptr(j), jobs.cmd_len(j));
        term.putc(t, 0x0A);
        return 0;
    }
    // The shared builtins (cd, export, set, unset, type, history, help) come
    // from one table both shells read, so `help` cannot drift out of date.
    let is i64 as bst with mut = 0;
    if (bi.dispatch(t, cast(*i64, &argv_ptr[0]), cast(*i64, &argv_len[0]), argc, &bst) == 1) {
        sx.set_status(bst);
        return 0;
    }

    // A function defined with `function name begin ... end` is callable by
    // name, and shadows a program of that name the way a builtin does.
    if (ss.has_fn(cmd, cl) == 1) {
        sx.set_status(ss.call_named(t, cmd, cl));
        return 0;
    }

    // Everything else is a pipeline: expansion, globbing, redirects and '|'
    // are shexec's job, and it hands back one job slot for the whole chain.
    // The extra channel goes on CTL_FD so a child can still ask for a window.
    let is i64 as nc = sx.prepare(line, len2);
    sx.cap_err_show(t);      // what a $(...) in it said on stderr
    // A line that had to be shortened is a DIFFERENT line; running it
    // would do something other than what was typed.
    if (sx.truncated() == 1) { g.err(t, "line too long after expansion\n"); sx.set_status(2); return 0; }
    if (nc == 0 - 2) { g.err(t, "syntax: redirect with no target\n"); return 0; }
    if (nc <= 0) { g.err(t, "too many pipeline stages\n"); return 0; }
    let is [2]i64 as aux;
    let is i64 as crc = sys.channel_create(&aux[0]);
    if (crc != 0) {
        g.err(t, "cannot start it: "); g.err(t, sys.err_text(crc)); g.err(t, "\n");
        sx.set_status(1);
        return 0;
    }
    let is i64 as slot = sx.exec(bg, line, len2, s.CTL_FD, cast(*i64, &aux[0]), 1);
    sys.close(aux[1]);                       // the child holds its own end now
    if (slot < 0) {
        sys.close(aux[0]);
        let is [192]u8 as m;
        sx.failure_text(slot, cast(*u8, &m[0]));
        g.err(t, cast(*u8, &m[0]));
        sx.set_status(sx.failure_status(slot));
        return 0;
    }
    jobs.get(slot).aux_fd = aux[0];
    if (bg == 1) { print_job(t, slot); sx.set_status(0); }
    else {
        s.fg_job = slot;
        s.ta_end = 0;
        cli.set_title(cast(*u8, argv_ptr[0]), argv_len[0]);
    }
    return 0;
}
