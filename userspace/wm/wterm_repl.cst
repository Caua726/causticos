// wterm/wterm_repl.cst — REPL primitives: parse, history (recall), run_line,
// tab-completion (with longest-common-prefix acc). Always pointers in/out,
// state in wterm_state.cst.
use "wterm_state.cst" as s;
use "wterm_child.cst" as cli;
use "wterm_grid.cst" as g;
use "../../../Caustic/std/causticos/term.cst" as term;

fn parse(line as *u8, len as i64, argv_ptr as *i64, argv_len as *i64) as i64 {
    let is i64 as argc with mut = 0;
    let is i64 as i with mut = 0;
    while (i < len && argc < s.MAX_ARGS) {
        while (i < len && line[i] == 32) { i = i + 1; }
        if (i >= len) { break; }
        let is i64 as start = i;
        while (i < len && line[i] != 32) { i = i + 1; }
        argv_ptr[argc] = cast(i64, line) + start;
        argv_len[argc] = i - start;
        argc = argc + 1;
    }
    return argc;
}

fn streq(a as *u8, alen as i64, lit as *u8) as i64 {
    let is i64 as ll = g.slen(lit);
    if (alen != ll) { return 0; }
    let is i64 as i with mut = 0;
    while (i < ll) { if (a[i] != lit[i]) { return 0; } i = i + 1; }
    return 1;
}

fn run_line(t as *term.Term, line as *u8, len as i64) as i64 {
    let is [16]i64 as argv_ptr;
    let is [16]i64 as argv_len;
    let is i64 as argc = parse(line, len, cast(*i64, &argv_ptr[0]), cast(*i64, &argv_len[0]));
    if (argc == 0) { return 0; }
    let is *u8 as cmd = cast(*u8, argv_ptr[0]);
    let is i64 as cl = argv_len[0];
    if (streq(cmd, cl, "clear") == 1 || streq(cmd, cl, "reset") == 1) { term.clear(t); return 0; }
    if (streq(cmd, cl, "exit") == 1) { return 1; }
    if (streq(cmd, cl, "help") == 1) {
        g._col(t, s.C_DIM); g.puts(t, "built-in\n"); g._col(t, s.C_TEXT);
        g.puts(t, "  help              show this help\n");
        g.puts(t, "  clear / reset     clear the screen\n");
        g.puts(t, "  exit              close this window\n");
        g._col(t, s.C_DIM); g.puts(t, "programs  (/<name>.cse)\n"); g._col(t, s.C_TEXT);
        g.puts(t, "  echo <args...>    print the arguments\n");
        g.puts(t, "  cat  <file>       print a file\n");
        g.puts(t, "  ls   [path]       list a directory\n");
        g.puts(t, "  uptime            time since boot\n");
        g.puts(t, "  sysinfo           kernel version + limits\n");
        g.puts(t, "  newterm           open another terminal window\n");
        return 0;
    }
    cli.run_program(t, cast(*i64, &argv_ptr[0]), cast(*i64, &argv_len[0]), argc);
    return 0;
}

// recall — populate the live line buffer from a stored history slot and
// redraw every character; the caller is responsible for resetting the cursor.
fn recall(t as *term.Term, line as *u8, llen_ptr as *i64, src as *u8, srclen as i64) as void {
    let is i64 as j with mut = 0;
    while (j < llen_ptr[0]) { term.putc(t, 0x08); j = j + 1; }
    let is i64 as i with mut = 0;
    while (i < srclen && i < s.LINE_CAP - 1) { line[i] = src[i]; term.putc(t, cast(i64, src[i])); i = i + 1; }
    llen_ptr[0] = i;
    g.show(t);
    return;
}

// ---- Tab completion ----
fn _cand_match(cand as *u8, cl as i64, line as *u8, ts as i64, plen as i64) as i64 {
    if (cl < plen) { return 0; }
    let is i64 as k with mut = 0;
    while (k < plen) { if (cand[k] != line[ts + k]) { return 0; } k = k + 1; }
    return 1;
}

fn _acc_update(cand as *u8, cl as i64, acc as *u8, acclen_ptr as *i64, nmatch_ptr as *i64) as void {
    nmatch_ptr[0] = nmatch_ptr[0] + 1;
    if (acclen_ptr[0] < 0) {
        let is i64 as i with mut = 0;
        while (i < cl && i < 255) { acc[i] = cand[i]; i = i + 1; }
        acclen_ptr[0] = i;
    } else {
        let is i64 as i with mut = 0;
        let is i64 as al = acclen_ptr[0];
        while (i < al && i < cl && acc[i] == cand[i]) { i = i + 1; }
        acclen_ptr[0] = i;
    }
    return;
}

fn complete(t as *term.Term, line as *u8, llen_ptr as *i64) as void {
    let is i64 as llen = llen_ptr[0];
    let is i64 as ts with mut = llen;
    while (ts > 0 && line[ts - 1] != 32) { ts = ts - 1; }
    let is i64 as plen = llen - ts;
    let is i64 as is_cmd with mut = 0;
    if (ts == 0) { is_cmd = 1; }
    let is [256]u8 as acc;
    let is i64 as acclen with mut = 0 - 1;
    let is i64 as nmatch with mut = 0;
    if (is_cmd == 1) {
        if (_cand_match("help", 4, line, ts, plen) == 1) { _acc_update("help", 4, cast(*u8, &acc[0]), &acclen, &nmatch); }
        if (_cand_match("clear", 5, line, ts, plen) == 1) { _acc_update("clear", 5, cast(*u8, &acc[0]), &acclen, &nmatch); }
        if (_cand_match("reset", 5, line, ts, plen) == 1) { _acc_update("reset", 5, cast(*u8, &acc[0]), &acclen, &nmatch); }
        if (_cand_match("exit", 4, line, ts, plen) == 1) { _acc_update("exit", 4, cast(*u8, &acc[0]), &acclen, &nmatch); }
    }
    let is i64 as fd = sys.open_read("/");
    if (fd < 0) { return; }
    let is [320]u8 as de;
    while (sys.readdir(fd, cast(*u8, &de[0])) == 0) {
        let is *u8 as nm = cast(*u8, &de[0]);
        let is *i64 as nlp = cast(*i64, cast(i64, &de[0]) + 256);
        let is i64 as nl = nlp[0];
        let is i64 as cl with mut = nl;
        let is i64 as ok with mut = 1;
        if (is_cmd == 1) {
            if (nl >= 4 && nm[nl-4] == 46 && nm[nl-3] == 99 && nm[nl-2] == 115 && nm[nl-1] == 101) { cl = nl - 4; }
            else { ok = 0; }
        }
        if (ok == 1 && _cand_match(nm, cl, line, ts, plen) == 1) { _acc_update(nm, cl, cast(*u8, &acc[0]), &acclen, &nmatch); }
    }
    sys.close(fd);
    if (nmatch == 0) { return; }
    let is i64 as i with mut = plen;
    while (i < acclen && llen_ptr[0] < s.LINE_CAP - 1) {
        line[llen_ptr[0]] = acc[i];
        term.putc(t, cast(i64, acc[i]));
        llen_ptr[0] = llen_ptr[0] + 1;
        i = i + 1;
    }
    if (nmatch == 1 && llen_ptr[0] < s.LINE_CAP - 1) {
        line[llen_ptr[0]] = cast(u8, 32); term.putc(t, 0x20); llen_ptr[0] = llen_ptr[0] + 1;
    }
    g.show(t);
    return;
}
