// wm/keyboard.cst — key events: modifier tracking + global hotkeys + forward to
// focused client. Hotkeys consume the key (never reach the client); any other
// key becomes MSG_KEY.

use "state.cst" as s;
use "window.cst" as win;
use "client.cst" as cli;
use "../lib/wmproto/wmproto.cst" as wmp;
use "../lib/compo_proto/compo_proto.cst" as cp;
use "../../../Caustic/std/os/causticos.cst" as sys;

// The raw scancode rides along in the third field: a client that binds a
// control chord needs the physical key, not what the keymap made of it.
fn forward_key(keysym as i64, kb as i64, sc as i64) as void {
    if (s.nz == 0) { return; }
    let is i64 as i = s.zord[0];
    if (s.wins[i].state != 2) { return; }
    if (s.quota[i] < 2 && cli.chan_writable_now(i) == 1) {
        wmp.msg_send(s.wins[i].chan, wmp.MSG_KEY, keysym, kb, sc);
        s.quota[i] = s.quota[i] + 1;
    } else {
        s.wins[i].drops = s.wins[i].drops + 1;
        if (s.wins[i].drops > s.MAX_DROPS) { reap_window(i, 0); }
    }
    return;
}

fn reap_window(i as i64, do_wait as i64) as void { cli.reap_window(i, do_wait); return; }

// a = keysym, kb = mods|pressed<<8|ext<<9, sc = raw scancode. Hotkeys gate on
// scancode + modifier mask (layout-independent); the keysym is forwarded as
// data to the child.
fn key_handle(keysym as i64, kb as i64, sc as i64) as void {
    let is i64 as pressed = cp.key_pressed(kb);
    let is i64 as ext = cp.key_ext(kb);
    let is i64 as mods = cp.key_mods(kb);
    s.mod_alt = (mods >> 2) & 1;
    s.mod_super = (mods >> 3) & 1;
    if (pressed == 1) {
        if (s.mod_alt == 1 && ext == 0 && sc == 0x0F) { win.win_cycle(); return; }
        if (s.mod_super == 1 && sc == 0x1C) { cli.spawn_client(); return; }
        if (s.mod_super == 1 && sc == 0x39) {
            cli.spawn_named(cast(*u8, "launcher.cse"), 12);
            return;
        }
        if (s.mod_super == 1 && sc == 0x10) {
            if (s.nz > 0) { s.wins[s.zord[0]].pend_close = 1; }
            return;
        }
    }
    forward_key(keysym, kb, sc);
    return;
}
