// wm/keyboard.cst — key events: modifier tracking + the bind table + forward
// to the focused client. A bound chord is consumed (it never reaches the
// client); every other key becomes MSG_KEY.

use "state.cst" as s;
use "window.cst" as win;
use "client.cst" as cli;
use "config.cst" as cfg;
use "actions.cst" as actions;
use "layout.cst" as lay;
use "tags.cst" as tags;
use "decoration.cst" as dec;
use "context.cst" as context;
use "../lib/keymap/keysym.cst" as ks;
use "../lib/wmproto/wmproto.cst" as wmp;
use "../lib/compo_proto/compo_proto.cst" as cp;
use "../lib/keymap/keymap.cst" as km;
use "std/os/causticos.cst" as sys;

// The raw scancode rides along in the third field: a client that binds a
// control chord needs the physical key, not what the keymap made of it.
// Queued (client.queue_msg): a window still opening gets its keys once it is
// ready, and a busy one gets them in order.
fn forward_key(keysym as i64, kb as i64, sc as i64) as void {
    if (s.focused < 0) { return; }
    let is i64 as i = s.focused;
    if (s.wins[i].state != 1 && s.wins[i].state != 2) { return; }
    cli.queue_msg(i, wmp.MSG_KEY, keysym, kb, sc);
    return;
}

fn reap_window(i as i64, do_wait as i64) as void { cli.reap_window(i, do_wait); return; }

// The keyboard layout is the compositor's to apply and the user's to choose
// (`keymap set`, or /etc/keymap). At start, and whenever one of its files
// changes (wm/watch.cst), the WM looks whether the choice moved and tells the
// compositor to load it again; the first look always tells it.
fn keymap_poll() as void {
    let is i64 as st = km.config_stamp();
    if (st == s.kmap_stamp && s.kmap_told == 1) { return; }
    s.kmap_stamp = st;
    s.kmap_told = 1;
    cp.msg_send(s.wc_fd, cp.MSG_WC_KEYMAP, 0, 0, 0);
    return;
}

// run_action — one bound action. Everything the WM can be asked to do by a key
// is here, and the bind table is the only thing that decides which key asks.
fn run_action(act as i64, arg as i64) as void {
    // Walking the stack does not restack as it goes — otherwise the second
    // press would come back to where the first started. The walk is committed
    // when the modifier holding it comes up.
    if (act == cfg.ACT_CYCLE || act == cfg.ACT_FOCUS_NEXT) {
        if (s.alt_cycling == 0) {
            s.alt_cycling = 1;
            win.win_cycle(1);
            context.switcher_open();
        } else {
            win.win_cycle(1);
            context.switcher_update();
        }
        return;
    }
    if (act == cfg.ACT_CYCLE_BACK || act == cfg.ACT_FOCUS_PREV) {
        if (s.alt_cycling == 0) {
            s.alt_cycling = 1;
            win.win_cycle(0 - 1);
            context.switcher_open();
        } else {
            win.win_cycle(0 - 1);
            context.switcher_update();
        }
        return;
    }
    if (act == cfg.ACT_SPAWN_TERM) { cli.spawn_client(); return; }
    if (act == cfg.ACT_LAUNCHER) { actions.open_launcher(); return; }
    if (act == cfg.ACT_CLOSE) {
        if (s.focused >= 0 && win.win_mapped(s.focused) == 1) {
            s.wins[s.focused].pend_close = 1;
        }
        return;
    }
    if (act == cfg.ACT_LAYOUT_NEXT) { lay.layout_next(); return; }
    if (act == cfg.ACT_LAYOUT_SET) { lay.set_layout(arg); return; }
    if (act == cfg.ACT_VIEW) { tags.view_tag(arg); return; }
    if (act == cfg.ACT_VIEW_ALL) { tags.view_all(); return; }
    if (act == cfg.ACT_TOGGLE_VIEW) { tags.toggle_view(arg); return; }
    if (act == cfg.ACT_TAG) { tags.tag_focused(arg); return; }
    if (act == cfg.ACT_TOGGLE_TAG) { tags.toggle_tag_focused(arg); return; }
    if (act == cfg.ACT_SCRATCH) { tags.toggle_scratch(); return; }
    if (act == cfg.ACT_SCRATCH_SEND) { tags.scratch_send(); return; }
    if (act == cfg.ACT_TOGGLE_FLOAT) { lay.toggle_float(); return; }
    if (act == cfg.ACT_ZOOM) { lay.zoom(); return; }
    if (act == cfg.ACT_INC_MASTER) { lay.inc_master(arg); return; }
    if (act == cfg.ACT_MFACT) { lay.mfact_step(arg); return; }
    if (act == cfg.ACT_MINIMIZE) {
        if (s.focused >= 0 && win.win_mapped(s.focused) == 1) { win.win_minimize(s.focused); }
        return;
    }
    if (act == cfg.ACT_MAXIMIZE) {
        if (s.focused >= 0 && win.win_mapped(s.focused) == 1) { win.win_toggle_max(s.focused); }
        return;
    }
    if (act == cfg.ACT_QUIT) {
        // Powering off is one chord away from closing a window (Super+Q), so
        // it takes the chord twice: the first press only asks. Then it is a
        // request like the power button's — every window asked to close first.
        let is i64 as now = sys.time_ns();
        if (now < s.quit_armed_until) {
            s.quit_armed_until = 0;
            sys.power_request(sys.POWER_OFF);
            return;
        }
        s.quit_armed_until = now + 4000000000;
        if (s.live_root == 1) {
            dec.notice(cast(*u8, "Power off? The live session's files go with it. Press Super+Shift+Q again"), 73, 4000000000);
        } else {
            dec.notice(cast(*u8, "Power off? Press Super+Shift+Q again"), 36, 4000000000);
        }
        return;
    }
    return;
}

// a = keysym, kb = mods|pressed<<8|ext<<9, sc = raw scancode. Binds gate on
// scancode + modifier mask — the key, wherever the layout puts its letter —
// and the keysym is forwarded as data to the child. A key that typed two
// characters (a dead key, then a letter it does not go on) comes as two
// events with the same scancode.
fn key_handle(keysym as i64, kb as i64, sc as i64) as void {
    let is i64 as pressed = cp.key_pressed(kb);
    let is i64 as ext = cp.key_ext(kb);
    let is i64 as mods = cp.key_mods(kb);
    s.mod_shift = mods & 1;
    s.mod_ctrl = (mods >> 1) & 1;
    s.mod_alt = (mods >> 2) & 1;
    s.mod_super = (mods >> 3) & 1;
    // Releasing the modifier that started a cycle commits the selected window
    // and closes the switcher overlay.
    if (s.alt_cycling == 1 && s.mod_alt == 0 && s.mod_super == 0) {
        win.win_cycle_commit();
        if (s.context_open == 1 && s.context_kind == 2) { context.close(); }
    }
    if (s.context_open == 1 && s.context_kind != 2) {
        context.key_handle(keysym, pressed);
        return;
    }
    if (s.context_open == 1 && s.context_kind == 2 && pressed == 1
        && (keysym == ks.KEY_ESC || keysym == ks.KEY_UP
            || keysym == ks.KEY_DOWN || keysym == ks.KEY_ENTER)) {
        context.key_handle(keysym, pressed);
        return;
    }
    if (pressed == 1 && ext == 0) {
        let is i64 as b = cfg.bind_find(mods, sc);
        if (b >= 0) {
            run_action(s.bind_act[b], s.bind_arg[b]);
            return;
        }
    }
    if (s.context_open == 1 && s.context_kind == 2) { return; }
    forward_key(keysym, kb, sc);
    return;
}
