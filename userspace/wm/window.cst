// wm/window.cst — window table + z-order + focus + geometry. Owns no state;
// reads/mutates wins[] / zord[] / nz in state.cst.

use "state.cst" as s;
use "damage.cst" as dmg;

fn win_init_all() as void {
    let is i64 as i with mut = 0;
    while (i < s.MAX_WIN) {
        s.wins[i].used = 0;
        s.wins[i].state = 0;
        s.wins[i].dec_fd = 0;
        i = i + 1;
    }
}

fn win_alloc() as i64 {
    let is i64 as i with mut = 0;
    while (i < s.MAX_WIN) {
        if (s.wins[i].used == 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn win_zremove(idx as i64) as void {
    let is i64 as k with mut = 0;
    let is i64 as found with mut = 0 - 1;
    while (k < s.nz) {
        if (s.zord[k] == idx) { found = k; }
        k = k + 1;
    }
    if (found < 0) { return; }
    let is i64 as j with mut = found;
    while (j < s.nz - 1) { s.zord[j] = s.zord[j + 1]; j = j + 1; }
    s.nz = s.nz - 1;
    return;
}

fn win_zraise(idx as i64) as void {
    win_zremove(idx);
    let is i64 as j with mut = s.nz;
    while (j > 0) { s.zord[j] = s.zord[j - 1]; j = j - 1; }
    s.zord[0] = idx;
    s.nz = s.nz + 1;
    return;
}

// Set focus to idx: raise, pend_focus flag for the child, damage the old
// and new frame so the compositor re-rasterises them.
fn win_focus(idx as i64) as void {
    s.scene_dirty = 1;
    s.deco_dirty = 1;
    dmg.dmg_taskbar();
    let is i64 as old with mut = 0 - 1;
    if (s.nz > 0) { old = s.zord[0]; }
    if (old == idx) { win_zraise(idx); return; }
    win_zraise(idx);
    if (old >= 0) {
        s.wins[old].pend_focus = 0;
        dmg.dmg_frame(old);
    }
    s.wins[idx].pend_focus = 1;
    dmg.dmg_frame(idx);
    return;
}

fn win_cycle() as void {
    if (s.nz >= 2) { win_focus(s.zord[1]); }
    return;
}

fn win_set_geom(i as i64, nx as i64, ny as i64, nw as i64, nh as i64) as void {
    dmg.dmg_frame(i);
    s.wins[i].x = nx; s.wins[i].y = ny;
    s.wins[i].w = nw; s.wins[i].h = nh;
    dmg.dmg_frame(i);
    s.scene_dirty = 1;
    s.deco_dirty = 1;
    s.wins[i].pend_resize_w = nw;
    s.wins[i].pend_resize_h = nh;
    return;
}

fn win_save_geom(i as i64) as void {
    s.wins[i].sav_x = s.wins[i].x; s.wins[i].sav_y = s.wins[i].y;
    s.wins[i].sav_w = s.wins[i].w; s.wins[i].sav_h = s.wins[i].h;
    return;
}

fn win_maximize(i as i64) as void {
    if (s.wins[i].maximized == 0) { win_save_geom(i); }
    win_set_geom(i, 0, 0, s.scr_w - 2 * s.BORDER, s.work_h - s.TITLE_H - 2 * s.BORDER);
    s.wins[i].maximized = 1;
    return;
}

fn win_snap(i as i64, rightside as i64) as void {
    if (s.wins[i].maximized == 0) { win_save_geom(i); }
    let is i64 as halfw = s.scr_w / 2;
    let is i64 as nx with mut = 0;
    if (rightside == 1) { nx = halfw; }
    win_set_geom(i, nx, 0, halfw - 2 * s.BORDER, s.work_h - s.TITLE_H - 2 * s.BORDER);
    s.wins[i].maximized = 1;
    return;
}

fn win_restore(i as i64) as void {
    win_set_geom(i, s.wins[i].sav_x, s.wins[i].sav_y, s.wins[i].sav_w, s.wins[i].sav_h);
    s.wins[i].maximized = 0;
    return;
}

fn win_toggle_max(i as i64) as void {
    if (s.wins[i].maximized == 1) { win_restore(i); } else { win_maximize(i); }
    return;
}

fn win_minimize(i as i64) as void {
    if (s.wins[i].minimized == 1) { return; }
    s.wins[i].minimized = 1;
    dmg.dmg_frame(i);
    dmg.dmg_taskbar();
    s.scene_dirty = 1;
    s.deco_dirty = 1;
    if (s.nz > 0 && s.zord[0] == i) {
        let is i64 as k with mut = 1;
        let is i64 as done with mut = 0;
        while (k < s.nz && done == 0) {
            let is i64 as cand = s.zord[k];
            if (s.wins[cand].used == 1 && s.wins[cand].state == 2 && s.wins[cand].minimized == 0) {
                win_focus(cand); done = 1;
            }
            k = k + 1;
        }
    }
    return;
}

fn win_unminimize(i as i64) as void {
    s.wins[i].minimized = 0;
    dmg.dmg_frame(i);
    dmg.dmg_taskbar();
    s.scene_dirty = 1;
    s.deco_dirty = 1;
    return;
}
