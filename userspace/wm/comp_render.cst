// compositor/render.cst — drawing primitives + cursor primitives + clip
// state. All read/write shape state lives in state.cst.
use "comp_state.cst" as s;
use "../../../Caustic/std/causticos/font.cst" as font;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/wmproto/wmproto.cst" as wmp;
use "../lib/compo_proto/compo_proto.cst" as cp;

fn iabs(v as i64) as i64 { if (v < 0) { return 0 - v; } return v; }

fn cfill(x as i64, y as i64, w as i64, h as i64, color as i64) as void {
    let is i64 as x0 with mut = x;
    let is i64 as y0 with mut = y;
    let is i64 as x1 with mut = x + w;
    let is i64 as y1 with mut = y + h;
    if (x0 < s.clip_x0) { x0 = s.clip_x0; }
    if (y0 < s.clip_y0) { y0 = s.clip_y0; }
    if (x1 > s.clip_x1) { x1 = s.clip_x1; }
    if (y1 > s.clip_y1) { y1 = s.clip_y1; }
    if (x1 <= x0 || y1 <= y0) { return; }
    let is i64 as yy with mut = y0;
    while (yy < y1) {
        let is *u32 as row = cast(*u32, s.fb_base + yy * s.scr_pitch);
        let is i64 as xx with mut = x0;
        while (xx < x1) { row[xx] = cast(u32, color); xx = xx + 1; }
        yy = yy + 1;
    }
    return;
}

fn cglyph(ch as i64, px as i64, py as i64, color as i64) as void {
    let is *u8 as g = font.get_glyph(cast(i32, ch));
    let is i64 as row with mut = 0;
    while (row < 16) {
        let is i64 as bits = cast(i64, g[row]);
        let is i64 as col with mut = 0;
        while (col < 8) {
            if ((bits & (128 >> col)) != 0) {
                let is i64 as xx = px + col;
                let is i64 as yy = py + row;
                if (xx >= s.clip_x0 && xx < s.clip_x1 && yy >= s.clip_y0 && yy < s.clip_y1) {
                    let is *u32 as p = cast(*u32, s.fb_base + yy * s.scr_pitch + xx * 4);
                    p[0] = cast(u32, color);
                }
            }
            col = col + 1;
        }
        row = row + 1;
    }
    return;
}

fn cpix(x as i64, y as i64, color as i64) as void {
    if (x >= s.clip_x0 && x < s.clip_x1 && y >= s.clip_y0 && y < s.clip_y1) {
        let is *u32 as p = cast(*u32, s.fb_base + y * s.scr_pitch + x * 4);
        p[0] = cast(u32, color);
    }
    return;
}

// ---- software cursor: arrow + resize/move/ibeam shapes. ----
fn cursor_init() as void {
    s.cur_o[0]  = 0x001; s.cur_f[0]  = 0x000;
    s.cur_o[1]  = 0x003; s.cur_f[1]  = 0x000;
    s.cur_o[2]  = 0x005; s.cur_f[2]  = 0x002;
    s.cur_o[3]  = 0x009; s.cur_f[3]  = 0x006;
    s.cur_o[4]  = 0x011; s.cur_f[4]  = 0x00E;
    s.cur_o[5]  = 0x021; s.cur_f[5]  = 0x01E;
    s.cur_o[6]  = 0x041; s.cur_f[6]  = 0x03E;
    s.cur_o[7]  = 0x081; s.cur_f[7]  = 0x07E;
    s.cur_o[8]  = 0x101; s.cur_f[8]  = 0x0FE;
    s.cur_o[9]  = 0x201; s.cur_f[9]  = 0x1FE;
    s.cur_o[10] = 0x3E1; s.cur_f[10] = 0x01E;
    s.cur_o[11] = 0x011; s.cur_f[11] = 0x00E;
    s.cur_o[12] = 0x009; s.cur_f[12] = 0x006;
    s.cur_o[13] = 0x005; s.cur_f[13] = 0x002;
    s.cur_o[14] = 0x003; s.cur_f[14] = 0x000;
    s.cur_o[15] = 0x001; s.cur_f[15] = 0x000;
    return;
}

fn tri_l(px as i64, py as i64, s_ as i64, col as i64) as void {
    let is i64 as i with mut = 0;
    while (i < s_) { cfill(px + i, py - i, 1, 2 * i + 1, col); i = i + 1; }
}
fn tri_r(px as i64, py as i64, s_ as i64, col as i64) as void {
    let is i64 as i with mut = 0;
    while (i < s_) { cfill(px - i, py - i, 1, 2 * i + 1, col); i = i + 1; }
}
fn tri_u(px as i64, py as i64, s_ as i64, col as i64) as void {
    let is i64 as i with mut = 0;
    while (i < s_) { cfill(px - i, py + i, 2 * i + 1, 1, col); i = i + 1; }
}
fn tri_d(px as i64, py as i64, s_ as i64, col as i64) as void {
    let is i64 as i with mut = 0;
    while (i < s_) { cfill(px - i, py - i, 2 * i + 1, 1, col); i = i + 1; }
}
fn dh_nw(px as i64, py as i64, s_ as i64, c as i64) as void {
    let is i64 as i with mut = 0;
    while (i < s_) { cfill(px, py + i, i + 1, 1, c); i = i + 1; }
}
fn dh_se(px as i64, py as i64, s_ as i64, c as i64) as void {
    let is i64 as i with mut = 0;
    while (i < s_) { cfill(px - i, py - i, i + 1, 1, c); i = i + 1; }
}
fn dh_ne(px as i64, py as i64, s_ as i64, c as i64) as void {
    let is i64 as i with mut = 0;
    while (i < s_) { cfill(px - i, py + i, i + 1, 1, c); i = i + 1; }
}
fn dh_sw(px as i64, py as i64, s_ as i64, c as i64) as void {
    let is i64 as i with mut = 0;
    while (i < s_) { cfill(px, py - i, i + 1, 1, c); i = i + 1; }
}
fn dshaft(cx as i64, cy as i64, half as i64, t as i64, c as i64) as void {
    let is i64 as i with mut = 0 - half;
    while (i <= half) { cfill(cx + i, cy + i, t, t, c); i = i + 1; }
}
fn dshaft2(cx as i64, cy as i64, half as i64, t as i64, c as i64) as void {
    let is i64 as i with mut = 0 - half;
    while (i <= half) { cfill(cx + i, cy - i, t, t, c); i = i + 1; }
}
fn cur_ew(cx as i64, cy as i64) as void {
    tri_l(cx - 9, cy, 5, s.CUR_BLACK); tri_r(cx + 9, cy, 5, s.CUR_BLACK); cfill(cx - 7, cy - 3, 14, 6, s.CUR_BLACK);
    tri_l(cx - 8, cy, 4, s.CUR_WHITE); tri_r(cx + 8, cy, 4, s.CUR_WHITE); cfill(cx - 6, cy - 1, 12, 2, s.CUR_WHITE);
}
fn cur_ns(cx as i64, cy as i64) as void {
    tri_u(cx, cy - 9, 5, s.CUR_BLACK); tri_d(cx, cy + 9, 5, s.CUR_BLACK); cfill(cx - 3, cy - 7, 6, 14, s.CUR_BLACK);
    tri_u(cx, cy - 8, 4, s.CUR_WHITE); tri_d(cx, cy + 8, 4, s.CUR_WHITE); cfill(cx - 1, cy - 6, 2, 12, s.CUR_WHITE);
}
fn cur_nwse(cx as i64, cy as i64) as void {
    dshaft(cx, cy, 6, 4, s.CUR_BLACK); dh_nw(cx - 7, cy - 7, 6, s.CUR_BLACK); dh_se(cx + 7, cy + 7, 6, s.CUR_BLACK);
    dshaft(cx, cy, 5, 2, s.CUR_WHITE); dh_nw(cx - 6, cy - 6, 4, s.CUR_WHITE); dh_se(cx + 6, cy + 6, 4, s.CUR_WHITE);
}
fn cur_nesw(cx as i64, cy as i64) as void {
    dshaft2(cx, cy, 6, 4, s.CUR_BLACK); dh_ne(cx + 7, cy - 7, 6, s.CUR_BLACK); dh_sw(cx - 7, cy + 7, 6, s.CUR_BLACK);
    dshaft2(cx, cy, 5, 2, s.CUR_WHITE); dh_ne(cx + 6, cy - 6, 4, s.CUR_WHITE); dh_sw(cx - 6, cy + 6, 4, s.CUR_WHITE);
}
fn cur_ibeam(cx as i64, cy as i64) as void {
    cfill(cx - 4, cy - 9, 8, 2, s.CUR_BLACK); cfill(cx - 2, cy - 9, 4, 18, s.CUR_BLACK); cfill(cx - 4, cy + 7, 8, 2, s.CUR_BLACK);
    cfill(cx - 3, cy - 8, 6, 1, s.CUR_WHITE); cfill(cx - 1, cy - 8, 2, 16, s.CUR_WHITE); cfill(cx - 3, cy + 7, 6, 1, s.CUR_WHITE);
}
fn cur_move(cx as i64, cy as i64) as void {
    cfill(cx - 10, cy - 2, 20, 4, s.CUR_BLACK); cfill(cx - 2, cy - 10, 4, 20, s.CUR_BLACK);
    tri_l(cx - 10, cy, 4, s.CUR_BLACK); tri_r(cx + 10, cy, 4, s.CUR_BLACK); tri_u(cx, cy - 10, 4, s.CUR_BLACK); tri_d(cx, cy + 10, 4, s.CUR_BLACK);
    cfill(cx - 9, cy - 1, 18, 2, s.CUR_WHITE); cfill(cx - 1, cy - 9, 2, 18, s.CUR_WHITE);
    tri_l(cx - 9, cy, 3, s.CUR_WHITE); tri_r(cx + 9, cy, 3, s.CUR_WHITE); tri_u(cx, cy - 9, 3, s.CUR_WHITE); tri_d(cx, cy + 9, 3, s.CUR_WHITE);
}
fn draw_arrow(cx as i64, cy as i64) as void {
    let is i64 as r with mut = 0;
    while (r < s.CUR_H) {
        let is i64 as c with mut = 0;
        while (c < s.CUR_W) {
            let is i64 as bit = 1 << c;
            if ((s.cur_f[r] & bit) != 0)      { cpix(cx + c, cy + r, s.CUR_WHITE); }
            else if ((s.cur_o[r] & bit) != 0) { cpix(cx + c, cy + r, s.CUR_BLACK); }
            c = c + 1;
        }
        r = r + 1;
    }
}
fn draw_cursor_at(cx as i64, cy as i64) as void {
    if (s.cur_shape == s.CUR_EW)         { cur_ew(cx, cy); }
    else if (s.cur_shape == s.CUR_NS)    { cur_ns(cx, cy); }
    else if (s.cur_shape == s.CUR_NWSE)  { cur_nwse(cx, cy); }
    else if (s.cur_shape == s.CUR_NESW)  { cur_nesw(cx, cy); }
    else if (s.cur_shape == s.CUR_IBEAM) { cur_ibeam(cx, cy); }
    else if (s.cur_shape == s.CUR_MOVE)  { cur_move(cx, cy); }
    else                                  { draw_arrow(cx, cy); }
}

// ---- big-glyph primitives used only by shutdown_screen ----
fn cglyph_big(ch as i64, px as i64, py as i64, color as i64, sc as i64) as void {
    let is *u8 as g = font.get_glyph(cast(i32, ch));
    let is i64 as row with mut = 0;
    while (row < 16) {
        let is i64 as bits = cast(i64, g[row]);
        let is i64 as col with mut = 0;
        while (col < 8) {
            if ((bits & (128 >> col)) != 0) { cfill(px + col * sc, py + row * sc, sc, sc, color); }
            col = col + 1;
        }
        row = row + 1;
    }
    return;
}
fn gtext_big(s_ as *u8, len as i64, x as i64, y as i64, color as i64, sc as i64) as void {
    let is i64 as k with mut = 0;
    while (k < len) { cglyph_big(cast(i64, s_[k]), x + k * 8 * sc, y, color, sc); k = k + 1; }
    return;
}
