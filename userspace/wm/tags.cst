// wm/tags.cst — which windows are on screen at all.
//
// A window carries a bitmask of the tags it belongs to; the WM shows the set
// in sel_tags. That is the whole model: there are no workspaces to move
// between, no window is ever "on" another screen, and a window can be on
// several tags at once. Bit 9 is the scratchpad — a tag whose visibility is
// toggled on top of whatever else is shown.

use "state.cst" as s;
use "window.cst" as win;
use "client.cst" as cli;
use "damage.cst" as dmg;

// Everything about the world just changed: what is drawn, what is arranged,
// and possibly what can hold focus.
fn _after_change() as void {
    if (s.focused >= 0 && win.win_visible(s.focused) == 0) {
        win.win_focus_fallback(s.focused);
    }
    if (s.focused < 0) { win.win_focus_fallback(0 - 1); }
    s.arrange_dirty = 1;
    s.scene_dirty = 1;
    s.deco_dirty = 1;
    s.layout_dirty = 1;
    dmg.dmg_all();
    return;
}

fn view_mask(mask as i64) as void {
    if (mask == 0) { return; }                  // an empty view shows nothing
    if (s.sel_tags == mask) { return; }
    s.sel_tags = mask;
    _after_change();
    return;
}

fn view_tag(idx as i64) as void {
    if (idx < 0 || idx >= s.TAG_COUNT) { return; }
    // Keep the scratchpad's visibility across a tag switch: it is a drop-down
    // that sits over whatever is shown, not a member of the tag you left.
    view_mask((1 << idx) | (s.sel_tags & s.SCRATCH_TAG));
    return;
}

fn view_all() as void {
    view_mask(s.TAG_MASK | (s.sel_tags & s.SCRATCH_TAG));
    return;
}

fn toggle_view(idx as i64) as void {
    if (idx < 0 || idx >= s.TAG_COUNT) { return; }
    let is i64 as m = s.sel_tags ^ (1 << idx);
    if ((m & s.TAG_MASK) == 0) { return; }      // never leave every tag hidden
    view_mask(m);
    return;
}

fn tag_focused(idx as i64) as void {
    if (idx < 0 || idx >= s.TAG_COUNT) { return; }
    if (s.focused < 0 || win.win_mapped(s.focused) == 0) { return; }
    s.wins[s.focused].tags = 1 << idx;
    _after_change();
    return;
}

fn toggle_tag_focused(idx as i64) as void {
    if (idx < 0 || idx >= s.TAG_COUNT) { return; }
    if (s.focused < 0 || win.win_mapped(s.focused) == 0) { return; }
    let is i64 as m = s.wins[s.focused].tags ^ (1 << idx);
    if ((m & (s.TAG_MASK | s.SCRATCH_TAG)) == 0) { return; }   // never orphan it
    s.wins[s.focused].tags = m;
    _after_change();
    return;
}

// ---- scratchpad -----------------------------------------------------------

// The scratchpad is one window on the reserved tag. Showing it is adding that
// tag to the view, which is why it appears over the current tag instead of
// taking you somewhere: visibility falls out of the same bitmask everything
// else uses.
fn scratch_alive() as i64 {
    if (s.scratch_win < 0) { return 0; }
    if (win.win_mapped(s.scratch_win) == 0) { return 0; }
    return 1;
}

fn toggle_scratch() as void {
    if (scratch_alive() == 0) {
        if (s.scratch_wait == 1) { return; }     // one is already on the way
        s.scratch_wait = 1;
        cli.spawn_client();
        s.sel_tags = s.sel_tags | s.SCRATCH_TAG;
        _after_change();
        return;
    }
    if ((s.sel_tags & s.SCRATCH_TAG) != 0) {
        s.sel_tags = s.sel_tags & (0 - 1 - s.SCRATCH_TAG);
        _after_change();
        return;
    }
    s.sel_tags = s.sel_tags | s.SCRATCH_TAG;
    _after_change();
    win.win_focus(s.scratch_win);
    return;
}

// scratch_send — hand the focused window to the scratchpad. It replaces any
// previous one (only one window can be THE scratchpad) and goes away with the
// tag it just joined.
fn scratch_send() as void {
    if (s.focused < 0 || win.win_mapped(s.focused) == 0) { return; }
    let is i64 as i = s.focused;
    s.wins[i].tags = s.SCRATCH_TAG;
    s.wins[i].floating = 1;
    s.scratch_win = i;
    s.sel_tags = s.sel_tags & (0 - 1 - s.SCRATCH_TAG);
    _after_change();
    return;
}
