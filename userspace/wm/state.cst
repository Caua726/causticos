// wm/state.cst — all WM constants and mutable globals in one place. Modules
// access via qualified names ("s.wins", "s.scr_w"); no module imports another
// wm module, so no cycles. Pure data + Win struct; no logic here.

struct Win {
    used as i64;
    state as i64;
    chan as i64;
    pid as i64;
    seg_fd as i64;
    seg_base as i64;
    seg_pages as i64;
    seg_stride as i64;
    x as i64;
    y as i64;
    w as i64;
    h as i64;
    title_len as i64;
    t0 as i64;
    t1 as i64;
    // The program name it was spawned as, packed like the title. The title is
    // the client's to change (the wterm retitles itself per command); the spawn
    // name is not, so rules (float/swallow) and the saved layout key off this.
    name_len as i64;
    n0 as i64;
    n1 as i64;
    drops as i64;
    pend_resize_w as i64;
    pend_resize_h as i64;
    pend_focus as i64;
    pend_close as i64;
    hello_deadline as i64;
    mb_fill as i64;
    maximized as i64;
    sav_x as i64;
    sav_y as i64;
    sav_w as i64;
    sav_h as i64;
    minimized as i64;
    is_text as i64;
    dec_fd as i64;
    dec_base as i64;
    dec_pages as i64;
    dec_attached as i64;
    tags as i64;              // bitmask: bit 0..8 = tags 1..9, bit 9 = scratchpad
    floating as i64;          // 1 = the layout does not place it
    swallowed_by as i64;      // window that took this one's place, or -1
    swallowing as i64;        // window this one displaced, or -1
    anim_open as i64;         // lib/anim slot driving the open tween, or ANIM_NONE
    anim_close as i64;        // ditto for the close tween
    anim_focus as i64;        // border/titlebar focus blend tween
    anim_geom as i64;         // geometry tween (maximise/snap/restore)
    geom_fx as i64;           // rect the geometry tween starts from
    geom_fy as i64;
    geom_fw as i64;
    geom_fh as i64;
    anim_task as i64;         // taskbar button reveal tween
    closing as i64;           // 1 = fading out; teardown runs when the tween ends
    close_wait as i64;        // the do_wait the deferred teardown must use
}

// Win.anim_* hold lib/anim slot ids; ANIM_NONE mirrors anim.NONE so state.cst
// stays import-free (no wm module imports another, so there are no cycles).
let is i64 as ANIM_NONE with imut = 0 - 1;

let is i64 as MAX_WIN   with imut = 64;
let is i64 as FRAME_NS  with imut = 16666667;
let is i64 as HELLO_NS  with imut = 5000000000;
let is i64 as MAX_DROPS with imut = 256;
let is i64 as DCLICK_NS with imut = 400000000;

// Metrics. Compiled defaults, overridable from /etc/wm.cst + /var/wm/config.cst
// (config.cst) and mirrored to the compositor as style keys — both sides draw
// the same frame or the border and the content disagree by a pixel.
let is i64 as TITLE_H   with mut = 20;
let is i64 as BORDER    with mut = 1;
let is i64 as MIN_W     with mut = 160;
let is i64 as MIN_H     with mut = 64;
let is i64 as BTN_W     with mut = 24;
let is i64 as SNAP_PX   with mut = 12;
let is i64 as DRAG_HALO with mut = 4;    // px the drag outline sits outside the frame
let is i64 as BAR_H     with mut = 26;
let is i64 as TASK_W    with mut = 150;

let is i64 as CUR_ARROW with imut = 0;
let is i64 as CUR_EW    with imut = 1;
let is i64 as CUR_NS    with imut = 2;
let is i64 as CUR_NWSE  with imut = 3;
let is i64 as CUR_NESW  with imut = 4;
let is i64 as CUR_IBEAM with imut = 5;
let is i64 as CUR_MOVE  with imut = 6;

let is i64 as DIR_N with imut = 1;
let is i64 as DIR_S with imut = 2;
let is i64 as DIR_W with imut = 4;
let is i64 as DIR_E with imut = 8;
let is i64 as EDGE  with imut = 6;

let is i64 as COL_BORDER_F with mut = 0x0073d0ff;
let is i64 as COL_BORDER_U with mut = 0x003a4048;
let is i64 as COL_TITLE_F  with mut = 0x002a3a4a;
let is i64 as COL_TITLE_U  with mut = 0x001c2228;
let is i64 as COL_TEXT     with mut = 0x00d3d7cf;
let is i64 as COL_CLOSE_H  with mut = 0x00c84040;
let is i64 as COL_BAR      with mut = 0x00161b21;
let is i64 as COL_BAR_ITEM with mut = 0x00262f38;
let is i64 as COL_BAR_DIM  with mut = 0x008a909a;
let is i64 as COL_MAX_H    with mut = 0x00c8a020;
let is i64 as COL_MIN_H    with mut = 0x005a6570;
let is i64 as COL_DESKTOP  with mut = 0x00202830;

let is [64]Win as wins with mut;
let is [2048]u8 as mbufs with mut;
let is [64]i64 as zord with mut;
let is i64 as nz with mut = 0;
let is [64]i64 as writable with mut;
let is [64]i64 as quota with mut;

// The focused window, held explicitly. It used to be implied by zord[0], which
// made "focused" and "on top" the same fact — and Alt-Tab needs them apart: it
// walks the stack focusing as it goes and only raises on release.
let is i64 as focused with mut = 0 - 1;
let is i64 as alt_cycling with mut = 0;

let is [32]i64 as dmg with mut;
let is i64 as dmg_n with mut = 0;
let is i64 as dmg_full with mut = 0;

// Animations live in lib/anim; this is the live count from the last frame's
// tick_all. Anything reading an animated value damages its own rects — the
// tick has no idea which pixels a value maps to.
let is i64 as anim_live with mut = 0;

let is i64 as wc_fd with mut = 0;
let is i64 as scene_dirty with mut = 1;
let is i64 as deco_dirty with mut = 1;
let is i64 as style_dirty with mut = 1;   // metrics/palette to (re)send to the compositor

// ---- tags + layout ------------------------------------------------------
let is i64 as TAG_COUNT   with imut = 9;
let is i64 as SCRATCH_BIT with imut = 9;
let is i64 as SCRATCH_TAG with imut = 512;    // 1 << 9
let is i64 as TAG_MASK    with imut = 511;    // tags 1..9

let is i64 as LAY_TILE    with imut = 0;
let is i64 as LAY_MONOCLE with imut = 1;
let is i64 as LAY_FLOAT   with imut = 2;
let is i64 as LAY_COUNT   with imut = 3;

let is i64 as sel_tags with mut = 1;
let is [10]i64 as tag_layout with mut;        // layout per tag (index 9 = scratchpad)
let is i64 as mfact with mut = 55;            // master column, percent of the work area
let is i64 as nmaster with mut = 1;
let is i64 as arrange_dirty with mut = 0;

// The tiling order: which window is master and what follows it. Separate from
// zord (paint/MRU) because raising a window must not re-tile the screen.
let is [64]i64 as tord with mut;
let is i64 as ntord with mut = 0;

let is i64 as scratch_win with mut = 0 - 1;   // the scratchpad window, or -1
let is i64 as scratch_wait with mut = 0;      // 1 = a scratchpad spawn is in flight

// Titlebar/bar hover: what the pointer is over and the ramp driving its
// highlight. One ramp is enough — only one item is ever hovered.
let is i64 as HOV_NONE with imut = 0;
let is i64 as HOV_BTN  with imut = 1;         // a titlebar button on hover_win
let is i64 as HOV_TAG  with imut = 2;         // a taskbar tag box (hover_btn = tag idx)
let is i64 as HOV_ITEM with imut = 3;         // a taskbar window button
let is i64 as HOV_LAY  with imut = 4;         // the layout symbol
let is i64 as hover_win with mut = 0 - 1;
let is i64 as hover_btn with mut = 0;
let is i64 as hover_kind with mut = 0;
let is i64 as hover_on with mut = 0;          // 1 = pointer still on it (ramp up)
let is i64 as anim_hover with mut = 0 - 1;

// Drag velocity, sampled per motion event, for the release fling.
let is i64 as drag_vx with mut = 0;
let is i64 as drag_vy with mut = 0;
let is i64 as drag_px with mut = 0;
let is i64 as drag_py with mut = 0;

let is i64 as scr_w with mut = 0;
let is i64 as scr_h with mut = 0;
let is i64 as work_h with mut = 0;
let is i64 as have_geom with mut = 0;

let is i64 as cmd_fd with mut = 0;
let is i64 as cmd_fill with mut = 0;
let is [32]u8 as cmd_acc with mut;
let is i64 as mod_alt with mut = 0;
let is i64 as mod_super with mut = 0;
let is i64 as mod_shift with mut = 0;
let is i64 as mod_ctrl with mut = 0;
let is i64 as mx with mut = 0;
let is i64 as my with mut = 0;
let is i64 as mbuttons with mut = 0;

let is [12]u8 as clock_str with mut;
let is i64 as clock_len with mut = 0;
let is i64 as clock_next with mut = 0;

let is i64 as tb_dec_fd with mut = 0;
let is i64 as tb_dec_base with mut = 0;
let is i64 as tb_dec_pages with mut = 0;
let is i64 as tb_cols with mut = 0;
let is i64 as tb_attached with mut = 0;
// The minimised-button pulse is redrawn in steps, not every frame: a bar that
// repainted at 60 Hz for a breathing colour would cost more than the whole
// desktop it sits under.
let is i64 as pulse_next with mut = 0;

// The taskbar's cell layout, computed once per render and read by the
// hit-test. Two copies of this arithmetic is how a click lands two pixels off
// the button it appears to be on.
let is i64 as tb_lay_c0 with mut = 0;         // first cell of the layout symbol
let is i64 as tb_lay_cw with mut = 4;
let is i64 as tb_item_c0 with mut = 0;        // first cell of the window buttons
let is i64 as tb_item_cw with mut = 0;        // cells per button (including the gap)
let is [64]i64 as tb_items with mut;          // window index drawn in each slot
let is i64 as tb_nitems with mut = 0;
let is i64 as tb_hidden with mut = 0;         // windows that did not fit

let is i64 as img_base with mut = 0;
let is i64 as img_len with mut = 0;

let is i64 as shutdown_state with mut = 0;
let is i64 as shutdown_deadline with mut = 0;

let is i64 as cur_shape with mut = 0;
let is i64 as cur_last_shape with mut = 0;

// Overlay chrome the WM asks the compositor to draw over the scene: slot 0 =
// the dragged window's outline, slot 1 = the edge-snap ghost. ovl_dirty marks
// them for the next flush so a still drag does not re-send every frame.
let is [2]i64 as ovl_on with mut;
let is [8]i64 as ovl_rect with mut;
let is i64 as ovl_dirty with mut = 0;

let is i64 as drag_mode with mut = 0;
let is i64 as drag_win with mut = 0;
let is i64 as drag_dirs with mut = 0;
let is i64 as drag_ax with mut = 0;
let is i64 as drag_ay with mut = 0;
let is i64 as drag_ox with mut = 0;
let is i64 as drag_oy with mut = 0;
let is i64 as drag_ow with mut = 0;
let is i64 as drag_oh with mut = 0;
let is i64 as last_click_ns with mut = 0;
let is i64 as last_click_win with mut = 0 - 1;

// ---- config (see config.cst) --------------------------------------------
// A bind is (mods, scancode) -> (action, arg). Modifiers are the MOD_* mask of
// compo_proto; the scancode keeps hotkeys layout-independent.
let is i64 as BIND_MAX with imut = 64;
let is [64]i64 as bind_mods with mut;
let is [64]i64 as bind_sc with mut;
let is [64]i64 as bind_act with mut;
let is [64]i64 as bind_arg with mut;
let is i64 as bind_n with mut = 0;

// Rule tables: a program name (packed 16 bytes, as spawned) and what it means.
let is i64 as RULE_MAX with imut = 16;
let is [16]i64 as float_n0 with mut;
let is [16]i64 as float_n1 with mut;
let is [16]i64 as float_len with mut;
let is i64 as float_n with mut = 0;
let is [16]i64 as swal_n0 with mut;
let is [16]i64 as swal_n1 with mut;
let is [16]i64 as swal_len with mut;
let is i64 as swal_n with mut = 0;

let is i64 as cfg_mtime_etc with mut = 0;
let is i64 as cfg_mtime_var with mut = 0;
let is i64 as cfg_next_check with mut = 0;

// ---- persisted layout (see persist.cst) ---------------------------------
let is i64 as RST_MAX with imut = 32;
let is [32]i64 as rst_n0 with mut;            // program name, packed
let is [32]i64 as rst_n1 with mut;
let is [32]i64 as rst_len with mut;
let is [32]i64 as rst_x with mut;
let is [32]i64 as rst_y with mut;
let is [32]i64 as rst_w with mut;
let is [32]i64 as rst_h with mut;
let is [32]i64 as rst_tags with mut;
let is [32]i64 as rst_float with mut;
let is [32]i64 as rst_used with mut;          // 0 once claimed by a mapped window
let is i64 as rst_n with mut = 0;
let is i64 as layout_dirty with mut = 0;
let is i64 as layout_next_save with mut = 0;
