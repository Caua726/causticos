// wm/state.cst — all WM constants and mutable globals in one place. Modules
// access via qualified names ("s.wins", "s.scr_w"); no module imports another
// wm module, so no cycles. Pure data + Win struct; no logic here.

struct Win {
    used as i64;
    state as i64;
    chan as i64;
    pid as i64;
    seg_fd as i64;
    seg_base as i64;
    seg_pages as i64;
    seg_stride as i64;
    x as i64;
    y as i64;
    w as i64;
    h as i64;
    title_len as i64;
    t0 as i64;
    t1 as i64;
    drops as i64;
    pend_resize_w as i64;
    pend_resize_h as i64;
    pend_focus as i64;
    pend_close as i64;
    hello_deadline as i64;
    mb_fill as i64;
    maximized as i64;
    sav_x as i64;
    sav_y as i64;
    sav_w as i64;
    sav_h as i64;
    minimized as i64;
    is_text as i64;
    dec_fd as i64;
    dec_base as i64;
    dec_pages as i64;
    dec_attached as i64;
    anim_open as i64;         // lib/anim slot driving the open tween, or ANIM_NONE
    anim_close as i64;        // ditto for the close tween
    anim_focus as i64;        // border/titlebar focus blend tween
    anim_geom as i64;         // geometry tween (maximise/snap/restore)
    geom_fx as i64;           // rect the geometry tween starts from
    geom_fy as i64;
    geom_fw as i64;
    geom_fh as i64;
    anim_task as i64;         // taskbar button reveal tween
    closing as i64;           // 1 = fading out; teardown runs when the tween ends
    close_wait as i64;        // the do_wait the deferred teardown must use
}

// Win.anim_* hold lib/anim slot ids; ANIM_NONE mirrors anim.NONE so state.cst
// stays import-free (no wm module imports another, so there are no cycles).
let is i64 as ANIM_NONE with imut = 0 - 1;

let is i64 as MAX_WIN   with imut = 8;
let is i64 as TITLE_H   with imut = 20;
let is i64 as BORDER    with imut = 1;
let is i64 as FRAME_NS  with imut = 16666667;
let is i64 as MIN_W     with imut = 160;
let is i64 as MIN_H     with imut = 64;
let is i64 as HELLO_NS  with imut = 5000000000;
let is i64 as MAX_DROPS with imut = 256;
let is i64 as BTN_W     with imut = 24;
let is i64 as SNAP_PX   with imut = 12;
let is i64 as DRAG_HALO with imut = 4;    // px the drag outline sits outside the frame
let is i64 as DCLICK_NS with imut = 400000000;
let is i64 as BAR_H     with imut = 26;
let is i64 as TASK_W    with imut = 150;

let is i64 as CUR_ARROW with imut = 0;
let is i64 as CUR_EW    with imut = 1;
let is i64 as CUR_NS    with imut = 2;
let is i64 as CUR_NWSE  with imut = 3;
let is i64 as CUR_NESW  with imut = 4;
let is i64 as CUR_IBEAM with imut = 5;
let is i64 as CUR_MOVE  with imut = 6;

let is i64 as DIR_N with imut = 1;
let is i64 as DIR_S with imut = 2;
let is i64 as DIR_W with imut = 4;
let is i64 as DIR_E with imut = 8;
let is i64 as EDGE  with imut = 6;

let is i64 as COL_BORDER_F with imut = 0x0073d0ff;
let is i64 as COL_BORDER_U with imut = 0x003a4048;
let is i64 as COL_TITLE_F  with imut = 0x002a3a4a;
let is i64 as COL_TITLE_U  with imut = 0x001c2228;
let is i64 as COL_TEXT     with imut = 0x00d3d7cf;
let is i64 as COL_CLOSE_H  with imut = 0x00c84040;
let is i64 as COL_BAR      with imut = 0x00161b21;
let is i64 as COL_BAR_ITEM with imut = 0x00262f38;
let is i64 as COL_BAR_DIM  with imut = 0x008a909a;

let is [8]Win as wins with mut;
let is [256]u8 as mbufs with mut;
let is [8]i64 as zord with mut;
let is i64 as nz with mut = 0;
let is [8]i64 as writable with mut;
let is [8]i64 as quota with mut;

let is [32]i64 as dmg with mut;
let is i64 as dmg_n with mut = 0;
let is i64 as dmg_full with mut = 0;

// Animations live in lib/anim; this is the live count from the last frame's
// tick_all. Anything reading an animated value damages its own rects — the
// tick has no idea which pixels a value maps to.
let is i64 as anim_live with mut = 0;

let is i64 as wc_fd with mut = 0;
let is i64 as scene_dirty with mut = 1;
let is i64 as deco_dirty with mut = 1;

// Titlebar button hover: which window/button the pointer is over, and the ramp
// driving its highlight. One ramp is enough — only one button is ever hovered.
let is i64 as hover_win with mut = 0 - 1;
let is i64 as hover_btn with mut = 0;
let is i64 as hover_on with mut = 0;      // 1 = pointer still on it (ramp up)
let is i64 as anim_hover with mut = 0 - 1;

// Drag velocity, sampled per motion event, for the release fling.
let is i64 as drag_vx with mut = 0;
let is i64 as drag_vy with mut = 0;
let is i64 as drag_px with mut = 0;
let is i64 as drag_py with mut = 0;

let is i64 as COL_MAX_H with imut = 0x00c8a020;
let is i64 as COL_MIN_H with imut = 0x005a6570;

let is i64 as scr_w with mut = 0;
let is i64 as scr_h with mut = 0;
let is i64 as work_h with mut = 0;
let is i64 as have_geom with mut = 0;

let is i64 as cmd_fd with mut = 0;
let is i64 as cmd_fill with mut = 0;
let is [32]u8 as cmd_acc with mut;
let is i64 as mod_alt with mut = 0;
let is i64 as mod_super with mut = 0;
let is i64 as mx with mut = 0;
let is i64 as my with mut = 0;
let is i64 as mbuttons with mut = 0;

let is [12]u8 as clock_str with mut;
let is i64 as clock_len with mut = 0;
let is i64 as clock_next with mut = 0;

let is i64 as tb_dec_fd with mut = 0;
let is i64 as tb_dec_base with mut = 0;
let is i64 as tb_dec_pages with mut = 0;
let is i64 as tb_cols with mut = 0;
let is i64 as tb_attached with mut = 0;
let is i64 as tb_dirty with mut = 1;

let is i64 as img_base with mut = 0;
let is i64 as img_len with mut = 0;

let is i64 as shutdown_state with mut = 0;
let is i64 as shutdown_deadline with mut = 0;

let is i64 as cur_shape with mut = 0;
let is i64 as cur_last_shape with mut = 0;

// Overlay chrome the WM asks the compositor to draw over the scene: slot 0 =
// the dragged window's outline, slot 1 = the edge-snap ghost. ovl_dirty marks
// them for the next flush so a still drag does not re-send every frame.
let is [2]i64 as ovl_on with mut;
let is [8]i64 as ovl_rect with mut;
let is i64 as ovl_dirty with mut = 0;

let is i64 as drag_mode with mut = 0;
let is i64 as drag_win with mut = 0;
let is i64 as drag_dirs with mut = 0;
let is i64 as drag_ax with mut = 0;
let is i64 as drag_ay with mut = 0;
let is i64 as drag_ox with mut = 0;
let is i64 as drag_oy with mut = 0;
let is i64 as drag_ow with mut = 0;
let is i64 as drag_oh with mut = 0;
let is i64 as last_click_ns with mut = 0;
let is i64 as last_click_win with mut = 0 - 1;
