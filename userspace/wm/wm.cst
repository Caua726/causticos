// wm.cst — the CausticOS window manager / compositor.
//
// The one process that owns the screen and the input devices. Everybody
// else draws into a shared SEGMENT and talks to us over a channel
// (userspace/wmproto.cst); we composite back-to-front into the surface
// backbuffer and present only what changed. Policy lives here — the kernel
// gave us poll/segments/channels/devices and nothing else.
//
//   input:  keyboard + mouse fds (raw events; we keep the keymap-free ones
//           and forward scancodes to the focused client)
//   output: DEV_FB surface, damage-rect composition
//   loop:   one SYS_POLL over everything + a ~60Hz frame deadline
//
// Hotkeys (consumed, never forwarded): Alt+Tab cycle focus, Super+Enter
// spawn a terminal, Super+Q ask the focused window to close.

use "../../../Caustic/std/causticos/gfx.cst" as gfx;
use "../../../Caustic/std/causticos/font.cst" as font;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/wmproto.cst" as wmp;

// ---- layout & palette ----
let is i64 as MAX_WIN  with imut = 8;
let is i64 as TITLE_H  with imut = 20;
let is i64 as BORDER   with imut = 1;
let is i64 as FRAME_NS with imut = 16666667;   // ~60 Hz compose tick
let is i64 as MIN_W    with imut = 160;
let is i64 as MIN_H    with imut = 64;
let is i64 as HELLO_NS with imut = 5000000000; // 5s for a client to handshake
let is i64 as MAX_DROPS with imut = 256;       // stuck-client disconnect bar
let is i64 as BTN_W     with imut = 24;        // titlebar control button width
let is i64 as SNAP_PX   with imut = 12;        // drag-to-edge snap trigger band
let is i64 as DCLICK_NS with imut = 400000000; // titlebar double-click window (400ms)
let is i64 as COL_CLOSE_H with imut = 0x00c84040;  // close-button hover red

let is i64 as COL_DESKTOP  with imut = 0x00202830;
let is i64 as COL_BORDER_F with imut = 0x0073d0ff;
let is i64 as COL_BORDER_U with imut = 0x003a4048;
let is i64 as COL_TITLE_F  with imut = 0x002a3a4a;
let is i64 as COL_TITLE_U  with imut = 0x001c2228;
let is i64 as COL_TEXT     with imut = 0x00d3d7cf;

// ---- the window table ----
// state: 0 = free, 1 = spawned/awaiting HELLO, 2 = live (segment mapped).
struct Win {
    used as i64;  state as i64;
    chan as i64;  pid as i64;
    seg_fd as i64;  seg_base as i64;  seg_pages as i64;  seg_stride as i64;
    x as i64;  y as i64;  w as i64;  h as i64;       // x,y = FRAME corner; w,h = content
    title_len as i64;  t0 as i64;  t1 as i64;
    drops as i64;
    pend_resize_w as i64;  pend_resize_h as i64;     // 0 = none (slot: last wins)
    pend_focus as i64;                               // -1 = none, else 0|1
    pend_close as i64;
    hello_deadline as i64;
    mb_fill as i64;                                  // partial-message fill (buf in mbufs)
    maximized as i64;                                // 0 = floating, 1 = maximized/snapped
    sav_x as i64;  sav_y as i64;  sav_w as i64;  sav_h as i64;   // geometry to restore
}
let is [8]Win as wins with mut;
let is [256]u8 as mbufs with mut;                    // 8 × 32B message accumulators
let is [8]i64 as zord with mut;                      // zord[0] = top of the stack
let is i64 as nz with mut = 0;

// per-sweep snapshots (filled from each poll's got bits)
let is [8]i64 as writable with mut;
let is [8]i64 as quota with mut;                     // msgs sent this sweep (cap 2)

// ---- screen ----
let is i64 as scr_w with mut = 0;
let is i64 as scr_h with mut = 0;
let is i64 as scr_pitch with mut = 0;
let is i64 as fb_base with mut = 0;
let is i64 as fb_fd with mut = 0;

// ---- input ----
let is i64 as kbd_fd with mut = 0;
let is i64 as mouse_fd with mut = 0;
let is i64 as tab_fd with mut = 0;     // virtio tablet: absolute position, no grab
let is i64 as mod_alt with mut = 0;
let is i64 as mod_super with mut = 0;
let is i64 as mx with mut = 0;
let is i64 as my with mut = 0;
let is i64 as mbuttons with mut = 0;

// ---- software cursor: a 10x16 arrow, black outline + white fill, drawn
// last in every composed rect. Bit c of row r = pixel at column c. ----
let is i64 as CUR_W with imut = 10;
let is i64 as CUR_H with imut = 16;
let is [16]i64 as cur_o with mut;    // outline mask per row
let is [16]i64 as cur_f with mut;    // fill mask per row
let is i64 as cur_last_x with mut = 0;
let is i64 as cur_last_y with mut = 0;

fn cursor_init() as void {
    cur_o[0]  = 0x001; cur_f[0]  = 0x000;
    cur_o[1]  = 0x003; cur_f[1]  = 0x000;
    cur_o[2]  = 0x005; cur_f[2]  = 0x002;
    cur_o[3]  = 0x009; cur_f[3]  = 0x006;
    cur_o[4]  = 0x011; cur_f[4]  = 0x00E;
    cur_o[5]  = 0x021; cur_f[5]  = 0x01E;
    cur_o[6]  = 0x041; cur_f[6]  = 0x03E;
    cur_o[7]  = 0x081; cur_f[7]  = 0x07E;
    cur_o[8]  = 0x101; cur_f[8]  = 0x0FE;
    cur_o[9]  = 0x201; cur_f[9]  = 0x1FE;
    cur_o[10] = 0x3E1; cur_f[10] = 0x01E;
    cur_o[11] = 0x011; cur_f[11] = 0x00E;
    cur_o[12] = 0x009; cur_f[12] = 0x006;
    cur_o[13] = 0x005; cur_f[13] = 0x002;
    cur_o[14] = 0x003; cur_f[14] = 0x000;
    cur_o[15] = 0x001; cur_f[15] = 0x000;
    return;
}

// ---- drag state machine (move = pure WM bookkeeping; resize also streams
// RESIZE to the client so it can re-lay its grid out) ----
let is i64 as DIR_N with imut = 1;
let is i64 as DIR_S with imut = 2;
let is i64 as DIR_W with imut = 4;
let is i64 as DIR_E with imut = 8;
let is i64 as EDGE  with imut = 6;     // resize band, px from the frame edge

let is i64 as drag_mode with mut = 0;  // 0 none, 1 move, 2 resize
let is i64 as drag_win with mut = 0;
let is i64 as drag_dirs with mut = 0;
let is i64 as drag_ax with mut = 0;    // mouse at press
let is i64 as drag_ay with mut = 0;
let is i64 as drag_ox with mut = 0;    // window geometry at press
let is i64 as drag_oy with mut = 0;
let is i64 as drag_ow with mut = 0;
let is i64 as drag_oh with mut = 0;
let is i64 as last_click_ns with mut = 0;        // titlebar double-click → maximize
let is i64 as last_click_win with mut = 0 - 1;

// ---- the client image (/wmpat.cse for now; the terminal later) ----
let is i64 as img_base with mut = 0;
let is i64 as img_len with mut = 0;

// ============================================================
// Damage: a small rect list, collapsing to full-screen on overflow.
// ============================================================

let is [32]i64 as dmg with mut;                      // 8 × {x,y,w,h}
let is i64 as dmg_n with mut = 0;
let is i64 as dmg_full with mut = 0;

fn damage(x as i64, y as i64, w as i64, h as i64) as void {
    if (dmg_full == 1) { return; }
    let is i64 as x0 with mut = x;
    let is i64 as y0 with mut = y;
    let is i64 as x1 with mut = x + w;
    let is i64 as y1 with mut = y + h;
    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    if (x1 > scr_w) { x1 = scr_w; }
    if (y1 > scr_h) { y1 = scr_h; }
    if (x1 <= x0 || y1 <= y0) { return; }
    // Merge into an overlapping rect instead of stacking near-duplicates:
    // a drag damages old+new frames that mostly coincide — composing the
    // overlap twice per frame was pure waste.
    let is i64 as k with mut = 0;
    while (k < dmg_n) {
        let is i64 as ex0 = dmg[k*4+0];
        let is i64 as ey0 = dmg[k*4+1];
        let is i64 as ex1 = ex0 + dmg[k*4+2];
        let is i64 as ey1 = ey0 + dmg[k*4+3];
        if (x0 < ex1 && x1 > ex0 && y0 < ey1 && y1 > ey0) {
            let is i64 as nx0 with mut = x0;
            let is i64 as ny0 with mut = y0;
            let is i64 as nx1 with mut = x1;
            let is i64 as ny1 with mut = y1;
            if (ex0 < nx0) { nx0 = ex0; }
            if (ey0 < ny0) { ny0 = ey0; }
            if (ex1 > nx1) { nx1 = ex1; }
            if (ey1 > ny1) { ny1 = ey1; }
            dmg[k*4+0] = nx0;
            dmg[k*4+1] = ny0;
            dmg[k*4+2] = nx1 - nx0;
            dmg[k*4+3] = ny1 - ny0;
            return;
        }
        k = k + 1;
    }
    if (dmg_n >= 8) { dmg_full = 1; return; }
    dmg[dmg_n * 4 + 0] = x0;
    dmg[dmg_n * 4 + 1] = y0;
    dmg[dmg_n * 4 + 2] = x1 - x0;
    dmg[dmg_n * 4 + 3] = y1 - y0;
    dmg_n = dmg_n + 1;
    return;
}

fn damage_all() as void { dmg_full = 1; return; }

fn damage_frame(i as i64) as void {
    damage(wins[i].x, wins[i].y,
           wins[i].w + 2 * BORDER, wins[i].h + TITLE_H + 2 * BORDER);
    return;
}

// ============================================================
// Clipped drawing primitives. compose_rect() sets the clip box; everything
// drawn during composition stays inside it — that is what makes per-rect
// re-composition correct against overlapping windows.
// ============================================================

let is i64 as clip_x0 with mut = 0;
let is i64 as clip_y0 with mut = 0;
let is i64 as clip_x1 with mut = 0;
let is i64 as clip_y1 with mut = 0;

fn cfill(x as i64, y as i64, w as i64, h as i64, color as i64) as void {
    let is i64 as x0 with mut = x;
    let is i64 as y0 with mut = y;
    let is i64 as x1 with mut = x + w;
    let is i64 as y1 with mut = y + h;
    if (x0 < clip_x0) { x0 = clip_x0; }
    if (y0 < clip_y0) { y0 = clip_y0; }
    if (x1 > clip_x1) { x1 = clip_x1; }
    if (y1 > clip_y1) { y1 = clip_y1; }
    if (x1 <= x0 || y1 <= y0) { return; }
    let is i64 as yy with mut = y0;
    while (yy < y1) {
        let is *u32 as row = cast(*u32, fb_base + yy * scr_pitch);
        let is i64 as xx with mut = x0;
        while (xx < x1) { row[xx] = cast(u32, color); xx = xx + 1; }
        yy = yy + 1;
    }
    return;
}

fn cglyph(ch as i64, px as i64, py as i64, color as i64) as void {
    let is *u8 as g = font.get_glyph(cast(i32, ch));
    let is i64 as row with mut = 0;
    while (row < 16) {
        let is i64 as bits = cast(i64, g[row]);
        let is i64 as col with mut = 0;
        while (col < 8) {
            if ((bits & (128 >> col)) != 0) {
                let is i64 as xx = px + col;
                let is i64 as yy = py + row;
                if (xx >= clip_x0 && xx < clip_x1 && yy >= clip_y0 && yy < clip_y1) {
                    let is *u32 as p = cast(*u32, fb_base + yy * scr_pitch + xx * 4);
                    p[0] = cast(u32, color);
                }
            }
            col = col + 1;
        }
        row = row + 1;
    }
    return;
}

// One clipped pixel — for diagonal icon strokes cfill can't draw.
fn cpix(x as i64, y as i64, color as i64) as void {
    if (x >= clip_x0 && x < clip_x1 && y >= clip_y0 && y < clip_y1) {
        let is *u32 as p = cast(*u32, fb_base + y * scr_pitch + x * 4);
        p[0] = cast(u32, color);
    }
    return;
}
// A 1px-thick rectangle outline (4 cfills).
fn rect_outline(x as i64, y as i64, w as i64, h as i64, color as i64) as void {
    cfill(x, y, w, 1, color); cfill(x, y + h - 1, w, 1, color);
    cfill(x, y, 1, h, color); cfill(x + w - 1, y, 1, h, color);
    return;
}
// An X of size sz from (x0,y0) — the close-button glyph.
fn draw_x(x0 as i64, y0 as i64, sz as i64, color as i64) as void {
    let is i64 as k with mut = 0;
    while (k < sz) {
        cpix(x0 + k, y0 + k, color);
        cpix(x0 + k, y0 + sz - 1 - k, color);
        k = k + 1;
    }
    return;
}

// Titlebar control buttons [ max/restore ][ close ], right-aligned. `tcol` is
// the titlebar fill (used to clear behind the restore icon's front square).
fn draw_win_buttons(i as i64, tcol as i64) as void {
    let is i64 as tb_y = wins[i].y + BORDER;
    let is i64 as right = wins[i].x + BORDER + wins[i].w;
    let is i64 as icon = 8;
    let is i64 as iy = tb_y + (TITLE_H - icon) / 2;
    // close button: hover turns the cell red
    let is i64 as cbx = right - BTN_W;
    if (mx >= cbx && mx < right && my >= tb_y && my < tb_y + TITLE_H) {
        cfill(cbx, tb_y, BTN_W, TITLE_H, COL_CLOSE_H);
    }
    draw_x(cbx + (BTN_W - icon) / 2, iy, icon, COL_TEXT);
    // maximize / restore button
    let is i64 as mbx = cbx - BTN_W;
    let is i64 as mxx = mbx + (BTN_W - icon) / 2;
    if (wins[i].maximized == 1) {                    // restore: two stacked squares
        rect_outline(mxx + 2, iy - 1, icon - 2, icon - 2, COL_TEXT);
        cfill(mxx, iy + 1, icon - 2, icon - 2, tcol);
        rect_outline(mxx, iy + 1, icon - 2, icon - 2, COL_TEXT);
    } else {                                          // maximize: one square
        rect_outline(mxx, iy, icon, icon, COL_TEXT);
    }
    return;
}

// Blit the window's content sub-rect (segment → backbuffer), clipped.
fn cblit_content(i as i64) as void {
    let is i64 as cx = wins[i].x + BORDER;           // content origin on screen
    let is i64 as cy = wins[i].y + BORDER + TITLE_H;
    let is i64 as x0 with mut = cx;
    let is i64 as y0 with mut = cy;
    let is i64 as x1 with mut = cx + wins[i].w;
    let is i64 as y1 with mut = cy + wins[i].h;
    if (x0 < clip_x0) { x0 = clip_x0; }
    if (y0 < clip_y0) { y0 = clip_y0; }
    if (x1 > clip_x1) { x1 = clip_x1; }
    if (y1 > clip_y1) { y1 = clip_y1; }
    if (x1 <= x0 || y1 <= y0) { return; }
    let is i64 as nbytes = (x1 - x0) * 4;
    let is i64 as yy with mut = y0;
    while (yy < y1) {
        let is i64 as dst = fb_base + yy * scr_pitch + x0 * 4;
        let is i64 as src = wins[i].seg_base + (yy - cy) * wins[i].seg_stride + (x0 - cx) * 4;
        wmp.copy_row(dst, src, nbytes);
        yy = yy + 1;
    }
    return;
}

// Re-composite one rect: desktop, then every window back-to-front.
fn compose_rect(rx as i64, ry as i64, rw as i64, rh as i64) as void {
    clip_x0 = rx; clip_y0 = ry; clip_x1 = rx + rw; clip_y1 = ry + rh;
    if (clip_x0 < 0) { clip_x0 = 0; }
    if (clip_y0 < 0) { clip_y0 = 0; }
    if (clip_x1 > scr_w) { clip_x1 = scr_w; }
    if (clip_y1 > scr_h) { clip_y1 = scr_h; }
    if (clip_x1 <= clip_x0 || clip_y1 <= clip_y0) { return; }
    cfill(0, 0, scr_w, scr_h, COL_DESKTOP);
    let is i64 as zi with mut = nz - 1;
    while (zi >= 0) {
        let is i64 as i = zord[zi];
        if (wins[i].used == 1 && wins[i].state == 2) {
            let is i64 as focused with mut = 0;
            if (zi == 0) { focused = 1; }
            let is i64 as bcol with mut = COL_BORDER_U;
            let is i64 as tcol with mut = COL_TITLE_U;
            if (focused == 1) { bcol = COL_BORDER_F; tcol = COL_TITLE_F; }
            // frame fill (border color), then titlebar, then content on top
            cfill(wins[i].x, wins[i].y,
                  wins[i].w + 2 * BORDER, wins[i].h + TITLE_H + 2 * BORDER, bcol);
            cfill(wins[i].x + BORDER, wins[i].y + BORDER, wins[i].w, TITLE_H, tcol);
            let is i64 as tx_max = wins[i].x + BORDER + wins[i].w - 2 * BTN_W;  // stop before buttons
            if (wins[i].title_len > 0) {
                let is [16]u8 as tbuf;
                wmp.title_unpack(wins[i].t0, wins[i].t1, wins[i].title_len, cast(*u8, &tbuf[0]));
                let is i64 as k with mut = 0;
                while (k < wins[i].title_len) {
                    let is i64 as gx = wins[i].x + BORDER + 6 + k * 8;
                    if (gx + 8 > tx_max) { break; }
                    cglyph(cast(i64, tbuf[k]), gx, wins[i].y + BORDER + 2, COL_TEXT);
                    k = k + 1;
                }
            }
            draw_win_buttons(i, tcol);
            cblit_content(i);
        }
        zi = zi - 1;
    }
    // the cursor rides on top of everything
    if (mouse_fd >= 0 || tab_fd >= 0) {
        let is i64 as r with mut = 0;
        while (r < CUR_H) {
            let is i64 as yy = my + r;
            if (yy >= clip_y0 && yy < clip_y1) {
                let is i64 as c with mut = 0;
                while (c < CUR_W) {
                    let is i64 as xx = mx + c;
                    if (xx >= clip_x0 && xx < clip_x1) {
                        let is i64 as bit = 1 << c;
                        if ((cur_f[r] & bit) != 0) {
                            let is *u32 as p = cast(*u32, fb_base + yy * scr_pitch + xx * 4);
                            p[0] = cast(u32, 0x00FFFFFF);
                        } else if ((cur_o[r] & bit) != 0) {
                            let is *u32 as p2 = cast(*u32, fb_base + yy * scr_pitch + xx * 4);
                            p2[0] = cast(u32, 0x00101010);
                        }
                    }
                    c = c + 1;
                }
            }
            r = r + 1;
        }
    }
    return;
}

fn flush_damage() as void {
    if (dmg_full == 1) {
        compose_rect(0, 0, scr_w, scr_h);
        sys.present(fb_fd, 0, 0, scr_w, scr_h);
    } else {
        let is i64 as k with mut = 0;
        while (k < dmg_n) {
            compose_rect(dmg[k*4+0], dmg[k*4+1], dmg[k*4+2], dmg[k*4+3]);
            sys.present(fb_fd, dmg[k*4+0], dmg[k*4+1], dmg[k*4+2], dmg[k*4+3]);
            k = k + 1;
        }
    }
    dmg_n = 0;
    dmg_full = 0;
    return;
}

// ============================================================
// z-order / focus
// ============================================================

fn zremove(idx as i64) as void {
    let is i64 as k with mut = 0;
    let is i64 as found with mut = 0 - 1;
    while (k < nz) {
        if (zord[k] == idx) { found = k; }
        k = k + 1;
    }
    if (found < 0) { return; }
    let is i64 as j with mut = found;
    while (j < nz - 1) { zord[j] = zord[j + 1]; j = j + 1; }
    nz = nz - 1;
    return;
}

fn zraise(idx as i64) as void {
    zremove(idx);
    let is i64 as j with mut = nz;
    while (j > 0) { zord[j] = zord[j - 1]; j = j - 1; }
    zord[0] = idx;
    nz = nz + 1;
    return;
}

fn set_focus(idx as i64) as void {
    let is i64 as old with mut = 0 - 1;
    if (nz > 0) { old = zord[0]; }
    if (old == idx) { zraise(idx); return; }
    zraise(idx);
    if (old >= 0) {
        wins[old].pend_focus = 0;
        damage_frame(old);
    }
    wins[idx].pend_focus = 1;
    damage_frame(idx);
    wmp.log_kv(cast(*u8, "wm: focus win="), 14, idx);
    return;
}

fn cycle_focus() as void {
    if (nz >= 2) { set_focus(zord[1]); }
    return;
}

// ============================================================
// Client lifecycle
// ============================================================

fn alloc_win() as i64 {
    let is i64 as i with mut = 0;
    while (i < MAX_WIN) {
        if (wins[i].used == 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn spawn_client() as void {
    let is i64 as i = alloc_win();
    if (i < 0) { return; }
    let is [2]i64 as chans;
    if (sys.channel_create(&chans[0]) != 0) { return; }
    let is i64 as a = chans[0];
    let is i64 as b = chans[1];

    // default geometry: cascade, clamped to the screen
    let is i64 as w with mut = 640;
    let is i64 as h with mut = 400;
    if (w > scr_w - 80) { w = scr_w - 80; }
    if (h > scr_h - 80) { h = scr_h - 80; }
    if (w < MIN_W) { w = MIN_W; }
    if (h < MIN_H) { h = MIN_H; }
    let is i64 as px with mut = 40 + i * 32;
    let is i64 as py with mut = 40 + i * 32;
    if (px + w + 2 > scr_w) { px = 16; }
    if (py + h + TITLE_H + 2 > scr_h) { py = 16; }

    // WELCOME goes out BEFORE the child exists — the buffer is empty, it fits.
    wmp.msg_send(a, wmp.MSG_WELCOME, scr_w, scr_h, wmp.pack_wh(w, h));

    let is [2]i64 as acts;
    acts[0] = wmp.WM_FD;     // child fd 3 ← side B
    acts[1] = b;
    let is i64 as pid = sys.spawn(cast(*u8, img_base), img_len,
                                  cast(*u8, &acts[0]), 1, cast(*u8, 0), 0);
    sys.close(b);
    if (pid < 0) {
        sys.close(a);
        wmp.log_kv(cast(*u8, "wm: spawn FAIL rc="), 18, pid);
        return;
    }

    wins[i].used = 1;
    wins[i].state = 1;
    wins[i].chan = a;
    wins[i].pid = pid;
    wins[i].seg_fd = 0;
    wins[i].seg_base = 0;
    wins[i].seg_pages = 0;
    wins[i].seg_stride = 0;
    wins[i].x = px; wins[i].y = py; wins[i].w = w; wins[i].h = h;
    wins[i].title_len = 0; wins[i].t0 = 0; wins[i].t1 = 0;
    wins[i].drops = 0;
    wins[i].pend_resize_w = 0; wins[i].pend_resize_h = 0;
    wins[i].pend_focus = 0 - 1;
    wins[i].pend_close = 0;
    wins[i].hello_deadline = sys.time_ns() + HELLO_NS;
    wins[i].mb_fill = 0;
    wins[i].maximized = 0;
    set_focus(i);
    wmp.log_kv(cast(*u8, "wm: spawn pid="), 14, pid);
    return;
}

// Tear a window down. `do_wait` = the client exited (or will momentarily,
// after our channel close lands as its EOF) — reap the zombie. Stuck
// clients are KILLED for real (SYS_PROC_KILL: the spawn key is the kill
// authority, and the WM is every client's parent), then reaped.
fn reap_window(i as i64, do_wait as i64) as void {
    if (wins[i].state == 2) {
        sys.munmap(wins[i].seg_base, wins[i].seg_pages * 4096);
        sys.close(wins[i].seg_fd);
    }
    sys.close(wins[i].chan);
    let is i64 as was_top with mut = 0;
    if (nz > 0 && zord[0] == i) { was_top = 1; }
    zremove(i);
    damage_frame(i);
    wins[i].used = 0;
    wins[i].state = 0;
    if (do_wait == 1) {
        let is i64 as st with mut = 0;
        sys.wait(wins[i].pid, &st);
        wmp.log_kv(cast(*u8, "wm: reap pid="), 13, wins[i].pid);
    } else {
        let is i64 as krc = sys.kill(wins[i].pid);
        if (krc == 0) {
            let is i64 as st2 with mut = 0;
            sys.wait(wins[i].pid, &st2);
            wmp.log_kv(cast(*u8, "wm: killed stuck pid="), 21, wins[i].pid);
        } else {
            wmp.log_kv(cast(*u8, "wm: kill FAIL pid="), 18, wins[i].pid);
        }
    }
    if (was_top == 1 && nz > 0) {
        wins[zord[0]].pend_focus = 1;
        damage_frame(zord[0]);
        wmp.log_kv(cast(*u8, "wm: focus win="), 14, zord[0]);
    }
    return;
}

// ============================================================
// Per-window message service
// ============================================================

fn handle_msg(i as i64, m as *i64) as void {
    if (m[0] == wmp.MSG_HELLO && wins[i].state == 1) {
        let is i64 as seg = sys.fd_recv(wins[i].chan);
        if (seg < 0) {
            // protocol break: HELLO with no parked fd
            reap_window(i, 0);
            return;
        }
        let is i64 as va = sys.mmap_fd(sys.PROT_READ, seg);
        if (va < 0) {
            sys.close(seg);
            reap_window(i, 0);
            return;
        }
        wins[i].seg_fd = seg;
        wins[i].seg_base = va;
        wins[i].seg_pages = m[1];
        wins[i].seg_stride = m[2];
        wins[i].state = 2;
        damage_frame(i);
        wmp.log_kv(cast(*u8, "wm: hello win="), 14, i);
    } else if (m[0] == wmp.MSG_COMMIT) {
        if (wins[i].state != 2) { return; }
        let is i64 as cx with mut = m[1];
        let is i64 as cy with mut = m[2];
        let is i64 as cw with mut = wmp.unpack_w(m[3]);
        let is i64 as ch with mut = wmp.unpack_h(m[3]);
        if (cx < 0) { cw = cw + cx; cx = 0; }
        if (cy < 0) { ch = ch + cy; cy = 0; }
        if (cx + cw > wins[i].w) { cw = wins[i].w - cx; }
        if (cy + ch > wins[i].h) { ch = wins[i].h - cy; }
        if (cw > 0 && ch > 0) {
            damage(wins[i].x + BORDER + cx, wins[i].y + BORDER + TITLE_H + cy, cw, ch);
        }
    } else if (m[0] == wmp.MSG_SET_TITLE) {
        wins[i].title_len = m[1];
        if (wins[i].title_len > 16) { wins[i].title_len = 16; }
        wins[i].t0 = m[2];
        wins[i].t1 = m[3];
        damage(wins[i].x, wins[i].y, wins[i].w + 2 * BORDER, TITLE_H + BORDER);
    } else if (m[0] == wmp.MSG_CLOSE) {
        reap_window(i, 1);
    } else if (m[0] == wmp.MSG_SPAWN_REQ) {
        spawn_client();                              // bounded by MAX_WIN
    }
    return;
}

// Drain everything readable on window i's channel. `got` is this sweep's
// poll result; after draining, a CLOSED peer (client died — its exit drained
// its fd table) is reaped.
fn service_win(i as i64, got as i64) as void {
    let is i64 as g with mut = got;
    let is [4]i64 as m;
    let is i64 as guard with mut = 0;
    while ((g & sys.POLL_READABLE) != 0) {
        let is i64 as r = wmp.msg_read(wins[i].chan, &wins[i].mb_fill,
                                       cast(*u8, cast(i64, &mbufs[0]) + i * 32), &m[0]);
        if (r < 0) { reap_window(i, 1); return; }
        if (r == 1) {
            handle_msg(i, &m[0]);
            if (wins[i].used == 0) { return; }       // handle_msg reaped it
        }
        guard = guard + 1;
        if (guard > 64) { break; }                   // fairness: bound one window's burst
        let is [3]i64 as pe;
        pe[0] = wins[i].chan;
        pe[1] = sys.POLL_READABLE;
        pe[2] = 0;
        sys.poll(&pe[0], 1, 0);                      // non-blocking re-check
        g = pe[2];
    }
    if ((got & sys.POLL_CLOSED) != 0 || (got & sys.POLL_ERROR) != 0) {
        reap_window(i, 1);
    }
    return;
}

// Send at most (2 - quota) queued control messages to window i. Slots, not
// queues: the latest RESIZE/FOCUS wins; CLOSE_REQ goes first.
fn drain_pending(i as i64) as void {
    if (wins[i].state != 2) { return; }
    if (writable[i] == 0) { return; }
    if (wins[i].pend_close == 1 && quota[i] < 2) {
        wmp.msg_send(wins[i].chan, wmp.MSG_CLOSE_REQ, 0, 0, 0);
        wins[i].pend_close = 0;
        quota[i] = quota[i] + 1;
    }
    if (wins[i].pend_resize_w > 0 && quota[i] < 2) {
        wmp.msg_send(wins[i].chan, wmp.MSG_RESIZE, wins[i].pend_resize_w, wins[i].pend_resize_h, 0);
        wins[i].pend_resize_w = 0;
        wins[i].pend_resize_h = 0;
        quota[i] = quota[i] + 1;
    }
    if (wins[i].pend_focus >= 0 && quota[i] < 2) {
        wmp.msg_send(wins[i].chan, wmp.MSG_FOCUS, wins[i].pend_focus, 0, 0);
        wins[i].pend_focus = 0 - 1;
        quota[i] = quota[i] + 1;
    }
    return;
}

// ============================================================
// Input
// ============================================================

// Point check: can window i's channel take one whole message right now?
// Input events are reactive and rare (human-rate), so a one-entry
// non-blocking poll at forward time replaces standing WRITABLE interest in
// the main poll set — which would otherwise make the idle loop spin.
fn chan_writable_now(i as i64) as i64 {
    let is [3]i64 as ce;
    ce[0] = wins[i].chan;
    ce[1] = sys.POLL_WRITABLE;
    ce[2] = 0;
    sys.poll(&ce[0], 1, 0);
    if ((ce[2] & sys.POLL_WRITABLE) != 0) { return 1; }
    return 0;
}

fn forward_key(sc as i64, flags as i64) as void {
    if (nz == 0) { return; }
    let is i64 as i = zord[0];
    if (wins[i].state != 2) { return; }
    if (quota[i] < 2 && chan_writable_now(i) == 1) {
        wmp.msg_send(wins[i].chan, wmp.MSG_KEY, sc, flags, 0);
        quota[i] = quota[i] + 1;
    } else {
        wins[i].drops = wins[i].drops + 1;
        if (wins[i].drops > MAX_DROPS) { reap_window(i, 0); }
    }
    return;
}

fn handle_key(sc as i64, flags as i64) as void {
    let is i64 as pressed = flags & 1;
    let is i64 as ext = (flags >> 1) & 1;
    // modifier tracking (left alt 0x38, right alt E0 0x38; super E0 0x5B)
    if (sc == 0x38) { mod_alt = pressed; }
    if (ext == 1 && sc == 0x5B) { mod_super = pressed; }
    if (pressed == 1) {
        if (mod_alt == 1 && ext == 0 && sc == 0x0F) { cycle_focus(); return; }   // Alt+Tab
        if (mod_super == 1 && sc == 0x1C) { spawn_client(); return; }            // Super+Enter
        if (mod_super == 1 && sc == 0x10) {                                      // Super+Q
            if (nz > 0) { wins[zord[0]].pend_close = 1; }
            return;
        }
    }
    forward_key(sc, flags);
    return;
}

fn drain_kbd() as void {
    let is [64]u8 as evs;
    let is i64 as n = syscall(10, kbd_fd, cast(i64, &evs[0]), 64);
    if (n < 2) { return; }
    let is i64 as k with mut = 0;
    while (k + 1 < n) {
        handle_key(cast(i64, evs[k]), cast(i64, evs[k + 1]));
        k = k + 2;
    }
    return;
}

// ---- maximize / snap / restore ----
fn set_geometry(i as i64, nx as i64, ny as i64, nw as i64, nh as i64) as void {
    damage_frame(i);
    wins[i].x = nx; wins[i].y = ny; wins[i].w = nw; wins[i].h = nh;
    damage_frame(i);
    wins[i].pend_resize_w = nw; wins[i].pend_resize_h = nh;
    return;
}
fn save_geometry(i as i64) as void {
    wins[i].sav_x = wins[i].x; wins[i].sav_y = wins[i].y;
    wins[i].sav_w = wins[i].w; wins[i].sav_h = wins[i].h;
    return;
}
fn maximize_win(i as i64) as void {
    if (wins[i].maximized == 0) { save_geometry(i); }
    set_geometry(i, 0, 0, scr_w - 2 * BORDER, scr_h - TITLE_H - 2 * BORDER);
    wins[i].maximized = 1;
    return;
}
fn snap_win(i as i64, rightside as i64) as void {
    if (wins[i].maximized == 0) { save_geometry(i); }
    let is i64 as halfw = scr_w / 2;
    let is i64 as nx with mut = 0;
    if (rightside == 1) { nx = halfw; }
    set_geometry(i, nx, 0, halfw - 2 * BORDER, scr_h - TITLE_H - 2 * BORDER);
    wins[i].maximized = 1;
    return;
}
fn restore_win(i as i64) as void {
    set_geometry(i, wins[i].sav_x, wins[i].sav_y, wins[i].sav_w, wins[i].sav_h);
    wins[i].maximized = 0;
    return;
}
fn toggle_maximize(i as i64) as void {
    if (wins[i].maximized == 1) { restore_win(i); } else { maximize_win(i); }
    return;
}
// Which titlebar control button is under the cursor: 0 none, 1 close, 2 max.
fn titlebar_button_at(i as i64) as i64 {
    let is i64 as tb_y0 = wins[i].y + BORDER;
    if (my < tb_y0 || my >= tb_y0 + TITLE_H) { return 0; }
    let is i64 as right = wins[i].x + BORDER + wins[i].w;
    if (mx >= right - BTN_W && mx < right) { return 1; }
    if (mx >= right - 2 * BTN_W && mx < right - BTN_W) { return 2; }
    return 0;
}

fn start_move(i as i64) as void {
    if (wins[i].maximized == 1) {
        // un-snap: shrink to the saved size, recentre under the cursor, then drag
        let is i64 as nw = wins[i].sav_w;
        let is i64 as nh = wins[i].sav_h;
        let is i64 as nx with mut = mx - nw / 2;
        let is i64 as ny with mut = my - TITLE_H / 2;
        if (nx < 0) { nx = 0; }
        if (ny < 0) { ny = 0; }
        if (nx + nw + 2 * BORDER > scr_w) { nx = scr_w - nw - 2 * BORDER; }
        set_geometry(i, nx, ny, nw, nh);
        wins[i].maximized = 0;
    }
    drag_mode = 1;
    drag_win = i;
    drag_ax = mx; drag_ay = my;
    drag_ox = wins[i].x; drag_oy = wins[i].y;
    drag_ow = wins[i].w; drag_oh = wins[i].h;
    return;
}

fn start_resize(i as i64, dirs as i64) as void {
    drag_mode = 2;
    drag_win = i;
    drag_dirs = dirs;
    drag_ax = mx; drag_ay = my;
    drag_ox = wins[i].x; drag_oy = wins[i].y;
    drag_ow = wins[i].w; drag_oh = wins[i].h;
    return;
}

// Send a button/wheel event to window i with content-relative coordinates,
// under the same writable+quota gate as keys.
fn forward_mouse(i as i64, mtype as i64, a as i64) as void {
    if (wins[i].state != 2) { return; }
    let is i64 as rx = mx - (wins[i].x + BORDER);
    let is i64 as ry = my - (wins[i].y + BORDER + TITLE_H);
    if (rx < 0 || ry < 0 || rx >= wins[i].w || ry >= wins[i].h) { return; }
    if (quota[i] < 2 && chan_writable_now(i) == 1) {
        wmp.msg_send(wins[i].chan, mtype, a, rx, ry);
        quota[i] = quota[i] + 1;
    } else {
        wins[i].drops = wins[i].drops + 1;
        if (wins[i].drops > MAX_DROPS) { reap_window(i, 0); }
    }
    return;
}

// Left press: hit-test top→bottom. Resize band beats titlebar beats content;
// Super+press moves from anywhere in the frame. Every hit focuses + raises.
fn press_at() as void {
    let is i64 as zi with mut = 0;
    while (zi < nz) {
        let is i64 as i = zord[zi];
        if (wins[i].used == 1 && wins[i].state == 2) {
            let is i64 as fx = wins[i].x;
            let is i64 as fy = wins[i].y;
            let is i64 as fw = wins[i].w + 2 * BORDER;
            let is i64 as fh = wins[i].h + TITLE_H + 2 * BORDER;
            if (mx >= fx && mx < fx + fw && my >= fy && my < fy + fh) {
                set_focus(i);
                if (mod_super == 1) { start_move(i); return; }
                // titlebar control buttons beat the resize band and the move grab
                let is i64 as btn = titlebar_button_at(i);
                if (btn == 1) { wins[i].pend_close = 1; return; }
                if (btn == 2) { toggle_maximize(i); return; }
                let is i64 as dirs with mut = 0;
                if (mx < fx + EDGE) { dirs = dirs | DIR_W; }
                if (mx >= fx + fw - EDGE) { dirs = dirs | DIR_E; }
                if (my < fy + EDGE) { dirs = dirs | DIR_N; }
                if (my >= fy + fh - EDGE) { dirs = dirs | DIR_S; }
                if (dirs != 0) { start_resize(i, dirs); return; }
                if (my < fy + BORDER + TITLE_H) {
                    let is i64 as now = sys.time_ns();              // double-click = maximize
                    if (last_click_win == i && now - last_click_ns < DCLICK_NS) {
                        last_click_ns = 0; last_click_win = 0 - 1;
                        toggle_maximize(i); return;
                    }
                    last_click_ns = now; last_click_win = i;
                    start_move(i); return;
                }
                forward_mouse(i, wmp.MSG_MOUSE_BTN, mbuttons);
                return;
            }
        }
        zi = zi + 1;
    }
    return;                                          // desktop: nothing
}

fn handle_buttons(oldb as i64, newb as i64) as void {
    let is i64 as lp_old = oldb & 1;
    let is i64 as lp_new = newb & 1;
    mbuttons = newb;
    if (lp_old == 0 && lp_new == 1) { press_at(); return; }
    if (lp_old == 1 && lp_new == 0) {
        if (drag_mode == 1) {                            // drag-to-edge snap on release
            if (my <= SNAP_PX) { maximize_win(drag_win); }
            else if (mx <= SNAP_PX) { snap_win(drag_win, 0); }
            else if (mx >= scr_w - SNAP_PX) { snap_win(drag_win, 1); }
            drag_mode = 0; return;
        }
        if (drag_mode != 0) { drag_mode = 0; return; }
        if (nz > 0) { forward_mouse(zord[0], wmp.MSG_MOUSE_BTN, newb); }
        return;
    }
    // right/middle edges go to the focused window when inside its content
    if (nz > 0) { forward_mouse(zord[0], wmp.MSG_MOUSE_BTN, newb); }
    return;
}

// Apply accumulated motion once per sweep: drag geometry + cursor damage.
fn apply_motion() as void {
    if (drag_mode == 1) {
        let is i64 as i = drag_win;
        let is i64 as fw = wins[i].w + 2 * BORDER;
        let is i64 as fh = wins[i].h + TITLE_H + 2 * BORDER;
        let is i64 as nx2 with mut = drag_ox + (mx - drag_ax);
        let is i64 as ny2 with mut = drag_oy + (my - drag_ay);
        if (nx2 < 0) { nx2 = 0; }
        if (ny2 < 0) { ny2 = 0; }
        if (nx2 + fw > scr_w) { nx2 = scr_w - fw; }
        if (ny2 + fh > scr_h) { ny2 = scr_h - fh; }
        if (nx2 != wins[i].x || ny2 != wins[i].y) {
            damage_frame(i);
            wins[i].x = nx2;
            wins[i].y = ny2;
            damage_frame(i);
        }
    } else if (drag_mode == 2) {
        let is i64 as i = drag_win;
        let is i64 as nw with mut = drag_ow;
        let is i64 as nh with mut = drag_oh;
        let is i64 as nx with mut = drag_ox;
        let is i64 as ny with mut = drag_oy;
        if ((drag_dirs & DIR_E) != 0) { nw = drag_ow + (mx - drag_ax); }
        if ((drag_dirs & DIR_S) != 0) { nh = drag_oh + (my - drag_ay); }
        if ((drag_dirs & DIR_W) != 0) { nw = drag_ow - (mx - drag_ax); }
        if ((drag_dirs & DIR_N) != 0) { nh = drag_oh - (my - drag_ay); }
        if (nw < MIN_W) { nw = MIN_W; }
        if (nh < MIN_H) { nh = MIN_H; }
        if (nw > scr_w - 2 * BORDER) { nw = scr_w - 2 * BORDER; }
        if (nh > scr_h - TITLE_H - 2 * BORDER) { nh = scr_h - TITLE_H - 2 * BORDER; }
        if ((drag_dirs & DIR_W) != 0) { nx = drag_ox + (drag_ow - nw); }
        if ((drag_dirs & DIR_N) != 0) { ny = drag_oy + (drag_oh - nh); }
        if (nx < 0) { nw = nw + nx; nx = 0; }
        if (ny < 0) { nh = nh + ny; ny = 0; }
        if (nx + nw + 2 * BORDER > scr_w) { nw = scr_w - 2 * BORDER - nx; }
        if (ny + nh + TITLE_H + 2 * BORDER > scr_h) { nh = scr_h - TITLE_H - 2 * BORDER - ny; }
        if (nw != wins[i].w || nh != wins[i].h || nx != wins[i].x || ny != wins[i].y) {
            damage_frame(i);
            wins[i].x = nx; wins[i].y = ny;
            wins[i].w = nw; wins[i].h = nh;
            damage_frame(i);
            wins[i].pend_resize_w = nw;              // slot: the latest wins
            wins[i].pend_resize_h = nh;
        }
    }
    if (mx != cur_last_x || my != cur_last_y) {
        damage(cur_last_x, cur_last_y, CUR_W, CUR_H);
        damage(mx, my, CUR_W, CUR_H);
        // keep the focused window's button strip re-composed so close-hover tracks
        if (nz > 0) {
            let is i64 as f = zord[0];
            let is i64 as tby = wins[f].y + BORDER;
            if (my >= tby - CUR_H && my < tby + TITLE_H) {
                damage(wins[f].x + BORDER + wins[f].w - 2 * BTN_W, tby, 2 * BTN_W, TITLE_H);
            }
        }
        cur_last_x = mx;
        cur_last_y = my;
    }
    return;
}

fn drain_mouse() as void {
    let is [64]u8 as recs;
    let is i64 as n = syscall(10, mouse_fd, cast(i64, &recs[0]), 64);
    if (n < 4) { return; }
    let is i64 as k with mut = 0;
    while (k + 3 < n) {
        let is i64 as dx with mut = cast(i64, recs[k]);
        if (dx >= 128) { dx = dx - 256; }
        let is i64 as dy with mut = cast(i64, recs[k + 1]);
        if (dy >= 128) { dy = dy - 256; }
        mx = mx + dx;
        my = my - dy;                                 // PS/2 dy is positive-up
        if (mx < 0) { mx = 0; }
        if (my < 0) { my = 0; }
        if (mx >= scr_w) { mx = scr_w - 1; }
        if (my >= scr_h) { my = scr_h - 1; }
        let is i64 as nb = cast(i64, recs[k + 2]);
        if (nb != mbuttons) { handle_buttons(mbuttons, nb); }
        let is i64 as wh with mut = cast(i64, recs[k + 3]);
        if (wh >= 128) { wh = wh - 256; }
        if (wh != 0 && nz > 0) { forward_mouse(zord[0], wmp.MSG_MOUSE_WHEEL, wh); }
        k = k + 4;
    }
    apply_motion();
    return;
}

// Tablet records carry ABSOLUTE 0..32767 positions — the cursor lands
// exactly where the host pointer is over the VM window, no grab anywhere.
fn drain_tablet() as void {
    let is [64]u8 as recs;
    let is i64 as n = syscall(10, tab_fd, cast(i64, &recs[0]), 64);
    if (n < 8) { return; }
    let is i64 as k with mut = 0;
    while (k + 7 < n) {
        let is i64 as ax = cast(i64, recs[k]) | (cast(i64, recs[k + 1]) << 8);
        let is i64 as ay = cast(i64, recs[k + 2]) | (cast(i64, recs[k + 3]) << 8);
        mx = ax * scr_w / 32768;
        my = ay * scr_h / 32768;
        if (mx >= scr_w) { mx = scr_w - 1; }
        if (my >= scr_h) { my = scr_h - 1; }
        let is i64 as nb = cast(i64, recs[k + 4]);
        if (nb != mbuttons) { handle_buttons(mbuttons, nb); }
        let is i64 as wh with mut = cast(i64, recs[k + 5]);
        if (wh >= 128) { wh = wh - 256; }
        if (wh != 0 && nz > 0) { forward_mouse(zord[0], wmp.MSG_MOUSE_WHEEL, wh); }
        k = k + 8;
    }
    apply_motion();
    return;
}

// ============================================================
// Boot
// ============================================================

fn load_image(path as *u8, plen as i64) as i64 {
    let is i64 as fd = syscall(9, cast(i64, path), plen, 0);
    if (fd < 0) { return fd; }
    let is i64 as cap = 1048576;
    let is i64 as buf = sys.mmap(0, cap, sys.PROT_READ | sys.PROT_WRITE);
    if (buf < 0) { sys.close(fd); return buf; }
    let is i64 as total with mut = 0;
    let is i64 as more with mut = 1;
    while (more == 1) {
        let is i64 as r = syscall(10, fd, buf + total, cap - total);
        if (r <= 0) { more = 0; }
        else {
            total = total + r;
            if (total >= cap) { more = 0; }
        }
    }
    sys.close(fd);
    if (total <= 0) { return 0 - 1; }
    img_base = buf;
    img_len = total;
    return 0;
}

fn main() as i32 {
    let is gfx.Framebuffer as fb = gfx.open();
    if (fb.ok == 0) {
        sys.write_serial(cast(*u8, "wm: no framebuffer\n"), 19);
        return 1;
    }
    font.init();
    scr_w = fb.width;
    scr_h = fb.height;
    scr_pitch = fb.pitch;
    fb_base = cast(i64, fb.base);
    fb_fd = fb.fd;

    kbd_fd = sys.dev_open(sys.DEV_KEYBOARD, 0, 0);
    mouse_fd = sys.dev_open(sys.DEV_MOUSE, 0, 0);
    tab_fd = sys.dev_open(sys.DEV_TABLET, 0, 0);
    if (kbd_fd < 0) { sys.write_serial(cast(*u8, "wm: no keyboard\n"), 16); }
    if (mouse_fd < 0) { sys.write_serial(cast(*u8, "wm: no mouse\n"), 13); }
    if (tab_fd >= 0) { sys.write_serial(cast(*u8, "wm: tablet (absolute, no grab)\n"), 31); }

    wmp.log_kv(cast(*u8, "wm: ready w="), 12, scr_w);
    wmp.log_kv(cast(*u8, "wm: ready h="), 12, scr_h);

    // The default client: the windowed terminal; the checkerboard stays as
    // the fallback proving-client when no terminal is on the disk.
    if (load_image(cast(*u8, "/wterm.cse"), 10) != 0) {
        if (load_image(cast(*u8, "/wmpat.cse"), 10) != 0) {
            sys.write_serial(cast(*u8, "wm: no client image\n"), 20);
            return 1;
        }
    }

    let is i64 as zi with mut = 0;
    while (zi < MAX_WIN) { wins[zi].used = 0; wins[zi].state = 0; zi = zi + 1; }
    cursor_init();
    mx = scr_w / 2;
    my = scr_h / 2;
    cur_last_x = mx;
    cur_last_y = my;

    damage_all();
    flush_damage();
    spawn_client();

    let is [33]i64 as pe;                            // up to 11 poll entries × 3
    let is [11]i64 as pmap;                          // entry → window (-1 = device)
    let is i64 as next_frame with mut = sys.time_ns() + FRAME_NS;

    while (1 == 1) {
        // -- build the poll set --
        let is i64 as n with mut = 0;
        let is i64 as kbd_e with mut = 0 - 1;
        let is i64 as mouse_e with mut = 0 - 1;
        let is i64 as tab_e with mut = 0 - 1;
        if (kbd_fd >= 0) {
            pe[n*3+0] = kbd_fd; pe[n*3+1] = sys.POLL_READABLE; pe[n*3+2] = 0;
            pmap[n] = 0 - 1; kbd_e = n; n = n + 1;
        }
        if (mouse_fd >= 0) {
            pe[n*3+0] = mouse_fd; pe[n*3+1] = sys.POLL_READABLE; pe[n*3+2] = 0;
            pmap[n] = 0 - 1; mouse_e = n; n = n + 1;
        }
        if (tab_fd >= 0) {
            pe[n*3+0] = tab_fd; pe[n*3+1] = sys.POLL_READABLE; pe[n*3+2] = 0;
            pmap[n] = 0 - 1; tab_e = n; n = n + 1;
        }
        // READABLE always; WRITABLE only while a control message is queued
        // for that window. An empty channel is permanently writable, so
        // asking for WRITABLE unconditionally turns the poll into a busy
        // spin that starves every client of CPU — the idle WM must SLEEP.
        let is i64 as wi with mut = 0;
        while (wi < MAX_WIN) {
            if (wins[wi].used == 1) {
                let is i64 as want with mut = sys.POLL_READABLE;
                if (wins[wi].pend_close == 1 || wins[wi].pend_resize_w > 0
                    || wins[wi].pend_focus >= 0) {
                    want = want | sys.POLL_WRITABLE;
                }
                pe[n*3+0] = wins[wi].chan;
                pe[n*3+1] = want;
                pe[n*3+2] = 0;
                pmap[n] = wi;
                n = n + 1;
            }
            wi = wi + 1;
        }

        let is i64 as now with mut = sys.time_ns();
        let is i64 as tmo with mut = next_frame - now;
        if (tmo < 0) { tmo = 0; }
        sys.poll(&pe[0], n, tmo);

        // -- per-window snapshots first (forwarding gates on them) --
        let is i64 as e with mut = 0;
        while (e < n) {
            let is i64 as w2 = pmap[e];
            if (w2 >= 0) {
                quota[w2] = 0;
                writable[w2] = 0;
                if ((pe[e*3+2] & sys.POLL_WRITABLE) != 0) { writable[w2] = 1; }
            }
            e = e + 1;
        }

        // -- inputs --
        if (kbd_e >= 0 && (pe[kbd_e*3+2] & sys.POLL_READABLE) != 0) { drain_kbd(); }
        if (mouse_e >= 0 && (pe[mouse_e*3+2] & sys.POLL_READABLE) != 0) { drain_mouse(); }
        if (tab_e >= 0 && (pe[tab_e*3+2] & sys.POLL_READABLE) != 0) { drain_tablet(); }

        // -- client channels --
        e = 0;
        while (e < n) {
            let is i64 as w3 = pmap[e];
            if (w3 >= 0 && wins[w3].used == 1) {
                let is i64 as got = pe[e*3+2];
                if ((got & (sys.POLL_READABLE | sys.POLL_CLOSED | sys.POLL_ERROR)) != 0) {
                    service_win(w3, got);
                }
            }
            e = e + 1;
        }

        // -- queued control messages --
        let is i64 as wp with mut = 0;
        while (wp < MAX_WIN) {
            if (wins[wp].used == 1) { drain_pending(wp); }
            wp = wp + 1;
        }

        // -- frame tick --
        now = sys.time_ns();
        if (now >= next_frame) {
            // handshake deadlines
            let is i64 as wd with mut = 0;
            while (wd < MAX_WIN) {
                if (wins[wd].used == 1 && wins[wd].state == 1 && now > wins[wd].hello_deadline) {
                    reap_window(wd, 0);
                }
                wd = wd + 1;
            }
            if (dmg_full == 1 || dmg_n > 0) { flush_damage(); }
            next_frame = now + FRAME_NS;
        }
    }
    return 0;
}
