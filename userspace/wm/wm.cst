// wm.cst — the CausticOS window manager (POLICY half of the compositor split).
//
// The WM owns policy: focus, geometry, z-order, the taskbar's contents, the
// client lifecycle, and routing input to the focused client. It does NOT touch
// the framebuffer or the input devices anymore — the COMPOSITOR (compositor.cse,
// our parent, the /init) owns the hardware. The two talk over two channels
// (userspace/lib/compo_proto.cst):
//
//   compositor → WM (CMD, fd 4): normalised input — MSG_CP_KEY/PTR/WHEEL,
//     MSG_CP_SCR_READY (geometry, once, before any input), MSG_CP_SHUTDOWN_REQ.
//   WM → compositor (WC, fd 5): the scene — MSG_WC_SCENE + N×SCENE_ENTRY (a
//     back-to-front snapshot of the windows), MSG_WC_DAMAGE rects, MSG_WC_CURSOR
//     (the contextual shape; the compositor owns the cursor's pixels/position).
//
// The WM still SPAWNS its clients directly (it keeps kill authority) and keeps
// the per-client wmproto.cst channel; clients are unchanged. Only the WM↔screen
// boundary moved up to the compositor.
//
// Hotkeys (consumed, never forwarded): Alt+Tab cycle focus, Super+Enter spawn a
// terminal, Super+Q ask the focused window to close.

use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/wmproto.cst" as wmp;
use "../lib/compo_proto.cst" as cp;

// ---- layout & palette ----
let is i64 as MAX_WIN  with imut = 8;
let is i64 as TITLE_H  with imut = 20;
let is i64 as BORDER   with imut = 1;
let is i64 as FRAME_NS with imut = 16666667;   // ~60 Hz scene tick
let is i64 as MIN_W    with imut = 160;
let is i64 as MIN_H    with imut = 64;
let is i64 as HELLO_NS with imut = 5000000000; // 5s for a client to handshake
let is i64 as MAX_DROPS with imut = 256;       // stuck-client disconnect bar
let is i64 as BTN_W     with imut = 24;        // titlebar control button width
let is i64 as SNAP_PX   with imut = 12;        // drag-to-edge snap trigger band
let is i64 as DCLICK_NS with imut = 400000000; // titlebar double-click window (400ms)
let is i64 as BAR_H     with imut = 26;         // taskbar height (bottom)
let is i64 as TASK_W    with imut = 150;        // per-window button width

// ---- palette (the WM writes these into the decoration cell grids) ----
let is i64 as COL_BORDER_F with imut = 0x0073d0ff;  // focused border
let is i64 as COL_BORDER_U with imut = 0x003a4048;  // unfocused border
let is i64 as COL_TITLE_F  with imut = 0x002a3a4a;  // focused titlebar
let is i64 as COL_TITLE_U  with imut = 0x001c2228;  // unfocused titlebar
let is i64 as COL_TEXT     with imut = 0x00d3d7cf;
let is i64 as COL_CLOSE_H  with imut = 0x00c84040;  // close-button hover red
let is i64 as COL_BAR      with imut = 0x00161b21;  // taskbar background
let is i64 as COL_BAR_ITEM with imut = 0x00262f38;  // window button (inactive)
let is i64 as COL_BAR_DIM  with imut = 0x008a909a;  // minimized window text

// ---- the global taskbar decoration (a cell grid covering the bottom bar) ----
let is i64 as tb_dec_fd with mut = 0;
let is i64 as tb_dec_base with mut = 0;
let is i64 as tb_dec_pages with mut = 0;
let is i64 as tb_cols with mut = 0;
let is i64 as tb_attached with mut = 0;
let is i64 as tb_dirty with mut = 1;                 // re-render the taskbar this tick

// ---- clock (HH:MM:SS) on the right of the taskbar; the WM owns it again ----
let is [12]u8 as clock_str with mut;
let is i64 as clock_len with mut = 0;
let is i64 as clock_next with mut = 0;

// ---- the window table ----
// state: 0 = free, 1 = spawned/awaiting HELLO, 2 = live (segment mapped).
struct Win {
    used as i64;  state as i64;
    chan as i64;  pid as i64;
    seg_fd as i64;  seg_base as i64;  seg_pages as i64;  seg_stride as i64;
    x as i64;  y as i64;  w as i64;  h as i64;       // x,y = FRAME corner; w,h = content
    title_len as i64;  t0 as i64;  t1 as i64;
    drops as i64;
    pend_resize_w as i64;  pend_resize_h as i64;     // 0 = none (slot: last wins)
    pend_focus as i64;                               // -1 = none, else 0|1
    pend_close as i64;
    hello_deadline as i64;
    mb_fill as i64;                                  // partial-message fill (buf in mbufs)
    maximized as i64;                                // 0 = floating, 1 = maximized/snapped
    sav_x as i64;  sav_y as i64;  sav_w as i64;  sav_h as i64;   // geometry to restore
    minimized as i64;                                // 1 = hidden, lives only on the taskbar
    is_text as i64;                                  // 1 = TEXT surface (cell grid); 0 = PIXEL
    dec_fd as i64;  dec_base as i64;  dec_pages as i64;  // per-window titlebar decoration
    dec_attached as i64;                             // 1 = compositor mapped this dec seg
}
let is [8]Win as wins with mut;
let is [256]u8 as mbufs with mut;                    // 8 × 32B message accumulators
let is [8]i64 as zord with mut;                      // zord[0] = top of the stack
let is i64 as nz with mut = 0;
// shutdown: 0 = normal, 1 = asked clients to close (waiting), then power off.
let is i64 as shutdown_state with mut = 0;
let is i64 as shutdown_deadline with mut = 0;

// per-sweep snapshots (filled from each poll's got bits)
let is [8]i64 as writable with mut;
let is [8]i64 as quota with mut;                     // msgs sent this sweep (cap 2)

// ---- screen geometry (from the compositor's MSG_CP_SCR_READY) ----
let is i64 as scr_w with mut = 0;
let is i64 as scr_h with mut = 0;
let is i64 as work_h with mut = 0;                   // usable height = scr_h - BAR_H
let is i64 as have_geom with mut = 0;                // 1 once SCR_READY arrived

// ---- input (from the compositor's CMD channel) ----
let is i64 as cmd_fd with mut = 0;
let is i64 as cmd_fill with mut = 0;
let is [32]u8 as cmd_acc with mut;
let is i64 as mod_alt with mut = 0;
let is i64 as mod_super with mut = 0;
let is i64 as mx with mut = 0;
let is i64 as my with mut = 0;
let is i64 as mbuttons with mut = 0;

// ---- the scene channel (WM → compositor) ----
let is i64 as wc_fd with mut = 0;
let is i64 as scene_dirty with mut = 1;              // re-send the scene this tick
let is i64 as deco_dirty with mut = 1;               // re-render+resend decorations this tick
let is i64 as close_hover_win with mut = 0 - 1;      // window whose close button is hovered

// ---- cursor contextual shape (policy; the compositor draws it) ----
let is i64 as CUR_ARROW with imut = 0;
let is i64 as CUR_EW    with imut = 1;
let is i64 as CUR_NS    with imut = 2;
let is i64 as CUR_NWSE  with imut = 3;
let is i64 as CUR_NESW  with imut = 4;
let is i64 as CUR_IBEAM with imut = 5;
let is i64 as CUR_MOVE  with imut = 6;
let is i64 as cur_shape with mut = 0;
let is i64 as cur_last_shape with mut = 0;

// ---- drag state machine ----
let is i64 as DIR_N with imut = 1;
let is i64 as DIR_S with imut = 2;
let is i64 as DIR_W with imut = 4;
let is i64 as DIR_E with imut = 8;
let is i64 as EDGE  with imut = 6;     // resize band, px from the frame edge

let is i64 as drag_mode with mut = 0;  // 0 none, 1 move, 2 resize
let is i64 as drag_win with mut = 0;
let is i64 as drag_dirs with mut = 0;
let is i64 as drag_ax with mut = 0;    // mouse at press
let is i64 as drag_ay with mut = 0;
let is i64 as drag_ox with mut = 0;    // window geometry at press
let is i64 as drag_oy with mut = 0;
let is i64 as drag_ow with mut = 0;
let is i64 as drag_oh with mut = 0;
let is i64 as last_click_ns with mut = 0;        // titlebar double-click → maximize
let is i64 as last_click_win with mut = 0 - 1;

// ---- the client image (/wterm.cse; the checkerboard is the fallback) ----
let is i64 as img_base with mut = 0;
let is i64 as img_len with mut = 0;

// ============================================================
// Damage: a small rect list (collapsing to full-screen on overflow), sent to
// the compositor as MSG_WC_DAMAGE rects each tick. The WM no longer composes;
// it just tells the compositor which screen regions changed.
// ============================================================
let is [32]i64 as dmg with mut;                      // 8 × {x,y,w,h}
let is i64 as dmg_n with mut = 0;
let is i64 as dmg_full with mut = 0;

fn damage(x as i64, y as i64, w as i64, h as i64) as void {
    if (dmg_full == 1) { return; }
    let is i64 as x0 with mut = x;
    let is i64 as y0 with mut = y;
    let is i64 as x1 with mut = x + w;
    let is i64 as y1 with mut = y + h;
    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    if (x1 > scr_w) { x1 = scr_w; }
    if (y1 > scr_h) { y1 = scr_h; }
    if (x1 <= x0 || y1 <= y0) { return; }
    let is i64 as k with mut = 0;
    while (k < dmg_n) {
        let is i64 as ex0 = dmg[k*4+0];
        let is i64 as ey0 = dmg[k*4+1];
        let is i64 as ex1 = ex0 + dmg[k*4+2];
        let is i64 as ey1 = ey0 + dmg[k*4+3];
        if (x0 < ex1 && x1 > ex0 && y0 < ey1 && y1 > ey0) {
            let is i64 as nx0 with mut = x0;
            let is i64 as ny0 with mut = y0;
            let is i64 as nx1 with mut = x1;
            let is i64 as ny1 with mut = y1;
            if (ex0 < nx0) { nx0 = ex0; }
            if (ey0 < ny0) { ny0 = ey0; }
            if (ex1 > nx1) { nx1 = ex1; }
            if (ey1 > ny1) { ny1 = ey1; }
            dmg[k*4+0] = nx0;
            dmg[k*4+1] = ny0;
            dmg[k*4+2] = nx1 - nx0;
            dmg[k*4+3] = ny1 - ny0;
            return;
        }
        k = k + 1;
    }
    if (dmg_n >= 8) { dmg_full = 1; return; }
    dmg[dmg_n * 4 + 0] = x0;
    dmg[dmg_n * 4 + 1] = y0;
    dmg[dmg_n * 4 + 2] = x1 - x0;
    dmg[dmg_n * 4 + 3] = y1 - y0;
    dmg_n = dmg_n + 1;
    return;
}
fn damage_all() as void { dmg_full = 1; return; }
fn damage_taskbar() as void { damage(0, scr_h - BAR_H, scr_w, BAR_H); return; }
fn damage_frame(i as i64) as void {
    damage(wins[i].x, wins[i].y,
           wins[i].w + 2 * BORDER, wins[i].h + TITLE_H + 2 * BORDER);
    return;
}

// ============================================================
// The scene: hand the compositor a back-to-front snapshot. Bottom of the stack
// first (zord[nz-1]), top last (zord[0]) — paint order. Minimized windows are
// included (so the compositor can draw their taskbar button) with the minimized
// flag set. Sent only when scene_dirty (z/focus/geometry/lifecycle changed).
// ============================================================
fn wc_send(mtype as i64, a as i64, b as i64, c as i64) as i64 {
    return cp.msg_send(wc_fd, mtype, a, b, c);
}
fn send_scene() as void {
    // count = every used window (live state == 2), whether visible or minimized
    let is i64 as count with mut = 0;
    let is i64 as i with mut = 0;
    while (i < MAX_WIN) {
        if (wins[i].used == 1 && wins[i].state == 2) { count = count + 1; }
        i = i + 1;
    }
    wc_send(cp.MSG_WC_SCENE, count, 0, 0);
    // entries in paint order: bottom (zord[nz-1]) → top (zord[0]).
    let is i64 as zi with mut = nz - 1;
    while (zi >= 0) {
        let is i64 as w = zord[zi];
        if (wins[w].used == 1 && wins[w].state == 2) {
            let is i64 as flags with mut = 0;
            if (zi == 0 && wins[w].minimized == 0) { flags = flags | cp.ENTRY_FOCUSED; }
            if (wins[w].minimized == 1) { flags = flags | 2; }
            wc_send(cp.MSG_WC_SCENE_ENTRY,
                    cp.entry_a(w, flags),
                    cp.pack_xy(wins[w].x, wins[w].y),
                    cp.pack_wh(wins[w].w, wins[w].h));
        }
        zi = zi - 1;
    }
    return;
}

// Flush the queued damage to the compositor, plus the scene if it changed and
// the cursor shape if it changed. The channel buffer (1024B = 32 msgs) holds a
// scene (≤9) + damage (≤8) + cursor easily; we still check WRITABLE up front.
fn flush_to_compositor() as void {
    if (scene_dirty == 1) {
        send_scene();
        scene_dirty = 0;
    }
    if (cur_shape != cur_last_shape) {
        wc_send(cp.MSG_WC_CURSOR, cur_shape, mx, my);
        cur_last_shape = cur_shape;
    }
    if (dmg_full == 1) {
        wc_send(cp.MSG_WC_DAMAGE, 0 - 1, 0, 0);
    } else {
        let is i64 as k with mut = 0;
        while (k < dmg_n) {
            wc_send(cp.MSG_WC_DAMAGE, dmg[k*4+0], dmg[k*4+1],
                    cp.pack_wh(dmg[k*4+2], dmg[k*4+3]));
            k = k + 1;
        }
    }
    dmg_n = 0;
    dmg_full = 0;
    return;
}

// ============================================================
// Decorations: the WM draws borders/titlebars/buttons and the taskbar into
// CELL-GRID segments (compo_proto txt_cell format) and hands them to the
// compositor, which composes them around/over the client content. "The
// compositor decides HOW (the cell format); the WM does WHAT (writes cells)."
// Per-window = the titlebar strip (title + control buttons). Global (win_id
// DEC_TASKBAR_ID) = the bottom bar (window labels + clock).
// ============================================================

// Hand a freshly-written decoration segment to the compositor: fd_send (which
// parks the object before the message bytes) then MSG_WC_DEC_SURFACE.
fn dec_handoff(seg_fd as i64, win_id as i64, npages as i64, cols as i64, rows as i64) as i64 {
    let is i64 as tries with mut = 0;
    while (tries < 1000) {
        let is i64 as fr = sys.fd_send(wc_fd, seg_fd);
        if (fr == 0) {
            wc_send(cp.MSG_WC_DEC_SURFACE, win_id, npages, (cols & 0xFFFFFFFF) | ((rows & 0xFFFFFFFF) << 32));
            return 0;
        }
        if (fr != sys.E_AGAIN) { return 0 - 1; }
        tries = tries + 1;
        sys.poll(cast(*i64, 0), 0, 200000);
    }
    return 0 - 1;
}

// Fill a cell grid's header (cols/rows) at *base.
fn dec_set_header(base as i64, cols as i64, rows as i64) as void {
    let is *i64 as h = cast(*i64, base);
    h[cp.DEC_H_COLS] = cols;
    h[cp.DEC_H_ROWS] = rows;
    return;
}
fn dec_cell_ptr(base as i64, idx as i64) as *i64 {
    return cast(*i64, base + cp.DEC_HDR_CELLS * 8 + idx * 8);
}

// ---- per-window titlebar decoration ----
// Allocated once at full screen width (cols = scr_w/8, 1 row); a resize only
// rewrites the used cols + cells, never the segment. The titlebar is TITLE_H px
// tall; we use one 16px cell row, composed centred in the strip.
fn titlebar_dec_ensure(i as i64) as i64 {
    if (wins[i].dec_fd != 0) { return 0; }
    let is i64 as cols = scr_w / 8;
    let is i64 as pages = cp.dec_seg_pages(cols, 1);
    let is i64 as seg = sys.seg_create(pages, 0);
    if (seg < 0) { return 0 - 1; }
    let is i64 as va = sys.mmap_fd(sys.PROT_READ | sys.PROT_WRITE, seg);
    if (va < 0) { sys.close(seg); return 0 - 1; }
    wins[i].dec_fd = seg;
    wins[i].dec_base = va;
    wins[i].dec_pages = pages;
    // Hand the segment to the compositor ONCE. From then on the WM only writes
    // cells into the shared mapping and damages the titlebar; the compositor
    // re-reads the cells on compose — no per-frame fd_send (the channel's single
    // out-of-band slot can't carry many fd handoffs, which would starve the
    // HELLO surface handoff and wedge new clients).
    dec_set_header(va, cols, 1);                      // header before the compositor maps it
    if (dec_handoff(seg, i, pages, cols, 1) != 0) { return 0 - 1; }
    wins[i].dec_attached = 1;
    return 0;
}

// Render window i's titlebar into its cell grid: title text left, the 3 control
// buttons (minimize / maximize / close) right; the close button turns red on
// hover. cols = w/8 (the content-width titlebar). Only writes cells into the
// shared segment + damages the strip; the handoff happened once in ensure().
fn render_titlebar(i as i64) as void {
    if (titlebar_dec_ensure(i) != 0) { return; }
    let is i64 as cols = wins[i].w / 8;
    if (cols <= 0) { return; }
    let is i64 as focused with mut = 0;
    if (nz > 0 && zord[0] == i && wins[i].minimized == 0) { focused = 1; }
    let is i64 as tcol with mut = COL_TITLE_U;
    if (focused == 1) { tcol = COL_TITLE_F; }
    dec_set_header(wins[i].dec_base, cols, 1);
    // background fill
    let is i64 as c with mut = 0;
    while (c < cols) {
        let is *i64 as cell = dec_cell_ptr(wins[i].dec_base, c);
        cell[0] = cp.make_cell(0, COL_TEXT, tcol);
        c = c + 1;
    }
    // title text (stop before the 3 button columns)
    let is i64 as btn_cols = 3 * (BTN_W / 8);            // 3 buttons, 24px = 3 cells each
    let is i64 as title_max = cols - btn_cols - 1;
    if (wins[i].title_len > 0 && title_max > 0) {
        let is [16]u8 as tb;
        wmp.title_unpack(wins[i].t0, wins[i].t1, wins[i].title_len, cast(*u8, &tb[0]));
        let is i64 as k with mut = 0;
        while (k < wins[i].title_len && k < title_max) {
            let is *i64 as cell = dec_cell_ptr(wins[i].dec_base, k);
            cell[0] = cp.make_cell(cast(i64, tb[k]), COL_TEXT, tcol);
            k = k + 1;
        }
    }
    // buttons: last btn_cols columns. minimize '_', maximize '[', close 'x';
    // the close cell goes red when the pointer hovers the close button.
    let is i64 as per = BTN_W / 8;                       // cells per button (3)
    let is i64 as close0 = cols - per;
    let is i64 as max0   = cols - 2 * per;
    let is i64 as min0   = cols - 3 * per;
    // hover test for the close button (screen coords)
    let is i64 as tb_y = wins[i].y + BORDER;
    let is i64 as right = wins[i].x + BORDER + wins[i].w;
    let is i64 as cbx = right - BTN_W;
    let is i64 as close_hover with mut = 0;
    if (mx >= cbx && mx < right && my >= tb_y && my < tb_y + TITLE_H) { close_hover = 1; }
    if (min0 >= 0) {
        let is *i64 as cm = dec_cell_ptr(wins[i].dec_base, min0 + 1);
        cm[0] = cp.make_cell(cast(i64, 95), COL_TEXT, tcol);     // '_'
    }
    if (max0 >= 0) {
        let is *i64 as cx2 = dec_cell_ptr(wins[i].dec_base, max0 + 1);
        cx2[0] = cp.make_cell(cast(i64, 91), COL_TEXT, tcol);    // '['
    }
    if (close0 >= 0) {
        let is i64 as cbg with mut = tcol;
        if (close_hover == 1) { cbg = COL_CLOSE_H; }
        let is i64 as cc with mut = 0;
        while (cc < per) {
            let is *i64 as cl = dec_cell_ptr(wins[i].dec_base, close0 + cc);
            let is i64 as ch with mut = 0;
            if (cc == 1) { ch = cast(i64, 120); }               // 'x' centred
            cl[0] = cp.make_cell(ch, COL_TEXT, cbg);
            cc = cc + 1;
        }
    }
    // damage the titlebar strip so the compositor recomposes it from the cells
    damage(wins[i].x + BORDER, wins[i].y + BORDER, wins[i].w, TITLE_H);
    return;
}

// ---- global taskbar decoration ----
fn fmt2(off as i64, v as i64) as void {
    clock_str[off] = cast(u8, 48 + v / 10);
    clock_str[off + 1] = cast(u8, 48 + v - (v / 10) * 10);
    return;
}
fn update_clock() as void {
    let is [6]i64 as t;
    if (sys.time_wall(cast(*i64, &t[0])) != 0) { return; }
    fmt2(0, t[3]); clock_str[2] = cast(u8, 58);
    fmt2(3, t[4]); clock_str[5] = cast(u8, 58);
    fmt2(6, t[5]);
    clock_len = 8;
    return;
}
fn taskbar_dec_ensure() as i64 {
    if (tb_dec_fd != 0) { return 0; }
    let is i64 as cols = scr_w / 8;
    let is i64 as pages = cp.dec_seg_pages(cols, 1);
    let is i64 as seg = sys.seg_create(pages, 0);
    if (seg < 0) { return 0 - 1; }
    let is i64 as va = sys.mmap_fd(sys.PROT_READ | sys.PROT_WRITE, seg);
    if (va < 0) { sys.close(seg); return 0 - 1; }
    tb_dec_fd = seg;
    tb_dec_base = va;
    tb_dec_pages = pages;
    tb_cols = cols;
    // hand it to the compositor ONCE (shared mapping thereafter)
    dec_set_header(va, cols, 1);
    if (dec_handoff(seg, cp.DEC_TASKBAR_ID, pages, cols, 1) != 0) {
        sys.munmap(va, pages * 4096); sys.close(seg);
        tb_dec_fd = 0; tb_dec_base = 0;
        return 0 - 1;
    }
    tb_attached = 1;
    return 0;
}
fn tb_puts(col as i64, s as *u8, len as i64, fg as i64, bg as i64) as void {
    let is i64 as k with mut = 0;
    while (k < len && col + k < tb_cols) {
        let is *i64 as cell = dec_cell_ptr(tb_dec_base, col + k);
        cell[0] = cp.make_cell(cast(i64, s[k]), fg, bg);
        k = k + 1;
    }
    return;
}
fn render_taskbar() as void {
    if (taskbar_dec_ensure() != 0) { return; }
    dec_set_header(tb_dec_base, tb_cols, 1);
    // bar background
    let is i64 as c with mut = 0;
    while (c < tb_cols) {
        let is *i64 as cell = dec_cell_ptr(tb_dec_base, c);
        cell[0] = cp.make_cell(0, COL_TEXT, COL_BAR);
        c = c + 1;
    }
    // one button per live window, in win_id order
    let is i64 as task_cols = TASK_W / 8;
    let is i64 as col with mut = 1;
    let is i64 as i with mut = 0;
    while (i < MAX_WIN) {
        if (wins[i].used == 1 && wins[i].state == 2) {
            let is i64 as active with mut = 0;
            if (nz > 0 && zord[0] == i && wins[i].minimized == 0) { active = 1; }
            let is i64 as bg with mut = COL_BAR_ITEM;
            if (active == 1) { bg = COL_TITLE_F; }
            let is i64 as fg with mut = COL_TEXT;
            if (wins[i].minimized == 1) { fg = COL_BAR_DIM; }
            // button background
            let is i64 as bc with mut = 0;
            while (bc < task_cols && col + bc < tb_cols) {
                let is *i64 as cell = dec_cell_ptr(tb_dec_base, col + bc);
                cell[0] = cp.make_cell(0, fg, bg);
                bc = bc + 1;
            }
            // label
            if (wins[i].title_len > 0) {
                let is [16]u8 as tbn;
                wmp.title_unpack(wins[i].t0, wins[i].t1, wins[i].title_len, cast(*u8, &tbn[0]));
                let is i64 as ll with mut = wins[i].title_len;
                if (ll > task_cols - 1) { ll = task_cols - 1; }
                tb_puts(col + 1, cast(*u8, &tbn[0]), ll, fg, bg);
            }
            col = col + task_cols + 1;
        }
        i = i + 1;
    }
    // clock, right-aligned
    if (clock_len > 0) {
        let is i64 as cc = tb_cols - clock_len - 1;
        tb_puts(cc, cast(*u8, &clock_str[0]), clock_len, COL_TEXT, COL_BAR);
    }
    // damage the bar so the compositor recomposes it from the shared cells
    damage(0, scr_h - BAR_H, scr_w, BAR_H);
    return;
}

// ============================================================
// z-order / focus
// ============================================================
fn zremove(idx as i64) as void {
    let is i64 as k with mut = 0;
    let is i64 as found with mut = 0 - 1;
    while (k < nz) {
        if (zord[k] == idx) { found = k; }
        k = k + 1;
    }
    if (found < 0) { return; }
    let is i64 as j with mut = found;
    while (j < nz - 1) { zord[j] = zord[j + 1]; j = j + 1; }
    nz = nz - 1;
    return;
}
fn zraise(idx as i64) as void {
    zremove(idx);
    let is i64 as j with mut = nz;
    while (j > 0) { zord[j] = zord[j - 1]; j = j - 1; }
    zord[0] = idx;
    nz = nz + 1;
    return;
}
fn set_focus(idx as i64) as void {
    scene_dirty = 1;
    deco_dirty = 1;
    damage_taskbar();
    let is i64 as old with mut = 0 - 1;
    if (nz > 0) { old = zord[0]; }
    if (old == idx) { zraise(idx); return; }
    zraise(idx);
    if (old >= 0) {
        wins[old].pend_focus = 0;
        damage_frame(old);
    }
    wins[idx].pend_focus = 1;
    damage_frame(idx);
    wmp.log_kv(cast(*u8, "wm: focus win="), 14, idx);
    return;
}
fn cycle_focus() as void {
    if (nz >= 2) { set_focus(zord[1]); }
    return;
}

// ============================================================
// Client lifecycle
// ============================================================
fn alloc_win() as i64 {
    let is i64 as i with mut = 0;
    while (i < MAX_WIN) {
        if (wins[i].used == 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn spawn_client() as void {
    let is i64 as i = alloc_win();
    if (i < 0) { return; }
    let is [2]i64 as chans;
    if (sys.channel_create(&chans[0]) != 0) { return; }
    let is i64 as a = chans[0];
    let is i64 as b = chans[1];

    let is i64 as w with mut = 640;
    let is i64 as h with mut = 400;
    if (w > scr_w - 80) { w = scr_w - 80; }
    if (h > scr_h - 80) { h = scr_h - 80; }
    if (w < MIN_W) { w = MIN_W; }
    if (h < MIN_H) { h = MIN_H; }
    let is i64 as px with mut = 40 + i * 32;
    let is i64 as py with mut = 40 + i * 32;
    if (px + w + 2 > scr_w) { px = 16; }
    if (py + h + TITLE_H + 2 > scr_h) { py = 16; }

    wmp.msg_send(a, wmp.MSG_WELCOME, scr_w, scr_h, wmp.pack_wh(w, h));

    let is [2]i64 as acts;
    acts[0] = wmp.WM_FD;     // child fd 3 ← side B
    acts[1] = b;
    let is i64 as pid = sys.spawn(cast(*u8, img_base), img_len,
                                  cast(*u8, &acts[0]), 1, cast(*u8, 0), 0);
    sys.close(b);
    if (pid < 0) {
        sys.close(a);
        wmp.log_kv(cast(*u8, "wm: spawn FAIL rc="), 18, pid);
        return;
    }

    wins[i].used = 1;
    wins[i].state = 1;
    wins[i].chan = a;
    wins[i].pid = pid;
    wins[i].seg_fd = 0;
    wins[i].seg_base = 0;
    wins[i].seg_pages = 0;
    wins[i].seg_stride = 0;
    wins[i].x = px; wins[i].y = py; wins[i].w = w; wins[i].h = h;
    wins[i].title_len = 0; wins[i].t0 = 0; wins[i].t1 = 0;
    wins[i].drops = 0;
    wins[i].pend_resize_w = 0; wins[i].pend_resize_h = 0;
    wins[i].pend_focus = 0 - 1;
    wins[i].pend_close = 0;
    wins[i].hello_deadline = sys.time_ns() + HELLO_NS;
    wins[i].mb_fill = 0;
    wins[i].maximized = 0;
    wins[i].minimized = 0;
    wins[i].is_text = 0;
    wins[i].dec_fd = 0;
    wins[i].dec_base = 0;
    wins[i].dec_pages = 0;
    wins[i].dec_attached = 0;
    set_focus(i);
    wmp.log_kv(cast(*u8, "wm: spawn pid="), 14, pid);
    return;
}

// Tear a window down. `do_wait` = the client exited (reap the zombie). Stuck
// clients are KILLED for real (the spawn key is the kill authority).
fn reap_window(i as i64, do_wait as i64) as void {
    if (wins[i].state == 2) {
        // the compositor holds the content segment now — tell it to detach
        wc_send(cp.MSG_WC_DETACH_SURFACE, i, 0, 0);
    }
    if (wins[i].dec_fd != 0) {
        // drop the per-window titlebar decoration on both sides
        wc_send(cp.MSG_WC_DEC_DETACH, i, 0, 0);
        sys.munmap(wins[i].dec_base, wins[i].dec_pages * 4096);
        sys.close(wins[i].dec_fd);
        wins[i].dec_fd = 0;
        wins[i].dec_base = 0;
        wins[i].dec_attached = 0;
    }
    sys.close(wins[i].chan);
    let is i64 as was_top with mut = 0;
    if (nz > 0 && zord[0] == i) { was_top = 1; }
    zremove(i);
    damage_frame(i);
    damage_taskbar();
    scene_dirty = 1;
    deco_dirty = 1;
    wins[i].used = 0;
    wins[i].state = 0;
    if (do_wait == 1) {
        let is i64 as st with mut = 0;
        sys.wait(wins[i].pid, &st);
        wmp.log_kv(cast(*u8, "wm: reap pid="), 13, wins[i].pid);
    } else {
        let is i64 as krc = sys.kill(wins[i].pid);
        if (krc == 0) {
            let is i64 as st2 with mut = 0;
            sys.wait(wins[i].pid, &st2);
            wmp.log_kv(cast(*u8, "wm: killed stuck pid="), 21, wins[i].pid);
        } else {
            wmp.log_kv(cast(*u8, "wm: kill FAIL pid="), 18, wins[i].pid);
        }
    }
    if (was_top == 1 && nz > 0) {
        wins[zord[0]].pend_focus = 1;
        damage_frame(zord[0]);
        wmp.log_kv(cast(*u8, "wm: focus win="), 14, zord[0]);
    }
    return;
}

// ============================================================
// Per-window message service
// ============================================================
fn handle_msg(i as i64, m as *i64) as void {
    if (m[0] == wmp.MSG_HELLO && wins[i].state == 1) {
        // The client parked its content segment with FD_SEND before the HELLO
        // bytes — collect it, then HAND IT OFF to the compositor (the WM never
        // maps client pixels anymore). fd_send precedes the WC message so the
        // compositor's fd_recv on MSG_WC_ATTACH_SURFACE is guaranteed.
        let is i64 as seg = sys.fd_recv(wins[i].chan);
        if (seg < 0) {
            reap_window(i, 0);
            return;
        }
        wins[i].is_text = 0;
        if (wmp.hello_kind(m[3]) == wmp.SURFACE_TEXT) { wins[i].is_text = 1; }
        wins[i].seg_pages = m[1];
        wins[i].seg_stride = m[2];
        // hand the segment to the compositor (fd_send then the attach message)
        let is i64 as tries with mut = 0;
        let is i64 as sent with mut = 0;
        while (tries < 1000 && sent == 0) {
            let is i64 as fr = sys.fd_send(wc_fd, seg);
            if (fr == 0) { sent = 1; }
            else if (fr == sys.E_AGAIN) { tries = tries + 1; sys.poll(cast(*i64, 0), 0, 200000); }
            else { sent = 0 - 1; tries = 1000; }
        }
        sys.close(seg);                              // the compositor owns its copy now
        if (sent != 1) {
            reap_window(i, 0);
            return;
        }
        wc_send(cp.MSG_WC_ATTACH_SURFACE, i, m[1],
                (wins[i].is_text & 1) | ((m[2] & 0xFFFFFFFF) << 32));
        wins[i].seg_fd = 0;
        wins[i].seg_base = 0;
        wins[i].state = 2;
        damage_frame(i);
        damage_taskbar();
        scene_dirty = 1;
        deco_dirty = 1;
        wmp.log_kv(cast(*u8, "wm: hello win="), 14, i);
    } else if (m[0] == wmp.MSG_COMMIT) {
        if (wins[i].state != 2) { return; }
        if (wins[i].is_text == 1) {
            let is i64 as row0 with mut = m[1];
            let is i64 as nrows with mut = wmp.unpack_w(m[3]);
            if (row0 < 0) { nrows = nrows + row0; row0 = 0; }
            let is i64 as py0 = row0 * 16;
            let is i64 as ph with mut = nrows * 16;
            if (py0 + ph > wins[i].h) { ph = wins[i].h - py0; }
            if (ph > 0 && py0 < wins[i].h) {
                damage(wins[i].x + BORDER, wins[i].y + BORDER + TITLE_H + py0, wins[i].w, ph);
            }
            return;
        }
        let is i64 as cx with mut = m[1];
        let is i64 as cy with mut = m[2];
        let is i64 as cw with mut = wmp.unpack_w(m[3]);
        let is i64 as ch with mut = wmp.unpack_h(m[3]);
        if (cx < 0) { cw = cw + cx; cx = 0; }
        if (cy < 0) { ch = ch + cy; cy = 0; }
        if (cx + cw > wins[i].w) { cw = wins[i].w - cx; }
        if (cy + ch > wins[i].h) { ch = wins[i].h - cy; }
        if (cw > 0 && ch > 0) {
            damage(wins[i].x + BORDER + cx, wins[i].y + BORDER + TITLE_H + cy, cw, ch);
        }
    } else if (m[0] == wmp.MSG_SET_TITLE) {
        wins[i].title_len = m[1];
        if (wins[i].title_len > 16) { wins[i].title_len = 16; }
        wins[i].t0 = m[2];
        wins[i].t1 = m[3];
        damage(wins[i].x, wins[i].y, wins[i].w + 2 * BORDER, TITLE_H + BORDER);
        damage_taskbar();
        deco_dirty = 1;                              // title shows on the titlebar + taskbar
    } else if (m[0] == wmp.MSG_CLOSE) {
        reap_window(i, 1);
    } else if (m[0] == wmp.MSG_SPAWN_REQ) {
        spawn_client();
    }
    return;
}

fn service_win(i as i64, got as i64) as void {
    let is i64 as g with mut = got;
    let is [4]i64 as m;
    let is i64 as guard with mut = 0;
    while ((g & sys.POLL_READABLE) != 0) {
        let is i64 as r = wmp.msg_read(wins[i].chan, &wins[i].mb_fill,
                                       cast(*u8, cast(i64, &mbufs[0]) + i * 32), &m[0]);
        if (r < 0) { reap_window(i, 1); return; }
        if (r == 1) {
            handle_msg(i, &m[0]);
            if (wins[i].used == 0) { return; }
        }
        guard = guard + 1;
        if (guard > 64) { break; }
        let is [3]i64 as pe;
        pe[0] = wins[i].chan;
        pe[1] = sys.POLL_READABLE;
        pe[2] = 0;
        sys.poll(&pe[0], 1, 0);
        g = pe[2];
    }
    if ((got & sys.POLL_CLOSED) != 0 || (got & sys.POLL_ERROR) != 0) {
        reap_window(i, 1);
    }
    return;
}

fn drain_pending(i as i64) as void {
    if (wins[i].state != 2) { return; }
    if (writable[i] == 0) { return; }
    if (wins[i].pend_close == 1 && quota[i] < 2) {
        wmp.msg_send(wins[i].chan, wmp.MSG_CLOSE_REQ, 0, 0, 0);
        wins[i].pend_close = 0;
        quota[i] = quota[i] + 1;
    }
    if (wins[i].pend_resize_w > 0 && quota[i] < 2) {
        wmp.msg_send(wins[i].chan, wmp.MSG_RESIZE, wins[i].pend_resize_w, wins[i].pend_resize_h, 0);
        wins[i].pend_resize_w = 0;
        wins[i].pend_resize_h = 0;
        quota[i] = quota[i] + 1;
    }
    if (wins[i].pend_focus >= 0 && quota[i] < 2) {
        wmp.msg_send(wins[i].chan, wmp.MSG_FOCUS, wins[i].pend_focus, 0, 0);
        wins[i].pend_focus = 0 - 1;
        quota[i] = quota[i] + 1;
    }
    return;
}

// ============================================================
// Input routing
// ============================================================
fn chan_writable_now(i as i64) as i64 {
    let is [3]i64 as ce;
    ce[0] = wins[i].chan;
    ce[1] = sys.POLL_WRITABLE;
    ce[2] = 0;
    sys.poll(&ce[0], 1, 0);
    if ((ce[2] & sys.POLL_WRITABLE) != 0) { return 1; }
    return 0;
}

fn forward_key(sc as i64, flags as i64) as void {
    if (nz == 0) { return; }
    let is i64 as i = zord[0];
    if (wins[i].state != 2) { return; }
    if (quota[i] < 2 && chan_writable_now(i) == 1) {
        wmp.msg_send(wins[i].chan, wmp.MSG_KEY, sc, flags, 0);
        quota[i] = quota[i] + 1;
    } else {
        wins[i].drops = wins[i].drops + 1;
        if (wins[i].drops > MAX_DROPS) { reap_window(i, 0); }
    }
    return;
}

fn handle_key(sc as i64, flags as i64) as void {
    let is i64 as pressed = flags & 1;
    let is i64 as ext = (flags >> 1) & 1;
    if (sc == 0x38) { mod_alt = pressed; }
    if (ext == 1 && sc == 0x5B) { mod_super = pressed; }
    if (pressed == 1) {
        if (mod_alt == 1 && ext == 0 && sc == 0x0F) { cycle_focus(); return; }   // Alt+Tab
        if (mod_super == 1 && sc == 0x1C) { spawn_client(); return; }            // Super+Enter
        if (mod_super == 1 && sc == 0x10) {                                      // Super+Q
            if (nz > 0) { wins[zord[0]].pend_close = 1; }
            return;
        }
    }
    forward_key(sc, flags);
    return;
}

// ---- maximize / snap / restore ----
fn set_geometry(i as i64, nx as i64, ny as i64, nw as i64, nh as i64) as void {
    damage_frame(i);
    wins[i].x = nx; wins[i].y = ny; wins[i].w = nw; wins[i].h = nh;
    damage_frame(i);
    scene_dirty = 1;
    deco_dirty = 1;
    wins[i].pend_resize_w = nw; wins[i].pend_resize_h = nh;
    return;
}
fn save_geometry(i as i64) as void {
    wins[i].sav_x = wins[i].x; wins[i].sav_y = wins[i].y;
    wins[i].sav_w = wins[i].w; wins[i].sav_h = wins[i].h;
    return;
}
fn maximize_win(i as i64) as void {
    if (wins[i].maximized == 0) { save_geometry(i); }
    set_geometry(i, 0, 0, scr_w - 2 * BORDER, work_h - TITLE_H - 2 * BORDER);
    wins[i].maximized = 1;
    return;
}
fn snap_win(i as i64, rightside as i64) as void {
    if (wins[i].maximized == 0) { save_geometry(i); }
    let is i64 as halfw = scr_w / 2;
    let is i64 as nx with mut = 0;
    if (rightside == 1) { nx = halfw; }
    set_geometry(i, nx, 0, halfw - 2 * BORDER, work_h - TITLE_H - 2 * BORDER);
    wins[i].maximized = 1;
    return;
}
fn restore_win(i as i64) as void {
    set_geometry(i, wins[i].sav_x, wins[i].sav_y, wins[i].sav_w, wins[i].sav_h);
    wins[i].maximized = 0;
    return;
}
fn toggle_maximize(i as i64) as void {
    if (wins[i].maximized == 1) { restore_win(i); } else { maximize_win(i); }
    return;
}
fn minimize_win(i as i64) as void {
    if (wins[i].minimized == 1) { return; }
    wins[i].minimized = 1;
    damage_frame(i);
    damage_taskbar();
    scene_dirty = 1;
    deco_dirty = 1;
    if (nz > 0 && zord[0] == i) {
        let is i64 as k with mut = 1;
        let is i64 as done with mut = 0;
        while (k < nz && done == 0) {
            let is i64 as cand = zord[k];
            if (wins[cand].used == 1 && wins[cand].state == 2 && wins[cand].minimized == 0) {
                set_focus(cand); done = 1;
            }
            k = k + 1;
        }
    }
    return;
}
fn unminimize_win(i as i64) as void {
    wins[i].minimized = 0;
    damage_frame(i);
    damage_taskbar();
    scene_dirty = 1;
    deco_dirty = 1;
    return;
}
fn taskbar_window_at() as i64 {
    if (my < scr_h - BAR_H) { return 0 - 1; }
    let is i64 as bx with mut = 4;
    let is i64 as i with mut = 0;
    while (i < MAX_WIN) {
        if (wins[i].used == 1 && wins[i].state == 2) {
            if (mx >= bx && mx < bx + TASK_W) { return i; }
            bx = bx + TASK_W + 4;
        }
        i = i + 1;
    }
    return 0 - 1;
}
fn taskbar_click() as void {
    let is i64 as i = taskbar_window_at();
    if (i < 0) { return; }
    if (wins[i].minimized == 1) { unminimize_win(i); set_focus(i); return; }
    if (nz > 0 && zord[0] == i) { minimize_win(i); return; }
    set_focus(i);
    return;
}
fn titlebar_button_at(i as i64) as i64 {
    let is i64 as tb_y0 = wins[i].y + BORDER;
    if (my < tb_y0 || my >= tb_y0 + TITLE_H) { return 0; }
    let is i64 as right = wins[i].x + BORDER + wins[i].w;
    if (mx >= right - BTN_W && mx < right) { return 1; }
    if (mx >= right - 2 * BTN_W && mx < right - BTN_W) { return 2; }
    if (mx >= right - 3 * BTN_W && mx < right - 2 * BTN_W) { return 3; }
    return 0;
}

fn start_move(i as i64) as void {
    if (wins[i].maximized == 1) {
        let is i64 as nw = wins[i].sav_w;
        let is i64 as nh = wins[i].sav_h;
        let is i64 as nx with mut = mx - nw / 2;
        let is i64 as ny with mut = my - TITLE_H / 2;
        if (nx < 0) { nx = 0; }
        if (ny < 0) { ny = 0; }
        if (nx + nw + 2 * BORDER > scr_w) { nx = scr_w - nw - 2 * BORDER; }
        set_geometry(i, nx, ny, nw, nh);
        wins[i].maximized = 0;
    }
    drag_mode = 1;
    drag_win = i;
    drag_ax = mx; drag_ay = my;
    drag_ox = wins[i].x; drag_oy = wins[i].y;
    drag_ow = wins[i].w; drag_oh = wins[i].h;
    return;
}
fn start_resize(i as i64, dirs as i64) as void {
    drag_mode = 2;
    drag_win = i;
    drag_dirs = dirs;
    drag_ax = mx; drag_ay = my;
    drag_ox = wins[i].x; drag_oy = wins[i].y;
    drag_ow = wins[i].w; drag_oh = wins[i].h;
    return;
}

fn forward_mouse(i as i64, mtype as i64, a as i64) as void {
    if (wins[i].state != 2) { return; }
    let is i64 as rx = mx - (wins[i].x + BORDER);
    let is i64 as ry = my - (wins[i].y + BORDER + TITLE_H);
    if (rx < 0 || ry < 0 || rx >= wins[i].w || ry >= wins[i].h) { return; }
    if (quota[i] < 2 && chan_writable_now(i) == 1) {
        wmp.msg_send(wins[i].chan, mtype, a, rx, ry);
        quota[i] = quota[i] + 1;
    } else {
        wins[i].drops = wins[i].drops + 1;
        if (wins[i].drops > MAX_DROPS) { reap_window(i, 0); }
    }
    return;
}

fn press_at() as void {
    if (my >= scr_h - BAR_H) { taskbar_click(); return; }
    let is i64 as zi with mut = 0;
    while (zi < nz) {
        let is i64 as i = zord[zi];
        if (wins[i].used == 1 && wins[i].state == 2) {
            let is i64 as fx = wins[i].x;
            let is i64 as fy = wins[i].y;
            let is i64 as fw = wins[i].w + 2 * BORDER;
            let is i64 as fh = wins[i].h + TITLE_H + 2 * BORDER;
            if (mx >= fx && mx < fx + fw && my >= fy && my < fy + fh) {
                set_focus(i);
                if (mod_super == 1) { start_move(i); return; }
                let is i64 as btn = titlebar_button_at(i);
                if (btn == 1) { wins[i].pend_close = 1; return; }
                if (btn == 2) { toggle_maximize(i); return; }
                if (btn == 3) { minimize_win(i); return; }
                let is i64 as dirs with mut = 0;
                if (mx < fx + EDGE) { dirs = dirs | DIR_W; }
                if (mx >= fx + fw - EDGE) { dirs = dirs | DIR_E; }
                if (my < fy + EDGE) { dirs = dirs | DIR_N; }
                if (my >= fy + fh - EDGE) { dirs = dirs | DIR_S; }
                if (dirs != 0) { start_resize(i, dirs); return; }
                if (my < fy + BORDER + TITLE_H) {
                    let is i64 as now = sys.time_ns();
                    if (last_click_win == i && now - last_click_ns < DCLICK_NS) {
                        last_click_ns = 0; last_click_win = 0 - 1;
                        toggle_maximize(i); return;
                    }
                    last_click_ns = now; last_click_win = i;
                    start_move(i); return;
                }
                forward_mouse(i, wmp.MSG_MOUSE_BTN, mbuttons);
                return;
            }
        }
        zi = zi + 1;
    }
    return;
}

fn handle_buttons(oldb as i64, newb as i64) as void {
    let is i64 as lp_old = oldb & 1;
    let is i64 as lp_new = newb & 1;
    mbuttons = newb;
    if (lp_old == 0 && lp_new == 1) { press_at(); return; }
    if (lp_old == 1 && lp_new == 0) {
        if (drag_mode == 1) {
            if (my <= SNAP_PX) { maximize_win(drag_win); }
            else if (mx <= SNAP_PX) { snap_win(drag_win, 0); }
            else if (mx >= scr_w - SNAP_PX) { snap_win(drag_win, 1); }
            drag_mode = 0; return;
        }
        if (drag_mode != 0) { drag_mode = 0; return; }
        if (nz > 0) { forward_mouse(zord[0], wmp.MSG_MOUSE_BTN, newb); }
        return;
    }
    if (nz > 0) { forward_mouse(zord[0], wmp.MSG_MOUSE_BTN, newb); }
    return;
}

// Pick the resize cursor for a set of edge directions.
fn resize_shape(dirs as i64) as i64 {
    let is i64 as nn = dirs & DIR_N; let is i64 as ss = dirs & DIR_S;
    let is i64 as ww = dirs & DIR_W; let is i64 as ee = dirs & DIR_E;
    if ((nn != 0 && ww != 0) || (ss != 0 && ee != 0)) { return CUR_NWSE; }
    if ((nn != 0 && ee != 0) || (ss != 0 && ww != 0)) { return CUR_NESW; }
    if (ww != 0 || ee != 0) { return CUR_EW; }
    return CUR_NS;
}
// Which cursor the pointer should show right now (hit-test, like press_at).
fn cursor_shape_for() as i64 {
    if (drag_mode == 1) { return CUR_MOVE; }
    if (drag_mode == 2) { return resize_shape(drag_dirs); }
    if (my >= scr_h - BAR_H) { return CUR_ARROW; }
    let is i64 as zi with mut = 0;
    while (zi < nz) {
        let is i64 as i = zord[zi];
        if (wins[i].used == 1 && wins[i].state == 2 && wins[i].minimized == 0) {
            let is i64 as fx = wins[i].x; let is i64 as fy = wins[i].y;
            let is i64 as fw = wins[i].w + 2 * BORDER; let is i64 as fh = wins[i].h + TITLE_H + 2 * BORDER;
            if (mx >= fx && mx < fx + fw && my >= fy && my < fy + fh) {
                let is i64 as dirs with mut = 0;
                if (mx < fx + EDGE)       { dirs = dirs | DIR_W; }
                if (mx >= fx + fw - EDGE) { dirs = dirs | DIR_E; }
                if (my < fy + EDGE)       { dirs = dirs | DIR_N; }
                if (my >= fy + fh - EDGE) { dirs = dirs | DIR_S; }
                if (dirs != 0) { return resize_shape(dirs); }
                if (my < fy + BORDER + TITLE_H) { return CUR_ARROW; }
                return CUR_IBEAM;
            }
        }
        zi = zi + 1;
    }
    return CUR_ARROW;
}

// Apply accumulated motion once per pointer event: drag geometry + cursor shape.
// The compositor owns the cursor's pixels (it has the same mx/my we do), so we
// only damage frames we move/resize and recompute the contextual shape.
fn apply_motion() as void {
    if (drag_mode == 1) {
        let is i64 as i = drag_win;
        let is i64 as fw = wins[i].w + 2 * BORDER;
        let is i64 as fh = wins[i].h + TITLE_H + 2 * BORDER;
        let is i64 as nx2 with mut = drag_ox + (mx - drag_ax);
        let is i64 as ny2 with mut = drag_oy + (my - drag_ay);
        if (nx2 < 0) { nx2 = 0; }
        if (ny2 < 0) { ny2 = 0; }
        if (nx2 + fw > scr_w) { nx2 = scr_w - fw; }
        if (ny2 + fh > scr_h) { ny2 = scr_h - fh; }
        if (nx2 != wins[i].x || ny2 != wins[i].y) {
            damage_frame(i);
            wins[i].x = nx2;
            wins[i].y = ny2;
            damage_frame(i);
            scene_dirty = 1;
            deco_dirty = 1;
        }
    } else if (drag_mode == 2) {
        let is i64 as i = drag_win;
        let is i64 as nw with mut = drag_ow;
        let is i64 as nh with mut = drag_oh;
        let is i64 as nx with mut = drag_ox;
        let is i64 as ny with mut = drag_oy;
        if ((drag_dirs & DIR_E) != 0) { nw = drag_ow + (mx - drag_ax); }
        if ((drag_dirs & DIR_S) != 0) { nh = drag_oh + (my - drag_ay); }
        if ((drag_dirs & DIR_W) != 0) { nw = drag_ow - (mx - drag_ax); }
        if ((drag_dirs & DIR_N) != 0) { nh = drag_oh - (my - drag_ay); }
        if (nw < MIN_W) { nw = MIN_W; }
        if (nh < MIN_H) { nh = MIN_H; }
        if (nw > scr_w - 2 * BORDER) { nw = scr_w - 2 * BORDER; }
        if (nh > scr_h - TITLE_H - 2 * BORDER) { nh = scr_h - TITLE_H - 2 * BORDER; }
        if ((drag_dirs & DIR_W) != 0) { nx = drag_ox + (drag_ow - nw); }
        if ((drag_dirs & DIR_N) != 0) { ny = drag_oy + (drag_oh - nh); }
        if (nx < 0) { nw = nw + nx; nx = 0; }
        if (ny < 0) { nh = nh + ny; ny = 0; }
        if (nx + nw + 2 * BORDER > scr_w) { nw = scr_w - 2 * BORDER - nx; }
        if (ny + nh + TITLE_H + 2 * BORDER > scr_h) { nh = scr_h - TITLE_H - 2 * BORDER - ny; }
        if (nw != wins[i].w || nh != wins[i].h || nx != wins[i].x || ny != wins[i].y) {
            damage_frame(i);
            wins[i].x = nx; wins[i].y = ny;
            wins[i].w = nw; wins[i].h = nh;
            damage_frame(i);
            scene_dirty = 1;
            deco_dirty = 1;
            wins[i].pend_resize_w = nw;
            wins[i].pend_resize_h = nh;
        }
    }
    // Cursor moved → damage the old + new boxes so the compositor recomposes it.
    damage(mx - 13, my - 13, 28, 32);
    // close-button hover: re-render the focused window's titlebar only when the
    // hover state actually flips (the red close cell tracks the pointer).
    let is i64 as hov with mut = 0 - 1;
    if (nz > 0) {
        let is i64 as f = zord[0];
        let is i64 as right = wins[f].x + BORDER + wins[f].w;
        let is i64 as tby = wins[f].y + BORDER;
        if (mx >= right - BTN_W && mx < right && my >= tby && my < tby + TITLE_H) { hov = f; }
    }
    if (hov != close_hover_win) {
        close_hover_win = hov;
        deco_dirty = 1;
        if (nz > 0) {
            let is i64 as f2 = zord[0];
            damage(wins[f2].x + BORDER + wins[f2].w - 3 * BTN_W, wins[f2].y + BORDER, 3 * BTN_W, TITLE_H);
        }
    }
    cur_shape = cursor_shape_for();
    return;
}

// Apply one normalised pointer event from the compositor (absolute pos + buttons).
fn handle_ptr(nx as i64, ny as i64, nb as i64) as void {
    // damage the OLD cursor box before moving (compositor erases it on recompose)
    damage(mx - 13, my - 13, 28, 32);
    mx = nx; my = ny;
    if (nb != mbuttons) { handle_buttons(mbuttons, nb); }
    apply_motion();
    return;
}

// ============================================================
// CMD channel: normalised input from the compositor
// ============================================================
fn service_cmd() as i64 {
    let is [4]i64 as m;
    let is i64 as guard with mut = 0;
    while (1 == 1) {
        let is i64 as r = cp.msg_read(cmd_fd, &cmd_fill, cast(*u8, &cmd_acc[0]), &m[0]);
        if (r < 0) { return 0 - 1; }
        if (r == 0) { return 0; }
        if (m[0] == cp.MSG_CP_SCR_READY) {
            scr_w = m[1];
            scr_h = m[2];
            work_h = scr_h - BAR_H;
            have_geom = 1;
        } else if (m[0] == cp.MSG_CP_KEY) {
            handle_key(m[3], cp.key_devflags(m[2]));   // route by scancode (c word)
        } else if (m[0] == cp.MSG_CP_PTR) {
            handle_ptr(m[1], m[2], m[3]);
        } else if (m[0] == cp.MSG_CP_WHEEL) {
            if (nz > 0) { forward_mouse(zord[0], wmp.MSG_MOUSE_WHEEL, m[1]); }
        } else if (m[0] == cp.MSG_CP_SHUTDOWN_REQ) {
            if (shutdown_state == 0) {
                shutdown_state = 1;
                shutdown_deadline = sys.time_ns() + 2000000000;
                let is i64 as si with mut = 0;
                while (si < MAX_WIN) { if (wins[si].used == 1) { wins[si].pend_close = 1; } si = si + 1; }
            }
        }
        guard = guard + 1;
        if (guard > 128) { return 0; }
        let is [3]i64 as pe2;
        pe2[0] = cmd_fd;
        pe2[1] = sys.POLL_READABLE;
        pe2[2] = 0;
        sys.poll(&pe2[0], 1, 0);
        if ((pe2[2] & sys.POLL_READABLE) == 0) { return 0; }
    }
    return 0;
}

// ============================================================
// Boot
// ============================================================
fn load_image(path as *u8, plen as i64) as i64 {
    let is i64 as fd = syscall(9, cast(i64, path), plen, 0);
    if (fd < 0) { return fd; }
    let is i64 as cap = 1048576;
    let is i64 as buf = sys.mmap(0, cap, sys.PROT_READ | sys.PROT_WRITE);
    if (buf < 0) { sys.close(fd); return buf; }
    let is i64 as total with mut = 0;
    let is i64 as more with mut = 1;
    while (more == 1) {
        let is i64 as r = syscall(10, fd, buf + total, cap - total);
        if (r <= 0) { more = 0; }
        else {
            total = total + r;
            if (total >= cap) { more = 0; }
        }
    }
    sys.close(fd);
    if (total <= 0) { return 0 - 1; }
    img_base = buf;
    img_len = total;
    return 0;
}

fn main() as i32 {
    // No framebuffer, no input devices: the compositor (our parent) owns them.
    // We get the CMD channel (input) at fd 4 and the WC channel (scene) at fd 5.
    let is i64 as CMD_FD with imut = 4;
    let is i64 as WC_FD  with imut = 5;
    cmd_fd = CMD_FD;
    wc_fd = WC_FD;
    cmd_fill = 0;

    // The geometry arrives as MSG_CP_SCR_READY before any input; block for it so
    // spawn_client / clamping have a real screen size.
    let is i64 as spins with mut = 0;
    while (have_geom == 0 && spins < 1000) {
        let is [3]i64 as ge;
        ge[0] = cmd_fd; ge[1] = sys.POLL_READABLE; ge[2] = 0;
        sys.poll(&ge[0], 1, 1000000000);             // 1s
        if ((ge[2] & sys.POLL_READABLE) != 0) {
            if (service_cmd() < 0) {
                sys.write_serial(cast(*u8, "wm: compositor gone\n"), 20);
                return 1;
            }
        }
        spins = spins + 1;
    }
    if (have_geom == 0) {
        sys.write_serial(cast(*u8, "wm: no SCR_READY\n"), 17);
        return 1;
    }

    wmp.log_kv(cast(*u8, "wm: ready w="), 12, scr_w);
    wmp.log_kv(cast(*u8, "wm: ready h="), 12, scr_h);

    // The default client: the windowed terminal; the checkerboard is the
    // fallback proving-client when no terminal is on the disk.
    if (load_image(cast(*u8, "/wterm.cse"), 10) != 0) {
        if (load_image(cast(*u8, "/wmpat.cse"), 10) != 0) {
            sys.write_serial(cast(*u8, "wm: no client image\n"), 20);
            return 1;
        }
    }

    let is i64 as zi with mut = 0;
    while (zi < MAX_WIN) { wins[zi].used = 0; wins[zi].state = 0; wins[zi].dec_fd = 0; zi = zi + 1; }
    mx = scr_w / 2;
    my = scr_h / 2;

    update_clock();
    clock_next = sys.time_ns() + 1000000000;
    spawn_client();

    let is [33]i64 as pe;                            // up to 9 poll entries × 3
    let is [11]i64 as pmap;                          // entry → window (-1 = cmd channel)
    let is i64 as next_frame with mut = sys.time_ns() + FRAME_NS;

    while (1 == 1) {
        // -- build the poll set: the CMD channel + each client channel --
        let is i64 as n with mut = 0;
        let is i64 as cmd_e with mut = 0 - 1;
        pe[n*3+0] = cmd_fd; pe[n*3+1] = sys.POLL_READABLE; pe[n*3+2] = 0;
        pmap[n] = 0 - 1; cmd_e = n; n = n + 1;
        // READABLE always; WRITABLE only while a control message is queued.
        let is i64 as wi with mut = 0;
        while (wi < MAX_WIN) {
            if (wins[wi].used == 1) {
                let is i64 as want with mut = sys.POLL_READABLE;
                if (wins[wi].pend_close == 1 || wins[wi].pend_resize_w > 0
                    || wins[wi].pend_focus >= 0) {
                    want = want | sys.POLL_WRITABLE;
                }
                pe[n*3+0] = wins[wi].chan;
                pe[n*3+1] = want;
                pe[n*3+2] = 0;
                pmap[n] = wi;
                n = n + 1;
            }
            wi = wi + 1;
        }

        let is i64 as now with mut = sys.time_ns();
        let is i64 as tmo with mut = next_frame - now;
        if (tmo < 0) { tmo = 0; }
        sys.poll(&pe[0], n, tmo);

        // -- per-window snapshots first (forwarding gates on them) --
        let is i64 as e with mut = 0;
        while (e < n) {
            let is i64 as w2 = pmap[e];
            if (w2 >= 0) {
                quota[w2] = 0;
                writable[w2] = 0;
                if ((pe[e*3+2] & sys.POLL_WRITABLE) != 0) { writable[w2] = 1; }
            }
            e = e + 1;
        }

        // -- input: drain normalised events off the compositor's CMD channel --
        if (cmd_e >= 0) {
            let is i64 as cgot = pe[cmd_e*3+2];
            if ((cgot & sys.POLL_READABLE) != 0) {
                if (service_cmd() < 0) {
                    sys.write_serial(cast(*u8, "wm: compositor gone\n"), 20);
                    return 0;
                }
            }
            if ((cgot & (sys.POLL_CLOSED | sys.POLL_ERROR)) != 0) {
                sys.write_serial(cast(*u8, "wm: compositor gone\n"), 20);
                return 0;
            }
        }

        // -- client channels --
        e = 0;
        while (e < n) {
            let is i64 as w3 = pmap[e];
            if (w3 >= 0 && wins[w3].used == 1) {
                let is i64 as got = pe[e*3+2];
                if ((got & (sys.POLL_READABLE | sys.POLL_CLOSED | sys.POLL_ERROR)) != 0) {
                    service_win(w3, got);
                }
            }
            e = e + 1;
        }

        // -- queued control messages --
        let is i64 as wp with mut = 0;
        while (wp < MAX_WIN) {
            if (wins[wp].used == 1) { drain_pending(wp); }
            wp = wp + 1;
        }

        // -- clock tick (~1 Hz): re-read the wall, re-render the taskbar --
        now = sys.time_ns();
        if (now >= clock_next) {
            update_clock();
            deco_dirty = 1;
            damage(0, scr_h - BAR_H, scr_w, BAR_H);
            clock_next = now + 1000000000;
        }

        // -- frame tick --
        now = sys.time_ns();
        if (now >= next_frame) {
            // handshake deadlines
            let is i64 as wd with mut = 0;
            while (wd < MAX_WIN) {
                if (wins[wd].used == 1 && wins[wd].state == 1 && now > wins[wd].hello_deadline) {
                    reap_window(wd, 0);
                }
                wd = wd + 1;
            }
            // -- shutdown: the compositor sent MSG_CP_SHUTDOWN_REQ; service_cmd
            // flipped shutdown_state and asked every window to close. Wait for them
            // to exit (the loop reaps them → nz drops), then tell the compositor to
            // paint the notice + power off. Wedged clients are forced after grace.
            if (shutdown_state == 1 && (nz == 0 || now >= shutdown_deadline)) {
                wmp.log_kv(cast(*u8, "wm: shutdown, clients left nz="), 30, nz);
                wc_send(cp.MSG_WC_SHUTDOWN, 0, 0, 0);
                shutdown_state = 2;                     // sent; the compositor powers off
            }
            // -- re-render decorations (titlebars + taskbar) when dirty --
            if (deco_dirty == 1) {
                let is i64 as di with mut = 0;
                while (di < MAX_WIN) {
                    if (wins[di].used == 1 && wins[di].state == 2 && wins[di].minimized == 0) {
                        render_titlebar(di);
                    }
                    di = di + 1;
                }
                render_taskbar();
                deco_dirty = 0;
            }
            // -- push the scene + damage + cursor to the compositor --
            if (scene_dirty == 1 || dmg_full == 1 || dmg_n > 0 || cur_shape != cur_last_shape) {
                flush_to_compositor();
            }
            next_frame = now + FRAME_NS;
        }
    }
    return 0;
}
