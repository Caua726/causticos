// wm.cst — orchestrator only. State + per-domain modules live in separate
// files in this folder; this file just wires main().

use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/wmproto.cst" as wmp;
use "../lib/compo_proto.cst" as cp;
use "state.cst" as s;
use "damage.cst" as dmg;
use "window.cst" as win;
use "decoration.cst" as dec;
use "mouse.cst" as mouse;
use "keyboard.cst" as kbd;
use "client.cst" as cli;
use "scene.cst" as scene;
use "input.cst" as input;

fn main() as i32 {
    s.cmd_fd = 4;
    s.wc_fd = 5;
    s.cmd_fill = 0;
    let is i64 as spins with mut = 0;
    while (s.have_geom == 0 && spins < 1000) {
        let is [3]i64 as ge;
        ge[0] = s.cmd_fd; ge[1] = sys.POLL_READABLE; ge[2] = 0;
        sys.poll(&ge[0], 1, 1000000000);
        if ((ge[2] & sys.POLL_READABLE) != 0) {
            if (input.service_cmd() < 0) {
                sys.write_serial(cast(*u8, "wm: compositor gone\n"), 20);
                return 1;
            }
        }
        spins = spins + 1;
    }
    if (s.have_geom == 0) {
        sys.write_serial(cast(*u8, "wm: no SCR_READY\n"), 17);
        return 1;
    }
    wmp.log_kv(cast(*u8, "wm: ready w="), 12, s.scr_w);
    wmp.log_kv(cast(*u8, "wm: ready h="), 12, s.scr_h);
    if (cli.load_image(cast(*u8, "/wterm.cse"), 10) != 0) {
        if (cli.load_image(cast(*u8, "/wmpat.cse"), 10) != 0) {
            sys.write_serial(cast(*u8, "wm: no client image\n"), 20);
            return 1;
        }
    }
    win.win_init_all();
    s.mx = s.scr_w / 2;
    s.my = s.scr_h / 2;
    dec.update_clock();
    s.clock_next = sys.time_ns() + 1000000000;
    cli.spawn_named(cast(*u8, "launcher.cse"), 12);
    if (s.nz == 0) { cli.spawn_client(); }

    let is [33]i64 as pe;
    let is [11]i64 as pmap;
    let is i64 as next_frame with mut = sys.time_ns() + 16666667;
    while (1 == 1) {
        let is i64 as n with mut = 0;
        let is i64 as cmd_e with mut = 0 - 1;
        pe[n*3+0] = s.cmd_fd; pe[n*3+1] = sys.POLL_READABLE; pe[n*3+2] = 0;
        pmap[n] = 0 - 1; cmd_e = n; n = n + 1;
        let is i64 as wi with mut = 0;
        while (wi < s.MAX_WIN) {
            if (s.wins[wi].used == 1) {
                let is i64 as want with mut = sys.POLL_READABLE;
                if (s.wins[wi].pend_close == 1 || s.wins[wi].pend_resize_w > 0
                    || s.wins[wi].pend_focus >= 0) {
                    want = want | sys.POLL_WRITABLE;
                }
                pe[n*3+0] = s.wins[wi].chan;
                pe[n*3+1] = want;
                pe[n*3+2] = 0;
                pmap[n] = wi;
                n = n + 1;
            }
            wi = wi + 1;
        }
        let is i64 as now with mut = sys.time_ns();
        let is i64 as tmo with mut = next_frame - now;
        if (tmo < 0) { tmo = 0; }
        sys.poll(&pe[0], n, tmo);
        let is i64 as e with mut = 0;
        while (e < n) {
            let is i64 as w2 = pmap[e];
            if (w2 >= 0) {
                s.quota[w2] = 0;
                s.writable[w2] = 0;
                if ((pe[e*3+2] & sys.POLL_WRITABLE) != 0) { s.writable[w2] = 1; }
            }
            e = e + 1;
        }
        if (cmd_e >= 0) {
            let is i64 as cgot = pe[cmd_e*3+2];
            if ((cgot & sys.POLL_READABLE) != 0) {
                if (input.service_cmd() < 0) {
                    sys.write_serial(cast(*u8, "wm: compositor gone\n"), 20);
                    return 0;
                }
            }
            if ((cgot & (sys.POLL_CLOSED | sys.POLL_ERROR)) != 0) {
                sys.write_serial(cast(*u8, "wm: compositor gone\n"), 20);
                return 0;
            }
        }
        e = 0;
        while (e < n) {
            let is i64 as w3 = pmap[e];
            if (w3 >= 0 && s.wins[w3].used == 1) {
                let is i64 as got = pe[e*3+2];
                if ((got & (sys.POLL_READABLE | sys.POLL_CLOSED | sys.POLL_ERROR)) != 0) {
                    cli.service_win(w3, got);
                }
            }
            e = e + 1;
        }
        let is i64 as wp with mut = 0;
        while (wp < s.MAX_WIN) {
            if (s.wins[wp].used == 1) { cli.drain_pending(wp); }
            wp = wp + 1;
        }
        now = sys.time_ns();
        if (now >= s.clock_next) {
            dec.update_clock();
            s.deco_dirty = 1;
            dmg.dmg_add(0, s.scr_h - 26, s.scr_w, 26);
            s.clock_next = now + 1000000000;
        }
        now = sys.time_ns();
        if (now >= next_frame) {
            let is i64 as wd with mut = 0;
            while (wd < s.MAX_WIN) {
                if (s.wins[wd].used == 1 && s.wins[wd].state == 1 && now > s.wins[wd].hello_deadline) {
                    cli.reap_window(wd, 0);
                }
                wd = wd + 1;
            }
            if (s.shutdown_state == 1 && (s.nz == 0 || now >= s.shutdown_deadline)) {
                cp.msg_send(s.wc_fd, cp.MSG_WC_SHUTDOWN, 0, 0, 0);
                s.shutdown_state = 2;
            }
            dec.render_all_decorations();
            if (scene.needs_flush() == 1) {
                scene.flush_to_compositor();
            }
            next_frame = now + 16666667;
        }
    }
    return 0;
}
