// wterm.cst — orchestrator (/wterm.cse). Imports state + per-domain modules;
// owns main() and the per-sweep dispatchers. Module-level state lives
// exclusively in wterm_state.cst; this file only orchestrates.
use "wterm_state.cst" as s;
use "wterm_grid.cst" as g;
use "wterm_child.cst" as cli;
use "wterm_repl.cst" as r;
use "std/causticos/term.cst" as term;
use "std/os/causticos.cst" as sys;
use "../lib/wmproto/wmproto.cst" as wmp;
use "../lib/compo_proto/compo_proto.cst" as cp;
use "../lib/repl/repl.cst" as repl;
use "../lib/jobs/jobs.cst" as jobs;
use "../lib/shbuiltin/shbuiltin.cst" as bi;
use "../lib/shexec/shexec.cst" as sx;
use "../lib/netcli/netsvc.cst" as netsvc;
use "../lib/ttyproto/ttyproto.cst" as tty;

// Forward one keystroke to the running child. Raw bytes, byte-at-a-time,
// no echo: the program echoes if it wants (terminal raw mode). Special keys
// become 1-byte codes (Enter 0x0A, BS 0x08, Tab 0x09, Esc 0x1B) or 3-byte
// ANSI sequences (arrows → ESC[A/B/C/D) so a TUI like btop can read them.
fn forward_key(t as *term.Term, keysym as i64, kb as i64) as void {
    if (s.fg_job < 0) { return; }
    let is i64 as cin = jobs.get(s.fg_job).in_fd;
    if (cin < 0) { return; }
    if (keysym == cp.KEY_UP) {
        let is [3]u8 as ek;
        ek[0] = cast(u8, 0x1B); ek[1] = cast(u8, 0x5B); ek[2] = cast(u8, 65);
        g.to_child(cin, cast(*u8, &ek[0]), 3);
    } else if (keysym == cp.KEY_DOWN) {
        let is [3]u8 as ek;
        ek[0] = cast(u8, 0x1B); ek[1] = cast(u8, 0x5B); ek[2] = cast(u8, 66);
        g.to_child(cin, cast(*u8, &ek[0]), 3);
    } else if (keysym == cp.KEY_RIGHT) {
        let is [3]u8 as ek;
        ek[0] = cast(u8, 0x1B); ek[1] = cast(u8, 0x5B); ek[2] = cast(u8, 67);
        g.to_child(cin, cast(*u8, &ek[0]), 3);
    } else if (keysym == cp.KEY_LEFT) {
        let is [3]u8 as ek;
        ek[0] = cast(u8, 0x1B); ek[1] = cast(u8, 0x5B); ek[2] = cast(u8, 68);
        g.to_child(cin, cast(*u8, &ek[0]), 3);
    } else if (keysym == cp.KEY_ENTER) {
        let is [1]u8 as kb_b; kb_b[0] = cast(u8, 0x0A);
        g.to_child(cin, cast(*u8, &kb_b[0]), 1);
    } else if (keysym == cp.KEY_BACKSPACE) {
        let is [1]u8 as kb_b; kb_b[0] = cast(u8, 0x08);
        g.to_child(cin, cast(*u8, &kb_b[0]), 1);
    } else if (keysym == cp.KEY_TAB) {
        let is [1]u8 as kb_b; kb_b[0] = cast(u8, 0x09);
        g.to_child(cin, cast(*u8, &kb_b[0]), 1);
    } else if (keysym == cp.KEY_ESC) {
        let is [1]u8 as kb_b; kb_b[0] = cast(u8, 0x1B);
        g.to_child(cin, cast(*u8, &kb_b[0]), 1);
    } else if (keysym > 0 && keysym < 0x80) {
        let is [1]u8 as kb_b; kb_b[0] = cast(u8, keysym);
        g.to_child(cin, cast(*u8, &kb_b[0]), 1);
    }
    return;
}

// Append decimal `v` (>= 0) to buf at off; return the new offset.
fn _dec(buf as *u8, off as i64, v as i64) as i64 {
    let is i64 as x with mut = v;
    if (x < 0) { x = 0; }
    if (x == 0) { buf[off] = cast(u8, 48); return off + 1; }
    let is [12]u8 as tmp;
    let is i64 as nn with mut = 0;
    while (x > 0) { tmp[nn] = cast(u8, 48 + (x - (x / 10) * 10)); x = x / 10; nn = nn + 1; }
    let is i64 as o with mut = off;
    let is i64 as i with mut = nn - 1;
    while (i >= 0) { buf[o] = tmp[i]; o = o + 1; i = i - 1; }
    return o;
}

fn px_to_cell_col(t as *term.Term, px as i64) as i64 {
    let is i64 as c with mut = 1;
    if (t.width > 0 && t.cols > 0) { c = px * t.cols / t.width + 1; }
    if (c < 1) { c = 1; }
    if (c > t.cols) { c = t.cols; }
    return c;
}
fn px_to_cell_row(t as *term.Term, py as i64) as i64 {
    let is i64 as r with mut = 1;
    if (t.height > 0 && t.rows > 0) { r = py * t.rows / t.height + 1; }
    if (r < 1) { r = 1; }
    if (r > t.rows) { r = t.rows; }
    return r;
}

// Encode one mouse event into the child's stdin. xbtn = xterm button code
// (0 left, 1 middle, 2 right, 64 wheel-up, 65 wheel-down). SGR (CSI < b;x;y M/m)
// when the child asked for ?1006, else legacy X10 (CSI M Cb Cx Cy, 32-based).
fn mouse_emit(t as *term.Term, xbtn as i64, col as i64, row as i64, press as i64) as void {
    if (s.fg_job < 0) { return; }
    let is i64 as cin = jobs.get(s.fg_job).in_fd;
    if (cin < 0) { return; }
    let is [32]u8 as seq;
    let is i64 as n with mut = 0;
    if (t.mouse_sgr == 1) {
        seq[0] = cast(u8, 0x1B); seq[1] = cast(u8, 0x5B); seq[2] = cast(u8, 0x3C); n = 3;   // ESC [ <
        n = _dec(cast(*u8, &seq[0]), n, xbtn);
        seq[n] = cast(u8, 0x3B); n = n + 1;
        n = _dec(cast(*u8, &seq[0]), n, col);
        seq[n] = cast(u8, 0x3B); n = n + 1;
        n = _dec(cast(*u8, &seq[0]), n, row);
        if (press == 1) { seq[n] = cast(u8, 77); } else { seq[n] = cast(u8, 109); }         // 'M' / 'm'
        n = n + 1;
    } else {
        let is i64 as cb with mut = 32 + xbtn;
        if (press == 0) { cb = 32 + 3; }                                                    // release => button 3
        let is i64 as cx = 32 + col; let is i64 as cy = 32 + row;
        seq[0] = cast(u8, 0x1B); seq[1] = cast(u8, 0x5B); seq[2] = cast(u8, 77);            // ESC [ M
        seq[3] = cast(u8, cb & 0xFF); seq[4] = cast(u8, cx & 0xFF); seq[5] = cast(u8, cy & 0xFF);
        n = 6;
    }
    g.to_child(cin, cast(*u8, &seq[0]), n);
    return;
}

// A button mask arrived (MSG_MOUSE_BTN). If the child enabled tracking, emit a
// press/release for every button that changed since last time.
fn forward_mouse_btn(t as *term.Term, newmask as i64, px as i64, py as i64) as void {
    if (s.fg_job < 0 || t.mouse_mode == 0) { s.mouse_prev_btn = newmask; return; }
    let is i64 as cin = jobs.get(s.fg_job).in_fd;
    if (cin < 0) { s.mouse_prev_btn = newmask; return; }
    let is i64 as col = px_to_cell_col(t, px);
    let is i64 as row = px_to_cell_row(t, py);
    let is i64 as diff = newmask ^ s.mouse_prev_btn;
    if ((diff & cp.BTN_LEFT) != 0) {
        let is i64 as pr with mut = 0; if ((newmask & cp.BTN_LEFT) != 0) { pr = 1; }
        mouse_emit(t, 0, col, row, pr);
    }
    if ((diff & cp.BTN_MIDDLE) != 0) {
        let is i64 as pr with mut = 0; if ((newmask & cp.BTN_MIDDLE) != 0) { pr = 1; }
        mouse_emit(t, 1, col, row, pr);
    }
    if ((diff & cp.BTN_RIGHT) != 0) {
        let is i64 as pr with mut = 0; if ((newmask & cp.BTN_RIGHT) != 0) { pr = 1; }
        mouse_emit(t, 2, col, row, pr);
    }
    s.mouse_prev_btn = newmask;
    return;
}

// A wheel notch arrived (MSG_MOUSE_WHEEL). Wheel is a press-only button 64/65.
fn forward_mouse_wheel(t as *term.Term, delta as i64, px as i64, py as i64) as void {
    // Nobody asked for the wheel: it scrolls the terminal's own history,
    // three lines a notch (delta > 0 is a notch up, toward older lines).
    if (s.fg_job < 0 || t.mouse_mode == 0) {
        term.scroll_view(t, delta * 3);
        g.show(t);
        return;
    }
    let is i64 as cin = jobs.get(s.fg_job).in_fd;
    if (cin < 0) { return; }
    let is i64 as col = px_to_cell_col(t, px);
    let is i64 as row = px_to_cell_row(t, py);
    if (delta > 0) { mouse_emit(t, 64, col, row, 1); }
    else if (delta < 0) { mouse_emit(t, 65, col, row, 1); }
    return;
}

// finish_job — retire a job only after its output is drained: the exit event
// usually arrives while the last write is still sitting in the channel. Its
// control requests are honoured too, for the same reason.
fn finish_job(t as *term.Term, slot as i64) as void {
    cli.drain_ctl(slot);
    let is i64 as guard with mut = 0;
    while (jobs.get(slot).out_fd >= 0 && guard < 4096) {
        if (cli.pump_job(t, slot) == 1) { guard = 4096; }
        guard = guard + 1;
    }
    let is i64 as was_fg with mut = 0;
    let is i64 as unread with mut = 0;
    if (s.fg_job == slot) {
        was_fg = 1;
        // A program that ended without putting the terminal back (killed,
        // or an error on the way out) does not leave its screen, a hidden
        // cursor or mouse reporting behind it.
        term.end_program(t);
        s.fg_job = 0 - 1;
        // What it was sent and never read: the channel still counts it after
        // the job's end closed. Saved before release closes ours.
        let is i64 as cin = jobs.get(slot).in_fd;
        if (cin >= 0) {
            let is [4]i64 as ci;
            if (sys.chan_info(cin, &ci[0]) == 0) { unread = ci[0] - ci[2]; }
        }
        if (unread > s.ta_end) { unread = s.ta_end; }
        if (unread > s.TA_CAP) { unread = s.TA_CAP; }
        let is i64 as k with mut = 0;
        while (k < unread) {
            s.ta_back[k] = s.ta_ring[(s.ta_end - unread + k) % s.TA_CAP];
            k = k + 1;
        }
        // This is where '$?' comes from. Without it the status a script or an
        // `if` reads is whatever a builtin last returned, not what the command
        // the user actually ran exited with.
        sx.set_status(jobs.get(slot).exit_code);
        sx.crash_line(t, slot, s.C_ERR);
    }
    if (jobs.get(slot).bg == 1 && jobs.get(slot).reported == 0) {
        // A background job finishes at a moment the user did not choose, so it
        // lands on a half-typed line: break, report, then put the prompt and
        // what was typed back.
        jobs.get(slot).reported = 1;
        repl.finish(&s.rl, t);
        r.print_job(t, slot);
        sx.crash_line(t, slot, s.C_ERR);
        jobs.release(slot);
        g.prompt(t);
        repl.reprint(&s.rl, t);
        g.show(t);
        return;
    }
    jobs.release(slot);
    if (was_fg == 1) {
        cli.set_title(cast(*u8, "wterm"), 5);
        // The rest of the line it was part of (`a && b`) runs now.
        if (sx.list_pending() == 1) {
            if (r.list_run(t) == 1) { quit(); return; }
        }
        if (s.fg_job < 0) { g.prompt(t); }
        if (unread > 0) { type_ahead(t, unread); }
    }
    g.show(t);
    return;
}

// The n bytes of s.ta_back — typed while the last job ran, never read by it —
// as if typed now: into the line, and Enter runs it. Once a line starts a job,
// the rest is that job's input, the way it would have been on a tty. Escape
// sequences (arrows, mouse reports) were for the program that is gone and are
// skipped.
fn type_ahead(t as *term.Term, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (s.fg_job >= 0) {
            let is i64 as cin = jobs.get(s.fg_job).in_fd;
            if (cin >= 0) { g.to_child(cin, cast(*u8, &s.ta_back[i]), n - i); }
            return;
        }
        let is i64 as c = cast(i64, s.ta_back[i]);
        if (c == 0x1B) {
            i = i + 1;
            if (i < n && s.ta_back[i] == cast(u8, 0x5B)) {               // CSI: up to its final byte
                i = i + 1;
                while (i < n && (s.ta_back[i] < cast(u8, 0x40) || s.ta_back[i] > cast(u8, 0x7E))) { i = i + 1; }
            }
        }
        else if (c == 0x0A) { handle_key(t, cp.KEY_ENTER, 0x100, 0x1C); }
        else if (c == 0x08) { handle_key(t, cp.KEY_BACKSPACE, 0x100, 0x0E); }
        else if (c == 0x09) { handle_key(t, cp.KEY_TAB, 0x100, 0x0F); }
        else if (c >= 32 && c < 127) { handle_key(t, c, 0x100, 0); }
        i = i + 1;
    }
    return;
}

// `exit` owes the same cleanup the window manager's close request does: this
// terminal holds the only keys to the jobs it started, so leaving without
// ending them strands them with nobody to read their output and nobody able to
// kill them.
// close_window — the window was asked to close, and every job goes with it.
// A job that asked for EV_HUP is told instead of ended, and the window waits
// up to CLOSE_WAIT_NS for it (close_check): one holding unsaved work stays,
// says so on its own screen, and the window stays with it — the close is
// called off. Closing the window of an editor used to end it as it stood.
fn close_window(t as *term.Term) as void {
    let is i64 as waiting with mut = 0;
    let is i64 as jk with mut = 0;
    while (jk < jobs.max_jobs()) {
        let is *jobs.Job as cj = jobs.get(jk);
        if (cj.status == jobs.JOB_RUN) {
            if ((cj.tty_catch & tty.EV_HUP) != 0 && cj.tty_fd >= 0) {
                tty.send_event(cj.tty_fd, tty.EV_HUP);
                waiting = 1;
            } else {
                jobs.kill_job(jk);
            }
        }
        jk = jk + 1;
    }
    if (waiting == 1) { s.close_wait_until = sys.time_ns() + s.CLOSE_WAIT_NS; return; }
    term.putc(t, 0x0A); g.show(t);
    wmp.msg_send(s.WM_FD, wmp.MSG_CLOSE, 0, 0, 0);
    return;
}

// close_check — each pass while a close waits: the jobs it told may be gone
// (the window closes), or the wait over (it stays open).
fn close_check() as void {
    if (s.close_wait_until == 0) { return; }
    let is i64 as running with mut = 0;
    let is i64 as jk with mut = 0;
    while (jk < jobs.max_jobs()) {
        if (jobs.get(jk).status == jobs.JOB_RUN) { running = 1; }
        jk = jk + 1;
    }
    if (running == 0) {
        s.close_wait_until = 0;
        wmp.msg_send(s.WM_FD, wmp.MSG_CLOSE, 0, 0, 0);
        return;
    }
    if (sys.time_ns() >= s.close_wait_until) { s.close_wait_until = 0; }
    return;
}

fn quit() as void {
    let is i64 as jk with mut = 0;
    while (jk < jobs.max_jobs()) {
        if (jobs.get(jk).status == jobs.JOB_RUN) { jobs.kill_job(jk); }
        jk = jk + 1;
    }
    wmp.msg_send(s.WM_FD, wmp.MSG_CLOSE, 0, 0, 0);
    return;
}

// _edit — run one editing action and repaint. See the same helper in the
// fullscreen shell: both drive the shared editor, they just receive keys
// differently (raw scancodes there, normalised keysyms here).
fn _edit(t as *term.Term, what as i64) as void {
    let is i64 as ok with mut = 0;
    if (what == 1)      { ok = repl.move_left(&s.rl); }
    else if (what == 2) { ok = repl.move_right(&s.rl); }
    else if (what == 3) { ok = repl.move_home(&s.rl); }
    else if (what == 4) { ok = repl.move_end(&s.rl); }
    else if (what == 5) { ok = repl.kill_to_end(&s.rl); }
    else if (what == 6) { ok = repl.kill_to_start(&s.rl); }
    else if (what == 7) { ok = repl.kill_word(&s.rl); }
    else if (what == 8) { ok = repl.yank(&s.rl); }
    else if (what == 9) { ok = repl.transpose(&s.rl); }
    else if (what == 10) { ok = repl.line_delete(&s.rl); }
    if (ok == 1) { repl.redraw(&s.rl, t); g.show(t); }
    return;
}

// Ctrl+L: the screen cleared, the prompt and the line being typed redrawn at
// the top — the same `clear` does, without losing the line.
fn clear_screen(t as *term.Term) as void {
    term.clear(t);
    g.prompt(t);
    repl.reprint(&s.rl, t);
    g.show(t);
    return;
}

// Tab is "auto-commit at first whitespace, else emit completion and stay".
fn handle_key(t as *term.Term, keysym as i64, kb as i64, sc as i64) as void {
    let is i64 as pressed = cp.key_pressed(kb);
    if (pressed != 1) { return; }
    // Shift+PgUp/PgDn page through the history, whoever has the keys — the
    // terminal's own, never passed on.
    if ((cp.key_mods(kb) & cp.MOD_SHIFT) != 0 && (keysym == cp.KEY_PGUP || keysym == cp.KEY_PGDN)) {
        let is i64 as page with mut = t.rows - 1;
        if (page < 1) { page = 1; }
        if (keysym == cp.KEY_PGUP) { term.scroll_view(t, page); } else { term.scroll_view(t, 0 - page); }
        g.show(t);
        return;
    }
    // Any other key brings the live screen back first: what it does shows
    // there. (Output does the same in term.putc; a key that only moves the
    // cursor did not, and moved it out of sight.)
    if (keysym != 0 && t.view_off != 0) {
        term.scroll_view(t, 0 - t.view_off);
        g.show(t);
    }
    if (s.fg_job >= 0) {
        // Ctrl+C ends the job instead of being forwarded to it. The terminal
        // spawned it and holds the only key to it, so this is the ONLY way out
        // of a program that stopped reading its input — without it a runaway
        // command could only be escaped by destroying the window. A program
        // that asked for it (ttyproto EV_INTR: an editor, a recorder with a
        // file to finish) is told instead, and decides. Ctrl+\ ends the job
        // whatever it asked.
        if ((cp.key_mods(kb) & cp.MOD_CTRL) != 0 && (sc == 0x2E || sc == 0x2B)) {
            let is *jobs.Job as fj = jobs.get(s.fg_job);
            if (sc == 0x2E && (fj.tty_catch & tty.EV_INTR) != 0 && fj.tty_fd >= 0) {
                tty.send_event(fj.tty_fd, tty.EV_INTR);
            } else {
                jobs.kill_job(s.fg_job);
            }
            sx.list_cancel();            // and the rest of its line with it
            return;
        }
        // Otherwise a job in the foreground is who the user is talking to.
        forward_key(t, keysym, kb);
        return;
    }
    // A Ctrl+R search takes the keys while it runs (repl.cst explains which
    // do what); any other key ends it, keeping the line found, and then goes
    // on below as usual. A modifier pressed alone (keysym 0) is not a key.
    if (repl.searching(&s.rl) == 1) {
        if (keysym == 0) { return; }
        let is i64 as sctrl = cp.key_mods(kb) & cp.MOD_CTRL;
        if (sctrl != 0 && sc == 0x13) { repl.search_next(&s.rl, t); g.show(t); return; }
        if ((sctrl != 0 && sc == 0x22) || keysym == cp.KEY_ESC) {     // Ctrl+G, Esc
            repl.search_end(&s.rl, t, 0); g.show(t); return;
        }
        if (keysym == cp.KEY_BACKSPACE) { repl.search_back(&s.rl, t); g.show(t); return; }
        if (sctrl == 0 && keysym >= 0x20 && keysym < 0x7F) {
            repl.search_key(&s.rl, t, keysym); g.show(t); return;
        }
        repl.search_end(&s.rl, t, 1);
        g.show(t);
    }
    // Readline's control chords, matched on the SCANCODE the compositor also
    // forwards: what Ctrl+letter turns into is keymap policy, and the chord is
    // not.
    if ((cp.key_mods(kb) & cp.MOD_CTRL) != 0) {
        if (sc == 0x25) { _edit(t, 5); return; }        // Ctrl+K  kill to end
        if (sc == 0x16) { _edit(t, 6); return; }        // Ctrl+U  kill to start
        if (sc == 0x11) { _edit(t, 7); return; }        // Ctrl+W  kill word
        if (sc == 0x15) { _edit(t, 8); return; }        // Ctrl+Y  yank
        if (sc == 0x14) { _edit(t, 9); return; }        // Ctrl+T  transpose
        if (sc == 0x1E) { _edit(t, 3); return; }        // Ctrl+A  start of line
        if (sc == 0x12) { _edit(t, 4); return; }        // Ctrl+E  end of line
        if (sc == 0x26) { clear_screen(t); return; }    // Ctrl+L  clear the screen
        if (sc == 0x13) { repl.search_next(&s.rl, t); g.show(t); return; }   // Ctrl+R  search history
        if (sc == 0x2E) {                               // Ctrl+C  drop the line
            repl.cancel(&s.rl, t);
            g.prompt(t);
            g.show(t);
            return;
        }
        if (sc == 0x20) {                               // Ctrl+D  close on an empty line,
            if (repl.line_len(&s.rl) == 0) { quit(); return; }   // like `exit`
            _edit(t, 10);                               // else delete at the cursor
            return;
        }
        // Any other chord is not text. It used to fall through and go into the
        // line as the letter or as a control character drawn as a glyph
        // (Ctrl+V), and from there into the command. Ctrl+Alt is left alone:
        // that is how some layouts type characters.
        if ((cp.key_mods(kb) & cp.MOD_ALT) == 0) { return; }
    }
    if (keysym == cp.KEY_ENTER) {
        repl.finish(&s.rl, t);
        g.show(t);
        repl.hist_push(&s.rl, repl.line_ptr(&s.rl), repl.line_len(&s.rl));
        // Persisted before the command runs, not on exit: a terminal is closed
        // by the window manager as often as by `exit`, and a killed window owes
        // its history just the same.
        repl.file_save(&s.rl, cast(*u8, "/var/history"));
        let is i64 as leave = r.run_line(t, repl.line_ptr(&s.rl), repl.line_len(&s.rl));
        repl.line_clear(&s.rl);
        if (leave == 1) { quit(); return; }
        if (s.fg_job < 0) { g.prompt(t); }
        g.show(t);
    } else if (keysym == cp.KEY_TAB) {
        let is [64]i64 as bt;
        let is i64 as nb = r.builtins(cast(*i64, &bt[0]));
        repl.complete(&s.rl, t, cast(*i64, &bt[0]), nb);
        g.show(t);
    } else if (keysym == cp.KEY_BACKSPACE) {
        if (repl.line_backspace(&s.rl) == 1) { repl.redraw(&s.rl, t); g.show(t); }
    } else if (keysym == cp.KEY_UP) {
        if (repl.nav_up(&s.rl, t) == 1) { g.show(t); }
    } else if (keysym == cp.KEY_DOWN) {
        if (repl.nav_down(&s.rl, t) == 1) { g.show(t); }
    } else if (keysym == cp.KEY_LEFT)  { _edit(t, 1); }
    else if (keysym == cp.KEY_RIGHT) { _edit(t, 2); }
    else if (keysym == cp.KEY_HOME)  { _edit(t, 3); }
    else if (keysym == cp.KEY_END)   { _edit(t, 4); }
    else if (keysym == cp.KEY_DEL)   { _edit(t, 10); }
    else if (keysym > 0 && keysym < 0x80) {
        if (repl.line_push(&s.rl, keysym) == 1) { repl.redraw(&s.rl, t); g.show(t); }
    }
    return;
}

fn handle_msg(t as *term.Term, m as *i64) as void {
    if (m[0] == wmp.MSG_RESIZE) {
        // What is on screen stays: the grid re-lays itself out at the new size
        // (rows are cut at the new width, not re-wrapped; the view keeps its
        // bottom). This used to clear the screen, and with it everything a
        // resize, maximise or restore happened to fall on.
        //
        // The line being typed is the exception: its wrap depends on the width,
        // so it is taken off first and put back after, wrapped anew. If the
        // prompt no longer fits beside it, it starts again on the next row.
        let is i64 as editing with mut = 0;
        if (s.fg_job < 0) { editing = 1; }
        if (editing == 1) { repl.lift(&s.rl, t); }
        let is i64 as cx0 = t.cx;
        term.resize(t, m[1], m[2]);
        if (editing == 1) {
            if (t.cx != cx0) { term.putc(t, 0x0A); g.prompt(t); }
            repl.reprint(&s.rl, t);
        }
        g.show(t);
        g.send_size(t);
    } else if (m[0] == wmp.MSG_CLOSE_REQ) {
        // The window is being dismissed, so it goes, and every job this
        // terminal started goes with it, background ones too: the wterm holds
        // the only keys to them. Ending the job without ending the window (an
        // old behaviour) left Super+Q doing nothing at an idle prompt. A job
        // that asked to be told is told, and may keep the window (close_window).
        if (s.close_wait_until == 0) { close_window(t); }
    } else if (m[0] == wmp.MSG_MOUSE_BTN) {
        forward_mouse_btn(t, m[1], m[2], m[3]);   // a=buttons, b=x, c=y (content-relative)
    } else if (m[0] == wmp.MSG_MOUSE_WHEEL) {
        forward_mouse_wheel(t, m[1], m[2], m[3]); // a=delta, b=x, c=y
    } else if (m[0] == wmp.MSG_KILL_RES && m[3] >= 0 && m[3] < jobs.max_jobs()) {
        // The WM's answer to a kill a job asked for (tag = its slot); the job
        // is waiting on its terminal channel for it.
        let is *jobs.Job as kj = jobs.get(m[3]);
        if (kj.status != jobs.JOB_FREE && kj.tty_fd >= 0) { tty.kill_reply(kj.tty_fd, m[1], m[2]); }
    }
    return;
}

// A job asked its terminal to end a process for the user (ttyproto). One this
// terminal started it ends itself; anything else is the WM's to end, and the
// WM answers on its own time (handle_msg, MSG_KILL_RES).
fn kill_for_job(slot as i64, pid as i64) as void {
    let is *jobs.Job as kj = jobs.get(slot);
    if (sys.kill(pid) == 0) {
        tty.kill_reply(kj.tty_fd, pid, 0);
        return;
    }
    wmp.msg_send(s.WM_FD, wmp.MSG_KILL_REQ, pid, slot, 0);
    return;
}

fn main() as i32 {
    let is [4]i64 as welcome_m;
    let is i64 as got with mut = 0;
    while (got != 1) {
        got = wmp.msg_read(s.WM_FD, &s.cmd_fill, cast(*u8, &s.cmd_acc[0]), &welcome_m[0]);
        if (got < 0) { return 1; }
    }
    if (welcome_m[0] != wmp.MSG_WELCOME) { return 1; }
    let is i64 as win_w = wmp.unpack_w(welcome_m[3]);
    let is i64 as win_h = wmp.unpack_h(welcome_m[3]);

    // The most rows a window on this screen can show: the text segment the
    // compositor reads holds that many, and the ring that many more than the
    // scrollback. The segment used to be as big as the whole ring.
    let is i64 as vis_max = welcome_m[2] / 16 + 1;
    s.seg_cap_cells = s.GRID_STRIDE * vis_max;
    let is i64 as npages with mut = (8 + s.seg_cap_cells) * 8;
    npages = (npages + 4095) / 4096;
    let is i64 as seg = sys.seg_create(npages, 0);
    if (seg < 0) { return 2; }
    let is i64 as va = sys.mmap_fd(sys.PROT_READ | sys.PROT_WRITE, seg);
    if (va < 0) { return 2; }
    s.seg_base = va;
    s.segcells = va + 8 * 8;
    if (sys.fd_send(s.WM_FD, seg) != 0) { return 3; }
    wmp.msg_send(s.WM_FD, wmp.MSG_HELLO, npages, s.GRID_STRIDE * 8,
                 wmp.hello_c(wmp.PROTO_VER, wmp.SURFACE_TEXT));
    cli.set_title(cast(*u8, "wterm"), 5);

    s.grid_rows = s.SCROLLBACK + vis_max;
    let is i64 as gbytes = ((s.GRID_STRIDE * s.grid_rows * 8 + 4095) / 4096) * 4096;
    let is i64 as gva = sys.reserve(0, gbytes, sys.PROT_READ | sys.PROT_WRITE);
    if (gva < 0) { return 2; }
    let is term.Term as t = term.init_text(win_w, win_h);
    if (term.attach_grid_lazy(&t, cast(*i64, gva), s.GRID_STRIDE, s.grid_rows) != 0) { return 2; }
    g._col(&t, s.C_TITLE);
    g.puts(&t, "Caustic Terminal\n");
    g._col(&t, s.C_DIM);
    g.hline(&t, 0xC4, 24); g.puts(&t, "\n");
    g.puts(&t, "'help' for commands, 'exit' to close\n\n");
    g._col(&t, s.C_TEXT);
    g.prompt(&t);
    g.show(&t);

    repl.init(&s.rl);
    sys.mkdir("/var");
    repl.file_load(&s.rl, cast(*u8, "/var/history"));
    jobs.init();
    bi.init();
    // Adopt the endpoint the WM handed down. Not start: the compositor is
    // /init and owns the only netd. Every command typed here gets its own
    // endpoint minted from this one, in shexec.
    if (netsvc.attach_or_start(0) != 0) {
        sys.write_serial(cast(*u8, "wterm: no netd, offline\n"), 24);
    }
    bi.bind_repl(&s.rl);
    // 2 fixed entries (WM channel, exit events), one per running job's output
    // and one per job asking the terminal its size (ttyproto).
    let is [102]i64 as pe;

    while (1 == 1) {
        let is i64 as n with mut = 0;
        // WRITABLE only matters when a commit is waiting for room. Asking for
        // it unconditionally would report ready every pass and spin; asking
        // for it NEVER (which is what this did) meant the deferred commit was
        // tested against a bit the kernel masks out of an unrequested poll —
        // so a commit put off for a full channel was never sent at all.
        let is i64 as wmwant with mut = sys.POLL_READABLE;
        if (s.pend_on == 1) { wmwant = wmwant | sys.POLL_WRITABLE; }
        pe[0] = s.WM_FD; pe[1] = wmwant; pe[2] = 0;
        n = 1;
        let is i64 as ev_e with mut = 0 - 1;
        if (jobs.event_fd() >= 0) {
            pe[n*3+0] = jobs.event_fd(); pe[n*3+1] = sys.POLL_READABLE; pe[n*3+2] = 0;
            ev_e = n; n = n + 1;
        }
        // The job table is sparse, so remember which entry maps to which slot.
        let is [16]i64 as slot_of_entry;
        let is i64 as njp with mut = 0;
        let is i64 as je0 = n;                  // the first job entry
        let is i64 as jj with mut = 0;
        while (jj < jobs.max_jobs()) {
            if (jobs.get(jj).status != jobs.JOB_FREE && jobs.get(jj).out_fd >= 0) {
                pe[n*3+0] = jobs.get(jj).out_fd;
                pe[n*3+1] = sys.POLL_READABLE;
                pe[n*3+2] = 0;
                slot_of_entry[njp] = jj;
                njp = njp + 1;
                n = n + 1;
            }
            jj = jj + 1;
        }
        let is [16]i64 as tty_slot;
        let is i64 as ntp with mut = 0;
        let is i64 as te0 = n;
        jj = 0;
        while (jj < jobs.max_jobs()) {
            if (jobs.get(jj).status != jobs.JOB_FREE && jobs.get(jj).tty_fd >= 0) {
                pe[n*3+0] = jobs.get(jj).tty_fd;
                pe[n*3+1] = sys.POLL_READABLE;
                pe[n*3+2] = 0;
                tty_slot[ntp] = jj;
                ntp = ntp + 1;
                n = n + 1;
            }
            jj = jj + 1;
        }
        // Block until something arrives. This asked for a timeout of ZERO —
        // never blocking — so the terminal spun a whole core forever whether
        // or not anything was happening (measured: 95% with one process
        // printing once a second). Nothing in this loop is periodic: keys
        // arrive on the WM channel, output on a job's fd, exits on the event
        // fd, and all three wake a blocked poll.
        // A close waiting on its jobs needs waking when the wait is over.
        let is i64 as ptmo with mut = 0 - 1;
        if (s.close_wait_until > 0) {
            ptmo = s.close_wait_until - sys.time_ns();
            if (ptmo < 0) { ptmo = 0; }
        }
        sys.poll(&pe[0], n, ptmo);

        let is i64 as pk with mut = 0;
        while (pk < njp) {
            if ((pe[(je0 + pk)*3+2] & sys.POLL_READABLE) != 0) { cli.pump_job(&t, slot_of_entry[pk]); }
            pk = pk + 1;
        }
        // A job asking how big the terminal is waits for the answer.
        pk = 0;
        while (pk < ntp) {
            if ((pe[(te0 + pk)*3+2] & (sys.POLL_READABLE | sys.POLL_CLOSED)) != 0) {
                let is *jobs.Job as tj = jobs.get(tty_slot[pk]);
                let is i64 as kp with mut = 0;
                let is i64 as ar = tty.answer(tj.tty_fd, &tj.tty_fill, jobs.tty_acc(tty_slot[pk]), t.cols, t.rows, &tj.tty_catch, &kp);
                if (ar < 0) { sys.close(tj.tty_fd); tj.tty_fd = 0 - 1; }
                else if (ar == 1) { kill_for_job(tty_slot[pk], kp); }
            }
            pk = pk + 1;
        }
        if (ev_e >= 0 && (pe[ev_e*3+2] & sys.POLL_READABLE) != 0) { jobs.poll_events(); }
        jj = 0;
        while (jj < jobs.max_jobs()) {
            if (jobs.get(jj).status == jobs.JOB_DONE) { finish_job(&t, jj); }
            jj = jj + 1;
        }
        close_check();

        // What the WM sent while a kill waited on its answer, first, in order.
        let is [4]i64 as hm;
        while (cli.unhold(&hm[0]) == 1) {
            if (hm[0] == wmp.MSG_KEY) { handle_key(&t, hm[1], hm[2], hm[3]); }
            else { handle_msg(&t, &hm[0]); }
        }
        if ((pe[0*3+2] & sys.POLL_READABLE) != 0) {
            let is [4]i64 as m;
            let is i64 as r2 = wmp.msg_read(s.WM_FD, &s.cmd_fill, cast(*u8, &s.cmd_acc[0]), &m[0]);
            if (r2 < 0) { return 0; }
            if (r2 == 1) {
                if (m[0] == wmp.MSG_KEY) {
                    handle_key(&t, m[1], m[2], m[3]);
                } else {
                    handle_msg(&t, &m[0]);
                }
            }
        }

        if (s.pend_on == 1 && (pe[0*3+2] & sys.POLL_WRITABLE) != 0) {
            let is i64 as nrows = s.pend_r1 - s.pend_r0;
            // a=row0, b=0 — the protocol's text form (wmproto.cst). This sent
            // the row in `b` and zero in `a`, so the window manager, reading
            // a as the first dirty row, damaged the TOP of the window every
            // time however far down the change actually was. Output near the
            // top redrew and output anywhere else did not, which is exactly
            // what "sometimes it doesn't render" looks like.
            wmp.msg_send(s.WM_FD, wmp.MSG_COMMIT, s.pend_r0, 0,
                         wmp.pack_wh(nrows, 0));
            s.pend_on = 0;
        }
    }
    return 0;
}
