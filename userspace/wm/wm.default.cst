# /etc/wm.cst — the window manager's shipped defaults.
#
# This file is read first; /var/wm/config.cst is read after it and overrides
# key by key, so a personal config only carries what it changes. Both are
# optional: with neither present the WM behaves exactly as this file describes,
# because these ARE the compiled defaults written out.
#
# Editing either file applies it — the mtime is checked once a second and a
# change is reloaded. There is no reload command because there is no daemon to
# send one to.

# ---- metrics (pixels) -----------------------------------------------------
title_h 20
border  1
bar_h   26
btn_w   24
task_w  150
snap    12
min_w   160
min_h   64

# ---- palette (RGB hex) ----------------------------------------------------
color border_focus    73d0ff
color border_unfocus  3a4048
color title_focus     2a3a4a
color title_unfocus   1c2228
color text            d3d7cf
color close_hover     c84040
color max_hover       c8a020
color min_hover       5a6570
color bar             161b21
color bar_item        262f38
color bar_dim         8a909a
color desktop         202830

# ---- desktop --------------------------------------------------------------
# solid | image. The image (a CSIF on disk, or the generated gradient when
# there is none) drifts once a second and slides with the pointer, and each of
# those is a full-screen recompose. Solid is flat COL_DESKTOP and costs nothing.
wallpaper solid

# ---- layout ---------------------------------------------------------------
# tile | monocle | float. Each tag remembers its own; this is what they start
# on. mfact is the master column as a percentage of the screen.
layout  float
mfact   55
nmaster 1

# ---- rules ----------------------------------------------------------------
# float <name>: that program's windows start outside the layout.
# swallow <name>: it takes over the window of whatever asked for it, instead
#   of opening beside it, and gives the place back when it closes.
float launcher.cse

# ---- keys -----------------------------------------------------------------
# bind <mods> <key> <action> [arg]. Modifiers: super, alt, shift, ctrl, joined
# with '+'. Keys are physical, so a different keymap moves the letters and not
# the shortcuts.
bind super       enter  spawn_term
bind super       space  launcher
bind super       q      close
bind alt         tab    cycle
bind alt+shift   tab    cycle_back
bind super       t      layout_next
bind super       f      toggle_float
bind super       z      zoom
bind super       grave  scratchpad
bind super+shift grave  scratch_send
bind super       i      inc_master 1
bind super       d      inc_master -1
bind super       h      mfact -5
bind super       l      mfact 5
bind super       j      focus_next
bind super       k      focus_prev
bind super       minus  minimize
bind super       equal  maximize
bind super       0      view_all
bind super+shift q      quit

bind super       1      view 1
bind super       2      view 2
bind super       3      view 3
bind super       4      view 4
bind super       5      view 5
bind super       6      view 6
bind super       7      view 7
bind super       8      view 8
bind super       9      view 9
bind super+shift 1      tag 1
bind super+shift 2      tag 2
bind super+shift 3      tag 3
bind super+shift 4      tag 4
bind super+shift 5      tag 5
bind super+shift 6      tag 6
bind super+shift 7      tag 7
bind super+shift 8      tag 8
bind super+shift 9      tag 9
bind super+ctrl  1      toggle_view 1
bind super+ctrl  2      toggle_view 2
bind super+ctrl  3      toggle_view 3
bind super+ctrl  4      toggle_view 4
bind super+ctrl  5      toggle_view 5
bind super+ctrl  6      toggle_view 6
bind super+ctrl  7      toggle_view 7
bind super+ctrl  8      toggle_view 8
bind super+ctrl  9      toggle_view 9
