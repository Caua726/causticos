// compositor/comp_fx.cst — the compositor's own effects: the ones it decides
// for itself, with no policy from the WM. The cursor shimmer, the night-light
// LUT, wallpaper parallax and drift, and the screen-edge pulse on focus.
//
// Each owns its damage. The frame loop calls tick() once, before composing.
use "comp_state.cst" as s;
use "comp_damage.cst" as dmg;
use "comp_wallpaper.cst" as wp;
use "../lib/anim/anim.cst" as anim;
use "../lib/anim/bezier.cst" as bez;
use "std/os/causticos.cst" as sys;

let is i64 as CUR_PHASE_NS with imut = 250000000;   // 4 Hz
let is i64 as EDGE_MS      with imut = 800;
let is i64 as EDGE_PX      with imut = 2;

// build_gamma — temp 0 (daylight, neutral) .. 100 (warmest). Red is left alone
// and green/blue are pulled down, which is what a colour-temperature shift is
// on a display that cannot change its backlight.
fn build_gamma(temp as i64) as void {
    let is i64 as gs = 256 - temp * 30 / 100;
    let is i64 as bs = 256 - temp * 90 / 100;
    let is i64 as i with mut = 0;
    while (i < 256) {
        s.gam_lut[i] = i;
        s.gam_lut[256 + i] = i * gs / 256;
        s.gam_lut[512 + i] = i * bs / 256;
        i = i + 1;
    }
    s.gam_on = 1;
    return;
}

// Rebuild only when the hour bucket changes; before the RTC answers, gam_on
// stays 0 and nothing is tinted.
fn gamma_for_time() as void {
    let is [6]i64 as t;
    if (sys.time_wall(cast(*i64, &t[0])) != 0) { return; }
    let is i64 as h = t[3];
    if (h == s.gam_hour) { return; }
    s.gam_hour = h;
    let is i64 as temp with mut = 60;
    if (h >= 7 && h < 19) { temp = 8; }
    else if (h >= 19 && h < 22) { temp = 45; }
    build_gamma(temp);
    dmg.damage_all();
    return;
}

// focus_pulse — a window took focus: flash the screen edge and let it fade.
fn focus_pulse(now as i64) as void {
    s.edge_anim = anim.start_new(now, 255, 0, EDGE_MS, bez.EASE_OUT, 0);
    return;
}

fn edge_alpha() as i64 {
    if (s.edge_anim == anim.NONE) { return 0; }
    if (anim.active(s.edge_anim) == 0) { return 0; }
    return anim.value(s.edge_anim);
}

fn damage_edges() as void {
    dmg.damage(0, 0, s.scr_w, EDGE_PX);
    dmg.damage(0, s.scr_h - EDGE_PX, s.scr_w, EDGE_PX);
    dmg.damage(0, 0, EDGE_PX, s.scr_h);
    dmg.damage(s.scr_w - EDGE_PX, 0, EDGE_PX, s.scr_h);
    return;
}

fn tick(now as i64) as void {
    s.anim_live = anim.tick_all(now);

    if (now - s.cur_phase_ns >= CUR_PHASE_NS) {
        s.cur_phase_ns = now;
        s.cur_phase = s.cur_phase + 1;
        if (s.cur_phase > 2) { s.cur_phase = 0; }
        dmg.damage(s.mx - 13, s.my - 13, 28, 32);
    }

    gamma_for_time();
    if (wp.wp_parallax() == 1) { dmg.damage_all(); }
    if (wp.wp_anim_tick(now) == 1) { dmg.damage_all(); }
    if (s.edge_anim != anim.NONE) {
        damage_edges();
        if (anim.active(s.edge_anim) == 0) { s.edge_anim = anim.NONE; }
    }
    return;
}
