// wm/client.cst — client lifecycle + per-client message handling. Loads the
// spawned image, wires up its end of the WM channel, and drains per-window
// messages (HELLO/COMMIT/SET_TITLE/CLOSE/SPAWN_*).

use "state.cst" as s;
use "window.cst" as win;
use "damage.cst" as dmg;
use "wanim.cst" as wan;
use "config.cst" as cfg;
use "persist.cst" as pst;
use "decoration.cst" as dec;
use "clipboard.cst" as clip;
use "../lib/crash/crash.cst" as crash;
use "../lib/wmproto/wmproto.cst" as wmp;
use "../lib/compo_proto/compo_proto.cst" as cp;
use "../lib/netproto/netproto.cst" as np;
use "../lib/netcli/netsvc.cst" as netsvc;
use "../lib/sndcli/sndcli.cst" as sndcli;
use "../lib/sndproto/sndproto.cst" as sp;
use "std/os/causticos.cst" as sys;

// The WM used to slurp wterm.cse into its own memory at startup and hand those
// bytes to every spawn — the right optimisation when a spawn carried an image,
// since it read the file once instead of once per window. A spawn names its
// source now, so the kernel's image cache does that job and does it better:
// every wterm maps the SAME frames for its text instead of getting a copy.

// Settle on the program a bare "new window" runs. Tries each candidate in turn
// and keeps the first that is actually on the volume. Returns 0 on success.
fn pick_client_image(path as *u8, plen as i64) as i64 {
    let is [4]i64 as st;
    if (sys.stat(path, cast(*u8, &st[0])) != 0) { return 0 - 1; }
    if (st[3] != 0 || st[0] <= 0) { return 0 - 1; }
    let is i64 as k with mut = 0;
    while (k < plen && k < 39) { s.client_path[k] = path[k]; k = k + 1; }
    s.client_path[k] = cast(u8, 0);
    s.client_path_len = k;
    return 0;
}

fn spawn_client_path(cpath as *u8, cname as *u8, cnlen as i64,
                     swal_from as i64, run as *u8, run_len as i64) as void {
    let is i64 as i = win.win_alloc();
    if (i < 0) {
        sys.write_serial(cast(*u8, "wm: window table full\n"), 22);
        return;
    }
    let is [2]i64 as chans;
    if (sys.channel_create(&chans[0]) != 0) { return; }
    let is i64 as a = chans[0];
    let is i64 as b = chans[1];
    let is [2]i64 as nm;
    let is i64 as nlen with mut = cnlen;
    if (nlen > 16) { nlen = 16; }
    wmp.title_pack(cname, nlen, &nm[0], &nm[1]);

    // room for an 80x24 terminal, the size programs are written for
    let is i64 as w with mut = 80 * 8 + 2 * wmp.TXT_PAD;
    let is i64 as h with mut = 24 * 16 + 2 * wmp.TXT_PAD;
    if (w > s.scr_w - 80) { w = s.scr_w - 80; }
    if (h > s.scr_h - 80) { h = s.scr_h - 80; }
    if (w < s.MIN_W) { w = s.MIN_W; }
    if (h < s.MIN_H) { h = s.MIN_H; }
    let is i64 as px with mut = 40 + (i % 8) * 32;
    let is i64 as py with mut = 40 + (i % 8) * 32;
    if (px + w + 2 > s.scr_w) { px = 16; }
    if (py + h + s.TITLE_H + 2 > s.scr_h) { py = 16; }

    // Where this window belongs: on the tags in view, floating if a rule says
    // so, and on the scratchpad tag when it is the scratchpad being opened.
    let is i64 as tags with mut = s.sel_tags & (s.TAG_MASK | s.SCRATCH_TAG);
    if (tags == 0) { tags = 1; }
    let is i64 as flt with mut = cfg.float_rule(nm[0], nm[1], nlen);
    if (s.scratch_wait == 1) {
        tags = s.SCRATCH_TAG;
        flt = 1;
        w = s.scr_w * 3 / 5; h = s.work_h / 2;
        px = (s.scr_w - w) / 2; py = 0;
    }
    // A saved layout, if this program left one behind, decides the rest.
    pst.restore_for(nm[0], nm[1], nlen, &px, &py, &w, &h, &tags, &flt);
    // Swallowing: the new window takes the placeholder's place literally —
    // same rect, same tags, same layer — so the screen does not move under
    // the user just because a program launched another one.
    if (swal_from >= 0 && win.win_mapped(swal_from) == 1) {
        px = s.wins[swal_from].x; py = s.wins[swal_from].y;
        w = s.wins[swal_from].w;  h = s.wins[swal_from].h;
        tags = s.wins[swal_from].tags;
        flt = s.wins[swal_from].floating;
    }
    if (w < s.MIN_W) { w = s.MIN_W; }
    if (h < s.MIN_H) { h = s.MIN_H; }
    wmp.msg_send(a, wmp.MSG_WELCOME, s.scr_w, s.scr_h, wmp.pack_wh(w, h));
    let is [6]i64 as acts;
    acts[0] = wmp.WM_FD;
    acts[1] = b;
    let is i64 as nact with mut = 1;
    // Its own netd endpoint, so a terminal opened here can reach the network
    // and hand endpoints on to what IT spawns. The WM never starts netd — the
    // compositor did, and passed this one down.
    let is i64 as net_c with mut = netsvc.endpoint();
    if (net_c >= 0) {
        acts[nact*2] = np.NET_FD; acts[nact*2+1] = net_c;
        nact = nact + 1;
    }
    // And the mixer: a terminal hands it on to what runs in it, so `aplay`
    // in a window plays alongside everything else instead of taking the
    // converter for itself.
    let is i64 as snd_c with mut = sndcli.endpoint();
    if (snd_c >= 0) {
        acts[nact*2] = sp.SND_FD; acts[nact*2+1] = snd_c;
        nact = nact + 1;
    }
    // argv: the name, and for a terminal opened to run a program, the
    // command it runs first.
    let is [4]i64 as av;
    av[0] = cast(i64, cname); av[1] = cnlen;
    let is i64 as ac with mut = 1;
    if (run_len > 0) { av[2] = cast(i64, run); av[3] = run_len; ac = 2; }
    let is i64 as pid = sys.spawn_path(cpath,
                                       cast(*u8, &acts[0]), nact, cast(*u8, &av[0]), ac);
    sys.close(b);
    if (net_c >= 0) { sys.close(net_c); }
    if (snd_c >= 0) { sys.close(snd_c); }
    if (pid < 0) {
        sys.close(a);
        return;
    }
    s.wins[i].used = 1;
    s.wins[i].state = 1;
    s.wins[i].chan = a;
    s.wins[i].pid = pid;
    s.wins[i].seg_fd = 0;
    s.wins[i].seg_base = 0;
    s.wins[i].seg_pages = 0;
    s.wins[i].seg_stride = 0;
    s.wins[i].x = px; s.wins[i].y = py; s.wins[i].w = w; s.wins[i].h = h;
    s.wins[i].title_len = 0; s.wins[i].t0 = 0; s.wins[i].t1 = 0;
    s.wins[i].name_len = nlen; s.wins[i].n0 = nm[0]; s.wins[i].n1 = nm[1];
    s.wins[i].tags = tags;
    s.wins[i].floating = flt;
    s.wins[i].swallowed_by = 0 - 1;
    s.wins[i].swallowing = 0 - 1;
    s.wins[i].drops = 0;
    s.outq_head[i] = 0;
    s.outq_n[i] = 0;
    s.wins[i].pend_resize_w = 0; s.wins[i].pend_resize_h = 0;
    s.wins[i].pend_focus = 0 - 1;
    s.wins[i].pend_close = 0;
    s.wins[i].pend_move = 0;
    s.wins[i].pointer_track = 0;
    s.wins[i].pend_clip = 0 - 1;
    s.wins[i].hello_deadline = sys.time_ns() + s.HELLO_NS;
    s.wins[i].surf_pend = 0;
    s.wins[i].surf_fd = 0;
    s.wins[i].mb_fill = 0;
    s.wins[i].maximized = 0;
    s.wins[i].minimized = 0;
    s.wins[i].is_text = 0;
    s.wins[i].dec_fd = 0;
    s.wins[i].dec_base = 0;
    s.wins[i].dec_pages = 0;
    s.wins[i].dec_attached = 0;
    wan.init_win(i);
    win.tord_add(i);
    if (s.scratch_wait == 1) { s.scratch_win = i; s.scratch_wait = 0; }
    if (swal_from >= 0 && win.win_mapped(swal_from) == 1) {
        s.wins[i].swallowing = swal_from;
        s.wins[swal_from].swallowed_by = i;
        dmg.dmg_frame(swal_from);
    }
    s.arrange_dirty = 1;
    s.layout_dirty = 1;
    win.win_focus(i);
    return;
}

fn spawn_client() as void {
    if (s.client_path_len == 0) { return; }
    spawn_client_path(cast(*u8, &s.client_path[0]), cast(*u8, "wterm"), 5, 0 - 1, cast(*u8, 0), 0);
    return;
}

// CSE image flags byte (docs/CSE_FORMAT.md): bit1 says the program opens its
// own window — set by `caustic --window`. Everything else writes to a
// terminal, and started as a window it would have nothing to show and no way
// to be stopped.
let is i64 as CSE_F_WINDOW with imut = 2;
let is i64 as CSE_ARCH_NATIVE with imut = 1 * __target_is_x86_64 + 2 * __target_is_aarch64;

fn _read_at(fd as i64, off as i64, buf as *u8, n as i64) as i64 {
    if (sys.lseek(fd, off, cast(i32, sys.SEEK_SET)) != off) { return 0 - 1; }
    return sys.read(fd, buf, n);
}

fn _is_cst(h as *u8) as i64 {
    if (h[0] == cast(u8, 67) && h[1] == cast(u8, 83) && h[2] == cast(u8, 84) && h[3] == cast(u8, 95)) { return 1; }  // "CST_"
    return 0;
}

// The flags byte of the image this machine would run from `path`, or -1. The
// same walk the kernel's loader makes, header bytes only: a polyglot .cse.exe
// ("MZ") names its CST body's offset, in ASCII, in the "CST*" mini-header at
// 0x40; a v3.1 container indexes one image per architecture ({arch u8, pad,
// offset u32} from the u32 at 0x08); an image carries the flags at 0x07.
fn image_flags(path as *u8) as i64 {
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { return 0 - 1; }
    let is [16]u8 as h;
    let is i64 as base with mut = 0;
    let is i64 as rc with mut = 0 - 1;
    if (_read_at(fd, 0, cast(*u8, &h[0]), 16) == 16) {
        if (h[0] == cast(u8, 77) && h[1] == cast(u8, 90)) {                    // "MZ"
            let is [12]u8 as num;
            base = 0 - 1;
            if (_read_at(fd, 0x48, cast(*u8, &num[0]), 12) == 12) {
                base = 0;
                let is i64 as k with mut = 0;
                while (k < 12 && num[k] >= cast(u8, 48) && num[k] <= cast(u8, 57)) {
                    base = base * 10 + cast(i64, num[k]) - 48;
                    k = k + 1;
                }
                if (k == 0) { base = 0 - 1; }
            }
            if (base < 0 || _read_at(fd, base, cast(*u8, &h[0]), 16) != 16) { base = 0 - 1; }
        }
        if (base >= 0 && _is_cst(cast(*u8, &h[0])) == 1) {
            if (h[4] == cast(u8, 3) && h[5] == cast(u8, 1)) {                  // v3.1 container
                let is i64 as count = cast(i64, h[6]);
                let is i64 as index_off = cast(i64, h[8]) | (cast(i64, h[9]) << 8)
                                        | (cast(i64, h[10]) << 16) | (cast(i64, h[11]) << 24);
                let is i64 as picked with mut = 0 - 1;
                let is i64 as k with mut = 0;
                while (k < count && k < 8 && picked < 0) {
                    let is [8]u8 as e;
                    if (_read_at(fd, base + index_off + k * 8, cast(*u8, &e[0]), 8) == 8
                        && cast(i64, e[0]) == CSE_ARCH_NATIVE) {
                        picked = cast(i64, e[4]) | (cast(i64, e[5]) << 8)
                               | (cast(i64, e[6]) << 16) | (cast(i64, e[7]) << 24);
                    }
                    k = k + 1;
                }
                if (picked >= 0 && _read_at(fd, base + picked, cast(*u8, &h[0]), 16) == 16
                    && _is_cst(cast(*u8, &h[0])) == 1) { rc = cast(i64, h[7]); }
            } else {
                rc = cast(i64, h[7]);
            }
        }
    }
    sys.close(fd);
    return rc;
}

fn opens_window(path as *u8) as i64 {
    let is i64 as f = image_flags(path);
    if (f >= 0 && (f & CSE_F_WINDOW) != 0) { return 1; }
    return 0;
}

// spawn_named — run a program by name: as a window if it opens one, else in a
// new terminal that runs it and stays open at the prompt — a terminal program
// started as a window had nothing to show, and was killed for never opening
// one. `from` is the window that asked (or -1): a program the config marks
// `swallow` takes that window's place instead of opening beside it.
fn spawn_named_from(from as i64, name as *u8, nlen as i64) as void {
    // The directory ABI has 255 filename bytes; allow all of them without
    // shortening the path. The VFS decides whether the whole path is valid.
    if (nlen <= 0 || nlen > 255) { return; }
    let is [257]u8 as path;
    path[0] = cast(u8, 47);
    let is i64 as k with mut = 0;
    while (k < nlen) { path[1 + k] = name[k]; k = k + 1; }
    path[1 + nlen] = cast(u8, 0);
    let is i64 as swal with mut = 0 - 1;
    if (from >= 0) {
        let is [2]i64 as nm;
        let is i64 as nl with mut = nlen;
        if (nl > 16) { nl = 16; }
        wmp.title_pack(name, nl, &nm[0], &nm[1]);
        if (cfg.swallow_rule(nm[0], nm[1], nl) == 1) { swal = from; }
    }
    let is [4]i64 as tst;
    let is i64 as have_term with mut = 0;
    if (sys.stat(cast(*u8, "/wterm.cse"), cast(*u8, &tst[0])) == 0 && tst[3] == 0) { have_term = 1; }
    if (opens_window(cast(*u8, &path[0])) == 1 || have_term == 0) {
        spawn_client_path(cast(*u8, &path[0]), name, nlen, swal, cast(*u8, 0), 0);
        return;
    }
    // A terminal receives the literal image path, never shell source. Spaces,
    // quotes, dollar signs and long names cannot change which program starts.
    spawn_client_path(cast(*u8, "/wterm.cse"), cast(*u8, "wterm"), 5, swal,
                      cast(*u8, &path[0]), nlen + 1);
    return;
}

fn spawn_named(name as *u8, nlen as i64) as void {
    spawn_named_from(0 - 1, name, nlen);
    return;
}

// reap_window — start a window going away. A mapped window fades out first and
// is torn down when the tween ends (reap_window_final, via the anim's
// completion callback); everything else tears down at once. The fade needs the
// window to stay drawable, which it is: its content segment is still mapped in
// the compositor and its frame is still in the scene.
//
// Focus moves on immediately — the user should not wait out an animation to
// type into the next window — and `closing` takes the fading window out of
// hit-testing, the taskbar and its own message pump.
fn reap_window(i as i64, do_wait as i64) as void {
    if (s.wins[i].used == 0) { return; }
    if (s.wins[i].closing == 1) { return; }
    if (s.wins[i].state == 2 && s.wins[i].minimized == 0) {
        s.wins[i].close_wait = do_wait;
        if (wan.close_start(i, sys.time_ns(), cast(i64, fn_ptr(reap_window_deferred))) == 1) {
            if (s.drag_mode != 0 && s.drag_win == i) { s.drag_mode = 0; }
            unswallow(i);
            if (s.focused == i) { win.win_focus_fallback(i); }
            dmg.dmg_taskbar();
            s.scene_dirty = 1;
            s.deco_dirty = 1;
            return;
        }
        // Pool full — never strand a window half-closed.
        s.wins[i].closing = 0;
    }
    reap_window_final(i, do_wait);
    return;
}

// unswallow — a window that displaced another is going away: give the
// placeholder its place back. Done when the close STARTS, not when the fade
// ends, so the window underneath reappears as the one above it dissolves.
fn unswallow(i as i64) as void {
    let is i64 as ph = s.wins[i].swallowing;
    s.wins[i].swallowing = 0 - 1;
    if (ph < 0 || ph >= s.MAX_WIN) { return; }
    if (s.wins[ph].used == 0 || s.wins[ph].swallowed_by != i) { return; }
    s.wins[ph].swallowed_by = 0 - 1;
    if (win.win_mapped(ph) == 1) {
        win.win_set_geom(ph, s.wins[i].x, s.wins[i].y, s.wins[i].w, s.wins[i].h);
        win.win_focus(ph);
    }
    s.arrange_dirty = 1;
    s.scene_dirty = 1;
    s.deco_dirty = 1;
    dmg.dmg_frame(ph);
    dmg.dmg_taskbar();
    return;
}

// The anim completion callback: one arg, the window index.
fn reap_window_deferred(i as i64) as void {
    if (i < 0 || i >= s.MAX_WIN) { return; }
    if (s.wins[i].used == 0) { return; }
    reap_window_final(i, s.wins[i].close_wait);
    return;
}

// Tear a window down for real. do_wait = the client exited (reap the zombie);
// do_wait = 0 → the client is wedged, force-kill it (the spawn key is the
// kill authority).
fn reap_window_final(i as i64, do_wait as i64) as void {
    if (s.wins[i].state == 2) {
        cp.msg_send(s.wc_fd, cp.MSG_WC_DETACH_SURFACE, i, 0, 0);
    }
    if (s.wins[i].surf_pend == 1) {
        sys.close(s.wins[i].surf_fd);
        s.wins[i].surf_pend = 0;
    }
    if (s.wins[i].dec_fd != 0) {
        cp.msg_send(s.wc_fd, cp.MSG_WC_DEC_DETACH, i, 0, 0);
        sys.munmap(s.wins[i].dec_base, s.wins[i].dec_pages * 4096);
        sys.close(s.wins[i].dec_fd);
        s.wins[i].dec_fd = 0;
        s.wins[i].dec_base = 0;
        s.wins[i].dec_attached = 0;
    }
    sys.close(s.wins[i].chan);
    if (s.ptr_grab == i) { s.ptr_grab = 0 - 1; }
    unswallow(i);
    // A window this one was standing in for outlives it as an ordinary
    // window: the placeholder is gone, so nothing is waiting to come back.
    let is i64 as host = s.wins[i].swallowed_by;
    if (host >= 0 && host < s.MAX_WIN && s.wins[host].swallowing == i) {
        s.wins[host].swallowing = 0 - 1;
    }
    s.wins[i].swallowed_by = 0 - 1;
    win.win_zremove(i);
    win.tord_remove(i);
    if (s.scratch_win == i) { s.scratch_win = 0 - 1; }
    dmg.dmg_frame(i);
    dmg.dmg_taskbar();
    s.scene_dirty = 1;
    s.deco_dirty = 1;
    s.arrange_dirty = 1;
    s.layout_dirty = 1;
    s.wins[i].used = 0;
    s.wins[i].state = 0;
    s.wins[i].closing = 0;
    if (do_wait == 1) {
        // The taskbar says why a window vanished rather than leaving it to guess.
        let is [8]i64 as wi;
        if (sys.wait_info(s.wins[i].pid, cast(*i64, &wi[0])) >= 0) {
            let is [2]i64 as launcher_name;
            wmp.title_pack(cast(*u8, "launcher.cse"), 12, &launcher_name[0], &launcher_name[1]);
            if (wi[1] == 0 && wi[0] == 2 && s.wins[i].name_len == 12
                && s.wins[i].n0 == launcher_name[0] && s.wins[i].n1 == launcher_name[1]) {
                // Exit code 2 means the launcher could not allocate or map its surface.
                dec.notice("Launcher: not enough memory", 27, 10000000000);
            } else {
                let is [80]u8 as cb;
                let is i64 as cn = crash.describe(cast(*i64, &wi[0]), cast(*u8, &cb[0]), 80);
                if (cn > 0) { dec.notice(cast(*u8, &cb[0]), cn, 10000000000); }
            }
        }
    } else {
        let is i64 as krc = sys.kill(s.wins[i].pid);
        if (krc == 0) {
            let is i64 as st2 with mut = 0;
            sys.wait(s.wins[i].pid, &st2);
        }
    }
    if (s.focused == i) { win.win_focus_fallback(i); }
    return;
}

// surface_handoff — pass window i's surface to the compositor; the window goes
// on screen with it. The WM channel to the compositor carries one fd at a time,
// and the one before (another window's surface, a decoration) may not have
// been taken yet — the compositor can be in the middle of a frame. Then this
// is tried again on the next pass of the loop, never waited for.
//
// It used to be waited for, up to a thousand times with a 200 us "sleep" in
// between — a poll of no entries, which the kernel refuses at once. The
// thousand tries took a millisecond or two, and a window whose surface met a
// busy slot was killed: the launcher, on about one boot in twenty.
fn surface_handoff(i as i64) as void {
    let is i64 as fr = sys.fd_send(s.wc_fd, s.wins[i].surf_fd);
    if (fr == sys.E_AGAIN) { s.surf_waiting = 1; return; }
    sys.close(s.wins[i].surf_fd);
    s.wins[i].surf_pend = 0;
    if (fr != 0) {
        wmp.log_kv(cast(*u8, "wm: closed: surface not handed over rc="), 39, fr);
        reap_window(i, 0);
        return;
    }
    cp.msg_send(s.wc_fd, cp.MSG_WC_ATTACH_SURFACE, i, s.wins[i].seg_pages,
                 (s.wins[i].is_text & 1) | ((s.wins[i].seg_stride & 0xFFFFFFFF) << 32));
    s.wins[i].seg_fd = 0;
    s.wins[i].seg_base = 0;
    s.wins[i].state = 2;
    // The window becomes visible exactly here — its surface just arrived —
    // so this is where it grows and fades in.
    wan.open_start(i, sys.time_ns());
    wan.task_start(i, sys.time_ns());
    dmg.dmg_frame(i);
    dmg.dmg_taskbar();
    s.scene_dirty = 1;
    s.deco_dirty = 1;
    // It only joins the layout now: a window with no surface has nothing
    // to show in a column.
    s.arrange_dirty = 1;
    s.layout_dirty = 1;
    return;
}

// surface_handoffs — one more try for every surface still waiting, each pass.
// Leaves s.surf_waiting set while any is, so the loop keeps the frame clock.
fn surface_handoffs() as void {
    let is i64 as waiting with mut = 0;
    let is i64 as i with mut = 0;
    while (i < s.MAX_WIN) {
        if (s.wins[i].used == 1 && s.wins[i].state == 1 && s.wins[i].surf_pend == 1) {
            surface_handoff(i);
            if (s.wins[i].used == 1 && s.wins[i].surf_pend == 1) { waiting = 1; }
        }
        i = i + 1;
    }
    s.surf_waiting = waiting;
    return;
}

fn handle_msg(i as i64, m as *i64) as void {
    if (m[0] == wmp.MSG_HELLO && s.wins[i].state == 1 && s.wins[i].surf_pend == 0) {
        let is i64 as seg = sys.fd_recv(s.wins[i].chan);
        if (seg < 0) {
            wmp.log_kv(cast(*u8, "wm: closed: HELLO had no surface rc="), 36, seg);
            reap_window(i, 0);
            return;
        }
        s.wins[i].is_text = 0;
        if (wmp.hello_kind(m[3]) == wmp.SURFACE_TEXT) { s.wins[i].is_text = 1; }
        s.wins[i].seg_pages = m[1];
        s.wins[i].seg_stride = m[2];
        s.wins[i].surf_fd = seg;
        s.wins[i].surf_pend = 1;
        surface_handoff(i);
    } else if (m[0] == wmp.MSG_COMMIT) {
        if (s.wins[i].state != 2) { return; }
        if (s.wins[i].is_text == 1) {
            let is i64 as row0 with mut = m[1];
            let is i64 as nrows with mut = wmp.unpack_w(m[3]);
            if (row0 < 0) { nrows = nrows + row0; row0 = 0; }
            let is i64 as py0 = wmp.TXT_PAD + row0 * 16;     // the grid is inset
            let is i64 as ph with mut = nrows * 16;
            if (py0 + ph > s.wins[i].h) { ph = s.wins[i].h - py0; }
            if (ph > 0 && py0 < s.wins[i].h) {
                dmg.dmg_add(s.wins[i].x + s.BORDER, s.wins[i].y + s.BORDER + s.TITLE_H + py0,
                          s.wins[i].w, ph);
            }
            return;
        }
        let is i64 as cx with mut = m[1];
        let is i64 as cy with mut = m[2];
        let is i64 as cw with mut = wmp.unpack_w(m[3]);
        let is i64 as ch with mut = wmp.unpack_h(m[3]);
        if (cx < 0) { cw = cw + cx; cx = 0; }
        if (cy < 0) { ch = ch + cy; cy = 0; }
        if (cx + cw > s.wins[i].w) { cw = s.wins[i].w - cx; }
        if (cy + ch > s.wins[i].h) { ch = s.wins[i].h - cy; }
        if (cw > 0 && ch > 0) {
            dmg.dmg_add(s.wins[i].x + s.BORDER + cx, s.wins[i].y + s.BORDER + s.TITLE_H + cy, cw, ch);
        }
    } else if (m[0] == wmp.MSG_SET_TITLE) {
        s.wins[i].title_len = m[1];
        if (s.wins[i].title_len > 16) { s.wins[i].title_len = 16; }
        s.wins[i].t0 = m[2];
        s.wins[i].t1 = m[3];
        dmg.dmg_add(s.wins[i].x, s.wins[i].y, s.wins[i].w + 2 * s.BORDER, s.TITLE_H + s.BORDER);
        dmg.dmg_taskbar();
        s.deco_dirty = 1;
    } else if (m[0] == wmp.MSG_CLOSE) {
        reap_window(i, 1);
    } else if (m[0] == wmp.MSG_SPAWN_REQ) {
        spawn_client();
    } else if (m[0] == wmp.MSG_SPAWN_NAMED) {
        let is i64 as fd = sys.fd_recv(s.wins[i].chan);
        if (fd >= 0) {
            let is [256]u8 as name;
            if (m[1] > 0 && m[1] <= 255
                && sys.seg_read(fd, 0, cast(*u8, &name[0]), m[1]) >= 0) {
                name[m[1]] = cast(u8, 0);
                spawn_named_from(i, cast(*u8, &name[0]), m[1]);
            }
            sys.close(fd);
        }
    } else if (m[0] == wmp.MSG_POINTER_TRACK) {
        s.wins[i].pointer_track = m[1] == 1;
        if (s.wins[i].pointer_track == 1) { s.wins[i].pend_move = 1; }
    } else if (m[0] == wmp.MSG_KILL_REQ) {
        // A process ended for the user, asked by a window that could not end
        // it itself. The kernel holds the line: only what the WM started,
        // directly or not, can go.
        let is i64 as krc = sys.kill(m[1]);
        wmp.log_kv(cast(*u8, "wm: kill for the user, pid="), 27, m[1]);
        queue_msg(i, wmp.MSG_KILL_RES, m[1], krc, m[2]);
    } else if (m[0] == wmp.MSG_CLIP_SET) {
        clip.set_from(i, m[1]);
    } else if (m[0] == wmp.MSG_CLIP_GET) {
        clip.get_for(i);
    }
    return;
}

fn service_win(i as i64, got as i64) as void {
    let is i64 as g with mut = got;
    let is [4]i64 as m;
    let is i64 as guard with mut = 0;
    while ((g & sys.POLL_READABLE) != 0) {
        let is i64 as r = wmp.msg_read(s.wins[i].chan, &s.wins[i].mb_fill,
                                       cast(*u8, cast(i64, &s.mbufs[0]) + i * 32), &m[0]);
        if (r < 0) { reap_window(i, 1); return; }
        if (r == 1) {
            handle_msg(i, &m[0]);
            if (s.wins[i].used == 0) { return; }
        }
        guard = guard + 1;
        if (guard > 64) { break; }
        let is [3]i64 as pe;
        pe[0] = s.wins[i].chan;
        pe[1] = sys.POLL_READABLE;
        pe[2] = 0;
        sys.poll(&pe[0], 1, 0);
        g = pe[2];
    }
    if ((got & sys.POLL_CLOSED) != 0 || (got & sys.POLL_ERROR) != 0) {
        reap_window(i, 1);
    }
    return;
}

// ---- what the WM owes each client --------------------------------------------
//
// The WM must never block on a client, so it writes a client's channel only
// as far as it has room. Input used to go straight out under a quota of two
// messages per window per pass of the loop — what one POLL_WRITABLE promises
// — and whatever did not fit was thrown away: keys typed while the WM was
// busy (a few at once from the compositor), clicks, and every key pressed
// while a new window was still opening. After 256 such losses the window was
// closed, program and all.
//
// Now input waits in the window's queue, in order, and goes out as the
// channel takes it: SYS_CHAN_INFO says how many bytes fit right now, and the
// loop polls for WRITABLE while anything waits. Only a client that leaves
// OUTQ messages unread loses input, and it is not closed for it — it may be
// busy, and it is the user's to close. Keys for a window still opening wait
// until it is ready.
//
// The queue is flushed when the loop comes round, after ALL the input that
// arrived has been sorted — so a burst longer than OUTQ (a fast paste, keys
// held while the WM was busy) used to fill it and lose the rest though the
// client's channel had room for them all. A full queue now goes out to the
// channel first, and input is lost only when both are full.
fn queue_msg(i as i64, mtype as i64, a as i64, b as i64, c as i64) as void {
    if (s.outq_n[i] >= s.OUTQ) { flush_out(i); }
    if (s.outq_n[i] >= s.OUTQ) {
        if (s.wins[i].drops == 0) {
            sys.write_serial(cast(*u8, "wm: a client is not reading its input - events dropped\n"), 55);
        }
        s.wins[i].drops = s.wins[i].drops + 1;
        return;
    }
    let is i64 as slot = (s.outq_head[i] + s.outq_n[i]) % s.OUTQ;
    let is i64 as base = (i * s.OUTQ + slot) * 4;
    s.outq[base] = mtype;
    s.outq[base + 1] = a;
    s.outq[base + 2] = b;
    s.outq[base + 3] = c;
    s.outq_n[i] = s.outq_n[i] + 1;
    return;
}

// Anything owed to window i's client: a control message or queued input.
fn has_output(i as i64) as i64 {
    if (s.outq_n[i] > 0 || s.wins[i].pend_close == 1 || s.wins[i].pend_resize_w > 0
        || s.wins[i].pend_focus >= 0 || s.wins[i].pend_clip >= 0 || s.wins[i].pend_move == 1) { return 1; }
    return 0;
}

// Write what window i's client is owed, as much as its channel takes without
// blocking: the control messages first — they are state (the size it has
// now, whether it has focus), not a sequence — then queued input, in order.
fn flush_out(i as i64) as void {
    if (s.wins[i].state != 2 || s.wins[i].closing == 1) { return; }
    if (has_output(i) == 0) { return; }
    let is [4]i64 as ci;
    if (sys.chan_info(s.wins[i].chan, &ci[0]) != 0) { return; }
    if (ci[3] != 0) { return; }                      // gone: service_win reaps it
    let is i64 as room with mut = ci[2] / wmp.MSG_BYTES;
    if (room > 0 && s.wins[i].pend_close == 1) {
        wmp.msg_send(s.wins[i].chan, wmp.MSG_CLOSE_REQ, 0, 0, 0);
        s.wins[i].pend_close = 0;
        room = room - 1;
    }
    if (room > 0 && s.wins[i].pend_resize_w > 0) {
        wmp.msg_send(s.wins[i].chan, wmp.MSG_RESIZE, s.wins[i].pend_resize_w, s.wins[i].pend_resize_h, 0);
        s.wins[i].pend_resize_w = 0;
        s.wins[i].pend_resize_h = 0;
        room = room - 1;
    }
    if (room > 0 && s.wins[i].pend_focus >= 0) {
        wmp.msg_send(s.wins[i].chan, wmp.MSG_FOCUS, s.wins[i].pend_focus, 0, 0);
        s.wins[i].pend_focus = 0 - 1;
        room = room - 1;
    }
    if (room > 0 && s.wins[i].pend_clip >= 0) {
        wmp.msg_send(s.wins[i].chan, wmp.MSG_CLIP_DATA, s.wins[i].pend_clip, 0, 0);
        s.wins[i].pend_clip = 0 - 1;
        room = room - 1;
    }
    while (room > 0 && s.outq_n[i] > 0) {
        let is i64 as base = (i * s.OUTQ + s.outq_head[i]) * 4;
        wmp.msg_send(s.wins[i].chan, s.outq[base], s.outq[base + 1], s.outq[base + 2], s.outq[base + 3]);
        s.outq_head[i] = (s.outq_head[i] + 1) % s.OUTQ;
        s.outq_n[i] = s.outq_n[i] - 1;
        room = room - 1;
    }
    // The pointer's latest position, after everything queued before it.
    if (room > 0 && s.wins[i].pend_move == 1) {
        wmp.msg_send(s.wins[i].chan, wmp.MSG_MOUSE_MOVE, mouse_a(s.mbuttons), rel_x(i), rel_y(i));
        s.wins[i].pend_move = 0;
    }
    return;
}

// MOUSE_BTN / MOUSE_MOVE field a: the buttons, and the modifiers held (the
// keysym MOD_* bits) — a terminal extends a selection on Shift+click.
fn mouse_a(buttons as i64) as i64 {
    let is i64 as mods = s.mod_shift | (s.mod_ctrl << 1) | (s.mod_alt << 2) | (s.mod_super << 3);
    return (buttons & 0xFF) | (mods << 8);
}

// The pointer relative to window i's content.
fn rel_x(i as i64) as i64 { return s.mx - (s.wins[i].x + s.BORDER); }
fn rel_y(i as i64) as i64 { return s.my - (s.wins[i].y + s.BORDER + s.TITLE_H); }

// A queued pointer event for window i goes after the motion owed before it,
// or the window sees the button come up before the drag that led there.
fn queue_mouse(i as i64, mtype as i64, a as i64, x as i64, y as i64) as void {
    if (s.wins[i].pend_move == 1) {
        queue_msg(i, wmp.MSG_MOUSE_MOVE, mouse_a(s.mbuttons), x, y);
        s.wins[i].pend_move = 0;
    }
    queue_msg(i, mtype, a, x, y);
    return;
}

