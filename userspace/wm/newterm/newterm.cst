// newterm.cst — open a new terminal window, from inside a terminal.
//
// The whole program is one 32-byte message: MSG_SPAWN_REQ written to the
// control channel its terminal installed at fd 4 (wmp.TERM_CTL). The
// terminal relays it to the WM, the WM spawns another wterm. Authority
// stays chained — this program never holds a WM key; it can only ask the
// terminal that owns it, and only for what the terminal chooses to relay.
//
// Run outside a terminal window (no fd 4) and the write comes back E_BADF:
// say so and fail, honestly.

use "std/os/causticos.cst" as sys;
use "../../lib/wmproto/wmproto.cst" as wmp;

fn main(argc as i64, argv as *u8) as i32 {
    let is i64 as rc = wmp.msg_send(wmp.TERM_CTL, wmp.MSG_SPAWN_REQ, 0, 0, 0);
    if (rc < 0) {
        let is *u8 as msg = "newterm: not inside a terminal window\n";
        sys.write(1, msg, 38);
        return 1;
    }
    return 0;
}
