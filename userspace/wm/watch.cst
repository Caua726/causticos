// wm/watch.cst — the files the WM keeps in memory, and being told they change.
//
// The config (/etc/wm.cst, then /var/wm/config.cst), the keyboard layout
// chosen (/var/keymap, /etc/keymap, the maps in /etc/keymaps) and the time
// zone (/var/timezone, /etc/timezone, the chosen zone's file) are each looked
// at again when SYS_WATCH says one of their paths changed. They used to be
// stat'ed once a second, every second, whether anything had changed or not.

use "config.cst" as cfg;
use "keyboard.cst" as kbd;
use "decoration.cst" as dec;
use "std/os/causticos.cst" as sys;
use "../lib/tz/tz.cst" as tz;

let is i64 as W_CFG  with imut = 1;
let is i64 as W_KMAP with imut = 2;
let is i64 as W_TZ   with imut = 3;

// One slot per path; the last is the chosen zone's file, which moves.
let is i64 as NW with imut = 8;
let is i64 as ZONE_SLOT with imut = 7;
let is [8]i64 as wfd with mut;
let is [8]i64 as wrole with mut;

fn count() as i64 { return NW; }
fn fd(k as i64) as i64 { return wfd[k]; }

fn _arm(k as i64, path as *u8, role as i64) as void {
    wrole[k] = role;
    wfd[k] = sys.watch(path);
    if (wfd[k] < 0) {
        // Without the watch the WM still runs; it just will not notice this
        // file changing until it starts again — so say which, and why.
        sys.write_serial(cast(*u8, "wm: cannot watch "), 17);
        let is i64 as n with mut = 0;
        while (path[n] != cast(u8, 0)) { n = n + 1; }
        sys.write_serial(path, n);
        sys.write_serial(cast(*u8, ": "), 2);
        let is *u8 as w = sys.err_text(wfd[k]);
        let is i64 as wl with mut = 0;
        while (w[wl] != cast(u8, 0)) { wl = wl + 1; }
        sys.write_serial(w, wl);
        sys.write_serial(cast(*u8, "\n"), 1);
    }
    return;
}

// The zone file follows the choice: a new choice is a new path to watch.
fn _rearm_zone() as void {
    if (wfd[ZONE_SLOT] >= 0) { sys.close(wfd[ZONE_SLOT]); wfd[ZONE_SLOT] = 0 - 1; }
    let is [64]u8 as nm;
    let is i64 as n = tz.chosen(cast(*u8, &nm[0]));
    if (tz.valid_name(cast(*u8, &nm[0]), n) == 0) { return; }
    let is [96]u8 as p;
    _arm(ZONE_SLOT, tz.zone_path(cast(*u8, &nm[0]), n, cast(*u8, &p[0])), W_TZ);
    return;
}

fn arm() as void {
    _arm(0, cast(*u8, "/etc/wm.cst"), W_CFG);
    _arm(1, cast(*u8, "/var/wm/config.cst"), W_CFG);
    _arm(2, cast(*u8, "/var/keymap"), W_KMAP);
    _arm(3, cast(*u8, "/etc/keymap"), W_KMAP);
    _arm(4, cast(*u8, "/etc/keymaps"), W_KMAP);
    _arm(5, cast(*u8, "/var/timezone"), W_TZ);
    _arm(6, cast(*u8, "/etc/timezone"), W_TZ);
    wfd[ZONE_SLOT] = 0 - 1;
    _rearm_zone();
    return;
}

// Slot k polled readable: take its count and look again at what it covers.
fn fired(k as i64) as void {
    sys.watch_changes(wfd[k]);
    if (wrole[k] == W_CFG) {
        sys.write_serial(cast(*u8, "wm: config reloaded\n"), 20);
        cfg.load();
    } else if (wrole[k] == W_KMAP) {
        kbd.keymap_poll();
    } else if (wrole[k] == W_TZ) {
        if (dec.tz_poll() == 1) { _rearm_zone(); }
    }
    return;
}
