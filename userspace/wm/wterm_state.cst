// wterm/wterm_state.cst — all wterm globals, constants and types. State split
// from the orchestrator for the same plan-9 single-source pattern used in
// the wm + compositor splits.

use "../lib/repl/repl.cst" as repl;

let is i64 as IMG_CAP  with imut = 4194304;

let is u32 as C_TEXT   with imut = 0x00d3d7cf;
let is u32 as C_PROMPT with imut = 0x008bbf63;
let is u32 as C_ERR    with imut = 0x00ef5350;
let is u32 as C_DIM    with imut = 0x00888a8c;
let is u32 as C_TITLE  with imut = 0x0073d0ff;
let is u32 as C_BG     with imut = 0x00121417;

// Channel fds handed to us at spawn: 3 = WM, 4 = CTL.
let is i64 as WM_FD  with imut = 3;
let is i64 as CTL_FD with imut = 4;

// In-flight command history ring.
// The edit buffer and history ring live in the Repl instance (lib/repl), not
// here: they are the same code the fullscreen shell runs.
let is repl.Repl as rl with mut;
// The thread that keeps /var/history: Enter hands it the line and goes on.
let is repl.HistSync as hs with mut;
// How long leaving waits for it to say the file is written, before going
// anyway: a disk that stopped answering must not keep the window open.
let is i64 as HIST_WAIT_NS with imut = 3000000000;

// Cell grid (TEXT surface): a ring of i64 cells GRID_STRIDE wide, as many rows
// as the screen can show plus SCROLLBACK lines of history. It is reserved at
// start and committed as history fills it (term.attach_grid_lazy): ~2.6 MiB
// for a terminal that has scrolled 2000 lines, 64 KiB for one that has not.
// It was a fixed 60-row array, and the window's own rows came out of those 60:
// 37 lines of history at the default size, 19 maximised.
let is i64 as GRID_STRIDE with imut = 160;
let is i64 as SCROLLBACK  with imut = 2000;
let is i64 as grid_rows   with mut = 0;

// TEXT surface segment:
let is i64 as seg_base      with mut = 0;
let is i64 as segcells      with mut = 0;
let is i64 as seg_cap_cells with mut = 0;
let is i64 as seg_cols      with mut = 0;

// Coalesced dirty ROW range awaiting a WRITABLE channel (hi exclusive).
let is i64 as pend_on with mut = 0;
let is i64 as pend_r0 with mut = 0;
let is i64 as pend_r1 with mut = 0;

// Which job keys are routed to, or -1 for "the user is typing at the prompt".
// The jobs themselves live in lib/jobs.
let is i64 as fg_job   with mut = 0 - 1;
// The compositor inverts the text cursor only while this terminal window is focused.
let is i64 as win_focused with mut = 1;

// The window was asked to close and is waiting, until this time (ns), for jobs
// it told so (ttyproto EV_HUP) to end; 0 = no close pending.
let is i64 as close_wait_until with mut = 0;
let is i64 as CLOSE_WAIT_NS with imut = 3000000000;

// What the terminal has written to the foreground job's stdin since that job
// came forward, newest last, as much as the channel holds. When the job ends,
// the part it never read goes back to the prompt (wterm.finish_job) — the way
// a tty keeps type-ahead. It used to die with the job: a command typed while
// `sleep 5` ran was simply gone.
let is i64 as TA_CAP with imut = 8192;
let is [8192]u8 as ta_ring with mut;
let is i64 as ta_end with mut = 0;          // bytes written to the job's stdin so far
let is [8192]u8 as ta_back with mut;        // the unread part, carried past finish_job
let is i64 as ctl_fill with mut = 0;
let is [32]u8 as ctl_acc with mut;

// CMD channel (the WM's view: the WM writes keys to us at fd 3 reads).
let is i64 as cmd_fill with mut = 0;
let is [32]u8 as cmd_acc with mut;
// Messages from the WM that arrived while the terminal was waiting for one in
// particular (kill_via_wm): held, in order, for the main loop. A ring, because
// handling one can start another wait.
let is i64 as HELD_CAP with imut = 64;
let is [256]i64 as held with mut;           // HELD_CAP * 4
let is i64 as held_head with mut = 0;
let is i64 as held_tail with mut = 0;

// Previous mouse button mask — diffed on each MSG_MOUSE_BTN to emit press vs
// release edges to a child that enabled xterm mouse tracking.
let is i64 as mouse_prev_btn with mut = 0;
// The cell the last drag report was for (?1002/?1003 report once per cell).
let is i64 as mouse_mcol with mut = 0;
let is i64 as mouse_mrow with mut = 0;

// Which rows are long lines the terminal wrapped (term.attach_wraps), one
// byte per grid row.
let is [4096]u8 as wraps with mut;

// The selection (wterm_sel.cst). Its two ends are line NUMBERS (term
// line_number: they stay with the text while output scrolls it) and column
// boundaries (0..cols, between cells): `a` where the press was, `b` where the
// pointer is. The cells between them, in reading order, are selected.
let is i64 as sel_state with mut = 0;       // 0 none, 1 being dragged, 2 made
let is i64 as sel_al with mut = 0;
let is i64 as sel_ac with mut = 0;
let is i64 as sel_bl with mut = 0;
let is i64 as sel_bc with mut = 0;
let is i64 as sel_unit with mut = 1;        // 1 characters, 2 words, 3 lines (clicks)
let is i64 as sel_alt with mut = 0;         // the screen it was made on (term.alt)
// The normalised span the highlight draws, recomputed on every change:
// [s0, s1) in (number, column) order.
let is i64 as sel_s0l with mut = 0;
let is i64 as sel_s0c with mut = 0;
let is i64 as sel_s1l with mut = 0;
let is i64 as sel_s1c with mut = 0;
// Double and triple clicks: when and on which cell the last press was.
let is i64 as click_ns with mut = 0;
let is i64 as click_n with mut = 0;
let is i64 as click_l with mut = 0;
let is i64 as click_c with mut = 0;
let is i64 as CLICK_NS with imut = 400000000;
// A paste on its way (wterm.paste_pump): the clipboard's text, in the segment
// the WM sent it in, and how far into it has been typed. A program reading
// slower than the text arrives gets it as its input takes it, so a long paste
// never blocks the terminal. -1 = none.
let is i64 as paste_fd with mut = 0 - 1;
let is i64 as paste_off with mut = 0;
let is i64 as paste_len with mut = 0;

// The image we keep mmap'd for the currently running child (or the last child
// before it EOF'd). Tracked so the unload path can munmap exactly the bytes we
// allocated, not the IMG_CAP ceiling.
let is i64 as img_alloc with mut = 0;
