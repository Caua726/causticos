// wterm/wterm_state.cst — all wterm globals, constants and types. State split
// from the orchestrator for the same plan-9 single-source pattern used in
// the wm + compositor splits.

let is i64 as MAX_ARGS with imut = 16;
let is i64 as LINE_CAP with imut = 256;
let is i64 as IMG_CAP  with imut = 4194304;

let is u32 as C_TEXT   with imut = 0x00d3d7cf;
let is u32 as C_PROMPT with imut = 0x008bbf63;
let is u32 as C_ERR    with imut = 0x00ef5350;
let is u32 as C_DIM    with imut = 0x00888a8c;
let is u32 as C_TITLE  with imut = 0x0073d0ff;
let is u32 as C_BG     with imut = 0x00121417;

// Channel fds handed to us at spawn: 3 = WM, 4 = CTL.
let is i64 as WM_FD  with imut = 3;
let is i64 as CTL_FD with imut = 4;

// In-flight command history ring.
let is [4096]u8 as hbuf with mut;
let is [16]i64 as hlen with mut;
let is i64 as hhead with mut = 0;
let is i64 as hsize with mut = 0;
let is i64 as hnav with mut = 0;

// Cell grid (TEXT surface). 160 cols × 60 rows = ~75 KiB ring of i64 cells.
let is [9600]i64 as gridbuf with mut;
let is i64 as GRID_STRIDE with imut = 160;
let is i64 as GRID_ROWS   with imut = 60;

// TEXT surface segment:
let is i64 as seg_base      with mut = 0;
let is i64 as segcells      with mut = 0;
let is i64 as seg_cap_cells with mut = 0;
let is i64 as seg_cols      with mut = 0;

// Coalesced dirty ROW range awaiting a WRITABLE channel (hi exclusive).
let is i64 as pend_on with mut = 0;
let is i64 as pend_r0 with mut = 0;
let is i64 as pend_r1 with mut = 0;

// Running child process (one at a time).
let is i64 as child_pid with mut = 0;
let is i64 as child_out with mut = 0 - 1;
let is i64 as child_in  with mut = 0 - 1;
let is i64 as child_ctl with mut = 0 - 1;
let is i64 as ctl_fill  with mut = 0;
let is [32]u8 as ctl_acc with mut;

// CMD channel (the WM's view: the WM writes keys to us at fd 3 reads).
let is i64 as cmd_fill with mut = 0;
let is [32]u8 as cmd_acc with mut;

// Previous mouse button mask — diffed on each MSG_MOUSE_BTN to emit press vs
// release edges to a child that enabled xterm mouse tracking.
let is i64 as mouse_prev_btn with mut = 0;

// The image we keep mmap'd for the currently running child (or the last child
// before it EOF'd). Tracked so the unload path can munmap exactly the bytes we
// allocated, not the IMG_CAP ceiling.
let is i64 as img_alloc with mut = 0;
