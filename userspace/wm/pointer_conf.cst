// pointer_conf.cst — discover every pointer the machine has and bind an accel
// curve to each one individually.
//
// Discovery is SYS_QUERY_DEVS (what exists) + SYS_DEV_INFO (what each one is),
// so a second mouse is a real second device, not an alias of index 0.
//
// /var/wm/pointer.cst is a plain `key value` list. Keys before any `device`
// line set the defaults every pointer starts from; a `device <selector>` line
// opens a section whose keys apply only to the pointers it matches. Absent
// file = compiled defaults, so a stock system needs no config.
//
//   profile   adaptive | flat
//   base      <int>   slow-speed gain (256 = 1.0x)
//   threshold <int>   speed below which gain stays at base
//   vmax      <int>   speed at which gain saturates
//   max       <int>   top gain
//   flat      <int>   FLAT-profile gain
//
// Selectors (a section may repeat `device` to match several):
//   device mouse 0      class name + in-class index
//   device tablet 0
//   device mouse        every mouse, whatever its index
//   device 1af4:1052    bus vendor:product, hex, whatever the class
//   device name mouse   the hardware node's name
use "comp_state.cst" as s;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/wmproto/wmproto.cst" as wmp;

fn _tok_eq(buf as *u8, a as i64, b as i64, lit as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (a + i < b) {
        if (lit[i] == cast(u8, 0)) { return 0; }        // lit shorter than token
        if (buf[a + i] != lit[i]) { return 0; }
        i = i + 1;
    }
    if (lit[i] != cast(u8, 0)) { return 0; }             // token shorter than lit
    return 1;
}

fn _int(buf as *u8, a as i64, b as i64) as i64 {
    let is i64 as v with mut = 0;
    let is i64 as i with mut = a;
    while (i < b) {
        let is i64 as c = cast(i64, buf[i]);
        if (c >= 48 && c <= 57) { v = v * 10 + (c - 48); }
        i = i + 1;
    }
    return v;
}

// Parse [a,b) as hex. Returns -1 when a byte is not a hex digit, so a
// malformed vendor:product selector is rejected instead of silently
// matching device 0.
fn _hex(buf as *u8, a as i64, b as i64) as i64 {
    if (b <= a) { return 0 - 1; }
    let is i64 as v with mut = 0;
    let is i64 as i with mut = a;
    while (i < b) {
        let is i64 as c = cast(i64, buf[i]);
        if (c >= 48 && c <= 57)       { v = v * 16 + (c - 48); }
        else if (c >= 97 && c <= 102) { v = v * 16 + (c - 87); }
        else if (c >= 65 && c <= 70)  { v = v * 16 + (c - 55); }
        else { return 0 - 1; }
        i = i + 1;
    }
    return v;
}

fn _ws(c as i64) as i64 {
    if (c == 32 || c == 9) { return 1; }
    return 0;
}

// Class name → dev class, or -1 when the token is not a class name.
fn _class_of(buf as *u8, a as i64, b as i64) as i64 {
    if (_tok_eq(buf, a, b, cast(*u8, "mouse")) == 1)  { return sys.DEV_MOUSE; }
    if (_tok_eq(buf, a, b, cast(*u8, "tablet")) == 1) { return sys.DEV_TABLET; }
    return 0 - 1;
}

// ---- discovery -------------------------------------------------------------

fn _defaults(p as *s.Ptr) as void {
    p.profile   = s.accel_profile;
    p.base      = s.ACCEL_BASE;
    p.threshold = s.ACCEL_THRESHOLD;
    p.vmax      = s.ACCEL_VMAX;
    p.max       = s.ACCEL_MAX;
    p.flat      = s.ACCEL_FLAT_GAIN;
    p.rem_x     = 0;
    p.rem_y     = 0;
    return;
}

// Open one instance and record its identity. Returns 1 when it joined the
// table. A dev_open failure is not fatal: the machine keeps the pointers it
// could take, and the compositor logs the loss.
fn _adopt(class as i64, index as i64) as i64 {
    if (s.ptr_n >= s.PTR_MAX) { return 0; }
    let is i64 as fd = sys.dev_open(class, index, 0);
    if (fd < 0) { return 0; }
    let is i64 as k = s.ptr_n;
    s.ptrs[k].fd      = fd;
    s.ptrs[k].class   = class;
    s.ptrs[k].index   = index;
    s.ptrs[k].vendor  = 0;
    s.ptrs[k].product = 0;
    if (class == sys.DEV_TABLET) { s.ptrs[k].is_abs = 1; } else { s.ptrs[k].is_abs = 0; }
    _defaults(&s.ptrs[k]);

    let is [8]i64 as inf;
    let is i64 as j with mut = 0;
    while (j < 32) { s.ptr_names[k * 32 + j] = cast(u8, 0); j = j + 1; }
    if (sys.dev_info(class, index, cast(*i64, &inf[0])) == 0) {
        s.ptrs[k].vendor  = inf[2];
        s.ptrs[k].product = inf[3];
        let is *u8 as nm = cast(*u8, &inf[4]);
        j = 0;
        while (j < 31) { s.ptr_names[k * 32 + j] = nm[j]; j = j + 1; }
    }
    s.ptr_n = k + 1;
    return 1;
}

// Enumerate the whole device landscape once, then adopt every relative and
// absolute pointer in it. dev_count would answer per class, but query_devs
// answers in one call and keeps the class list in one place.
fn open_all() as void {
    s.ptr_n = 0;
    let is [32]i64 as devs;                              // 16 instances x {class,index}
    let is i64 as total with mut = sys.query_devs(cast(*i64, &devs[0]), 16);
    if (total < 0) { total = 0; }
    if (total > 16) { total = 16; }
    let is i64 as i with mut = 0;
    while (i < total) {
        let is i64 as cls = devs[i * 2];
        if (cls == sys.DEV_MOUSE || cls == sys.DEV_TABLET) {
            _adopt(cls, devs[i * 2 + 1]);
        }
        i = i + 1;
    }
    return;
}

// ---- config ----------------------------------------------------------------

// Does pointer k match the selector token range [as,ae) (+ optional second
// token [bs,be), be < 0 when absent)?
fn _matches(k as i64, buf as *u8, as_ as i64, ae as i64, bs as i64, be as i64) as i64 {
    // `name <str>`
    if (_tok_eq(buf, as_, ae, cast(*u8, "name")) == 1) {
        if (be < 0) { return 0; }
        let is i64 as i with mut = 0;
        while (bs + i < be) {
            if (i >= 31) { return 0; }
            if (s.ptr_names[k * 32 + i] != buf[bs + i]) { return 0; }
            i = i + 1;
        }
        if (s.ptr_names[k * 32 + i] != cast(u8, 0)) { return 0; }   // name is longer
        return 1;
    }
    // `<vendor>:<product>` in hex
    let is i64 as colon with mut = 0 - 1;
    let is i64 as c with mut = as_;
    while (c < ae) { if (buf[c] == cast(u8, 58)) { colon = c; c = ae; } else { c = c + 1; } }
    if (colon >= 0) {
        let is i64 as ven = _hex(buf, as_, colon);
        let is i64 as prd = _hex(buf, colon + 1, ae);
        if (ven < 0 || prd < 0) { return 0; }
        if (s.ptrs[k].vendor == ven && s.ptrs[k].product == prd) { return 1; }
        return 0;
    }
    // `<class> [index]`
    let is i64 as cls = _class_of(buf, as_, ae);
    if (cls < 0) { return 0; }
    if (s.ptrs[k].class != cls) { return 0; }
    if (be < 0) { return 1; }                            // no index -> every instance
    if (s.ptrs[k].index != _int(buf, bs, be)) { return 0; }
    return 1;
}

// Apply one key/value to pointer k. Section -1 means "the defaults", which are
// written back to the globals so a later-adopted device inherits them too.
fn _apply_to(k as i64, buf as *u8, ks as i64, ke as i64, vs as i64, ve as i64) as void {
    if (_tok_eq(buf, ks, ke, cast(*u8, "profile")) == 1) {
        let is i64 as pv with mut = 1;
        if (_tok_eq(buf, vs, ve, cast(*u8, "flat")) == 1) { pv = 0; }
        if (k < 0) { s.accel_profile = pv; } else { s.ptrs[k].profile = pv; }
        return;
    }
    let is i64 as v = _int(buf, vs, ve);
    if (_tok_eq(buf, ks, ke, cast(*u8, "base")) == 1) {
        if (k < 0) { s.ACCEL_BASE = v; } else { s.ptrs[k].base = v; }
        return;
    }
    if (_tok_eq(buf, ks, ke, cast(*u8, "threshold")) == 1) {
        if (k < 0) { s.ACCEL_THRESHOLD = v; } else { s.ptrs[k].threshold = v; }
        return;
    }
    if (_tok_eq(buf, ks, ke, cast(*u8, "vmax")) == 1) {
        if (k < 0) { s.ACCEL_VMAX = v; } else { s.ptrs[k].vmax = v; }
        return;
    }
    if (_tok_eq(buf, ks, ke, cast(*u8, "max")) == 1) {
        if (k < 0) { s.ACCEL_MAX = v; } else { s.ptrs[k].max = v; }
        return;
    }
    if (_tok_eq(buf, ks, ke, cast(*u8, "flat")) == 1) {
        if (k < 0) { s.ACCEL_FLAT_GAIN = v; } else { s.ptrs[k].flat = v; }
        return;
    }
    return;
}

// dump — one serial line per pointer with the curve it actually ended up with.
// Without this a mistyped selector fails silently and the device just keeps the
// defaults, which is indistinguishable from the config having been applied.
fn dump() as void {
    let is i64 as k with mut = 0;
    while (k < s.ptr_n) {
        wmp.log_kv(cast(*u8, "comp: ptr class="), 16, s.ptrs[k].class);
        wmp.log_kv(cast(*u8, "comp:   index="), 14, s.ptrs[k].index);
        wmp.log_kv(cast(*u8, "comp:   vendor="), 15, s.ptrs[k].vendor);
        wmp.log_kv(cast(*u8, "comp:   product="), 16, s.ptrs[k].product);
        wmp.log_kv(cast(*u8, "comp:   profile="), 16, s.ptrs[k].profile);
        wmp.log_kv(cast(*u8, "comp:   base="), 13, s.ptrs[k].base);
        wmp.log_kv(cast(*u8, "comp:   max="), 12, s.ptrs[k].max);
        k = k + 1;
    }
    return;
}

// load — read the config over the already-adopted pointers. Call AFTER
// open_all(): a section can only bind to a device that exists.
fn load() as void {
    let is i64 as fd = sys.open_read(cast(*u8, "/var/wm/pointer.cst"));
    if (fd < 0) { wmp.log_kv(cast(*u8, "comp: pointer.cst rc="), 21, fd); return; }
    let is [1024]u8 as buf;
    let is i64 as n = sys.read(fd, cast(*u8, &buf[0]), 1024);
    sys.close(fd);
    if (n <= 0) { return; }
    let is *u8 as p = cast(*u8, &buf[0]);

    // sel_mask: bit k set = pointer k is in the current section. No section
    // yet (mask 0 with in_section 0) means the keys are defaults.
    let is i64 as sel_mask with mut = 0;
    let is i64 as in_section with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        while (i < n && (cast(i64, p[i]) == 10 || cast(i64, p[i]) == 13 || _ws(cast(i64, p[i])) == 1)) { i = i + 1; }
        if (i < n && cast(i64, p[i]) == 35) {            // '#' comment to end of line
            while (i < n && cast(i64, p[i]) != 10) { i = i + 1; }
        } else {
            let is i64 as ks = i;
            while (i < n && _ws(cast(i64, p[i])) == 0 && cast(i64, p[i]) != 10 && cast(i64, p[i]) != 13) { i = i + 1; }
            let is i64 as ke = i;
            while (i < n && _ws(cast(i64, p[i])) == 1) { i = i + 1; }
            let is i64 as vs = i;
            while (i < n && _ws(cast(i64, p[i])) == 0 && cast(i64, p[i]) != 10 && cast(i64, p[i]) != 13) { i = i + 1; }
            let is i64 as ve = i;
            // an optional third token: `device mouse 0`
            while (i < n && _ws(cast(i64, p[i])) == 1) { i = i + 1; }
            let is i64 as ts = i;
            while (i < n && _ws(cast(i64, p[i])) == 0 && cast(i64, p[i]) != 10 && cast(i64, p[i]) != 13) { i = i + 1; }
            let is i64 as te with mut = i;
            if (te <= ts) { te = 0 - 1; }

            if (ke > ks && ve > vs) {
                if (_tok_eq(p, ks, ke, cast(*u8, "device")) == 1) {
                    // Consecutive `device` lines UNION into one section; the
                    // first after a key line starts a fresh one.
                    if (in_section != 1) { sel_mask = 0; in_section = 1; }
                    let is i64 as k with mut = 0;
                    while (k < s.ptr_n) {
                        if (_matches(k, p, vs, ve, ts, te) == 1) { sel_mask = sel_mask | (1 << k); }
                        k = k + 1;
                    }
                } else if (in_section == 0) {
                    _apply_to(0 - 1, p, ks, ke, vs, ve);  // defaults, before any section
                    let is i64 as k with mut = 0;         // and onto what is already open
                    while (k < s.ptr_n) { _apply_to(k, p, ks, ke, vs, ve); k = k + 1; }
                } else {
                    let is i64 as k with mut = 0;
                    while (k < s.ptr_n) {
                        if ((sel_mask & (1 << k)) != 0) { _apply_to(k, p, ks, ke, vs, ve); }
                        k = k + 1;
                    }
                }
                // A key line closes the run of `device` lines above it.
                if (_tok_eq(p, ks, ke, cast(*u8, "device")) == 0 && in_section == 1) { in_section = 2; }
            }
        }
    }
    return;
}
