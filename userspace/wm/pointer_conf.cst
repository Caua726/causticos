// pointer_conf.cst — optional runtime tuning of the pointer accel curve. Reads
// /var/wm/pointer.cst at compositor startup, a plain `key value` list one per
// line, and overrides the accel parameters. Absent file = compiled defaults, so
// a stock system needs no config. Keys:
//   profile   adaptive | flat
//   base      <int>   slow-speed gain (256 = 1.0x)
//   threshold <int>   speed below which gain stays at base
//   vmax      <int>   speed at which gain saturates
//   max       <int>   top gain
//   flat      <int>   FLAT-profile gain
use "comp_state.cst" as s;
use "../../../Caustic/std/os/causticos.cst" as sys;

fn _tok_eq(buf as *u8, a as i64, b as i64, lit as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (a + i < b) {
        if (lit[i] == cast(u8, 0)) { return 0; }        // lit shorter than token
        if (buf[a + i] != lit[i]) { return 0; }
        i = i + 1;
    }
    if (lit[i] != cast(u8, 0)) { return 0; }             // token shorter than lit
    return 1;
}

fn _int(buf as *u8, a as i64, b as i64) as i64 {
    let is i64 as v with mut = 0;
    let is i64 as i with mut = a;
    while (i < b) {
        let is i64 as c = cast(i64, buf[i]);
        if (c >= 48 && c <= 57) { v = v * 10 + (c - 48); }
        i = i + 1;
    }
    return v;
}

fn _apply(buf as *u8, ks as i64, ke as i64, vs as i64, ve as i64) as void {
    if (_tok_eq(buf, ks, ke, cast(*u8, "profile")) == 1) {
        if (_tok_eq(buf, vs, ve, cast(*u8, "flat")) == 1) { s.accel_profile = 0; }
        else { s.accel_profile = 1; }
        return;
    }
    let is i64 as v = _int(buf, vs, ve);
    if (_tok_eq(buf, ks, ke, cast(*u8, "base")) == 1)      { s.ACCEL_BASE = v; return; }
    if (_tok_eq(buf, ks, ke, cast(*u8, "threshold")) == 1) { s.ACCEL_THRESHOLD = v; return; }
    if (_tok_eq(buf, ks, ke, cast(*u8, "vmax")) == 1)      { s.ACCEL_VMAX = v; return; }
    if (_tok_eq(buf, ks, ke, cast(*u8, "max")) == 1)       { s.ACCEL_MAX = v; return; }
    if (_tok_eq(buf, ks, ke, cast(*u8, "flat")) == 1)      { s.ACCEL_FLAT_GAIN = v; return; }
    return;
}

fn _ws(c as i64) as i64 {
    if (c == 32 || c == 9) { return 1; }
    return 0;
}

fn load() as void {
    let is i64 as fd = sys.open_read(cast(*u8, "/var/wm/pointer.cst"));
    if (fd < 0) { return; }                              // no config — defaults stand
    let is [1024]u8 as buf;
    let is i64 as n = sys.read(fd, cast(*u8, &buf[0]), 1024);
    sys.close(fd);
    if (n <= 0) { return; }
    let is *u8 as p = cast(*u8, &buf[0]);
    let is i64 as i with mut = 0;
    while (i < n) {
        // skip line breaks + leading blanks
        while (i < n && (cast(i64, p[i]) == 10 || cast(i64, p[i]) == 13 || _ws(cast(i64, p[i])) == 1)) { i = i + 1; }
        let is i64 as ks = i;
        while (i < n && _ws(cast(i64, p[i])) == 0 && cast(i64, p[i]) != 10 && cast(i64, p[i]) != 13) { i = i + 1; }
        let is i64 as ke = i;
        while (i < n && _ws(cast(i64, p[i])) == 1) { i = i + 1; }
        let is i64 as vs = i;
        while (i < n && _ws(cast(i64, p[i])) == 0 && cast(i64, p[i]) != 10 && cast(i64, p[i]) != 13) { i = i + 1; }
        let is i64 as ve = i;
        if (ke > ks && ve > vs) { _apply(p, ks, ke, vs, ve); }
    }
    // A profile/param change mid-stroke would otherwise carry a stale remainder.
    s.accel_rem_x = 0; s.accel_rem_y = 0;
    return;
}
