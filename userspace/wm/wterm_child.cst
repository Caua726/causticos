// wterm/wterm_child.cst — starting and retiring the jobs this terminal runs.
//
// The job table itself is lib/jobs, shared with the fullscreen shell: one place
// decides what "a job finished" means. What is wterm-specific lives here — the
// third channel each child gets (so it can ask for another window), the window
// title following the running command, and drawing into a cell grid.
use "wterm_state.cst" as s;
use "wterm_grid.cst" as g;
use "../lib/jobs/jobs.cst" as jobs;
use "../lib/repl/repl.cst" as repl;
use "std/os/causticos.cst" as sys;
use "../lib/wmproto/wmproto.cst" as wmp;

let is i64 as RF_OK     with imut = 0;
let is i64 as RF_NOENT  with imut = 1;
let is i64 as RF_BADSZ  with imut = 2;
let is i64 as RF_NOMEM  with imut = 3;
let is i64 as RF_IOERR  with imut = 4;

// set_title — the window title IS what the terminal is doing: the running job
// while one runs, the terminal's own name at the prompt. The WM shows it in the
// titlebar and the taskbar button, so a terminal with no title left both blank.
fn set_title(name as *u8, len as i64) as void {
    let is [2]i64 as tb;
    let is i64 as n with mut = len;
    if (n < 0) { n = 0; }
    n = wmp.utf8_fit(name, n, 16);
    wmp.title_pack(name, n, &tb[0], &tb[1]);
    wmp.msg_send(s.WM_FD, wmp.MSG_SET_TITLE, n, tb[0], tb[1]);
    return;
}

fn read_file(path as *u8, out_len as *i64, out_err as *i64) as *u8 {
    *out_len = 0;
    *out_err = RF_OK;
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { *out_err = RF_NOENT; return cast(*u8, 0); }
    let is i64 as sz = sys.lseek(fd, 0, cast(i32, sys.SEEK_END));
    sys.lseek(fd, 0, cast(i32, sys.SEEK_SET));
    if (sz <= 0 || sz > s.IMG_CAP) { sys.close(fd); *out_err = RF_BADSZ; return cast(*u8, 0); }
    let is i64 as alloc = (sz + 4095) & (0 - 4096);
    let is i64 as va = sys.mmap(cast(i64, 0), alloc, sys.PROT_READ | sys.PROT_WRITE);
    if (va < 0) { sys.close(fd); *out_err = RF_NOMEM; return cast(*u8, 0); }
    let is i64 as got = sys.read(fd, cast(*u8, va), sz);
    sys.close(fd);
    if (got != sz) { sys.munmap(va, alloc); *out_err = RF_IOERR; return cast(*u8, 0); }
    *out_len = got;
    s.img_alloc = alloc;
    return cast(*u8, va);
}

// drain_ctl — forward every control request this job has buffered. A child's
// exit closes its end together with its last write, so the request must be
// honored even when its EOF lands in the same sweep.
fn drain_ctl(slot as i64) as void {
    let is *jobs.Job as jb = jobs.get(slot);
    if (jb.aux_fd < 0) { return; }
    let is [3]i64 as ce;
    let is [4]i64 as cm;
    let is i64 as more with mut = 1;
    while (more == 1) {
        ce[0] = jb.aux_fd;
        ce[1] = sys.POLL_READABLE;
        ce[2] = 0;
        sys.poll(&ce[0], 1, 0);
        if ((ce[2] & sys.POLL_READABLE) == 0) { more = 0; }
        else {
            let is i64 as cr = wmp.msg_read(jb.aux_fd, &s.ctl_fill, cast(*u8, &s.ctl_acc[0]), &cm[0]);
            if (cr < 0) { more = 0; }
            else if (cr == 1 && cm[0] == wmp.MSG_SPAWN_REQ) {
                wmp.msg_send(s.WM_FD, wmp.MSG_SPAWN_REQ, 0, 0, 0);
            }
        }
    }
    return;
}

// kill_via_wm — ask the WM to end `pid` (and what it started) for the user,
// and wait up to 2 s for its answer: 0, E_NOENT when it is out of the WM's
// reach too, E_AGAIN when the WM did not answer. The terminal ends what it
// started itself; the WM started every window, so everything in the session
// is one of the two. Whatever else the WM sends meanwhile is held for the main
// loop, in order.
fn kill_via_wm(pid as i64) as i64 {
    wmp.msg_send(s.WM_FD, wmp.MSG_KILL_REQ, pid, 0 - 1, 0);
    let is i64 as deadline = sys.time_ns() + 2000000000;
    let is [4]i64 as m;
    while (1 == 1) {
        let is i64 as left = deadline - sys.time_ns();
        if (left <= 0) { return sys.E_AGAIN; }
        // No room to hold another: stop reading rather than lose a key. What
        // is left stays queued in the channel, and the answer with it.
        if (s.held_tail - s.held_head >= s.HELD_CAP) { return sys.E_AGAIN; }
        let is [3]i64 as pe;
        pe[0] = s.WM_FD; pe[1] = sys.POLL_READABLE; pe[2] = 0;
        sys.poll(&pe[0], 1, left);
        if ((pe[2] & sys.POLL_READABLE) != 0) {
            let is i64 as r = wmp.msg_read(s.WM_FD, &s.cmd_fill, cast(*u8, &s.cmd_acc[0]), &m[0]);
            if (r < 0) { return sys.E_AGAIN; }
            if (r == 1) {
                if (m[0] == wmp.MSG_KILL_RES && m[3] == 0 - 1 && m[1] == pid) { return m[2]; }
                hold(&m[0]);
            }
        }
    }
    return sys.E_AGAIN;
}

// hold — keep m for the main loop. The caller has made sure there is room.
fn hold(m as *i64) as void {
    let is i64 as at = (s.held_tail % s.HELD_CAP) * 4;
    s.held[at] = m[0]; s.held[at + 1] = m[1]; s.held[at + 2] = m[2]; s.held[at + 3] = m[3];
    s.held_tail = s.held_tail + 1;
    return;
}

// unhold — the oldest held message into m: 1, or 0 when none is held.
fn unhold(m as *i64) as i64 {
    if (s.held_head >= s.held_tail) { return 0; }
    let is i64 as at = (s.held_head % s.HELD_CAP) * 4;
    m[0] = s.held[at]; m[1] = s.held[at + 1]; m[2] = s.held[at + 2]; m[3] = s.held[at + 3];
    s.held_head = s.held_head + 1;
    return 1;
}

// pump_job — move a job's output into the grid. Returns 1 at end-of-stream.
fn pump_job(t as *term.Term, slot as i64) as i64 {
    let is *jobs.Job as jb = jobs.get(slot);
    if (jb.out_fd < 0) { return 1; }
    let is [256]u8 as pbuf;
    let is i64 as n = sys.read(jb.out_fd, cast(*u8, &pbuf[0]), 256);
    if (n <= 0) { return 1; }
    term.puts(t, cast(*u8, &pbuf[0]), n);
    g.show(t);
    if (t.want_size == 1) { t.want_size = 0; g.send_size(t); }
    return 0;
}
