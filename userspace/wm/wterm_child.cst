// wterm/wterm_child.cst — child process lifecycle: load CSE, mmap, hand to
// compositor, control + data channel plumbing, reap on exit.
use "wterm_state.cst" as s;
use "wterm_grid.cst" as g;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/wmproto.cst" as wmp;

let is i64 as RF_OK     with imut = 0;
let is i64 as RF_NOENT  with imut = 1;
let is i64 as RF_BADSZ  with imut = 2;
let is i64 as RF_NOMEM  with imut = 3;
let is i64 as RF_IOERR  with imut = 4;

let is i64 as img_alloc with mut = 0;

fn read_file(path as *u8, out_len as *i64, out_err as *i64) as *u8 {
    *out_len = 0;
    *out_err = RF_OK;
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { *out_err = RF_NOENT; return cast(*u8, 0); }
    let is i64 as sz = sys.lseek(fd, 0, cast(i32, sys.SEEK_END));
    sys.lseek(fd, 0, cast(i32, sys.SEEK_SET));
    if (sz <= 0 || sz > s.IMG_CAP) { sys.close(fd); *out_err = RF_BADSZ; return cast(*u8, 0); }
    let is i64 as alloc = (sz + 4095) & (0 - 4096);
    let is i64 as va = sys.mmap(cast(i64, 0), alloc, sys.PROT_READ | sys.PROT_WRITE);
    if (va < 0) { sys.close(fd); *out_err = RF_NOMEM; return cast(*u8, 0); }
    let is i64 as got = sys.read(fd, cast(*u8, va), sz);
    sys.close(fd);
    if (got != sz) { sys.munmap(va, alloc); *out_err = RF_IOERR; return cast(*u8, 0); }
    *out_len = got;
    s.img_alloc = alloc;
    return cast(*u8, va);
}

fn run_program(t as *term.Term, argv_ptr as *i64, argv_len as *i64, argc as i64) as void {
    let is [128]u8 as path;
    let is *u8 as cmd = cast(*u8, argv_ptr[0]);
    let is i64 as cl = argv_len[0];
    if (cl > 110) { g.err(t, "name too long\n"); return; }
    path[0] = cast(u8, 47);
    let is i64 as i with mut = 0;
    while (i < cl) { path[1 + i] = cmd[i]; i = i + 1; }
    let is *u8 as ext = ".cse";
    let is i64 as j with mut = 0;
    while (j < 4) { path[1 + cl + j] = ext[j]; j = j + 1; }
    path[1 + cl + 4] = cast(u8, 0);

    let is i64 as img_len with mut = 0;
    let is i64 as rferr with mut = 0;
    let is *u8 as img = read_file(cast(*u8, &path[0]), &img_len, &rferr);
    if (cast(i64, img) == 0) {
        g.err(t, cast(*u8, &path[0]));
        if (rferr == RF_NOENT)      { g.err(t, ": not found\n"); }
        else if (rferr == RF_BADSZ) { g.err(t, ": bad size\n"); }
        else if (rferr == RF_NOMEM) { g.err(t, ": out of memory\n"); }
        else if (rferr == RF_IOERR) { g.err(t, ": read error\n"); }
        else                        { g.err(t, ": load failed\n"); }
        return;
    }

    let is [2]i64 as fds;
    if (sys.channel_create(&fds[0]) != 0) { g.err(t, "channel fail\n"); sys.munmap(cast(i64, img), s.img_alloc); return; }
    let is [2]i64 as cfds;
    if (sys.channel_create(&cfds[0]) != 0) {
        g.err(t, "channel fail\n");
        sys.close(fds[0]); sys.close(fds[1]);
        sys.munmap(cast(i64, img), s.img_alloc);
        return;
    }
    let is [2]i64 as ifds;
    if (sys.channel_create(&ifds[0]) != 0) {
        g.err(t, "channel fail\n");
        sys.close(fds[0]); sys.close(fds[1]);
        sys.close(cfds[0]); sys.close(cfds[1]);
        sys.munmap(cast(i64, img), s.img_alloc);
        return;
    }
    let is [6]i64 as fdacts;
    fdacts[0] = 0;          fdacts[1] = ifds[1];
    fdacts[2] = 1;          fdacts[3] = fds[1];
    fdacts[4] = s.CTL_FD;   fdacts[5] = cfds[1];

    let is [32]i64 as av;
    let is i64 as k with mut = 0;
    while (k < argc) { av[2 * k] = argv_ptr[k]; av[2 * k + 1] = argv_len[k]; k = k + 1; }

    let is i64 as pid = sys.spawn(cast(*u8, img), img_len,
                                  cast(*u8, &fdacts[0]), 3, cast(*u8, &av[0]), argc);
    sys.close(fds[1]);
    sys.close(cfds[1]);
    sys.close(ifds[1]);
    if (pid < 0) {
        g.err(t, "spawn failed\n");
        sys.close(fds[0]);
        sys.close(cfds[0]);
        sys.close(ifds[0]);
        sys.munmap(cast(i64, img), s.img_alloc);
        return;
    }

    s.child_pid = pid;
    s.child_out = fds[0];
    s.child_ctl = cfds[0];
    s.child_in = ifds[0];
    s.ctl_fill = 0;
    return;
}

// Drain every control request still buffered and forward them. The child's
// exit closes its end together with its last write — the request must be
// honored even when its EOF arrives in the same sweep.
fn drain_ctl() as void {
    if (s.child_ctl < 0) { return; }
    let is [3]i64 as ce;
    let is [4]i64 as cm;
    let is i64 as more with mut = 1;
    while (more == 1) {
        ce[0] = s.child_ctl;
        ce[1] = sys.POLL_READABLE;
        ce[2] = 0;
        sys.poll(&ce[0], 1, 0);
        if ((ce[2] & sys.POLL_READABLE) == 0) { more = 0; }
        else {
            let is i64 as cr = wmp.msg_read(s.child_ctl, &s.ctl_fill, cast(*u8, &s.ctl_acc[0]), &cm[0]);
            if (cr < 0) { more = 0; }
            else if (cr == 1 && cm[0] == wmp.MSG_SPAWN_REQ) {
                wmp.msg_send(wmp.WM_FD, wmp.MSG_SPAWN_REQ, 0, 0, 0);
            }
        }
    }
    return;
}

fn child_eof(t as *term.Term) as void {
    drain_ctl();
    sys.close(s.child_out);
    sys.close(s.child_ctl);
    if (s.child_in >= 0) { sys.close(s.child_in); }
    let is i64 as st with mut = 0;
    sys.wait(s.child_pid, &st);
    s.child_out = 0 - 1;
    s.child_ctl = 0 - 1;
    s.child_in = 0 - 1;
    s.child_pid = 0;
    g.prompt(t);
    g.show(t);
    return;
}
