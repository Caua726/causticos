// compositor/comp_scene.cst — the back-to-front composer. cblit_* + compose_rect
// read scene state from state.cst (CWin/CSurf/CDec arrays) and call into
// render.cst + wallpaper.cst for primitives.
use "comp_state.cst" as s;
use "comp_render.cst" as r;
use "comp_wallpaper.cst" as wp;
use "comp_fx.cst" as fx;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/wmproto/wmproto.cst" as wmp;
use "../lib/compo_proto/compo_proto.cst" as cp;

// Rasterise a TEXT window's content from its cell-grid segment (header + cols*
// rows i64 cells). Per cell: fill the 8x16 background, stamp the glyph; the
// cursor cell is inverted. Clipping is per-pixel so a partial re-compose only
// repaints the touched cells.
fn cblit_text(i as i64) as void {
    let is i64 as cx = s.cwins[i].x + s.BORDER;
    let is i64 as cy = s.cwins[i].y + s.BORDER + s.TITLE_H;
    let is *i64 as hdr = cast(*i64, s.surfs[i].seg_base);
    let is i64 as cols with mut = hdr[wmp.TXT_H_COLS];
    let is i64 as rows with mut = hdr[wmp.TXT_H_ROWS];
    if (cols <= 0 || rows <= 0) { return; }
    let is i64 as vis_cols = s.cwins[i].w / 8;
    let is i64 as vis_rows = s.cwins[i].h / 16;
    if (cols > vis_cols) { cols = vis_cols; }
    if (rows > vis_rows) { rows = vis_rows; }
    let is i64 as cur_col = hdr[wmp.TXT_H_CUR_COL];
    let is i64 as cur_row = hdr[wmp.TXT_H_CUR_ROW];
    let is i64 as cur_vis = hdr[wmp.TXT_H_CUR_VIS];
    let is *i64 as cells = cast(*i64, s.surfs[i].seg_base + wmp.TXT_HDR_CELLS * 8);
    let is i64 as base_bg = wmp.txt_cell_bg(cells[0]);
    let is i64 as gw = cols * 8;
    let is i64 as gh = rows * 16;
    if (gw < s.cwins[i].w) { r.cfill(cx + gw, cy, s.cwins[i].w - gw, s.cwins[i].h, base_bg); }
    if (gh < s.cwins[i].h) { r.cfill(cx, cy + gh, gw, s.cwins[i].h - gh, base_bg); }
    let is i64 as rr with mut = 0;
    while (rr < rows) {
        let is i64 as py = cy + rr * 16;
        if (py + 16 > s.clip_y0 && py < s.clip_y1) {
            let is i64 as cc with mut = 0;
            while (cc < cols) {
                let is i64 as px = cx + cc * 8;
                if (px + 8 > s.clip_x0 && px < s.clip_x1) {
                    let is i64 as cell = cells[rr * cols + cc];
                    let is i64 as ch = wmp.txt_cell_char(cell);
                    let is i64 as fg with mut = wmp.txt_cell_fg(cell);
                    let is i64 as bg with mut = wmp.txt_cell_bg(cell);
                    if (cur_vis == 1 && rr == cur_row && cc == cur_col) {
                        let is i64 as tmp = fg; fg = bg; bg = tmp;
                    }
                    r.cfill(px, py, 8, 16, bg);
                    if (ch != 0x20 && ch != 0) { r.cglyph(ch, px, py, fg); }
                }
                cc = cc + 1;
            }
        }
        rr = rr + 1;
    }
    return;
}

fn cblit_pixels(i as i64) as void {
    let is i64 as cx = s.cwins[i].x + s.BORDER;
    let is i64 as cy = s.cwins[i].y + s.BORDER + s.TITLE_H;
    let is i64 as x0 with mut = cx;
    let is i64 as y0 with mut = cy;
    let is i64 as x1 with mut = cx + s.cwins[i].w;
    let is i64 as y1 with mut = cy + s.cwins[i].h;
    if (x0 < s.clip_x0) { x0 = s.clip_x0; }
    if (y0 < s.clip_y0) { y0 = s.clip_y0; }
    if (x1 > s.clip_x1) { x1 = s.clip_x1; }
    if (y1 > s.clip_y1) { y1 = s.clip_y1; }
    if (x1 <= x0 || y1 <= y0) { return; }
    let is i64 as a = s.draw_alpha;
    if (a <= 0) { return; }
    if (a < 256) {
        let is i64 as by with mut = y0;
        while (by < y1) {
            let is *u32 as drow = cast(*u32, s.fb_base + by * s.scr_pitch);
            let is *u32 as srow = cast(*u32,
                s.surfs[i].seg_base + (by - cy) * s.surfs[i].seg_stride);
            let is i64 as bx with mut = x0;
            while (bx < x1) {
                let is i64 as raw = cast(i64, srow[bx - cx]);
                let is i64 as sp with mut = raw;
                if (s.gam_on == 1) {
                    sp = (s.gam_lut[(raw >> 16) & 0xFF] << 16)
                       | (s.gam_lut[256 + ((raw >> 8) & 0xFF)] << 8)
                       |  s.gam_lut[512 + (raw & 0xFF)];
                }
                let is i64 as d = cast(i64, drow[bx]);
                let is i64 as dr = (d >> 16) & 0xFF;
                let is i64 as dg = (d >> 8) & 0xFF;
                let is i64 as db = d & 0xFF;
                drow[bx] = cast(u32, (((dr + (((sp >> 16) & 0xFF) - dr) * a / 256) & 0xFF) << 16)
                                   | (((dg + (((sp >> 8) & 0xFF) - dg) * a / 256) & 0xFF) << 8)
                                   |  ((db + ((sp & 0xFF) - db) * a / 256) & 0xFF));
                bx = bx + 1;
            }
            by = by + 1;
        }
        return;
    }
    // Night light has to reach a client's own pixels too, or a pixel-surface
    // window stays daylight-white on a warmed desktop. Costs the row copy, so
    // it is only taken while the LUT is actually tinting.
    if (s.gam_on == 1) {
        let is i64 as gy with mut = y0;
        while (gy < y1) {
            let is *u32 as grow = cast(*u32, s.fb_base + gy * s.scr_pitch);
            let is *u32 as gsrc = cast(*u32,
                s.surfs[i].seg_base + (gy - cy) * s.surfs[i].seg_stride);
            let is i64 as gx with mut = x0;
            while (gx < x1) {
                let is i64 as sp = cast(i64, gsrc[gx - cx]);
                grow[gx] = cast(u32, (s.gam_lut[(sp >> 16) & 0xFF] << 16)
                                   | (s.gam_lut[256 + ((sp >> 8) & 0xFF)] << 8)
                                   |  s.gam_lut[512 + (sp & 0xFF)]);
                gx = gx + 1;
            }
            gy = gy + 1;
        }
        return;
    }
    let is i64 as nbytes = (x1 - x0) * 4;
    let is i64 as yy with mut = y0;
    while (yy < y1) {
        let is i64 as dst = s.fb_base + yy * s.scr_pitch + x0 * 4;
        let is i64 as src = s.surfs[i].seg_base + (yy - cy) * s.surfs[i].seg_stride + (x0 - cx) * 4;
        wmp.copy_row(dst, src, nbytes);
        yy = yy + 1;
    }
    return;
}

fn cblit_content(i as i64) as void {
    if (s.surfs[i].has == 0) {
        r.cfill(s.cwins[i].x + s.BORDER, s.cwins[i].y + s.BORDER + s.TITLE_H,
                s.cwins[i].w, s.cwins[i].h, 0x00101418);
        return;
    }
    if (s.surfs[i].is_text == 1) { cblit_text(i); } else { cblit_pixels(i); }
    return;
}

// maxw caps the strip at the width it is being drawn into. The WM rasterises a
// titlebar for the window's SETTLED width; while a tween shrinks the frame the
// strip must not spill past the narrower border.
fn cblit_dec(seg_base as i64, ox as i64, oy as i64, maxw as i64) as void {
    let is *i64 as hdr = cast(*i64, seg_base);
    let is i64 as cols with mut = hdr[cp.DEC_H_COLS];
    let is i64 as rows = hdr[cp.DEC_H_ROWS];
    if (maxw >= 0 && cols > maxw / 8) { cols = maxw / 8; }
    if (cols <= 0 || rows <= 0) { return; }
    let is *i64 as cells = cast(*i64, seg_base + cp.DEC_HDR_CELLS * 8);
    let is i64 as rr with mut = 0;
    while (rr < rows) {
        let is i64 as py = oy + rr * 16;
        if (py + 16 > s.clip_y0 && py < s.clip_y1) {
            let is i64 as cc with mut = 0;
            while (cc < cols) {
                let is i64 as px = ox + cc * 8;
                if (px + 8 > s.clip_x0 && px < s.clip_x1) {
                    let is i64 as cell = cells[rr * cols + cc];
                    let is i64 as ch = wmp.txt_cell_char(cell);
                    let is i64 as fg = wmp.txt_cell_fg(cell);
                    let is i64 as bg = wmp.txt_cell_bg(cell);
                    r.cfill(px, py, 8, 16, bg);
                    if (ch != 0x20 && ch != 0) { r.cglyph(ch, px, py, fg); }
                }
                cc = cc + 1;
            }
        }
        rr = rr + 1;
    }
    return;
}

fn compose_rect(rx as i64, ry as i64, rw as i64, rh as i64) as void {
    s.clip_x0 = rx; s.clip_y0 = ry; s.clip_x1 = rx + rw; s.clip_y1 = ry + rh;
    if (s.clip_x0 < 0) { s.clip_x0 = 0; }
    if (s.clip_y0 < 0) { s.clip_y0 = 0; }
    if (s.clip_x1 > s.scr_w) { s.clip_x1 = s.scr_w; }
    if (s.clip_y1 > s.scr_h) { s.clip_y1 = s.scr_h; }
    if (s.clip_x1 <= s.clip_x0 || s.clip_y1 <= s.clip_y0) { return; }
    if (s.wp_ok == 1) { wp.wp_blit(); } else { r.cfill(0, 0, s.scr_w, s.scr_h, s.COL_DESKTOP); }
    let is i64 as zi with mut = 0;
    while (zi < s.comp_nz) {
        let is i64 as i = s.comp_z[zi];
        if (s.cwins[i].used == 1 && (s.cwins[i].flags & cp.ENTRY_MINIMIZED) == 0) {
            // The WM sends how focused this window LOOKS (0..255), not just
            // whether it is focused, so a focus change ramps instead of
            // snapping. Mixing two palette entries stays the compositor's job.
            let is i64 as fb = s.cwins[i].fblend;
            let is i64 as bcol with mut = r.mix(s.COL_BORDER_U, s.COL_BORDER_F, fb);
            let is i64 as tcol with mut = r.mix(s.COL_TITLE_U, s.COL_TITLE_F, fb);
            // Everything this window paints blends at its opacity against what
            // is already composed under it — painter's order makes that correct
            // alpha without a scratch buffer.
            s.draw_alpha = s.cwins[i].alpha;
            r.draw_shadow(s.cwins[i].x, s.cwins[i].y,
                          s.cwins[i].w + 2 * s.BORDER, s.cwins[i].h + s.TITLE_H + 2 * s.BORDER);
            s.draw_alpha = s.cwins[i].alpha;
            r.cfill(s.cwins[i].x, s.cwins[i].y,
                    s.cwins[i].w + 2 * s.BORDER, s.cwins[i].h + s.TITLE_H + 2 * s.BORDER, bcol);
            r.cfill(s.cwins[i].x + s.BORDER, s.cwins[i].y + s.BORDER,
                    s.cwins[i].w, s.TITLE_H, tcol);
            r.draw_chamfer(s.cwins[i].x, s.cwins[i].y,
                           s.cwins[i].w + 2 * s.BORDER, s.cwins[i].h + s.TITLE_H + 2 * s.BORDER,
                           s.COL_BORDER_U);
            cblit_content(i);
            if (s.decs[i].has == 1) {
                cblit_dec(s.decs[i].seg_base,
                          s.cwins[i].x + s.BORDER, s.cwins[i].y + s.BORDER + (s.TITLE_H - 16) / 2,
                          s.cwins[i].w);
            }
            s.draw_alpha = 256;
        }
        zi = zi + 1;
    }
    // Overlay chrome sits above every window and below the taskbar/cursor.
    let is i64 as ov with mut = 0;
    while (ov < 2) {
        if (s.ovl_on[ov] == 1) {
            let is i64 as oc with mut = s.COL_BORDER_F;
            if (ov == cp.OVL_SNAP) { oc = s.COL_TEXT; }
            r.draw_outline(s.ovl_rect[ov*4+0], s.ovl_rect[ov*4+1],
                           s.ovl_rect[ov*4+2], s.ovl_rect[ov*4+3], oc);
        }
        ov = ov + 1;
    }
    r.cfill(0, s.scr_h - s.BAR_H, s.scr_w, s.BAR_H, s.COL_BAR);
    r.cfill(0, s.scr_h - s.BAR_H, s.scr_w, 1, s.COL_BORDER_U);
    if (s.tb_dec.has == 1) {
        cblit_dec(s.tb_dec.seg_base, 0, s.scr_h - s.BAR_H + (s.BAR_H - 16) / 2, 0 - 1);
    }
    let is i64 as ea = fx.edge_alpha();
    if (ea > 0) {
        let is i64 as keep = s.draw_alpha;
        s.draw_alpha = ea;
        r.cfill(0, 0, s.scr_w, 2, s.COL_BORDER_F);
        r.cfill(0, s.scr_h - 2, s.scr_w, 2, s.COL_BORDER_F);
        r.cfill(0, 0, 2, s.scr_h, s.COL_BORDER_F);
        r.cfill(s.scr_w - 2, 0, 2, s.scr_h, s.COL_BORDER_F);
        s.draw_alpha = keep;
    }
    r.draw_cursor_at(s.mx, s.my);
    return;
}

fn _prof_rect(x as i64, y as i64, w as i64, h as i64) as void {
    let is i64 as t0 = sys.time_ns();
    compose_rect(x, y, w, h);
    let is i64 as t1 = sys.time_ns();
    sys.present(s.fb_fd, x, y, w, h);
    let is i64 as t2 = sys.time_ns();
    s.prof_compose_ns = s.prof_compose_ns + (t1 - t0);
    s.prof_present_ns = s.prof_present_ns + (t2 - t1);
    s.prof_px = s.prof_px + w * h;
    s.prof_rects = s.prof_rects + 1;
    return;
}

fn flush_damage() as void {
    s.prof_frames = s.prof_frames + 1;
    if (s.dmg_full == 1) {
        _prof_rect(0, 0, s.scr_w, s.scr_h);
    } else {
        let is i64 as k with mut = 0;
        while (k < s.dmg_n) {
            _prof_rect(s.dmg[k*4+0], s.dmg[k*4+1], s.dmg[k*4+2], s.dmg[k*4+3]);
            k = k + 1;
        }
    }
    s.dmg_n = 0;
    s.dmg_full = 0;
    s.needs_compose = 0;
    return;
}

// shutdown_screen — paint the "causticos / Shutting down..." notice directly
// to the framebuffer, then present. Called once after MSG_WC_SHUTDOWN.
fn shutdown_screen() as void {
    s.clip_x0 = 0; s.clip_y0 = 0; s.clip_x1 = s.scr_w; s.clip_y1 = s.scr_h;
    r.cfill(0, 0, s.scr_w, s.scr_h, 0x00000000);
    let is i64 as cx = s.scr_w / 2;
    let is i64 as cy = s.scr_h / 2;
    let is i64 as sc = 5;
    let is i64 as wx = cx - (9 * 8 * sc) / 2;
    let is i64 as wy = cy - 16 * sc - 10;
    r.gtext_big(cast(*u8, "causticos"), 9, wx + 3, wy + 4, 0x00102838, sc);
    r.gtext_big(cast(*u8, "causticos"), 9, wx, wy, 0x0073d0ff, sc);
    r.gtext_big(cast(*u8, "Shutting down..."), 16, cx - (16 * 8 * 2) / 2, cy + 24, 0x008a929c, 2);
    sys.present(s.fb_fd, 0, 0, s.scr_w, s.scr_h);
    return;
}
