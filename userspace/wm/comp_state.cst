// compositor/state.cst — all compositor globals + per-window/frame/decor
// structs + palette. Pure data; functions live in dedicated per-domain files.

struct CWin {
    used as i64;
    flags as i64;
    x as i64;
    y as i64;
    w as i64;
    h as i64;
    alpha as i64;         // 0..256, 256 = opaque (from the scene entry's flags)
    fblend as i64;        // 0..255 between the unfocused and focused palette
}

struct CSurf {
    has as i64;
    seg_fd as i64;
    seg_base as i64;
    seg_pages as i64;
    seg_stride as i64;
    is_text as i64;
}

struct CDec {
    has as i64;
    seg_fd as i64;
    seg_base as i64;
    seg_pages as i64;
}

// One pointer device the compositor opened, carrying the accel parameters
// bound to THAT device. Two mice can feel different: config is matched by
// identity (class/index/vendor/product/name via SYS_DEV_INFO), never applied
// globally. is_abs devices (tablet) report a position, so they carry no gain.
struct Ptr {
    fd as i64;
    class as i64;
    index as i64;
    vendor as i64;
    product as i64;
    is_abs as i64;
    profile as i64;        // 0 = flat, 1 = adaptive
    base as i64;
    threshold as i64;
    vmax as i64;
    max as i64;
    flat as i64;
    rem_x as i64;          // sub-pixel remainder, carried per device
    rem_y as i64;
}

let is i64 as IMG_CAP with imut = 4194304;

let is i64 as MAX_WIN  with imut = 8;
let is i64 as TITLE_H  with imut = 20;
let is i64 as BORDER   with imut = 1;
let is i64 as FRAME_NS with imut = 16666667;
let is i64 as BTN_W    with imut = 24;

let is i64 as COL_DESKTOP  with imut = 0x00202830;
let is i64 as COL_BORDER_F with imut = 0x0073d0ff;
let is i64 as COL_BORDER_U with imut = 0x003a4048;
let is i64 as COL_TITLE_F  with imut = 0x002a3a4a;
let is i64 as COL_TITLE_U  with imut = 0x001c2228;
let is i64 as COL_TEXT     with imut = 0x00d3d7cf;
let is i64 as BAR_H        with imut = 26;
let is i64 as TASK_W       with imut = 150;
let is i64 as COL_BAR      with imut = 0x00161b21;
let is i64 as COL_BAR_ITEM with imut = 0x00262f38;

let is i64 as fb_fd    with mut = 0;
let is i64 as kbd_fd   with mut = 0;
let is i64 as cmd_fd   with mut = 0;
let is i64 as wc_fd    with mut = 0;

let is i64 as scr_w     with mut = 0;
let is i64 as scr_h     with mut = 0;
let is i64 as scr_pitch with mut = 0;
let is i64 as fb_base   with mut = 0;

let is i64 as wp_ok    with mut = 0;
let is i64 as wp_w     with mut = 0;
let is i64 as wp_h     with mut = 0;
let is i64 as wp_nchan with mut = 0;
let is i64 as wp_pix   with mut = 0;

let is i64 as mx       with mut = 0;
let is i64 as my       with mut = 0;
let is i64 as mbuttons with mut = 0;

let is i64 as ACCEL_UNIT      with imut = 256;    // gain fixed-point unit (256 = 1.0x); structural
// Compiled defaults. /var/wm/pointer.cst can override them globally (keys
// before any `device` line) or per device (keys inside a `device` section).
// A device with no matching section runs on exactly these.
let is i64 as ACCEL_BASE      with mut = 200;     // slow-speed gain (~0.78x, precise)
let is i64 as ACCEL_THRESHOLD with mut = 2;       // v at/below which gain stays at BASE
let is i64 as ACCEL_VMAX      with mut = 40;      // v at/above which gain saturates at MAX
let is i64 as ACCEL_MAX       with mut = 1280;    // top gain (5.0x, fast flick)
let is i64 as ACCEL_FLAT_GAIN with mut = 256;     // FLAT profile gain (1.0x)
let is i64 as accel_profile   with mut = 1;

// The pointers the compositor holds. Filled by ptr_open_all() from
// SYS_QUERY_DEVS, so a second mouse is a real second entry, not an alias.
let is i64 as PTR_MAX with imut = 4;
let is [4]Ptr as ptrs with mut;
let is i64 as ptr_n with mut = 0;
let is [128]u8 as ptr_names with mut;             // 4 x 32, NUL-padded, from SYS_DEV_INFO

// Live animation count from the last frame's tick_all (lib/anim). Effects that
// read an animated value damage their own rects; the tick damages nothing.
let is i64 as anim_live with mut = 0;

let is i64 as shutdown_sent with mut = 0;

let is i64 as wc_fill with mut = 0;
let is [32]u8 as wc_acc with mut;

let is [8]CWin as cwins with mut;
let is [8]i64 as comp_z with mut;
let is i64 as comp_nz with mut = 0;
let is i64 as scene_pending with mut = 0;
let is i64 as needs_compose with mut = 0;

let is [8]CSurf as surfs with mut;
let is [8]CDec as decs with mut;
let is CDec as tb_dec with mut;

let is i64 as cur_shape with mut = 0;
let is i64 as cur_last_x with mut = 0;
let is i64 as cur_last_y with mut = 0;

let is [32]i64 as dmg with mut;
let is i64 as dmg_n with mut = 0;
let is i64 as dmg_full with mut = 0;

// Current draw opacity, 0..256 (256 = opaque). Read by the primitives in
// comp_render, the same "current draw state" shape the clip box below already
// uses — the alternative was an extra argument on every cfill/cglyph call site.
let is i64 as draw_alpha with mut = 256;

// Cursor shimmer: a 3-frame cycle at 4 Hz, so the pointer is never a dead
// sprite. Phase advances in comp_fx; the shape itself is unchanged.
let is i64 as cur_phase with mut = 0;
let is i64 as cur_phase_ns with mut = 0;

// Colour temperature (night light): a per-channel 256-entry LUT, applied to
// every colour the compositor draws. gam_on stays 0 until the first build so a
// boot before the RTC answers is not tinted.
let is [768]i64 as gam_lut with mut;     // r 0..255 | g 256..511 | b 512..767
let is i64 as gam_on with mut = 0;
let is i64 as gam_hour with mut = 0 - 1;

// Wallpaper parallax: the desktop slides a few px against cursor motion.
let is i64 as wp_off_x with mut = 0;
let is i64 as wp_off_y with mut = 0;
// Procedural wallpaper (when no CSIF is on disk): a small HSL tile the blitter
// scales up, re-baked once a second so the gradient drifts.
let is i64 as wp_gen_on with mut = 0;
let is i64 as wp_gen_next with mut = 0;
let is [15552]u8 as wp_gen with mut;     // 96 x 54 x 3
// One scaled wallpaper row, reused for the ~15 screen rows that share a source
// row. 8 KB buys back most of a full-screen repaint; see wp_blit.
let is [2048]u32 as wp_row with mut;

// Screen-edge accent pulse on a focus change.
let is i64 as edge_anim with mut = 0 - 1;
let is i64 as edge_last with mut = 0 - 1;

// Overlay chrome (drag outline, snap ghost): on-flag + rect per slot, flat.
let is [2]i64 as ovl_on with mut;
let is [8]i64 as ovl_rect with mut;      // slot*4 + {x, y, w, h}

let is i64 as clip_x0 with mut = 0;
let is i64 as clip_y0 with mut = 0;
let is i64 as clip_x1 with mut = 0;
let is i64 as clip_y1 with mut = 0;

let is i64 as mod_shift with mut = 0;
let is i64 as mod_ctrl  with mut = 0;
let is i64 as mod_alt   with mut = 0;
let is i64 as mod_super with mut = 0;

let is i64 as CUR_W with imut = 10;
let is i64 as CUR_H with imut = 16;
let is [16]i64 as cur_o with mut;
let is [16]i64 as cur_f with mut;
let is i64 as CUR_ARROW with imut = 0;
let is i64 as CUR_EW    with imut = 1;
let is i64 as CUR_NS    with imut = 2;
let is i64 as CUR_NWSE  with imut = 3;
let is i64 as CUR_NESW  with imut = 4;
let is i64 as CUR_IBEAM with imut = 5;
let is i64 as CUR_MOVE  with imut = 6;
let is i64 as CUR_BLACK with imut = 0x00101010;
let is i64 as CUR_WHITE with imut = 0x00FFFFFF;
