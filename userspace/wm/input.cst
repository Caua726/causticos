// wm/input.cst — drain the compositor's CMD channel. The channel is 32-byte
// fixed messages (mtype + 3 args). Read in a tight loop until POLL says empty.

use "state.cst" as s;
use "damage.cst" as dmg;
use "mouse.cst" as mouse;
use "keyboard.cst" as kbd;
use "../lib/compo_proto.cst" as cp;
use "../lib/wmproto.cst" as wmp;
use "../../../Caustic/std/os/causticos.cst" as sys;

fn handle_ptr_event(nx as i64, ny as i64, nb as i64) as void {
    dmg.dmg_add(s.mx - 13, s.my - 13, 28, 32);
    s.mx = nx; s.my = ny;
    if (nb != s.mbuttons) { mouse.mouse_buttons(s.mbuttons, nb); }
    mouse.mouse_apply_motion();
    return;
}

fn handle_key_event(keysym as i64, kb as i64, sc as i64) as void {
    kbd.key_handle(keysym, kb, sc);
    return;
}

fn handle_wheel_event(delta as i64) as void {
    if (s.nz > 0) {
        let is [3]i64 as ce;
        ce[0] = s.wins[s.zord[0]].chan;
        ce[1] = sys.POLL_WRITABLE;
        ce[2] = 0;
        sys.poll(&ce[0], 1, 0);
        if ((ce[2] & sys.POLL_WRITABLE) != 0) {
            cp.msg_send(s.wins[s.zord[0]].chan, wmp.MSG_MOUSE_WHEEL,
                         delta, 0, 0);
        }
    }
    return;
}

fn handle_shutdown_req() as void {
    if (s.shutdown_state != 0) { return; }
    s.shutdown_state = 1;
    s.shutdown_deadline = sys.time_ns() + 2000000000;
    let is i64 as si with mut = 0;
    while (si < s.MAX_WIN) {
        if (s.wins[si].used == 1) { s.wins[si].pend_close = 1; }
        si = si + 1;
    }
    return;
}

fn handle_scr_ready(w as i64, h as i64) as void {
    s.scr_w = w;
    s.scr_h = h;
    s.work_h = s.scr_h - s.BAR_H;
    s.have_geom = 1;
    return;
}

// Service the CMD channel: read until POLL would block. Returns 0 normal,
// -1 if the compositor channel closed.
fn service_cmd() as i64 {
    let is [4]i64 as m;
    let is i64 as guard with mut = 0;
    while (1 == 1) {
        let is i64 as r = cp.msg_read(s.cmd_fd, &s.cmd_fill, cast(*u8, &s.cmd_acc[0]), &m[0]);
        if (r < 0) { return 0 - 1; }
        if (r == 0) { return 0; }
        if (m[0] == cp.MSG_CP_SCR_READY) {
            handle_scr_ready(m[1], m[2]);
        } else if (m[0] == cp.MSG_CP_KEY) {
            handle_key_event(m[1], m[2], m[3]);
        } else if (m[0] == cp.MSG_CP_PTR) {
            handle_ptr_event(m[1], m[2], m[3]);
        } else if (m[0] == cp.MSG_CP_WHEEL) {
            handle_wheel_event(m[1]);
        } else if (m[0] == cp.MSG_CP_SHUTDOWN_REQ) {
            handle_shutdown_req();
        }
        guard = guard + 1;
        if (guard > 128) { return 0; }
        let is [3]i64 as pe2;
        pe2[0] = s.cmd_fd;
        pe2[1] = sys.POLL_READABLE;
        pe2[2] = 0;
        sys.poll(&pe2[0], 1, 0);
        if ((pe2[2] & sys.POLL_READABLE) == 0) { return 0; }
    }
    return 0;
}
