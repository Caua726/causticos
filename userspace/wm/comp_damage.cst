// compositor/comp_damage.cst — damage rect accumulator + flush_damage.
// Owns no state; reads/mutates the dmg[] rect list + the must-compose flag in
// state.cst.
use "comp_state.cst" as s;
use "../../../Caustic/std/os/causticos.cst" as sys;

fn damage(x as i64, y as i64, w as i64, h as i64) as void {
    if (s.dmg_full == 1) { return; }
    let is i64 as x0 with mut = x;
    let is i64 as y0 with mut = y;
    let is i64 as x1 with mut = x + w;
    let is i64 as y1 with mut = y + h;
    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    if (x1 > s.scr_w) { x1 = s.scr_w; }
    if (y1 > s.scr_h) { y1 = s.scr_h; }
    if (x1 <= x0 || y1 <= y0) { return; }
    let is i64 as k with mut = 0;
    while (k < s.dmg_n) {
        let is i64 as ex0 = s.dmg[k*4+0];
        let is i64 as ey0 = s.dmg[k*4+1];
        let is i64 as ex1 = ex0 + s.dmg[k*4+2];
        let is i64 as ey1 = ey0 + s.dmg[k*4+3];
        if (x0 < ex1 && x1 > ex0 && y0 < ey1 && y1 > ey0) {
            let is i64 as nx0 with mut = x0;
            let is i64 as ny0 with mut = y0;
            let is i64 as nx1 with mut = x1;
            let is i64 as ny1 with mut = y1;
            if (ex0 < nx0) { nx0 = ex0; }
            if (ey0 < ny0) { ny0 = ey0; }
            if (ex1 > nx1) { nx1 = ex1; }
            if (ey1 > ny1) { ny1 = ey1; }
            s.dmg[k*4+0] = nx0;
            s.dmg[k*4+1] = ny0;
            s.dmg[k*4+2] = nx1 - nx0;
            s.dmg[k*4+3] = ny1 - ny0;
            s.needs_compose = 1;
            return;
        }
        k = k + 1;
    }
    if (s.dmg_n >= 8) { s.dmg_full = 1; s.needs_compose = 1; return; }
    s.dmg[s.dmg_n * 4 + 0] = x0;
    s.dmg[s.dmg_n * 4 + 1] = y0;
    s.dmg[s.dmg_n * 4 + 2] = x1 - x0;
    s.dmg[s.dmg_n * 4 + 3] = y1 - y0;
    s.dmg_n = s.dmg_n + 1;
    s.needs_compose = 1;
    return;
}

fn damage_all() as void { s.dmg_full = 1; s.needs_compose = 1; return; }
