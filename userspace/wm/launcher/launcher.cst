// launcher/main.cst — orchestrator for the Launcher app. Owns main(); all the
// helper logic lives in state.cst / render.cst / apps.cst.
use "state.cst" as s;
use "render.cst" as r;
use "apps.cst" as a;
use "std/os/causticos.cst" as sys;
use "../../lib/wmproto/wmproto.cst" as wmp;
use "../../lib/compo_proto/compo_proto.cst" as cp;
use "../../lib/keymap/keysym.cst" as ks;

fn commit_full() as void {
    wmp.msg_send(wmp.WM_FD, wmp.MSG_COMMIT, 0, 0, wmp.pack_wh(s.win_w, s.win_h));
    return;
}

// launch — ask the WM to spawn app idx: send "<base>.cse" via MSG_SPAWN_NAMED.
fn launch(idx as i64) as void {
    let is i64 as blen = s.name_len[idx];
    let is [16]u8 as full;
    let is i64 as k with mut = 0;
    while (k < blen && k < 12) { full[k] = s.names[idx * s.NAMEW + k]; k = k + 1; }
    let is *u8 as ext = ".cse";
    let is i64 as e with mut = 0;
    while (e < 4) { full[k + e] = ext[e]; e = e + 1; }
    let is i64 as flen = k + 4;
    let is [2]i64 as tb;
    wmp.title_pack(cast(*u8, &full[0]), flen, &tb[0], &tb[1]);
    wmp.msg_send(wmp.WM_FD, wmp.MSG_SPAWN_NAMED, flen, tb[0], tb[1]);
    return;
}

// _named — app idx is called `nm`.
fn _named(idx as i64, nm as *u8) as i64 {
    let is i64 as n = s.name_len[idx];
    let is i64 as k with mut = 0;
    while (k < n) {
        if (nm[k] == 0 || s.names[idx * s.NAMEW + k] != nm[k]) { return 0; }
        k = k + 1;
    }
    if (nm[n] != 0) { return 0; }
    return 1;
}

// activate — what a click on app idx does. Powering off or restarting from a
// launcher used to take one click, the moment the button went down; those two
// now ask for a second click on the same tile first. Returns 1 when the tiles
// need repainting.
fn activate(idx as i64) as i64 {
    if (_named(idx, "poweroff") == 1 || _named(idx, "reboot") == 1) {
        let is i64 as now = sys.time_ns();
        if (s.confirm_idx == idx && now < s.confirm_until) {
            s.confirm_idx = 0 - 1;
            launch(idx);
            return 1;
        }
        s.confirm_idx = idx;
        s.confirm_until = now + s.CONFIRM_NS;
        return 1;
    }
    let is i64 as was = s.confirm_idx;
    s.confirm_idx = 0 - 1;
    launch(idx);
    if (was >= 0) { return 1; }
    return 0;
}

fn main() as i32 {
    let is [4]i64 as m;
    let is [32]u8 as acc;
    let is i64 as fill with mut = 0;
    let is i64 as got with mut = 0;
    while (got != 1) {
        got = wmp.msg_read(wmp.WM_FD, &fill, cast(*u8, &acc[0]), &m[0]);
        if (got < 0) { return 1; }
    }
    if (m[0] != wmp.MSG_WELCOME) { return 1; }
    let is i64 as screen_w = m[1];
    s.win_w = wmp.unpack_w(m[3]);
    s.win_h = wmp.unpack_h(m[3]);
    s.seg_stride = screen_w * 4;

    let is i64 as npages = (screen_w * m[2] * 4 + 4095) / 4096;
    let is i64 as seg = sys.seg_create(npages, 0);
    if (seg < 0) { return 2; }
    let is i64 as va = sys.mmap_fd(sys.PROT_READ | sys.PROT_WRITE, seg);
    if (va < 0) { return 2; }
    s.seg_base = va;
    if (sys.fd_send(wmp.WM_FD, seg) != 0) { return 3; }
    wmp.msg_send(wmp.WM_FD, wmp.MSG_HELLO, npages, s.seg_stride, wmp.PROTO_VER);
    let is [2]i64 as tb;
    wmp.title_pack(cast(*u8, "Launcher"), 8, &tb[0], &tb[1]);
    wmp.msg_send(wmp.WM_FD, wmp.MSG_SET_TITLE, 8, tb[0], tb[1]);

    a.scan_apps();
    r.paint();
    commit_full();

    let is i64 as mb_prev with mut = 0;
    let is i64 as press_idx with mut = 0 - 1;   // the tile the button went down on
    let is i64 as dirty with mut = 0;
    let is [3]i64 as pe;
    while (1 == 1) {
        pe[0] = wmp.WM_FD; pe[1] = sys.POLL_READABLE; pe[2] = 0;
        // A tile waiting for its second click wakes this when the wait is over,
        // to go back to what it was.
        let is i64 as tmo with mut = 0 - 1;
        if (s.confirm_idx >= 0) {
            tmo = s.confirm_until - sys.time_ns();
            if (tmo < 0) { tmo = 0; }
        }
        sys.poll(&pe[0], 1, tmo);
        if (s.confirm_idx >= 0 && sys.time_ns() >= s.confirm_until) {
            s.confirm_idx = 0 - 1;
            r.paint(); commit_full();
        }
        if ((pe[2] & (sys.POLL_READABLE | sys.POLL_CLOSED | sys.POLL_ERROR)) == 0) { continue; }
        let is i64 as r2 = wmp.msg_read(wmp.WM_FD, &fill, cast(*u8, &acc[0]), &m[0]);
        if (r2 < 0) { return 0; }
        if (r2 == 1) {
            dirty = 0;
            if (m[0] == wmp.MSG_MOUSE_BTN) {
                // A click is the button going down and coming back up on the
                // same tile; it fired on the way down, so a press meant for
                // somewhere else could not be taken back by moving off.
                let is i64 as btn = wmp.mouse_buttons(m[1]);
                if ((btn & 1) != 0 && (mb_prev & 1) == 0) { press_idx = a.hit(m[2], m[3]); }
                if ((btn & 1) == 0 && (mb_prev & 1) != 0) {
                    let is i64 as idx = a.hit(m[2], m[3]);
                    if (idx >= 0 && idx == press_idx) { dirty = activate(idx); }
                    press_idx = 0 - 1;
                }
                mb_prev = btn;
            } else if (m[0] == wmp.MSG_MOUSE_WHEEL) {
                // delta > 0 is a notch UP, which shows EARLIER rows — hence the
                // subtraction. One row per notch.
                r.scroll_to(s.scroll - m[1]);
                dirty = 1;
            } else if (m[0] == wmp.MSG_RESIZE) {
                s.win_w = m[1]; s.win_h = m[2];
                // A taller window can leave the offset past the new end.
                r.scroll_to(s.scroll);
                dirty = 1;
            } else if (m[0] == wmp.MSG_KEY) {
                if (cp.key_pressed(m[2]) == 1) {
                    let is i64 as k = m[1];
                    // KEY_ESC, not 27: the compositor normalises Escape to a
                    // keysym in the 0x1000000 range and only characters
                    // arrive as their code point. Comparing against 27 matched
                    // nothing, so Escape did not close this window.
                    if (k == ks.KEY_ESC) {
                        wmp.msg_send(wmp.WM_FD, wmp.MSG_CLOSE, 0, 0, 0);
                        return 0;
                    }
                    let is i64 as page = r.rows_visible();
                    if (k == ks.KEY_DOWN) { r.scroll_to(s.scroll + 1); dirty = 1; }
                    else if (k == ks.KEY_UP) { r.scroll_to(s.scroll - 1); dirty = 1; }
                    else if (k == ks.KEY_PGDN) { r.scroll_to(s.scroll + page); dirty = 1; }
                    else if (k == ks.KEY_PGUP) { r.scroll_to(s.scroll - page); dirty = 1; }
                    else if (k == ks.KEY_HOME) { r.scroll_to(0); dirty = 1; }
                    else if (k == ks.KEY_END) { r.scroll_to(r.max_scroll()); dirty = 1; }
                }
            } else if (m[0] == wmp.MSG_CLOSE_REQ) {
                wmp.msg_send(wmp.WM_FD, wmp.MSG_CLOSE, 0, 0, 0);
                return 0;
            }
            if (dirty == 1) { r.paint(); commit_full(); }
        }
    }
    return 0;
}
