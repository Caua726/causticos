// launcher/main.cst — orchestrator for the Launcher app. Owns main(); all the
// helper logic lives in state.cst / render.cst / apps.cst.
use "state.cst" as s;
use "render.cst" as r;
use "apps.cst" as a;
use "std/os/causticos.cst" as sys;
use "../../lib/wmproto/wmproto.cst" as wmp;
use "../../lib/compo_proto/compo_proto.cst" as cp;
use "../../lib/keymap/keysym.cst" as ks;

use "std/unicode/utf8.cst" as utf8;
use "../../lib/futil/futil.cst" as fu;
fn commit_full() as void {
    wmp.msg_send(wmp.WM_FD, wmp.MSG_COMMIT, 0, 0, wmp.pack_wh(s.win_w, s.win_h));
    return;
}

// The complete directory filename travels in a segment, not title bytes.
fn launch(idx as i64) as void {
    s.action_idx = idx;
    s.action_error = wmp.spawn_named(s.name(idx), s.app(idx).name_len + 4);
    return;
}

// _named — app idx is called `nm`.
fn _named(idx as i64, nm as *u8) as i64 {
    let is i64 as n = s.app(idx).name_len;
    let is i64 as k with mut = 0;
    while (k < n) {
        if (nm[k] == 0 || s.name(idx)[k] != nm[k]) { return 0; }
        k = k + 1;
    }
    if (nm[n] != 0) { return 0; }
    return 1;
}

// activate — what a click on app idx does. Powering off or restarting from a
// launcher used to take one click, the moment the button went down; those two
// now ask for a second click on the same tile first. Returns 1 when the tiles
// need repainting.
fn activate(idx as i64) as i64 {
    if (_named(idx, "poweroff") == 1 || _named(idx, "reboot") == 1) {
        let is i64 as now = sys.time_ns();
        if (s.confirm_idx == idx && now < s.confirm_until) {
            s.confirm_idx = 0 - 1;
            launch(idx);
            return 1;
        }
        s.confirm_idx = idx;
        s.confirm_until = now + s.CONFIRM_NS;
        return 1;
    }
    let is i64 as was = s.confirm_idx;
    let is i64 as had_error = s.action_error < 0;
    s.confirm_idx = 0 - 1;
    launch(idx);
    if (was >= 0 || had_error == 1 || s.action_error < 0) { return 1; }
    return 0;
}
fn select_view(view as i64) as i64 {
    let is i64 as count = s.visible_count();
    if (count <= 0) {
        s.selected_view = 0 - 1;
        s.detail_idx = 0 - 1;
        return 0;
    }
    let is i64 as target with mut = view;
    if (target < 0) { target = 0; }
    if (target >= count) { target = count - 1; }
    s.selected_view = target;
    let is i64 as idx = s.visible_app(target);
    s.detail_idx = idx;
    if (s.confirm_idx >= 0 && s.confirm_idx != idx) { s.confirm_idx = 0 - 1; }
    let is i64 as row = target / r.cols_per_row();
    if (row < s.scroll) { r.scroll_to(row); }
    else if (row >= s.scroll + r.rows_visible()) {
        r.scroll_to(row - r.rows_visible() + 1);
    }
    return 1;
}

fn move_selection(key as i64) as i64 {
    let is i64 as count = s.visible_count();
    if (count <= 0) { return select_view(0 - 1); }
    let is i64 as cols = r.cols_per_row();
    let is i64 as current with mut = s.selected_view;
    if (current < 0 || current >= count) { current = 0; }
    let is i64 as target with mut = current;
    if (key == ks.KEY_LEFT && current % cols > 0) { target = current - 1; }
    else if (key == ks.KEY_RIGHT && current % cols + 1 < cols && current + 1 < count) {
        target = current + 1;
    } else if (key == ks.KEY_UP && current >= cols) { target = current - cols; }
    else if (key == ks.KEY_DOWN && current + cols < count) { target = current + cols; }
    else if (key == ks.KEY_PGUP) { target = current - r.rows_visible() * cols; }
    else if (key == ks.KEY_PGDN) { target = current + r.rows_visible() * cols; }
    else if (key == ks.KEY_HOME) { target = 0; }
    else if (key == ks.KEY_END) { target = count - 1; }
    if (target < 0) { target = 0; }
    if (target >= count) { target = count - 1; }
    if (target == s.selected_view) { return 0; }
    return select_view(target);
}


fn edit_search(key as i64, mods as i64) as i64 {
    if (key != ks.KEY_BACKSPACE && ((mods & ks.MOD_CTRL) != 0 || (mods & ks.MOD_ALT) != 0
        || (mods & ks.MOD_SUPER) != 0)) { return 0; }
    if (key == ks.KEY_BACKSPACE) {
        if (s.search_query.len == 0) { return 0; }
        let is *u8 as query = cast(*u8, s.search_query.va);
        let is i64 as cut with mut = s.search_query.len - 1;
        while (cut > 0 && (cast(i64, query[cut]) & 0xC0) == 0x80) { cut = cut - 1; }
        s.search_query.len = cut;
        a.rebuild_search();
    } else if (key >= 0x20 && key < 0x110000 && (key < 0xD800 || key > 0xDFFF)) {
        let is i64 as old_len = s.search_query.len;
        let is i64 as rc = fu.line_reserve(&s.search_query, old_len + 4);
        if (rc < 0) {
            s.search_error = rc;
            s.search_count = 0;
            s.selected_view = 0 - 1;
            s.detail_idx = 0 - 1;
            s.scroll = 0;
            s.confirm_idx = 0 - 1;
            return 1;
        }
        let is i64 as n = utf8.encode1(cast(i32, key), cast(*u8, s.search_query.va + old_len));
        if (n < 0) { return 0; }
        s.search_query.len = old_len + n;
        a.rebuild_search();
    } else {
        return 0;
    }
    s.scroll = 0;
    s.confirm_idx = 0 - 1;
    select_view(0);
    return 1;
}

fn main() as i32 {
    let is [4]i64 as m;
    let is [32]u8 as acc;
    let is i64 as fill with mut = 0;
    let is i64 as got with mut = 0;
    while (got != 1) {
        got = wmp.msg_read(wmp.WM_FD, &fill, cast(*u8, &acc[0]), &m[0]);
        if (got < 0) { return 1; }
    }
    if (m[0] != wmp.MSG_WELCOME) { return 1; }
    let is i64 as screen_w = m[1];
    s.win_w = wmp.unpack_w(m[3]);
    s.win_h = wmp.unpack_h(m[3]);
    s.seg_stride = screen_w * 4;

    let is i64 as npages = (screen_w * m[2] * 4 + 4095) / 4096;
    let is i64 as seg = sys.seg_create(npages, 0);
    if (seg < 0) { return 2; }
    let is i64 as va = sys.mmap_fd(sys.PROT_READ | sys.PROT_WRITE, seg);
    if (va < 0) { return 2; }
    s.seg_base = va;
    if (sys.fd_send(wmp.WM_FD, seg) != 0) { return 3; }
    wmp.msg_send(wmp.WM_FD, wmp.MSG_HELLO, npages, s.seg_stride, wmp.PROTO_VER);
    wmp.msg_send(wmp.WM_FD, wmp.MSG_POINTER_TRACK, 1, 0, 0);
    let is [2]i64 as tb;
    wmp.title_pack(cast(*u8, "Launcher"), 8, &tb[0], &tb[1]);
    wmp.msg_send(wmp.WM_FD, wmp.MSG_SET_TITLE, 8, tb[0], tb[1]);

    a.scan_apps();
    a.load_descriptions();
    if (s.visible_count() > 0) { select_view(0); }
    a.load_visible_icons();
    r.paint();
    commit_full();

    let is i64 as mb_prev with mut = 0;
    let is i64 as press_idx with mut = 0 - 1;   // the tile the button went down on
    let is i64 as dirty with mut = 0;
    let is [3]i64 as pe;
    while (1 == 1) {
        pe[0] = wmp.WM_FD; pe[1] = sys.POLL_READABLE; pe[2] = 0;
        // A tile waiting for its second click wakes this when the wait is over,
        // to go back to what it was.
        let is i64 as tmo with mut = 0 - 1;
        if (s.confirm_idx >= 0) {
            tmo = s.confirm_until - sys.time_ns();
            if (tmo < 0) { tmo = 0; }
        }
        sys.poll(&pe[0], 1, tmo);
        if (s.confirm_idx >= 0 && sys.time_ns() >= s.confirm_until) {
            s.confirm_idx = 0 - 1;
            r.paint(); commit_full();
        }
        if ((pe[2] & (sys.POLL_READABLE | sys.POLL_CLOSED | sys.POLL_ERROR)) == 0) { continue; }
        let is i64 as r2 = wmp.msg_read(wmp.WM_FD, &fill, cast(*u8, &acc[0]), &m[0]);
        if (r2 < 0) { return 0; }
        if (r2 == 1) {
            dirty = 0;
            if (m[0] == wmp.MSG_MOUSE_BTN) {
                // A click is the button going down and coming back up on the
                // same tile; it fired on the way down, so a press meant for
                // somewhere else could not be taken back by moving off.
                let is i64 as btn = wmp.mouse_buttons(m[1]);
                s.pointer_x = m[2]; s.pointer_y = m[3];
                let is i64 as view_hover = a.hit_view(m[2], m[3]);
                if (view_hover != s.hover_view) {
                    s.hover_view = view_hover; dirty = 1;
                }
                if ((btn & 1) != 0 && (mb_prev & 1) == 0) { press_idx = a.hit(m[2], m[3]); }
                if ((btn & 1) == 0 && (mb_prev & 1) != 0) {
                    let is i64 as idx = a.hit(m[2], m[3]);
                    if (idx >= 0 && idx == press_idx) {
                        let is i64 as view = a.hit_view(m[2], m[3]);
                        if (view >= 0 && view != s.selected_view) {
                            select_view(view); dirty = 1;
                        }
                        if (activate(idx) == 1) { dirty = 1; }
                    }
                    press_idx = 0 - 1;
                }
                mb_prev = btn;
            } else if (m[0] == wmp.MSG_MOUSE_MOVE) {
                s.pointer_x = m[2]; s.pointer_y = m[3];
                let is i64 as view_hover = a.hit_view(m[2], m[3]);
                if (view_hover != s.hover_view) {
                    s.hover_view = view_hover; dirty = 1;
                }
                let is i64 as idx = a.hit(m[2], m[3]);
                if (idx != s.detail_idx) { s.detail_idx = idx; dirty = 1; }
            } else if (m[0] == wmp.MSG_MOUSE_WHEEL) {
                // delta > 0 is a notch UP, which shows EARLIER rows — hence the
                // subtraction. One row per notch.
                s.pointer_x = m[2]; s.pointer_y = m[3];
                r.scroll_to(s.scroll - m[1]);
                dirty = 1;
            } else if (m[0] == wmp.MSG_RESIZE) {
                s.win_w = m[1]; s.win_h = m[2];
                // Keep keyboard focus visible when the grid dimensions change.
                if (s.selected_view >= 0) { select_view(s.selected_view); }
                r.scroll_to(s.scroll);
                dirty = 1;
            } else if (m[0] == wmp.MSG_KEY) {
                if (cp.key_pressed(m[2]) == 1) {
                    let is i64 as k = m[1];
                    // KEY_ESC, not 27: the compositor normalises Escape to a
                    // keysym in the 0x1000000 range and only characters
                    // arrive as their code point. Comparing against 27 matched
                    // nothing, so Escape did not close this window.
                    if (k == ks.KEY_ESC) {
                        if (s.search_query.len > 0 || s.search_error < 0) {
                            s.search_query.len = 0;
                            a.rebuild_search();
                            s.scroll = 0;
                            s.confirm_idx = 0 - 1;
                            select_view(0);
                            dirty = 1;
                        } else {
                            wmp.msg_send(wmp.WM_FD, wmp.MSG_CLOSE, 0, 0, 0);
                            return 0;
                        }
                    } else if (k == ks.KEY_ENTER) {
                        if (s.selected_view >= 0 && s.selected_view < s.visible_count()) {
                            dirty = activate(s.visible_app(s.selected_view));
                        }
                    } else if (k == ks.KEY_BACKSPACE) {
                        dirty = edit_search(k, cp.key_mods(m[2]));
                    } else if (k == ks.KEY_UP || k == ks.KEY_DOWN
                        || k == ks.KEY_LEFT || k == ks.KEY_RIGHT
                        || k == ks.KEY_PGUP || k == ks.KEY_PGDN
                        || k == ks.KEY_HOME || k == ks.KEY_END) {
                        dirty = move_selection(k);
                    } else {
                        dirty = edit_search(k, cp.key_mods(m[2]));
                    }
                }
            } else if (m[0] == wmp.MSG_CLOSE_REQ) {
                wmp.msg_send(wmp.WM_FD, wmp.MSG_CLOSE, 0, 0, 0);
                return 0;
            }
            if (dirty == 1) {
                if (m[0] != wmp.MSG_KEY) { s.detail_idx = a.hit(s.pointer_x, s.pointer_y); }
                s.hover_view = a.hit_view(s.pointer_x, s.pointer_y);
                a.load_visible_icons(); r.paint(); commit_full();
            }
        }
    }
    return 0;
}
