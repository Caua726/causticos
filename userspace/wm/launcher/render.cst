// launcher/render.cst — drawing primitives + tile/icon renderers. Pixel-buffer
// based (the launcher is a PIXEL-surface client, unlike the text-surface
// wterm).
use "state.cst" as s;
use "std/causticos/font.cst" as font;
use "std/unicode/utf8.cst" as utf8;
use "std/os/causticos.cst" as sys;
use "std/causticos/prog.cst" as prog;

fn gpix(x as i64, y as i64, color as i64) as void {
    if (x < 0 || y < 0 || x >= s.win_w || y >= s.win_h) { return; }
    if (s.paint_limit >= 0 && y >= s.paint_limit) { return; }
    let is *u32 as p = cast(*u32, s.seg_base + y * s.seg_stride + x * 4);
    p[0] = cast(u32, color);
    return;
}
fn gpix_alpha(x as i64, y as i64, color as i64, alpha as i64) as void {
    if (alpha == 0 || x < 0 || y < 0 || x >= s.win_w || y >= s.win_h) { return; }
    if (s.paint_limit >= 0 && y >= s.paint_limit) { return; }
    if (alpha == 255) { gpix(x, y, color); return; }
    let is *u32 as p = cast(*u32, s.seg_base + y * s.seg_stride + x * 4);
    let is i64 as bg = cast(i64, p[0]);
    let is i64 as inv = 255 - alpha;
    let is i64 as rr = (((color >> 16) & 255) * alpha + ((bg >> 16) & 255) * inv + 127) / 255;
    let is i64 as gg = (((color >> 8) & 255) * alpha + ((bg >> 8) & 255) * inv + 127) / 255;
    let is i64 as bb = ((color & 255) * alpha + (bg & 255) * inv + 127) / 255;
    p[0] = cast(u32, (rr << 16) | (gg << 8) | bb);
    return;
}
fn gfill(x as i64, y as i64, w as i64, h as i64, color as i64) as void {
    let is i64 as x0 with mut = x;
    let is i64 as y0 with mut = y;
    let is i64 as x1 with mut = x + w;
    let is i64 as y1 with mut = y + h;
    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    if (x1 > s.win_w) { x1 = s.win_w; }
    if (y1 > s.win_h) { y1 = s.win_h; }
    if (s.paint_limit >= 0 && y1 > s.paint_limit) { y1 = s.paint_limit; }
    let is i64 as yy with mut = y0;
    while (yy < y1) {
        let is *u32 as pixels = cast(*u32, s.seg_base + yy * s.seg_stride);
        let is i64 as xx with mut = x0;
        while (xx < x1) { pixels[xx] = cast(u32, color); xx = xx + 1; }
        yy = yy + 1;
    }
    return;
}
fn gglyph(ch as i64, px as i64, py as i64, color as i64, sc as i64) as void {
    let is *u8 as g = font.glyph(ch);
    let is i64 as row with mut = 0;
    while (row < 16) {
        let is i64 as bits = cast(i64, g[row]);
        let is i64 as col with mut = 0;
        while (col < 8) {
            if ((bits & (128 >> col)) != 0) {
                gfill(px + col * sc, py + row * sc, sc, sc, color);
            }
            col = col + 1;
        }
        row = row + 1;
    }
    return;
}
// Text is UTF-8: one glyph per character, a malformed byte drawn as U+FFFD.
fn gtext(s_in as *u8, len as i64, x as i64, y as i64, color as i64) as void {
    let is i64 as i with mut = 0;
    let is i64 as col with mut = 0;
    while (i < len) {
        let is [1]i32 as cp;
        let is i64 as n with mut = utf8.decode1(s_in, len, i, cast(*i32, &cp[0]));
        let is i64 as c with mut = cast(i64, cp[0]);
        if (n <= 0) { n = 1; c = 0xFFFD; }
        gglyph(c, x + col * 8, y, color, 1);
        col = col + 1;
        i = i + n;
    }
    return;
}

// Columns gtext takes for s_in: its characters, not its bytes.
fn text_cols(s_in as *u8, len as i64) as i64 {
    let is i64 as i with mut = 0;
    let is i64 as col with mut = 0;
    while (i < len) {
        let is [1]i32 as cp;
        let is i64 as n with mut = utf8.decode1(s_in, len, i, cast(*i32, &cp[0]));
        if (n <= 0) { n = 1; }
        col = col + 1;
        i = i + n;
    }
    return col;
}

// The grid geometry, defined once. apps.cst hit-tests against these same
// functions rather than recomputing the layout: a hit test that disagrees with
// the paint by one column launches the wrong program, silently.
fn cols_per_row() as i64 {
    let is i64 as c = (s.win_w - s.SBW) / s.TILE;
    if (c < 1) { return 1; }
    return c;
}

fn rows_total() as i64 {
    let is i64 as cols = cols_per_row();
    return (s.visible_count() + cols - 1) / cols;
}



fn grid_bottom() as i64 {
    let is i64 as h = s.win_h - s.DETAIL_H;
    if (h < s.PAD) { return s.PAD; }
    return h;
}
// Whole rows that fit. A partial row at the bottom is still drawn (clipped by
// gpix), but it does not count as reachable — otherwise the last row could
// never be scrolled fully into view.
fn rows_visible() as i64 {
    let is i64 as h = grid_bottom() - s.PAD;
    if (h < s.TILE) { return 1; }
    return h / s.TILE;
}

fn max_scroll() as i64 {
    let is i64 as m = rows_total() - rows_visible();
    if (m < 0) { return 0; }
    return m;
}

// Clamped after every scroll AND after every resize: a window made taller while
// scrolled to the bottom would otherwise keep an offset that now points past
// the end, painting an empty grid over a full disk.
fn scroll_to(row as i64) as void {
    let is i64 as m = max_scroll();
    let is i64 as r with mut = row;
    if (r > m) { r = m; }
    if (r < 0) { r = 0; }
    s.scroll = r;
    return;
}

// draw_icon — CSIF scaled into the ICO box. Straight RGBA is composited over
// the current tile, not turned into a black square by ignoring transparency.
fn draw_icon(idx as i64, bx as i64, by as i64) as void {
    let is *s.App as item = s.app(idx);
    if (item.ico_pix != 0) {
        let is *u8 as src = cast(*u8, item.ico_pix);
        let is i64 as iw = item.ico_w;
        let is i64 as ih = item.ico_h;
        let is i64 as nc = item.ico_nc;
        let is i64 as yy with mut = 0;
        while (yy < s.ICO) {
            let is i64 as sy = yy * ih / s.ICO;
            let is i64 as xx with mut = 0;
            while (xx < s.ICO) {
                let is i64 as sp = (sy * iw + (xx * iw / s.ICO)) * nc;
                let is i64 as alpha with mut = 255;
                if (nc == 4) { alpha = cast(i64, src[sp + 3]); }
                if (alpha != 0) {
                    let is i64 as rr = cast(i64, src[sp]);
                    let is i64 as gg = cast(i64, src[sp + 1]);
                    let is i64 as bb = cast(i64, src[sp + 2]);
                    let is i64 as color = (rr << 16) | (gg << 8) | bb;
                    if (alpha == 255) { gpix(bx + xx, by + yy, color); }
                    else { gpix_alpha(bx + xx, by + yy, color, alpha); }
                }
                xx = xx + 1;
            }
            yy = yy + 1;
        }
        return;
    }
    // An unregistered application has a document symbol, never an ambiguous
    // initial. Its name is also available in the description panel.
    gfill(bx + 15, by + 5, 26, 2, s.COL_ICOB);
    gfill(bx + 15, by + 5, 2, 42, s.COL_ICOB);
    gfill(bx + 39, by + 5, 2, 42, s.COL_ICOB);
    gfill(bx + 15, by + 45, 26, 2, s.COL_ICOB);
    gfill(bx + 21, by + 17, 14, 2, s.COL_LABEL);
    gfill(bx + 21, by + 25, 14, 2, s.COL_LABEL);
    gfill(bx + 21, by + 33, 10, 2, s.COL_LABEL);
    return;
}

// draw_scrollbar — the track and a thumb sized by how much of the grid is on
// screen. Without it there is nothing to say the list continues below, and a
// launcher whose second half is invisible looks exactly like one that has no
// second half.
fn draw_scrollbar() as void {
    let is i64 as total = rows_total();
    let is i64 as vis = rows_visible();
    if (total <= vis) { return; }
    let is i64 as x = s.win_w - s.SBW;
    let is i64 as h = grid_bottom();
    gfill(x, 0, s.SBW, h, s.COL_SBTRK);
    let is i64 as th with mut = h * vis / total;
    if (th < 16) { th = 16; }
    let is i64 as ty = (h - th) * s.scroll / (total - vis);
    gfill(x + 1, ty, s.SBW - 2, th, s.COL_SBTHM);
    return;
}

// Word-wrapped UTF-8, with a visible ellipsis if the physical panel is too
// small. Neither a long word nor a malformed byte can stall the renderer.
fn paragraph(text as *u8, len as i64, x as i64, y as i64, cols as i64, rows as i64, color as i64) as void {
    if (cols <= 0 || rows <= 0) { return; }
    let is i64 as start with mut = 0;
    let is i64 as row with mut = 0;
    while (start < len && row < rows) {
        while (start < len && text[start] == cast(u8, 32)) { start = start + 1; }
        let is i64 as end with mut = start;
        let is i64 as last_space with mut = 0 - 1;
        let is i64 as count with mut = 0;
        while (end < len && count < cols) {
            if (text[end] == cast(u8, 32)) { last_space = end; }
            let is [1]i32 as cp;
            let is i64 as n with mut = utf8.decode1(text, len, end, cast(*i32, &cp[0]));
            if (n <= 0) { n = 1; }
            end = end + n;
            count = count + 1;
        }
        if (end < len && row + 1 == rows) {
            let is i64 as dots with mut = 3;
            if (dots > cols) { dots = cols; }
            end = start; count = 0;
            while (end < len && count < cols - dots) {
                let is [1]i32 as cp;
                let is i64 as n with mut = utf8.decode1(text, len, end, cast(*i32, &cp[0]));
                if (n <= 0) { n = 1; }
                end = end + n; count = count + 1;
            }
            gtext(text + start, end - start, x, y + row * 16, color);
            gtext(cast(*u8, "..."), dots, x + count * 8, y + row * 16, color);
            return;
        }
        if (end < len && last_space > start) { end = last_space; }
        gtext(text + start, end - start, x, y + row * 16, color);
        start = end;
        row = row + 1;
    }
    return;
}

fn draw_details() as void {
    let is i64 as top = grid_bottom();
    gfill(0, top, s.win_w, s.win_h - top, s.COL_BG);
    gfill(0, top, s.win_w, 1, s.COL_SBTHM);
    let is i64 as cols = (s.win_w - 24) / 8;
    let is i64 as detail_rows = (s.win_h - top - 40) / 16;
    let is i64 as idx with mut = s.detail_idx;
    let is *u8 as search_label = "Search: ";
    paragraph(search_label, 8, 12, top + 8, 8, 1, s.COL_ICOB);
    if (s.search_query.len > 0) {
        gtext(cast(*u8, s.search_query.va), s.search_query.len, 76, top + 8, s.COL_ICOB);
    } else {
        let is *u8 as prompt = "type to filter apps";
        paragraph(prompt, prog.slen(prompt), 76, top + 8, cols - 8, 1, s.COL_LABEL);
    }
    if (s.scan_error < 0) {
        let is *u8 as title = "Application list incomplete";
        let is *u8 as reason = sys.err_text(s.scan_error);
        paragraph(title, prog.slen(title), 12, top + 24, cols, 1, s.COL_WARN);
        paragraph(reason, prog.slen(reason), 12, top + 40, cols, detail_rows, s.COL_LABEL);
        return;
    }
    if (s.search_error < 0) {
        let is *u8 as title = "Search failed";
        let is *u8 as reason = sys.err_text(s.search_error);
        paragraph(title, prog.slen(title), 12, top + 24, cols, 1, s.COL_WARN);
        paragraph(reason, prog.slen(reason), 12, top + 40, cols, detail_rows, s.COL_LABEL);
        return;
    }
    if (s.search_query.len > 0 && s.visible_count() == 0) {
        let is *u8 as hint = "No applications match this search.";
        paragraph(hint, prog.slen(hint), 12, top + 24, cols, detail_rows + 1, s.COL_LABEL);
        return;
    }
    if (s.search_query.len > 0 && s.selected_view >= 0
        && s.selected_view < s.visible_count()) {
        idx = s.visible_app(s.selected_view);
    }
    if (s.action_error < 0 && s.action_idx == s.visible_app(s.selected_view)) {
        idx = s.action_idx;
    }
    if (idx < 0 || idx >= s.app_count) {
        let is *u8 as hint with mut = "Point at an app to see its description.";
        if (s.search_query.len > 0) { hint = "Type to search, or point at an app for its description."; }
        paragraph(hint, prog.slen(hint), 12, top + 24, cols, detail_rows + 1, s.COL_LABEL);
        return;
    }
    let is *s.App as item = s.app(idx);
    paragraph(s.name(idx), item.name_len, 12, top + 24, cols, 1, s.COL_ICOB);
    let is *u8 as text with mut = cast(*u8, s.catalog.va + item.desc_off);
    let is i64 as len with mut = item.desc_len;
    if (len == 0) {
        text = cast(*u8, "No description registered for this application.");
        if (s.catalog_error < 0) { text = sys.err_text(s.catalog_error); }
        len = prog.slen(text);
    }
    if (s.action_error < 0 && s.action_idx == idx) {
        text = sys.err_text(s.action_error); len = prog.slen(text);
    }
    paragraph(text, len, 12, top + 40, cols, detail_rows, s.COL_LABEL);
    return;
}

fn paint() as void {
    s.paint_limit = grid_bottom();
    gfill(0, 0, s.win_w, s.paint_limit, s.COL_BG);
    let is i64 as cols = cols_per_row();
    // Only the rows on screen are drawn. Painting all 77 tiles and letting gpix
    // clip the off-screen ones costs a full glyph raster per hidden label.
    let is i64 as first = s.scroll * cols;
    let is i64 as last with mut = first + (rows_visible() + 1) * cols;
    if (last > s.visible_count()) { last = s.visible_count(); }
    let is i64 as i with mut = first;
    while (i < last) {
        let is i64 as idx = s.visible_app(i);
        let is i64 as cx = i - (i / cols) * cols;
        let is i64 as cy = i / cols - s.scroll;
        let is i64 as tx = cx * s.TILE;
        let is i64 as ty = s.PAD + cy * s.TILE;
        let is i64 as tile with mut = s.COL_TILE;
        if (i == s.hover_view) { tile = s.COL_TILE_HOVER; }
        if (idx == s.confirm_idx) { tile = s.COL_WARN; }
        gfill(tx + 4, ty, s.TILE - 8, s.TILE - 6, tile);
        draw_icon(idx, tx + (s.TILE - s.ICO) / 2, ty + 8);
        let is *u8 as label with mut = s.name(idx);
        let is i64 as blen with mut = s.app(idx).name_len;
        if (idx == s.confirm_idx) { label = cast(*u8, "again?"); blen = 6; }
        let is i64 as lw = text_cols(label, blen) * 8;
        let is i64 as lx with mut = tx + (s.TILE - lw) / 2;
        if (lx < tx + 4) { lx = tx + 4; }
        paragraph(label, blen, lx, ty + 8 + s.ICO + 6, (tx + s.TILE - 4 - lx) / 8, 1, s.COL_LABEL);
        if (i == s.selected_view) {
            gfill(tx + 2, ty - 2, s.TILE - 4, 2, s.COL_ICOB);
            gfill(tx + 2, ty + s.TILE - 4, s.TILE - 4, 2, s.COL_ICOB);
            gfill(tx + 2, ty, 2, s.TILE - 4, s.COL_ICOB);
            gfill(tx + s.TILE - 4, ty, 2, s.TILE - 4, s.COL_ICOB);
        }
        i = i + 1;
    }
    draw_scrollbar();
    s.paint_limit = 0 - 1;
    draw_details();
    return;
}
