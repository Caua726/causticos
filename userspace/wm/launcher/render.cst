// launcher/render.cst — drawing primitives + tile/icon renderers. Pixel-buffer
// based (the launcher is a PIXEL-surface client, unlike the text-surface
// wterm).
use "state.cst" as s;
use "../../../../Caustic/std/causticos/font.cst" as font;

fn gpix(x as i64, y as i64, color as i64) as void {
    if (x < 0 || y < 0 || x >= s.win_w || y >= s.win_h) { return; }
    let is *u32 as p = cast(*u32, s.seg_base + y * s.seg_stride + x * 4);
    p[0] = cast(u32, color);
    return;
}
fn gfill(x as i64, y as i64, w as i64, h as i64, color as i64) as void {
    let is i64 as yy with mut = y;
    while (yy < y + h) {
        let is i64 as xx with mut = x;
        while (xx < x + w) { gpix(xx, yy, color); xx = xx + 1; }
        yy = yy + 1;
    }
    return;
}
fn gglyph(ch as i64, px as i64, py as i64, color as i64, sc as i64) as void {
    let is *u8 as g = font.get_glyph(cast(i32, ch));
    let is i64 as row with mut = 0;
    while (row < 16) {
        let is i64 as bits = cast(i64, g[row]);
        let is i64 as col with mut = 0;
        while (col < 8) {
            if ((bits & (128 >> col)) != 0) {
                gfill(px + col * sc, py + row * sc, sc, sc, color);
            }
            col = col + 1;
        }
        row = row + 1;
    }
    return;
}
fn gtext(s_in as *u8, len as i64, x as i64, y as i64, color as i64) as void {
    let is i64 as i with mut = 0;
    while (i < len) { gglyph(cast(i64, s_in[i]), x + i * 8, y, color, 1); i = i + 1; }
    return;
}

fn cols_per_row() as i64 {
    let is i64 as c = s.win_w / s.TILE;
    if (c < 1) { return 1; }
    return c;
}

// draw_icon — app idx's icon into the ICOxICO box at (bx,by): CSIF
// (nearest-neighbor scaled) if present, else a generic lettered tile.
fn draw_icon(idx as i64, bx as i64, by as i64) as void {
    if (s.ico_pix[idx] != 0) {
        let is *u8 as src = cast(*u8, s.ico_pix[idx]);
        let is i64 as iw = s.ico_w[idx];
        let is i64 as ih = s.ico_h[idx];
        let is i64 as nc = s.ico_nc[idx];
        let is i64 as yy with mut = 0;
        while (yy < s.ICO) {
            let is i64 as sy = yy * ih / s.ICO;
            let is i64 as xx with mut = 0;
            while (xx < s.ICO) {
                let is i64 as sp = (sy * iw + (xx * iw / s.ICO)) * nc;
                let is i64 as r = cast(i64, src[sp]);
                let is i64 as g = cast(i64, src[sp + 1]);
                let is i64 as b = cast(i64, src[sp + 2]);
                gpix(bx + xx, by + yy, (r << 16) | (g << 8) | b);
                xx = xx + 1;
            }
            yy = yy + 1;
        }
        return;
    }
    gfill(bx, by, s.ICO, s.ICO, s.COL_ICO0);
    gfill(bx, by, s.ICO, 2, s.COL_ICOB);
    gfill(bx, by + s.ICO - 2, s.ICO, 2, s.COL_ICOB);
    gfill(bx, by, 2, s.ICO, s.COL_ICOB);
    gfill(bx + s.ICO - 2, by, 2, s.ICO, s.COL_ICOB);
    let is i64 as ch = cast(i64, s.names[idx * s.NAMEW]);
    gglyph(ch, bx + (s.ICO - 24) / 2, by + (s.ICO - 48) / 2, s.COL_LABEL, 3);
    return;
}

fn paint() as void {
    gfill(0, 0, s.win_w, s.win_h, s.COL_BG);
    let is i64 as cols = cols_per_row();
    let is i64 as i with mut = 0;
    while (i < s.app_count) {
        let is i64 as cx = i - (i / cols) * cols;
        let is i64 as cy = i / cols;
        let is i64 as tx = cx * s.TILE;
        let is i64 as ty = s.PAD + cy * s.TILE;
        gfill(tx + 4, ty, s.TILE - 8, s.TILE - 6, s.COL_TILE);
        draw_icon(i, tx + (s.TILE - s.ICO) / 2, ty + 8);
        let is i64 as blen = s.name_len[i];
        let is i64 as lw = blen * 8;
        let is i64 as lx with mut = tx + (s.TILE - lw) / 2;
        if (lx < tx + 4) { lx = tx + 4; }
        gtext(cast(*u8, &s.names[i * s.NAMEW]), blen, lx, ty + 8 + s.ICO + 6, s.COL_LABEL);
        i = i + 1;
    }
    return;
}
