// launcher/apps.cst — *.cse discovery + CSIF icon decode + click hit-test +
// launch-through-WM helper.
use "state.cst" as s;
use "render.cst" as r;
use "../../../../Caustic/std/os/causticos.cst" as sys;
use "../../../../Caustic/std/causticos/img/csif.cst" as csif;

// ends_cse — does name[0..len) end with ".cse"?
fn ends_cse(nm as *u8, len as i64) as i64 {
    if (len < 5) { return 0; }
    if (nm[len-4] == cast(u8, 46) && nm[len-3] == cast(u8, 99)
        && nm[len-2] == cast(u8, 115) && nm[len-1] == cast(u8, 101)) { return 1; }
    return 0;
}

// skip the OS internals that aren't launchable-as-app.
fn is_internal(base as *u8, blen as i64) as i64 {
    if (blen == 4 && base[0]==cast(u8,105) && base[1]==cast(u8,110) && base[2]==cast(u8,105) && base[3]==cast(u8,116)) { return 1; }
    if (blen == 2 && base[0]==cast(u8,119) && base[1]==cast(u8,109)) { return 1; }
    return 0;
}

// load_icon — try /icons/<base>.csif → decode, store pixels; else ico_pix=0.
fn load_icon(idx as i64, base as *u8, blen as i64) as void {
    s.ico_pix[idx] = 0;
    if (blen > 22) { return; }
    let is [40]u8 as path;
    let is *u8 as pfx = "/icons/";
    let is i64 as o with mut = 0;
    while (o < 7) { path[o] = pfx[o]; o = o + 1; }
    let is i64 as i with mut = 0;
    while (i < blen) { path[7 + i] = base[i]; i = i + 1; }
    let is *u8 as sfx = ".csif";
    let is i64 as j with mut = 0;
    while (j < 6) { path[7 + blen + j] = sfx[j]; j = j + 1; }
    let is csif.Image as im = csif.load(cast(*u8, &path[0]));
    if (im.ok == 0) { return; }
    s.ico_pix[idx] = cast(i64, im.pixels);
    s.ico_w[idx] = im.width; s.ico_h[idx] = im.height; s.ico_nc[idx] = im.nchan;
    return;
}

// scan_apps — readdir "/" for *.cse, fill the app list (base names minus
// the .cse extension).
fn scan_apps() as void {
    s.app_count = 0;
    let is i64 as fd = sys.open_read(cast(*u8, "/"));
    if (fd < 0) { return; }
    let is [37]i64 as ent;
    while (s.app_count < s.MAXAPP) {
        let is i64 as rc = sys.readdir(fd, cast(*u8, &ent[0]));
        if (rc != 0) { sys.close(fd); return; }
        let is *u8 as nm = cast(*u8, &ent[0]);
        let is i64 as nlen = ent[32];
        let is i64 as isdir = ent[36];
        if (isdir == 1) { continue; }
        if (ends_cse(nm, nlen) == 0) { continue; }
        let is i64 as blen = nlen - 4;
        if (blen <= 0 || blen >= s.NAMEW) { continue; }
        if (is_internal(nm, blen) == 1) { continue; }
        let is i64 as slot = s.app_count * s.NAMEW;
        let is i64 as k with mut = 0;
        while (k < blen) { s.names[slot + k] = nm[k]; k = k + 1; }
        s.name_len[s.app_count] = blen;
        load_icon(s.app_count, cast(*u8, &s.names[slot]), blen);
        s.app_count = s.app_count + 1;
    }
    sys.close(fd);
    return;
}

// hit — click at content (cx, cy) → app index, or -1. Geometry comes from
// render.cst, the same functions paint() lays the grid out with; the scroll
// offset is added here because cy is a WINDOW coordinate and the index is a
// GRID one.
fn hit(cx as i64, cy as i64) as i64 {
    if (cy < s.PAD) { return 0 - 1; }
    if (cx >= s.win_w - s.SBW) { return 0 - 1; }
    let is i64 as cols = r.cols_per_row();
    let is i64 as col = cx / s.TILE;
    let is i64 as rowi = (cy - s.PAD) / s.TILE + s.scroll;
    if (col >= cols) { return 0 - 1; }
    let is i64 as idx = rowi * cols + col;
    if (idx < 0 || idx >= s.app_count) { return 0 - 1; }
    return idx;
}
