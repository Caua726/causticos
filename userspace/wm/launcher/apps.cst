// launcher/apps.cst — *.cse discovery + CSIF icon decode + click hit-test +
// launch-through-WM helper.
use "state.cst" as s;
use "render.cst" as r;
use "std/os/causticos.cst" as sys;
use "std/causticos/img/csif.cst" as csif;
use "std/unicode/utf8.cst" as utf8;
use "../../lib/ucase/ucase.cst" as uc;

// ends_cse — does name[0..len) end with ".cse"?
fn ends_cse(nm as *u8, len as i64) as i64 {
    if (len < 5) { return 0; }
    if (nm[len-4] == cast(u8, 46) && nm[len-3] == cast(u8, 99)
        && nm[len-2] == cast(u8, 115) && nm[len-1] == cast(u8, 101)) { return 1; }
    return 0;
}

// skip the OS internals that aren't launchable-as-app.
fn is_internal(base as *u8, blen as i64) as i64 {
    if (blen == 4 && base[0]==cast(u8,105) && base[1]==cast(u8,110) && base[2]==cast(u8,105) && base[3]==cast(u8,116)) { return 1; }
    if (blen == 2 && base[0]==cast(u8,119) && base[1]==cast(u8,109)) { return 1; }
    // The desktop opens this picker; it is not an application to relaunch.
    if (blen == 8 && fu.mem_find(base, blen, cast(*u8, "launcher"), 8) == 0) { return 1; }
    // The checkerboard client is a development fixture, not a desktop app.
    if (blen == 5 && fu.mem_find(base, blen, cast(*u8, "wmpat"), 5) == 0) { return 1; }
    // Services are started with explicit channels/configuration, not by a
    // launcher click with no clients attached.
    if (blen == 4 && fu.mem_find(base, blen, cast(*u8, "netd"), 4) == 0) { return 1; }
    if (blen == 6 && fu.mem_find(base, blen, cast(*u8, "soundd"), 6) == 0) { return 1; }
    if (blen == 5 && fu.mem_find(base, blen, cast(*u8, "httpd"), 5) == 0) { return 1; }
    return 0;
}

// load_icon — try /icons/<base>.csif → decode, store pixels; else ico_pix=0.
fn load_icon(idx as i64, base as *u8, blen as i64) as void {
    let is *s.App as item = s.app(idx);
    item.ico_pix = 0;
    item.ico_nc = 0 - 1; // attempted; a missing icon is not reopened on repaint
    // The directory ABI carries at most 255 name bytes, not a 22-byte UI name.
    let is [268]u8 as path;
    let is *u8 as pfx = "/icons/";
    let is i64 as o with mut = 0;
    while (o < 7) { path[o] = pfx[o]; o = o + 1; }
    let is i64 as i with mut = 0;
    while (i < blen) { path[7 + i] = base[i]; i = i + 1; }
    let is *u8 as sfx = ".csif";
    let is i64 as j with mut = 0;
    while (j < 6) { path[7 + blen + j] = sfx[j]; j = j + 1; }
    let is csif.Image as im = csif.load(cast(*u8, &path[0]));
    if (im.ok == 0) { return; }
    item.ico_pix = cast(i64, im.pixels);
    item.ico_w = im.width; item.ico_h = im.height; item.ico_nc = im.nchan;
    return;
}

fn is_terminal(idx as i64) as i64 {
    if (s.app(idx).name_len != 5) { return 0; }
    let is *u8 as p = s.name(idx);
    return p[0] == cast(u8, 119) && p[1] == cast(u8, 116)
        && p[2] == cast(u8, 101) && p[3] == cast(u8, 114) && p[4] == cast(u8, 109);
}

// The terminal is pinned first; everything else is alphabetic. FAT names are
// case-insensitive, so ASCII case does not change an app's position.
fn after(a as i64, b as i64) as i64 {
    let is i64 as at = is_terminal(a);
    let is i64 as bt = is_terminal(b);
    if (at != bt) { return at < bt; }
    let is *s.App as aa = s.app(a);
    let is *s.App as bb = s.app(b);
    let is *u8 as ap = s.name(a);
    let is *u8 as bp = s.name(b);
    let is i64 as i with mut = 0;
    while (i < aa.name_len && i < bb.name_len) {
        let is i64 as ac with mut = cast(i64, ap[i]);
        let is i64 as bc with mut = cast(i64, bp[i]);
        if (ac >= 65 && ac <= 90) { ac = ac + 32; }
        if (bc >= 65 && bc <= 90) { bc = bc + 32; }
        if (ac != bc) { return ac > bc; }
        i = i + 1;
    }
    return aa.name_len > bb.name_len;
}

// Sorting precedes icon and description loading, so only name slices move.
fn swap(a as i64, b as i64) as void {
    let is *s.App as aa = s.app(a);
    let is *s.App as bb = s.app(b);
    let is i64 as off = aa.name_off;
    let is i64 as len = aa.name_len;
    aa.name_off = bb.name_off; aa.name_len = bb.name_len;
    bb.name_off = off; bb.name_len = len;
    return;
}

fn sift(root as i64, count as i64) as void {
    let is i64 as p with mut = root;
    while (p * 2 + 1 < count) {
        let is i64 as c with mut = p * 2 + 1;
        if (c + 1 < count && after(c + 1, c) == 1) { c = c + 1; }
        if (after(c, p) == 0) { return; }
        swap(p, c);
        p = c;
    }
    return;
}

// In-place heapsort: no scratch allocation, O(n log n). Icons are loaded
// afterwards, so their pixels and geometry cannot get attached to another name.
fn sort_names() as void {
    let is i64 as p with mut = s.app_count / 2;
    while (p > 0) { p = p - 1; sift(p, s.app_count); }
    let is i64 as end with mut = s.app_count - 1;
    while (end > 0) {
        swap(0, end);
        sift(0, end);
        end = end - 1;
    }
    return;
}

fn add_app(name as *u8, len as i64) as i64 {
    if (fu.line_reserve(&s.apps, s.apps.len + sizeof(s.App)) < 0
        || fu.line_reserve(&s.names, s.names.len + len + 1) < 0) { return sys.E_NOMEM; }
    let is *u8 as dst = cast(*u8, s.names.va + s.names.len);
    let is i64 as k with mut = 0;
    while (k < len) { dst[k] = name[k]; k = k + 1; }
    dst[len] = cast(u8, 0);
    let is *s.App as item = s.app(s.app_count);
    item.name_off = s.names.len; item.name_len = len - 4;
    item.ico_pix = 0; item.ico_w = 0; item.ico_h = 0; item.ico_nc = 0;
    item.desc_off = 0; item.desc_len = 0;
    s.names.len = s.names.len + len + 1;
    s.apps.len = s.apps.len + sizeof(s.App);
    s.app_count = s.app_count + 1;
    return 0;
}

// scan_apps — readdir "/" for *.cse, retaining each complete filename.
// name_len excludes the suffix only for labels and catalogue lookup.
fn scan_apps() as void {
    s.app_count = 0;
    let is i64 as fd = sys.open_read(cast(*u8, "/"));
    if (fd < 0) { s.scan_error = fd; return; }
    let is [37]i64 as ent;
    while (1 == 1) {
        let is i64 as rc = sys.readdir(fd, cast(*u8, &ent[0]));
        if (rc != 0) { if (rc != sys.E_NOENT) { s.scan_error = rc; } break; }
        let is *u8 as nm = cast(*u8, &ent[0]);
        let is i64 as nlen = ent[32];
        let is i64 as isdir = ent[36];
        if (isdir == 1) { continue; }
        if (ends_cse(nm, nlen) == 0) { continue; }
        let is i64 as blen = nlen - 4;
        if (is_internal(nm, blen) == 1) { continue; }
        let is i64 as added = add_app(nm, nlen);
        if (added < 0) { s.scan_error = added; break; }
    }
    sys.close(fd);
    sort_names();
    return;
}

fn name_is(idx as i64, name as *u8, len as i64) as i64 {
    if (s.app(idx).name_len != len) { return 0; }
    let is *u8 as own = s.name(idx);
    let is i64 as k with mut = 0;
    while (k < len) { if (own[k] != name[k]) { return 0; } k = k + 1; }
    return 1;
}

fn _folded_cp(text as *u8, len as i64, off as i64, out as *i64) as i64 {
    let is i32 as cp;
    let is i64 as n = utf8.decode1(text, len, off, &cp);
    if (n < 0) {
        out[0] = 0x110000 + cast(i64, text[off]);
        return 1;
    }
    out[0] = uc.lower(cast(i64, cp));
    return n;
}

// Case-insensitive Unicode substring search; malformed catalogue/name bytes
// compare as opaque values and can never alias a valid typed character.
fn _contains_query(text as *u8, len as i64) as i64 {
    if (s.search_query.len == 0) { return 1; }
    let is *u8 as query = cast(*u8, s.search_query.va);
    let is i64 as start with mut = 0;
    let is i64 as tc with mut = 0;
    let is i64 as qc with mut = 0;
    while (start < len) {
        let is i64 as ti with mut = start;
        let is i64 as qi with mut = 0;
        while (ti < len && qi < s.search_query.len) {
            let is i64 as tn = _folded_cp(text, len, ti, &tc);
            let is i64 as qn = _folded_cp(query, s.search_query.len, qi, &qc);
            if (tc != qc) { break; }
            ti = ti + tn;
            qi = qi + qn;
        }
        if (qi == s.search_query.len) { return 1; }
        start = start + _folded_cp(text, len, start, &tc);
    }
    return 0;
}

fn _app_matches(idx as i64) as i64 {
    let is *s.App as item = s.app(idx);
    if (_contains_query(s.name(idx), item.name_len) == 1) { return 1; }
    if (item.desc_len > 0
        && _contains_query(cast(*u8, s.catalog.va + item.desc_off), item.desc_len) == 1) { return 1; }
    return 0;
}

fn rebuild_search() as i64 {
    s.search_count = 0;
    s.search_error = 0;
    if (s.search_query.len == 0) { s.search_matches.len = 0; return 0; }
    let is i64 as rc = fu.line_reserve(&s.search_matches, s.app_count * 8);
    if (rc < 0) { s.search_error = rc; return rc; }
    let is *i64 as dst = cast(*i64, s.search_matches.va);
    let is i64 as i with mut = 0;
    while (i < s.app_count) {
        if (_app_matches(i) == 1) {
            dst[s.search_count] = i;
            s.search_count = s.search_count + 1;
        }
        i = i + 1;
    }
    s.search_matches.len = s.search_count * 8;
    return 0;
}


// The host generator and the launcher consume the same four-column TSV.
// Description slices stay in the catalogue mapping for this process's lifetime.
fn index_descriptions() as void {
    let is *u8 as text = cast(*u8, s.catalog.va);
    let is i64 as pos with mut = 0;
    while (pos < s.catalog.len) {
        let is i64 as start = pos;
        while (pos < s.catalog.len && text[pos] != cast(u8, 10)) { pos = pos + 1; }
        let is i64 as end with mut = pos;
        if (pos < s.catalog.len) { pos = pos + 1; }
        if (end > start && text[end - 1] == cast(u8, 13)) { end = end - 1; }
        if (end == start || text[start] == cast(u8, 35)) { continue; }
        let is i64 as tabs with mut = 0;
        let is i64 as name_end with mut = start;
        let is i64 as desc with mut = end;
        let is i64 as k with mut = start;
        while (k < end) {
            if (text[k] == cast(u8, 9)) {
                tabs = tabs + 1;
                if (tabs == 1) { name_end = k; }
                if (tabs == 3) { desc = k + 1; }
            }
            k = k + 1;
        }
        if (tabs != 3 || desc == end) { s.catalog_error = sys.E_INVAL; continue; }
        let is i64 as i with mut = 0;
        while (i < s.app_count) {
            if (name_is(i, cast(*u8, s.catalog.va + start), name_end - start) == 1) {
                s.app(i).desc_off = desc;
                s.app(i).desc_len = end - desc;
                break;
            }
            i = i + 1;
        }
    }
    return;
}

fn load_descriptions() as void {
    let is fu.Reader as reader;
    let is [4096]u8 as staging;
    let is i64 as fd = fu.rd_open(&reader, cast(*u8, "/etc/apps.tsv"), cast(*u8, &staging[0]), 4096);
    if (fd < 0) { s.catalog_error = fd; return; }
    let is i64 as rc = fu.rd_rec(&reader, &s.catalog, 0);
    fu.rd_close(&reader);
    if (rc < 0) { s.catalog_error = rc; fu.line_free(&s.catalog); return; }
    index_descriptions();
    return;
}

// Decode only icons about to be painted, including the clipped bottom row.
// Scanning a large catalogue must not allocate pixels for every hidden tile.
fn load_visible_icons() as void {
    let is i64 as cols = r.cols_per_row();
    let is i64 as first = s.scroll * cols;
    let is i64 as last with mut = first + (r.rows_visible() + 1) * cols;
    if (last > s.visible_count()) { last = s.visible_count(); }
    let is i64 as i with mut = first;
    while (i < last) {
        let is i64 as idx = s.visible_app(i);
        if (s.app(idx).ico_nc == 0) {
            load_icon(idx, s.name(idx), s.app(idx).name_len);
        }
        i = i + 1;
    }
    return;
}

// hit_view — click at content (cx, cy) → visible-list index, or -1.
// Geometry comes from render.cst, the same functions paint() lays the grid
// out with; the scroll offset converts WINDOW coordinates to GRID rows.
fn hit_view(cx as i64, cy as i64) as i64 {
    let is i64 as gx = r.grid_x();
    let is i64 as gy = r.grid_y();
    if (cx < gx || cy < gy || cy >= r.grid_bottom()) { return 0 - 1; }
    if (cx >= s.win_w - s.SBW) { return 0 - 1; }
    let is i64 as cols = r.cols_per_row();
    let is i64 as col = (cx - gx) / s.TILE;
    let is i64 as row_on_screen = (cy - gy) / s.TILE;
    if (row_on_screen >= r.rows_visible()) { return 0 - 1; }
    let is i64 as rowi = row_on_screen + s.scroll;
    if (col >= cols) { return 0 - 1; }
    let is i64 as view_idx = rowi * cols + col;
    if (view_idx < 0 || view_idx >= s.visible_count()) { return 0 - 1; }
    return view_idx;
}

fn hit(cx as i64, cy as i64) as i64 {
    let is i64 as view_idx = hit_view(cx, cy);
    if (view_idx < 0) { return 0 - 1; }
    return s.visible_app(view_idx);
}
