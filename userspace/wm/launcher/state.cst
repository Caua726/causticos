// launcher/state.cst — all launcher globals + palette. Pure data.
let is i64 as seg_base   with mut = 0;
let is i64 as seg_stride with mut = 0;
let is i64 as win_w with mut = 0;
let is i64 as win_h with mut = 0;

// MAXAPP is a real ceiling on what the launcher can SEE, not a display budget:
// scan_apps stops reading the directory when it fills, so anything past it is
// invisible with no indication that it exists. At 32 the desktop root's 77
// launchable programs were cut at "du", which is how wterm — the terminal, the
// one program you cannot do without — was missing from a launcher sitting on a
// disk that had it. 128 covers every profile in the tree with room to grow; the
// arrays below are sized from it and cost about 7 KB.
let is i64 as MAXAPP with imut = 128;
let is i64 as NAMEW  with imut = 16;
let is [2048]u8 as names;
let is [128]i64 as name_len;
let is [128]i64 as ico_pix;
let is [128]i64 as ico_w;
let is [128]i64 as ico_h;
let is [128]i64 as ico_nc;
let is i64 as app_count with mut = 0;

// First VISIBLE row. The grid is taller than the window as soon as there are
// more apps than fit, so this is what makes the rest reachable at all.
let is i64 as scroll with mut = 0;

let is i64 as TILE with imut = 104;
let is i64 as ICO  with imut = 56;
let is i64 as PAD  with imut = 12;
// The scrollbar gutter, always reserved rather than appearing when the content
// overflows: a column count that changes with the app count would move every
// tile under the pointer the moment one more program is installed.
let is i64 as SBW  with imut = 6;
let is i64 as COL_BG    with imut = 0x001b2129;
let is i64 as COL_TILE  with imut = 0x00263039;
let is i64 as COL_LABEL with imut = 0x00d3d7cf;
let is i64 as COL_ICO0  with imut = 0x003a4655;
let is i64 as COL_ICOB  with imut = 0x0073d0ff;
let is i64 as COL_SBTRK with imut = 0x00222a33;
let is i64 as COL_SBTHM with imut = 0x003a4655;
