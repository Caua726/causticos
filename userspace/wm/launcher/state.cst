// launcher/state.cst — shared storage, direct accessors and palette.
use "../../lib/futil/futil.cst" as fu;
let is i64 as seg_base   with mut = 0;
let is i64 as seg_stride with mut = 0;
let is i64 as win_w with mut = 0;
let is i64 as win_h with mut = 0;

// Names retain the complete directory entry, including its .cse suffix and NUL.
// Offsets survive buffer growth; neither the app count nor names have a UI cap.
struct App {
    name_off as i64;
    name_len as i64;         // basename bytes, without .cse
    ico_pix as i64;
    ico_w as i64;
    ico_h as i64;
    ico_nc as i64;
    desc_off as i64;
    desc_len as i64;
}
let is fu.Line as apps;
let is fu.Line as names;
let is i64 as app_count with mut = 0;
let is fu.Line as search_query;
let is fu.Line as search_matches;
let is i64 as search_count with mut = 0;
let is i64 as search_error with mut = 0;
let is i64 as scan_error with mut = 0;
fn app(idx as i64) as *App { return cast(*App, apps.va + idx * sizeof(App)); }
fn name(idx as i64) as *u8 { return cast(*u8, names.va + app(idx).name_off); }

fn visible_count() as i64 {
    if (search_query.len == 0) { return app_count; }
    return search_count;
}

fn visible_app(view_idx as i64) as i64 {
    if (view_idx < 0 || view_idx >= visible_count()) { return 0 - 1; }
    if (search_query.len == 0) { return view_idx; }
    let is *i64 as filtered = cast(*i64, search_matches.va);
    return filtered[view_idx];
}

// Description slices refer to this one growable file buffer; no per-app copies.
let is fu.Line as catalog;
let is i64 as action_error with mut = 0;
let is i64 as action_idx with mut = 0 - 1;
let is i64 as catalog_error with mut = 0;
let is i64 as detail_idx with mut = 0 - 1;
// Index in the current visible list; keyboard arrows move this focus.
let is i64 as selected_view with mut = 0 - 1;
// Index under the pointer; independent of keyboard focus and details.
let is i64 as hover_view with mut = 0 - 1;
let is i64 as paint_limit with mut = 0 - 1;
let is i64 as DETAIL_H with imut = 64;
let is i64 as pointer_x with mut = 0 - 1;
let is i64 as pointer_y with mut = 0 - 1;

// First VISIBLE row. The grid is taller than the window as soon as there are
// more apps than fit, so this is what makes the rest reachable at all.
let is i64 as scroll with mut = 0;

let is i64 as TILE with imut = 104;
let is i64 as ICO  with imut = 56;
let is i64 as PAD  with imut = 12;
// A 6-pixel scrollbar and 8 pixels between it and the frame, where the WM's
// resize grip begins: dragging the bar must never start a resize. Keeping the
// whole gutter fixed keeps tile columns stable as apps change.
let is i64 as SBW with imut = 14;
let is i64 as SBAR_W with imut = 6;
let is i64 as COL_BG    with imut = 0x001b2129;
let is i64 as COL_TILE  with imut = 0x00263039;
let is i64 as COL_TILE_HOVER with imut = 0x0034404d;
let is i64 as COL_LABEL with imut = 0x00d3d7cf;
let is i64 as COL_ICOB  with imut = 0x0073d0ff;
let is i64 as COL_SBTRK with imut = 0x00222a33;
let is i64 as COL_SBTHM with imut = 0x003a4655;
let is i64 as COL_WARN  with imut = 0x00a03a2a;   // a tile waiting for its second click

// A tile that does something drastic (poweroff, reboot) takes a second click
// within CONFIRM_NS; until then it shows it is waiting for one.
let is i64 as CONFIRM_NS with imut = 4000000000;
let is i64 as confirm_idx with mut = 0 - 1;
let is i64 as confirm_until with mut = 0;
