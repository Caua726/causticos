// wm/context.cst — WM-owned popups shared by desktop, taskbar and frames.
// Their cell surface is handed to the compositor; this module owns placement,
// selection and the actions behind each row.

use "state.cst" as s;
use "window.cst" as win;
use "layout.cst" as lay;
use "client.cst" as cli;
use "actions.cst" as actions;
use "tags.cst" as tags;
use "decoration.cst" as dec;
use "damage.cst" as dmg;
use "../lib/wmproto/wmproto.cst" as wmp;
use "../lib/compo_proto/compo_proto.cst" as cp;
use "../lib/keymap/keysym.cst" as ks;
use "std/os/causticos.cst" as sys;
use "../lib/tz/tz.cst" as tz;

let is i64 as MENU_COLS with imut = 22;
let is i64 as MENU_ROWS_MAX with imut = 64;
let is i64 as MENU_W with imut = 176;

fn _unavailable(rc as i64) as void {
    if (s.context_kind == 2) {
        dec.notice(cast(*u8, "Window switcher unavailable"), 27, 5000000000);
        wmp.log_kv(cast(*u8, "wm: window switcher unavailable rc="), 35, rc);
    } else {
        dec.notice(cast(*u8, "Context menu unavailable"), 24, 5000000000);
        wmp.log_kv(cast(*u8, "wm: context menu unavailable rc="), 32, rc);
    }
    return;
}

fn _ensure_surface() as i64 {
    if (s.context_dec_fd != 0) { return 0; }
    let is i64 as pages = cp.dec_seg_pages(MENU_COLS, MENU_ROWS_MAX);
    let is i64 as fd = sys.seg_create(pages, 0);
    if (fd < 0) { _unavailable(fd); return fd; }
    let is i64 as base = sys.mmap_fd(sys.PROT_READ | sys.PROT_WRITE, fd);
    if (base < 0) { sys.close(fd); _unavailable(base); return base; }
    s.context_dec_fd = fd;
    s.context_dec_base = base;
    s.context_dec_pages = pages;
    s.context_dec_attached = 0;
    return 0;
}

fn _switcher_count() as i64 {
    let is i64 as count with mut = 0;
    let is i64 as k with mut = 0;
    while (k < s.nz) {
        if (win.win_visible(s.zord[k]) == 1) { count = count + 1; }
        k = k + 1;
    }
    return count;
}

fn _switcher_window_at(index as i64) as i64 {
    let is i64 as seen with mut = 0;
    let is i64 as k with mut = 0;
    while (k < s.nz) {
        let is i64 as candidate = s.zord[k];
        if (win.win_visible(candidate) == 1) {
            if (seen == index) { return candidate; }
            seen = seen + 1;
        }
        k = k + 1;
    }
    return 0 - 1;
}

fn _switcher_focus_index(candidate as i64) as i64 {
    let is i64 as seen with mut = 0;
    let is i64 as k with mut = 0;
    while (k < s.nz) {
        let is i64 as current = s.zord[k];
        if (win.win_visible(current) == 1) {
            if (current == candidate) { return seen; }
            seen = seen + 1;
        }
        k = k + 1;
    }
    return 0 - 1;
}

fn _rows() as i64 {
    if (s.context_kind == 2) {
        let is i64 as count = _switcher_count();
        let is i64 as limit with mut = (s.scr_h - s.BAR_H - 32) / 16;
        if (limit < 1) { limit = 1; }
        if (limit > MENU_ROWS_MAX) { limit = MENU_ROWS_MAX; }
        if (count < limit) { limit = count; }
        if (limit < 1) { limit = 1; }
        return limit;
    }
    if (s.context_kind == 1) { return 4; }
    if (s.context_kind == 3) { return _cal_rows(); }
    return 2;
}

fn _switcher_sync() as void {
    let is i64 as count = _switcher_count();
    let is i64 as rows = _rows();
    let is i64 as index with mut = _switcher_focus_index(s.focused);
    if (index < 0) { index = 0; }
    let is i64 as max_offset with mut = count - rows;
    if (max_offset < 0) { max_offset = 0; }
    if (index < s.context_switch_offset) { s.context_switch_offset = index; }
    if (index >= s.context_switch_offset + rows) {
        s.context_switch_offset = index - rows + 1;
    }
    if (s.context_switch_offset > max_offset) { s.context_switch_offset = max_offset; }
    if (s.context_switch_offset < 0) { s.context_switch_offset = 0; }
    s.context_hover = index - s.context_switch_offset;
    if (s.context_hover < 0 || s.context_hover >= rows) { s.context_hover = 0; }
    return;
}

// ---- the clock's calendar (kind 3) -----------------------------------------
// The date and the zone the clock shows, this month with today marked, and a
// row that opens `timezone` in a terminal to choose another zone.
let is tz.Local as cal with mut;
let is i64 as cal_ok with mut = 0;

fn _cal_refresh() as void {
    let is i64 as t = tz.now_epoch();
    if (t < 0) { cal_ok = 0; return; }
    tz.at(&dec.zone, t, &cal);
    cal_ok = 1;
    return;
}

fn _cal_mlen() as i64 {
    let is i64 as m = cal.month;
    let is i64 as y = cal.year;
    if (m == 2) {
        if ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0) { return 29; }
        return 28;
    }
    if (m == 4 || m == 6 || m == 9 || m == 11) { return 30; }
    return 31;
}

// Weekday (0 = Sunday) of the first of this month.
fn _cal_first() as i64 { return (cal.wday + 35 - (cal.day - 1) % 7) % 7; }

fn _cal_weeks() as i64 { return (_cal_first() + _cal_mlen() + 6) / 7; }

// Date, zone, offset, weekday names, the weeks, and the action row.
fn _cal_rows() as i64 {
    if (cal_ok == 0) { return 2; }
    return 4 + _cal_weeks() + 1;
}

fn _wname(w as i64) as *u8 {
    if (w == 0) { return "Sun"; } if (w == 1) { return "Mon"; } if (w == 2) { return "Tue"; }
    if (w == 3) { return "Wed"; } if (w == 4) { return "Thu"; } if (w == 5) { return "Fri"; }
    return "Sat";
}

fn _mname(m as i64) as *u8 {
    if (m == 1) { return "Jan"; } if (m == 2) { return "Feb"; } if (m == 3) { return "Mar"; }
    if (m == 4) { return "Apr"; } if (m == 5) { return "May"; } if (m == 6) { return "Jun"; }
    if (m == 7) { return "Jul"; } if (m == 8) { return "Aug"; } if (m == 9) { return "Sep"; }
    if (m == 10) { return "Oct"; } if (m == 11) { return "Nov"; }
    return "Dec";
}

let is [32]u8 as cal_buf with mut;
let is i64 as cal_n with mut = 0;

fn _cal_s(t as *u8) as void {
    let is i64 as i with mut = 0;
    while (t[i] != cast(u8, 0) && cal_n < 31) { cal_buf[cal_n] = t[i]; cal_n = cal_n + 1; i = i + 1; }
}

// v in decimal; at least `width` digits, padded with pad (48 '0', 32 ' ').
fn _cal_num(v as i64, width as i64, pad as i64) as void {
    let is [8]u8 as d;
    let is i64 as k with mut = 0;
    let is i64 as x with mut = v;
    if (x == 0) { d[0] = cast(u8, 48); k = 1; }
    while (x > 0 && k < 8) { d[k] = cast(u8, 48 + x % 10); x = x / 10; k = k + 1; }
    while (k < width && k < 8) { d[k] = cast(u8, pad); k = k + 1; }
    while (k > 0 && cal_n < 31) { k = k - 1; cal_buf[cal_n] = d[k]; cal_n = cal_n + 1; }
}

fn _cal_put(row as i64, col as i64, fg as i64, bg as i64) as void {
    dec.cells_utf8(s.context_dec_base, row * MENU_COLS + col, MENU_COLS - col,
                   cast(*u8, &cal_buf[0]), cal_n, fg, bg);
    cal_n = 0;
}

fn _paint_calendar(rows as i64) as void {
    let is i64 as last = rows - 1;
    if (cal_ok == 0) {
        _cal_s("No clock to read"); _cal_put(0, 1, s.COL_TEXT, s.COL_TITLE_U);
    } else {
        // "Fri 9 Oct 2026 14:16"
        _cal_s(_wname(cal.wday)); _cal_s(" "); _cal_num(cal.day, 1, 32); _cal_s(" ");
        _cal_s(_mname(cal.month)); _cal_s(" "); _cal_num(cal.year, 4, 48); _cal_s(" ");
        _cal_num(cal.hour, 2, 48); _cal_s(":"); _cal_num(cal.min, 2, 48);
        _cal_put(0, 1, s.COL_TEXT, s.COL_TITLE_U);
        dec.cells_utf8(s.context_dec_base, MENU_COLS + 1, MENU_COLS - 2,
                       tz.name_ptr(&dec.zone), tz.name_len(&dec.zone), s.COL_BAR_DIM, s.COL_TITLE_U);
        // "UTC-03:00  -03"
        let is [12]u8 as off;
        let is i64 as on = tz.fmt_offset(cal.utoff, 1, cast(*u8, &off[0]));
        _cal_s("UTC");
        let is i64 as i with mut = 0;
        while (i < on && cal_n < 31) { cal_buf[cal_n] = off[i]; cal_n = cal_n + 1; i = i + 1; }
        _cal_s("  ");
        i = 0;
        while (i < cal.abbr_len && cal_n < 31) { cal_buf[cal_n] = cal.abbr[i]; cal_n = cal_n + 1; i = i + 1; }
        _cal_put(2, 1, s.COL_BAR_DIM, s.COL_TITLE_U);
        _cal_s("Su Mo Tu We Th Fr Sa"); _cal_put(3, 1, s.COL_BAR_DIM, s.COL_TITLE_U);
        let is i64 as first = _cal_first();
        let is i64 as n = _cal_mlen();
        let is i64 as d with mut = 1;
        while (d <= n) {
            let is i64 as pos = first + d - 1;
            let is i64 as fg with mut = s.COL_TEXT;
            let is i64 as bg with mut = s.COL_TITLE_U;
            if (d == cal.day) { fg = s.COL_BAR; bg = s.COL_BORDER_F; }
            _cal_num(d, 2, 32);
            dec.cells_utf8(s.context_dec_base, (4 + pos / 7) * MENU_COLS + 1 + (pos % 7) * 3, 2,
                           cast(*u8, &cal_buf[0]), 2, fg, bg);
            cal_n = 0;
            d = d + 1;
        }
    }
    let is i64 as abg with mut = s.COL_TITLE_U;
    if (s.context_hover == last) { abg = s.COL_TITLE_F; }
    _cal_s("Change time zone"); _cal_put(last, 2, s.COL_TEXT, abg);
    return;
}

// Click on the clock: the calendar, above it. A second click anywhere outside
// closes it, as any popup.
fn clock_open() as void {
    _cal_refresh();
    s.context_kind = 3;
    s.context_target = 0 - 1;
    s.context_hover = 0 - 1;
    s.context_press = 0 - 1;
    s.context_capture = 0;
    s.context_open = 1;
    s.context_dirty = 1;
    s.context_paint_dirty = 1;
    _position(s.scr_w, s.scr_h);
    s.deco_dirty = 1;
    dmg.dmg_taskbar();
    return;
}

// Once a second with the clock: the time on the first row moves, and so does
// the month at midnight on the last day, with a different number of weeks.
fn clock_tick() as void {
    if (s.context_open == 0 || s.context_kind != 3) { return; }
    _cal_refresh();
    _position(s.scr_w, s.scr_h);
    s.context_paint_dirty = 1;
    return;
}

fn _paint() as void {
    let is i64 as rows = _rows();
    dec.dec_set_header(s.context_dec_base, MENU_COLS, rows);
    let is i64 as r with mut = 0;
    while (r < rows) {
        let is i64 as bg with mut = s.COL_TITLE_U;
        let is i64 as fg with mut = s.COL_TEXT;
        if (r == s.context_hover) { bg = s.COL_TITLE_F; }
        if (s.context_kind == 2 && r == s.context_hover) {
            bg = s.COL_BORDER_F;
            fg = s.COL_BAR;
        }
        let is i64 as i with mut = 0;
        while (i < MENU_COLS) {
            let is *i64 as cell = dec.dec_cell_ptr(s.context_dec_base, r * MENU_COLS + i);
            cell[0] = cp.make_cell(0x20, fg, bg);
            i = i + 1;
        }
        if (s.context_kind == 2) {
            let is i64 as candidate = _switcher_window_at(s.context_switch_offset + r);
            if (candidate >= 0) {
                let is [16]u8 as label;
                let is i64 as len with mut = s.wins[candidate].title_len;
                if (len > 0) {
                    wmp.title_unpack(s.wins[candidate].t0, s.wins[candidate].t1,
                                     len, cast(*u8, &label[0]));
                } else {
                    len = s.wins[candidate].name_len;
                    wmp.title_unpack(s.wins[candidate].n0, s.wins[candidate].n1,
                                     len, cast(*u8, &label[0]));
                }
                let is i64 as text_col with mut = 2;
                let is i64 as text_width with mut = MENU_COLS - 4;
                if (r == s.context_hover) {
                    dec.cells_utf8(s.context_dec_base, r * MENU_COLS + 1, 1,
                                   cast(*u8, ">"), 1, s.COL_BAR, bg);
                    text_col = 3;
                    text_width = MENU_COLS - 5;
                }
                dec.cells_utf8(s.context_dec_base, r * MENU_COLS + text_col, text_width,
                               cast(*u8, &label[0]), len, fg, bg);
            }
        } else if (s.context_kind != 3) {
            let is *u8 as label with mut = cast(*u8, "Open Apps");
            let is i64 as len with mut = 9;
            if (s.context_kind == 0) {
                if (r == 1) { label = cast(*u8, "New terminal"); len = 12; }
            } else if (r == 0) {
                label = cast(*u8, "Focus window"); len = 12;
                if (s.context_target >= 0 && s.context_target < s.MAX_WIN
                    && s.wins[s.context_target].minimized == 1) {
                    label = cast(*u8, "Restore / focus"); len = 15;
                }
            } else if (r == 1) {
                label = cast(*u8, "Minimize window"); len = 15;
                if (s.context_target >= 0 && s.context_target < s.MAX_WIN
                    && s.wins[s.context_target].minimized == 1) {
                    label = cast(*u8, "Restore window"); len = 14;
                }
            } else if (r == 2) {
                label = cast(*u8, "Maximize window"); len = 15;
                if (s.context_target >= 0 && s.context_target < s.MAX_WIN
                    && s.wins[s.context_target].maximized == 1) {
                    label = cast(*u8, "Restore size"); len = 12;
                }
            } else {
                label = cast(*u8, "Close window"); len = 12;
            }
            dec.cells_utf8(s.context_dec_base, r * MENU_COLS + 2, MENU_COLS - 4,
                           label, len, s.COL_TEXT, bg);
        }
        r = r + 1;
    }
    if (s.context_kind == 3) { _paint_calendar(rows); }
    s.context_paint_dirty = 0;
    dmg.dmg_add(s.context_x, s.context_y, s.context_w, s.context_h);
    return;
}

fn _position(x as i64, y as i64) as void {
    let is i64 as rows = _rows();
    let is i64 as h = rows * 16;
    let is i64 as nx with mut = x;
    let is i64 as ny with mut = y;
    if (nx + MENU_W > s.scr_w) { nx = s.scr_w - MENU_W; }
    if (nx < 0) { nx = 0; }
    let is i64 as bar_top = s.scr_h - s.BAR_H;
    if (ny + h > bar_top) { ny = bar_top - h; }
    if (ny < 0) { ny = 0; }
    if (s.context_x != nx || s.context_y != ny || s.context_w != MENU_W || s.context_h != h) {
        s.context_x = nx;
        s.context_y = ny;
        s.context_w = MENU_W;
        s.context_h = h;
        s.context_dirty = 1;
    }
    return;
}

fn open_at(x as i64, y as i64, kind as i64, target as i64) as void {
    let is i64 as nk with mut = kind;
    let is i64 as nt with mut = target;
    if (nk != 1 || nt < 0 || nt >= s.MAX_WIN || win.win_mapped(nt) == 0) {
        nk = 0; nt = 0 - 1;
    }
    if (s.context_open == 0 || s.context_kind != nk || s.context_target != nt) {
        s.context_kind = nk;
        s.context_target = nt;
        s.context_hover = 0;
        s.context_press = 0 - 1;
        s.context_capture = 0;
        s.context_paint_dirty = 1;
    }
    if (s.context_open == 0) { s.context_open = 1; s.context_dirty = 1; }
    _position(x, y);
    return;
}

fn switcher_open() as void {
    if (_switcher_count() < 2) { return; }
    s.context_kind = 2;
    s.context_target = 0 - 1;
    s.context_switch_offset = 0;
    s.context_hover = 0;
    s.context_press = 0 - 1;
    s.context_capture = 0;
    s.context_open = 1;
    s.context_dirty = 1;
    s.context_paint_dirty = 1;
    _switcher_sync();
    _position((s.scr_w - MENU_W) / 2,
              (s.scr_h - s.BAR_H - _rows() * 16) / 2);
    return;
}

fn switcher_update() as void {
    if (s.context_open == 0 || s.context_kind != 2) { return; }
    _switcher_sync();
    _position((s.scr_w - MENU_W) / 2,
              (s.scr_h - s.BAR_H - _rows() * 16) / 2);
    s.context_paint_dirty = 1;
    s.context_dirty = 1;
    return;
}

fn _window_at() as i64 {
    let is i64 as layer with mut = 1;
    let is i64 as split = lay.layers_apart();
    while (layer >= 0) {
        let is i64 as zi with mut = 0;
        while (zi < s.nz) {
            let is i64 as i = s.zord[zi];
            if (win.win_visible(i) == 1 && (split == 0 || s.wins[i].floating == layer)) {
                let is i64 as fx = s.wins[i].x;
                let is i64 as fy = s.wins[i].y;
                let is i64 as fw = s.wins[i].w + 2 * s.BORDER;
                let is i64 as fh = s.wins[i].h + s.TITLE_H + 2 * s.BORDER;
                if (s.mx >= fx && s.mx < fx + fw && s.my >= fy && s.my < fy + fh) { return i; }
            }
            zi = zi + 1;
        }
        layer = layer - 1;
    }
    return 0 - 1;
}

// Returns 1 when the right press belongs to WM chrome and opened a menu.
fn open_at_pointer() as i64 {
    if (s.my >= s.scr_h - s.BAR_H) {
        let is [2]i64 as hit;
        dec.tb_hit(s.mx / 8, &hit[0], &hit[1]);
        if (hit[0] == s.HOV_ITEM && hit[1] >= 0 && win.win_mapped(hit[1]) == 1) {
            open_at(s.mx, s.my, 1, hit[1]);
        } else {
            open_at(s.mx, s.my, 0, 0 - 1);
        }
        return 1;
    }
    let is i64 as i = _window_at();
    if (i >= 0) {
        let is i64 as cx = s.wins[i].x + s.BORDER;
        let is i64 as cy = s.wins[i].y + s.BORDER + s.TITLE_H;
        if (s.mx >= cx && s.mx < cx + s.wins[i].w
            && s.my >= cy && s.my < cy + s.wins[i].h) { return 0; }
        open_at(s.mx, s.my, 1, i);
        return 1;
    }
    open_at(s.mx, s.my, 0, 0 - 1);
    return 1;
}

fn close() as void {
    if (s.context_open == 0) { return; }
    if (s.context_kind == 2 && s.alt_cycling == 1) { win.win_cycle_commit(); }
    s.context_open = 0;
    s.context_hover = 0 - 1;
    s.context_press = 0 - 1;
    s.context_capture = 0;
    s.context_dirty = 1;
    // The clock is lit while its calendar is open.
    if (s.context_kind == 3) { s.deco_dirty = 1; dmg.dmg_taskbar(); }
    return;
}

fn _row_at(x as i64, y as i64) as i64 {
    if (s.context_open == 0 || x < s.context_x || x >= s.context_x + s.context_w
        || y < s.context_y || y >= s.context_y + s.context_h) { return 0 - 1; }
    let is i64 as row = (y - s.context_y) / 16;
    if (row < 0 || row >= _rows()) { return 0 - 1; }
    return row;
}

fn hover_at(x as i64, y as i64) as void {
    let is i64 as row with mut = _row_at(x, y);
    // In the calendar only the last row does anything.
    if (s.context_kind == 3 && row != _rows() - 1) { row = 0 - 1; }
    if (row != s.context_hover) { s.context_hover = row; s.context_paint_dirty = 1; }
    return;
}

fn pointer_press() as void {
    if (s.context_open == 0) { return; }
    s.context_capture = 1;
    s.context_press = _row_at(s.mx, s.my);
    return;
}

fn _activate(row as i64) as void {
    let is i64 as kind = s.context_kind;
    let is i64 as target = s.context_target;
    if (kind == 3) {
        // A day is not a button; only "Change time zone" acts.
        if (row != _rows() - 1) { return; }
        close();
        cli.spawn_named(cast(*u8, "timezone.cse"), 12);
        return;
    }
    if (kind == 2) {
        let is i64 as candidate = _switcher_window_at(s.context_switch_offset + row);
        close();
        if (candidate >= 0 && win.win_visible(candidate) == 1) { win.win_focus(candidate); }
        return;
    }
    close();
    if (kind == 0) {
        if (row == 0) { actions.open_launcher(); }
        else if (row == 1) { cli.spawn_client(); }
        return;
    }
    if (target < 0 || target >= s.MAX_WIN || win.win_mapped(target) == 0) { return; }
    if (row == 0) {
        if ((s.wins[target].tags & s.sel_tags) == 0) {
            s.wins[target].tags = s.sel_tags;
            tags._after_change();
        }
        if (s.wins[target].minimized == 1) { win.win_unminimize(target); }
        win.win_focus(target);
    } else if (row == 1) {
        if (s.wins[target].minimized == 1) { win.win_unminimize(target); }
        else { win.win_minimize(target); }
    } else if (row == 2) { win.win_toggle_max(target); }
    else if (row == 3) { s.wins[target].pend_close = 1; }
    return;
}

fn pointer_release() as void {
    if (s.context_capture == 0) { return; }
    let is i64 as pressed = s.context_press;
    let is i64 as released = _row_at(s.mx, s.my);
    s.context_capture = 0;
    s.context_press = 0 - 1;
    if (pressed >= 0 && pressed == released) { _activate(released); }
    else if (released < 0) { close(); }
    return;
}

fn key_handle(keysym as i64, pressed as i64) as void {
    if (s.context_open == 0 || pressed != 1) { return; }
    if (s.context_kind == 3) {
        if (keysym == ks.KEY_ESC) { close(); return; }
        if (keysym == ks.KEY_UP || keysym == ks.KEY_DOWN) {
            s.context_hover = _rows() - 1;
            s.context_paint_dirty = 1;
            return;
        }
        if (keysym == ks.KEY_ENTER && s.context_hover == _rows() - 1) { _activate(s.context_hover); }
        return;
    }
    if (s.context_kind == 2) {
        if (keysym == ks.KEY_ESC || keysym == ks.KEY_ENTER) { close(); return; }
        if (keysym == ks.KEY_UP || keysym == ks.KEY_DOWN) {
            let is i64 as count = _switcher_count();
            let is i64 as index with mut = _switcher_focus_index(s.focused);
            if (count < 1) { close(); return; }
            if (index < 0) { index = 0; }
            if (keysym == ks.KEY_UP) { index = index - 1; }
            else { index = index + 1; }
            if (index < 0) { index = count - 1; }
            if (index >= count) { index = 0; }
            let is i64 as candidate = _switcher_window_at(index);
            if (candidate >= 0) { win.win_focus_only(candidate); switcher_update(); }
            return;
        }
        return;
    }
    if (keysym == ks.KEY_ESC) { close(); return; }
    if (keysym == ks.KEY_UP || keysym == ks.KEY_DOWN) {
        let is i64 as row with mut = s.context_hover;
        if (row < 0) { row = 0; }
        else if (keysym == ks.KEY_UP) { row = row - 1; }
        else { row = row + 1; }
        if (row < 0) { row = _rows() - 1; }
        if (row >= _rows()) { row = 0; }
        s.context_hover = row;
        s.context_paint_dirty = 1;
        return;
    }
    if (keysym == ks.KEY_ENTER) {
        let is i64 as row with mut = s.context_hover;
        if (row < 0) { row = 0; }
        _activate(row);
    }
    return;
}

fn render() as void {
    if (s.context_open == 1) {
        let is i64 as rc = _ensure_surface();
        if (rc != 0) {
            s.context_open = 0;
            s.context_dirty = 1;
        } else {
            if (s.context_paint_dirty == 1) { _paint(); }
            if (s.context_dec_attached == 0) {
                let is i64 as hrc = dec.dec_handoff(s.context_dec_fd, cp.DEC_CONTEXT_ID,
                                                    s.context_dec_pages, MENU_COLS, _rows());
                if (hrc == 0) { s.context_dec_attached = 1; }
                else if (hrc != sys.E_AGAIN) {
                    _unavailable(hrc);
                    s.context_open = 0;
                    s.context_dirty = 1;
                }
            }
        }
    }
    if (s.context_dirty == 1) {
        if (s.context_open == 1 && s.context_dec_attached == 0) { return; }
        cp.msg_send(s.wc_fd, cp.MSG_WC_CONTEXT, s.context_open,
                    cp.pack_xy(s.context_x, s.context_y),
                    cp.pack_wh(s.context_w, s.context_h));
        s.context_dirty = 0;
    }
    return;
}
