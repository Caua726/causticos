// compositor/comp_input.cst — keyboard/mouse/tablet pumps, the keyboard layout
// (lib/keymap: scancodes to what they type) and its LEDs, and the
// cursor-acceleration profile.
use "comp_state.cst" as s;
use "comp_damage.cst" as dmg;
use "comp_render.cst" as r;
use "accel.cst" as accel;
use "std/os/causticos.cst" as sys;
use "../lib/wmproto/wmproto.cst" as wmp;
use "../lib/compo_proto/compo_proto.cst" as cp;
use "../lib/keymap/keymap.cst" as km;
use "../lib/keymap/keysym.cst" as ks;

fn cmd_send(mtype as i64, a as i64, b as i64, c as i64) as void {
    cp.msg_send(s.cmd_fd, mtype, a, b, c);
    return;
}

// Show CapsLock and NumLock on the keyboard. The keyboard only lights what it
// is told; a failure is the kernel's to report (it says why on the serial
// line), and the keys work the same without their lights.
fn set_leds() as void {
    if (s.kbd_fd < 0) { return; }
    let is [1]u8 as m;
    m[0] = cast(u8, km.locks(&s.kmap));
    sys.write(s.kbd_fd, cast(*u8, &m[0]), 1);
    return;
}

// The layout chosen, loaded again (MSG_WC_KEYMAP). A layout that does not load
// leaves the keyboard as it was; keymap.cst says why on the serial line.
fn reload_keymap() as void {
    if (km.load_chosen(&s.kmap) == 0) {
        sys.write_serial(cast(*u8, "comp: keymap "), 13);
        sys.write_serial(km.file_ptr(&s.kmap), km.file_len(&s.kmap));
        sys.write_serial(cast(*u8, "\n"), 1);
    }
    return;
}

fn handle_key(sc as i64, devflags as i64) as void {
    let is i64 as pressed = devflags & 1;
    let is i64 as ext = (devflags >> 1) & 1;
    let is [2]i64 as sym;
    let is i64 as locks = km.locks(&s.kmap);
    let is i64 as n = km.key(&s.kmap, sc, ext, pressed, cast(*i64, &sym[0]));
    if (km.locks(&s.kmap) != locks) { set_leds(); }
    let is i64 as held = km.mods(&s.kmap);
    // Super+Ctrl+A toggles the pointer accel profile live. The compositor owns
    // the pointer "feel", so it consumes the chord itself — it is NOT forwarded.
    if (pressed == 1 && ext == 0 && sc == 0x1E && (held & ks.MOD_SUPER) != 0 && (held & ks.MOD_CTRL) != 0) {
        if (s.accel_profile == 0) { s.accel_profile = 1; } else { s.accel_profile = 0; }
        // The chord is a global gesture, so it moves every pointer at once —
        // including one whose config had pinned it to the other profile. The
        // remainder is dropped per device: carrying it across a profile change
        // would smear the old feel into the new one.
        let is i64 as i with mut = 0;
        while (i < s.ptr_n) {
            s.ptrs[i].profile = s.accel_profile;
            s.ptrs[i].rem_x = 0; s.ptrs[i].rem_y = 0;
            i = i + 1;
        }
        if (s.accel_profile == 1) { sys.write_serial(cast(*u8, "comp: accel=adaptive\n"), 21); }
        else { sys.write_serial(cast(*u8, "comp: accel=flat\n"), 17); }
        return;
    }
    // Every transition goes to the WM, typing or not: it tracks the modifiers
    // from them, and binds act on the key. A dead key and a letter it does not
    // go on type two characters, as two messages.
    let is i64 as b = cp.key_b(km.ev_mods(&s.kmap), pressed, ext);
    if (n == 0) { cmd_send(cp.MSG_CP_KEY, 0, b, sc); return; }
    cmd_send(cp.MSG_CP_KEY, sym[0], b, sc);
    if (n == 2) { cmd_send(cp.MSG_CP_KEY, sym[1], b, sc); }
    return;
}

fn pump_kbd() as void {
    let is [64]u8 as evs;
    let is i64 as n = syscall(10, s.kbd_fd, cast(i64, &evs[0]), 64);
    if (n < 2) { return; }
    let is i64 as k with mut = 0;
    while (k + 1 < n) {
        handle_key(cast(i64, evs[k]), cast(i64, evs[k + 1]));
        k = k + 2;
    }
    return;
}

// pump_mouse — drain ONE relative pointer. Each device carries its own curve
// and its own sub-pixel remainder, so two mice never blend into one feel.
fn pump_mouse(p as *s.Ptr) as void {
    let is [64]u8 as recs;
    let is i64 as n = syscall(10, p.fd, cast(i64, &recs[0]), 64);
    if (n < 4) { return; }
    let is i64 as k with mut = 0;
    let is i64 as moved with mut = 0;
    while (k + 3 < n) {
        let is i64 as dx with mut = cast(i64, recs[k]);
        if (dx >= 128) { dx = dx - 256; }
        let is i64 as dy with mut = cast(i64, recs[k + 1]);
        if (dy >= 128) { dy = dy - 256; }
        accel.accel_move(p, dx, 0 - dy);
        moved = 1;
        let is i64 as nb = cast(i64, recs[k + 2]) & cp.BTN_MASK;
        if (nb != s.mbuttons) {
            s.mbuttons = nb;
            cmd_send(cp.MSG_CP_PTR, s.mx, s.my, s.mbuttons);
            moved = 0;
        }
        let is i64 as wh with mut = cast(i64, recs[k + 3]);
        if (wh >= 128) { wh = wh - 256; }
        if (wh != 0) { cmd_send(cp.MSG_CP_WHEEL, wh, s.mx, s.my); }
        k = k + 4;
    }
    if (moved == 1) { cmd_send(cp.MSG_CP_PTR, s.mx, s.my, s.mbuttons); }
    accel.cursor_moved();
    return;
}

// pump_tablet — drain ONE absolute pointer. Position is state, not deltas, so
// no accel curve applies; the device entry exists so config and polling treat
// every pointer the same way.
fn pump_tablet(p as *s.Ptr) as void {
    let is [64]u8 as recs;
    let is i64 as n = syscall(10, p.fd, cast(i64, &recs[0]), 64);
    if (n < 8) { return; }
    let is i64 as k with mut = 0;
    let is i64 as moved with mut = 0;
    while (k + 7 < n) {
        let is i64 as ax = cast(i64, recs[k]) | (cast(i64, recs[k + 1]) << 8);
        let is i64 as ay = cast(i64, recs[k + 2]) | (cast(i64, recs[k + 3]) << 8);
        s.mx = ax * s.scr_w / 32768;
        s.my = ay * s.scr_h / 32768;
        accel.clamp_cursor();
        moved = 1;
        let is i64 as nb = cast(i64, recs[k + 4]) & cp.BTN_MASK;
        if (nb != s.mbuttons) {
            s.mbuttons = nb;
            cmd_send(cp.MSG_CP_PTR, s.mx, s.my, s.mbuttons);
            moved = 0;
        }
        let is i64 as wh with mut = cast(i64, recs[k + 5]);
        if (wh >= 128) { wh = wh - 256; }
        if (wh != 0) { cmd_send(cp.MSG_CP_WHEEL, wh, s.mx, s.my); }
        k = k + 8;
    }
    if (moved == 1) { cmd_send(cp.MSG_CP_PTR, s.mx, s.my, s.mbuttons); }
    accel.cursor_moved();
    return;
}
