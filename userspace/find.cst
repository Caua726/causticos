// find — recursively list paths under a directory, optionally filtered by a
// name substring. `find <path> [name]`.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn find_walk(path as *u8, plen as i64, needle as *u8, nlen as i64) as void {
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { return; }
    let is [320]u8 as de;
    while (sys.readdir(fd, cast(*u8, &de[0])) == 0) {
        let is i64 as nl = fu.de_name_len(cast(*u8, &de[0]));
        if (fu.is_dot(cast(*u8, &de[0]), nl) == 0) {
            let is [512]u8 as child;
            let is i64 as clen = fu.path_join(cast(*u8, &child[0]), path, plen, cast(*u8, &de[0]), nl);
            if (nlen == 0 || fu.mem_find(cast(*u8, &de[0]), nl, needle, nlen) >= 0) {
                prog.out(cast(*u8, &child[0]), clen); prog.out("\n", 1);
            }
            if (fu.de_is_dir(cast(*u8, &de[0])) != 0) {
                find_walk(cast(*u8, &child[0]), clen, needle, nlen);
            }
        }
    }
    sys.close(fd);
}

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 2) { prog.outs("usage: find <path> [name]\n"); return cast(i32, 1); }
    let is [256]u8 as pb;
    let is *u8 as path = prog.abspath(prog.arg(argv, 1), cast(*u8, &pb[0]));
    let is *u8 as needle with mut = "";
    let is i64 as nlen with mut = 0;
    if (argc >= 3) { needle = prog.arg(argv, 2); nlen = prog.slen(needle); }
    find_walk(path, prog.slen(path), needle, nlen);
    return 0;
}
