// wc — count lines, words, and bytes of a file. `wc <file>`.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 2) { prog.outs("usage: wc <file>\n"); return cast(i32, 1); }
    let is [256]u8 as pb;
    let is *u8 as path = prog.abspath(prog.arg(argv, 1), cast(*u8, &pb[0]));
    let is [4096]u8 as iobuf;
    let is fu.Reader as r;
    if (fu.rd_open(&r, path, cast(*u8, &iobuf[0]), 4096) < 0) {
        prog.outs("wc: cannot open "); prog.outs(path); prog.out("\n", 1);
        return cast(i32, 1);
    }
    let is i64 as lines with mut = 0;
    let is i64 as words with mut = 0;
    let is i64 as bytes with mut = 0;
    let is i64 as inword with mut = 0;
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(&r);
        if (c < 0) { break; }
        bytes = bytes + 1;
        if (c == 0x0A) { lines = lines + 1; }
        if (c == 0x20 || c == 0x09 || c == 0x0A || c == 0x0D) { inword = 0; }
        else { if (inword == 0) { words = words + 1; inword = 1; } }
    }
    fu.rd_close(&r);
    prog.out_num(lines); prog.outs(" ");
    prog.out_num(words); prog.outs(" ");
    prog.out_num(bytes); prog.outs("  ");
    prog.outs(path); prog.out("\n", 1);
    return 0;
}
