// wc — count lines, words, bytes (and chars) per file, with a `total` when
// given several. No file argument (or `-`) reads stdin.
//   wc [-l] [-w] [-c] [-m] [file ...]
// -l lines, -w words, -c bytes, -m characters (UTF-8 code points). Default -lwc.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn count(r as *fu.Reader, out as *i64) as void {
    let is i64 as lines with mut = 0;
    let is i64 as words with mut = 0;
    let is i64 as bytes with mut = 0;
    let is i64 as chars with mut = 0;
    let is i64 as inword with mut = 0;
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(r);
        if (c < 0) { break; }
        bytes = bytes + 1;
        if ((c & 0xC0) != 0x80) { chars = chars + 1; }      // not a UTF-8 continuation byte
        if (c == 0x0A) { lines = lines + 1; }
        let is i64 as sp with mut = 0;
        if (c == 0x20 || c == 0x09 || c == 0x0A || c == 0x0B || c == 0x0C || c == 0x0D) { sp = 1; }
        if (sp == 1) { inword = 0; } else { if (inword == 0) { words = words + 1; inword = 1; } }
    }
    out[0] = lines; out[1] = words; out[2] = bytes; out[3] = chars;
}

fn show(cnt as *i64, sl as i64, sw as i64, sc as i64, sm as i64, name as *u8) as void {
    if (sl == 1) { prog.pad_num(cnt[0], 7); }
    if (sw == 1) { prog.pad_num(cnt[1], 7); }
    if (sc == 1) { prog.pad_num(cnt[2], 7); }
    if (sm == 1) { prog.pad_num(cnt[3], 7); }
    if (cast(i64, name) != 0) { prog.outs(" "); prog.outs(name); }
    prog.out("\n", 1);
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as sl with mut = 0;
    let is i64 as sw with mut = 0;
    let is i64 as sc with mut = 0;
    let is i64 as sm with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "lwcm");
        if (f < 0) { break; }
        if (f == 108) { sl = 1; }
        else if (f == 119) { sw = 1; }
        else if (f == 99) { sc = 1; }
        else if (f == 109) { sm = 1; }
        else { prog.outs("usage: wc [-lwcm] [file ...]\n"); return cast(i32, 1); }
    }
    if (sl == 0 && sw == 0 && sc == 0 && sm == 0) { sl = 1; sw = 1; sc = 1; }

    let is i64 as nfiles = argc - o.ind;
    if (nfiles <= 0) {
        let is [4096]u8 as buf;
        let is fu.Reader as r;
        fu.rd_open_fd(&r, cast(i64, 0), cast(*u8, &buf[0]), 4096);
        let is [4]i64 as cnt;
        count(&r, cast(*i64, &cnt[0]));
        show(cast(*i64, &cnt[0]), sl, sw, sc, sm, cast(*u8, 0));
        return 0;
    }

    let is [4]i64 as total;
    total[0] = 0; total[1] = 0; total[2] = 0; total[3] = 0;
    let is i32 as rc with mut = 0;
    let is i64 as i with mut = o.ind;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb;
        let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is [4096]u8 as buf;
        let is fu.Reader as r;
        if (fu.rd_open(&r, path, cast(*u8, &buf[0]), 4096) < 0) {
            prog.outs("wc: "); prog.outs(name); prog.outs(": cannot open\n");
            rc = cast(i32, 1);
        } else {
            let is [4]i64 as cnt;
            count(&r, cast(*i64, &cnt[0]));
            fu.rd_close(&r);
            show(cast(*i64, &cnt[0]), sl, sw, sc, sm, name);
            total[0] = total[0] + cnt[0]; total[1] = total[1] + cnt[1];
            total[2] = total[2] + cnt[2]; total[3] = total[3] + cnt[3];
        }
        i = i + 1;
    }
    if (nfiles > 1) { show(cast(*i64, &total[0]), sl, sw, sc, sm, "total"); }
    return rc;
}
