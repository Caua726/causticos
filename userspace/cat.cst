// cat — concatenate files to stdout. cat [-n] [-b] [-s] [-E] [-T] [file ...].
// -n number all lines, -b number nonempty lines, -s squeeze repeated blank
// lines, -E mark line ends with `$`, -T show tabs as `^I`. No file (or `-`)
// reads stdin. Plain `cat file` is a straight copy.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

// flags: bit0 n, bit1 b, bit2 s, bit3 E, bit4 T. st[0]=line number, st[1]=blank
// run — both persist across files (GNU cat numbers/squeezes the whole stream).
fn cat_one(r as *fu.Reader, fl as i64, st as *i64) as void {
    let is i64 as nflag = fl & 1;
    let is i64 as bflag = (fl >> 1) & 1;
    let is i64 as sflag = (fl >> 2) & 1;
    let is i64 as eflag = (fl >> 3) & 1;
    let is i64 as tflag = (fl >> 4) & 1;
    let is i64 as at_bol with mut = 1;
    let is i64 as skip with mut = 0;
    let is [1]u8 as ob;
    while (1 == 1) {
        let is i64 as c = fu.rd_byte(r);
        if (c < 0) { break; }
        if (at_bol == 1) {
            at_bol = 0;
            let is i64 as blank with mut = 0;
            if (c == 0x0A) { blank = 1; }
            skip = 0;
            if (sflag == 1) {
                if (blank == 1) { st[1] = st[1] + 1; if (st[1] > 1) { skip = 1; } }
                else { st[1] = 0; }
            }
            if (skip == 0 && (nflag == 1 || (bflag == 1 && blank == 0))) {
                prog.pad_num(st[0], 6); prog.outs("  "); st[0] = st[0] + 1;
            }
        }
        if (skip == 0) {
            if (c == 0x0A) {
                if (eflag == 1) { prog.outs("$"); }
                prog.out("\n", 1);
            } else if (tflag == 1 && c == 0x09) {
                prog.outs("^I");
            } else {
                ob[0] = cast(u8, c); prog.out(cast(*u8, &ob[0]), 1);
            }
        }
        if (c == 0x0A) { at_bol = 1; }
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as fl with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "nbsET");
        if (f < 0) { break; }
        if (f == 110) { fl = fl | 1; }
        else if (f == 98) { fl = fl | 2; }
        else if (f == 115) { fl = fl | 4; }
        else if (f == 69) { fl = fl | 8; }
        else if (f == 84) { fl = fl | 16; }
        else { prog.outs("usage: cat [-nbsET] [file ...]\n"); return cast(i32, 1); }
    }
    let is [2]i64 as st; st[0] = 1; st[1] = 0;
    let is i64 as nfiles = argc - o.ind;
    if (nfiles <= 0) {
        let is [4096]u8 as buf;
        let is fu.Reader as r;
        fu.rd_open_fd(&r, cast(i64, 0), cast(*u8, &buf[0]), 4096);
        cat_one(&r, fl, cast(*i64, &st[0]));
        return 0;
    }
    let is i32 as rc with mut = 0;
    let is i64 as i with mut = o.ind;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb;
        let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is [4096]u8 as buf;
        let is fu.Reader as r;
        if (fu.rd_open(&r, path, cast(*u8, &buf[0]), 4096) < 0) {
            prog.outs("cat: "); prog.outs(name); prog.outs(": cannot open\n"); rc = cast(i32, 1);
        } else { cat_one(&r, fl, cast(*i64, &st[0])); fu.rd_close(&r); }
        i = i + 1;
    }
    return rc;
}
