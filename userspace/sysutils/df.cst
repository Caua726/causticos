// df — show filesystem space. df [-h] [-k]. -h human-readable, -k KiB (default).
// Reads SYS_STATFS for the mounted FAT32 volume.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/futil.cst" as fu;

let is i64 as g_human with mut = 0;

fn emit(v as i64) as void {
    if (g_human == 1) {
        if (v >= 1048576) { prog.pad_num(v / 1048576, 10); prog.outs("M"); }
        else if (v >= 1024) { prog.pad_num(v / 1024, 10); prog.outs("K"); }
        else { prog.pad_num(v, 10); prog.outs("B"); }
    } else { prog.pad_num(v / 1024, 12); }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "hk");
        if (f < 0) { break; }
        if (f == 104) { g_human = 1; } else if (f == 107) { g_human = 0; }
        else { prog.outs("usage: df [-hk]\n"); return cast(i32, 1); }
    }
    let is [3]i64 as st;
    if (sys.statfs(cast(*i64, &st[0])) != 0) { prog.outs("df: SYS_STATFS failed\n"); return cast(i32, 1); }
    let is i64 as total = st[0];
    let is i64 as free = st[1];
    let is i64 as used = total - free;
    let is i64 as pct with mut = 0;
    if (total > 0) { pct = used * 100 / total; }
    prog.outs("Filesystem         size         used        avail  use%   block\n");
    prog.outs("/          ");
    emit(total); emit(used); emit(free);
    prog.outs("   "); prog.pad_num(pct, 3); prog.outs("%   "); prog.out_num(st[2]);
    prog.out("\n", 1);
    return 0;
}
