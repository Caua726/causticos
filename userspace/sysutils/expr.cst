// expr — evaluate an expression and print the result. Each ARG is one token.
//   arithmetic:  + - * / %        (integer, with * / % above + -)
//   compare:     = != < <= > >=    (numeric if both look like ints, else string)
//   logic:       | &              (a|b = a if a truthy else b; a&b = a if both)
//   string:      STRING : REGEX   match (anchored), length, substr, index, match
//   grouping:    ( ... )
// Exit status: 0 if the result is non-null and non-zero, 1 otherwise, 2 on error.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/regex.cst" as re;

let is i64 as g_argv with mut = 0; let is i64 as g_argc with mut = 0; let is i64 as g_ti with mut = 1;
let is [8192]u8 as g_pool; let is i64 as g_pp with mut = 0;

fn slen(s as *u8) as i64 { let is i64 as n with mut = 0; while (s[n] != 0) { n = n + 1; } return n; }
fn streq(a as *u8, b as *u8) as i64 { let is i64 as i with mut = 0; while (a[i] != 0 && b[i] != 0) { if (a[i] != b[i]) { return 0; } i = i + 1; } if (a[i] == b[i]) { return 1; } return 0; }
fn scmp(a as *u8, b as *u8) as i64 { let is i64 as i with mut = 0; while (a[i] != 0 && b[i] != 0) { if (a[i] != b[i]) { if (a[i] < b[i]) { return 0 - 1; } return 1; } i = i + 1; } if (a[i] == b[i]) { return 0; } if (a[i] == 0) { return 0 - 1; } return 1; }
fn die(m as *u8) as void { prog.outs("expr: "); prog.outs(m); prog.out("\n", 1); sys.exit(cast(i32, 2)); }

fn pool_str(s as *u8, n as i64) as i64 {
    if (g_pp + n + 1 > 8192) { die("out of memory"); }
    let is i64 as start = g_pp; let is i64 as k with mut = 0;
    while (k < n) { g_pool[g_pp] = s[k]; g_pp = g_pp + 1; k = k + 1; }
    g_pool[g_pp] = cast(u8, 0); g_pp = g_pp + 1;
    return cast(i64, &g_pool[0]) + start;
}
fn pool_int(v as i64) as i64 {
    let is i64 as start = g_pp; let is i64 as x with mut = v; let is i64 as neg with mut = 0;
    if (x < 0) { neg = 1; x = 0 - x; }
    let is [24]u8 as tmp; let is i64 as k with mut = 0;
    if (x == 0) { tmp[0] = cast(u8, 48); k = 1; } else { while (x > 0) { tmp[k] = cast(u8, 48 + x - (x / 10) * 10); x = x / 10; k = k + 1; } }
    if (neg == 1) { g_pool[g_pp] = cast(u8, 45); g_pp = g_pp + 1; }
    while (k > 0) { k = k - 1; g_pool[g_pp] = tmp[k]; g_pp = g_pp + 1; }
    g_pool[g_pp] = cast(u8, 0); g_pp = g_pp + 1;
    return cast(i64, &g_pool[0]) + start;
}
fn vis_int(p as i64) as i64 {
    let is *u8 as s = cast(*u8, p); let is i64 as i with mut = 0;
    if (s[0] == 45 || s[0] == 43) { i = 1; }
    if (s[i] == 0) { return 0; }
    while (s[i] != 0) { if (s[i] < 48 || s[i] > 57) { return 0; } i = i + 1; }
    return 1;
}
fn vto_int(p as i64) as i64 {
    let is *u8 as s = cast(*u8, p); let is i64 as i with mut = 0; let is i64 as neg with mut = 0;
    if (s[0] == 45) { neg = 1; i = 1; } else if (s[0] == 43) { i = 1; }
    let is i64 as v with mut = 0; while (s[i] >= 48 && s[i] <= 57) { v = v * 10 + (cast(i64, s[i]) - 48); i = i + 1; }
    if (neg == 1) { return 0 - v; } return v;
}
fn vint(p as i64) as i64 { if (vis_int(p) == 0) { die("non-integer argument"); } return vto_int(p); }
fn vcmp(a as i64, b as i64) as i64 { if (vis_int(a) == 1 && vis_int(b) == 1) { let is i64 as x = vto_int(a); let is i64 as y = vto_int(b); if (x < y) { return 0 - 1; } if (x > y) { return 1; } return 0; } return scmp(cast(*u8, a), cast(*u8, b)); }
fn vtrue(a as i64) as i64 { let is *u8 as s = cast(*u8, a); if (s[0] == 0) { return 0; } if (s[0] == 48 && s[1] == 0) { return 0; } return 1; }

fn tok() as i64 { if (g_ti >= g_argc) { return 0; } return cast(i64, prog.arg(cast(*u8, g_argv), g_ti)); }
fn tokis(s as *u8) as i64 { let is i64 as t = tok(); if (t == 0) { return 0; } return streq(cast(*u8, t), s); }
fn adv() as void { g_ti = g_ti + 1; }

// `S : RE` — anchored match; returns the match length (or its \( \) group capture
// if present — we report length, which covers the common case).
fn do_match(l as i64, re_p as i64) as i64 {
    let is *u8 as str = cast(*u8, l); let is *u8 as pat = cast(*u8, re_p);
    if (re.re_compile(pat, slen(pat), 0, 0) != 0) { return pool_int(0); }
    let is [1]i64 as ms; let is [1]i64 as me;
    if (re.re_search(str, slen(str), cast(*i64, &ms[0]), cast(*i64, &me[0])) == 0) { return pool_int(0); }
    if (ms[0] != 0) { return pool_int(0); }                    // ':' anchors at the start
    return pool_int(me[0]);
}
fn do_substr(s as i64, pos as i64, len as i64) as i64 {
    let is *u8 as str = cast(*u8, s); let is i64 as n = slen(str);
    if (pos < 1 || len < 0 || pos > n) { return pool_str(cast(*u8, ""), 0); }
    let is i64 as a = pos - 1; let is i64 as b with mut = a + len; if (b > n) { b = n; }
    return pool_str(cast(*u8, cast(i64, str) + a), b - a);
}
fn do_index(s as i64, chars as i64) as i64 {
    let is *u8 as str = cast(*u8, s); let is *u8 as set = cast(*u8, chars);
    let is i64 as i with mut = 0;
    while (str[i] != 0) { let is i64 as j with mut = 0; while (set[j] != 0) { if (str[i] == set[j]) { return i + 1; } j = j + 1; } i = i + 1; }
    return 0;
}

// p_atom calls p_or for parentheses; the 2-pass compiler resolves the forward ref.
fn p_atom() as i64 {
    if (tokis("(") == 1) { adv(); let is i64 as v = p_or(); if (tokis(")") == 1) { adv(); } else { die("unbalanced ("); } return v; }
    if (tokis("length") == 1) { adv(); let is i64 as a = p_atom(); return pool_int(slen(cast(*u8, a))); }
    if (tokis("substr") == 1) { adv(); let is i64 as s = p_atom(); let is i64 as pp = p_atom(); let is i64 as ll = p_atom(); return do_substr(s, vint(pp), vint(ll)); }
    if (tokis("index") == 1) { adv(); let is i64 as s = p_atom(); let is i64 as cs = p_atom(); return pool_int(do_index(s, cs)); }
    if (tokis("match") == 1) { adv(); let is i64 as s = p_atom(); let is i64 as r = p_atom(); return do_match(s, r); }
    let is i64 as t = tok(); adv();
    if (t == 0) { die("syntax error: missing operand"); }
    return t;
}
fn p_match() as i64 { let is i64 as l with mut = p_atom(); while (tokis(":") == 1) { adv(); let is i64 as r = p_atom(); l = do_match(l, r); } return l; }
fn p_mul() as i64 {
    let is i64 as l with mut = p_match();
    while (tokis("*") == 1 || tokis("/") == 1 || tokis("%") == 1) {
        let is i64 as op with mut = 0; if (tokis("/") == 1) { op = 1; } else if (tokis("%") == 1) { op = 2; }
        adv(); let is i64 as r = p_match(); let is i64 as x = vint(l); let is i64 as y = vint(r);
        if (op == 0) { l = pool_int(x * y); } else { if (y == 0) { die("division by zero"); } if (op == 1) { l = pool_int(x / y); } else { l = pool_int(x - (x / y) * y); } }
    }
    return l;
}
fn p_add() as i64 {
    let is i64 as l with mut = p_mul();
    while (tokis("+") == 1 || tokis("-") == 1) { let is i64 as plus = tokis("+"); adv(); let is i64 as r = p_mul(); let is i64 as x = vint(l); let is i64 as y = vint(r); if (plus == 1) { l = pool_int(x + y); } else { l = pool_int(x - y); } }
    return l;
}
fn p_rel() as i64 {
    let is i64 as l = p_add();
    let is i64 as op with mut = 0;
    if (tokis("=") == 1) { op = 1; } else if (tokis("!=") == 1) { op = 2; } else if (tokis("<") == 1) { op = 3; } else if (tokis("<=") == 1) { op = 4; } else if (tokis(">") == 1) { op = 5; } else if (tokis(">=") == 1) { op = 6; }
    if (op == 0) { return l; }
    adv(); let is i64 as r = p_add(); let is i64 as c = vcmp(l, r); let is i64 as res with mut = 0;
    if (op == 1 && c == 0) { res = 1; } else if (op == 2 && c != 0) { res = 1; } else if (op == 3 && c < 0) { res = 1; } else if (op == 4 && c <= 0) { res = 1; } else if (op == 5 && c > 0) { res = 1; } else if (op == 6 && c >= 0) { res = 1; }
    return pool_int(res);
}
fn p_and() as i64 { let is i64 as l with mut = p_rel(); while (tokis("&") == 1) { adv(); let is i64 as r = p_rel(); if (vtrue(l) == 0 || vtrue(r) == 0) { l = pool_int(0); } } return l; }
fn p_or() as i64 { let is i64 as l with mut = p_and(); while (tokis("|") == 1) { adv(); let is i64 as r = p_and(); if (vtrue(l) == 0) { l = r; } } return l; }

fn main(argc as i64, argv as *u8) as i32 {
    g_argv = cast(i64, argv); g_argc = argc; g_ti = 1;
    if (argc < 2) { prog.outs("usage: expr EXPRESSION\n"); return cast(i32, 2); }
    let is i64 as r = p_or();
    if (g_ti < g_argc) { die("syntax error: unexpected argument"); }
    prog.outs(cast(*u8, r)); prog.out("\n", 1);
    if (vtrue(r) == 1) { return cast(i32, 0); }
    return cast(i32, 1);
}
