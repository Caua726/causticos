// lscpu — per-CPU summary, mirrors `lscpu(1)` shape on Linux.
// Reads SYS_CPU_STAT: out[0] = ncpu, out[1..] = sampled busy ticks per cpu.
// busy here is a kernel-sampled counter (the same value ps/top consume);
// we render it as a percentage of the sample window — not a live load
// average (no /proc/stat ticks), just the moment the syscall returned.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;

fn pad_r(s as *u8, w as i64) as void {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    let is i64 as k with mut = 0;
    while (k < w - n) { prog.outs(" "); k = k + 1; }
    prog.outs(s);
}

fn main(argc as i64, argv as *u8) as i32 {
    let is [17]i64 as cs;
    let is i64 as n = sys.cpu_stat(cast(*i64, &cs[0]));
    if (n <= 0) {
        prog.outs("lscpu: SYS_CPU_STAT failed\n");
        return cast(i32, 1);
    }
    let is i64 as ncpu = cs[0];
    // "Architecture: x86_64" — the kernel is x86_64 only today.
    prog.outs("Architecture:        x86_64\n");
    let is [16]u8 as nbuf;
    prog.out_num(ncpu); prog.outs("\0");
    let is i64 as k with mut = 0;
    while (k < 16 && cast(i64, prog.arg(cast(*u8, 0), 0)[0]) == 0) { k = k + 1; }   // unused; just for digit extraction
    // Render ncpu via out_num then a newline helper; simpler: just call again.
    prog.outs("CPU(s):              ");
    prog.out_num(ncpu); prog.out("\n", 1);
    prog.outs("Thread(s) per core:  1\n");
    prog.outs("Core(s) per socket:  ");
    prog.out_num(ncpu); prog.out("\n", 1);
    prog.outs("Socket(s):           1\n");
    prog.outs("Vendor:              (unknown)\n");
    prog.outs("Model name:          (no CPUID string)\n");
    prog.outs("\n");
    prog.outs("CPU busy (sampled ticks, 0..N):\n");
    let is i64 as total with mut = 0;
    let is i64 as j with mut = 1;
    while (j <= ncpu) { total = total + cs[j]; j = j + 1; }
    if (total <= 0) { total = 1; }                                  // avoid /0
    j = 0;
    while (j < ncpu) {
        prog.outs("  CPU "); prog.out_num(j);
        prog.outs(": ");
        // Right-align the busy value into a 12-char field.
        let is i64 as b = cs[j + 1];
        let is i64 as w with mut = 0;
        let is i64 as t with mut = b;
        if (t == 0) { w = 1; } else { while (t > 0) { w = w + 1; t = t / 10; } }
        let is i64 as sp with mut = 0;
        while (sp < 12 - w) { prog.outs(" "); sp = sp + 1; }
        prog.out_num(b); prog.outs(" (");
        let is i64 as pct = b * 100 / total;
        prog.out_num(pct); prog.outs("%)");
        // mark the BSP (cpu 0) so the user can tell which is which.
        if (j == 0) { prog.outs("  [BSP]"); }
        prog.out("\n", 1);
        j = j + 1;
    }
    return cast(i32, 0);
}
