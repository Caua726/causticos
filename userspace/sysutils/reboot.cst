// reboot — reset the machine (ACPI reset register, then 0xCF9, then i8042).
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;

fn main(argc as i64, argv as *u8) as i32 {
    prog.outs("Rebooting...\n");
    sys.reboot();                         // does not return on success
    prog.outs("reboot: reset failed\n");
    return cast(i32, 1);
}
