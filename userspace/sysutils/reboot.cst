// reboot — restart the machine the way poweroff powers it off: on a desktop
// every window is asked to close first, and one holding unsaved work calls it
// off; the files are written out before the reset. With no desktop running it
// goes at once.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;

fn main(argc as i64, argv as *u8) as i32 {
    prog.outs("Restarting...\n");
    sys.power_request(sys.POWER_REBOOT);  // returns once a desktop has taken it
    return cast(i32, 0);
}
