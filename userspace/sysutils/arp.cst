// arp — what the stack believes about its neighbours.
//
// The cache is not a lookup table, it is a set of claims with expiry dates,
// and the state is the interesting column: REACHABLE means somebody answered
// recently, STALE means somebody answered a while ago and we will re-check
// when we next need it, INCOMPLETE means we asked and nobody has answered yet.
// A tool that printed only address-to-MAC would hide the difference between
// "this neighbour is there" and "this neighbour has never replied".
//
//   arp

use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/netproto/netproto.cst" as np;
use "../lib/netcli/netcli.cst" as nc;
use "../lib/netarp/netarp.cst" as arp;
use "../lib/netip/netip.cst" as ip;

fn print_ip(v as i64) as void {
    let is i64 as i with mut = 0;
    while (i < 4) {
        if (i > 0) { prog.outs("."); }
        prog.out_num(ip.addr_octet(v, i));
        i = i + 1;
    }
    return;
}

fn hex2(v as i64) as void {
    let is [2]u8 as b;
    let is i64 as hi = (v >> 4) & 15;
    let is i64 as lo = v & 15;
    if (hi < 10) { b[0] = cast(u8, 48 + hi); } else { b[0] = cast(u8, 87 + hi); }
    if (lo < 10) { b[1] = cast(u8, 48 + lo); } else { b[1] = cast(u8, 87 + lo); }
    prog.out(cast(*u8, &b[0]), 2);
    return;
}

fn print_mac(packed as i64) as void {
    let is i64 as i with mut = 0;
    while (i < 6) {
        if (i > 0) { prog.outs(":"); }
        hex2((packed >> ((5 - i) * 8)) & 0xFF);
        i = i + 1;
    }
    return;
}

fn print_state(s as i64) as void {
    if (s == arp.ST_INCOMPLETE) { prog.outs("INCOMPLETE"); return; }
    if (s == arp.ST_REACHABLE)  { prog.outs("REACHABLE "); return; }
    if (s == arp.ST_STALE)      { prog.outs("STALE     "); return; }
    if (s == arp.ST_PROBE)      { prog.outs("PROBE     "); return; }
    prog.outs("?         ");
    return;
}

fn pad_to(n as i64, width as i64) as void {
    let is i64 as i with mut = n;
    while (i < width) { prog.outs(" "); i = i + 1; }
    return;
}

fn main(argc as i64, argv as *u8) as i32 {
    if (nc.attach(np.NET_FD) != 0) {
        prog.outs("arp: no netd on fd 6\n");
        return cast(i32, 1);
    }

    if (np.send(nc.ctl_fd(), np.REQ_ARPDUMP, 0, 0, 0) < 0) {
        prog.outs("arp: netd did not take the request\n");
        return cast(i32, 1);
    }

    prog.outs("if  address          state       hardware\n");
    let is i64 as n with mut = 0;
    let is i64 as deadline = sys.time_ns() + 3000000000;
    while (1 == 1) {
        let is i64 as t = nc.pump(deadline);
        if (t <= 0) {
            prog.outs("arp: netd stopped answering\n");
            return cast(i32, 1);
        }
        if (t == np.EV_ARP_END) {
            prog.out_num(nc.last_word(2));
            prog.outs(" entries\n");
            return cast(i32, 0);
        }
        if (t != np.EV_ARP) { continue; }

        let is i64 as iface = nc.last_word(1);
        let is i64 as addr = nc.last_word(2);
        let is i64 as packed = nc.last_word(3);
        prog.out_num(iface);
        prog.outs("   ");
        print_ip(addr);
        // Addresses are up to 15 characters; the column is 17 so the state
        // always starts in the same place whatever the address is.
        let is i64 as w with mut = 0;
        let is i64 as k with mut = 0;
        while (k < 4) {
            let is i64 as o = ip.addr_octet(addr, k);
            w = w + 1;
            if (o >= 10) { w = w + 1; }
            if (o >= 100) { w = w + 1; }
            k = k + 1;
        }
        pad_to(w + 3, 17);
        print_state((packed >> 48) & 0xFFFF);
        prog.outs("  ");
        // An INCOMPLETE entry has no hardware address yet, and printing
        // 00:00:00:00:00:00 would look like an answer rather than the absence
        // of one.
        if (((packed >> 48) & 0xFFFF) == arp.ST_INCOMPLETE) { prog.outs("(none)"); }
        else { print_mac(packed & 0xFFFFFFFFFFFF); }
        prog.outs("\n");
        n = n + 1;
    }
    return cast(i32, 0);
}
