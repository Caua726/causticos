// top — a live process/memory monitor. top [-d N]. Redraws every N seconds
// (default 2), processes sorted by memory (largest first), with names and
// %mem. q quits. Run bare (no stdin) it draws one frame and exits.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;
use "../lib/proclist/proclist.cst" as pl;

// The last snapshot (every process, lib/proclist) and the order it is shown in.
let is pl.Snap as g_snap;
let is i64 as g_ord with mut = 0;
let is i64 as g_ordcap with mut = 0;
fn padstr(s as *u8, w as i64) as void {
    prog.outs(s);
    let is i64 as k with mut = prog.slen(s);
    while (k < w) { prog.outs(" "); k = k + 1; }
}

fn draw() as void {
    let is [1]u8 as ff; ff[0] = cast(u8, 12); prog.out(cast(*u8, &ff[0]), 1);   // clear
    let is [4]i64 as mi;
    let is i64 as totalkb with mut = 1;
    if (sys.mem_info(cast(*i64, &mi[0])) == 0) {
        let is i64 as pagesz = mi[2];
        totalkb = mi[0] * pagesz / 1024;
        let is i64 as freekb = mi[1] * pagesz / 1024;
        prog.outs("top - mem "); prog.out_num(totalkb - freekb); prog.outs("/"); prog.out_num(totalkb); prog.outs(" KB used");
    }
    let is i64 as rc = pl.take(&g_snap);
    if (rc < 0) { prog.errs("\ntop: cannot read the process list: "); prog.errs(sys.err_text(rc)); prog.errs("\n"); return; }
    let is i64 as n = g_snap.n;
    prog.outs(",  "); prog.out_num(n); prog.outs(" procs\n");
    if (n > g_ordcap) {
        let is i64 as nc = n + n / 4 + 8;
        let is i64 as va = sys.mmap(0, nc * 8, sys.PROT_READ | sys.PROT_WRITE);
        if (va < 0) { prog.errs("top: out of memory\n"); return; }
        if (g_ordcap > 0) { sys.munmap(g_ord, g_ordcap * 8); }
        g_ord = va; g_ordcap = nc;
    }
    let is *i64 as ord = cast(*i64, g_ord);
    // by resident memory, largest first (insertion sort over an index)
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as m = pl.rec(&g_snap, i)[pl.F_RSS];
        let is i64 as j with mut = i - 1;
        while (j >= 0 && pl.rec(&g_snap, ord[j])[pl.F_RSS] < m) { ord[j + 1] = ord[j]; j = j - 1; }
        ord[j + 1] = i;
        i = i + 1;
    }

    prog.outs("  PID  STATE    NAME             THR        MEM  %MEM\n");
    i = 0;
    while (i < n) {
        let is *i64 as r = pl.rec(&g_snap, ord[i]);
        prog.pad_num(r[pl.F_PID], 5); prog.outs("  ");
        padstr(pl.state_name(r), 9);
        padstr(pl.name(&g_snap, ord[i]), 16); prog.outs(" ");
        prog.pad_num(r[pl.F_THREADS], 3); prog.outs("  ");
        prog.pad_num(r[pl.F_RSS], 9); prog.outs("  ");
        let is i64 as pct with mut = 0;
        if (totalkb > 0) { pct = r[pl.F_RSS] / 1024 * 100 / totalkb; }
        prog.pad_num(pct, 3); prog.outs("%");
        prog.out("\n", 1);
        i = i + 1;
    }
    prog.outs("[q to quit]\n");
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as delay_ns with mut = 2000000000;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "d:");
        if (f < 0) { break; }
        if (f == 100) { let is *u8 as va = cast(*u8, o.optarg); let is i64 as d = fu.parse_uint(va, prog.slen(va)); if (d > 0) { delay_ns = d * 1000000000; } }
        else { prog.errs("usage: top [-d N]\n"); return cast(i32, 1); }
    }
    while (1 == 1) {
        draw();
        let is [3]i64 as pe;
        pe[0] = 0; pe[1] = sys.POLL_READABLE; pe[2] = 0;
        sys.poll(cast(*i64, &pe[0]), 1, delay_ns);
        let is i64 as got = pe[2];
        if ((got & sys.POLL_ERROR) != 0 || (got & sys.POLL_CLOSED) != 0) { return 0; }
        if ((got & sys.POLL_READABLE) != 0) {
            let is [1]u8 as bb;
            let is i64 as r = sys.read(cast(i64, 0), cast(*u8, &bb[0]), 1);
            if (r > 0 && cast(i64, bb[0]) == 113) { return 0; }
        }
    }
    return 0;
}
