// nslookup — what does this name resolve to.
//
// The whole program is one call, because the resolver lives in netd: the
// cache, the retries, the query ids drawn from the kernel's entropy. A tool
// that reimplemented any of that would be answering from a second resolver
// with a second opinion, and the point of asking is to see what the machine
// itself will do with the name.
//
//   nslookup example.com
//   nslookup 10.0.2.2        — a literal answers as itself, without a query

use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/netproto/netproto.cst" as np;
use "../lib/netcli/netcli.cst" as nc;
use "../lib/netip/netip.cst" as ip;

fn print_ip(v as i64) as void {
    let is i64 as i with mut = 0;
    while (i < 4) {
        if (i > 0) { prog.outs("."); }
        prog.out_num(ip.addr_octet(v, i));
        i = i + 1;
    }
    return;
}

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 2) {
        prog.outs("usage: nslookup <name>\n");
        return cast(i32, 1);
    }
    let is *u8 as name = prog.arg(argv, 1);
    let is i64 as len with mut = 0;
    while (name[len] != cast(u8, 0)) { len = len + 1; }

    if (nc.attach(np.NET_FD) != 0) {
        prog.outs("nslookup: no netd on fd 6\n");
        return cast(i32, 1);
    }
    if (nc.wait_address(10000000000) == 0) {
        prog.outs("nslookup: no address yet\n");
        return cast(i32, 1);
    }

    let is i64 as t0 = sys.time_ns();
    let is i64 as addr = nc.resolve(name, len);
    let is i64 as dt = sys.time_ns() - t0;

    if (addr == 0) {
        // A definite nothing, not a timeout: netd answers NXDOMAIN as an
        // answer, so a caller can fail fast instead of waiting one out.
        prog.outs("nslookup: ");
        prog.out(name, len);
        prog.outs(" not found\n");
        return cast(i32, 1);
    }
    prog.out(name, len);
    prog.outs(" -> ");
    print_ip(addr);
    prog.outs("  (");
    prog.out_num(dt / 1000000);
    prog.outs(" ms)\n");
    return cast(i32, 0);
}
