// ifconfig — what network ports this machine has, and what they are doing.
//
// The first program to reach a NIC. Everything it prints crosses the ring
// boundary through the DEV_NET contract: dev_count says how many ports there
// are, dev_open takes one, and net_info reports the state of the port behind
// the fd it hands back.
//
// Reporting only, for now: there is no address to show because addressing is
// netd's job and netd does not exist yet. What this proves is the layer under
// it — that a program can hold a network port at all.
//
//   ifconfig          — every port
//   ifconfig 1        — one port by index
//   ifconfig -w 0     — watch port 0's counters, once a second

use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;

fn put_hex2(v as i64) as void {
    let is [2]u8 as d;
    let is i64 as hi = (v >> 4) & 0xF;
    let is i64 as lo = v & 0xF;
    if (hi < 10) { d[0] = cast(u8, 48 + hi); } else { d[0] = cast(u8, 87 + hi); }
    if (lo < 10) { d[1] = cast(u8, 48 + lo); } else { d[1] = cast(u8, 87 + lo); }
    prog.out(cast(*u8, &d[0]), 2);
    return;
}

fn print_mac(packed as i64) as void {
    let is i64 as i with mut = 0;
    while (i < 6) {
        if (i > 0) { prog.outs(":"); }
        put_hex2(sys.net_mac_byte(packed, i));
        i = i + 1;
    }
    return;
}

// One port, long form.
fn show(index as i64) as i64 {
    let is i64 as fd = sys.dev_open(sys.DEV_NET, index, 0);
    if (fd < 0) {
        prog.outs("net"); prog.out_num(index);
        prog.outs(": cannot open (");
        prog.out_num(fd);
        prog.outs(")\n");
        return 1;
    }
    let is [16]i64 as inf;
    let is i64 as rc = sys.net_info(fd, cast(*i64, &inf[0]));
    if (rc != 0) {
        prog.outs("net"); prog.out_num(index);
        prog.outs(": net_info failed ("); prog.out_num(rc); prog.outs(")\n");
        sys.close(fd);
        return 1;
    }

    prog.outs("net"); prog.out_num(index);
    prog.outs(": ");
    // Words 12..15 are the driver's name, NUL-padded.
    let is *u8 as nm = cast(*u8, &inf[12]);
    let is i64 as nl with mut = 0;
    while (nl < 32 && nm[nl] != cast(u8, 0)) { nl = nl + 1; }
    if (nl > 0) { prog.out(nm, nl); prog.outs(" "); }
    if (inf[2] != 0) { prog.outs("UP"); } else { prog.outs("DOWN"); }
    if ((inf[5] & sys.NET_FLAG_BROADCAST) != 0) { prog.outs(" BROADCAST"); }
    if ((inf[5] & sys.NET_FLAG_PROMISC) != 0) { prog.outs(" PROMISC"); }
    prog.outs("\n");

    prog.outs("        ether "); print_mac(inf[4]);
    prog.outs("  mtu "); prog.out_num(inf[0]);
    prog.outs("  frame_max "); prog.out_num(inf[1]);
    if (inf[3] > 0) { prog.outs("  "); prog.out_num(inf[3]); prog.outs("Mb/s"); }
    prog.outs("\n");

    prog.outs("        RX packets "); prog.out_num(inf[6]);
    prog.outs("  dropped "); prog.out_num(inf[7]);
    prog.outs("  oversized "); prog.out_num(inf[8]);
    prog.outs("\n");
    prog.outs("        TX packets "); prog.out_num(inf[9]);
    prog.outs("  errors "); prog.out_num(inf[10]);
    prog.outs("\n");

    sys.close(fd);
    return 0;
}

// Counters only, one line, for watch mode.
fn show_counters(fd as i64) as void {
    let is [12]i64 as inf;
    if (sys.net_info(fd, cast(*i64, &inf[0])) != 0) { return; }
    prog.outs("  rx "); prog.out_num(inf[6]);
    prog.outs("  rxdrop "); prog.out_num(inf[7]);
    prog.outs("  tx "); prog.out_num(inf[9]);
    prog.outs("  txerr "); prog.out_num(inf[10]);
    prog.outs("  link ");
    if (inf[2] != 0) { prog.outs("up"); } else { prog.outs("down"); }
    prog.outs("\n");
    return;
}

// Watch holds the port open across every sample. That is the honest shape:
// closing between samples would hand the port back to whoever held it before
// and take it again, and counters read through a port you are not holding are
// somebody else's business.
fn watch(index as i64) as i64 {
    let is i64 as fd = sys.dev_open(sys.DEV_NET, index, 0);
    if (fd < 0) { prog.outs("cannot open port\n"); return 1; }
    prog.outs("watching net"); prog.out_num(index); prog.outs(" (Ctrl+C to stop)\n");
    while (1 == 1) {
        show_counters(fd);
        sys.sleep_ns(1000000000);
    }
    sys.close(fd);
    return 0;
}

fn is_digit(c as i64) as i64 {
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}

fn parse_num(s as *u8) as i64 {
    let is i64 as v with mut = 0;
    let is i64 as i with mut = 0;
    while (s[i] != cast(u8, 0)) {
        if (is_digit(cast(i64, s[i])) == 0) { return 0 - 1; }
        v = v * 10 + (cast(i64, s[i]) - 48);
        i = i + 1;
    }
    if (i == 0) { return 0 - 1; }
    return v;
}

fn main(argc as i64, argv as *u8) as i32 {
    let is i64 as n = sys.dev_count(sys.DEV_NET);
    if (n <= 0) {
        prog.outs("no network ports\n");
        return cast(i32, 1);
    }

    if (argc >= 2) {
        let is *u8 as a1 = prog.arg(argv, 1);
        if (a1[0] == cast(u8, 45) && a1[1] == cast(u8, 119)) {      // "-w"
            let is i64 as idx with mut = 0;
            if (argc >= 3) { idx = parse_num(prog.arg(argv, 2)); }
            if (idx < 0 || idx >= n) { prog.outs("no such port\n"); return cast(i32, 1); }
            return cast(i32, watch(idx));
        }
        let is i64 as one = parse_num(a1);
        if (one < 0 || one >= n) {
            prog.outs("no such port (have ");
            prog.out_num(n);
            prog.outs(")\n");
            return cast(i32, 1);
        }
        return cast(i32, show(one));
    }

    let is i64 as i with mut = 0;
    let is i64 as bad with mut = 0;
    while (i < n) {
        bad = bad + show(i);
        i = i + 1;
    }
    if (bad != 0) { return cast(i32, 1); }
    return cast(i32, 0);
}
