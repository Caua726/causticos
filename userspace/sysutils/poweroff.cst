// poweroff — power the machine off via ACPI S5 soft-off.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;

fn main(argc as i64, argv as *u8) as i32 {
    prog.outs("Powering off...\n");
    sys.poweroff();                       // does not return on success
    prog.outs("poweroff: ACPI soft-off failed\n");
    return cast(i32, 1);
}
