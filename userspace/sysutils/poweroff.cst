// poweroff — power the machine off the way the power button does. On a
// desktop every window is asked to close first, and one holding unsaved work
// calls it off; the files are written out before the power goes. With no
// desktop running it goes at once. Asking again while it is pending (a second
// `poweroff`, the button) goes down regardless.
//
// It used to call SYS_POWEROFF directly: the files were synced, but every
// window was killed as it stood.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;

fn main(argc as i64, argv as *u8) as i32 {
    prog.outs("Powering off...\n");
    sys.power_request(sys.POWER_OFF);     // returns once a desktop has taken it
    return cast(i32, 0);
}
