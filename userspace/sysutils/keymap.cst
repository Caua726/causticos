// keymap — the keyboard layout: which one is in use, which there are, and
// choosing one.
//
//   keymap                 the layout in use, and where that choice comes from
//   keymap list            every layout there is (* = the one in use)
//   keymap set <name>      use <name> from now on (kept in /var/keymap)
//   keymap reset           back to the image's default (/etc/keymap)
//   keymap show <name>     print a layout's map; `keymap show us` prints the
//                          compiled-in one, a place to start a layout of your own
//   keymap check <file>    read a map file and say what is wrong with it, if
//                          anything, before it goes into /etc/keymaps
//
// The layouts and the file format are lib/keymap's (keymap.cst says it all).
// This only reads and writes the two names: the desktop picks a change up
// within a second, the fullscreen shell at its next prompt.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/keymap/keymap.cst" as km;

let is km.Keymap as k with mut;

fn streq(a as *u8, b as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (a[i] != 0 && b[i] != 0) { if (a[i] != b[i]) { return 0; } i = i + 1; }
    if (a[i] == b[i]) { return 1; }
    return 0;
}

fn err_num(v as i64) as void {
    let is [24]u8 as b;
    let is i64 as i with mut = 24;
    let is i64 as x with mut = v;
    if (x == 0) { prog.errs("0"); return; }
    while (x > 0) { i = i - 1; b[i] = cast(u8, 48 + x % 10); x = x / 10; }
    prog.err(cast(*u8, &b[i]), 24 - i);
}

fn usage() as i32 {
    prog.errs("usage: keymap [list | set <name> | reset | show <name> | check <file>]\n");
    return cast(i32, 2);
}

fn pad(n as i64, width as i64) as void {
    let is i64 as i with mut = n;
    while (i < width) { prog.out(" ", 1); i = i + 1; }
}

// "<line>: <why>" for a map that did not load.
fn say_why(rc as i64) as void {
    if (rc > 0) { prog.errs("line "); err_num(rc); prog.errs(": "); }
    prog.err(km.why_ptr(), km.why_len());
    prog.errs("\n");
}

// The layout in use and where the choice comes from.
fn current() as i32 {
    let is [32]u8 as nm;
    let is [1]i64 as src;
    let is i64 as n = km.chosen_src(cast(*u8, &nm[0]), cast(*i64, &src[0]));
    prog.out(cast(*u8, &nm[0]), n);
    let is i64 as rc = km.load(&k, cast(*u8, &nm[0]), n);
    if (rc == 0) { prog.outs("  "); prog.out(km.name_ptr(&k), km.name_len(&k)); }
    if (src[0] == 1) { prog.outs("  (chosen with `keymap set`, kept in /var/keymap)\n"); }
    else if (src[0] == 2) { prog.outs("  (the default, from /etc/keymap)\n"); }
    else { prog.outs("  (nothing chosen: the built-in one)\n"); }
    if (rc != 0) {
        prog.errs("keymap: but it does not load, so the keyboard is US: ");
        say_why(rc);
        return cast(i32, 1);
    }
    return cast(i32, 0);
}

// Every layout: the built-in one, then /etc/keymaps, in name order.
let is [2048]u8 as names;
let is [64]i64 as noff;
let is [64]i64 as nlen;

fn list() as i32 {
    let is [32]u8 as cur;
    let is i64 as cn = km.chosen(cast(*u8, &cur[0]));
    let is i64 as count with mut = 0;
    let is i64 as used with mut = 0;
    // "us" first: it is always there.
    names[0] = cast(u8, 117); names[1] = cast(u8, 115);
    noff[0] = 0; nlen[0] = 2; count = 1; used = 2;
    let is i64 as fd = sys.open_read("/etc/keymaps");
    if (fd >= 0) {
        let is [320]u8 as de;
        while (count < 64 && sys.readdir(fd, cast(*u8, &de[0])) == 0) {
            let is *i64 as nlp = cast(*i64, cast(i64, &de[0]) + 256);
            let is i64 as nl = nlp[0] - 4;
            if (nl > 0 && nlp[0] < 36 && de[nl] == cast(u8, 46) && de[nl + 1] == cast(u8, 109)
                && de[nl + 2] == cast(u8, 97) && de[nl + 3] == cast(u8, 112)
                && km.is_builtin(cast(*u8, &de[0]), nl) == 0 && used + nl <= 2048) {
                let is i64 as j with mut = 0;
                while (j < nl) { names[used + j] = de[j]; j = j + 1; }
                noff[count] = used; nlen[count] = nl;
                used = used + nl;
                count = count + 1;
            }
        }
        sys.close(fd);
    }
    // Insertion sort, after "us": a handful of names.
    let is i64 as a with mut = 2;
    while (a < count) {
        let is i64 as b with mut = a;
        while (b > 1 && before(noff[b], nlen[b], noff[b - 1], nlen[b - 1]) == 1) {
            let is i64 as to = noff[b]; noff[b] = noff[b - 1]; noff[b - 1] = to;
            let is i64 as tl = nlen[b]; nlen[b] = nlen[b - 1]; nlen[b - 1] = tl;
            b = b - 1;
        }
        a = a + 1;
    }
    let is i64 as i with mut = 0;
    while (i < count) {
        let is *u8 as nm = cast(*u8, cast(i64, &names[0]) + noff[i]);
        let is i64 as n = nlen[i];
        if (same(nm, n, cast(*u8, &cur[0]), cn) == 1) { prog.outs("* "); } else { prog.outs("  "); }
        prog.out(nm, n);
        pad(n, 12);
        let is i64 as rc = km.load(&k, nm, n);
        if (rc == 0) { prog.out(km.name_ptr(&k), km.name_len(&k)); prog.outs("\n"); }
        else {
            prog.outs("(broken: ");
            if (rc > 0) { prog.outs("line "); prog.out_num(rc); prog.outs(": "); }
            prog.out(km.why_ptr(), km.why_len());
            prog.outs(")\n");
        }
        i = i + 1;
    }
    return cast(i32, 0);
}

fn same(a as *u8, an as i64, b as *u8, bn as i64) as i64 {
    if (an != bn) { return 0; }
    let is i64 as i with mut = 0;
    while (i < an) { if (a[i] != b[i]) { return 0; } i = i + 1; }
    return 1;
}

fn before(ao as i64, an as i64, bo as i64, bn as i64) as i64 {
    let is i64 as i with mut = 0;
    while (i < an && i < bn) {
        if (names[ao + i] < names[bo + i]) { return 1; }
        if (names[ao + i] > names[bo + i]) { return 0; }
        i = i + 1;
    }
    if (an < bn) { return 1; }
    return 0;
}

fn set(name as *u8) as i32 {
    let is i64 as n = prog.slen(name);
    let is i64 as rc = km.load(&k, name, n);
    if (rc < 0 && km.valid_name(name, n) == 1) {
        prog.errs("keymap: no layout called "); prog.errs(name); prog.errs(" (`keymap list` shows them)\n");
        return cast(i32, 1);
    }
    if (rc != 0) {
        prog.errs("keymap: "); prog.errs(name); prog.errs(": ");
        say_why(rc);
        return cast(i32, 1);
    }
    // /var may not exist on a fresh disk; "already exists" is as good.
    sys.mkdir("/var");
    // Written whole and then renamed over: the compositor reads it once a
    // second, and must never see half a name.
    let is i64 as fd = sys.open_write("/var/keymap.new");
    if (fd < 0) { prog.errs("keymap: cannot write /var/keymap.new: "); prog.errs(sys.err_text(fd)); prog.errs("\n"); return cast(i32, 1); }
    let is [33]u8 as line;
    let is i64 as i with mut = 0;
    while (i < n) { line[i] = name[i]; i = i + 1; }
    line[n] = cast(u8, 10);
    let is i64 as w = sys.write(fd, cast(*u8, &line[0]), n + 1);
    sys.close(fd);
    if (w != n + 1) {
        sys.unlink("/var/keymap.new");
        prog.errs("keymap: cannot write /var/keymap.new");
        if (w < 0) { prog.errs(": "); prog.errs(sys.err_text(w)); }
        prog.errs("\n");
        return cast(i32, 1);
    }
    let is i64 as rr = cast(i64, sys.rename("/var/keymap.new", "/var/keymap"));
    if (rr != 0) {
        sys.unlink("/var/keymap.new");
        prog.errs("keymap: cannot replace /var/keymap: "); prog.errs(sys.err_text(rr)); prog.errs("\n");
        return cast(i32, 1);
    }
    prog.outs("keymap: "); prog.out(name, n); prog.outs("  "); prog.out(km.name_ptr(&k), km.name_len(&k)); prog.outs("\n");
    return cast(i32, 0);
}

fn reset() as i32 {
    let is i64 as rc = cast(i64, sys.unlink("/var/keymap"));
    if (rc != 0 && rc != sys.E_NOENT) {
        prog.errs("keymap: cannot remove /var/keymap: "); prog.errs(sys.err_text(rc)); prog.errs("\n");
        return cast(i32, 1);
    }
    return current();
}

fn show(name as *u8) as i32 {
    let is i64 as n = prog.slen(name);
    if (km.is_builtin(name, n) == 1) { prog.outs(km.builtin_text()); return cast(i32, 0); }
    if (km.valid_name(name, n) == 0) {
        prog.errs("keymap: a layout name is letters, digits, - and _\n");
        return cast(i32, 2);
    }
    let is [64]u8 as p;
    let is *u8 as path = km.map_path(name, n, cast(*u8, &p[0]));
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { prog.errs("keymap: no layout called "); prog.errs(name); prog.errs(" (`keymap list` shows them)\n"); return cast(i32, 1); }
    let is [1024]u8 as buf;
    while (1 == 1) {
        let is i64 as r = sys.read(fd, cast(*u8, &buf[0]), 1024);
        if (r <= 0) { break; }
        prog.out(cast(*u8, &buf[0]), r);
    }
    sys.close(fd);
    return cast(i32, 0);
}

let is [8192]u8 as text;

fn check(file as *u8) as i32 {
    let is [256]u8 as pb;
    let is *u8 as path = prog.abspath(file, cast(*u8, &pb[0]));
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { prog.errs("keymap: "); prog.errs(file); prog.errs(": "); prog.errs(sys.err_text(fd)); prog.errs("\n"); return cast(i32, 1); }
    let is i64 as len with mut = 0;
    while (len < 8192) {
        let is i64 as r = sys.read(fd, cast(*u8, cast(i64, &text[0]) + len), 8192 - len);
        if (r <= 0) { break; }
        len = len + r;
    }
    sys.close(fd);
    if (len >= 8192) { prog.errs("keymap: "); prog.errs(file); prog.errs(": over 8 KB, more than any layout\n"); return cast(i32, 1); }
    let is i64 as rc = km.load_text(&k, cast(*u8, &text[0]), len, "check", 5);
    if (rc != 0) {
        prog.errs(file); prog.errs(":"); err_num(rc); prog.errs(": ");
        prog.err(km.why_ptr(), km.why_len());
        prog.errs("\n");
        return cast(i32, 1);
    }
    prog.outs(file); prog.outs(": ok");
    if (km.name_len(&k) > 0) { prog.outs("  "); prog.out(km.name_ptr(&k), km.name_len(&k)); }
    prog.outs("\n");
    return cast(i32, 0);
}

fn main(argc as i64, argv as *u8) as i32 {
    km.init(&k);
    if (argc <= 1) { return current(); }
    let is *u8 as cmd = prog.arg(argv, 1);
    if (streq(cmd, "--help") == 1 || streq(cmd, "-h") == 1) {
        prog.outs("keymap                the keyboard layout in use\n");
        prog.outs("keymap list           the layouts there are (* = in use)\n");
        prog.outs("keymap set <name>     use <name> from now on\n");
        prog.outs("keymap reset          back to the default layout\n");
        prog.outs("keymap show <name>    print a layout's map file\n");
        prog.outs("keymap check <file>   say what is wrong with a map file\n");
        prog.outs("A layout is /etc/keymaps/<name>.map, one key a line:\n");
        prog.outs("  <scancode> <plain> [<shift> [<altgr> [<shift+altgr>]]]\n");
        prog.outs("`keymap show br-abnt2` is one, with dead keys; `keymap show us` is the built-in one.\n");
        return cast(i32, 0);
    }
    if (streq(cmd, "list") == 1 && argc == 2) { return list(); }
    if (streq(cmd, "reset") == 1 && argc == 2) { return reset(); }
    if (argc == 3) {
        let is *u8 as a = prog.arg(argv, 2);
        if (streq(cmd, "set") == 1) { return set(a); }
        if (streq(cmd, "show") == 1) { return show(a); }
        if (streq(cmd, "check") == 1) { return check(a); }
    }
    return usage();
}
