// md5sum — compute / check MD5 (RFC 1321). `md5sum [FILE...]`  ·  `md5sum -c FILE`
//   no FILE (or "-") reads stdin; -c reads "HASH  NAME" lines and verifies them.
// Streaming implementation — no file-size limit.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;

let is [64]i64 as K; let is [4]i64 as state;
let is [64]u8 as g_block; let is i64 as g_bufn with mut = 0; let is i64 as g_total with mut = 0;
let is i64 as MASK = 0xFFFFFFFF;

fn rotl(x as i64, c as i64) as i64 { return ((x << c) | (x >> (32 - c))) & MASK; }
fn s_shift(i as i64) as i64 {
    let is i64 as g = i / 16; let is i64 as k = i - (i / 4) * 4;
    if (g == 0) { if (k == 0) { return 7; } if (k == 1) { return 12; } if (k == 2) { return 17; } return 22; }
    if (g == 1) { if (k == 0) { return 5; } if (k == 1) { return 9; } if (k == 2) { return 14; } return 20; }
    if (g == 2) { if (k == 0) { return 4; } if (k == 1) { return 11; } if (k == 2) { return 16; } return 23; }
    if (k == 0) { return 6; } if (k == 1) { return 10; } if (k == 2) { return 15; } return 21;
}
fn md5_block(msg as *u8, off as i64) as void {
    let is [16]i64 as M; let is i64 as j with mut = 0;
    while (j < 16) { M[j] = cast(i64, msg[off + j * 4]) | (cast(i64, msg[off + j * 4 + 1]) << 8) | (cast(i64, msg[off + j * 4 + 2]) << 16) | (cast(i64, msg[off + j * 4 + 3]) << 24); j = j + 1; }
    let is i64 as a with mut = state[0]; let is i64 as b with mut = state[1]; let is i64 as c with mut = state[2]; let is i64 as d with mut = state[3];
    let is i64 as i with mut = 0;
    while (i < 64) {
        let is i64 as f with mut = 0; let is i64 as g with mut = 0;
        if (i < 16) { f = (b & c) | ((MASK ^ b) & d); g = i; }
        else if (i < 32) { f = (d & b) | ((MASK ^ d) & c); g = (5 * i + 1) - ((5 * i + 1) / 16) * 16; }
        else if (i < 48) { f = b ^ c ^ d; g = (3 * i + 5) - ((3 * i + 5) / 16) * 16; }
        else { f = c ^ (b | (MASK ^ d)); g = (7 * i) - ((7 * i) / 16) * 16; }
        f = (f + a + K[i] + M[g]) & MASK;
        a = d; d = c; c = b;
        b = (b + rotl(f, s_shift(i))) & MASK;
        i = i + 1;
    }
    state[0] = (state[0] + a) & MASK; state[1] = (state[1] + b) & MASK; state[2] = (state[2] + c) & MASK; state[3] = (state[3] + d) & MASK;
}
fn md5_init() as void { state[0] = 0x67452301; state[1] = 0xefcdab89; state[2] = 0x98badcfe; state[3] = 0x10325476; g_bufn = 0; g_total = 0; }
fn md5_update(data as *u8, n as i64) as void {
    g_total = g_total + n; let is i64 as i with mut = 0;
    while (i < n) { g_block[g_bufn] = data[i]; g_bufn = g_bufn + 1; i = i + 1; if (g_bufn == 64) { md5_block(cast(*u8, &g_block[0]), 0); g_bufn = 0; } }
}
fn md5_final(out as *u8) as void {
    let is i64 as bits = g_total * 8;
    g_block[g_bufn] = cast(u8, 0x80); g_bufn = g_bufn + 1;
    if (g_bufn > 56) { while (g_bufn < 64) { g_block[g_bufn] = cast(u8, 0); g_bufn = g_bufn + 1; } md5_block(cast(*u8, &g_block[0]), 0); g_bufn = 0; }
    while (g_bufn < 56) { g_block[g_bufn] = cast(u8, 0); g_bufn = g_bufn + 1; }
    let is i64 as b with mut = 0; while (b < 8) { g_block[56 + b] = cast(u8, (bits >> (b * 8)) & 255); b = b + 1; }
    md5_block(cast(*u8, &g_block[0]), 0);
    let is i64 as w with mut = 0; while (w < 4) { let is i64 as bb with mut = 0; while (bb < 4) { out[w * 4 + bb] = cast(u8, (state[w] >> (bb * 8)) & 255); bb = bb + 1; } w = w + 1; }
}
fn init_K() as void {
    let is [64]i64 as kv;
    kv[0]=0xd76aa478; kv[1]=0xe8c7b756; kv[2]=0x242070db; kv[3]=0xc1bdceee; kv[4]=0xf57c0faf; kv[5]=0x4787c62a; kv[6]=0xa8304613; kv[7]=0xfd469501;
    kv[8]=0x698098d8; kv[9]=0x8b44f7af; kv[10]=0xffff5bb1; kv[11]=0x895cd7be; kv[12]=0x6b901122; kv[13]=0xfd987193; kv[14]=0xa679438e; kv[15]=0x49b40821;
    kv[16]=0xf61e2562; kv[17]=0xc040b340; kv[18]=0x265e5a51; kv[19]=0xe9b6c7aa; kv[20]=0xd62f105d; kv[21]=0x02441453; kv[22]=0xd8a1e681; kv[23]=0xe7d3fbc8;
    kv[24]=0x21e1cde6; kv[25]=0xc33707d6; kv[26]=0xf4d50d87; kv[27]=0x455a14ed; kv[28]=0xa9e3e905; kv[29]=0xfcefa3f8; kv[30]=0x676f02d9; kv[31]=0x8d2a4c8a;
    kv[32]=0xfffa3942; kv[33]=0x8771f681; kv[34]=0x6d9d6122; kv[35]=0xfde5380c; kv[36]=0xa4beea44; kv[37]=0x4bdecfa9; kv[38]=0xf6bb4b60; kv[39]=0xbebfbc70;
    kv[40]=0x289b7ec6; kv[41]=0xeaa127fa; kv[42]=0xd4ef3085; kv[43]=0x04881d05; kv[44]=0xd9d4d039; kv[45]=0xe6db99e5; kv[46]=0x1fa27cf8; kv[47]=0xc4ac5665;
    kv[48]=0xf4292244; kv[49]=0x432aff97; kv[50]=0xab9423a7; kv[51]=0xfc93a039; kv[52]=0x655b59c3; kv[53]=0x8f0ccc92; kv[54]=0xffeff47d; kv[55]=0x85845dd1;
    kv[56]=0x6fa87e4f; kv[57]=0xfe2ce6e0; kv[58]=0xa3014314; kv[59]=0x4e0811a1; kv[60]=0xf7537e82; kv[61]=0xbd3af235; kv[62]=0x2ad7d2bb; kv[63]=0xeb86d391;
    let is i64 as i with mut = 0; while (i < 64) { K[i] = kv[i]; i = i + 1; }
}

// Round `n` up to the next 4096-byte page boundary. The kernel only
// honours page-aligned munmap ranges, so callers must round before
// releasing a mmap_fd mapping.
fn page_round(n as i64) as i64 {
    return (n + 4095) & 0xFFFFF000;
}

// hash_path(path, out): stat → mmap_fd → md5 → munmap. ONE syscall per
// operation instead of N read syscalls for big files. Returns 0 on
// success, errno on stat/open/mmap failure (caller prints the error).
fn hash_path(path as *u8, out as *u8) as i64 {
    let is [4]i64 as st;
    if (sys.stat(path, cast(*u8, &st[0])) != 0) { return 0 - 9; }
    let is i64 as sz = st[0];
    if (sz < 0) { return 0 - 22; }
    if (sz == 0) { md5_init(); md5_final(out); return 0; }
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { return 0 - 9; }
    let is i64 as va = sys.mmap_fd(sys.PROT_READ, fd);
    sys.close(fd);
    if (va <= 0) { return 0 - 5; }
    md5_init();
    md5_update(cast(*u8, va), sz);
    sys.munmap(va, page_round(sz));
    md5_final(out);
    return 0;
}

// hash_fd(fd, out): streaming hash for fds that don't have a backing
// path (stdin = 0, pipes). One 64 KiB read loop — no mmap possible.
fn hash_fd(fd as i64, out as *u8) as void {
    md5_init();
    let is [65536]u8 as buf;
    let is i64 as r with mut = sys.read(fd, cast(*u8, &buf[0]), 65536);
    while (r > 0) { md5_update(cast(*u8, &buf[0]), r); r = sys.read(fd, cast(*u8, &buf[0]), 65536); }
    md5_final(out);
}
fn put_hex(out as *u8) as void { let is *u8 as H = "0123456789abcdef"; let is i64 as i with mut = 0; let is [1]u8 as ch; while (i < 16) { ch[0] = H[(cast(i64, out[i]) >> 4) & 15]; prog.out(cast(*u8, &ch[0]), 1); ch[0] = H[cast(i64, out[i]) & 15]; prog.out(cast(*u8, &ch[0]), 1); i = i + 1; } }
fn streq(a as *u8, b as *u8) as i64 { let is i64 as i with mut = 0; while (a[i] != 0 && b[i] != 0) { if (a[i] != b[i]) { return 0; } i = i + 1; } if (a[i] == b[i]) { return 1; } return 0; }

fn hash_one(name as *u8) as i64 {
    let is [16]u8 as dig;
    if (cast(i64, name) == 0 || streq(name, "-") == 1) {
        hash_fd(cast(i64, 0), cast(*u8, &dig[0]));
    } else {
        let is [256]u8 as pb; let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is i64 as rc = hash_path(path, cast(*u8, &dig[0]));
        if (rc != 0) { prog.outs("md5sum: "); prog.outs(name); prog.outs(": cannot hash\n"); return 1; }
    }
    put_hex(cast(*u8, &dig[0])); prog.outs("  "); if (cast(i64, name) != 0) { prog.outs(name); } else { prog.outs("-"); } prog.out("\n", 1);
    return 0;
}

// -c: parse "HASH  NAME" lines from a checklist file, recompute, report.
fn check(listpath as *u8) as i32 {
    let is [256]u8 as lpb; let is i64 as fd = sys.open_read(prog.abspath(listpath, cast(*u8, &lpb[0])));
    if (fd < 0) { prog.outs("md5sum: "); prog.outs(listpath); prog.outs(": cannot open\n"); return cast(i32, 1); }
    let is [131072]u8 as data; let is i64 as n with mut = 0;
    let is i64 as r with mut = sys.read(fd, cast(*u8, cast(i64, &data[0]) + n), 65536);
    while (r > 0) { n = n + r; if (n + 65536 > 131072) { break; } r = sys.read(fd, cast(*u8, cast(i64, &data[0]) + n), 65536); }
    sys.close(fd);
    let is i32 as rc with mut = 0; let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as ls = i; while (i < n && data[i] != 0x0A) { i = i + 1; }
        let is i64 as le = i; if (i < n) { i = i + 1; }
        if (le - ls < 34) { } else {
            let is [40]u8 as want; let is i64 as k with mut = 0; while (k < 32) { want[k] = data[ls + k]; k = k + 1; } want[32] = cast(u8, 0);
            let is i64 as np with mut = ls + 32; while (np < le && (data[np] == 32 || data[np] == 42)) { np = np + 1; }   // skip "  " or " *"
            let is [256]u8 as nm; let is i64 as m with mut = 0; while (np < le && m < 255) { nm[m] = data[np]; m = m + 1; np = np + 1; } nm[m] = cast(u8, 0);
            let is [256]u8 as cpb; let is *u8 as cpath = prog.abspath(cast(*u8, &nm[0]), cast(*u8, &cpb[0]));
            prog.outs(cast(*u8, &nm[0])); prog.outs(": ");
            let is [16]u8 as dig;
            if (hash_path(cpath, cast(*u8, &dig[0])) != 0) { prog.outs("FAILED open\n"); rc = cast(i32, 1); }
            else {
                let is *u8 as H = "0123456789abcdef"; let is [33]u8 as got; let is i64 as g with mut = 0;
                while (g < 16) { got[g * 2] = H[(cast(i64, dig[g]) >> 4) & 15]; got[g * 2 + 1] = H[(cast(i64, dig[g]) & 15)]; g = g + 1; } got[32] = cast(u8, 0);
                if (streq(cast(*u8, &got[0]), cast(*u8, &want[0])) == 1) { prog.outs("OK\n"); } else { prog.outs("FAILED\n"); rc = cast(i32, 1); }
            }
        }
    }
    return rc;
}

fn main(argc as i64, argv as *u8) as i32 {
    init_K();
    let is i64 as i with mut = 1; let is i64 as nfiles with mut = 0; let is i32 as rc with mut = 0;
    while (i < argc) {
        let is *u8 as a = prog.arg(argv, i);
        if (streq(a, "-c") == 1 || streq(a, "--check") == 1) { i = i + 1; if (i < argc) { return check(prog.arg(argv, i)); } prog.outs("md5sum: -c needs a file\n"); return cast(i32, 1); }
        else if (a[0] == 45 && a[1] != 0 && streq(a, "-") == 0) { prog.outs("usage: md5sum [FILE...] | md5sum -c LIST\n"); return cast(i32, 1); }
        else { if (hash_one(a) != 0) { rc = cast(i32, 1); } nfiles = nfiles + 1; }
        i = i + 1;
    }
    if (nfiles == 0) { if (hash_one(cast(*u8, 0)) != 0) { rc = cast(i32, 1); } }
    return rc;
}
