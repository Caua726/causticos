// date — print the date and time from the RTC. `date [-u] [+FORMAT]`
//   default: "Www Mmm DD HH:MM:SS UTC YYYY"
//   +FORMAT specifiers: %Y %y %m %d %H %I %M %S %p %j %a %A %b %B %F %T %R %D %s %n %t %%
// (The QEMU RTC is UTC; -u is accepted and is the default behaviour.)
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;

fn pad2(v as i64) as void { if (v < 10) { prog.outs("0"); } prog.out_num(v); }
fn pad2sp(v as i64) as void { if (v < 10) { prog.outs(" "); } prog.out_num(v); }
fn is_leap(y as i64) as i64 { if ((y - (y / 4) * 4) == 0 && (y - (y / 100) * 100) != 0) { return 1; } if ((y - (y / 400) * 400) == 0) { return 1; } return 0; }
// Sakamoto: day of week, 0=Sunday.
fn dow(y as i64, m as i64, d as i64) as i64 {
    let is [12]i64 as t; t[0] = 0; t[1] = 3; t[2] = 2; t[3] = 5; t[4] = 0; t[5] = 3; t[6] = 5; t[7] = 1; t[8] = 4; t[9] = 6; t[10] = 2; t[11] = 4;
    let is i64 as yy with mut = y; if (m < 3) { yy = yy - 1; }
    let is i64 as w = yy + yy / 4 - yy / 100 + yy / 400 + t[m - 1] + d;
    return w - (w / 7) * 7;
}
fn yday(y as i64, m as i64, d as i64) as i64 {
    let is [12]i64 as dim; dim[0] = 31; dim[1] = 28; dim[2] = 31; dim[3] = 30; dim[4] = 31; dim[5] = 30; dim[6] = 31; dim[7] = 31; dim[8] = 30; dim[9] = 31; dim[10] = 30; dim[11] = 31;
    let is i64 as n with mut = d; let is i64 as i with mut = 0;
    while (i < m - 1) { n = n + dim[i]; i = i + 1; }
    if (m > 2 && is_leap(y) == 1) { n = n + 1; }
    return n;
}
fn unix_ts(y as i64, mo as i64, d as i64, h as i64, mi as i64, s as i64) as i64 {
    let is i64 as days with mut = 0; let is i64 as yy with mut = 1970;
    while (yy < y) { if (is_leap(yy) == 1) { days = days + 366; } else { days = days + 365; } yy = yy + 1; }
    days = days + yday(y, mo, d) - 1;
    return days * 86400 + h * 3600 + mi * 60 + s;
}
fn wname_abbr(w as i64) as void { if (w == 0) { prog.outs("Sun"); } else if (w == 1) { prog.outs("Mon"); } else if (w == 2) { prog.outs("Tue"); } else if (w == 3) { prog.outs("Wed"); } else if (w == 4) { prog.outs("Thu"); } else if (w == 5) { prog.outs("Fri"); } else { prog.outs("Sat"); } }
fn wname_full(w as i64) as void { if (w == 0) { prog.outs("Sunday"); } else if (w == 1) { prog.outs("Monday"); } else if (w == 2) { prog.outs("Tuesday"); } else if (w == 3) { prog.outs("Wednesday"); } else if (w == 4) { prog.outs("Thursday"); } else if (w == 5) { prog.outs("Friday"); } else { prog.outs("Saturday"); } }
fn mname_abbr(m as i64) as void { if (m == 1) { prog.outs("Jan"); } else if (m == 2) { prog.outs("Feb"); } else if (m == 3) { prog.outs("Mar"); } else if (m == 4) { prog.outs("Apr"); } else if (m == 5) { prog.outs("May"); } else if (m == 6) { prog.outs("Jun"); } else if (m == 7) { prog.outs("Jul"); } else if (m == 8) { prog.outs("Aug"); } else if (m == 9) { prog.outs("Sep"); } else if (m == 10) { prog.outs("Oct"); } else if (m == 11) { prog.outs("Nov"); } else { prog.outs("Dec"); } }
fn mname_full(m as i64) as void { if (m == 1) { prog.outs("January"); } else if (m == 2) { prog.outs("February"); } else if (m == 3) { prog.outs("March"); } else if (m == 4) { prog.outs("April"); } else if (m == 5) { prog.outs("May"); } else if (m == 6) { prog.outs("June"); } else if (m == 7) { prog.outs("July"); } else if (m == 8) { prog.outs("August"); } else if (m == 9) { prog.outs("September"); } else if (m == 10) { prog.outs("October"); } else if (m == 11) { prog.outs("November"); } else { prog.outs("December"); } }

let is i64 as Y with mut = 0; let is i64 as Mo with mut = 0; let is i64 as D with mut = 0;
let is i64 as H with mut = 0; let is i64 as Mi with mut = 0; let is i64 as S with mut = 0; let is i64 as W with mut = 0;

fn emit_spec(c as i64) as void {
    if (c == 89) { prog.out_num(Y); }                                  // %Y
    else if (c == 121) { pad2(Y - (Y / 100) * 100); }                  // %y
    else if (c == 109) { pad2(Mo); }                                   // %m
    else if (c == 100) { pad2(D); }                                    // %d
    else if (c == 72) { pad2(H); }                                     // %H
    else if (c == 73) { let is i64 as h12 with mut = H - (H / 12) * 12; if (h12 == 0) { h12 = 12; } pad2(h12); }   // %I
    else if (c == 77) { pad2(Mi); }                                    // %M
    else if (c == 83) { pad2(S); }                                     // %S
    else if (c == 112) { if (H < 12) { prog.outs("AM"); } else { prog.outs("PM"); } }   // %p
    else if (c == 106) { let is i64 as j = yday(Y, Mo, D); if (j < 100) { prog.outs("0"); } if (j < 10) { prog.outs("0"); } prog.out_num(j); }   // %j
    else if (c == 97) { wname_abbr(W); }                               // %a
    else if (c == 65) { wname_full(W); }                              // %A
    else if (c == 98) { mname_abbr(Mo); }                              // %b
    else if (c == 66) { mname_full(Mo); }                             // %B
    else if (c == 70) { prog.out_num(Y); prog.outs("-"); pad2(Mo); prog.outs("-"); pad2(D); }   // %F
    else if (c == 84) { pad2(H); prog.outs(":"); pad2(Mi); prog.outs(":"); pad2(S); }            // %T
    else if (c == 82) { pad2(H); prog.outs(":"); pad2(Mi); }                                     // %R
    else if (c == 68) { pad2(Mo); prog.outs("/"); pad2(D); prog.outs("/"); pad2(Y - (Y / 100) * 100); }   // %D
    else if (c == 115) { prog.out_num(unix_ts(Y, Mo, D, H, Mi, S)); }  // %s
    else if (c == 110) { prog.out("\n", 1); }                          // %n
    else if (c == 116) { prog.out("\t", 1); }                          // %t
    else if (c == 37) { prog.outs("%"); }                              // %%
    else { prog.outs("%"); let is [2]u8 as b; b[0] = cast(u8, c); b[1] = cast(u8, 0); prog.outs(cast(*u8, &b[0])); }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is [6]i64 as t;                          // raw RTC fields from the kernel
    if (sys.time_wall(cast(*i64, &t[0])) != 0) { prog.outs("date: RTC unavailable\n"); return cast(i32, 1); }
    Y = t[0]; Mo = t[1]; D = t[2]; H = t[3]; Mi = t[4]; S = t[5];
    W = dow(Y, Mo, D);                            // weekday is the app's job, not the kernel's
    let is *u8 as fmt with mut; fmt = cast(*u8, 0);
    let is i64 as i with mut = 1;
    while (i < argc) {
        let is *u8 as a = prog.arg(argv, i);
        if (a[0] == 43) { fmt = cast(*u8, cast(i64, a) + 1); }          // +FORMAT
        else if (a[0] == 45 && a[1] == 117) { }                        // -u (no-op: RTC is UTC)
        else { prog.outs("usage: date [-u] [+FORMAT]\n"); return cast(i32, 1); }
        i = i + 1;
    }
    if (cast(i64, fmt) == 0) {
        wname_abbr(W); prog.outs(" "); mname_abbr(Mo); prog.outs(" "); pad2sp(D); prog.outs(" ");
        pad2(H); prog.outs(":"); pad2(Mi); prog.outs(":"); pad2(S); prog.outs(" UTC "); prog.out_num(Y); prog.out("\n", 1);
    } else {
        let is i64 as k with mut = 0;
        while (fmt[k] != 0) { if (fmt[k] == 37 && fmt[k + 1] != 0) { k = k + 1; emit_spec(cast(i64, fmt[k])); } else { let is [2]u8 as b; b[0] = fmt[k]; b[1] = cast(u8, 0); prog.outs(cast(*u8, &b[0])); } k = k + 1; }
        prog.out("\n", 1);
    }
    return cast(i32, 0);
}
