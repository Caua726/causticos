// date — print the date and time. `date [-u] [+FORMAT]`
//   default: "Www Mmm DD HH:MM:SS ZONE YYYY", in the zone `timezone` chose
//   -u: in UTC, whatever the zone
//   +FORMAT specifiers: %Y %y %m %d %H %I %M %S %p %j %a %A %b %B %F %T %R %D
//                       %s %z %Z %n %t %%
// The RTC is UTC; which zone the wall clock is in is lib/tz's to say.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/tz/tz.cst" as tz;

fn pad2(v as i64) as void { if (v < 10) { prog.outs("0"); } prog.out_num(v); }
fn pad2sp(v as i64) as void { if (v < 10) { prog.outs(" "); } prog.out_num(v); }
fn wname_abbr(w as i64) as void { if (w == 0) { prog.outs("Sun"); } else if (w == 1) { prog.outs("Mon"); } else if (w == 2) { prog.outs("Tue"); } else if (w == 3) { prog.outs("Wed"); } else if (w == 4) { prog.outs("Thu"); } else if (w == 5) { prog.outs("Fri"); } else { prog.outs("Sat"); } }
fn wname_full(w as i64) as void { if (w == 0) { prog.outs("Sunday"); } else if (w == 1) { prog.outs("Monday"); } else if (w == 2) { prog.outs("Tuesday"); } else if (w == 3) { prog.outs("Wednesday"); } else if (w == 4) { prog.outs("Thursday"); } else if (w == 5) { prog.outs("Friday"); } else { prog.outs("Saturday"); } }
fn mname_abbr(m as i64) as void { if (m == 1) { prog.outs("Jan"); } else if (m == 2) { prog.outs("Feb"); } else if (m == 3) { prog.outs("Mar"); } else if (m == 4) { prog.outs("Apr"); } else if (m == 5) { prog.outs("May"); } else if (m == 6) { prog.outs("Jun"); } else if (m == 7) { prog.outs("Jul"); } else if (m == 8) { prog.outs("Aug"); } else if (m == 9) { prog.outs("Sep"); } else if (m == 10) { prog.outs("Oct"); } else if (m == 11) { prog.outs("Nov"); } else { prog.outs("Dec"); } }
fn mname_full(m as i64) as void { if (m == 1) { prog.outs("January"); } else if (m == 2) { prog.outs("February"); } else if (m == 3) { prog.outs("March"); } else if (m == 4) { prog.outs("April"); } else if (m == 5) { prog.outs("May"); } else if (m == 6) { prog.outs("June"); } else if (m == 7) { prog.outs("July"); } else if (m == 8) { prog.outs("August"); } else if (m == 9) { prog.outs("September"); } else if (m == 10) { prog.outs("October"); } else if (m == 11) { prog.outs("November"); } else { prog.outs("December"); } }

let is tz.Zone as zone with mut;
let is tz.Local as L with mut;
let is i64 as EPOCH with mut = 0;

fn emit_spec(c as i64) as void {
    if (c == 89) { prog.out_num(L.year); }                             // %Y
    else if (c == 121) { pad2(L.year % 100); }                         // %y
    else if (c == 109) { pad2(L.month); }                              // %m
    else if (c == 100) { pad2(L.day); }                                // %d
    else if (c == 72) { pad2(L.hour); }                                // %H
    else if (c == 73) { let is i64 as h12 with mut = L.hour % 12; if (h12 == 0) { h12 = 12; } pad2(h12); }   // %I
    else if (c == 77) { pad2(L.min); }                                 // %M
    else if (c == 83) { pad2(L.sec); }                                 // %S
    else if (c == 112) { if (L.hour < 12) { prog.outs("AM"); } else { prog.outs("PM"); } }   // %p
    else if (c == 106) { if (L.yday < 100) { prog.outs("0"); } if (L.yday < 10) { prog.outs("0"); } prog.out_num(L.yday); }   // %j
    else if (c == 97) { wname_abbr(L.wday); }                          // %a
    else if (c == 65) { wname_full(L.wday); }                          // %A
    else if (c == 98) { mname_abbr(L.month); }                         // %b
    else if (c == 66) { mname_full(L.month); }                         // %B
    else if (c == 70) { prog.out_num(L.year); prog.outs("-"); pad2(L.month); prog.outs("-"); pad2(L.day); }   // %F
    else if (c == 84) { pad2(L.hour); prog.outs(":"); pad2(L.min); prog.outs(":"); pad2(L.sec); }            // %T
    else if (c == 82) { pad2(L.hour); prog.outs(":"); pad2(L.min); }                                         // %R
    else if (c == 68) { pad2(L.month); prog.outs("/"); pad2(L.day); prog.outs("/"); pad2(L.year % 100); }    // %D
    else if (c == 115) { prog.out_num(EPOCH); }                        // %s — the instant, not the wall clock
    else if (c == 122) { let is [12]u8 as b; prog.out(cast(*u8, &b[0]), tz.fmt_offset(L.utoff, 0, cast(*u8, &b[0]))); }   // %z
    else if (c == 90) { prog.out(cast(*u8, &L.abbr[0]), L.abbr_len); }   // %Z
    else if (c == 110) { prog.out("\n", 1); }                          // %n
    else if (c == 116) { prog.out("\t", 1); }                          // %t
    else if (c == 37) { prog.outs("%"); }                              // %%
    else { prog.outs("%"); let is [2]u8 as b; b[0] = cast(u8, c); b[1] = cast(u8, 0); prog.outs(cast(*u8, &b[0])); }
}

fn main(argc as i64, argv as *u8) as i32 {
    tz.init(&zone);
    let is *u8 as fmt with mut; fmt = cast(*u8, 0);
    let is i64 as utc with mut = 0;
    let is i64 as i with mut = 1;
    while (i < argc) {
        let is *u8 as a = prog.arg(argv, i);
        if (a[0] == 43) { fmt = cast(*u8, cast(i64, a) + 1); }          // +FORMAT
        else if (a[0] == 45 && a[1] == 117 && a[2] == 0) { utc = 1; }   // -u
        else { prog.errs("usage: date [-u] [+FORMAT]\n"); return cast(i32, 1); }
        i = i + 1;
    }
    EPOCH = tz.now_epoch();
    if (EPOCH < 0) { prog.errs("date: RTC unavailable\n"); return cast(i32, 1); }
    // A zone that does not load is said, and the time is told in UTC rather
    // than not at all.
    if (utc == 0 && tz.load_chosen(&zone) != 0) {
        prog.errs("date: the chosen time zone does not load, showing UTC: ");
        prog.err(tz.why_ptr(), tz.why_len());
        prog.errs("\n");
    }
    tz.at(&zone, EPOCH, &L);
    if (cast(i64, fmt) == 0) {
        wname_abbr(L.wday); prog.outs(" "); mname_abbr(L.month); prog.outs(" "); pad2sp(L.day); prog.outs(" ");
        pad2(L.hour); prog.outs(":"); pad2(L.min); prog.outs(":"); pad2(L.sec); prog.outs(" ");
        prog.out(cast(*u8, &L.abbr[0]), L.abbr_len); prog.outs(" "); prog.out_num(L.year); prog.out("\n", 1);
    } else {
        let is i64 as k with mut = 0;
        while (fmt[k] != 0) { if (fmt[k] == 37 && fmt[k + 1] != 0) { k = k + 1; emit_spec(cast(i64, fmt[k])); } else { let is [2]u8 as b; b[0] = fmt[k]; b[1] = cast(u8, 0); prog.outs(cast(*u8, &b[0])); } k = k + 1; }
        prog.out("\n", 1);
    }
    return cast(i32, 0);
}
