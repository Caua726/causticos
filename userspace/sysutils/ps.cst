// ps — list processes. ps [-l]. Reads SYS_PROC_LIST (lib/proclist: every
// process, however many): pid, ppid, state — run while a thread is on a cpu
// or ready for one, sleep while all of them wait — threads, resident memory,
// name = argv[0]. Sorted by pid. -l adds the exit code.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;
use "../lib/proclist/proclist.cst" as pl;

fn padstr(s as *u8, w as i64) as void {
    prog.outs(s);
    let is i64 as k with mut = prog.slen(s);
    while (k < w) { prog.outs(" "); k = k + 1; }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as lflag with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "l");
        if (f < 0) { break; }
        if (f == 108) { lflag = 1; } else { prog.outs("usage: ps [-l]\n"); return cast(i32, 1); }
    }
    let is pl.Snap as sn;
    sn.va = 0; sn.cap = 0; sn.n = 0;
    let is i64 as rc = pl.take(&sn);
    if (rc < 0) {
        prog.outs("ps: cannot read the process list: "); prog.outs(sys.err_text(rc)); prog.outs("\n");
        return cast(i32, 1);
    }
    let is i64 as n = sn.n;
    // the records in pid order, through an index (insertion sort)
    let is *i64 as ord = cast(*i64, sys.mmap(0, (n + 1) * 8, sys.PROT_READ | sys.PROT_WRITE));
    if (cast(i64, ord) < 0) { prog.outs("ps: out of memory\n"); return cast(i32, 1); }
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as pid = pl.rec(&sn, i)[pl.F_PID];
        let is i64 as j with mut = i - 1;
        while (j >= 0 && pl.rec(&sn, ord[j])[pl.F_PID] > pid) { ord[j + 1] = ord[j]; j = j - 1; }
        ord[j + 1] = i;
        i = i + 1;
    }

    prog.outs("  PID  PPID  STATE    NAME             THR        MEM");
    if (lflag == 1) { prog.outs("    EXIT"); }
    prog.out("\n", 1);
    i = 0;
    while (i < n) {
        let is *i64 as r = pl.rec(&sn, ord[i]);
        prog.pad_num(r[pl.F_PID], 5); prog.outs("  ");
        prog.pad_num(r[pl.F_PPID], 4); prog.outs("  ");
        padstr(pl.state_name(r), 9);
        padstr(pl.name(&sn, ord[i]), 16);
        prog.outs(" ");
        prog.pad_num(r[pl.F_THREADS], 3); prog.outs("  ");
        prog.pad_num(r[pl.F_RSS], 9);
        if (lflag == 1) { prog.outs("  "); prog.pad_num(r[pl.F_EXIT], 6); }
        prog.out("\n", 1);
        i = i + 1;
    }
    return 0;
}
