// ps — list processes. ps [-l]. Reads SYS_PROC_LIST (pid, ppid, state,
// exit_code, threads, committed_bytes, name=argv[0]). Sorted by pid. -l adds
// the exit code. (No owner/CPU%: the kernel doesn't track them yet.)
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;

fn statename(s as i64) as *u8 {
    if (s == 1) { return "run"; }
    if (s == 2) { return "exiting"; }
    if (s == 3) { return "zombie"; }
    if (s == 4) { return "dead"; }
    return "?";
}

fn padstr(s as *u8, w as i64) as void {
    prog.outs(s);
    let is i64 as k with mut = prog.slen(s);
    while (k < w) { prog.outs(" "); k = k + 1; }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as lflag with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "l");
        if (f < 0) { break; }
        if (f == 108) { lflag = 1; } else { prog.outs("usage: ps [-l]\n"); return cast(i32, 1); }
    }
    let is [512]i64 as ents;                         // PROC_LIST_MAX(64) * 8
    let is i64 as total = sys.proc_list(cast(*i64, &ents[0]), 64);
    if (total < 0) { prog.outs("ps: SYS_PROC_LIST failed\n"); return cast(i32, 1); }
    let is i64 as n with mut = total;
    if (n > 64) { n = 64; }

    // insertion-sort the 8-word records by pid.
    let is i64 as i with mut = 1;
    while (i < n) {
        let is [8]i64 as tmp;
        let is i64 as w with mut = 0; while (w < 8) { tmp[w] = ents[i * 8 + w]; w = w + 1; }
        let is i64 as j with mut = i - 1;
        while (j >= 0 && ents[j * 8] > tmp[0]) {
            w = 0; while (w < 8) { ents[(j + 1) * 8 + w] = ents[j * 8 + w]; w = w + 1; }
            j = j - 1;
        }
        w = 0; while (w < 8) { ents[(j + 1) * 8 + w] = tmp[w]; w = w + 1; }
        i = i + 1;
    }

    prog.outs("  PID  PPID  STATE    NAME             THR        MEM");
    if (lflag == 1) { prog.outs("    EXIT"); }
    prog.out("\n", 1);
    i = 0;
    while (i < n) {
        let is i64 as b = i * 8;
        prog.pad_num(ents[b + 0], 5); prog.outs("  ");
        prog.pad_num(ents[b + 1], 4); prog.outs("  ");
        padstr(statename(ents[b + 2]), 9);
        padstr(cast(*u8, cast(i64, &ents[0]) + (b + 6) * 8), 16);     // name (16 bytes @ words 6-7)
        prog.outs(" ");
        prog.pad_num(ents[b + 4], 3); prog.outs("  ");
        prog.pad_num(ents[b + 5], 9);
        if (lflag == 1) { prog.outs("  "); prog.pad_num(ents[b + 3], 6); }
        prog.out("\n", 1);
        i = i + 1;
    }
    if (total > 64) { prog.outs("(+ "); prog.out_num(total - 64); prog.outs(" more)\n"); }
    return 0;
}
