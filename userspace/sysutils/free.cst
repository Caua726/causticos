// free — show memory usage. free [-b] [-k] [-m] [-h].
// -b bytes, -k KiB (default), -m MiB, -h human-readable. Reads SYS_MEM_INFO.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;
use "../lib/futil/futil.cst" as fu;

let is i64 as g_unit with mut = 0;   // 0 KiB, 1 B, 2 MiB, 3 human

fn emit(v as i64) as void {
    if (g_unit == 1) { prog.pad_num(v, 13); }
    else if (g_unit == 2) { prog.pad_num(v / 1048576, 13); }
    else if (g_unit == 3) {
        if (v >= 1048576) { prog.pad_num(v / 1048576, 11); prog.outs("M"); }
        else if (v >= 1024) { prog.pad_num(v / 1024, 11); prog.outs("K"); }
        else { prog.pad_num(v, 11); prog.outs("B"); }
    } else { prog.pad_num(v / 1024, 13); }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "bkmh");
        if (f < 0) { break; }
        if (f == 98) { g_unit = 1; } else if (f == 107) { g_unit = 0; } else if (f == 109) { g_unit = 2; } else if (f == 104) { g_unit = 3; }
        else { prog.outs("usage: free [-bkmh]\n"); return cast(i32, 1); }
    }
    let is [4]i64 as mi;
    if (sys.mem_info(cast(*i64, &mi[0])) != 0) { prog.outs("free: SYS_MEM_INFO failed\n"); return cast(i32, 1); }
    let is i64 as pagesz = mi[2];
    let is i64 as total_b = mi[0] * pagesz;
    let is i64 as free_b = mi[1] * pagesz;
    let is i64 as used_b = total_b - free_b;
    prog.outs("              total         used         free\n");
    prog.outs("Mem:   "); emit(total_b); emit(used_b); emit(free_b); prog.out("\n", 1);
    prog.outs("committed: "); emit(mi[3]); prog.outs("   (anon RAM across processes)\n");
    return 0;
}
