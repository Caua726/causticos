// htop — a process viewer in the classic htop spirit, as a terminal TUI. It
// writes text + ANSI to stdout and reads keys from stdin: the TERMINAL renders
// it (wterm in the WM, or the shell), never the framebuffer. Distinct from btop:
// a process TREE (parent/child), sort modes, a name filter, numbered per-core
// CPU meters, and an htop-style shortcut bar.
//   up/down select   t tree   s sort   / filter   k kill   q quit
use "../../../Caustic/std/os/causticos.cst" as sys;

let is i64 as C_FG = 0x00cdd6f4; let is i64 as C_DIM = 0x006c7086;
let is i64 as C_BARBG = 0x00313244; let is i64 as C_GREEN = 0x00a6e3a1; let is i64 as C_RED = 0x00f38ba8;
let is i64 as C_BLUE = 0x0089b4fa; let is i64 as C_MAUVE = 0x00cba6f7; let is i64 as C_TEAL = 0x0094e2d5;
let is i64 as C_SEL = 0x0045475a; let is i64 as C_KEY = 0x0089b4fa; let is i64 as C_KEYBG = 0x00313244;

let is i64 as g_cols with mut = 80; let is i64 as g_rows with mut = 24;
let is i64 as HSIZE = 24;
let is [400]i64 as cpu_hist; let is i64 as cpu_hpos with mut = 0; let is i64 as cpu_filled with mut = 0; let is i64 as ncpu with mut = 1;
let is [576]i64 as g_ents; let is i64 as g_nproc with mut = 0; let is i64 as g_sel with mut = 0; let is i64 as g_scroll with mut = 0;
let is i64 as g_quit with mut = 0; let is i64 as totalb with mut = 1;
let is [64]i64 as g_order; let is [64]i64 as g_depth; let is i64 as g_ordn with mut = 0;   // visible rows -> g_ents index
let is i64 as g_tree with mut = 0; let is i64 as g_sortm with mut = 0;     // 0 pid, 1 mem, 2 name
let is i64 as g_filtering with mut = 0; let is [64]u8 as g_filter; let is i64 as g_flen with mut = 0;
let is i64 as in_esc with mut = 0; let is [8]i64 as in_p; let is i64 as in_np with mut = 0;

// ---- output buffer + ANSI ----
let is [32768]u8 as obuf; let is i64 as olen with mut = 0;
fn flush_ob() as void {
    let is i64 as off with mut = 0;
    while (off < olen) {
        let is i64 as w = syscall(11, 1, cast(i64, &obuf[0]) + off, olen - off);
        if (w > 0) { off = off + w; }
        else { let is [3]i64 as pe; pe[0] = 1; pe[1] = sys.POLL_WRITABLE; pe[2] = 0; sys.poll(cast(*i64, &pe[0]), 1, 2000000000); if ((pe[2] & sys.POLL_WRITABLE) == 0) { olen = 0; return; } }
    }
    olen = 0;
}
fn ob(c as i64) as void { if (olen >= 32700) { flush_ob(); } obuf[olen] = cast(u8, c); olen = olen + 1; }
fn obs(s as *u8) as void { let is i64 as i with mut = 0; while (s[i] != 0) { ob(cast(i64, s[i])); i = i + 1; } }
fn obn(v as i64) as void { let is i64 as x with mut = v; if (x < 0) { ob(45); x = 0 - x; } if (x == 0) { ob(48); return; } let is [24]u8 as b; let is i64 as n with mut = 0; while (x > 0) { b[n] = cast(u8, 48 + x - (x / 10) * 10); x = x / 10; n = n + 1; } while (n > 0) { n = n - 1; ob(cast(i64, b[n])); } }
fn obbytes(v as i64) as void {
    let is i64 as scale with mut = 1; let is i64 as suf with mut = 66;
    if (v >= 1073741824) { scale = 1073741824; suf = 71; } else if (v >= 1048576) { scale = 1048576; suf = 77; } else if (v >= 1024) { scale = 1024; suf = 75; }
    let is i64 as whole = v / scale; obn(whole);
    if (scale > 1 && whole < 100) { ob(46); obn((v - whole * scale) * 10 / scale); }
    ob(suf);
}
fn esc() as void { ob(0x1B); ob(0x5B); }
fn cup(row as i64, col as i64) as void { esc(); obn(row); ob(59); obn(col); ob(72); }
fn eol() as void { esc(); ob(75); }
fn fgc(v as i64) as void { esc(); obs("38;2;"); obn((v >> 16) & 0xFF); ob(59); obn((v >> 8) & 0xFF); ob(59); obn(v & 0xFF); ob(109); }
fn bgc(v as i64) as void { esc(); obs("48;2;"); obn((v >> 16) & 0xFF); ob(59); obn((v >> 8) & 0xFF); ob(59); obn(v & 0xFF); ob(109); }
fn sgr0() as void { esc(); ob(48); ob(109); }
fn hidec() as void { esc(); ob(63); obn(25); ob(108); }
fn showc() as void { esc(); ob(63); obn(25); ob(104); }
fn clr() as void { esc(); ob(50); ob(74); }
fn grad(pct as i64) as i64 {
    let is i64 as p with mut = pct; if (p < 0) { p = 0; } if (p > 100) { p = 100; }
    let is i64 as r with mut = 0; let is i64 as g with mut = 0; let is i64 as b with mut = 0;
    if (p < 50) { r = 0xa6 + (0xf9 - 0xa6) * p / 50; g = 0xe3 + (0xe2 - 0xe3) * p / 50; b = 0xa1 + (0xaf - 0xa1) * p / 50; }
    else { let is i64 as t = p - 50; r = 0xf9 + (0xf3 - 0xf9) * t / 50; g = 0xe2 + (0x8b - 0xe2) * t / 50; b = 0xaf + (0xa8 - 0xaf) * t / 50; }
    return (r << 16) | (g << 8) | b;
}
// htop-style bracketed bar: [|||||      NN.N%]
fn meter(width as i64, pct as i64) as void {
    let is i64 as p with mut = pct; if (p < 0) { p = 0; } if (p > 100) { p = 100; }
    let is i64 as fw = width * p / 100; let is i64 as last with mut = 0 - 1;
    fgc(C_DIM); ob(91);                                     // '['
    let is i64 as i with mut = 0;
    while (i < width) {
        if (i < fw) { let is i64 as q = (i * 100 / width) / 8 * 8; if (q != last) { fgc(grad(q)); last = q; } ob(124); }   // '|'
        else { if (last != 1000) { fgc(C_BARBG); last = 1000; } ob(32); }
        i = i + 1;
    }
    fgc(C_DIM); ob(93); sgr0();                             // ']'
}
fn pad_num(v as i64, w as i64) as void { let is i64 as nd with mut = 1; let is i64 as x with mut = v; while (x >= 10) { x = x / 10; nd = nd + 1; } let is i64 as k with mut = nd; while (k < w) { ob(32); k = k + 1; } obn(v); }

// ---- data ----
// Utilisation is a RATIO OVER AN INTERVAL, so it takes two samples: the
// kernel hands out each cpu's cumulative busy nanoseconds plus the clock, and
// the percentage is the busy delta over the elapsed delta. Sampling an
// instantaneous "is this cpu running something" instead always read yes — the
// sampler is itself what was running — and every core showed 100%.
let is [16]i64 as cpu_prev with mut;
let is i64 as cpu_prev_t with mut = 0;
let is [16]i64 as cpu_now_pct with mut;

fn sample_cpu() as void {
    let is [18]i64 as cs;
    if (sys.cpu_stat(cast(*i64, &cs[0])) <= 0) { return; }
    ncpu = cs[0]; if (ncpu > 16) { ncpu = 16; }
    let is i64 as tnow = cs[ncpu + 1];
    let is i64 as dt = tnow - cpu_prev_t;
    let is i64 as k with mut = 0;
    while (k < ncpu) {
        let is i64 as db = cs[1 + k] - cpu_prev[k];
        let is i64 as pct with mut = 0;
        if (cpu_prev_t > 0 && dt > 0) { pct = db * 100 / dt; }
        if (pct < 0) { pct = 0; }
        if (pct > 100) { pct = 100; }
        cpu_now_pct[k] = pct;
        cpu_prev[k] = cs[1 + k];
        k = k + 1;
    }
    cpu_prev_t = tnow;
    let is i64 as c with mut = 0;
    while (c < ncpu) { cpu_hist[c * HSIZE + cpu_hpos] = cpu_now_pct[c]; c = c + 1; }
    cpu_hpos = (cpu_hpos + 1) % HSIZE; if (cpu_filled < HSIZE) { cpu_filled = cpu_filled + 1; }
}
// Averaged over the history window so a single long slice does not make the
// bar jump; the samples are already percentages.
fn cpu_pct(core as i64) as i64 {
    if (cpu_filled == 0) { return 0; }
    let is i64 as sum with mut = 0; let is i64 as i with mut = 0;
    while (i < cpu_filled) { sum = sum + cpu_hist[core * HSIZE + i]; i = i + 1; }
    return sum / cpu_filled;
}
fn state_ch(s as i64) as i64 { if (s == 1) { return 82; } if (s == 3) { return 90; } if (s == 2) { return 69; } return 63; }   // R Z E ?
fn state_col(s as i64) as i64 { if (s == 1) { return C_GREEN; } if (s == 3) { return C_RED; } return C_DIM; }
fn nameptr(idx as i64) as *u8 { return cast(*u8, cast(i64, &g_ents[0]) + (idx * 9 + 6) * 8); }
fn name_has_filter(idx as i64) as i64 {
    if (g_flen == 0) { return 1; }
    let is *u8 as nm = nameptr(idx);
    let is i64 as i with mut = 0;
    while (i < 16) {
        let is i64 as j with mut = 0;
        while (j < g_flen && nm[i + j] != 0 && nm[i + j] == g_filter[j]) { j = j + 1; }
        if (j == g_flen) { return 1; }
        i = i + 1;
    }
    return 0;
}

// build g_order[]/g_depth[] from g_ents, honoring tree / sort / filter.
fn add_children(ppid as i64, depth as i64) as void {
    if (depth > 24) { return; }
    let is i64 as i with mut = 0;
    while (i < g_nproc) {
        if (g_ents[i * 9 + 1] == ppid && name_has_filter(i) == 1 && g_ordn < 64) {
            g_order[g_ordn] = i; g_depth[g_ordn] = depth; g_ordn = g_ordn + 1;
            add_children(g_ents[i * 9], depth + 1);
        }
        i = i + 1;
    }
}
fn build_order() as void {
    g_ordn = 0;
    if (g_tree == 1) {
        let is i64 as i with mut = 0;
        while (i < g_nproc) {
            let is i64 as pp = g_ents[i * 9 + 1]; let is i64 as has with mut = 0; let is i64 as j with mut = 0;
            while (j < g_nproc) { if (g_ents[j * 9] == pp) { has = 1; } j = j + 1; }
            if (has == 0 && name_has_filter(i) == 1 && g_ordn < 64) { g_order[g_ordn] = i; g_depth[g_ordn] = 0; g_ordn = g_ordn + 1; add_children(g_ents[i * 9], 1); }
            i = i + 1;
        }
        return;
    }
    // flat: filtered indices, then selection-sort by mode
    let is i64 as i with mut = 0;
    while (i < g_nproc) { if (name_has_filter(i) == 1 && g_ordn < 64) { g_order[g_ordn] = i; g_depth[g_ordn] = 0; g_ordn = g_ordn + 1; } i = i + 1; }
    let is i64 as a with mut = 0;
    while (a < g_ordn) {
        let is i64 as best with mut = a; let is i64 as b with mut = a + 1;
        while (b < g_ordn) {
            let is i64 as ib = g_order[b]; let is i64 as ibest = g_order[best]; let is i64 as win with mut = 0;
            if (g_sortm == 1) { if (g_ents[ib * 9 + 5] > g_ents[ibest * 9 + 5]) { win = 1; } }       // mem desc
            else { if (g_ents[ib * 9] < g_ents[ibest * 9]) { win = 1; } }                            // pid asc (default)
            if (win == 1) { best = b; }
            b = b + 1;
        }
        let is i64 as tmp = g_order[a]; g_order[a] = g_order[best]; g_order[best] = tmp;
        a = a + 1;
    }
}

// ---- render ----
fn render() as void {
    let is i64 as bw with mut = g_cols - 26; if (bw < 8) { bw = 8; } if (bw > 70) { bw = 70; }
    let is i64 as row with mut = 1;
    // per-core CPU meters (numbered, htop-style)
    let is i64 as c with mut = 0;
    while (c < ncpu) {
        let is i64 as pct = cpu_pct(c);
        cup(row, 1); fgc(C_BLUE); pad_num(c, 3); sgr0(); ob(32); meter(bw, pct); ob(32); fgc(C_FG); pad_num(pct, 3); ob(37); sgr0();
        if (c == 0) { fgc(C_DIM); obs("   Tasks: "); sgr0(); fgc(C_TEAL); obn(g_nproc); sgr0(); }
        if (c == 1) { fgc(C_DIM); obs("   Up: "); sgr0(); fgc(C_TEAL); obn(sys.time_ns() / 60000000000); obs("m"); sgr0(); }
        eol(); row = row + 1; c = c + 1;
    }
    // Mem / Cmt
    let is [4]i64 as mi;
    if (sys.mem_info(cast(*i64, &mi[0])) == 0) {
        let is i64 as totb = mi[0] * mi[2]; totalb = totb; let is i64 as usedb = totb - mi[1] * mi[2];
        let is i64 as mp with mut = 0; if (totb > 0) { mp = usedb * 100 / totb; }
        cup(row, 1); fgc(C_TEAL); obs("Mem"); sgr0(); ob(32); meter(bw, mp); ob(32); fgc(C_FG); obbytes(usedb); fgc(C_DIM); ob(47); obbytes(totb); sgr0(); eol(); row = row + 1;
        let is i64 as cp with mut = 0; if (totb > 0) { cp = mi[3] * 100 / totb; }
        cup(row, 1); fgc(C_TEAL); obs("Cmt"); sgr0(); ob(32); meter(bw, cp); ob(32); fgc(C_FG); obbytes(mi[3]); sgr0(); eol(); row = row + 1;
    }
    row = row + 1;
    // table header
    cup(row, 1); bgc(C_KEYBG); fgc(C_DIM); obs("  PID PPID S THR     MEM MEM% COMMAND"); eol(); sgr0(); row = row + 1;
    build_order();
    if (g_sel >= g_ordn) { g_sel = g_ordn - 1; } if (g_sel < 0) { g_sel = 0; }
    let is i64 as avail = g_rows - row;
    if (g_sel < g_scroll) { g_scroll = g_sel; }
    if (g_sel >= g_scroll + avail) { g_scroll = g_sel - avail + 1; }
    if (g_scroll < 0) { g_scroll = 0; }
    let is i64 as o with mut = g_scroll; let is i64 as shown with mut = 0;
    while (o < g_ordn && shown < avail) {
        let is i64 as e = g_order[o] * 9;
        cup(row, 1);
        if (o == g_sel) { bgc(C_SEL); }
        fgc(C_FG); pad_num(g_ents[e], 5); ob(32); fgc(C_DIM); pad_num(g_ents[e + 1], 4); ob(32);
        fgc(state_col(g_ents[e + 2])); ob(state_ch(g_ents[e + 2])); ob(32);
        fgc(C_DIM); pad_num(g_ents[e + 4], 3); ob(32); fgc(C_FG);
        let is i64 as mem = g_ents[e + 5]; let is i64 as mpct with mut = 0; if (totalb > 0) { mpct = mem / 1024 * 100 / (totalb / 1024); }
        let is i64 as mb with mut = 0; let is [8]u8 as msb;     // right-pad MEM to 7
        // print bytes into a small scratch via obbytes after spaces — simpler: pad ahead
        ob(32); obbytes(mem); ob(32); fgc(C_DIM); pad_num(mpct, 3); ob(37); ob(32);
        // COMMAND, tree-indented
        fgc(C_FG);
        if (g_tree == 1) { let is i64 as d with mut = 1; while (d < g_depth[o]) { ob(32); ob(32); d = d + 1; } if (g_depth[o] > 0) { fgc(C_DIM); ob(0xC0); ob(0xC4); ob(32); fgc(C_FG); } }
        let is *u8 as nm = nameptr(g_order[o]); let is i64 as k with mut = 0;
        while (k < 16 && nm[k] != 0) { ob(cast(i64, nm[k])); k = k + 1; }
        eol(); sgr0(); row = row + 1; o = o + 1; shown = shown + 1;
    }
    while (shown < avail) { cup(row, 1); eol(); row = row + 1; shown = shown + 1; }
    // shortcut bar (htop-style)
    cup(g_rows, 1);
    if (g_filtering == 1) { fgc(C_FG); obs("Filter: "); let is i64 as i with mut = 0; while (i < g_flen) { ob(cast(i64, g_filter[i])); i = i + 1; } eol(); sgr0(); return; }
    fkey("up/dn", "select"); fkey("t", "tree"); fkey("s", "sort"); fkey("/", "filter"); fkey("k", "kill"); fkey("q", "quit");
    eol(); sgr0();
}
fn fkey(k as *u8, label as *u8) as void { fgc(C_KEY); obs(k); bgc(C_KEYBG); fgc(C_FG); obs(label); sgr0(); ob(32); }

// ---- input ----
fn do_kill() as void { if (g_sel >= 0 && g_sel < g_ordn) { sys.kill(g_ents[g_order[g_sel] * 9]); } }
fn feed(c as i64) as void {
    if (g_filtering == 1) {
        if (c == 0x0A || c == 0x0D) { g_filtering = 0; return; }
        if (c == 0x1B) { g_filtering = 0; g_flen = 0; return; }
        if (c == 0x08 || c == 0x7F) { if (g_flen > 0) { g_flen = g_flen - 1; } return; }
        if (c >= 32 && c < 127 && g_flen < 63) { g_filter[g_flen] = cast(u8, c); g_flen = g_flen + 1; }
        return;
    }
    if (in_esc == 0) {
        if (c == 0x1B) { in_esc = 1; return; }
        if (c == 113) { g_quit = 1; }                          // q
        else if (c == 116) { g_tree = 1 - g_tree; }            // t
        else if (c == 115) { g_sortm = (g_sortm + 1) % 2; }    // s (pid <-> mem)
        else if (c == 47) { g_filtering = 1; g_flen = 0; }     // /
        else if (c == 107) { do_kill(); }                      // k
        return;
    }
    if (in_esc == 1) { if (c == 0x5B) { in_esc = 2; in_np = 0; in_p[0] = 0; return; } in_esc = 0; return; }
    if (c >= 0x30 && c <= 0x39) { in_p[in_np] = in_p[in_np] * 10 + (c - 0x30); return; }
    if (c == 0x3B) { if (in_np < 7) { in_np = in_np + 1; in_p[in_np] = 0; } return; }
    if (c == 65) { if (g_sel > 0) { g_sel = g_sel - 1; } }
    else if (c == 66) { if (g_sel < g_ordn - 1) { g_sel = g_sel + 1; } }
    else if (c == 116) { if (in_p[0] == 8) { g_rows = in_p[1]; g_cols = in_p[2]; } }
    in_esc = 0;
}
fn drain_input(timeout as i64) as void {
    let is [3]i64 as pe; pe[0] = 0; pe[1] = sys.POLL_READABLE; pe[2] = 0;
    sys.poll(cast(*i64, &pe[0]), 1, timeout);
    while ((pe[2] & sys.POLL_READABLE) != 0) {
        let is [128]u8 as buf;
        let is i64 as r = syscall(10, 0, cast(i64, &buf[0]), 128);
        if (r <= 0) { return; }
        let is i64 as i with mut = 0; while (i < r) { feed(cast(i64, buf[i])); i = i + 1; }
        pe[0] = 0; pe[1] = sys.POLL_READABLE; pe[2] = 0; sys.poll(cast(*i64, &pe[0]), 1, 0);
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    hidec(); clr(); flush_ob();
    esc(); obn(18); ob(116); flush_ob();
    drain_input(300000000);
    while (g_quit == 0) {
        sample_cpu();
        g_nproc = sys.proc_list(cast(*i64, &g_ents[0]), 64); if (g_nproc > 64) { g_nproc = 64; }
        render();
        flush_ob();
        drain_input(1000000000);
    }
    sgr0(); showc(); clr(); cup(g_rows, 1); ob(0x0A); flush_ob();
    return cast(i32, 0);
}
