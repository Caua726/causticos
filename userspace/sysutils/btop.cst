// btop — a live system monitor written as a real TUI. It writes text + ANSI
// escape codes to its stdout and reads keys from its stdin; the TERMINAL
// (wterm in the WM, or the shell) renders it inside its own window. btop never
// touches the framebuffer and is not a WM client — exactly like htop in a
// terminal. Learns its size in-band via CSI 18t -> CSI 8;rows;cols t.
//   up/down (or arrows) select a process, k ends it (after y), q quits.
use "std/os/causticos.cst" as sys;
use "../lib/ttyproto/ttyproto.cst" as tty;
use "../lib/proclist/proclist.cst" as pl;

// palette (0xRRGGBB), emitted as ANSI truecolor.
let is i64 as C_FG = 0x00cdd6f4; let is i64 as C_DIM = 0x006c7086;
let is i64 as C_BARBG = 0x00313244; let is i64 as C_GREEN = 0x00a6e3a1; let is i64 as C_RED = 0x00f38ba8;
let is i64 as C_BLUE = 0x0089b4fa; let is i64 as C_MAUVE = 0x00cba6f7; let is i64 as C_TEAL = 0x0094e2d5;
let is i64 as C_SEL = 0x0045475a; let is i64 as C_YELLOW = 0x00f9e2af;

let is i64 as g_cols with mut = 80; let is i64 as g_rows with mut = 24;   // until CSI 8t arrives
let is i64 as HSIZE = 24;
let is [400]i64 as cpu_hist; let is i64 as cpu_hpos with mut = 0; let is i64 as cpu_filled with mut = 0; let is i64 as ncpu with mut = 1;
// The last snapshot of every process (lib/proclist): g_nproc records of pl.W
// words at g_ents, sorted by pid.
let is pl.Snap as g_snap;
let is *i64 as g_ents with mut = cast(*i64, 0); let is i64 as g_nproc with mut = 0; let is i64 as g_sel with mut = 0; let is i64 as g_scroll with mut = 0;
let is i64 as g_quit with mut = 0; let is i64 as totalb with mut = 1;
let is i64 as in_esc with mut = 0; let is [8]i64 as in_p; let is i64 as in_np with mut = 0;

// One frame is built in obuf and written at once (auto-flushes if it fills).
let is [32768]u8 as obuf; let is i64 as olen with mut = 0;
// Write the whole buffer, handling partial writes: the stdout channel is small
// (~1KB) and a frame is larger, so a single write() only takes what fits. We
// MUST loop — a short write that cuts an escape sequence in half wedges the
// terminal's parser and the next frame leaks as text. Wait for room when full.
fn flush_ob() as void {
    let is i64 as off with mut = 0;
    while (off < olen) {
        let is i64 as w = syscall(11, 1, cast(i64, &obuf[0]) + off, olen - off);
        if (w > 0) { off = off + w; }
        else {
            let is [3]i64 as pe; pe[0] = 1; pe[1] = sys.POLL_WRITABLE; pe[2] = 0;
            sys.poll(cast(*i64, &pe[0]), 1, 2000000000);
            if ((pe[2] & sys.POLL_WRITABLE) == 0) { olen = 0; return; }   // peer gone
        }
    }
    olen = 0;
}
fn ob(c as i64) as void { if (olen >= 32700) { flush_ob(); } obuf[olen] = cast(u8, c); olen = olen + 1; }
fn obs(s as *u8) as void { let is i64 as i with mut = 0; while (s[i] != 0) { ob(cast(i64, s[i])); i = i + 1; } }
fn obn(v as i64) as void {
    let is i64 as x with mut = v;
    if (x < 0) { ob(45); x = 0 - x; }
    if (x == 0) { ob(48); return; }
    let is [24]u8 as b; let is i64 as n with mut = 0;
    while (x > 0) { b[n] = cast(u8, 48 + x - (x / 10) * 10); x = x / 10; n = n + 1; }
    while (n > 0) { n = n - 1; ob(cast(i64, b[n])); }
}
fn obbytes(v as i64, width as i64) as void {
    let is i64 as scale with mut = 1; let is i64 as suf with mut = 66;        // 'B'
    if (v >= 1073741824) { scale = 1073741824; suf = 71; }
    else if (v >= 1048576) { scale = 1048576; suf = 77; }
    else if (v >= 1024) { scale = 1024; suf = 75; }
    let is i64 as whole = v / scale;
    let is i64 as fraction with mut = 0;
    if (scale > 1 && whole < 100) { fraction = 1; }
    let is [24]u8 as digits;
    let is i64 as x with mut = whole;
    let is i64 as negative with mut = 0;
    if (x < 0) { negative = 1; x = 0 - x; }
    let is i64 as n with mut = 0;
    if (x == 0) { digits[0] = cast(u8, 48); n = 1; }
    while (x > 0) {
        let is i64 as next = x / 10;
        digits[n] = cast(u8, 48 + x - next * 10);
        x = next; n = n + 1;
    }
    let is i64 as length with mut = n + 1 + fraction * 2 + negative;
    while (length < width) { ob(32); length = length + 1; }
    if (negative == 1) { ob(45); }
    while (n > 0) { n = n - 1; ob(cast(i64, digits[n])); }
    if (fraction == 1) { ob(46); ob(48 + (v - whole * scale) * 10 / scale); }
    ob(suf);
}

// ANSI emitters.
fn esc() as void { ob(0x1B); ob(0x5B); }
fn cup(row as i64, col as i64) as void { esc(); obn(row); ob(59); obn(col); ob(72); }   // CSI r;c H
fn eol() as void { esc(); ob(75); }                                                     // CSI K
fn fgc(v as i64) as void { esc(); obs("38;2;"); obn((v >> 16) & 0xFF); ob(59); obn((v >> 8) & 0xFF); ob(59); obn(v & 0xFF); ob(109); }
fn bgc(v as i64) as void { esc(); obs("48;2;"); obn((v >> 16) & 0xFF); ob(59); obn((v >> 8) & 0xFF); ob(59); obn(v & 0xFF); ob(109); }
fn sgr0() as void { esc(); ob(48); ob(109); }
fn hidec() as void { esc(); ob(63); obn(25); ob(108); }
fn showc() as void { esc(); ob(63); obn(25); ob(104); }
fn clr() as void { esc(); ob(50); ob(74); }
// The terminal's alternate screen: this program draws on a screen of its own,
// and the one with the prompt and the commands before it comes back on exit
// (it used to be cleared).
fn alt_on() as void { esc(); ob(63); obn(1049); ob(104); }
fn alt_off() as void { esc(); ob(63); obn(1049); ob(108); }

// thermal gradient: 0 green -> 50 yellow -> 100 red.
fn grad(pct as i64) as i64 {
    let is i64 as p with mut = pct; if (p < 0) { p = 0; } if (p > 100) { p = 100; }
    let is i64 as r with mut = 0; let is i64 as g with mut = 0; let is i64 as b with mut = 0;
    if (p < 50) { r = 0xa6 + (0xf9 - 0xa6) * p / 50; g = 0xe3 + (0xe2 - 0xe3) * p / 50; b = 0xa1 + (0xaf - 0xa1) * p / 50; }
    else { let is i64 as t = p - 50; r = 0xf9 + (0xf3 - 0xf9) * t / 50; g = 0xe2 + (0x8b - 0xe2) * t / 50; b = 0xaf + (0xa8 - 0xaf) * t / 50; }
    return (r << 16) | (g << 8) | b;
}
// A horizontal bar of `width` cells filled to pct, gradient along its length:
// U+2588 FULL BLOCK for the filled part, U+2591 LIGHT SHADE for the rest. The
// terminal reads UTF-8; the CP437 bytes these used to be (0xDB, 0xB0) are not
// characters there, and every cell of every bar drew as the replacement mark.
fn bar(width as i64, pct as i64) as void {
    let is i64 as p with mut = pct; if (p < 0) { p = 0; } if (p > 100) { p = 100; }
    let is i64 as fw = width * p / 100;
    let is i64 as last with mut = 0 - 1;            // last colour emitted (quantized)
    let is i64 as i with mut = 0;
    while (i < width) {
        if (i < fw) {
            let is i64 as q = (i * 100 / width) / 8 * 8;   // quantize to 8% steps
            if (q != last) { fgc(grad(q)); last = q; }
            ob(0xE2); ob(0x96); ob(0x88);
        } else {
            if (last != 1000) { fgc(C_BARBG); last = 1000; }
            ob(0xE2); ob(0x96); ob(0x91);
        }
        i = i + 1;
    }
    sgr0();
}
fn pad_num(v as i64, w as i64) as void {
    let is i64 as nd with mut = 1; let is i64 as x with mut = v; while (x >= 10) { x = x / 10; nd = nd + 1; }
    let is i64 as k with mut = nd; while (k < w) { ob(32); k = k + 1; }
    obn(v);
}
fn pad_str(s as *u8, w as i64) as void {
    let is i64 as i with mut = 0;
    while (s[i] != 0 && i < w) { ob(cast(i64, s[i])); i = i + 1; }
    while (i < w) { ob(32); i = i + 1; }
}
fn pad_name(s as *u8, w as i64) as void {
    let is i64 as i with mut = 0; let is i64 as done with mut = 0;
    while (i < w) {
        if (done == 0 && i < 16 && s[i] != 0) { ob(cast(i64, s[i])); } else { done = 1; ob(32); }
        i = i + 1;
    }
}

// ---- data (read-only kernel views) ----
// Utilisation is a RATIO OVER AN INTERVAL, so it takes two samples: the
// kernel hands out each cpu's cumulative busy nanoseconds plus the clock, and
// the percentage is the busy delta over the elapsed delta. Sampling an
// instantaneous "is this cpu running something" instead always read yes — the
// sampler is itself what was running — and every core showed 100%.
let is [16]i64 as cpu_prev with mut;
let is i64 as cpu_prev_t with mut = 0;
let is [16]i64 as cpu_now_pct with mut;

fn sample_cpu() as void {
    let is [18]i64 as cs;
    if (sys.cpu_stat(cast(*i64, &cs[0])) <= 0) { return; }
    ncpu = cs[0]; if (ncpu > 16) { ncpu = 16; }
    let is i64 as tnow = cs[ncpu + 1];
    let is i64 as dt = tnow - cpu_prev_t;
    let is i64 as k with mut = 0;
    while (k < ncpu) {
        let is i64 as db = cs[1 + k] - cpu_prev[k];
        let is i64 as pct with mut = 0;
        if (cpu_prev_t > 0 && dt > 0) { pct = db * 100 / dt; }
        if (pct < 0) { pct = 0; }
        if (pct > 100) { pct = 100; }
        cpu_now_pct[k] = pct;
        cpu_prev[k] = cs[1 + k];
        k = k + 1;
    }
    cpu_prev_t = tnow;
    let is i64 as c with mut = 0;
    while (c < ncpu) { cpu_hist[c * HSIZE + cpu_hpos] = cpu_now_pct[c]; c = c + 1; }
    cpu_hpos = (cpu_hpos + 1) % HSIZE; if (cpu_filled < HSIZE) { cpu_filled = cpu_filled + 1; }
}
// Averaged over the history window so a single long slice does not make the
// bar jump; the samples are already percentages.
fn cpu_pct(core as i64) as i64 {
    if (cpu_filled == 0) { return 0; }
    let is i64 as sum with mut = 0; let is i64 as i with mut = 0;
    while (i < cpu_filled) { sum = sum + cpu_hist[core * HSIZE + i]; i = i + 1; }
    return sum / cpu_filled;
}

// Per-process CPU. The kernel hands out cumulative nanoseconds; the percentage
// is the delta over the elapsed clock, keyed by pid so a table that reorders
// between samples still compares like with like. This is the column that makes
// "why is the machine busy" a question with an answer on screen.
// The last sample — pcpu_n (pid, cpu ns) pairs in pid order — and this one's
// percentage per row, in arrays that grow with the process count.
let is *i64 as pcpu_pid with mut = cast(*i64, 0);
let is *i64 as pcpu_ns with mut = cast(*i64, 0);
let is *i64 as pcpu_pct with mut = cast(*i64, 0);
let is i64 as pcpu_cap with mut = 0;
let is i64 as pcpu_n with mut = 0;
let is i64 as pcpu_last_t with mut = 0;

fn proc_pct(idx as i64) as i64 { return pcpu_pct[idx]; }

// Room for n rows; what the last sample holds is kept. 0, or -1.
fn pcpu_room(n as i64) as i64 {
    if (n <= pcpu_cap) { return 0; }
    let is i64 as nc = n + n / 4 + 8;
    let is i64 as va = sys.mmap(0, nc * 24, sys.PROT_READ | sys.PROT_WRITE);
    if (va < 0) { return 0 - 1; }
    let is *i64 as np = cast(*i64, va);
    let is *i64 as nn = cast(*i64, va + nc * 8);
    let is i64 as i with mut = 0;
    while (i < pcpu_n) { np[i] = pcpu_pid[i]; nn[i] = pcpu_ns[i]; i = i + 1; }
    if (pcpu_cap > 0) { sys.munmap(cast(i64, pcpu_pid), pcpu_cap * 24); }
    pcpu_pid = np; pcpu_ns = nn; pcpu_pct = cast(*i64, va + nc * 16); pcpu_cap = nc;
    return 0;
}

// Both the snapshot and the last sample are in pid order, so one walk pairs
// them up.
fn sample_proc_cpu(now as i64) as void {
    let is i64 as dt = now - pcpu_last_t;
    let is i64 as k with mut = 0;
    let is i64 as i with mut = 0;
    while (i < g_nproc) {
        let is *i64 as r = pl.rec(&g_snap, i);
        let is i64 as pid = r[pl.F_PID];
        let is i64 as cur = r[pl.F_CPU];
        while (k < pcpu_n && pcpu_pid[k] < pid) { k = k + 1; }
        let is i64 as pct with mut = 0;
        if (k < pcpu_n && pcpu_pid[k] == pid && pcpu_last_t > 0 && dt > 0) {
            pct = (cur - pcpu_ns[k]) * 100 / dt;
            if (pct < 0) { pct = 0; }
            if (pct > 100) { pct = 100; }
        }
        pcpu_pct[i] = pct;
        i = i + 1;
    }
    // this sample is the next one's last
    i = 0;
    while (i < g_nproc) {
        pcpu_pid[i] = pl.rec(&g_snap, i)[pl.F_PID];
        pcpu_ns[i] = pl.rec(&g_snap, i)[pl.F_CPU];
        i = i + 1;
    }
    pcpu_n = g_nproc;
    pcpu_last_t = now;
}

fn state_col(r as *i64) as i64 {
    let is i64 as l = pl.state_letter(r);
    if (l == 82) { return C_GREEN; }                         // R
    if (l == 90) { return C_RED; }                           // Z
    return C_DIM;
}
// The snapshot's records in pid order (insertion sort, moving whole records).
fn sort_procs() as void {
    let is i64 as W = pl.W;
    let is [10]i64 as tmp;
    let is i64 as i with mut = 1;
    while (i < g_nproc) {
        let is i64 as w with mut = 0; while (w < W) { tmp[w] = g_ents[i * W + w]; w = w + 1; }
        let is i64 as j with mut = i - 1;
        while (j >= 0 && g_ents[j * W] > tmp[0]) { w = 0; while (w < W) { g_ents[(j + 1) * W + w] = g_ents[j * W + w]; w = w + 1; } j = j - 1; }
        w = 0; while (w < W) { g_ents[(j + 1) * W + w] = tmp[w]; w = w + 1; }
        i = i + 1;
    }
}

// ---- stdin: keys + the CSI 8t size report, parsed as a byte stream ----
// ---- k: ending a process ----
// k asks, y ends. The pid and its name are taken when k is pressed: the list
// is resampled under the selection every second. The kill is asked of the
// terminal (ttyproto), which ends it for the user — a program can only end
// what it started itself, and btop started nothing.
let is i64 as g_kpid with mut = 0;
let is [16]u8 as g_kname;
let is [112]u8 as g_msg; let is i64 as g_msglen with mut = 0; let is i64 as g_msguntil with mut = 0;
fn msg_begin() as void { g_msglen = 0; g_msguntil = sys.time_ns() + 4000000000; }
fn msg_add(s as *u8) as void { let is i64 as i with mut = 0; while (s[i] != 0 && g_msglen < 111) { g_msg[g_msglen] = s[i]; g_msglen = g_msglen + 1; i = i + 1; } }
fn msg_name() as void { let is i64 as i with mut = 0; while (i < 16 && g_kname[i] != cast(u8, 0) && g_msglen < 111) { g_msg[g_msglen] = g_kname[i]; g_msglen = g_msglen + 1; i = i + 1; } }
fn msg_num(v as i64) as void {
    let is [20]u8 as d; let is i64 as n with mut = 0; let is i64 as x with mut = v;
    if (x <= 0) { x = 0; }
    while (n < 20) { d[n] = cast(u8, 48 + x % 10); n = n + 1; x = x / 10; if (x == 0) { break; } }
    while (n > 0 && g_msglen < 111) { n = n - 1; g_msg[g_msglen] = d[n]; g_msglen = g_msglen + 1; }
}
fn ask_kill(idx as i64) as void {
    let is i64 as pid = g_ents[idx * pl.W];
    if (pid == sys.getpid()) { msg_begin(); msg_add("this is btop itself: q quits"); return; }
    let is *u8 as nm = pl.name(&g_snap, idx);
    let is i64 as i with mut = 0;
    while (i < 16) { g_kname[i] = nm[i]; i = i + 1; }
    g_kpid = pid;
}
fn do_kill() as void {
    let is i64 as pid = g_kpid;
    g_kpid = 0;
    let is i64 as rc with mut = tty.kill(pid);
    if (rc == 0 - 4) { rc = sys.kill(pid); }        // not on a terminal: what btop started, only
    msg_begin();
    if (rc == 0) { msg_add("ended "); msg_num(pid); msg_add(" ("); msg_name(); msg_add(") and what it started"); }
    else if (rc == sys.E_AGAIN) { msg_num(pid); msg_add(": the terminal did not answer"); }
    else { msg_num(pid); msg_add(" ("); msg_name(); msg_add("): gone already, or a system service out of reach"); }
}
// The bottom line while a kill waits for y, or a result is fresh: 1 when drawn.
fn kill_line() as i64 {
    if (g_kpid != 0) {
        fgc(C_RED); obs("End "); obn(g_kpid); obs(" (");
        let is i64 as i with mut = 0; while (i < 16 && g_kname[i] != cast(u8, 0)) { ob(cast(i64, g_kname[i])); i = i + 1; }
        obs(") and what it started? y/n"); eol(); sgr0();
        return 1;
    }
    if (g_msglen > 0 && sys.time_ns() < g_msguntil) {
        fgc(C_FG); let is i64 as k with mut = 0; while (k < g_msglen) { ob(cast(i64, g_msg[k])); k = k + 1; } eol(); sgr0();
        return 1;
    }
    return 0;
}
fn feed(c as i64) as void {
    if (in_esc == 0) {
        if (g_kpid != 0) {                       // y ends it; anything else does not
            if (c == 121 || c == 89) { do_kill(); } else { g_kpid = 0; }
            if (c == 0x1B) { in_esc = 1; }
            return;
        }
        if (c == 0x1B) { in_esc = 1; return; }
        if (c == 113) { g_quit = 1; }            // 'q'
        else if (c == 107 && g_sel >= 0 && g_sel < g_nproc) { ask_kill(g_sel); }   // 'k'
        return;
    }
    if (in_esc == 1) {
        if (c == 0x5B) { in_esc = 2; in_np = 0; in_p[0] = 0; return; }
        in_esc = 0; return;
    }
    if (c >= 0x30 && c <= 0x39) { in_p[in_np] = in_p[in_np] * 10 + (c - 0x30); return; }
    if (c == 0x3B) { if (in_np < 7) { in_np = in_np + 1; in_p[in_np] = 0; } return; }
    if (c == 65) { if (g_sel > 0) { g_sel = g_sel - 1; } }                       // CSI A up
    else if (c == 66) { if (g_sel < g_nproc - 1) { g_sel = g_sel + 1; } }        // CSI B down
    else if (c == 116) { if (in_p[0] == 8) { g_rows = in_p[1]; g_cols = in_p[2]; } }  // CSI 8;r;c t
    in_esc = 0;
}
fn drain_input(timeout as i64) as void {
    let is [3]i64 as pe;
    pe[0] = 0; pe[1] = sys.POLL_READABLE; pe[2] = 0;
    sys.poll(cast(*i64, &pe[0]), 1, timeout);
    while ((pe[2] & sys.POLL_READABLE) != 0) {
        let is [128]u8 as buf;
        let is i64 as r = syscall(10, 0, cast(i64, &buf[0]), 128);
        if (r <= 0) { return; }
        let is i64 as i with mut = 0;
        while (i < r) { feed(cast(i64, buf[i])); i = i + 1; }
        pe[0] = 0; pe[1] = sys.POLL_READABLE; pe[2] = 0;
        sys.poll(cast(*i64, &pe[0]), 1, 0);
    }
}

// ---- render: home, then repaint each line (CSI K trims any leftover) ----
fn render() as void {
    let is i64 as bw with mut = g_cols - 20; if (bw < 8) { bw = 8; } if (bw > 90) { bw = 90; }
    let is i64 as row with mut = 1;
    let is [4]i64 as stf;
    let is i64 as have_fs = sys.statfs(cast(*i64, &stf[0]));
    // header
    cup(row, 1); fgc(C_MAUVE); obs("btop"); sgr0();
    fgc(C_DIM); obs("   up "); sgr0(); fgc(C_FG); obn(sys.time_ns() / 60000000000); fgc(C_DIM); obs("m  "); sgr0();
    fgc(C_TEAL); obn(ncpu); fgc(C_DIM); obs(" cpu  "); sgr0(); fgc(C_TEAL); obn(g_nproc); fgc(C_DIM); obs(" proc"); sgr0();
    if (have_fs == 0 && (stf[3] & sys.STATFS_VOLATILE) != 0) { fgc(C_YELLOW); obs("   live root: lost at power off"); sgr0(); }
    eol();
    row = row + 2;
    // CPU total + per-core meters
    let is i64 as totp with mut = 0; let is i64 as cc with mut = 0;
    while (cc < ncpu) { totp = totp + cpu_pct(cc); cc = cc + 1; } if (ncpu > 0) { totp = totp / ncpu; }
    cup(row, 1); fgc(C_DIM); obs("CPU "); sgr0(); bar(bw, totp); ob(32); fgc(grad(totp)); pad_num(totp, 3); ob(37); sgr0(); eol(); row = row + 1;
    let is i64 as c with mut = 0;
    while (c < ncpu) {
        let is i64 as pct = cpu_pct(c);
        cup(row, 1); fgc(C_BLUE); ob(67); obn(c); sgr0(); ob(32);
        bar(bw, pct); ob(32); fgc(C_FG); pad_num(pct, 3); ob(37); sgr0(); eol(); row = row + 1; c = c + 1;
    }
    row = row + 1;
    // memory / committed / disk
    let is [4]i64 as mi;
    if (sys.mem_info(cast(*i64, &mi[0])) == 0) {
        let is i64 as totb = mi[0] * mi[2]; totalb = totb; let is i64 as usedb = totb - mi[1] * mi[2];
        let is i64 as mp with mut = 0; if (totb > 0) { mp = usedb * 100 / totb; }
        cup(row, 1); fgc(C_TEAL); obs("Mem "); sgr0(); bar(bw, mp); ob(32); fgc(C_FG); obbytes(usedb, 0); fgc(C_DIM); ob(47); obbytes(totb, 0); sgr0(); eol(); row = row + 1;
        let is i64 as cp with mut = 0; if (totb > 0) { cp = mi[3] * 100 / totb; }
        cup(row, 1); fgc(C_TEAL); obs("Cmt "); sgr0(); bar(bw, cp); ob(32); fgc(C_FG); obbytes(mi[3], 0); sgr0(); eol(); row = row + 1;
    }
    if (have_fs == 0) {
        let is i64 as du = stf[0] - stf[1]; let is i64 as dp with mut = 0; if (stf[0] > 0) { dp = du * 100 / stf[0]; }
        cup(row, 1); fgc(C_TEAL); obs("Dsk "); sgr0(); bar(bw, dp); ob(32); fgc(C_FG); obbytes(du, 0); fgc(C_DIM); ob(47); obbytes(stf[0], 0); sgr0(); eol(); row = row + 1;
    }
    row = row + 1;
    // process table
    cup(row, 1); fgc(C_DIM); obs("  PID PPID STATE   PROGRAM        THR      MEM  CPU%"); sgr0(); eol(); row = row + 1;
    let is i64 as avail = g_rows - row;
    if (g_sel < g_scroll) { g_scroll = g_sel; }
    if (g_sel >= g_scroll + avail) { g_scroll = g_sel - avail + 1; }
    if (g_scroll < 0) { g_scroll = 0; }
    let is i64 as i with mut = g_scroll; let is i64 as shown with mut = 0;
    while (i < g_nproc && shown < avail) {
        let is i64 as b = i * pl.W;
        cup(row, 1);
        if (i == g_sel) { bgc(C_SEL); }
        fgc(C_FG); pad_num(g_ents[b], 5); ob(32); fgc(C_DIM); pad_num(g_ents[b + 1], 4); ob(32);
        fgc(state_col(pl.rec(&g_snap, i))); pad_str(pl.state_name(pl.rec(&g_snap, i)), 7); ob(32);
        fgc(C_FG); pad_name(pl.name(&g_snap, i), 14); ob(32);
        fgc(C_DIM); pad_num(g_ents[b + 4], 3); ob(32); ob(32); fgc(C_FG); obbytes(g_ents[b + 5], 7);
        ob(32); ob(32);
        let is i64 as pc = proc_pct(i);
        if (pc >= 10) { fgc(C_RED); } else if (pc > 0) { fgc(C_FG); } else { fgc(C_DIM); }
        pad_num(pc, 3); obs("%");
        eol(); sgr0(); row = row + 1; i = i + 1; shown = shown + 1;
    }
    while (shown < avail) { cup(row, 1); eol(); row = row + 1; shown = shown + 1; }
    // footer
    cup(g_rows, 1);
    if (kill_line() == 1) { return; }
    fgc(C_MAUVE); ob(113); sgr0(); fgc(C_DIM); obs(" quit  "); sgr0();
    fgc(C_MAUVE); obs("up/dn"); sgr0(); fgc(C_DIM); obs(" select  "); sgr0();
    fgc(C_MAUVE); ob(107); sgr0(); fgc(C_DIM); obs(" kill"); sgr0(); eol();
}

fn main(argc as i64, argv as *u8) as i32 {
    alt_on(); hidec(); clr(); flush_ob();
    esc(); obn(18); ob(116); flush_ob();          // CSI 18t — ask the terminal its size
    drain_input(300000000);                        // 300ms: collect the CSI 8t reply
    while (g_quit == 0) {
        sample_cpu();
        if (pl.take(&g_snap) == 0 && pcpu_room(g_snap.n) == 0) {
            g_ents = cast(*i64, g_snap.va); g_nproc = g_snap.n;
            sort_procs();
            sample_proc_cpu(sys.time_ns());
        }
        if (g_sel >= g_nproc) { g_sel = g_nproc - 1; } if (g_sel < 0) { g_sel = 0; }
        render();
        flush_ob();
        drain_input(1000000000);                   // ~1s frame, woken early by a keypress
    }
    sgr0(); showc(); alt_off(); flush_ob();
    return cast(i32, 0);
}
