// base64 — encode or decode base64. `base64 [-d] [-w COLS] [FILE]`
//   default: encode FILE (or stdin), wrapping lines at -w COLS (default 76, 0=off)
//   -d:      decode FILE (or stdin), ignoring whitespace
// Streaming: reads in 64K chunks, no whole-file buffer.
use "../../../Caustic/std/causticos/prog.cst" as prog;
use "../../../Caustic/std/os/causticos.cst" as sys;

fn b64c(i as i64) as i64 { if (i < 26) { return 65 + i; } if (i < 52) { return 97 + i - 26; } if (i < 62) { return 48 + i - 52; } if (i == 62) { return 43; } return 47; }
let is [256]u8 as g_obuf; let is i64 as g_olen with mut = 0;
let is i64 as g_col with mut = 0; let is i64 as g_wrap with mut = 76;
let is [3]u8 as g_c3; let is i64 as g_c3n with mut = 0;          // encode carry
let is i64 as g_acc with mut = 0; let is i64 as g_bits with mut = 0; let is i64 as g_eq with mut = 0;  // decode state

fn streq(a as *u8, b as *u8) as i64 { let is i64 as i with mut = 0; while (a[i] != 0 && b[i] != 0) { if (a[i] != b[i]) { return 0; } i = i + 1; } if (a[i] == b[i]) { return 1; } return 0; }
fn atoi(s as *u8) as i64 { let is i64 as v with mut = 0; let is i64 as i with mut = 0; while (s[i] >= 48 && s[i] <= 57) { v = v * 10 + (cast(i64, s[i]) - 48); i = i + 1; } return v; }
fn oflush() as void { if (g_olen > 0) { sys.write(cast(i64, 1), cast(*u8, &g_obuf[0]), g_olen); g_olen = 0; } }
fn oput(c as i64) as void { if (g_olen >= 256) { oflush(); } g_obuf[g_olen] = cast(u8, c); g_olen = g_olen + 1; }
fn oput_w(c as i64) as void { oput(c); if (g_wrap > 0) { g_col = g_col + 1; if (g_col >= g_wrap) { oput(10); g_col = 0; } } }

fn enc_byte(b as i64) as void {
    g_c3[g_c3n] = cast(u8, b); g_c3n = g_c3n + 1;
    if (g_c3n == 3) {
        let is i64 as v = (cast(i64, g_c3[0]) << 16) | (cast(i64, g_c3[1]) << 8) | cast(i64, g_c3[2]);
        oput_w(b64c((v >> 18) & 63)); oput_w(b64c((v >> 12) & 63)); oput_w(b64c((v >> 6) & 63)); oput_w(b64c(v & 63));
        g_c3n = 0;
    }
}
fn enc_final() as void {
    if (g_c3n == 1) { let is i64 as v = cast(i64, g_c3[0]) << 16; oput_w(b64c((v >> 18) & 63)); oput_w(b64c((v >> 12) & 63)); oput_w(61); oput_w(61); }
    else if (g_c3n == 2) { let is i64 as v = (cast(i64, g_c3[0]) << 16) | (cast(i64, g_c3[1]) << 8); oput_w(b64c((v >> 18) & 63)); oput_w(b64c((v >> 12) & 63)); oput_w(b64c((v >> 6) & 63)); oput_w(61); }
    if (g_col != 0 || g_wrap == 0) { oput(10); }
}
fn dval(c as i64) as i64 {
    if (c >= 65 && c <= 90) { return c - 65; } if (c >= 97 && c <= 122) { return c - 71; }
    if (c >= 48 && c <= 57) { return c + 4; } if (c == 43) { return 62; } if (c == 47) { return 63; }
    return 0 - 1;
}
fn dec_char(c as i64) as void {
    if (g_eq == 1) { return; }
    if (c == 61) { g_eq = 1; return; }
    let is i64 as v = dval(c);
    if (v >= 0) { g_acc = (g_acc << 6) | v; g_bits = g_bits + 6; if (g_bits >= 8) { g_bits = g_bits - 8; oput((g_acc >> g_bits) & 255); } }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is i64 as dec with mut = 0; let is *u8 as path with mut; path = cast(*u8, 0);
    let is i64 as i with mut = 1;
    while (i < argc) {
        let is *u8 as a = prog.arg(argv, i);
        if (streq(a, "-d") == 1 || streq(a, "--decode") == 1) { dec = 1; }
        else if (streq(a, "-w") == 1) { i = i + 1; if (i < argc) { g_wrap = atoi(prog.arg(argv, i)); } }
        else if (a[0] == 45 && a[1] != 0) { prog.outs("usage: base64 [-d] [-w COLS] [FILE]\n"); return cast(i32, 1); }
        else { path = a; }
        i = i + 1;
    }
    let is i64 as fd with mut = 0;
    if (cast(i64, path) != 0) { let is [256]u8 as pb; let is *u8 as ap = prog.abspath(path, cast(*u8, &pb[0])); fd = sys.open_read(ap); if (fd < 0) { prog.outs("base64: cannot open "); prog.outs(path); prog.out("\n", 1); return cast(i32, 1); } }
    let is [65536]u8 as buf;
    let is i64 as r with mut = sys.read(fd, cast(*u8, &buf[0]), 65536);
    while (r > 0) {
        let is i64 as j with mut = 0;
        while (j < r) { if (dec == 1) { dec_char(cast(i64, buf[j])); } else { enc_byte(cast(i64, buf[j])); } j = j + 1; }
        r = sys.read(fd, cast(*u8, &buf[0]), 65536);
    }
    if (fd != 0) { sys.close(fd); }
    if (dec == 0) { enc_final(); }
    oflush();
    return cast(i32, 0);
}
