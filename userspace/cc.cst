// cc — compile a .cst to a .cse (no run). `cc <file.cst> [-o <out.cse>]`.
// A friendly front-end over the embedded /caustic.cse: targets caustic-x86_64,
// defaults the output to the source with .cst swapped for .cse.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 2) { prog.outs("usage: cc <file.cst> [-o <out.cse>]\n"); return cast(i32, 1); }
    let is [256]u8 as pb;
    let is *u8 as src = prog.abspath(prog.arg(argv, 1), cast(*u8, &pb[0]));

    let is [256]u8 as ob;
    let is *u8 as out with mut = cast(*u8, 0);
    if (argc >= 4) {
        let is *u8 as f = prog.arg(argv, 2);
        if (cast(i64, f[0]) == 45 && cast(i64, f[1]) == 111) {          // "-o"
            out = prog.abspath(prog.arg(argv, 3), cast(*u8, &ob[0]));
        }
    }
    if (cast(i64, out) == 0) {                                          // derive <base>.cse
        let is i64 as sl = prog.slen(src);
        let is i64 as i with mut = 0;
        while (i < sl) { ob[i] = src[i]; i = i + 1; }
        if (sl >= 4 && cast(i64, ob[sl - 1]) == 116 && cast(i64, ob[sl - 2]) == 115
                    && cast(i64, ob[sl - 3]) == 99 && cast(i64, ob[sl - 4]) == 46) {
            ob[sl - 1] = cast(u8, 101);                                 // ".cst" -> ".cse"
            ob[sl] = cast(u8, 0);
        } else {
            ob[sl] = cast(u8, 46); ob[sl + 1] = cast(u8, 99);
            ob[sl + 2] = cast(u8, 115); ob[sl + 3] = cast(u8, 101); ob[sl + 4] = cast(u8, 0);
        }
        out = cast(*u8, &ob[0]);
    }

    let is i64 as clen with mut = 0;
    let is i64 as cimg = fu.slurp("/caustic.cse", &clen);
    if (clen <= 0) { prog.outs("cc: /caustic.cse not on disk (no compiler)\n"); return cast(i32, 1); }
    let is [10]i64 as av;
    av[0] = cast(i64, "caustic");                 av[1] = 7;
    av[2] = cast(i64, src);                       av[3] = prog.slen(src);
    av[4] = cast(i64, "-o");                      av[5] = 2;
    av[6] = cast(i64, out);                       av[7] = prog.slen(out);
    av[8] = cast(i64, "--target=caustic-x86_64"); av[9] = 23;
    let is [2]i64 as fda; fda[0] = 1; fda[1] = 1;
    prog.outs("cc: "); prog.outs(src); prog.outs(" -> "); prog.outs(out); prog.out("\n", 1);
    let is i64 as pid = sys.spawn(cast(*u8, cimg), clen, cast(*u8, &fda[0]), 1, cast(*u8, &av[0]), 5);
    fu.unslurp(cimg, clen);
    if (pid < 0) { prog.outs("cc: cannot spawn compiler\n"); return cast(i32, 1); }
    let is [1]i64 as st;
    let is i64 as r with mut = 0 - 8;
    while (r == (0 - 8)) { r = sys.wait(pid, cast(*i64, &st[0])); }
    if (r == 0) { prog.outs("cc: ok\n"); return 0; }
    prog.outs("cc: failed (exit "); prog.out_num(r); prog.outs(")\n");
    return cast(i32, 1);
}
