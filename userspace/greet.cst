// greet — a tiny program meant to be compiled AND run on CausticOS itself
// (via `run greet.cst`). It imports the stdlib by its on-disk absolute path
// (/std/...), the way a program written on the device would.
use "/std/causticos/prog.cst" as prog;

fn main(argc as i64, argv as *u8) as i32 {
    prog.outs("greetings from a program built and run on CausticOS!\n");
    return 0;
}
