// tail — print the last N lines of a file (default 10). `tail [-n N] <file>`.
// Maps the whole file (slurp), then walks back from the end counting newlines.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 2) { prog.outs("usage: tail [-n N] <file>\n"); return cast(i32, 1); }
    let is i64 as nlines with mut = 10;
    let is i64 as ai with mut = 1;
    let is *u8 as a1 = prog.arg(argv, 1);
    if (cast(i64, a1[0]) == 45 && cast(i64, a1[1]) == 110) {   // "-n"
        if (argc < 4) { prog.outs("usage: tail [-n N] <file>\n"); return cast(i32, 1); }
        let is *u8 as nv = prog.arg(argv, 2);
        let is i64 as pn = fu.parse_uint(nv, prog.slen(nv));
        if (pn >= 0) { nlines = pn; }
        ai = 3;
    }
    let is [256]u8 as pb;
    let is *u8 as path = prog.abspath(prog.arg(argv, ai), cast(*u8, &pb[0]));
    let is i64 as len with mut = 0;
    let is i64 as base = fu.slurp(path, &len);
    if (len < 0) {
        prog.outs("tail: cannot open "); prog.outs(path); prog.out("\n", 1);
        return cast(i32, 1);
    }
    if (len == 0 || nlines == 0) { return 0; }
    let is *u8 as p = cast(*u8, base);
    let is i64 as i with mut = len - 1;
    if (cast(i64, p[i]) == 0x0A) { i = i - 1; }    // ignore a single trailing newline
    let is i64 as seen with mut = 0;
    let is i64 as start with mut = 0;
    while (i >= 0) {
        if (cast(i64, p[i]) == 0x0A) {
            seen = seen + 1;
            if (seen == nlines) { start = i + 1; i = 0 - 1; }   // stop
        }
        i = i - 1;
    }
    prog.out(cast(*u8, base + start), len - start);
    fu.unslurp(base, len);
    return 0;
}
