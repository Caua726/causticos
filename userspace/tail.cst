// tail — print the last part of each file. tail [-n N] [-c N] [file ...].
// -n N lines (default 10), -c N bytes. With several files, a `==> name <==`
// banner each. No file (or `-`) reads stdin.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn emit_tail(base as i64, len as i64, n as i64, bymode as i64) as void {
    if (len <= 0) { return; }
    let is *u8 as p = cast(*u8, base);
    if (bymode == 1) {
        let is i64 as start with mut = len - n;
        if (start < 0) { start = 0; }
        prog.out(cast(*u8, base + start), len - start);
        return;
    }
    let is i64 as i with mut = len - 1;
    if (cast(i64, p[i]) == 0x0A) { i = i - 1; }      // ignore a single trailing newline
    let is i64 as seen with mut = 0;
    let is i64 as start with mut = 0;
    while (i >= 0) {
        if (cast(i64, p[i]) == 0x0A) { seen = seen + 1; if (seen == n) { start = i + 1; break; } }
        i = i - 1;
    }
    prog.out(cast(*u8, base + start), len - start);
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    let is i64 as n with mut = 10;
    let is i64 as bymode with mut = 0;
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "n:c:");
        if (f < 0) { break; }
        let is *u8 as va = cast(*u8, o.optarg);
        if (f == 110) { n = fu.parse_uint(va, prog.slen(va)); bymode = 0; }
        else if (f == 99) { n = fu.parse_uint(va, prog.slen(va)); bymode = 1; }
        else { prog.outs("usage: tail [-n N] [-c N] [file ...]\n"); return cast(i32, 1); }
    }
    if (n < 0) { n = 0; }
    let is i64 as nfiles = argc - o.ind;
    if (nfiles <= 0) {
        let is i64 as len with mut = 0;
        let is i64 as base = fu.slurp_fd(cast(i64, 0), &len);
        if (len > 0) { emit_tail(base, len, n, bymode); }
        return 0;
    }
    let is i32 as rc with mut = 0;
    let is i64 as i with mut = o.ind;
    let is i64 as first with mut = 1;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb;
        let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is i64 as len with mut = 0;
        let is i64 as base = fu.slurp(path, &len);
        if (len < 0) {
            prog.outs("tail: "); prog.outs(name); prog.outs(": cannot open\n"); rc = cast(i32, 1);
        } else {
            if (nfiles > 1) {
                if (first == 0) { prog.out("\n", 1); }
                prog.outs("==> "); prog.outs(name); prog.outs(" <==\n");
            }
            first = 0;
            emit_tail(base, len, n, bymode);
            fu.unslurp(base, len);
        }
        i = i + 1;
    }
    return rc;
}
