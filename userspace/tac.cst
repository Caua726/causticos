// tac — print the lines of a file in reverse order (last line first).
// `tac <file>`. Maps the whole file (slurp), then walks it back to front.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 2) { prog.outs("usage: tac <file>\n"); return cast(i32, 1); }
    let is [256]u8 as pb;
    let is *u8 as path = prog.abspath(prog.arg(argv, 1), cast(*u8, &pb[0]));
    let is i64 as len with mut = 0;
    let is i64 as base = fu.slurp(path, &len);
    if (len < 0) {
        prog.outs("tac: cannot open "); prog.outs(path); prog.out("\n", 1);
        return cast(i32, 1);
    }
    if (len == 0) { return 0; }                 // empty file: nothing to print
    let is *u8 as p = cast(*u8, base);
    // Drop a single trailing newline so the last line isn't emitted as a blank.
    let is i64 as seg_end with mut = len;
    if (cast(i64, p[len - 1]) == 0x0A) { seg_end = len - 1; }
    let is i64 as pos with mut = seg_end;
    while (pos > 0) {
        let is i64 as j with mut = pos - 1;
        while (j >= 0) {
            if (cast(i64, p[j]) == 0x0A) { break; }
            j = j - 1;
        }
        let is i64 as start = j + 1;
        prog.out(cast(*u8, base + start), pos - start);
        prog.out("\n", 1);
        pos = j;
    }
    fu.unslurp(base, len);
    return 0;
}
