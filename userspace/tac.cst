// tac — print each file's lines in reverse order (last line first).
// tac [file ...]. No file (or `-`) reads stdin. The file is mapped whole.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn tac_buf(base as i64, len as i64) as void {
    if (len <= 0) { return; }
    let is *u8 as p = cast(*u8, base);
    let is i64 as seg_end with mut = len;
    if (cast(i64, p[len - 1]) == 0x0A) { seg_end = len - 1; }     // drop one trailing newline
    let is i64 as pos with mut = seg_end;
    while (pos > 0) {
        let is i64 as j with mut = pos - 1;
        while (j >= 0) { if (cast(i64, p[j]) == 0x0A) { break; } j = j - 1; }
        let is i64 as start = j + 1;
        prog.out(cast(*u8, base + start), pos - start);
        prog.out("\n", 1);
        pos = j;
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "");
        if (f < 0) { break; }
        prog.outs("usage: tac [file ...]\n"); return cast(i32, 1);
    }
    let is i64 as nfiles = argc - o.ind;
    if (nfiles <= 0) {
        let is i64 as len with mut = 0;
        let is i64 as base = fu.slurp_fd(cast(i64, 0), &len);
        if (len > 0) { tac_buf(base, len); }
        return 0;
    }
    let is i32 as rc with mut = 0;
    let is i64 as i with mut = o.ind;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb;
        let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is i64 as len with mut = 0;
        let is i64 as base = fu.slurp(path, &len);
        if (len < 0) { prog.outs("tac: "); prog.outs(name); prog.outs(": cannot open\n"); rc = cast(i32, 1); }
        else { tac_buf(base, len); fu.unslurp(base, len); }
        i = i + 1;
    }
    return rc;
}
