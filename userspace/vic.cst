// vic.cst — Visual Interface Caustic: a tiny modal (vi-style) text editor.
//
// Modelled on busybox vi's data model: the text is ONE flat byte buffer with
// embedded '\n'; the cursor is an index `dot`; `tend` is the byte count. Lines
// are found by scanning for '\n'. Two modes (command / insert). Insert/delete
// shift the buffer (memmove). It's a spawned program: the shell hands it argv
// (the filename); it grabs the framebuffer + keyboard directly (v0 has no device
// exclusivity), runs a full-screen edit loop, and on :q restores the screen and
// exits — the shell resumes.
//
// commands: h j k l (+ arrows) move · 0 $ line ends · G last line · i a o insert
//           x delete char · dd delete line · Esc -> command · :w :q :wq :q!
use "../../Caustic/std/causticos/gfx.cst" as gfx;
use "../../Caustic/std/causticos/font.cst" as font;
use "../../Caustic/std/causticos/input.cst" as input;
use "../../Caustic/std/os/causticos.cst" as sys;

let is i64 as TEXT_CAP with imut = 65536;
let is i64 as GW with imut = 8;
let is i64 as GH with imut = 16;
let is i64 as PAD with imut = 8;

// palette (matches the shell)
let is u32 as C_FG    with imut = 0x00d3d7cf;
let is u32 as C_BG    with imut = 0x00121417;
let is u32 as C_BAR   with imut = 0x002a2e34;   // status-bar background
let is u32 as C_BARFG with imut = 0x008bbf63;   // status-bar text (green)
let is u32 as C_CYAN  with imut = 0x0073d0ff;

// --- editor state ---
let is [65536]u8 as text with mut;
let is i64 as tend with mut = 0;     // bytes used
let is i64 as dot  with mut = 0;     // cursor byte index [0..tend]
let is i64 as topln with mut = 0;    // byte index: start of the first visible line
let is i64 as mode with mut = 0;     // 0 = command, 1 = insert
let is i64 as modified with mut = 0;
let is i64 as quit with mut = 0;
let is i64 as pend_d with mut = 0;   // a 'd' is pending (for dd)

// framebuffer (module globals so the render helpers don't pass it around)
let is *u8 as fb_base with mut;
let is i64 as fb_fd with mut = 0;
let is i64 as fb_w with mut = 0;
let is i64 as fb_h with mut = 0;
let is i64 as fb_pitch with mut = 0;
let is i64 as fb_bpp with mut = 0;
let is i64 as g_cols with mut = 0;   // text columns
let is i64 as g_rows with mut = 0;   // text rows (above the status bar)

let is *u8 as g_path with mut;       // absolute path (always leading '/')
let is [128]u8 as g_pathbuf;         // backs g_path when argv[1] is relative
let is [80]u8 as g_msg;              // status message
let is i64 as g_msglen with mut = 0;

fn slen(s as *u8) as i64 { let is i64 as n with mut = 0; while (s[n] != 0) { n = n + 1; } return n; }
fn setmsg(s as *u8) as void {
    let is i64 as n with mut = slen(s); if (n > 79) { n = 79; }
    let is i64 as i with mut = 0; while (i < n) { g_msg[i] = s[i]; i = i + 1; }
    g_msglen = n;
}

// --- buffer / line navigation (indices into text[0..tend]) ---
fn bol(p as i64) as i64 { let is i64 as i with mut = p; while (i > 0 && text[i - 1] != 0x0A) { i = i - 1; } return i; }
fn eol(p as i64) as i64 { let is i64 as i with mut = p; while (i < tend && text[i] != 0x0A) { i = i + 1; } return i; }

// --- editing: shift the buffer to insert / delete (busybox text_hole_*) ---
fn insert_byte(c as i64) as void {
    if (tend >= TEXT_CAP - 1) { return; }
    let is i64 as i with mut = tend;
    while (i > dot) { text[i] = text[i - 1]; i = i - 1; }   // shift right
    text[dot] = cast(u8, c);
    tend = tend + 1; dot = dot + 1; modified = 1;
}
fn delete_at(p as i64) as void {                            // delete one byte at p
    if (p >= tend) { return; }
    let is i64 as i with mut = p;
    while (i < tend - 1) { text[i] = text[i + 1]; i = i + 1; }
    tend = tend - 1; modified = 1;
}
fn delete_line() as void {
    let is i64 as a = bol(dot);
    let is i64 as b with mut = eol(dot);
    if (b < tend) { b = b + 1; }                            // include the '\n'
    let is i64 as n = b - a;
    let is i64 as i with mut = a;
    while (i + n < tend) { text[i] = text[i + n]; i = i + 1; }
    tend = tend - n; modified = 1;
    if (dot > tend) { dot = tend; }
    dot = bol(dot);
}

// --- movement ---
fn m_left()  as void { if (dot > 0 && text[dot - 1] != 0x0A) { dot = dot - 1; } }
fn m_right() as void { if (dot < tend && text[dot] != 0x0A) { dot = dot + 1; } }
fn m_down() as void {
    let is i64 as col with mut = dot - bol(dot);
    let is i64 as e = eol(dot);
    if (e >= tend) { return; }                              // last line
    let is i64 as nb = e + 1;
    let is i64 as ne = eol(nb);
    let is i64 as nlen = ne - nb;
    if (col > nlen) { col = nlen; }
    dot = nb + col;
}
fn m_up() as void {
    let is i64 as b = bol(dot);
    if (b == 0) { return; }                                 // first line
    let is i64 as col with mut = dot - b;
    let is i64 as pb = bol(b - 1);
    let is i64 as pe = b - 1;
    let is i64 as plen = pe - pb;
    if (col > plen) { col = plen; }
    dot = pb + col;
}

// --- file ---
fn load_file() as void {
    let is i64 as fd = sys.open_read(g_path);
    if (fd < 0) { tend = 0; setmsg("(new file)"); return; }
    let is i64 as n with mut = sys.read(fd, cast(*u8, &text[0]), TEXT_CAP - 1);
    sys.close(fd);
    if (n < 0) { n = 0; }
    tend = n; dot = 0; topln = 0; modified = 0;
}
fn save_file() as void {
    let is i64 as fd = sys.open_write(g_path);
    if (fd < 0) { setmsg("write failed"); return; }
    sys.write(fd, cast(*u8, &text[0]), tend);
    sys.close(fd);
    modified = 0;
    setmsg("written");
}

// --- rendering (direct to the framebuffer, 8x16, no term.cst) ---
fn _px(x as i64, y as i64, color as u32) as void {
    if (x < 0 || y < 0 || x >= fb_w || y >= fb_h) { return; }
    let is *u32 as p = cast(*u32, cast(i64, fb_base) + y * fb_pitch + x * fb_bpp);
    p[0] = color;
}
fn _glyph(ch as i64, cx as i64, cy as i64, fg as u32, bg as u32) as void {
    let is *u8 as g = font.get_glyph(cast(i32, ch));
    let is i64 as px = PAD + cx * GW;
    let is i64 as py = PAD + cy * GH;
    let is i64 as row with mut = 0;
    while (row < GH) {
        let is i64 as bits = cast(i64, g[row]);
        let is i64 as col with mut = 0;
        while (col < GW) {
            let is i64 as mask = 128 >> col;
            if ((bits & mask) != 0) { _px(px + col, py + row, fg); }
            else { _px(px + col, py + row, bg); }
            col = col + 1;
        }
        row = row + 1;
    }
}
fn _fillrow(cy as i64, color as u32) as void {              // fill one text row, edge to edge
    let is i64 as y0 = PAD + cy * GH;
    let is i64 as y with mut = y0;
    while (y < y0 + GH) {
        let is i64 as x with mut = 0;
        while (x < fb_w) { _px(x, y, color); x = x + 1; }
        y = y + 1;
    }
}
fn _clear() as void {
    let is *u32 as p = cast(*u32, cast(i64, fb_base));
    let is i64 as pw = (fb_pitch * fb_h) / 4;
    let is i64 as i with mut = 0;
    while (i < pw) { p[i] = C_BG; i = i + 1; }
}

// ensure dot's line is within [topln .. topln + g_rows)
fn scroll_to_dot() as void {
    let is i64 as db = bol(dot);
    if (db < topln) { topln = db; return; }
    // walk g_rows lines from topln; if dot is past them, advance topln
    let is i64 as cnt with mut = 0;
    let is i64 as i with mut = topln;
    while (cnt < g_rows && i <= tend) {
        if (db <= eol(i)) { return; }                       // dot visible
        i = eol(i) + 1; cnt = cnt + 1;
    }
    // not visible: scroll down one line at a time until it is
    while (db > eol(topln) || db < topln) {
        let is i64 as e = eol(topln);
        if (e >= tend) { return; }
        topln = e + 1;
        // re-check window
        let is i64 as c2 with mut = 0;
        let is i64 as j with mut = topln;
        let is i64 as ok with mut = 0;
        while (c2 < g_rows && j <= tend) { if (db <= eol(j)) { ok = 1; j = tend + 1; } else { j = eol(j) + 1; c2 = c2 + 1; } }
        if (ok == 1) { return; }
    }
}

fn render() as void {
    scroll_to_dot();
    _clear();
    let is i64 as crow with mut = 0;     // cursor screen row
    let is i64 as ccol with mut = 0;     // cursor screen col
    let is i64 as row with mut = 0;
    let is i64 as i with mut = topln;
    while (row < g_rows) {
        if (i > tend) { row = g_rows; }                     // past end
        else {
            let is i64 as col with mut = 0;
            let is i64 as j with mut = i;
            while (j < tend && text[j] != 0x0A) {
                if (j == dot) { crow = row; ccol = col; }
                if (col < g_cols) { _glyph(cast(i64, text[j]), col, row, C_FG, C_BG); }
                col = col + 1; j = j + 1;
            }
            if (j == dot) { crow = row; ccol = col; }        // cursor at line end
            i = j + 1;                                       // skip the '\n'
            row = row + 1;
        }
    }
    // cursor: block in command mode, bar in insert mode
    if (ccol < g_cols) {
        let is i64 as px = PAD + ccol * GW;
        let is i64 as py = PAD + crow * GH;
        if (mode == 0) {
            let is i64 as yy with mut = 0;
            while (yy < GH) { let is i64 as xx with mut = 0; while (xx < GW) { _px(px + xx, py + yy, C_FG); xx = xx + 1; } yy = yy + 1; }
            let is i64 as uch with mut = 0x20; if (dot < tend && text[dot] != 0x0A) { uch = cast(i64, text[dot]); }
            _glyph(uch, ccol, crow, C_BG, C_FG);             // inverted glyph under the block
        } else {
            let is i64 as yy2 with mut = 0;
            while (yy2 < GH) { _px(px, py + yy2, C_CYAN); _px(px + 1, py + yy2, C_CYAN); yy2 = yy2 + 1; }
        }
    }
    // status bar (bottom row)
    _fillrow(g_rows, C_BAR);
    let is i64 as sx with mut = 0;
    if (mode == 1) { _glyph(cast(i64, '-'), sx, g_rows, C_BARFG, C_BAR); sx=sx+1; _glyph(cast(i64,'-'),sx,g_rows,C_BARFG,C_BAR); sx=sx+1; }
    // filename
    let is i64 as pk with mut = 0;
    while (g_path[pk] != 0 && sx < g_cols) { _glyph(cast(i64, g_path[pk]), sx, g_rows, C_BARFG, C_BAR); sx = sx + 1; pk = pk + 1; }
    if (modified != 0) { _glyph(cast(i64, '*'), sx, g_rows, C_BARFG, C_BAR); sx = sx + 1; }
    sx = sx + 2;
    let is i64 as mk with mut = 0;
    while (mk < g_msglen && sx < g_cols) { _glyph(cast(i64, g_msg[mk]), sx, g_rows, C_CYAN, C_BAR); sx = sx + 1; mk = mk + 1; }
    sys.present(fb_fd, 0, 0, fb_w, fb_h);
}

// --- ex line (:...) — read until Enter/Esc, then run :w :q :wq :q! ---
fn ex_line(kfd as i64) as void {
    let is [64]u8 as buf;
    let is i64 as n with mut = 0;
    let is i64 as shift with mut = 0;
    let is input.KeyEvent as ev;
    let is i64 as done with mut = 0;
    while (done == 0) {
        // draw the ex line in the status bar
        _fillrow(g_rows, C_BAR);
        _glyph(cast(i64, ':'), 0, g_rows, C_BARFG, C_BAR);
        let is i64 as k with mut = 0; while (k < n) { _glyph(cast(i64, buf[k]), 1 + k, g_rows, C_FG, C_BAR); k = k + 1; }
        sys.present(fb_fd, 0, 0, fb_w, fb_h);
        if (input.read_event(kfd, &ev) == 1) {
            if (input.is_shift(ev.scancode) == 1) { shift = ev.pressed; }
            else if (ev.pressed == 1) {
                if (ev.scancode == 0x01) { return; }         // Esc cancels
                let is i64 as c = input.scancode_to_ascii(ev.scancode, shift);
                if (c == 0x0A) { done = 1; }
                else if (c == 0x08) { if (n > 0) { n = n - 1; } }
                else if (c != 0 && n < 63) { buf[n] = cast(u8, c); n = n + 1; }
            }
        }
    }
    // parse buf[0..n)
    let is i64 as wantw with mut = 0;
    let is i64 as wantq with mut = 0;
    let is i64 as force with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        if (buf[i] == cast(u8, 'w')) { wantw = 1; }
        if (buf[i] == cast(u8, 'q')) { wantq = 1; }
        if (buf[i] == cast(u8, '!')) { force = 1; }
        i = i + 1;
    }
    if (wantw == 1) { save_file(); }
    if (wantq == 1) {
        if (modified != 0 && force == 0 && wantw == 0) { setmsg("no write since change (:q! to force)"); }
        else { quit = 1; }
    }
}

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 2) { sys.write_serial("vic: usage: vic <file>\n", 23); sys.exit(cast(i32, 1)); }
    // the kernel has no cwd — every VFS path must be absolute. Prepend '/' if the
    // filename arg isn't already absolute, so open/create work (this is what lets
    // `vic newfile.txt` create a file on :w).
    let is *u8 as raw = cast(*u8, cast(*i64, argv)[1]);
    if (raw[0] == cast(u8, 47)) { g_path = raw; }
    else {
        g_pathbuf[0] = cast(u8, 47);
        let is i64 as pi with mut = 0;
        while (raw[pi] != 0 && pi < 126) { g_pathbuf[1 + pi] = raw[pi]; pi = pi + 1; }
        g_pathbuf[1 + pi] = cast(u8, 0);
        g_path = cast(*u8, &g_pathbuf[0]);
    }

    let is gfx.Framebuffer as fb = gfx.open();
    if (fb.ok == 0) { sys.write_serial("vic: NO FB\n", 11); sys.exit(cast(i32, 1)); }
    font.init();
    fb_base = fb.base; fb_fd = fb.fd; fb_w = fb.width; fb_h = fb.height; fb_pitch = fb.pitch; fb_bpp = fb.bpp;
    g_cols = (fb_w - 2 * PAD) / GW;
    g_rows = (fb_h - 2 * PAD) / GH - 1;        // reserve the last row for the status bar
    let is i64 as kfd = input.open_keyboard();
    if (kfd < 0) { sys.write_serial("vic: NO KBD\n", 12); sys.exit(cast(i32, 2)); }

    load_file();
    render();

    let is i64 as shift with mut = 0;
    let is input.KeyEvent as ev;
    while (quit == 0) {
        if (input.read_event(kfd, &ev) == 1) {
            if (input.is_shift(ev.scancode) == 1) { shift = ev.pressed; }
            else if (ev.pressed == 1) {
                // arrows (extended) work in both modes
                if (ev.extended == 1) {
                    if (ev.scancode == 0x48) { m_up(); }
                    else if (ev.scancode == 0x50) { m_down(); }
                    else if (ev.scancode == 0x4B) { m_left(); }
                    else if (ev.scancode == 0x4D) { m_right(); }
                    render();
                } else if (ev.scancode == 0x01) {            // Esc
                    mode = 0; pend_d = 0; render();
                } else {
                    let is i64 as c = input.scancode_to_ascii(ev.scancode, shift);
                    if (mode == 1) {                          // INSERT
                        if (c == 0x08) { if (dot > 0) { dot = dot - 1; delete_at(dot); } }
                        else if (c != 0) { insert_byte(c); }
                        render();
                    } else {                                  // COMMAND
                        if (pend_d == 1) {
                            pend_d = 0;
                            if (c == cast(i64, 'd')) { delete_line(); }
                        }
                        else if (c == cast(i64, 'h')) { m_left(); }
                        else if (c == cast(i64, 'l')) { m_right(); }
                        else if (c == cast(i64, 'j')) { m_down(); }
                        else if (c == cast(i64, 'k')) { m_up(); }
                        else if (c == cast(i64, '0')) { dot = bol(dot); }
                        else if (c == cast(i64, '$')) { dot = eol(dot); if (dot > bol(dot)) { dot = dot - 1; } }
                        else if (c == cast(i64, 'G')) { dot = tend; dot = bol(dot); }
                        else if (c == cast(i64, 'x')) { if (dot < tend && text[dot] != 0x0A) { delete_at(dot); } }
                        else if (c == cast(i64, 'd')) { pend_d = 1; }
                        else if (c == cast(i64, 'i')) { mode = 1; }
                        else if (c == cast(i64, 'a')) { m_right(); mode = 1; }
                        else if (c == cast(i64, 'o')) { dot = eol(dot); insert_byte(0x0A); mode = 1; }
                        else if (c == cast(i64, ':')) { ex_line(kfd); }
                        render();
                    }
                }
            }
        }
    }
    _clear();
    sys.present(fb_fd, 0, 0, fb_w, fb_h);      // leave a clean screen for the shell
    sys.exit(cast(i32, 0));
    return 0;
}
