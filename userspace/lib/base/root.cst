// root.cst — the stub root libbase.csl is built through.
//
// ONE library for the base runtime: the syscall bindings, the program helpers
// on top of them, and futil. They are one dependency closure — futil is written
// against prog and the bindings — and a .csl cannot import from another .csl,
// so splitting them means each half carries its own copy of what it uses.
//
// That was measured, not assumed. Two libraries (libfutil + libcstd) put 32 KB
// of duplicated prog and bindings on the image and made it 20 KB BIGGER than
// sharing futil alone. One library has no duplication to pay for.
//
// A --shared build exports everything it defines, so importing the modules is
// enough; the calls below only give the linker an entry point to keep.
use "../futil/futil.cst" as f;
use "../../../../Caustic/std/causticos/prog.cst" as p;
use "../../../../Caustic/std/os/causticos.cst" as s;

fn _keep() as i64 {
    let is [8]u8 as buf;
    let is [2]i64 as n;
    p.outs(cast(*u8, ""));
    f.slurp(cast(*u8, "/x"), &n[0]);
    f.parse_int(cast(*u8, &buf[0]), 1);
    return s.getpid();
}
