// keysym.cst — what a key is, once a layout has made something of it.
//
// A key event carries a symbol: a character's code point, or one of the KEY_*
// codes below for the keys that are not characters, and the modifiers held as
// MOD_* bits. lib/keymap/keymap.cst makes them from scancodes; the compositor
// sends them to the window manager and on to the focused window
// (compo_proto MSG_CP_KEY, wmproto MSG_KEY); a terminal turns them into the
// bytes a program reads (term_bytes, below).
//
// This module is only that vocabulary, with no state and no tables, so a
// program that receives keys can name them without carrying a keyboard
// layout's parser.
use "std/unicode/utf8.cst" as utf8;

// The keys that are not characters. A character is its code point
// (below 0x110000); these sit far above it, so a client switches on the value.
let is i64 as KEY_NONE      with imut = 0;
let is i64 as KEY_BASE      with imut = 0x1000000;
let is i64 as KEY_ENTER     with imut = 0x1000001;
let is i64 as KEY_BACKSPACE with imut = 0x1000002;
let is i64 as KEY_TAB       with imut = 0x1000003;
let is i64 as KEY_ESC       with imut = 0x1000004;
let is i64 as KEY_UP        with imut = 0x1000005;
let is i64 as KEY_DOWN      with imut = 0x1000006;
let is i64 as KEY_LEFT      with imut = 0x1000007;
let is i64 as KEY_RIGHT     with imut = 0x1000008;
let is i64 as KEY_PGUP      with imut = 0x1000009;
let is i64 as KEY_PGDN      with imut = 0x100000A;
let is i64 as KEY_HOME      with imut = 0x100000B;
let is i64 as KEY_END       with imut = 0x100000C;
let is i64 as KEY_DEL       with imut = 0x100000D;
let is i64 as KEY_INSERT    with imut = 0x100000E;
let is i64 as KEY_F1        with imut = 0x1000011;   // .. KEY_F1 + 11 = F12

let is i64 as MOD_SHIFT with imut = 1;
let is i64 as MOD_CTRL  with imut = 2;
let is i64 as MOD_ALT   with imut = 4;
let is i64 as MOD_SUPER with imut = 8;

// The key a Ctrl chord names: a letter in lower case (Ctrl+Shift+W is Ctrl+W),
// anything else as it is. Chords go by the letter the layout puts on the key,
// as xterm and every shell do — Ctrl+W is the key marked W, which on AZERTY is
// not where it is on QWERTY.
fn chord_key(sym as i64) as i64 {
    if (sym >= 0x41 && sym <= 0x5A) { return sym + 0x20; }
    return sym;
}

// ---- what a terminal sends --------------------------------------------------

fn _csi_n(out as *u8, o as i64, v as i64) as i64 {
    let is i64 as p with mut = o;
    if (v >= 10) { out[p] = cast(u8, 48 + v / 10); p = p + 1; }
    out[p] = cast(u8, 48 + v % 10);
    return p + 1;
}

// The bytes a terminal sends the program reading it for one key event (its
// symbol and its modifiers), the way xterm does: a character as UTF-8 — with Ctrl,
// a letter is its control code; with Alt, an ESC goes first — Enter as \n,
// Backspace as \b, Tab, Esc, and the other special keys as CSI sequences
// (arrows ESC [ A..D, Home/End ESC [ H/F, Insert/Delete/PgUp/PgDn ESC [ 2/3/5/6 ~,
// F1..F12 ESC [ 11..24 ~), with ";<1 + Shift 1 + Alt 2 + Ctrl 4>" when a
// modifier is held. out needs 16 bytes; returns how many, 0 for nothing.
fn term_bytes(sym as i64, mods as i64, out as *u8) as i64 {
    if (sym <= 0) { return 0; }
    let is i64 as m with mut = 1;
    if ((mods & MOD_SHIFT) != 0) { m = m + 1; }
    if ((mods & MOD_ALT) != 0) { m = m + 2; }
    if ((mods & MOD_CTRL) != 0) { m = m + 4; }
    if (sym >= KEY_BASE) {
        if (sym == KEY_ENTER) { out[0] = cast(u8, 0x0A); return 1; }
        if (sym == KEY_BACKSPACE) { out[0] = cast(u8, 0x08); return 1; }
        if (sym == KEY_ESC) { out[0] = cast(u8, 0x1B); return 1; }
        if (sym == KEY_TAB) {
            if ((mods & MOD_SHIFT) != 0) { out[0] = cast(u8, 0x1B); out[1] = cast(u8, 0x5B); out[2] = cast(u8, 0x5A); return 3; }
            out[0] = cast(u8, 0x09);
            return 1;
        }
        let is i64 as fin with mut = 0;                      // ESC [ 1;m <fin> keys
        if (sym == KEY_UP) { fin = 0x41; }
        if (sym == KEY_DOWN) { fin = 0x42; }
        if (sym == KEY_RIGHT) { fin = 0x43; }
        if (sym == KEY_LEFT) { fin = 0x44; }
        if (sym == KEY_HOME) { fin = 0x48; }
        if (sym == KEY_END) { fin = 0x46; }
        out[0] = cast(u8, 0x1B); out[1] = cast(u8, 0x5B);
        if (fin != 0) {
            let is i64 as o with mut = 2;
            if (m > 1) { out[2] = cast(u8, 0x31); out[3] = cast(u8, 0x3B); o = _csi_n(out, 4, m); }
            out[o] = cast(u8, fin);
            return o + 1;
        }
        let is i64 as num with mut = 0;                      // ESC [ n;m ~ keys
        if (sym == KEY_INSERT) { num = 2; }
        if (sym == KEY_DEL) { num = 3; }
        if (sym == KEY_PGUP) { num = 5; }
        if (sym == KEY_PGDN) { num = 6; }
        if (sym >= KEY_F1 && sym <= KEY_F1 + 11) {
            let is *u8 as fnum = "\x0b\x0c\x0d\x0e\x0f\x11\x12\x13\x14\x15\x17\x18";
            num = cast(i64, fnum[sym - KEY_F1]);
        }
        if (num == 0) { return 0; }
        let is i64 as o2 with mut = _csi_n(out, 2, num);
        if (m > 1) { out[o2] = cast(u8, 0x3B); o2 = _csi_n(out, o2 + 1, m); }
        out[o2] = cast(u8, 0x7E);
        return o2 + 1;
    }
    let is i64 as c with mut = sym;
    let is i64 as o3 with mut = 0;
    if ((mods & MOD_ALT) != 0) { out[0] = cast(u8, 0x1B); o3 = 1; }
    if ((mods & MOD_CTRL) != 0) {
        if ((c >= 0x40 && c <= 0x5F) || (c >= 0x61 && c <= 0x7A)) { c = c & 0x1F; }
        else if (c == 0x20 || c == 0x32) { c = 0; }          // Ctrl+Space, Ctrl+2: NUL
        else if (c == 0x3F) { c = 0x7F; }                    // Ctrl+?: DEL
    }
    let is i64 as n = utf8.encode1(cast(i32, c), cast(*u8, cast(i64, out) + o3));
    if (n <= 0) { return 0; }
    return o3 + n;
}

