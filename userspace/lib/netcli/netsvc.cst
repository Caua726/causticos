// netsvc — how a program gets the network, and how it hands it on.
//
// There is no service namespace to look netd up in (architecture.md §2.2), so
// a network channel reaches a process exactly one way: whoever spawned it put
// one there. That makes the chain explicit, and it makes this module the two
// halves of every link in it —
//
//   adopt()      take the channel I was handed, and prove it is netd's
//   endpoint()   mint one for a program I am about to spawn
//
// EXACTLY ONE PROCESS STARTS NETD, and it is /init. DEV_NET is exclusive but
// preemptible (kernel/sys/grab.cst), so a second netd does not fail — it takes
// the interface away from the first, which then goes quiet with its DHCP lease
// still nominally live. Two stacks, one link, one of them silently wrong. So
// start() is called by /init and by nothing else; everyone below adopts what
// they were given, and a link that forgets to pass it on leaves its children
// with no network rather than with a second stack.
//
// A program with no netd is not broken, it is offline: adopt() fails, every
// call here says so, and the program prints something a person can act on.

use "std/os/causticos.cst" as sys;
use "../netproto/netproto.cst" as np;
use "netcli.cst" as nc;

let is i64 as ready with mut = 0;
let is i64 as netd_pid with mut = 0;

fn available() as i64 { return ready; }
fn pid() as i64 { return netd_pid; }

// Load a .cse image. Deliberately not futil's slurp: this module is linked
// into the compositor and the window manager, which have no other reason to
// carry a file-utility library, and the whole thing is fifteen lines.
fn load(path as *u8, out_len as *i64) as i64 {
    out_len[0] = 0;
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { return 0; }
    let is i64 as sz = sys.lseek(fd, 0, cast(i32, sys.SEEK_END));
    sys.lseek(fd, 0, cast(i32, sys.SEEK_SET));
    if (sz <= 0) { sys.close(fd); return 0; }
    let is i64 as alloc = (sz + 4095) & (0 - 4096);
    let is i64 as va = sys.mmap(cast(i64, 0), alloc, sys.PROT_READ | sys.PROT_WRITE);
    if (va < 0) { sys.close(fd); return 0; }
    let is i64 as got = sys.read(fd, cast(*u8, va), sz);
    sys.close(fd);
    if (got != sz) { sys.munmap(va, alloc); return 0; }
    out_len[0] = got;
    return va;
}

fn unload(va as i64, len as i64) as void {
    if (va == 0) { return; }
    sys.munmap(va, (len + 4095) & (0 - 4096));
    return;
}

// Take the channel we were handed and prove there is a netd behind it. One
// round trip, and a fast failure when NET_FD is not a channel at all — which
// is why netproto writes through the raw syscall rather than the std wrapper
// that would have quietly redirected the handshake to the serial console.
fn adopt() as i64 {
    if (ready == 1) { return 0; }
    let is i64 as r = nc.attach(np.NET_FD);
    if (r != 0) { return r; }
    ready = 1;
    return 0;
}

// Start netd and keep its control channel. /init only — see the header.
fn start() as i64 {
    if (ready == 1) { return 0; }
    let is [1]i64 as ilen;
    let is i64 as img = load(cast(*u8, "/netd.cse"), cast(*i64, &ilen[0]));
    if (img == 0) { return sys.E_NOENT; }

    let is [2]i64 as ch;
    if (sys.channel_create(cast(*i64, &ch[0])) != 0) {
        unload(img, ilen[0]);
        return sys.E_NOMEM;
    }
    let is [2]i64 as fda;
    fda[0] = np.NET_FD; fda[1] = ch[1];
    let is [2]i64 as av;
    av[0] = cast(i64, "netd"); av[1] = 4;
    netd_pid = sys.spawn(cast(*u8, img), ilen[0], cast(*u8, &fda[0]), 1,
                         cast(*u8, &av[0]), 1);
    unload(img, ilen[0]);
    sys.close(ch[1]);                         // netd owns its end now
    if (netd_pid < 0) {
        sys.close(ch[0]);
        netd_pid = 0;
        return sys.E_IO;
    }
    if (nc.attach(ch[0]) != 0) {
        // It spawned but does not answer: leave it running rather than
        // killing it blind, and report offline. Whatever went wrong is on
        // netd's own serial log.
        sys.close(ch[0]);
        return sys.E_IO;
    }
    ready = 1;
    return 0;
}

// The whole rule in one call: take what I was given, and start one myself only
// if I am the process that is allowed to.
fn attach_or_start(may_start as i64) as i64 {
    if (adopt() == 0) { return 0; }
    if (may_start == 0) { return sys.E_NOENT; }
    return start();
}

// An endpoint to install at NET_FD in a child, or -1 when there is no network
// to give — which is not an error, and a spawner that treats it as one refuses
// to run programs that never wanted the network in the first place.
fn endpoint() as i64 {
    if (ready == 0) { return 0 - 1; }
    let is i64 as fd = nc.new_endpoint();
    if (fd < 0) { return 0 - 1; }
    return fd;
}
