// jobs.cst — the shell's job table.
//
// causticos has no signals, so a child's death is not something that interrupts
// the parent: it is a record the parent reads from an fd it subscribed to
// (SYS_EVENT_SUBSCRIBE). That fd sits in the same poll set as the keyboard and
// the children's output, so "a job finished" is just another readable event and
// the shell never blocks on wait() to find out.
//
// A job is a pipeline: several pids that live and die together. It is done when
// the LAST one exits — that is the process whose exit code the shell reports,
// the same rule every shell uses.
use "std/os/causticos.cst" as sys;
use "../crash/crash.cst" as crash;

// The table is reserved once for JOB_LIMIT jobs and committed JOB_CHUNK at a
// time as it fills: a shell pays for the jobs it has had at once, and the
// table never moves, so a *Job a caller holds stays good while others start.
// It was sixteen fixed slots — the most the 64 descriptors a process had
// could feed (three or four channels a job) — and a shell with a dozen
// background jobs refused the next command with "too many jobs". JOB_LIMIT
// is address space, not memory; descriptors and memory run out long before.
let is i64 as JOB_LIMIT with imut = 1024;
let is i64 as JOB_CHUNK with imut = 16;
let is i64 as MAX_PIDS with imut = 8;      // pids per pipeline
let is i64 as CMD_CAP  with imut = 64;     // command text kept for `jobs`
// Poll entries a shell needs besides its jobs' (the keyboard or the WM, exit
// events, a paste waiting to be read, the history thread's channel wanting
// room): see poll_buf.
let is i64 as POLL_FIXED with imut = 4;

// status
let is i64 as JOB_FREE with imut = 0;
let is i64 as JOB_RUN  with imut = 1;
let is i64 as JOB_DONE with imut = 2;

struct Job {
    status as i64;
    npids as i64;
    nlive as i64;          // pids not yet reaped
    bg as i64;             // 1 = started with '&'
    exit_code as i64;      // of the LAST pid in the pipeline
    cmd_len as i64;
    out_fd as i64;         // shell's read end of what goes to the terminal — the
                           // last stage's stdout and every stage's stderr — or -1
    in_fd as i64;          // shell's write end of its stdin, or -1
    aux_fd as i64;         // a third endpoint the shell chose to hand this job,
                           // or -1. The windowed shell uses it for the control
                           // channel a child asks for a new window on; the
                           // fullscreen one hands out no such thing. The library
                           // only promises to close it on release.
    reported as i64;       // 1 once "[n] Done" was shown (background only)
    tty_fd as i64;         // the shell's end of the TTY_FD channel handed to the
                           // stage whose stdout is the terminal (ttyproto), or -1
    tty_fill as i64;       // bytes of a request read so far (tty_acc)
    tty_catch as i64;      // ttyproto EV_* the program asked to get as events
                           // instead of being ended (Ctrl+C, the window closing)
    crashed as i64;        // 1 = a pid of it crashed; `crash` holds the first
    err_fd as i64;         // a job with no terminal ($(...)): its stages' stderr,
                           // kept apart from the stdout being captured; or -1
    pids as [8]i64;        // MAX_PIDS
    cmd as [64]u8;         // CMD_CAP
    tty_acc as [32]u8;     // a ttyproto request being read
    crash as [8]i64;       // WAIT_INFO_WORDS: how it crashed
}

let is i64 as tab with mut = 0;             // the reserved table
let is i64 as cap with mut = 0;             // jobs committed in it
let is i64 as pbuf with mut = 0;            // poll_buf, reserved likewise
let is i64 as pmap with mut = 0;            // poll_map
let is i64 as evfd with mut = 0 - 1;

fn event_fd() as i64 { return evfd; }
fn get(i as i64) as *Job { return cast(*Job, tab + i * sizeof(Job)); }
fn tty_acc(i as i64) as *u8 { return cast(*u8, &get(i).tty_acc[0]); }
// How many slots there are now — loops over the table go this far. It grows.
fn max_jobs() as i64 { return cap; }

// A poll set with room for every job's two fds plus POLL_FIXED more (3 i64 an
// entry), and beside it room to note which job each entry is (2 an entry
// per job). The shells build both each pass of their loop; they live here
// because they grow with the table.
fn poll_buf() as *i64 { return cast(*i64, pbuf); }
fn poll_map() as *i64 { return cast(*i64, pmap); }

fn _bytes(n as i64) as i64 { return ((n + 4095) / 4096) * 4096; }

// What poll_buf has committed for `c` slots — nothing before the first.
fn _poll_bytes(c as i64) as i64 {
    if (c == 0) { return 0; }
    return _bytes((POLL_FIXED + 2 * c) * 24);
}

// Commit JOB_CHUNK more slots, all free, and the poll room they need. 0, or
// -1 when the reservation is full or memory has run out.
fn _grow() as i64 {
    if (cap + JOB_CHUNK > JOB_LIMIT) { return 0 - 1; }
    let is i64 as ncap = cap + JOB_CHUNK;
    let is i64 as had = _bytes(cap * sizeof(Job));
    let is i64 as need = _bytes(ncap * sizeof(Job));
    let is i64 as rw = sys.PROT_READ | sys.PROT_WRITE;
    if (need > had && sys.commit(tab + had, need - had, rw) != 0) { return 0 - 1; }
    let is i64 as phad = _poll_bytes(cap);
    let is i64 as pneed = _poll_bytes(ncap);
    if (pneed > phad && sys.commit(pbuf + phad, pneed - phad, rw) != 0) { return 0 - 1; }
    let is i64 as mhad = _bytes(2 * cap * 8);
    let is i64 as mneed = _bytes(2 * ncap * 8);
    if (mneed > mhad && sys.commit(pmap + mhad, mneed - mhad, rw) != 0) { return 0 - 1; }
    let is i64 as i with mut = cap;
    while (i < ncap) {
        let is *Job as jb = get(i);
        jb.status = JOB_FREE;
        jb.out_fd = 0 - 1;
        jb.in_fd = 0 - 1;
        jb.aux_fd = 0 - 1;
        jb.tty_fd = 0 - 1;
        jb.err_fd = 0 - 1;
        jb.tty_fill = 0;
        jb.tty_catch = 0;
        i = i + 1;
    }
    cap = ncap;
    return 0;
}

// init — subscribe to our own children's lifecycle. A failure is not fatal: the
// shell falls back to reaping foreground jobs with wait(), it just cannot
// notice a background one finishing until then.
fn init() as i64 {
    let is i64 as rw = sys.PROT_READ | sys.PROT_WRITE;
    tab = sys.reserve(0, _bytes(JOB_LIMIT * sizeof(Job)), rw);
    pbuf = sys.reserve(0, _bytes((POLL_FIXED + 2 * JOB_LIMIT) * 24), rw);
    pmap = sys.reserve(0, _bytes(2 * JOB_LIMIT * 8), rw);
    if (tab <= 0 || pbuf <= 0 || pmap <= 0 || _grow() != 0) {
        // Without even the first slots a shell can run no command at all.
        sys.write_serial("jobs: no memory for the job table\n", 34);
        sys.exit(cast(i32, 1));
    }
    evfd = sys.event_subscribe(sys.getpid(), 0);
    return evfd;
}

fn alloc() as i64 {
    let is i64 as i with mut = 0;
    while (i < cap || (i == cap && _grow() == 0)) {
        let is *Job as jb = get(i);
        if (jb.status == JOB_FREE) {
            jb.npids = 0; jb.nlive = 0; jb.bg = 0;
            jb.exit_code = 0; jb.cmd_len = 0;
            jb.out_fd = 0 - 1; jb.in_fd = 0 - 1; jb.aux_fd = 0 - 1;
            jb.tty_fd = 0 - 1; jb.tty_fill = 0; jb.tty_catch = 0;
            jb.err_fd = 0 - 1;
            jb.reported = 0;
            jb.crashed = 0;
            jb.status = JOB_RUN;
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn add_pid(j as i64, pid as i64) as void {
    if (j < 0 || j >= cap) { return; }
    let is *Job as jb = get(j);
    if (jb.npids >= MAX_PIDS) { return; }
    jb.pids[jb.npids] = pid;
    jb.npids = jb.npids + 1;
    jb.nlive = jb.nlive + 1;
    return;
}

fn pid_at(j as i64, k as i64) as i64 { return get(j).pids[k]; }
fn last_pid(j as i64) as i64 {
    let is *Job as jb = get(j);
    if (jb.npids <= 0) { return 0; }
    return jb.pids[jb.npids - 1];
}

fn set_cmd(j as i64, src as *u8, len as i64) as void {
    let is i64 as n with mut = len;
    if (n > CMD_CAP) { n = CMD_CAP; }
    let is *Job as jb = get(j);
    let is i64 as i with mut = 0;
    while (i < n) { jb.cmd[i] = src[i]; i = i + 1; }
    jb.cmd_len = n;
    return;
}
fn cmd_ptr(j as i64) as *u8 { return cast(*u8, &get(j).cmd[0]); }

// crash_text — "prog: crashed: ..." for job j into out (no newline), or 0 when
// nothing in it crashed.
fn crash_text(j as i64, out as *u8, room as i64) as i64 {
    if (j < 0 || j >= cap || get(j).crashed != 1) { return 0; }
    return crash.describe(cast(*i64, &get(j).crash[0]), out, room);
}
fn cmd_len(j as i64) as i64 { return get(j).cmd_len; }

// find — which job owns `pid`? -1 when none does (a stranger's event, or an
// already-freed slot).
fn find(pid as i64) as i64 {
    let is i64 as j with mut = 0;
    while (j < cap) {
        if (get(j).status != JOB_FREE) {
            let is i64 as k with mut = 0;
            while (k < get(j).npids) {
                if (get(j).pids[k] == pid) { return j; }
                k = k + 1;
            }
        }
        j = j + 1;
    }
    return 0 - 1;
}

// poll_events — drain the subscription without blocking and mark what died.
// Returns how many jobs finished in this sweep. A 0-byte read means "nothing
// queued", never end-of-stream: the fd stays in the poll set for the next one.
fn poll_events() as i64 {
    if (evfd < 0) { return 0; }
    let is i64 as finished with mut = 0;
    let is [24]i64 as recs;                 // 8 records of {pid, kind, code}
    let is i64 as more with mut = 1;
    while (more == 1) {
        let is i64 as n = sys.read(evfd, cast(*u8, &recs[0]), 8 * 24);
        if (n < 24) { more = 0; }
        else {
            let is i64 as nrec = n / 24;
            let is i64 as i with mut = 0;
            while (i < nrec) {
                let is i64 as pid  = recs[i * 3 + 0];
                let is i64 as kind = recs[i * 3 + 1];
                let is i64 as code = recs[i * 3 + 2];
                if (kind == sys.EVENT_EXIT) {
                    let is i64 as j = find(pid);
                    if (j >= 0) {
                        // Reap it here: the event says it is a zombie, and the
                        // wait cannot block once that is true. A crash is kept
                        // for the shell to report — the first one, which is
                        // the one the rest of a pipeline died of.
                        let is *Job as jb = get(j);
                        let is [8]i64 as wi;
                        if (sys.wait_info(pid, &wi[0]) >= 0 && wi[1] == 1 && jb.crashed == 0) {
                            let is i64 as w with mut = 0;
                            while (w < sys.WAIT_INFO_WORDS) { jb.crash[w] = wi[w]; w = w + 1; }
                            jb.crashed = 1;
                        }
                        if (jb.nlive > 0) { jb.nlive = jb.nlive - 1; }
                        if (pid == last_pid(j)) { jb.exit_code = code; }
                        if (jb.nlive == 0) {
                            jb.status = JOB_DONE;
                            finished = finished + 1;
                        }
                    }
                }
                i = i + 1;
            }
            if (n < 8 * 24) { more = 0; }
        }
    }
    return finished;
}

// release — close what the job held and free the slot. A job used to also carry
// the spawned image's mapping, because the shell read every program into its own
// memory to hand spawn the bytes and could not drop that buffer until the child
// was reaped. A spawn names its source now, so there is nothing left to hold.
fn release(j as i64) as void {
    if (j < 0 || j >= cap) { return; }
    let is *Job as jb = get(j);
    if (jb.out_fd >= 0) { sys.close(jb.out_fd); jb.out_fd = 0 - 1; }
    if (jb.in_fd >= 0)  { sys.close(jb.in_fd);  jb.in_fd = 0 - 1; }
    if (jb.aux_fd >= 0) { sys.close(jb.aux_fd); jb.aux_fd = 0 - 1; }
    if (jb.tty_fd >= 0) { sys.close(jb.tty_fd); jb.tty_fd = 0 - 1; }
    if (jb.err_fd >= 0) { sys.close(jb.err_fd); jb.err_fd = 0 - 1; }
    jb.status = JOB_FREE;
    return;
}

// kill_job — end every pid still live. The shell spawned them and holds the
// only keys to them, so nobody else can.
fn kill_job(j as i64) as void {
    if (j < 0 || j >= cap || get(j).status != JOB_RUN) { return; }
    let is i64 as k with mut = 0;
    while (k < get(j).npids) { sys.kill(get(j).pids[k]); k = k + 1; }
    return;
}

// parse_pct — "%3" -> job index 2. Returns -1 when the token is not a job spec
// or names a slot that is not running.
fn parse_pct(tok as *u8, len as i64) as i64 {
    if (len < 2 || tok[0] != cast(u8, 37)) { return 0 - 1; }      // '%'
    let is i64 as v with mut = 0;
    let is i64 as i with mut = 1;
    while (i < len) {
        let is i64 as c = cast(i64, tok[i]);
        if (c < 48 || c > 57) { return 0 - 1; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    if (v < 1 || v > cap) { return 0 - 1; }
    if (get(v - 1).status == JOB_FREE) { return 0 - 1; }
    return v - 1;
}

// parse_pid — "42" -> 42. -1 when the token is not a plain number.
fn parse_pid(tok as *u8, len as i64) as i64 {
    if (len < 1 || len > 18) { return 0 - 1; }
    let is i64 as v with mut = 0;
    let is i64 as i with mut = 0;
    while (i < len) {
        let is i64 as c = cast(i64, tok[i]);
        if (c < 48 || c > 57) { return 0 - 1; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    if (v <= 0) { return 0 - 1; }
    return v;
}

// n_running — how many jobs are still alive (the shell asks before it lets the
// window close, and to decide whether it has anything to poll).
fn n_running() as i64 {
    let is i64 as n with mut = 0;
    let is i64 as j with mut = 0;
    while (j < cap) {
        if (get(j).status == JOB_RUN) { n = n + 1; }
        j = j + 1;
    }
    return n;
}
