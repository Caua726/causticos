// bezier.cst — cubic Bezier easing curves baked into integer LUTs.
//
// A curve is P0=(0,0), P1=(c1x,c1y), P2=(c2x,c2y), P3=(1,1), the CSS
// timing-function shape. x is TIME, y is the eased output. The bake walks t
// forward, evaluates (Bx(t), By(t)), and fills LUT[x] by interpolating between
// consecutive samples — the honest reparameterisation. (Sampling y at uniform t
// and indexing that by x, which looks equivalent, skews every non-linear curve:
// x advances at its own rate.)
//
// Fixed point throughout, like the rest of this project: control points and the
// internal t are in units of ONE; the baked output is 0..256 so a caller lerps
// with `from + (to - from) * y / 256`.

let is i64 as ONE     with imut = 4096;   // fixed-point 1.0 for control points / t
let is i64 as SAMPLES with imut = 512;    // t samples per bake
let is i64 as LUT_N   with imut = 256;    // LUT entries per curve (x = 0..255)
let is i64 as NCURVES with imut = 5;

let is i64 as LINEAR      with imut = 0;
let is i64 as EASE        with imut = 1;
let is i64 as EASE_IN     with imut = 2;
let is i64 as EASE_OUT    with imut = 3;
let is i64 as EASE_IN_OUT with imut = 4;

let is [1280]i64 as baked with mut;       // NCURVES * LUT_N
let is i64 as ready with mut = 0;

// One axis of the cubic: B(t) = 3(1-t)^2*t*c1 + 3(1-t)*t^2*c2 + t^3, every term
// carrying ONE^3 so a single divide lands back in [0, ONE]. Peak magnitude is
// 3*ONE^4 = 8.4e14, comfortably inside i64.
fn _axis(t as i64, c1 as i64, c2 as i64) as i64 {
    let is i64 as omt = ONE - t;
    let is i64 as a = 3 * omt * omt * t * c1;
    let is i64 as b = 3 * omt * t * t * c2;
    let is i64 as c = t * t * t * ONE;
    return (a + b + c) / (ONE * ONE * ONE);
}

fn setup(id as i64, c1x as i64, c1y as i64, c2x as i64, c2y as i64) as void {
    if (id < 0 || id >= NCURVES) { return; }
    let is i64 as base = id * LUT_N;
    let is i64 as span = LUT_N - 1;
    baked[base] = 0;
    let is i64 as xi with mut = 1;
    let is i64 as px with mut = 0;
    let is i64 as py with mut = 0;
    let is i64 as i with mut = 1;
    while (i <= SAMPLES && xi < LUT_N) {
        let is i64 as t = i * ONE / SAMPLES;
        let is i64 as cx = _axis(t, c1x, c2x);
        let is i64 as cy = _axis(t, c1y, c2y);
        while (xi < LUT_N && xi * ONE / span <= cx) {
            let is i64 as tx = xi * ONE / span;
            let is i64 as y with mut = py;
            if (cx > px) { y = py + (cy - py) * (tx - px) / (cx - px); }
            baked[base + xi] = y * 256 / ONE;
            xi = xi + 1;
        }
        px = cx; py = cy;
        i = i + 1;
    }
    // Control points inside the unit square cannot leave x short of 1.0, but a
    // rounding shortfall on the last entry would read as a stalled animation.
    while (xi < LUT_N) { baked[base + xi] = 256; xi = xi + 1; }
    return;
}

// The five named curves, control points as CSS defines them (x4096).
fn init() as void {
    if (ready == 1) { return; }
    setup(LINEAR,      1365, 1365, 2731, 2731);   // (1/3,1/3,2/3,2/3) = y = x
    setup(EASE,        1024,  410, 1024, 4096);   // (.25,.1,.25,1)
    setup(EASE_IN,     1720,    0, 4096, 4096);   // (.42,0,1,1)
    setup(EASE_OUT,       0,    0, 2376, 4096);   // (0,0,.58,1)
    setup(EASE_IN_OUT, 1720,    0, 2376, 4096);   // (.42,0,.58,1)
    ready = 1;
    return;
}

// get_y — eased output (0..256) for a time fraction x256 (0..255).
fn get_y(id as i64, x256 as i64) as i64 {
    if (x256 <= 0) { return 0; }
    if (x256 >= 255) { return 256; }
    if (id < 0 || id >= NCURVES) { return x256 * 256 / 255; }
    return baked[id * LUT_N + x256];
}

// lerp — interpolate from..to at eased fraction y256 (0..256).
fn lerp(from_v as i64, to_v as i64, y256 as i64) as i64 {
    return from_v + (to_v - from_v) * y256 / 256;
}
