// proclist.cst — the kernel's process list (SYS_PROC_LIST), however long.
//
// The kernel says how many there are; a snapshot whose array turned out too
// small is taken again in one with room for all. ps, top, htop and btop each
// read 64 entries into an array on the stack, and every process past the
// 64th was missing from all of them. A record is W i64 — the ProcInfo comment
// in kernel/abi.cst says what each word holds; the F_ names below index it.
use "std/os/causticos.cst" as sys;

let is i64 as W         with imut = sys.PROC_INFO_WORDS;
let is i64 as F_PID     with imut = 0;
let is i64 as F_PPID    with imut = 1;
let is i64 as F_STATE   with imut = 2;    // 1 alive, 2 exiting, 3 zombie
let is i64 as F_EXIT    with imut = 3;
let is i64 as F_THREADS with imut = 4;
let is i64 as F_RSS     with imut = 5;
let is i64 as F_NAME    with imut = 6;    // 16 bytes, words 6-7
let is i64 as F_CPU     with imut = 8;    // cumulative ns
let is i64 as F_RUNNING with imut = 9;    // threads on a cpu or ready for one

struct Snap { va as i64; cap as i64; n as i64; }

// Into s, every process (the kernel's row first): s.n records. 0, or an errno.
fn take(s as *Snap) as i64 {
    while (1 == 1) {
        let is i64 as total = sys.proc_list(cast(*i64, s.va), s.cap);
        if (total < 0) { return total; }
        if (total <= s.cap) { s.n = total; return 0; }
        // Room for these and some that may start before the next look.
        let is i64 as nc = total + total / 4 + 8;
        let is i64 as va = sys.mmap(0, nc * W * 8, sys.PROT_READ | sys.PROT_WRITE);
        if (va < 0) { return va; }
        if (s.cap > 0) { sys.munmap(s.va, s.cap * W * 8); }
        s.va = va; s.cap = nc;
    }
    return 0;
}

fn rec(s as *Snap, i as i64) as *i64 { return cast(*i64, s.va + i * W * 8); }
fn name(s as *Snap, i as i64) as *u8 { return cast(*u8, s.va + (i * W + F_NAME) * 8); }

// What the process is doing, as ps says it: "run" while a thread of it is on
// a cpu or waiting for one, "sleep" while every one waits on something (a
// key, a timer, a pipe), "exiting", "zombie" (ended, not yet collected).
fn state_name(r as *i64) as *u8 {
    let is i64 as st = r[F_STATE];
    if (st == 1) { if (r[F_RUNNING] > 0) { return "run"; } return "sleep"; }
    if (st == 2) { return "exiting"; }
    if (st == 3) { return "zombie"; }
    return "?";
}
// The same as one letter, as top and htop show it: R S E Z.
fn state_letter(r as *i64) as i64 {
    let is i64 as st = r[F_STATE];
    if (st == 1) { if (r[F_RUNNING] > 0) { return 82; } return 83; }
    if (st == 2) { return 69; }
    if (st == 3) { return 90; }
    return 63;
}
