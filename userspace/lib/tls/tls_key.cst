// tls_key — the TLS 1.3 key schedule, and the AEAD it feeds.
//
// RFC 8446 §7.1 draws the schedule as a ladder: a secret goes in at the top,
// each rung derives the next, and every traffic key hangs off one of them. The
// shape matters more than any individual step, because the property it buys is
// that a key compromised at one rung says nothing about the rungs above it.
//
//              0
//              |
//    PSK ---> HKDF-Extract = Early Secret
//              |
//        Derive-Secret(., "derived", "")
//              |
//  (EC)DHE -> HKDF-Extract = Handshake Secret
//              |  +--> "c hs traffic"   client handshake traffic secret
//              |  +--> "s hs traffic"   server handshake traffic secret
//        Derive-Secret(., "derived", "")
//              |
//      0 ---> HKDF-Extract = Master Secret
//                 +--> "c ap traffic"   client application traffic secret
//                 +--> "s ap traffic"   server application traffic secret
//
// No PSK and no early data here, so the top of the ladder is extract(0, 0) —
// a constant. It is still computed rather than written down: the constant
// depends on the hash, and a hard-coded one would be silently wrong the day a
// SHA-384 suite is negotiated.
//
// THE TRANSCRIPT IS BUFFERED WHOLE rather than hashed incrementally. Every
// Derive-Secret takes the hash of the handshake SO FAR, at four different
// points, and CertificateVerify needs a fifth. Keeping the bytes and hashing a
// prefix on demand is a few kilobytes and no bookkeeping; checkpointing a
// running hash is no memory and a great deal of bookkeeping, and getting one
// checkpoint wrong produces a handshake that fails with "decrypt error" and
// nothing else to go on.

use "caustic-crypto/hash/sha2.cst" as sha2;
use "caustic-crypto/mac/hmac.cst" as hmac;
use "caustic-crypto/kdf/hkdf.cst" as hkdf;
use "caustic-crypto/sym/aes.cst" as aes;
use "caustic-crypto/sym/aes_modes.cst" as aesm;
use "caustic-crypto/sym/chachapoly.cst" as ccp;

// The three suites RFC 8446 §B.4 defines that anyone actually offers.
// TLS_AES_128_GCM_SHA256 is mandatory to implement (§9.1): without it a
// conforming server is allowed to refuse us.
let is i64 as TLS_AES_128_GCM_SHA256       with imut = 0x1301;
let is i64 as TLS_AES_256_GCM_SHA384       with imut = 0x1302;
let is i64 as TLS_CHACHA20_POLY1305_SHA256 with imut = 0x1303;

fn suite_hash_len(suite as i64) as i64 {
    if (suite == TLS_AES_256_GCM_SHA384) { return 48; }
    return 32;
}

fn suite_key_len(suite as i64) as i64 {
    if (suite == TLS_AES_128_GCM_SHA256) { return 16; }
    return 32;
}

fn suite_iv_len(suite as i64) as i64 { return 12; }

fn suite_ok(suite as i64) as i64 {
    if (suite == TLS_AES_128_GCM_SHA256) { return 1; }
    if (suite == TLS_AES_256_GCM_SHA384) { return 1; }
    if (suite == TLS_CHACHA20_POLY1305_SHA256) { return 1; }
    return 0;
}

fn alg_of(suite as i64) as hmac.HashAlg {
    if (suite == TLS_AES_256_GCM_SHA384) { return hmac.alg_sha384(); }
    return hmac.alg_sha256();
}

fn transcript_hash(suite as i64, msgs as *u8, len as i64, out as *u8) as void {
    if (suite == TLS_AES_256_GCM_SHA384) { sha2.sha384(msgs, len, out); }
    else { sha2.sha256(msgs, len, out); }
    return;
}

// HKDF-Expand-Label (RFC 8446 §7.1):
//
//   struct { uint16 length; opaque label<7..255>; opaque context<0..255>; }
//
// where the label on the wire is "tls13 " followed by the short name. The
// prefix is what keeps a TLS 1.3 key schedule from ever colliding with some
// other protocol that also uses HKDF with the same secret.
fn expand_label(suite as i64, secret as *u8, seclen as i64,
                label as *u8, llen as i64,
                ctx as *u8, clen as i64,
                out as *u8, outlen as i64) as i64 {
    let is [512]u8 as info;
    if (llen + 6 > 255 || clen > 255) { return 0 - 1; }
    if (llen + clen + 16 > 512) { return 0 - 1; }
    let is i64 as p with mut = 0;
    info[0] = cast(u8, (outlen >> 8) & 0xFF);
    info[1] = cast(u8, outlen & 0xFF);
    p = 2;
    info[p] = cast(u8, 6 + llen); p = p + 1;
    let is *u8 as pre = "tls13 ";
    let is i64 as i with mut = 0;
    while (i < 6) { info[p] = pre[i]; p = p + 1; i = i + 1; }
    i = 0;
    while (i < llen) { info[p] = label[i]; p = p + 1; i = i + 1; }
    info[p] = cast(u8, clen); p = p + 1;
    i = 0;
    while (i < clen) { info[p] = ctx[i]; p = p + 1; i = i + 1; }

    let is hmac.HashAlg as a = alg_of(suite);
    hkdf.hkdf_expand(&a, secret, seclen, cast(*u8, &info[0]), p, out, outlen);
    return 0;
}

// Derive-Secret(Secret, Label, Messages) — Expand-Label with the transcript
// hash as the context.
fn derive_secret(suite as i64, secret as *u8, seclen as i64,
                 label as *u8, llen as i64,
                 msgs as *u8, msglen as i64, out as *u8) as i64 {
    let is i64 as hl = suite_hash_len(suite);
    let is [64]u8 as th;
    transcript_hash(suite, msgs, msglen, cast(*u8, &th[0]));
    return expand_label(suite, secret, seclen, label, llen,
                        cast(*u8, &th[0]), hl, out, hl);
}

fn extract(suite as i64, salt as *u8, saltlen as i64,
           ikm as *u8, ikmlen as i64, out as *u8) as void {
    let is hmac.HashAlg as a = alg_of(suite);
    hkdf.hkdf_extract(&a, salt, saltlen, ikm, ikmlen, out);
    return;
}

// The traffic key and IV that hang off one secret.
fn traffic_keys(suite as i64, secret as *u8,
                key as *u8, iv as *u8) as void {
    let is i64 as hl = suite_hash_len(suite);
    expand_label(suite, secret, hl, cast(*u8, "key"), 3,
                 cast(*u8, ""), 0, key, suite_key_len(suite));
    expand_label(suite, secret, hl, cast(*u8, "iv"), 2,
                 cast(*u8, ""), 0, iv, suite_iv_len(suite));
    return;
}

// verify_data for a Finished message: HMAC over the transcript hash, keyed by
// a value derived from the traffic secret. It is what proves the peer holds
// the same keys AND saw the same handshake — a man in the middle who altered
// one byte of one extension cannot produce it.
fn finished_mac(suite as i64, base_secret as *u8,
                msgs as *u8, msglen as i64, out as *u8) as void {
    let is i64 as hl = suite_hash_len(suite);
    let is [64]u8 as fkey;
    expand_label(suite, base_secret, hl, cast(*u8, "finished"), 8,
                 cast(*u8, ""), 0, cast(*u8, &fkey[0]), hl);
    let is [64]u8 as th;
    transcript_hash(suite, msgs, msglen, cast(*u8, &th[0]));
    let is hmac.HashAlg as a = alg_of(suite);
    hmac.hmac(&a, cast(*u8, &fkey[0]), hl, cast(*u8, &th[0]), hl, out);
    return;
}

// ============================================================
// The record AEAD
// ============================================================

// The per-record nonce: the static IV with the sequence number exclusive-ored
// into its last eight bytes (RFC 8446 §5.3). Not a counter appended to a salt
// — that was TLS 1.2, and the difference is why a 1.3 record leaks nothing
// about how many came before it.
fn record_nonce(iv as *u8, ivlen as i64, seq as i64, out as *u8) as void {
    let is i64 as i with mut = 0;
    while (i < ivlen) { out[i] = iv[i]; i = i + 1; }
    i = 0;
    while (i < 8) {
        let is i64 as shift = (7 - i) * 8;
        let is i64 as b = (seq >> shift) & 0xFF;
        let is i64 as at = ivlen - 8 + i;
        out[at] = cast(u8, cast(i64, out[at]) ^ b);
        i = i + 1;
    }
    return;
}

fn seal(suite as i64, key as *u8, nonce as *u8,
        aad as *u8, aadlen as i64,
        pt as *u8, ptlen as i64, ct as *u8, tag as *u8) as void {
    if (suite == TLS_CHACHA20_POLY1305_SHA256) {
        ccp.chachapoly_seal(key, nonce, aad, aadlen, pt, ptlen, ct, tag);
        return;
    }
    let is aes.Aes as a;
    aes.aes_init(&a, key, suite_key_len(suite));
    aesm.aes_gcm_seal(&a, nonce, 12, aad, aadlen, pt, ptlen, ct, tag);
    return;
}

fn open(suite as i64, key as *u8, nonce as *u8,
        aad as *u8, aadlen as i64,
        ct as *u8, ctlen as i64, tag as *u8, pt as *u8) as i64 {
    if (suite == TLS_CHACHA20_POLY1305_SHA256) {
        return ccp.chachapoly_open(key, nonce, aad, aadlen, ct, ctlen, tag, pt);
    }
    let is aes.Aes as a;
    aes.aes_init(&a, key, suite_key_len(suite));
    return aesm.aes_gcm_open(&a, nonce, 12, aad, aadlen, ct, ctlen, tag, pt);
}
