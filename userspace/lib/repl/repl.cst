// repl.cst — the line editor every causticos shell shares: the edit buffer,
// the history ring, recall, and tab completion.
//
// causticos has two shells — the fullscreen one that owns the framebuffer and
// the keyboard, and the windowed wterm that receives keys from the WM — and
// they had byte-for-byte copies of all of this. A fix landed in one and not the
// other every time.
//
// State is per instance (a *Repl the caller owns), never module globals: the
// library must not decide that a process has exactly one line being edited.
// Echo goes through term.putc, which both shells have; the caller flushes,
// because only it knows whether that means term.flush or a grid commit.
//
// The line is UTF-8. The cursor is a byte offset that is always on a
// character's first byte, and every edit moves by whole characters: a key that
// typed "ç" is one character to Backspace over, not two bytes, the second of
// which would leave half of it behind.
use "std/causticos/term.cst" as term;
use "std/os/causticos.cst" as sys;
use "std/unicode/utf8.cst" as utf8;
use "std/unicode/cpwidth.cst" as cpw;

let is i64 as LINE_CAP with imut = 256;
let is i64 as HIST_N   with imut = 16;
let is i64 as MAX_ARGS with imut = 16;

struct Repl {
    hhead as i64;              // next history slot to write
    hsize as i64;              // slots filled, <= HIST_N
    hnav as i64;               // 0 = editing fresh, 1..hsize = walking back
    llen as i64;               // bytes in `line`
    cur as i64;                // cursor, 0..llen, on a character's first byte — edits happen HERE
    npush as i64;              // total pushes, monotonic
    npush_load as i64;         // npush when the file was last read/written
    khead as i64;              // kill ring: next slot to write
    ksize as i64;              // kill ring: entries stored
    knav as i64;               // how far back the last yank reached
    above as i64;              // cells of the line above the top row, past the cursor (see _goto)
    shown_len as i64;          // what is on screen from the line's start: the cells it covers...
    shown_cur as i64;          // ...and the cell the cursor is on
    srch as i64;               // 1 = a Ctrl+R search is running
    sqlen as i64;              // bytes in `sq`
    shit as i64;               // history age (1 = newest) of the line found, 0 = none
    sfail as i64;              // 1 = the query is in no line from there back
    sllen as i64;              // the line as it was when the search began
    slcur as i64;
    hlen as [16]i64;
    hbuf as [4096]u8;          // HIST_N * LINE_CAP
    line as [256]u8;
    klen as [8]i64;
    kbuf as [2048]u8;          // KILL_N * LINE_CAP
    sq as [64]u8;              // the search query
    sline as [256]u8;
}

let is i64 as SQ_CAP with imut = 64;

let is i64 as KILL_N with imut = 8;

fn init(r as *Repl) as void {
    r.hhead = 0; r.hsize = 0; r.hnav = 0; r.llen = 0; r.cur = 0;
    r.npush = 0; r.npush_load = 0;
    r.khead = 0; r.ksize = 0; r.knav = 0;
    r.above = 0;
    r.shown_len = 0; r.shown_cur = 0;
    r.srch = 0; r.sqlen = 0; r.shit = 0; r.sfail = 0; r.sllen = 0; r.slcur = 0;
    let is i64 as i with mut = 0;
    while (i < HIST_N) { r.hlen[i] = 0; i = i + 1; }
    i = 0;
    while (i < KILL_N) { r.klen[i] = 0; i = i + 1; }
    return;
}

fn line_ptr(r as *Repl) as *u8 { return cast(*u8, &r.line[0]); }
fn line_len(r as *Repl) as i64 { return r.llen; }
// A fresh line, after the caller has put up a new prompt: nothing of it is on
// screen yet.
fn line_clear(r as *Repl) as void {
    r.llen = 0; r.cur = 0; r.hnav = 0; r.knav = 0; r.above = 0;
    r.shown_len = 0; r.shown_cur = 0;
    r.srch = 0;
    return;
}

// ---- editing ---------------------------------------------------------------
//
// The line is edited at the CURSOR, not only at the end, which means the screen
// can no longer be kept in step with a single putc per keystroke. `redraw`
// repaints from wherever the cursor was: back to where the line starts, print
// the line, blank whatever the line used to be longer by, then back to the new
// cursor. It is the only thing that writes the line, so every edit is
// automatically consistent with what is on screen.
//
// A line wider than the terminal wraps onto the rows below, so "n characters
// back" can be rows up, not n columns left. Going back with "cursor left" (it
// stops at column 0) reprinted the whole line from the start of the row it had
// wrapped onto: every key typed past the edge added another copy of the line.
// A cell is one linear index, row * cols + col, and offset k of the line is
// the start's index plus k. When a row fills, the terminal leaves the wrap
// pending with the cursor still on the last column (term.cst); the cursor is
// then one past that cell, the first of the next row, which is what _here
// says.
// Moves are always taken from where the cursor IS: printing on the last row
// scrolls, and every row on screen moves up with it.
//
// In a window too small for the line, its start scrolls off the top. Those
// cells cannot be shown, and a move to one parks the cursor at the top-left
// with `above` counting how far beyond it the cursor really is — so the next
// redraw still knows where every offset of the line falls, and prints from the
// first cell that shows.

fn _csi(t as *term.Term, n as i64, final as i64) as void {
    term.putc(t, 0x1B); term.putc(t, 0x5B);        // ESC [
    let is i64 as x with mut = n;
    let is [20]u8 as d;
    let is i64 as i with mut = 20;
    if (x <= 0) { i = i - 1; d[i] = cast(u8, 48); }
    while (x > 0) { i = i - 1; d[i] = cast(u8, 48 + (x % 10)); x = x / 10; }
    while (i < 20) { term.putc(t, cast(i64, d[i])); i = i + 1; }
    term.putc(t, final);
    return;
}

// Where the cursor is, as a linear index — negative while it is parked for a
// cell above the top row.
fn _here(r as *Repl, t as *term.Term) as i64 {
    return t.cy * t.cols + t.cx + t.wrap_pend - r.above;
}

// _park — set how far above the top-left the cursor really is. A parked cursor
// is hidden: drawn at the top-left it would point at the wrong character.
fn _park(r as *Repl, t as *term.Term, n as i64) as void {
    let is i64 as was = r.above;
    r.above = n;
    if (was == 0 && n > 0) {
        term.putc(t, 0x1B); term.putc(t, 0x5B); term.putc(t, 0x3F);   // ESC [ ?
        term.putc(t, 0x32); term.putc(t, 0x35); term.putc(t, 0x6C);    // 25l
    }
    if (was > 0 && n == 0) {
        term.putc(t, 0x1B); term.putc(t, 0x5B); term.putc(t, 0x3F);   // ESC [ ?
        term.putc(t, 0x32); term.putc(t, 0x35); term.putc(t, 0x68);    // 25h
    }
    return;
}

// Put the cursor on linear index `to`, parking it at the top-left if that cell
// has scrolled off.
fn _goto(r as *Repl, t as *term.Term, to as i64) as void {
    if (t.cols <= 0) { return; }
    // Already there. Moving would drop a pending wrap — and the cell past the
    // bottom-right one cannot be moved to, only printed into.
    if (to == _here(r, t)) { return; }
    let is i64 as dst with mut = to;
    let is i64 as hidden with mut = 0;
    if (dst < 0) { hidden = 0 - dst; dst = 0; }
    let is i64 as row = dst / t.cols;
    let is i64 as col = dst % t.cols;
    if (row < t.cy) { _csi(t, t.cy - row, 0x41); }        // 'A' up
    if (row > t.cy) { _csi(t, row - t.cy, 0x42); }        // 'B' down
    // A pending wrap leaves the cursor ON the cell `col` may name: the move is
    // made anyway, since a move is what drops the pending wrap.
    if (col != t.cx || t.wrap_pend == 1) { _csi(t, col + 1, 0x47); }   // 'G' column
    _park(r, t, hidden);
    return;
}

// ---- where characters land ---------------------------------------------------
//
// A byte is not a cell. "é" is two bytes in one cell, a combining mark is a
// character in no cell of its own, and a wide character (CJK, most emoji) takes
// two — and when only the last column of a row is left it does not fit, so
// term.cst leaves that column empty and starts it on the next row. Where the
// line's characters land is therefore worked out the way the terminal will
// place them, from the column the line starts on: these two functions are the
// only place that knows, and they follow term.cst's putc and _put_cp exactly,
// down to what it draws for bytes that are not UTF-8.

// The character at buf[i]: writes its code point to cp, returns the bytes it
// takes. Broken UTF-8 reads as term.cst draws it: U+FFFD, for one byte, or for
// the lead and the continuations that came before the sequence broke.
fn _decode(buf as *u8, len as i64, i as i64, cp as *i64) as i64 {
    let is i64 as b = cast(i64, buf[i]);
    cp[0] = 0xFFFD;
    if (b < 0x80) { cp[0] = b; return 1; }
    let is i64 as need with mut = 0;
    let is i64 as v with mut = 0;
    let is i64 as min with mut = 0;
    if (b >= 0xC2 && b <= 0xDF) { need = 1; v = b & 0x1F; min = 0x80; }
    if (b >= 0xE0 && b <= 0xEF) { need = 2; v = b & 0x0F; min = 0x800; }
    if (b >= 0xF0 && b <= 0xF4) { need = 3; v = b & 0x07; min = 0x10000; }
    if (need == 0) { return 1; }
    let is i64 as k with mut = 1;
    while (k <= need) {
        if (i + k >= len) { return k; }
        let is i64 as c = cast(i64, buf[i + k]);
        if ((c & 0xC0) != 0x80) { return k; }
        v = (v << 6) | (c & 0x3F);
        k = k + 1;
    }
    if (v >= min && v <= 0x10FFFF && (v < 0xD800 || v > 0xDFFF)) { cp[0] = v; }
    return k;
}

// Place the character at buf[i], the cells before it holding `pos` cells of
// the line, on a terminal `cols` wide where the line starts at column col0:
// at[0] = the cell it starts on, w[0] = how many it covers. Returns its bytes.
fn _place(buf as *u8, len as i64, i as i64, pos as i64, col0 as i64, cols as i64,
          at as *i64, w as *i64) as i64 {
    let is [1]i64 as cp;
    let is i64 as n = _decode(buf, len, i, cast(*i64, &cp[0]));
    let is i64 as cw with mut = cpw.cp_width(cast(i32, cp[0]));
    if (cp[0] >= 0x80 && cp[0] <= 0x9F) { cw = 0; }          // C1 controls draw nothing
    if (cw == 2 && cols < 2) { cw = 1; }
    let is i64 as p with mut = pos;
    if (cw == 2 && (col0 + p) % cols == cols - 1) { p = p + 1; }   // wraps whole
    at[0] = p;
    w[0] = cw;
    return n;
}

// The first byte of the character after the one at i.
fn _next(buf as *u8, len as i64, i as i64) as i64 {
    if (i >= len) { return len; }
    let is [1]i64 as cp;
    return i + _decode(buf, len, i, cast(*i64, &cp[0]));
}

// The first byte of the character before offset i.
fn _prev(buf as *u8, i as i64) as i64 {
    if (i <= 0) { return 0; }
    let is i64 as j with mut = i - 1;
    let is i64 as k with mut = 0;
    while (j > 0 && k < 3 && (cast(i64, buf[j]) & 0xC0) == 0x80) { j = j - 1; k = k + 1; }
    // j is a lead only if what follows it really is its sequence; else the
    // byte before i stands alone (term.cst draws it as U+FFFD by itself).
    if (_next(buf, i, j) == i) { return j; }
    return i - 1;
}

// How much of src[0..n] fits in cap bytes without cutting a character.
fn _fit(src as *u8, n as i64, cap as i64) as i64 {
    if (n <= cap) { return n; }
    let is i64 as k with mut = cap;
    while (k > 0 && (cast(i64, src[k]) & 0xC0) == 0x80) { k = k - 1; }
    return k;
}

fn _mod(a as i64, m as i64) as i64 {
    let is i64 as x = a % m;
    if (x < 0) { return x + m; }
    return x;
}

// _paint — make the screen show buf[0..len] from the line's start, with the
// cursor before the character at byte `cur`, over whatever was shown there
// before.
fn _paint(r as *Repl, t as *term.Term, buf as *u8, len as i64, cur as i64) as void {
    let is i64 as cols = t.cols;
    if (cols <= 0) { return; }
    let is i64 as start = _here(r, t) - r.shown_cur;       // the cell the line starts on
    let is i64 as col0 = _mod(start, cols);
    let is [1]i64 as at;
    let is [1]i64 as w;
    let is i64 as pos with mut = 0;                         // cells before character i
    let is i64 as curcell with mut = 0 - 1;
    let is i64 as first with mut = 0 - 1;                   // first character on screen
    let is i64 as firstcell with mut = 0;
    let is i64 as i with mut = 0;
    while (i < len) {
        let is i64 as n = _place(buf, len, i, pos, col0, cols, cast(*i64, &at[0]), cast(*i64, &w[0]));
        if (i == cur) { curcell = at[0]; }
        if (first < 0 && start + at[0] >= 0) { first = i; firstcell = at[0]; }
        pos = at[0] + w[0];
        i = i + n;
    }
    if (curcell < 0) { curcell = pos; }
    if (first < 0) { first = len; firstcell = pos; }
    _goto(r, t, start + firstcell);
    i = first;
    while (i < len) { term.putc(t, cast(i64, buf[i])); i = i + 1; }
    // Blank whatever was shown longer than this.
    let is i64 as end with mut = pos;
    while (end < r.shown_len) { term.putc(t, 0x20); end = end + 1; }
    _goto(r, t, _here(r, t) - (end - curcell));
    r.shown_len = pos;
    r.shown_cur = curcell;
    return;
}

// redraw — the screen brought in step with the line after an edit. The repl
// keeps what it last put there (shown_len/shown_cur), so callers do not have
// to remember what the line was before they changed it.
fn redraw(r as *Repl, t as *term.Term) as void {
    if (r.srch == 1) { _paint_search(r, t); return; }
    _paint(r, t, cast(*u8, &r.line[0]), r.llen, r.cur);
    return;
}

// finish — leave the line: the cursor on a fresh row below it. Whatever comes
// next (a command's output after Enter, a background job's notice) has to start
// there; from the cursor it would land on the line's own wrapped rows. A line
// that ends exactly at the right edge has already wrapped, and a newline on top
// of that would leave an empty row.
fn finish(r as *Repl, t as *term.Term) as void {
    _to_end(r, t);
    term.putc(t, 0x0A);
    r.shown_len = 0; r.shown_cur = 0;
    return;
}

// _to_end — the cursor just past what is shown, exactly where printing it left
// the cursor: when it ended on the right edge that is the edge with the wrap
// pending, a place no cursor move can reach (at the bottom row the next row
// does not exist yet). So the cursor goes onto the last character shown and
// prints it again — all of it: a wide one from its first cell, with the marks
// that combined into it after it.
fn _to_end(r as *Repl, t as *term.Term) as void {
    let is i64 as end = _here(r, t) + (r.shown_len - r.shown_cur);
    // Even when the cursor is already at `end`: after an edit it may sit at
    // the start of the next row instead of pending on the edge, and a newline
    // from there would leave an empty row under the line.
    if (r.shown_len == 0) { _goto(r, t, end); _park(r, t, 0); return; }
    // The last character that takes cells, and how many.
    let is [1]i64 as at;
    let is [1]i64 as w;
    let is i64 as last with mut = 0 - 1;
    let is i64 as lw with mut = 1;
    let is i64 as i with mut = 0;
    while (i < r.llen) {
        let is i64 as n = _place(cast(*u8, &r.line[0]), r.llen, i, 0, 0, 1 << 30,
                                 cast(*i64, &at[0]), cast(*i64, &w[0]));
        if (w[0] > 0) { last = i; lw = w[0]; }
        i = i + n;
    }
    if (last < 0) {                                 // only a search line shows no character: it ends in "': "
        _goto(r, t, end - 1);
        _park(r, t, 0);
        term.putc(t, 32);
        return;
    }
    _goto(r, t, end - lw);
    _park(r, t, 0);
    i = last;
    while (i < r.llen) { term.putc(t, cast(i64, r.line[i])); i = i + 1; }
    return;
}

// lift — take the line off the screen: its cells blanked, the cursor where it
// starts. For a change the line cannot follow by itself — the terminal being
// resized, which re-lays rows out but does not re-wrap them; reprint puts it
// back, wrapped to the new width.
fn lift(r as *Repl, t as *term.Term) as void {
    _paint(r, t, cast(*u8, &r.line[0]), 0, 0);
    return;
}

// reprint — the line again, from where the cursor is (a fresh prompt), with the
// cursor where it was in it.
fn reprint(r as *Repl, t as *term.Term) as void {
    _park(r, t, 0);
    r.shown_len = 0; r.shown_cur = 0;
    redraw(r, t);
    return;
}

// ---- reverse search (Ctrl+R) -------------------------------------------------
//
// Ctrl+R looks back through the history for the newest line that contains what
// is typed after it, and Ctrl+R again looks further back. While it runs, the
// line reads
//     (reverse-i-search)`query': the line found
// Enter runs the line found, Escape or Ctrl+G puts back the line there was
// before, and any other key keeps the line found and is then taken as usual.
// The line found is the edit buffer itself, so "keep" is just stopping.

fn searching(r as *Repl) as i64 { return r.srch; }

// Where needle[0..nl] first occurs in hay[0..hl], or -1.
fn _index_of(hay as *u8, hl as i64, needle as *u8, nl as i64) as i64 {
    let is i64 as i with mut = 0;
    while (i + nl <= hl) {
        let is i64 as k with mut = 0;
        while (k < nl && hay[i + k] == needle[k]) { k = k + 1; }
        if (k == nl) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// The age (1 = newest) of the newest history line, `from` or older, holding
// the query; 0 if none does.
fn _find(r as *Repl, from as i64) as i64 {
    let is i64 as k with mut = from;
    if (k < 1) { k = 1; }
    while (k <= r.hsize) {
        let is i64 as slot = slot_of(r, k);
        if (slot >= 0 && _index_of(hist_ptr(r, slot), r.hlen[slot],
                                   cast(*u8, &r.sq[0]), r.sqlen) >= 0) { return k; }
        k = k + 1;
    }
    return 0;
}

// The history line of age k becomes the line, the cursor on the match.
fn _take(r as *Repl, k as i64) as void {
    let is i64 as slot = slot_of(r, k);
    if (slot < 0) { return; }
    let is *u8 as h = hist_ptr(r, slot);
    let is i64 as n = _fit(h, r.hlen[slot], LINE_CAP - 1);
    let is i64 as i with mut = 0;
    while (i < n) { r.line[i] = h[i]; i = i + 1; }
    r.llen = i;
    r.cur = _index_of(cast(*u8, &r.line[0]), r.llen, cast(*u8, &r.sq[0]), r.sqlen);
    if (r.cur < 0) { r.cur = r.llen; }
    r.shit = k;
    r.sfail = 0;
    return;
}

fn _restore(r as *Repl) as void {
    let is i64 as i with mut = 0;
    while (i < r.sllen) { r.line[i] = r.sline[i]; i = i + 1; }
    r.llen = r.sllen;
    r.cur = r.slcur;
    return;
}

// The query changed: the newest line from `from` back that has it. When none
// does, the line found so far stays and the search says it failed.
fn _research(r as *Repl, from as i64) as void {
    if (r.sqlen == 0) { _restore(r); r.shit = 0; r.sfail = 0; return; }
    let is i64 as k = _find(r, from);
    if (k > 0) { _take(r, k); } else { r.sfail = 1; }
    return;
}

fn _paint_search(r as *Repl, t as *term.Term) as void {
    let is [400]u8 as d;
    let is i64 as n with mut = 0;
    let is *u8 as pre with mut = "(reverse-i-search)`";
    if (r.sfail == 1) { pre = "(failed reverse-i-search)`"; }
    let is i64 as i with mut = 0;
    while (pre[i] != 0) { d[n] = pre[i]; n = n + 1; i = i + 1; }
    i = 0;
    while (i < r.sqlen) { d[n] = r.sq[i]; n = n + 1; i = i + 1; }
    d[n] = cast(u8, 39); d[n + 1] = cast(u8, 58); d[n + 2] = cast(u8, 32);   // "': "
    n = n + 3;
    let is i64 as at = n;
    i = 0;
    while (i < r.llen) { d[n] = r.line[i]; n = n + 1; i = i + 1; }
    _paint(r, t, cast(*u8, &d[0]), n, at + r.cur);
    return;
}

// search_next — Ctrl+R: start a search, or look further back for the query.
fn search_next(r as *Repl, t as *term.Term) as void {
    if (r.srch == 0) {
        let is i64 as i with mut = 0;
        while (i < r.llen) { r.sline[i] = r.line[i]; i = i + 1; }
        r.sllen = r.llen;
        r.slcur = r.cur;
        r.srch = 1;
        r.sqlen = 0;
        r.shit = 0;
        r.sfail = 0;
        redraw(r, t);
        return;
    }
    if (r.sqlen == 0) { return; }
    let is i64 as k = _find(r, r.shit + 1);
    if (k > 0) { _take(r, k); } else { r.sfail = 1; }
    redraw(r, t);
    return;
}

// search_key — a typed character (a code point) narrows the query. The line
// found so far is looked at first: it may still match.
fn search_key(r as *Repl, t as *term.Term, c as i64) as void {
    let is [4]u8 as e;
    let is i64 as n = _encode(c, cast(*u8, &e[0]));
    if (n <= 0 || r.sqlen + n > SQ_CAP) { return; }
    let is i64 as k with mut = 0;
    while (k < n) { r.sq[r.sqlen + k] = e[k]; k = k + 1; }
    r.sqlen = r.sqlen + n;
    _research(r, r.shit);
    redraw(r, t);
    return;
}

// search_back — Backspace takes the query's last character off and looks again
// from the newest.
fn search_back(r as *Repl, t as *term.Term) as void {
    if (r.sqlen == 0) { return; }
    r.sqlen = _prev(cast(*u8, &r.sq[0]), r.sqlen);
    _research(r, 1);
    redraw(r, t);
    return;
}

// search_end — stop searching: keep = 1 keeps the line found (and Up goes on
// from it), 0 puts back the line from before the search.
fn search_end(r as *Repl, t as *term.Term, keep as i64) as void {
    if (r.srch == 0) { return; }
    r.srch = 0;
    if (keep == 0) { _restore(r); r.hnav = 0; }
    else { r.hnav = r.shit; }
    redraw(r, t);
    return;
}

// A character a line can hold, as UTF-8 into e (room for 4): its length, or 0
// for what is not text — a control (it would move the terminal's cursor
// instead of being drawn), a surrogate, past U+10FFFF.
fn _encode(c as i64, e as *u8) as i64 {
    if (c < 0x20 || c == 0x7F || (c >= 0x80 && c <= 0x9F) || c > 0x10FFFF) { return 0; }
    let is i64 as n = utf8.encode1(cast(i32, c), e);
    if (n < 0) { return 0; }
    return n;
}

// Remove line[from..to) and close the gap; the cursor is the caller's.
fn _drop(r as *Repl, from as i64, to as i64) as void {
    let is i64 as i with mut = to;
    while (i < r.llen) { r.line[from + i - to] = r.line[i]; i = i + 1; }
    r.llen = r.llen - (to - from);
    return;
}

// Insert one character (a code point) at the cursor. Returns 0 when it is not
// text or the line is full.
fn line_push(r as *Repl, c as i64) as i64 {
    let is [4]u8 as e;
    let is i64 as n = _encode(c, cast(*u8, &e[0]));
    if (n == 0 || r.llen + n > LINE_CAP - 1) { return 0; }
    let is i64 as i with mut = r.llen;
    while (i > r.cur) { r.line[i + n - 1] = r.line[i - 1]; i = i - 1; }
    let is i64 as k with mut = 0;
    while (k < n) { r.line[r.cur + k] = e[k]; k = k + 1; }
    r.llen = r.llen + n;
    r.cur = r.cur + n;
    r.knav = 0;
    return 1;
}

// Insert src[0..n] at the cursor, as much of it as fits, never part of a
// character.
fn _insert(r as *Repl, src as *u8, n as i64) as void {
    let is i64 as m = _fit(src, n, LINE_CAP - 1 - r.llen);
    if (m <= 0) { return; }
    let is i64 as i with mut = r.llen;
    while (i > r.cur) { r.line[i + m - 1] = r.line[i - 1]; i = i - 1; }
    let is i64 as k with mut = 0;
    while (k < m) { r.line[r.cur + k] = src[k]; k = k + 1; }
    r.llen = r.llen + m;
    r.cur = r.cur + m;
    r.knav = 0;
    return;
}

// Delete the character BEFORE the cursor.
fn line_backspace(r as *Repl) as i64 {
    if (r.cur <= 0) { return 0; }
    let is i64 as p = _prev(cast(*u8, &r.line[0]), r.cur);
    _drop(r, p, r.cur);
    r.cur = p;
    r.knav = 0;
    return 1;
}

// Delete the character AT the cursor (Del; Ctrl+D on a line that has text).
fn line_delete(r as *Repl) as i64 {
    if (r.cur >= r.llen) { return 0; }
    _drop(r, r.cur, _next(cast(*u8, &r.line[0]), r.llen, r.cur));
    r.knav = 0;
    return 1;
}

// cancel — Ctrl+C at the prompt: the line is dropped, not run and not kept in
// the history, with ^C left where it ended; the caller starts a fresh prompt.
fn cancel(r as *Repl, t as *term.Term) as void {
    _to_end(r, t);
    term.putc(t, 0x5E); term.putc(t, 0x43);        // ^C
    term.putc(t, 0x0A);
    line_clear(r);
    return;
}

fn cursor(r as *Repl) as i64 { return r.cur; }
fn move_left(r as *Repl) as i64 {
    if (r.cur <= 0) { return 0; }
    r.cur = _prev(cast(*u8, &r.line[0]), r.cur);
    return 1;
}
fn move_right(r as *Repl) as i64 {
    if (r.cur >= r.llen) { return 0; }
    r.cur = _next(cast(*u8, &r.line[0]), r.llen, r.cur);
    return 1;
}
fn move_home(r as *Repl) as i64 { if (r.cur == 0) { return 0; } r.cur = 0; return 1; }
fn move_end(r as *Repl) as i64 { if (r.cur == r.llen) { return 0; } r.cur = r.llen; return 1; }

// kill_push — remember a cut so it can be yanked back. Empty cuts are not
// remembered: Ctrl+K at the end of a line must not push the ring's history out.
fn kill_push(r as *Repl, from as i64, len as i64) as void {
    if (len <= 0) { return; }
    let is i64 as n = _fit(cast(*u8, cast(i64, &r.line[0]) + from), len, LINE_CAP - 1);
    let is i64 as i with mut = 0;
    while (i < n) { r.kbuf[r.khead * LINE_CAP + i] = r.line[from + i]; i = i + 1; }
    r.klen[r.khead] = n;
    r.khead = (r.khead + 1) % KILL_N;
    if (r.ksize < KILL_N) { r.ksize = r.ksize + 1; }
    r.knav = 0;
    return;
}

fn _cut(r as *Repl, from as i64, to as i64) as i64 {
    if (to <= from) { return 0; }
    kill_push(r, from, to - from);
    _drop(r, from, to);
    if (r.cur > from) { r.cur = from; }
    return 1;
}

fn kill_to_end(r as *Repl) as i64 { return _cut(r, r.cur, r.llen); }
fn kill_to_start(r as *Repl) as i64 {
    let is i64 as c = r.cur;
    if (c <= 0) { return 0; }
    kill_push(r, 0, c);
    let is i64 as i with mut = c;
    while (i < r.llen) { r.line[i - c] = r.line[i]; i = i + 1; }
    r.llen = r.llen - c;
    r.cur = 0;
    return 1;
}

// Cut the word before the cursor: trailing blanks, then the run of non-blanks.
fn kill_word(r as *Repl) as i64 {
    if (r.cur <= 0) { return 0; }
    let is i64 as e with mut = r.cur;
    let is i64 as b with mut = e;
    while (b > 0 && r.line[b - 1] == cast(u8, 32)) { b = b - 1; }
    while (b > 0 && r.line[b - 1] != cast(u8, 32)) { b = b - 1; }
    return _cut(r, b, e);
}

// yank — paste the most recent cut. Repeating it walks further back through the
// ring, replacing what the previous yank inserted, which is what a kill ring is
// for: cut several things, then choose among them.
fn yank(r as *Repl) as i64 {
    if (r.ksize == 0) { return 0; }
    if (r.knav > 0) {
        // Undo the previous yank before inserting the older entry.
        let is i64 as prev = (r.khead - r.knav + KILL_N) % KILL_N;
        let is i64 as pl = r.klen[prev];
        if (r.cur >= pl) {
            let is i64 as i with mut = r.cur;
            while (i < r.llen) { r.line[i - pl] = r.line[i]; i = i + 1; }
            r.llen = r.llen - pl;
            r.cur = r.cur - pl;
        }
    }
    r.knav = r.knav + 1;
    if (r.knav > r.ksize) { r.knav = 1; }
    let is i64 as slot = (r.khead - r.knav + KILL_N) % KILL_N;
    let is i64 as n = r.klen[slot];
    if (n <= 0 || r.llen + n >= LINE_CAP) { return 0; }
    let is i64 as i with mut = r.llen;
    while (i > r.cur) { r.line[i + n - 1] = r.line[i - 1]; i = i - 1; }
    let is i64 as k with mut = 0;
    while (k < n) { r.line[r.cur + k] = r.kbuf[slot * LINE_CAP + k]; k = k + 1; }
    r.llen = r.llen + n;
    r.cur = r.cur + n;
    return 1;
}

// transpose — swap the two characters around the cursor and step past them, the
// readline behaviour: at the end of the line it swaps the last two.
fn transpose(r as *Repl) as i64 {
    let is *u8 as ln = cast(*u8, &r.line[0]);
    let is i64 as c with mut = r.cur;
    if (c >= r.llen) { c = _prev(ln, r.llen); }
    if (c <= 0) { return 0; }
    let is i64 as a = _prev(ln, c);                 // [a, c) and [c, e) trade places
    let is i64 as e = _next(ln, r.llen, c);
    let is [8]u8 as tmp;
    let is i64 as k with mut = 0;
    while (a + k < c) { tmp[k] = r.line[a + k]; k = k + 1; }
    let is i64 as la = k;
    k = 0;
    while (c + k < e) { r.line[a + k] = r.line[c + k]; k = k + 1; }
    let is i64 as lb = k;
    k = 0;
    while (k < la) { r.line[a + lb + k] = tmp[k]; k = k + 1; }
    r.cur = e;
    r.knav = 0;
    return 1;
}

// ---- history ---------------------------------------------------------------

// slot_of(idx) — idx 1 = most recent. Returns the ring slot, or -1 when idx is
// outside what is stored.
fn slot_of(r as *Repl, idx as i64) as i64 {
    if (idx < 1 || idx > r.hsize) { return 0 - 1; }
    return (r.hhead - idx + HIST_N) % HIST_N;
}

fn hist_ptr(r as *Repl, slot as i64) as *u8 { return cast(*u8, &r.hbuf[slot * LINE_CAP]); }
fn hist_len(r as *Repl, slot as i64) as i64 { return r.hlen[slot]; }
fn hist_count(r as *Repl) as i64 { return r.hsize; }

// push — store a finished command. A blank line is not history, and neither is
// an immediate repeat: walking back through five identical entries is noise.
fn hist_push(r as *Repl, src as *u8, len as i64) as void {
    if (len <= 0) { return; }
    let is i64 as prev = slot_of(r, 1);
    if (prev >= 0 && r.hlen[prev] == len) {
        let is i64 as k with mut = 0;
        while (k < len && r.hbuf[prev * LINE_CAP + k] == src[k]) { k = k + 1; }
        if (k == len) { return; }
    }
    let is i64 as n = _fit(src, len, LINE_CAP - 1);
    let is i64 as i with mut = 0;
    while (i < n) { r.hbuf[r.hhead * LINE_CAP + i] = src[i]; i = i + 1; }
    r.hlen[r.hhead] = n;
    r.hhead = (r.hhead + 1) % HIST_N;
    if (r.hsize < HIST_N) { r.hsize = r.hsize + 1; }
    r.npush = r.npush + 1;
    return;
}

// recall — replace what is on screen with src[0..srclen]: rub out the typed
// characters, then echo the recalled ones. The caller flushes.
fn recall(r as *Repl, t as *term.Term, src as *u8, srclen as i64) as void {
    let is i64 as n = _fit(src, srclen, LINE_CAP - 1);
    let is i64 as i with mut = 0;
    while (i < n) { r.line[i] = src[i]; i = i + 1; }
    r.llen = i;
    r.cur = i;                       // a recalled line is ready to be extended
    redraw(r, t);
    return;
}

// nav_up / nav_down — walk the ring. Return 1 when the line changed (the caller
// then flushes), 0 at either end.
fn nav_up(r as *Repl, t as *term.Term) as i64 {
    if (r.hnav >= r.hsize) { return 0; }
    r.hnav = r.hnav + 1;
    let is i64 as slot = slot_of(r, r.hnav);
    if (slot < 0) { return 0; }
    recall(r, t, hist_ptr(r, slot), r.hlen[slot]);
    return 1;
}

fn nav_down(r as *Repl, t as *term.Term) as i64 {
    if (r.hnav <= 0) { return 0; }
    r.hnav = r.hnav - 1;
    if (r.hnav == 0) { recall(r, t, cast(*u8, &r.line[0]), 0); return 1; }
    let is i64 as slot = slot_of(r, r.hnav);
    if (slot < 0) { return 0; }
    recall(r, t, hist_ptr(r, slot), r.hlen[slot]);
    return 1;
}

fn slen(s as *u8) as i64 { let is i64 as n with mut = 0; while (s[n] != 0) { n = n + 1; } return n; }

fn streq(a as *u8, alen as i64, lit as *u8) as i64 {
    let is i64 as ll = slen(lit);
    if (alen != ll) { return 0; }
    let is i64 as i with mut = 0;
    while (i < ll) { if (a[i] != lit[i]) { return 0; } i = i + 1; }
    return 1;
}

// ---- persistence -----------------------------------------------------------
//
// /var/history, format v1:
//   "HIST"            4 bytes
//   count             u32 LE — records that follow
//   count x { len:u32 LE, bytes }   oldest first
//
// The magic exists so a truncated or foreign file is refused instead of
// half-parsed. The disk keeps FILE_MAX commands; the ring in memory keeps
// HIST_N of them, so the file outlives what Up/Down can reach.
//
// Writes go to <path>.tmp and are renamed over the target: a shell killed
// mid-save leaves the previous history intact, never a half-written one.
let is i64 as FILE_MAX with imut = 128;
let is i64 as FILE_CAP with imut = 16384;

let is [16384]u8 as fbuf with mut;

fn _u32le(b as *u8, off as i64) as i64 {
    return cast(i64, b[off]) | (cast(i64, b[off+1]) << 8)
         | (cast(i64, b[off+2]) << 16) | (cast(i64, b[off+3]) << 24);
}

fn _put_u32le(b as *u8, off as i64, v as i64) as void {
    b[off]     = cast(u8, v & 0xFF);
    b[off + 1] = cast(u8, (v >> 8) & 0xFF);
    b[off + 2] = cast(u8, (v >> 16) & 0xFF);
    b[off + 3] = cast(u8, (v >> 24) & 0xFF);
    return;
}

// _scan — walk the records in b[0..n], writing each record's offset and
// length into offs/lens. Returns how many were well-formed; a record that
// runs past the end ends the scan rather than reading rubbish.
fn _scan(b as *u8, n as i64, offs as *i64, lens as *i64, max as i64) as i64 {
    if (n < 8) { return 0; }
    if (b[0] != cast(u8, 72) || b[1] != cast(u8, 73)
        || b[2] != cast(u8, 83) || b[3] != cast(u8, 84)) { return 0; }   // "HIST"
    let is i64 as count = _u32le(b, 4);
    let is i64 as p with mut = 8;
    let is i64 as got with mut = 0;
    let is i64 as i with mut = 0;
    while (i < count && got < max) {
        if (p + 4 > n) { i = count; }
        else {
            let is i64 as rlen = _u32le(b, p);
            p = p + 4;
            if (rlen < 0 || rlen > LINE_CAP - 1 || p + rlen > n) { i = count; }
            else {
                offs[got] = p; lens[got] = rlen; got = got + 1;
                p = p + rlen;
                i = i + 1;
            }
        }
    }
    return got;
}

// file_load — seed the ring from disk. Missing or malformed file = empty
// history, never an error the caller has to handle: a first boot has no file.
fn file_load(r as *Repl, path as *u8) as i64 {
    let is i64 as fd = sys.open_read(path);
    if (fd < 0) { return 0; }
    let is i64 as n = sys.read(fd, cast(*u8, &fbuf[0]), FILE_CAP);
    sys.close(fd);
    if (n <= 0) { return 0; }
    let is [128]i64 as offs;
    let is [128]i64 as lens;
    let is i64 as got = _scan(cast(*u8, &fbuf[0]), n, cast(*i64, &offs[0]), cast(*i64, &lens[0]), FILE_MAX);
    // Only the newest HIST_N reach the ring — pushing all of them would just
    // overwrite the same slots and cost the loop.
    let is i64 as first with mut = got - HIST_N;
    if (first < 0) { first = 0; }
    let is i64 as i with mut = first;
    while (i < got) {
        hist_push(r, cast(*u8, &fbuf[offs[i]]), lens[i]);
        i = i + 1;
    }
    r.npush_load = r.npush;
    return got;
}

// _save — rewrite the file at `path` as what is on it now plus the n lines at
// ptrs/lens (oldest first), keeping the newest FILE_MAX: written to
// <path>.tmp and renamed over it. `buf` (FILE_CAP bytes) holds the old file
// while it is copied — the caller's, so two threads saving never share one.
// The records written, or -1.
//
// Only lines new since the last save come in, so a session that loaded 40
// entries does not write them back a second time. Several shells share one
// file: the last writer wins the tail, which loses interleaving but never
// corrupts — the rename is the whole transaction.
fn _save(path as *u8, buf as *u8, ptrs as *i64, lens as *i64, n as i64) as i64 {
    if (n <= 0) { return 0; }
    // Read the current file first: the new records are appended to it.
    let is i64 as old_n with mut = 0;
    let is i64 as fd = sys.open_read(path);
    if (fd >= 0) {
        old_n = sys.read(fd, buf, FILE_CAP);
        sys.close(fd);
        if (old_n < 0) { old_n = 0; }
    }
    let is [128]i64 as offs;
    let is [128]i64 as olens;
    let is i64 as old_got = _scan(buf, old_n, cast(*i64, &offs[0]), cast(*i64, &olens[0]), FILE_MAX);

    // Drop the oldest so old + new fits the cap; more new lines than that
    // and only their newest go in.
    let is i64 as first with mut = 0;
    if (n > FILE_MAX) { first = n - FILE_MAX; }
    let is i64 as fresh = n - first;
    let is i64 as skip with mut = old_got + fresh - FILE_MAX;
    if (skip < 0) { skip = 0; }
    let is i64 as keep = old_got - skip;

    let is [128]u8 as tmp;
    let is i64 as pl = slen(path);
    if (pl > 120) { return 0 - 1; }
    let is i64 as k with mut = 0;
    while (k < pl) { tmp[k] = path[k]; k = k + 1; }
    tmp[pl] = cast(u8, 46); tmp[pl+1] = cast(u8, 116);
    tmp[pl+2] = cast(u8, 109); tmp[pl+3] = cast(u8, 112);    // ".tmp"
    tmp[pl+4] = cast(u8, 0);

    let is i64 as out = sys.open_write(cast(*u8, &tmp[0]));
    if (out < 0) { return 0 - 1; }
    let is [8]u8 as hdr;
    hdr[0] = cast(u8, 72); hdr[1] = cast(u8, 73); hdr[2] = cast(u8, 83); hdr[3] = cast(u8, 84);
    _put_u32le(cast(*u8, &hdr[0]), 4, keep + fresh);
    if (sys.write(out, cast(*u8, &hdr[0]), 8) != 8) { sys.close(out); return 0 - 1; }

    let is [4]u8 as lb;
    let is i64 as i with mut = skip;
    while (i < old_got) {
        _put_u32le(cast(*u8, &lb[0]), 0, olens[i]);
        sys.write(out, cast(*u8, &lb[0]), 4);
        sys.write(out, cast(*u8, cast(i64, buf) + offs[i]), olens[i]);
        i = i + 1;
    }
    i = first;
    while (i < n) {
        _put_u32le(cast(*u8, &lb[0]), 0, lens[i]);
        sys.write(out, cast(*u8, &lb[0]), 4);
        sys.write(out, cast(*u8, ptrs[i]), lens[i]);
        i = i + 1;
    }
    sys.close(out);
    if (cast(i64, sys.rename(cast(*u8, &tmp[0]), path)) != 0) {
        sys.unlink(cast(*u8, &tmp[0]));                      // no half-file left behind
        return 0 - 1;
    }
    return keep + fresh;
}

// file_save — the lines this session added since the last load or save, from
// the ring, written now on the caller's thread. A shell with a HistSync
// running hands its lines to that instead (sync); this is what is left when it
// could not start one.
fn file_save(r as *Repl, path as *u8) as i64 {
    let is i64 as fresh with mut = r.npush - r.npush_load;
    if (fresh <= 0) { return 0; }
    if (fresh > r.hsize) { fresh = r.hsize; }                // older ones fell out of the ring
    let is [16]i64 as ptrs;                                 // HIST_N
    let is [16]i64 as lens;
    let is i64 as n with mut = 0;
    let is i64 as age with mut = fresh;                     // oldest first
    while (age >= 1) {
        let is i64 as slot = slot_of(r, age);
        if (slot >= 0) {
            ptrs[n] = cast(i64, hist_ptr(r, slot));
            lens[n] = r.hlen[slot];
            n = n + 1;
        }
        age = age - 1;
    }
    let is i64 as rc = _save(path, cast(*u8, &fbuf[0]), cast(*i64, &ptrs[0]), cast(*i64, &lens[0]), n);
    if (rc >= 0) { r.npush_load = r.npush; }
    return rc;
}

// ---- keeping the file without waiting for it ------------------------------
//
// Saving is a read of the whole file, a write of it to <path>.tmp and a rename
// — on a disk, behind every other program's file I/O. It was done on Enter,
// before the command ran, so the command waited for it, and a terminal whose
// disk was busy did not answer at all until it was done.
//
// A HistSync is a thread of the shell's own that does the saving. Enter hands
// it the line through a channel and goes on to run the command; the thread
// gathers what has come in — several lines if the disk kept it — and saves
// them in one go. The hand-over never waits either: a line goes only when the
// channel has room for it, and while one is held back the shell polls the
// channel for room (sync_waiting, sync_fd) and calls sync again. The ring
// keeps HIST_N lines, so a disk that stays stuck for more than that many
// commands loses the oldest of them, as file_save always did.
//
// The thread shares nothing with the shell but the channel and what it was
// given before it started (the path, its end of the channel): its buffers are
// on its own stack.

let is i64 as SYNC_STOP with imut = 0xFFFFFFFF;   // a record length meaning "save what you have, answer, end"
let is i64 as SYNC_PEND with imut = 16;           // lines the thread gathers before it saves regardless
// Its stack: reserved for 128 KiB, 32 KiB of it committed — its buffers and
// the save's frames take about 24. A dynamic-stack program's probes commit
// more if a deeper path ever needs it; a static one has to fit in the 32.
let is i64 as SYNC_STACK with imut = 131072;
let is i64 as SYNC_COMMIT with imut = 32768;

struct HistSync {
    on as i64;               // 1 = the thread is running
    fd as i64;               // the shell's end of the channel
    tfd as i64;              // the thread's end
    sent as i64;             // r.npush up to which lines were handed over
    held as i64;             // 1 = a line is waiting for room in the channel
    ts as sys.ThreadStack;
    path as [128]u8;
}

// The thread. Reads records — u32 length, then the line — and saves when what
// it has read is all there is for now, when it has gathered SYNC_PEND lines,
// and when told to stop; on SYNC_STOP it answers one byte once the save is
// done, and ends. EOF (the shell gone without stopping it) also ends it, after
// a last save.
fn _sync_thread(h as *HistSync) as i64 {
    let is [2048]u8 as rbuf;
    let is [4096]u8 as pbuf;               // SYNC_PEND * LINE_CAP
    let is [16]i64 as plen;
    let is [16]i64 as pptr;
    let is [16384]u8 as fb;                // FILE_CAP: the old file while it is copied
    let is [4]u8 as lenb;
    let is i64 as lfill with mut = 0;      // bytes of the length read so far
    let is i64 as want with mut = 0 - 1;   // the line's length once known
    let is i64 as got with mut = 0;        // bytes of the line read so far
    let is i64 as pn with mut = 0;
    let is i64 as stop with mut = 0;       // 1 = EOF, 2 = asked to stop
    let is [3]i64 as pe;
    while (stop == 0) {
        let is i64 as n = sys.read(h.tfd, cast(*u8, &rbuf[0]), 2048);
        if (n <= 0) { stop = 1; }
        let is i64 as i with mut = 0;
        while (i < n && stop == 0) {
            let is u8 as c = rbuf[i];
            i = i + 1;
            if (want < 0) {
                lenb[lfill] = c;
                lfill = lfill + 1;
                if (lfill == 4) {
                    lfill = 0;
                    let is i64 as l = _u32le(cast(*u8, &lenb[0]), 0);
                    if (l == SYNC_STOP) { stop = 2; }
                    else if (l > 0 && l < LINE_CAP) {
                        if (pn == SYNC_PEND) {
                            _save(cast(*u8, &h.path[0]), cast(*u8, &fb[0]), cast(*i64, &pptr[0]), cast(*i64, &plen[0]), pn);
                            pn = 0;
                        }
                        want = l; got = 0;
                    }
                }
            } else {
                pbuf[pn * LINE_CAP + got] = c;
                got = got + 1;
                if (got == want) {
                    pptr[pn] = cast(i64, &pbuf[pn * LINE_CAP]);
                    plen[pn] = want;
                    pn = pn + 1;
                    want = 0 - 1;
                }
            }
        }
        // More already waiting is read before saving: a burst is one save.
        if (stop == 0) {
            pe[0] = h.tfd; pe[1] = sys.POLL_READABLE; pe[2] = 0;
            sys.poll(cast(*i64, &pe[0]), 1, 0);
            if ((pe[2] & sys.POLL_READABLE) != 0) { continue; }
        }
        if (pn > 0) {
            _save(cast(*u8, &h.path[0]), cast(*u8, &fb[0]), cast(*i64, &pptr[0]), cast(*i64, &plen[0]), pn);
            pn = 0;
        }
    }
    if (stop == 2) {
        let is [1]u8 as ack;
        ack[0] = cast(u8, 1);
        sys.write(h.tfd, cast(*u8, &ack[0]), 1);
    }
    sys.close(h.tfd);
    return 0;
}

// sync_start — start the thread that keeps `path` up to date with r's new
// lines. 0, or the errno with nothing started; then sync saves on the
// caller's thread, as before (file_save).
fn sync_start(h as *HistSync, r as *Repl, path as *u8) as i64 {
    h.on = 0; h.held = 0;
    h.fd = 0 - 1; h.tfd = 0 - 1;
    h.sent = r.npush;                      // what was loaded is on disk already
    h.path[0] = cast(u8, 0);
    let is i64 as pl = slen(path);
    if (pl > 120) { return sys.E_INVAL; }
    let is i64 as k with mut = 0;
    while (k <= pl) { h.path[k] = path[k]; k = k + 1; }
    let is [2]i64 as ch;
    let is i64 as rc with mut = sys.channel_create(cast(*i64, &ch[0]));
    if (rc != 0) { return rc; }
    h.fd = ch[0];
    h.tfd = ch[1];
    rc = sys.thread_start(&h.ts, cast(i64, fn_ptr(_sync_thread)), cast(i64, h), SYNC_STACK, SYNC_COMMIT);
    if (rc != 0) {
        sys.close(ch[0]); sys.close(ch[1]);
        h.fd = 0 - 1; h.tfd = 0 - 1;
        return rc;
    }
    h.on = 1;
    return 0;
}

// sync — after hist_push: hand the thread every line it has not had yet, as
// far as the channel has room, without waiting. With no thread, save here.
fn sync(h as *HistSync, r as *Repl) as void {
    if (h.on == 0) {
        file_save(r, cast(*u8, &h.path[0]));
        return;
    }
    _send(h, r);
    return;
}

// Every line not handed over yet, while the channel has room for it; h.held
// says whether one is left waiting.
fn _send(h as *HistSync, r as *Repl) as void {
    h.held = 0;
    let is [4]i64 as ci;
    let is [260]u8 as rec;                 // 4 + LINE_CAP
    while (h.sent < r.npush) {
        let is i64 as age = r.npush - h.sent;          // of the oldest not sent: 1 = newest
        if (age > r.hsize) { h.sent = r.npush - r.hsize; }   // fell out of the ring
        else {
            let is i64 as slot = slot_of(r, age);
            let is i64 as len = r.hlen[slot];
            if (sys.chan_info(h.fd, cast(*i64, &ci[0])) != 0) { h.held = 0; return; }
            if (ci[2] < 4 + len) { h.held = 1; return; }
            _put_u32le(cast(*u8, &rec[0]), 0, len);
            let is *u8 as src = hist_ptr(r, slot);
            let is i64 as k with mut = 0;
            while (k < len) { rec[4 + k] = src[k]; k = k + 1; }
            if (sys.write(h.fd, cast(*u8, &rec[0]), 4 + len) != 4 + len) { h.held = 0; return; }
            h.sent = h.sent + 1;
        }
    }
    return;
}

// While this is 1, poll sync_fd for POLL_WRITABLE and call sync when it is.
fn sync_waiting(h as *HistSync) as i64 { return h.held; }
fn sync_fd(h as *HistSync) as i64 { return h.fd; }

// sync_stop — on the way out: hand over what is left, ask the thread to save
// and stop, and wait for it to say it has — up to `wait_ns`, because a disk
// that does not answer must not keep the shell from leaving. 0, or E_AGAIN
// when the wait ran out (the newest lines may then not be in the file).
fn sync_stop(h as *HistSync, r as *Repl, wait_ns as i64) as i64 {
    if (h.on == 0) { file_save(r, cast(*u8, &h.path[0])); return 0; }
    h.on = 0;
    let is i64 as until = sys.time_ns() + wait_ns;
    let is [3]i64 as pe;
    let is i64 as rc with mut = sys.E_AGAIN;
    let is i64 as phase with mut = 0;        // 0 lines, 1 the stop record, 2 the answer
    while (phase < 3) {
        let is i64 as left = until - sys.time_ns();
        if (left <= 0) { phase = 3; }
        else if (phase == 0) {
            _send(h, r);
            if (h.held == 0) { phase = 1; }
            else {
                pe[0] = h.fd; pe[1] = sys.POLL_WRITABLE; pe[2] = 0;
                sys.poll(cast(*i64, &pe[0]), 1, left);
            }
        } else if (phase == 1) {
            let is [4]i64 as ci;
            sys.chan_info(h.fd, cast(*i64, &ci[0]));
            if (ci[2] >= 4) {
                let is [4]u8 as stop;
                _put_u32le(cast(*u8, &stop[0]), 0, SYNC_STOP);
                sys.write(h.fd, cast(*u8, &stop[0]), 4);
                phase = 2;
            } else {
                pe[0] = h.fd; pe[1] = sys.POLL_WRITABLE; pe[2] = 0;
                sys.poll(cast(*i64, &pe[0]), 1, left);
            }
        } else {
            pe[0] = h.fd; pe[1] = sys.POLL_READABLE; pe[2] = 0;
            sys.poll(cast(*i64, &pe[0]), 1, left);
            if ((pe[2] & (sys.POLL_READABLE | sys.POLL_CLOSED)) != 0) {
                let is [1]u8 as ack;
                if (sys.read(h.fd, cast(*u8, &ack[0]), 1) == 1) { rc = 0; }
                phase = 3;
            }
        }
    }
    sys.close(h.fd);
    h.fd = 0 - 1;
    return rc;
}

// ---- tokenising ------------------------------------------------------------

// parse — split the line on runs of spaces, in place. argv_ptr[i] is a byte
// pointer INTO the line (no copy), argv_len[i] its length. Returns argc.
fn parse(line as *u8, len as i64, argv_ptr as *i64, argv_len as *i64) as i64 {
    let is i64 as argc with mut = 0;
    let is i64 as i with mut = 0;
    while (i < len && argc < MAX_ARGS) {
        while (i < len && line[i] == 32) { i = i + 1; }
        if (i >= len) { break; }
        let is i64 as start = i;
        while (i < len && line[i] != 32) { i = i + 1; }
        argv_ptr[argc] = cast(i64, line) + start;
        argv_len[argc] = i - start;
        argc = argc + 1;
    }
    return argc;
}

// ---- completion ------------------------------------------------------------

fn _cand_match(cand as *u8, cl as i64, line as *u8, ts as i64, plen as i64) as i64 {
    if (cl < plen) { return 0; }
    let is i64 as k with mut = 0;
    while (k < plen) { if (cand[k] != line[ts + k]) { return 0; } k = k + 1; }
    return 1;
}

// Fold a match into the longest-common-prefix accumulator.
fn _acc_update(cand as *u8, cl as i64, acc as *u8, acclen_ptr as *i64, nmatch_ptr as *i64) as void {
    nmatch_ptr[0] = nmatch_ptr[0] + 1;
    if (acclen_ptr[0] < 0) {
        let is i64 as i with mut = 0;
        while (i < cl && i < LINE_CAP - 1) { acc[i] = cand[i]; i = i + 1; }
        acclen_ptr[0] = i;
    } else {
        let is i64 as i with mut = 0;
        let is i64 as al = acclen_ptr[0];
        while (i < al && i < cl && acc[i] == cand[i]) { i = i + 1; }
        acclen_ptr[0] = i;
    }
    return;
}

// complete — extend the last token to the longest prefix every candidate
// shares. Candidates are the caller's builtins (pairs of {ptr,len} in `builtins`,
// only when the token IS the command) plus the directory listing: programs with
// the .cse suffix stripped for a command, every name for an argument.
//
// The builtin list is the caller's because the two shells do not have the same
// one — the windowed shell can `exit`, the fullscreen one cannot.
fn complete(r as *Repl, t as *term.Term, builtins as *i64, nbuiltin as i64) as void {
    let is *u8 as line = cast(*u8, &r.line[0]);
    // Completion acts on the token the CURSOR is in, not on the end of the
    // line: with a movable cursor those are no longer the same place.
    let is i64 as llen = r.cur;
    let is i64 as ts with mut = llen;
    while (ts > 0 && line[ts - 1] != 32) { ts = ts - 1; }
    let is i64 as plen = llen - ts;
    let is i64 as is_cmd with mut = 0;
    if (ts == 0) { is_cmd = 1; }

    let is [256]u8 as acc;
    let is i64 as acclen with mut = 0 - 1;
    let is i64 as nmatch with mut = 0;

    if (is_cmd == 1) {
        let is i64 as bi with mut = 0;
        while (bi < nbuiltin) {
            let is *u8 as bp = cast(*u8, builtins[bi * 2]);
            let is i64 as bl = builtins[bi * 2 + 1];
            if (_cand_match(bp, bl, line, ts, plen) == 1) {
                _acc_update(bp, bl, cast(*u8, &acc[0]), &acclen, &nmatch);
            }
            bi = bi + 1;
        }
    }

    // A program's own options can be completed too, from /etc/completions/<cmd>:
    // one word per line, offered for any argument of that command. It is a plain
    // list and not a script because completing an argument must not be able to
    // run anything — the point is to look, not to act.
    if (is_cmd == 0) {
        let is i64 as ce with mut = 0;
        while (ce < llen && line[ce] != 32) { ce = ce + 1; }
        if (ce > 0 && ce < 64) {
            let is [128]u8 as cpath;
            let is *u8 as pre = "/etc/completions/";
            let is i64 as pl with mut = 0;
            while (pre[pl] != 0) { cpath[pl] = pre[pl]; pl = pl + 1; }
            let is i64 as q with mut = 0;
            while (q < ce) { cpath[pl + q] = line[q]; q = q + 1; }
            cpath[pl + ce] = cast(u8, 0);
            let is i64 as cfd = sys.open_read(cast(*u8, &cpath[0]));
            if (cfd >= 0) {
                let is [1024]u8 as cbuf;
                let is i64 as cn = sys.read(cfd, cast(*u8, &cbuf[0]), 1024);
                sys.close(cfd);
                let is i64 as p with mut = 0;
                while (p < cn) {
                    while (p < cn && (cbuf[p] == cast(u8, 10) || cbuf[p] == cast(u8, 13)
                                      || cbuf[p] == cast(u8, 32))) { p = p + 1; }
                    let is i64 as w0 = p;
                    while (p < cn && cbuf[p] != cast(u8, 10) && cbuf[p] != cast(u8, 13)
                           && cbuf[p] != cast(u8, 32)) { p = p + 1; }
                    if (p > w0 && _cand_match(cast(*u8, &cbuf[w0]), p - w0, line, ts, plen) == 1) {
                        _acc_update(cast(*u8, &cbuf[w0]), p - w0, cast(*u8, &acc[0]), &acclen, &nmatch);
                    }
                }
            }
        }
    }

    let is i64 as fd = sys.open_read(cast(*u8, "/"));
    if (fd >= 0) {
        let is [320]u8 as de;
        while (sys.readdir(fd, cast(*u8, &de[0])) == 0) {
            let is *u8 as nm = cast(*u8, &de[0]);
            let is *i64 as nlp = cast(*i64, cast(i64, &de[0]) + 256);
            let is i64 as nl = nlp[0];
            let is i64 as cl with mut = nl;
            let is i64 as ok with mut = 1;
            if (is_cmd == 1) {
                if (nl >= 4 && nm[nl-4] == 46 && nm[nl-3] == 99 && nm[nl-2] == 115 && nm[nl-1] == 101) { cl = nl - 4; }
                else { ok = 0; }
            }
            if (ok == 1 && _cand_match(nm, cl, line, ts, plen) == 1) {
                _acc_update(nm, cl, cast(*u8, &acc[0]), &acclen, &nmatch);
            }
        }
        sys.close(fd);
    }
    if (nmatch == 0) { return; }

    // Two names can share the first bytes of different characters ("café",
    // "cafè"): the prefix they share stops before that character.
    while (acclen > plen && (cast(i64, acc[acclen]) & 0xC0) == 0x80) { acclen = acclen - 1; }
    if (acclen > plen) {
        _insert(r, cast(*u8, cast(i64, &acc[0]) + plen), acclen - plen);
    }
    if (nmatch == 1) { line_push(r, 32); }               // sole match -> trailing space
    redraw(r, t);
    return;
}
