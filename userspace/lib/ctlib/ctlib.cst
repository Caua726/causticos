// ctlib.cst — shared bits for the on-device test harnesses. Spawn a .cse from a
// command line (split on spaces = its argv), echo a `$ ...` banner, wait. A
// spawned child has an empty fd table, so its write(1) falls back to the serial
// console and the boot log shows everything.
use "std/causticos/prog.cst" as prog;
use "std/os/causticos.cst" as sys;

fn ser(s as *u8) as void { sys.write_serial(s, prog.slen(s)); }

// Split `cmdline` on spaces into an argv vector. `cb` receives a NUL-punched
// copy of the line (the tokens point into it, so it must outlive the spawn) and
// `av` the {ptr,len} pairs. Returns argc.
fn split_argv(cmdline as *u8, cb as *u8, av as *i64) as i64 {
    let is i64 as cl with mut = prog.slen(cmdline);
    if (cl > 510) { cl = 510; }
    let is i64 as k with mut = 0;
    while (k < cl) { cb[k] = cmdline[k]; k = k + 1; }
    cb[cl] = cast(u8, 0);
    let is i64 as argc with mut = 0;
    let is i64 as i with mut = 0;
    while (i < cl) {
        while (i < cl && cast(i64, cb[i]) == 32) { i = i + 1; }
        if (i >= cl) { break; }
        let is i64 as start = i;
        while (i < cl && cast(i64, cb[i]) != 32) { i = i + 1; }
        cb[i] = cast(u8, 0);
        if (argc < 32) { av[argc * 2] = cast(i64, &cb[start]); av[argc * 2 + 1] = i - start; argc = argc + 1; }
        i = i + 1;
    }
    return argc;
}

// runc: spawn `path` with argv parsed from `cmdline` (space-separated). The
// cmdline doubles as the child's argv (copied so tokens can be NUL-terminated).
fn runc(path as *u8, cmdline as *u8) as void {
    ser("\n$ "); ser(cmdline); ser("\n");
    let is [512]u8 as cb;
    let is [64]i64 as av;
    let is i64 as argc = split_argv(cmdline, cast(*u8, &cb[0]), cast(*i64, &av[0]));
    let is i64 as pid = sys.spawn_path(path, cast(*u8, 0), 0, cast(*u8, &av[0]), argc);
    if (pid < 0) { ser("[spawn fail]\n"); return; }
    let is [1]i64 as stt;
    sys.wait(pid, cast(*i64, &stt[0]));
}

// runc_in: like runc, but wire the child's stdin (fd 0) to `infile` so stdin
// filters (tr, sort, ...) get real input. fd 1 stays unmapped → serial fallback.
fn runc_in(path as *u8, cmdline as *u8, infile as *u8) as void {
    ser("\n$ "); ser(cmdline); ser(" < "); ser(infile); ser("\n");
    let is [512]u8 as cb;
    let is [64]i64 as av;
    let is i64 as argc = split_argv(cmdline, cast(*u8, &cb[0]), cast(*i64, &av[0]));
    let is i64 as fdin = sys.open_read(infile);
    let is [2]i64 as fda; fda[0] = 0; fda[1] = fdin;             // child fd 0 = infile
    let is i64 as pid = sys.spawn_path(path, cast(*u8, &fda[0]), 1, cast(*u8, &av[0]), argc);
    if (pid < 0) { ser("[spawn fail]\n"); if (fdin >= 0) { sys.close(fdin); } return; }
    let is [1]i64 as stt2;
    sys.wait(pid, cast(*i64, &stt2[0]));
    if (fdin >= 0) { sys.close(fdin); }
}

// spawn_bg: launch `path` with argv[0]=name and DON'T wait — leaves it running
// (so ps/top have named processes to show). Returns the pid.
fn spawn_bg(path as *u8, name as *u8) as i64 {
    let is [2]i64 as av; av[0] = cast(i64, name); av[1] = prog.slen(name);
    return sys.spawn_path(path, cast(*u8, 0), 0, cast(*u8, &av[0]), 1);
}

fn mkfile(path as *u8, data as *u8) as void {
    let is i64 as fd = syscall(sys.SYS_OPEN, path, prog.slen(path), sys.O_WRONLY | sys.O_CREAT | sys.O_TRUNC);
    if (fd >= 0) { sys.write(fd, data, prog.slen(data)); sys.close(fd); }
}
