// compo_proto.cst — the wire protocol between the COMPOSITOR and the WM.
//
// The compositor/WM split peels the monolithic window manager apart. The
// compositor (the /init) owns the hardware — the framebuffer and the raw
// input devices — and the WM owns POLICY (focus, geometry, z-order, the
// taskbar). They talk over TWO channels, each carrying the same fixed 32-byte
// messages (4 x i64: {mtype, a, b, c}) the WM↔client protocol already uses, so
// the kernel's POLL_WRITE_UNIT (64B) makes a poll-then-write of one message
// never split. 1024B channel buffer = 32 messages in flight.
//
//   CMD channel (compositor → WM): normalised INPUT events. The compositor
//   reads raw scancodes / mouse deltas / tablet absolutes off the devices,
//   normalises them (modifier tracking, cursor position, button/wheel state),
//   and forwards MSG_CP_* here. The WM no longer touches an input device.
//
//   WC channel (WM → compositor): SCENE + DAMAGE descriptions and SURFACE
//   handoffs. The WM never touches the framebuffer; it describes WHAT to draw
//   (a back-to-front snapshot of windows + decorations) and the compositor
//   composes it. Surface/decoration segments arrive out-of-band via fd_send,
//   each immediately preceding its MSG_WC_*_SURFACE.
//
// Fd map handed to the WM at spawn (fdacts), see compositor.cst:
//   fd 3 = framebuffer surface (DEV_FB)         [used by the WM until M3]
//   fd 4 = CMD channel  (compositor → WM)       [WM reads input here]
//   fd 5 = WC  channel  (WM → compositor)       [WM writes the scene here]

use "std/os/causticos.cst" as sys;

// Child-side fd numbers (must match compositor.cst's spawn fdacts).
let is i64 as CP_FB_FD  with imut = 3;    // framebuffer surface
let is i64 as CP_CMD_FD with imut = 4;    // compositor → WM (input)
let is i64 as CP_WC_FD  with imut = 5;    // WM → compositor (scene)

let is i64 as MSG_BYTES with imut = 32;

// ---- compositor → WM (CMD channel): normalised input ----
// MSG_CP_SCR_READY{a=width, b=height}: sent ONCE, before any input, so the WM
//   learns the screen geometry it needs to clamp the cursor / lay windows out.
let is i64 as MSG_CP_SCR_READY with imut = 1;
// MSG_CP_KEY{a=keysym, b=mods|(pressed<<8)|(extended<<9), c=scancode}: one key
//   transition. The compositor OWNS THE KEYMAP (lib/keymap, in the layout the
//   user chose) — `a` is what the key typed: a character's code point (Shift,
//   CapsLock, AltGr and dead keys already applied: 'A', 'ç', 'é'), or a KEY_*
//   code (lib/keymap/keysym.cst) for the keys that are not characters, or 0
//   when it typed nothing (a modifier, a release, a dead key waiting for its
//   letter). A dead key and then a letter it does not go on type both, as two
//   KEY messages for the one key. `b` carries the modifiers that are left once
//   the character is chosen — AltGr+q typing "/" is no Alt chord — and the
//   pressed/extended bits (key_b/key_mods). The raw SCANCODE rides in `c`, so
//   the WM can route its hotkeys (Alt+Tab/Super+Enter/Super+Q) by key and
//   not by what the layout puts on it. Clients consume `a`.
let is i64 as MSG_CP_KEY with imut = 2;
// MSG_CP_PTR{a=x, b=y, c=buttons}: absolute cursor position + button mask. The
//   compositor owns cursor MOTION (it applies the accel curve to mouse deltas →
//   abs, passes the tablet's abs through) and clamps to the screen; the WM just
//   consumes x/y/buttons. This is a UNIFIED motion+button event (like an evdev
//   EV_ABS+EV_KEY batch closed by a SYN): every event carries the live cursor
//   position AND the current button mask, so the WM sees motion and a click in
//   the same coordinate frame. `c` is a bitmask of the BTN_* bits below — a
//   button transition is detected by the WM as a change in that mask (it diffs
//   old vs new, like handle_buttons does for BTN_LEFT). Position-only moves and
//   button-only clicks both ride this one message; there is no separate button
//   message (keeping the WM's hit-test/drag/focus path single-sourced).
let is i64 as MSG_CP_PTR with imut = 3;
// MSG_CP_WHEEL{a=delta, b=x, c=y}: a wheel notch at the current cursor. `a` is
//   the VERTICAL wheel delta (REL_WHEEL: + = away/up, - = toward/down), the
//   standard PS/2 IntelliMouse Z axis. Horizontal scroll (REL_HWHEEL) would ride
//   MSG_CP_HWHEEL — structured below but a STUB on PS/2: the standard 4-byte
//   IntelliMouse protocol has no horizontal axis (only the 5-button/H-wheel
//   "Explorer 4.0" variant does, which QEMU's PS/2 model doesn't emit), so the
//   compositor never sends it today. A virtio-tablet or a future 5-button PS/2
//   negotiation can fill it in without touching this contract.
let is i64 as MSG_CP_WHEEL  with imut = 4;
let is i64 as MSG_CP_HWHEEL with imut = 6;   // horizontal wheel notch (REL_HWHEEL); PS/2 stub
// MSG_CP_SHUTDOWN_REQ{a=kind}: the power was asked to go off (kind =
//   sys.POWER_OFF) or the machine to restart (sys.POWER_REBOOT) — by the power
//   button or a program (sys.power_request). The WM asks its clients to close,
//   then replies MSG_WC_SHUTDOWN, or MSG_WC_SHUTDOWN_CANCEL when one would not.
let is i64 as MSG_CP_SHUTDOWN_REQ with imut = 5;

// ---- pointer button bits (the `c` field of MSG_CP_PTR) ------------------
// Named after the Linux evdev BTN_* codes so the mask reads the same up and
// down the stack. The low three bits map 1:1 onto the PS/2 byte the mouse
// driver reports (DEV_MOUSE record byte 2): bit0=left, bit1=right, bit2=middle.
// IntelliMouse "Explorer" 5-button mice put buttons 4/5 in bits 3/4 of that same
// byte; the compositor passes them straight through, so BACK/FORWARD light up if
// the hardware (or QEMU model) reports them and stay 0 otherwise.
let is i64 as BTN_LEFT    with imut = 1;       // bit 0
let is i64 as BTN_RIGHT   with imut = 2;       // bit 1
let is i64 as BTN_MIDDLE  with imut = 4;       // bit 2
let is i64 as BTN_BACK    with imut = 8;       // bit 3 (button 4)
let is i64 as BTN_FORWARD with imut = 16;      // bit 4 (button 5)
// The driver byte may set high bits we don't define (overflow/sign flags on a
// raw PS/2 status byte); the compositor masks the byte to the defined buttons
// before it forwards, so the WM only ever sees BTN_* bits.
let is i64 as BTN_MASK    with imut = 31;       // BTN_LEFT..BTN_FORWARD

// ---- WM → compositor (WC channel): the scene ----
// MSG_WC_SCENE{a=count}: begins a full back-to-front snapshot; followed by
//   `count` MSG_WC_SCENE_ENTRY messages, top-of-stack LAST (paint order). A
//   scene replaces the previous one entirely (snapshot, not a delta).
let is i64 as MSG_WC_SCENE with imut = 16;
// MSG_WC_SCENE_ENTRY{a=win_id|(flags<<32), b=pack(x,y), c=pack(w,h)}: one
//   window's frame placement. flags bit0 = focused, bit1 = minimised, bits 8-15
//   = opacity. (x,y) = FRAME corner, (w,h) = CONTENT size (the compositor draws
//   border/titlebar from its own decoration surface, see MSG_WC_DEC_SURFACE).
//   The rect is what to DRAW THIS FRAME, not where the window "is": while the
//   WM tweens an open/close/resize it sends the interpolated rect here and
//   keeps the settled one to itself, so hit-testing and client RESIZE messages
//   never see the intermediate values.
let is i64 as MSG_WC_SCENE_ENTRY with imut = 17;
// MSG_WC_DAMAGE{a=x, b=y, c=pack(w,h)}: a screen rect to recompose. a<0 (a==-1)
//   means full-screen.
let is i64 as MSG_WC_DAMAGE with imut = 18;
// MSG_WC_CURSOR{a=shape, b=x, c=y}: the cursor's contextual shape + position.
let is i64 as MSG_WC_CURSOR with imut = 19;
// MSG_WC_ATTACH_SURFACE{a=win_id, b=npages, c=is_text|(stride<<32)}: a client's
//   content segment, preceded by fd_send of the seg fd. is_text=1 → cell grid.
let is i64 as MSG_WC_ATTACH_SURFACE with imut = 20;
// MSG_WC_DETACH_SURFACE{a=win_id}: drop a window's content segment.
let is i64 as MSG_WC_DETACH_SURFACE with imut = 21;
// MSG_WC_DEC_SURFACE{a=win_id, b=npages, c=cols|(rows<<32)}: a per-window
//   decoration segment (a cell grid: char|fg<<8|bg<<32), preceded by fd_send.
//   win_id == DEC_TASKBAR_ID is the global taskbar; DEC_CONTEXT_ID is the WM popup.
let is i64 as MSG_WC_DEC_SURFACE with imut = 22;
// MSG_WC_DEC_DETACH{a=win_id}: drop a window's titlebar decoration.
let is i64 as MSG_WC_DEC_DETACH with imut = 24;
// MSG_WC_SHUTDOWN{a=kind}: every client is gone — paint the notice, then power
//   off or restart as `kind` says.
let is i64 as MSG_WC_SHUTDOWN with imut = 23;
// MSG_WC_SHUTDOWN_CANCEL: a client would not close (unsaved work); the request
//   is called off and the desktop goes on.
let is i64 as MSG_WC_SHUTDOWN_CANCEL with imut = 27;

// MSG_WC_OVERLAY{a=slot, b=pack(x,y), c=pack(w,h)}: a chrome rect the WM wants
//   drawn ON TOP of the scene, in its own right — a drag outline, a snap ghost.
//   w<=0 clears the slot. These are not windows: they have no surface, no
//   z-order and no input. The WM says WHERE and WHICH KIND; how an outline
//   looks (dash pattern, colour) is the compositor's.
let is i64 as MSG_WC_OVERLAY with imut = 25;
let is i64 as OVL_DRAG  with imut = 0;    // outline round the window being dragged
let is i64 as OVL_SNAP  with imut = 1;    // ghost of the edge-snap target
let is i64 as OVL_SLOTS with imut = 2;

// MSG_WC_KEYMAP: the keyboard layout chosen has changed (lib/keymap: the name
//   in /var/keymap or /etc/keymap, or the map file it names) — the compositor
//   loads it again. The WM sends it once at start and then whenever
//   keymap.config_stamp() moves; what the layout is stays the compositor's
//   to read, so nothing about it crosses the channel.
let is i64 as MSG_WC_KEYMAP with imut = 28;

// MSG_WC_TIMEZONE: the time zone chosen has changed (lib/tz: the name in
//   /var/timezone or /etc/timezone, or the zone file it names) — the
//   compositor loads it again, so the night light follows the local hour.
//   Sent once at start and then whenever tz.config_stamp() moves.
let is i64 as MSG_WC_TIMEZONE with imut = 30;

// MSG_WC_STYLE{a=key, b=value}: one metric or colour the compositor must draw
//   with. Both sides draw parts of the same frame — the WM rasterises the
//   titlebar cells, the compositor fills the border under them — so a titlebar
//   height that lives in only one of them is a frame that does not line up.
//   The WM owns the numbers (they come from its config); the compositor is told
//   them, and re-told whenever the config is reloaded. One key per message
//   keeps the set open: a new style key is a new constant, not a new message.
let is i64 as MSG_WC_STYLE with imut = 26;
// MSG_WC_CONTEXT{a=open, b=pack(x,y), c=pack(w,h)} positions the WM-owned menu
// surface above the scene; a=0 dismisses it and restores its previous rect.
let is i64 as MSG_WC_CONTEXT with imut = 29;
let is i64 as STY_TITLE_H      with imut = 1;
let is i64 as STY_BORDER       with imut = 2;
let is i64 as STY_BAR_H        with imut = 3;
let is i64 as STY_BTN_W        with imut = 4;
// 0 = the desktop is a flat COL_DESKTOP fill, 1 = the wallpaper image (or the
// generated one). Flat is not just a look: it also stops the once-a-second
// re-bake and the parallax, both of which full-damage the screen.
let is i64 as STY_WALLPAPER    with imut = 5;
let is i64 as STY_COL_BORDER_F with imut = 10;
let is i64 as STY_COL_BORDER_U with imut = 11;
let is i64 as STY_COL_TITLE_F  with imut = 12;
let is i64 as STY_COL_TITLE_U  with imut = 13;
let is i64 as STY_COL_TEXT     with imut = 14;
let is i64 as STY_COL_BAR      with imut = 15;
let is i64 as STY_COL_BAR_ITEM with imut = 16;
let is i64 as STY_COL_DESKTOP  with imut = 17;

// Global taskbar and popup decorations use reserved win_ids.
let is i64 as DEC_TASKBAR_ID with imut = 1000000;
let is i64 as DEC_CONTEXT_ID with imut = 1000001;  // the WM's context menu

// ---- decoration cell grid -----------------------------------------------
// A decoration surface is a cell grid in the SAME txt_cell format the WM↔client
// TEXT surface uses (wmproto.cst): an 8-cell (64-byte) header then cols*rows i64
// cells, row-major. The compositor rasterises each 8x16 cell (char|fg<<8|bg<<32)
// — a glyph over a background. A "coloured button" cell is char=0 with the
// wanted bg. The WM writes border/titlebar/buttons (per-window) and the taskbar
// labels (global) into these grids; pixels never cross the channel.
//   header[0] = cols   header[1] = rows   (header[2..7] reserved, cursor unused)
let is i64 as DEC_HDR_CELLS with imut = 8;
let is i64 as DEC_H_COLS    with imut = 0;
let is i64 as DEC_H_ROWS    with imut = 1;
fn dec_seg_pages(cols as i64, rows as i64) as i64 {
    return ((DEC_HDR_CELLS + cols * rows) * 8 + 4095) / 4096;
}
// Pack a cell the way a terminal's text segment does (wmproto txt_cell_*):
// code point (bits 0-15) | fg RGB24 (16-39) | bg RGB24 (40-63).
fn make_cell(ch as i64, fg as i64, bg as i64) as i64 {
    return (ch & 0xFFFF) | ((fg & 0xFFFFFF) << 16) | ((bg & 0xFFFFFF) << 40);
}

// ---- packing helpers (geometry into one i64) ----
fn pack_xy(x as i64, y as i64) as i64 { return ((x & 0xFFFFFFFF) << 32) | (y & 0xFFFFFFFF); }
fn unpack_x(v as i64) as i64 { return (v >> 32) & 0xFFFFFFFF; }
fn unpack_y(v as i64) as i64 {
    let is i64 as y = v & 0xFFFFFFFF;
    return y;
}
fn pack_wh(w as i64, h as i64) as i64 { return ((w & 0xFFFFFFFF) << 32) | (h & 0xFFFFFFFF); }
fn unpack_w(v as i64) as i64 { return (v >> 32) & 0xFFFFFFFF; }
fn unpack_h(v as i64) as i64 { return v & 0xFFFFFFFF; }

// ---- KEY field b ----------------------------------------------------------
// mods (low 8: lib/keymap/keysym.cst's MOD_* bits) | pressed<<8 | extended<<9.
fn key_b(mods as i64, pressed as i64, ext as i64) as i64 {
    return (mods & 0xFF) | ((pressed & 1) << 8) | ((ext & 1) << 9);
}
fn key_mods(b as i64) as i64 { return b & 0xFF; }
fn key_pressed(b as i64) as i64 { return (b >> 8) & 1; }
fn key_ext(b as i64) as i64 { return (b >> 9) & 1; }

// SCENE_ENTRY a field: win_id (low 32) | flags<<32.
fn entry_a(win_id as i64, flags as i64) as i64 { return (win_id & 0xFFFFFFFF) | ((flags & 0xFFFFFFFF) << 32); }
fn entry_win(a as i64) as i64 { return a & 0xFFFFFFFF; }
fn entry_flags(a as i64) as i64 { return (a >> 32) & 0xFFFFFFFF; }
let is i64 as ENTRY_FOCUSED   with imut = 1;    // bit 0
let is i64 as ENTRY_MINIMIZED with imut = 2;    // bit 1 — draw as a taskbar button only
// Opacity rides bits 8..15 (255 = opaque). The WM sets it while a window fades
// in or out; the compositor blends everything it draws for that window against
// what is already composed underneath. Composition is the compositor's job, so
// the WM says HOW OPAQUE, never how to mix.
fn entry_alpha(flags as i64) as i64 { return (flags >> 8) & 0xFF; }
fn entry_with_alpha(flags as i64, a as i64) as i64 {
    return (flags & 0xFFFF00FF) | ((a & 0xFF) << 8);
}
// Focus blend rides bits 16..23 (0 = unfocused colours, 255 = focused). The
// WM tweens it so a focus change ramps instead of snapping; the compositor
// just mixes its two palette entries by it.
fn entry_fblend(flags as i64) as i64 { return (flags >> 16) & 0xFF; }
fn entry_with_fblend(flags as i64, b as i64) as i64 {
    return (flags & 0xFF00FFFF) | ((b & 0xFF) << 16);
}

// ---- raw channel I/O (same discipline as wmproto.cst) ----
fn _wr(fd as i64, buf as i64, n as i64) as i64 { return syscall(11, fd, buf, n); }
fn _rd(fd as i64, buf as i64, n as i64) as i64 { return syscall(10, fd, buf, n); }

fn msg_write(fd as i64, m as *i64) as i64 {
    let is i64 as sent with mut = 0;
    while (sent < MSG_BYTES) {
        let is i64 as w = _wr(fd, cast(i64, m) + sent, MSG_BYTES - sent);
        if (w < 0) { return w; }
        if (w == 0) { return sys.E_PIPE; }
        sent = sent + w;
    }
    return 0;
}

fn msg_send(fd as i64, mtype as i64, a as i64, b as i64, c as i64) as i64 {
    let is [4]i64 as m;
    m[0] = mtype; m[1] = a; m[2] = b; m[3] = c;
    return msg_write(fd, &m[0]);
}

// msg_read — assemble one 32-byte message from a possibly-fragmented stream.
// `fill`/`acc` persist across calls per channel. 1 = whole message in out[];
// 0 = partial (poll again); -1 = EOF/error. Call only when fd is READABLE.
fn msg_read(fd as i64, fill as *i64, acc as *u8, out as *i64) as i64 {
    let is i64 as have with mut = *fill;
    let is i64 as r = _rd(fd, cast(i64, acc) + have, MSG_BYTES - have);
    if (r <= 0) { return 0 - 1; }
    have = have + r;
    if (have < MSG_BYTES) { *fill = have; return 0; }
    *fill = 0;
    let is *i64 as p = cast(*i64, cast(i64, acc));
    out[0] = p[0]; out[1] = p[1]; out[2] = p[2]; out[3] = p[3];
    return 1;
}
