// lib/ttyproto/ttyproto.cst — the terminal a program's output goes to, when it
// goes to one.
//
// causticos has no tty in the kernel and no ambient environment, so a program
// cannot ask "is my stdout a terminal, and how wide?" of anything but the
// terminal itself. A shell hands TTY_FD only to the process whose stdout IS
// its terminal — the last stage of a pipeline with no redirect — on a channel
// of that process's own. So the key's presence answers the first question, and
// the channel behind it answers the rest. A process writing into a pipe or a
// file has no TTY_FD, and size() says so.
//
// Messages are 32 bytes, four i64, like the other protocols here:
//   process → terminal  {MSG_TTY_SIZE, 0, 0, 0}
//   terminal → process  {MSG_TTY_SIZE, cols, rows, 0}
//   process → terminal  {MSG_TTY_CATCH, mask, 0, 0}
//   terminal → process  {MSG_TTY_EVENT, kind, 0, 0}
//   process → terminal  {MSG_TTY_KILL, pid, 0, 0}
//   terminal → process  {MSG_TTY_KILL, pid, rc, 0}
//
// Events — the job of signals, without them. Ctrl+C (EV_INTR) and the
// terminal going away (EV_HUP, its window closed) end the program by default,
// at once. A program that has something to finish first — unsaved text, a
// file whose header is written last — asks for them with catch(): from then on
// the terminal sends MSG_TTY_EVENT instead, and the program decides. Ctrl+\
// ends it regardless, so a program that catches Ctrl+C and then hangs can
// still be stopped.
//
// Ending a process for the person at the keyboard (a task manager's `k`). The
// authority to end a process is having started it, so a program can end its
// own children and nothing else; a task manager asks its terminal instead, on
// the user's behalf. The terminal ends it if it is one of its own, and the
// windowed one asks the desktop otherwise — which started every window, and
// so everything in them. What neither started (the services under the desktop)
// stays out of reach. rc is 0, or E_NOENT for a process out of reach.

let is i64 as TTY_FD        with imut = 8;
let is i64 as MSG_TTY_SIZE  with imut = 1;
let is i64 as MSG_TTY_CATCH with imut = 2;
let is i64 as MSG_TTY_EVENT with imut = 3;
let is i64 as MSG_TTY_KILL  with imut = 4;
let is i64 as MSG_BYTES     with imut = 32;
let is i64 as EV_INTR       with imut = 1;
let is i64 as EV_HUP        with imut = 2;

// An event that arrived while size() was waiting for its answer.
let is i64 as pending_ev with mut = 0;

fn _wr(fd as i64, buf as i64, n as i64) as i64 { return syscall(11, fd, buf, n); }
fn _rd(fd as i64, buf as i64, n as i64) as i64 { return syscall(10, fd, buf, n); }

// Write all n bytes of buf, or fail.
fn _write_all(fd as i64, buf as i64, n as i64) as i64 {
    let is i64 as done with mut = 0;
    while (done < n) {
        let is i64 as w = _wr(fd, buf + done, n - done);
        if (w <= 0) { return 0 - 1; }
        done = done + w;
    }
    return 0;
}

// size — the terminal's columns and rows, asked over TTY_FD. 0, or -1 when the
// output is not a terminal (no TTY_FD) or it did not answer.
fn size(cols as *i64, rows as *i64) as i64 {
    let is [4]i64 as m;
    m[0] = MSG_TTY_SIZE; m[1] = 0; m[2] = 0; m[3] = 0;
    if (_write_all(TTY_FD, cast(i64, &m[0]), MSG_BYTES) != 0) { return 0 - 1; }
    while (1 == 1) {
        if (_read_msg(cast(*i64, &m[0])) != 0) { return 0 - 1; }
        if (m[0] == MSG_TTY_EVENT) { pending_ev = pending_ev | m[1]; }
        else if (m[0] == MSG_TTY_SIZE) {
            if (m[1] <= 0) { return 0 - 1; }
            *cols = m[1];
            *rows = m[2];
            return 0;
        }
    }
    return 0 - 1;
}

fn _read_msg(m as *i64) as i64 {
    let is i64 as got with mut = 0;
    while (got < MSG_BYTES) {
        let is i64 as r = _rd(TTY_FD, cast(i64, m) + got, MSG_BYTES - got);
        if (r <= 0) { return 0 - 1; }
        got = got + r;
    }
    return 0;
}

// catch — deliver the events in `mask` (EV_INTR | EV_HUP) to this program
// instead of ending it. 0, or -1 when the output is not a terminal.
fn catch(mask as i64) as i64 {
    let is [4]i64 as m;
    m[0] = MSG_TTY_CATCH; m[1] = mask; m[2] = 0; m[3] = 0;
    return _write_all(TTY_FD, cast(i64, &m[0]), MSG_BYTES);
}

// next_event — the events that have arrived (a mask of EV_*), 0 if none. Call
// it when TTY_FD polls readable; it does not wait.
fn next_event() as i64 {
    let is i64 as ev with mut = pending_ev;
    pending_ev = 0;
    let is [3]i64 as pe;
    pe[0] = TTY_FD; pe[1] = 1; pe[2] = 0;                 // POLL_READABLE
    while (syscall(34, cast(i64, &pe[0]), 1, 0) > 0 && (pe[2] & 1) != 0) {
        let is [4]i64 as m;
        if (_read_msg(cast(*i64, &m[0])) != 0) { return ev; }
        if (m[0] == MSG_TTY_EVENT) { ev = ev | m[1]; }
        pe[2] = 0;
    }
    return ev;
}

// kill — ask the terminal to end process `pid` (and everything it started).
// The answer: 0 when it was ended, E_NOENT (-9) when it is out of the
// terminal's and the desktop's reach, E_BADF (-4) when the output is not a
// terminal, E_AGAIN (-8) when the terminal did not answer within 3 s. Events
// that arrive meanwhile are kept for next_event().
fn kill(pid as i64) as i64 {
    let is [4]i64 as m;
    m[0] = MSG_TTY_KILL; m[1] = pid; m[2] = 0; m[3] = 0;
    if (_write_all(TTY_FD, cast(i64, &m[0]), MSG_BYTES) != 0) { return 0 - 4; }
    let is i64 as deadline = syscall(1) + 3000000000;        // SYS_TIME_NS
    while (1 == 1) {
        let is i64 as left = deadline - syscall(1);
        if (left <= 0) { return 0 - 8; }
        let is [3]i64 as pe;
        pe[0] = TTY_FD; pe[1] = 1; pe[2] = 0;                 // POLL_READABLE
        syscall(34, cast(i64, &pe[0]), 1, left);
        if ((pe[2] & 1) != 0) {
            if (_read_msg(cast(*i64, &m[0])) != 0) { return 0 - 4; }
            if (m[0] == MSG_TTY_EVENT) { pending_ev = pending_ev | m[1]; }
            else if (m[0] == MSG_TTY_KILL && m[1] == pid) { return m[2]; }
        }
    }
    return 0 - 8;
}

// The terminal's side of a kill: the answer for `pid`.
fn kill_reply(fd as i64, pid as i64, rc as i64) as i64 {
    let is [4]i64 as m;
    m[0] = MSG_TTY_KILL; m[1] = pid; m[2] = rc; m[3] = 0;
    return _write_all(fd, cast(i64, &m[0]), MSG_BYTES);
}

// The terminal's side of an event: tell the program on fd.
fn send_event(fd as i64, kind as i64) as i64 {
    let is [4]i64 as m;
    m[0] = MSG_TTY_EVENT; m[1] = kind; m[2] = 0; m[3] = 0;
    return _write_all(fd, cast(i64, &m[0]), MSG_BYTES);
}

// is_tty — whether this process's output is a terminal.
fn is_tty() as i64 {
    let is i64 as c with mut = 0;
    let is i64 as r with mut = 0;
    if (size(&c, &r) == 0) { return 1; }
    return 0;
}

// answer — the terminal's side: serve the requests waiting on fd, one job's
// end of the channel. `fill`/`acc` hold a request split across reads; a
// MSG_TTY_CATCH sets *caught. Returns -1 once the process has gone (its end
// closed), 1 when it asked for a process to be ended — the pid is in
// *kill_pid, and the terminal answers with kill_reply — and 0 otherwise.
fn answer(fd as i64, fill as *i64, acc as *u8, cols as i64, rows as i64, caught as *i64, kill_pid as *i64) as i64 {
    let is i64 as have = *fill;
    let is i64 as r = _rd(fd, cast(i64, acc) + have, MSG_BYTES - have);
    if (r <= 0) { return 0 - 1; }
    if (have + r < MSG_BYTES) { *fill = have + r; return 0; }
    *fill = 0;
    let is *i64 as m = cast(*i64, cast(i64, acc));
    if (m[0] == MSG_TTY_SIZE) {
        let is [4]i64 as rep;
        rep[0] = MSG_TTY_SIZE; rep[1] = cols; rep[2] = rows; rep[3] = 0;
        _write_all(fd, cast(i64, &rep[0]), MSG_BYTES);
    } else if (m[0] == MSG_TTY_CATCH) {
        *caught = m[1] & (EV_INTR | EV_HUP);
    } else if (m[0] == MSG_TTY_KILL) {
        *kill_pid = m[1];
        return 1;
    }
    return 0;
}
