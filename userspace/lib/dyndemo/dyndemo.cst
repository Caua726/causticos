// dyndemo.cst — the smallest thing that proves dynamic linking end to end.
// Its body lives in /lib/libdyndemo.csl, not in the programs that call it.
use "../../../../Caustic/std/causticos/prog.cst" as prog;

fn greet() as void {
    prog.outs("dyndemo: this text lives in libdyndemo.csl\n");
    return;
}

fn add(a as i64, b as i64) as i64 { return a + b; }
