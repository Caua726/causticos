// root.cst — the stub root a shared build needs.
//
// A .csl exports what the compilation defines, and mangled names are relative
// to the module's path FROM THE ROOT. Building dyndemo.cst directly would
// export bare `greet`, which is not the name a program importing it emits
// (`_dyndemo_cst_greet` from here). So the library is built through a root that
// imports it exactly as its users do, and references every entry point so
// dead-code elimination keeps them.
use "dyndemo.cst" as d;

fn _keep() as i64 { d.greet(); return d.add(1, 2); }
