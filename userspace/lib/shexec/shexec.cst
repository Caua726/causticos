// shexec.cst — turning a typed line into running processes.
//
// One line goes through five passes, in this order, because each one produces
// the input the next one expects:
//
//   1. expand   $VAR, $?, $$ and $(cmd) are replaced by their text
//   2. tokenise quotes are removed, words are split on unquoted whitespace
//   3. split    words are cut into pipeline stages on '|'
//   4. redirect >, >>, <, 2>&1 are lifted out of each stage's argv
//   5. glob     *, ? and [..] are matched against the directory
//
// Globbing last is deliberate: an expansion that yields "*.cst" must still be
// matched, and a quoted "*" must not be. Only step 5 is skipped for quoted
// words, which is why quoting is tracked per word rather than stripped early.
//
// Both shells share this. The only thing they differ on is the extra channel
// they hand a child (the windowed one gives it a control endpoint), which is
// why that is a parameter and not a policy baked in here.
use "std/os/causticos.cst" as sys;
use "std/causticos/term.cst" as term;
use "../jobs/jobs.cst" as jobs;
use "../netproto/netproto.cst" as np;
use "../netcli/netsvc.cst" as netsvc;
use "../sndcli/sndcli.cst" as sndcli;
use "../sndproto/sndproto.cst" as sp;
use "../ttyproto/ttyproto.cst" as tty;
use "../glob/glob.cst" as glob;
use "std/causticos/prog.cst" as prog;
use "../grow/grow.cst" as grow;

// Every table in this file grows instead of having a size picked for it
// (lib/grow): reserved once as address space, backed with memory only as far
// as a line reaches. They were 8 stages, 64 words and 4096 bytes of them, and
// what did not fit was cut without a word — a glob past 64 names lost the
// rest, so `rm *` in a big directory removed part of it and said nothing. The
// reservations are far past what one command can carry (spawn takes ARGV_MAX,
// 256 KiB, of arguments); reaching one, or running out of memory first, makes
// the line fail with the reason (room_error), never run shorter.
let is i64 as BYTES_LIMIT with imut = 67108864;   // a line, its expansion, its words
let is i64 as WORDS_LIMIT with imut = 4194304;    // words in one line
let is i64 as CMDS_LIMIT  with imut = 1048576;    // stages in one pipeline

// A pipeline stage: a slice of the word table plus where its ends are wired.
struct Cmd {
    w0 as i64;          // first word index
    wn as i64;          // word count (argv)
    in_w as i64;        // word index of a '<' target, or -1
    out_w as i64;       // word index of a '>' / '>>' target, or -1
    append as i64;      // 1 when the redirect was '>>'
    err_to_out as i64;  // 1 when '2>&1' was seen
}

let is grow.Grow as cmd_g with mut;
let is i64 as ncmd with mut = 0;
let is i64 as prepared_program with mut = 0; // one literal image path, not shell source

// The word table. Words point INTO wbuf, which holds everything expansion and
// globbing produced; the original line is never referenced past tokenising.
// The tables never move once made, so these pointers stay good as they grow.
let is grow.Grow as woff_g with mut;
let is grow.Grow as wlen_g with mut;
let is grow.Grow as wq_g with mut;
let is grow.Grow as wbuf_g with mut;
let is *i64 as w_off with mut = cast(*i64, 0);
let is *i64 as w_len with mut = cast(*i64, 0);
let is *i64 as w_quoted with mut = cast(*i64, 0);   // 1 = came from quotes, never globbed
let is i64 as nword with mut = 0;
let is *u8 as wbuf with mut = cast(*u8, 0);
let is i64 as wfill with mut = 0;
let is i64 as wbase with mut = 0;            // where tokenise starts in wbuf (see capture)

let is grow.Grow as exp_g with mut;
let is *u8 as expbuf with mut = cast(*u8, 0); // the line after pass 1

// glob_words builds the new word table here, then copies it back.
let is grow.Grow as goff_g with mut;
let is grow.Grow as glen_g with mut;
let is grow.Grow as gq_g with mut;

// exec's argv for one stage: {pointer, length} pairs.
let is grow.Grow as av_g with mut;

// args_split's words for builtins: {pointer, length} pairs, a stack (see there).
let is grow.Grow as args_g with mut;
let is i64 as args_top with mut = 0;          // words in use on it

// list_begin's own copy of the line and its parts (see "lists").
let is grow.Grow as list_g with mut;
let is grow.Grow as loff_g with mut;
let is grow.Grow as llen_g with mut;
let is grow.Grow as lop_g with mut;
let is *u8 as l_line with mut = cast(*u8, 0);
let is *i64 as l_off with mut = cast(*i64, 0);
let is *i64 as l_len with mut = cast(*i64, 0);
let is *i64 as l_op with mut = cast(*i64, 0);  // the operator after each part

// The variables (see "environment").
let is grow.Grow as envt_g with mut;
let is grow.Grow as env_g with mut;
let is *i64 as env_tab with mut = cast(*i64, 0);
let is *u8 as envbuf with mut = cast(*u8, 0);

// resolve works here, which can be longer than a path for a moment: a long
// name followed by ".." is folded back below PATH_MAX before it is judged.
let is grow.Grow as res_g with mut;

let is i64 as ready with mut = 0;              // 1 = the tables are reserved

// Why the line cannot go on: 0, or E_2BIG (past a reservation) or E_NOMEM.
// Set by whatever ran out first; the shells print room_text and run nothing,
// because a line that had to be shortened is a DIFFERENT line.
let is i64 as room_err with mut = 0;
fn room_error() as i64 { return room_err; }
fn room_text(e as i64) as *u8 {
    if (e == sys.E_2BIG) { return cast(*u8, "line too long: more than the shell can hold"); }
    return cast(*u8, "not enough memory for this line");
}

// Reserve every table, once. 0, or E_NOMEM.
fn _ready() as i64 {
    if (ready == 1) { return 0; }
    if (grow.init(&cmd_g, CMDS_LIMIT * sizeof(Cmd)) != 0) { return sys.E_NOMEM; }
    if (grow.init(&woff_g, WORDS_LIMIT * 8) != 0) { return sys.E_NOMEM; }
    if (grow.init(&wlen_g, WORDS_LIMIT * 8) != 0) { return sys.E_NOMEM; }
    if (grow.init(&wq_g, WORDS_LIMIT * 8) != 0) { return sys.E_NOMEM; }
    if (grow.init(&goff_g, WORDS_LIMIT * 8) != 0) { return sys.E_NOMEM; }
    if (grow.init(&glen_g, WORDS_LIMIT * 8) != 0) { return sys.E_NOMEM; }
    if (grow.init(&gq_g, WORDS_LIMIT * 8) != 0) { return sys.E_NOMEM; }
    if (grow.init(&av_g, WORDS_LIMIT * 16) != 0) { return sys.E_NOMEM; }
    if (grow.init(&wbuf_g, BYTES_LIMIT) != 0) { return sys.E_NOMEM; }
    if (grow.init(&exp_g, BYTES_LIMIT) != 0) { return sys.E_NOMEM; }
    if (grow.init(&list_g, BYTES_LIMIT) != 0) { return sys.E_NOMEM; }
    if (grow.init(&loff_g, WORDS_LIMIT * 8) != 0) { return sys.E_NOMEM; }
    if (grow.init(&llen_g, WORDS_LIMIT * 8) != 0) { return sys.E_NOMEM; }
    if (grow.init(&lop_g, WORDS_LIMIT * 8) != 0) { return sys.E_NOMEM; }
    if (grow.init(&args_g, WORDS_LIMIT * 16) != 0) { return sys.E_NOMEM; }
    if (grow.init(&env_g, BYTES_LIMIT) != 0) { return sys.E_NOMEM; }
    if (grow.init(&envt_g, WORDS_LIMIT * 32) != 0) { return sys.E_NOMEM; }
    if (grow.init(&res_g, BYTES_LIMIT) != 0) { return sys.E_NOMEM; }
    w_off = grow.words(&woff_g);
    w_len = grow.words(&wlen_g);
    w_quoted = grow.words(&wq_g);
    wbuf = grow.bytes(&wbuf_g);
    expbuf = grow.bytes(&exp_g);
    l_line = grow.bytes(&list_g);
    l_off = grow.words(&loff_g);
    l_len = grow.words(&llen_g);
    l_op = grow.words(&lop_g);
    envbuf = grow.bytes(&env_g);
    env_tab = grow.words(&envt_g);
    ready = 1;
    return 0;
}

// Room for `n` bytes or words of `g` from its start. 1, or 0 with room_err
// saying why not.
fn _room(g as *grow.Grow, n as i64) as i64 {
    let is i64 as rc = grow.need(g, n);
    if (rc == 0) { return 1; }
    if (room_err == 0) { room_err = rc; }
    return 0;
}

// Room for `more` bytes past wfill.
fn _wroom(more as i64) as i64 { return _room(&wbuf_g, wfill + more); }

fn cmd_at(i as i64) as *Cmd { return cast(*Cmd, cmd_g.base + i * sizeof(Cmd)); }

// Status of the last foreground command, for '$?'.
let is i64 as last_status with mut = 0;
fn set_status(v as i64) as void { last_status = v; return; }
fn status() as i64 { return last_status; }

// ---- current directory -----------------------------------------------------
//
// The kernel has no cwd and must not grow one: "no ambient global namespace" is
// the second principle, and a per-process directory the kernel resolves against
// is exactly that. So the shell keeps one itself and hands the VFS absolute
// paths only. Each child is handed the directory as it is at the spawn, at
// sys.DIR_FD (prog.dir_handoff), and resolves its own relative paths there.
let is [256]u8 as cwd with mut;
let is i64 as cwd_len with mut = 0;

fn cwd_init() as void {
    cwd[0] = cast(u8, 47);      // "/"
    cwd_len = 1;
    env_set(cast(*u8, "PWD"), 3, cast(*u8, &cwd[0]), 1);
    return;
}
fn cwd_ptr() as *u8 { return cast(*u8, &cwd[0]); }
fn cwd_size() as i64 { return cwd_len; }

// resolve — make `path` absolute against the cwd, folding "." and ".." as it
// goes. Returns a NUL-terminated pointer valid until the next call, or 0 when
// the result is longer than a path can be (prog.PATH_MAX) or there is no
// memory to work in. It used to stop copying at 250 bytes and hand back the
// shortened path — a redirect into a long path wrote to a different file.
fn resolve(path as *u8, len as i64) as *u8 {
    if (_ready() != 0) { return cast(*u8, 0); }
    if (grow.need(&res_g, cwd_len + len + 3) != 0) { return cast(*u8, 0); }
    let is *u8 as rb = grow.bytes(&res_g);
    let is i64 as n with mut = 0;
    if (len > 0 && path[0] == cast(u8, 47)) { rb[0] = cast(u8, 47); n = 1; }
    else {
        let is i64 as i with mut = 0;
        while (i < cwd_len) { rb[n] = cwd[i]; n = n + 1; i = i + 1; }
        if (n == 0 || rb[n - 1] != cast(u8, 47)) { rb[n] = cast(u8, 47); n = n + 1; }
    }
    let is i64 as p with mut = 0;
    while (p < len) {
        while (p < len && path[p] == cast(u8, 47)) { p = p + 1; }
        let is i64 as st = p;
        while (p < len && path[p] != cast(u8, 47)) { p = p + 1; }
        let is i64 as cl = p - st;
        if (cl == 0) { }
        else if (cl == 1 && path[st] == cast(u8, 46)) { }             // "."
        else if (cl == 2 && path[st] == cast(u8, 46) && path[st+1] == cast(u8, 46)) {
            // ".." — walk back over the previous component, never past the root.
            if (n > 1) {
                n = n - 1;                                            // drop the trailing '/'
                while (n > 1 && rb[n - 1] != cast(u8, 47)) { n = n - 1; }
            }
        } else {
            let is i64 as k with mut = 0;
            while (k < cl) { rb[n] = path[st + k]; n = n + 1; k = k + 1; }
            rb[n] = cast(u8, 47); n = n + 1;
        }
    }
    if (n > 1 && rb[n - 1] == cast(u8, 47)) { n = n - 1; }        // no trailing slash
    if (n == 0) { rb[0] = cast(u8, 47); n = 1; }
    if (n > prog.PATH_MAX) { return cast(*u8, 0); }
    rb[n] = cast(u8, 0);
    return rb;
}

// cd — the directory must exist AND be a directory; anything else leaves the
// shell where it was rather than silently moving somewhere unusable. 0; -1 no
// such directory; -2 not a directory; -3 a path longer than one can be.
fn cd(path as *u8, len as i64) as i64 {
    let is *u8 as abs = resolve(path, len);
    if (cast(i64, abs) == 0) { return 0 - 3; }
    let is i64 as fd = sys.open_read(abs);
    if (fd < 0) { return 0 - 1; }
    // A readdir on a plain file fails, which is how a non-directory is caught
    // without a stat that reports the type.
    let is [320]u8 as de;
    let is i64 as rc = sys.readdir(fd, cast(*u8, &de[0]));
    sys.close(fd);
    if (rc < 0) { return 0 - 2; }
    let is i64 as n with mut = 0;
    while (abs[n] != cast(u8, 0)) { cwd[n] = abs[n]; n = n + 1; }
    cwd_len = n;
    // $PWD is how a relative name reaches a CHILD: the child has no directory
    // of its own, so `cat $PWD/note.txt` is the explicit form of what other
    // systems do behind your back.
    env_set(cast(*u8, "PWD"), 3, cast(*u8, &cwd[0]), cwd_len);
    return 0;
}

// ---- environment -----------------------------------------------------------
//
// The shell's own table, not something the kernel knows: causticos has no
// ambient environment, and a child receives argv only. `export` therefore means
// "remember this for expansion", which is the honest scope of it here.
//
// Four words an entry in env_tab — name offset, name length, value offset,
// value length — and the bytes in envbuf (both declared at the top). Both
// grow (lib/grow): they were 32 variables and 2048 bytes, and `export` said
// "no room" past them. A value replaced by a longer one is appended and its
// old bytes are dead; once the dead bytes outweigh the live ones the arena is
// packed, so a loop setting a variable a million times does not keep a
// million copies of it.
let is i64 as nenv with mut = 0;
let is i64 as envfill with mut = 0;
let is i64 as envdead with mut = 0;          // bytes of envbuf no entry points at

fn _eq(a as *u8, alen as i64, b as *u8, blen as i64) as i64 {
    if (alen != blen) { return 0; }
    let is i64 as i with mut = 0;
    while (i < alen) { if (a[i] != b[i]) { return 0; } i = i + 1; }
    return 1;
}

fn env_find(name as *u8, len as i64) as i64 {
    let is i64 as i with mut = 0;
    while (i < nenv) {
        if (_eq(env_name(i), env_name_len(i), name, len) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// Copy n bytes to envbuf[at..]. src may itself be in envbuf (a value set from
// another variable's): ranges that overlap are copied in the safe direction.
fn _env_copy(at as i64, src as *u8, n as i64) as void {
    let is *u8 as d = cast(*u8, cast(i64, envbuf) + at);
    if (cast(i64, d) <= cast(i64, src)) {
        let is i64 as i with mut = 0;
        while (i < n) { d[i] = src[i]; i = i + 1; }
    } else {
        let is i64 as j with mut = n;
        while (j > 0) { j = j - 1; d[j] = src[j]; }
    }
    return;
}

// Lay every live name and value end to end from the start of envbuf, through
// a scratch mapping. Packing is only economy: when the scratch cannot be had
// the arena simply stays as it is.
fn _env_pack() as void {
    let is i64 as live = envfill - envdead;
    if (live <= 0) { envfill = 0; envdead = 0; return; }
    let is i64 as sz = ((live + 4095) / 4096) * 4096;
    let is i64 as tmp = sys.mmap(0, sz, sys.PROT_READ | sys.PROT_WRITE);
    if (tmp < 0) { return; }
    let is *u8 as tp = cast(*u8, tmp);
    let is i64 as n with mut = 0;
    let is i64 as i with mut = 0;
    while (i < nenv) {
        let is *u8 as nm = env_name(i);
        let is i64 as k with mut = 0;
        while (k < env_tab[i * 4 + 1]) { tp[n + k] = nm[k]; k = k + 1; }
        env_tab[i * 4] = n;
        n = n + env_tab[i * 4 + 1];
        let is *u8 as v = env_val(i);
        k = 0;
        while (k < env_tab[i * 4 + 3]) { tp[n + k] = v[k]; k = k + 1; }
        env_tab[i * 4 + 2] = n;
        n = n + env_tab[i * 4 + 3];
        i = i + 1;
    }
    let is i64 as c with mut = 0;
    while (c < n) { envbuf[c] = tp[c]; c = c + 1; }
    envfill = n;
    envdead = 0;
    sys.munmap(tmp, sz);
    return;
}

// env_set — set name to val. The slot, or E_NOMEM / E_2BIG when the table or
// its bytes cannot grow (env_err_text says it in words).
fn env_set(name as *u8, nlen as i64, val as *u8, vlen as i64) as i64 {
    let is i64 as rd = _ready();
    if (rd != 0) { return rd; }
    let is i64 as slot with mut = env_find(name, nlen);
    if (slot >= 0 && vlen <= env_tab[slot * 4 + 3]) {
        // It fits where the old value is.
        _env_copy(env_tab[slot * 4 + 2], val, vlen);
        envdead = envdead + env_tab[slot * 4 + 3] - vlen;
        env_tab[slot * 4 + 3] = vlen;
        return slot;
    }
    let is i64 as add with mut = vlen;
    if (slot < 0) { add = add + nlen; }
    let is i64 as rc with mut = grow.need(&env_g, envfill + add);
    if (rc != 0) { return rc; }
    if (slot < 0) {
        rc = grow.need(&envt_g, (nenv + 1) * 32);
        if (rc != 0) { return rc; }
        slot = nenv;
        nenv = nenv + 1;
        _env_copy(envfill, name, nlen);
        env_tab[slot * 4] = envfill;
        env_tab[slot * 4 + 1] = nlen;
        envfill = envfill + nlen;
    } else {
        envdead = envdead + env_tab[slot * 4 + 3];
    }
    _env_copy(envfill, val, vlen);
    env_tab[slot * 4 + 2] = envfill;
    env_tab[slot * 4 + 3] = vlen;
    envfill = envfill + vlen;
    if (envdead > 4096 && envdead > envfill - envdead) { _env_pack(); }
    return slot;
}

fn env_err_text(e as i64) as *u8 {
    if (e == sys.E_2BIG) { return cast(*u8, "the variables take more than the shell can hold"); }
    return cast(*u8, "not enough memory for another variable");
}

fn env_unset(name as *u8, nlen as i64) as void {
    let is i64 as slot = env_find(name, nlen);
    if (slot < 0) { return; }
    envdead = envdead + env_tab[slot * 4 + 1] + env_tab[slot * 4 + 3];
    let is i64 as i with mut = slot;
    while (i + 1 < nenv) {
        env_tab[i * 4] = env_tab[(i + 1) * 4];
        env_tab[i * 4 + 1] = env_tab[(i + 1) * 4 + 1];
        env_tab[i * 4 + 2] = env_tab[(i + 1) * 4 + 2];
        env_tab[i * 4 + 3] = env_tab[(i + 1) * 4 + 3];
        i = i + 1;
    }
    nenv = nenv - 1;
    return;
}

fn env_count() as i64 { return nenv; }
fn env_name(i as i64) as *u8 { return cast(*u8, cast(i64, envbuf) + env_tab[i * 4]); }
fn env_name_len(i as i64) as i64 { return env_tab[i * 4 + 1]; }
fn env_val(i as i64) as *u8 { return cast(*u8, cast(i64, envbuf) + env_tab[i * 4 + 2]); }
fn env_val_len(i as i64) as i64 { return env_tab[i * 4 + 3]; }

// ---- pass 1: expansion -----------------------------------------------------

fn _is_name(c as i64) as i64 {
    if (c >= 48 && c <= 57) { return 1; }
    if (c >= 65 && c <= 90) { return 1; }
    if (c >= 97 && c <= 122) { return 1; }
    if (c == 95) { return 1; }
    return 0;
}

// Expansion writes into expbuf through _put, which grows it; what cannot be
// written (room_err) fails the line. A command substitution or a variable must
// never be silently shortened: a truncated command line is a DIFFERENT command.
fn _put(buf as *u8, n as *i64, c as i64) as void {
    if (_room(&exp_g, n[0] + 1) == 1) { buf[n[0]] = cast(u8, c); n[0] = n[0] + 1; }
    return;
}

fn _put_num(buf as *u8, n as *i64, v as i64) as void {
    let is i64 as x with mut = v;
    if (x < 0) { _put(buf, n, 45); x = 0 - x; }
    if (x == 0) { _put(buf, n, 48); return; }
    let is [24]u8 as b;
    let is i64 as i with mut = 24;
    while (x > 0) { i = i - 1; b[i] = cast(u8, 48 + (x % 10)); x = x / 10; }
    while (i < 24) { _put(buf, n, cast(i64, b[i])); i = i + 1; }
    return;
}

// expand_line — pass 1. Writes the rewritten line to expbuf and returns its
// length, or -1 when it could not be written whole (room_error says why).
// Single quotes suppress expansion entirely; double quotes do not. A $(...) is
// run by capture, defined after the executor it needs.
fn expand_line(src as *u8, len as i64) as i64 {
    room_err = 0;
    let is i64 as rd = _ready();
    if (rd != 0) { room_err = rd; return 0 - 1; }
    let is i64 as n with mut = 0;
    let is *u8 as out = expbuf;
    let is i64 as i with mut = 0;
    let is i64 as sq with mut = 0;
    while (i < len) {
        let is i64 as c = cast(i64, src[i]);
        if (c == 39) { sq = 1 - sq; _put(out, &n, c); i = i + 1; }
        else if (c == 36 && sq == 0 && i + 1 < len) {         // '$'
            let is i64 as c2 = cast(i64, src[i + 1]);
            if (c2 == 63) { _put_num(out, &n, last_status); i = i + 2; }        // $?
            else if (c2 == 36) { _put_num(out, &n, sys.getpid()); i = i + 2; }  // $$
            else if (c2 == 40) {                                               // $(
                let is i64 as depth with mut = 1;
                let is i64 as st = i + 2;
                let is i64 as k with mut = st;
                while (k < len && depth > 0) {
                    if (src[k] == cast(u8, 40)) { depth = depth + 1; }
                    else if (src[k] == cast(u8, 41)) { depth = depth - 1; }
                    if (depth > 0) { k = k + 1; }
                }
                if (depth != 0) { _put(out, &n, c); i = i + 1; }   // unbalanced: literal
                else {
                    capture(cast(*u8, cast(i64, src) + st), k - st, out, &n);
                    i = k + 1;
                }
            }
            else if (_is_name(c2) == 1) {
                let is i64 as st = i + 1;
                let is i64 as k with mut = st;
                while (k < len && _is_name(cast(i64, src[k])) == 1) { k = k + 1; }
                let is i64 as slot = env_find(cast(*u8, cast(i64, src) + st), k - st);
                if (slot >= 0) {
                    let is i64 as v with mut = 0;
                    let is *u8 as vp = env_val(slot);
                    while (v < env_val_len(slot)) {
                        _put(out, &n, cast(i64, vp[v]));
                        v = v + 1;
                    }
                }
                // An unset variable expands to nothing, the way every shell does.
                i = k;
            }
            else { _put(out, &n, c); i = i + 1; }
        }
        else { _put(out, &n, c); i = i + 1; }
    }
    if (room_err != 0) { return 0 - 1; }
    return n;
}

// ---- lists -------------------------------------------------------------------
//
// A typed line is a LIST of pipelines joined by
//   ;    run the next one when this one ends
//   &&   run the next one if this one succeeded (status 0)
//   ||   run the next one if this one failed
//   &    do not wait for this one (it runs in the background; status 0)
// left to right, each operator looking at the status the list has reached —
// `a && b || c` runs c when either a or b fails. They were not recognised at
// all: `echo a ; echo b` printed "a ; echo b", and `mkdir x && cd x` would
// have made directories named "&&" and "cd".
//
// list_begin finds the separators outside quotes and $(...) and keeps its own
// copy of the line: a part runs as a job the shell then waits for, and the
// editor's buffer is reused meanwhile. Each part is expanded when it runs, not
// before, so `false; echo $?` prints 1. The shells run the parts one at a time
// (list_next), resuming when the foreground job ends.
let is i64 as OP_END  with imut = 0;
let is i64 as OP_SEMI with imut = 1;
let is i64 as OP_AND  with imut = 2;
let is i64 as OP_OR   with imut = 3;
let is i64 as OP_BG   with imut = 4;
// The line and its parts grow like every other table here; they were 1024
// bytes and 32 parts, and a longer line was refused as "too many commands".
let is i64 as l_n with mut = 0;
let is i64 as l_next with mut = 0;          // the next part to consider

fn _blank(c as u8) as i64 {
    if (c == cast(u8, 32) || c == cast(u8, 9)) { return 1; }
    return 0;
}

// list_scan — from `from`, the next list operator outside quotes and $(...):
// its kind (OP_END at the end of the line), where it starts (*at) and how long
// it is (*oplen). Keeps no state between calls, so a script's command and the
// line typed at the prompt can be walked at once.
fn list_scan(line as *u8, len as i64, from as i64, at as *i64, oplen as *i64) as i64 {
    let is i64 as i with mut = from;
    let is i64 as quote with mut = 0;          // the open quote character; 0 = none
    let is i64 as paren with mut = 0;          // depth inside $( )
    while (i < len) {
        let is i64 as c = cast(i64, line[i]);
        if (quote != 0) { if (c == quote) { quote = 0; } }
        else if (c == 39 || c == 34) { quote = c; }
        else if (c == 36 && i + 1 < len && line[i + 1] == cast(u8, 40)) { paren = paren + 1; i = i + 1; }
        else if (paren > 0) {
            if (c == 40) { paren = paren + 1; }
            else if (c == 41) { paren = paren - 1; }
        }
        else if (c == 59) { at[0] = i; oplen[0] = 1; return OP_SEMI; }
        else if (c == 38) {
            if (i + 1 < len && line[i + 1] == cast(u8, 38)) { at[0] = i; oplen[0] = 2; return OP_AND; }
            if (i == 0 || line[i - 1] != cast(u8, 62)) { at[0] = i; oplen[0] = 1; return OP_BG; }
            // else the & of 2>&1
        }
        else if (c == 124 && i + 1 < len && line[i + 1] == cast(u8, 124)) { at[0] = i; oplen[0] = 2; return OP_OR; }
        i = i + 1;
    }
    at[0] = len; oplen[0] = 0;
    return OP_END;
}

// list_valid — whether line is a well-formed list: no separator without a
// command before it ("; a", "a && && b"), no && or || without one after. A
// list that is not is refused before any of it runs.
fn list_valid(line as *u8, len as i64) as i64 {
    let is i64 as start with mut = 0;
    let is i64 as prev with mut = OP_SEMI;
    while (1 == 1) {
        let is i64 as at with mut = 0;
        let is i64 as oplen with mut = 0;
        let is i64 as op = list_scan(line, len, start, &at, &oplen);
        let is i64 as a with mut = start;
        let is i64 as b with mut = at;
        while (a < b && _blank(line[a]) == 1) { a = a + 1; }
        while (b > a && _blank(line[b - 1]) == 1) { b = b - 1; }
        if (a == b) {
            // Nothing here: fine only at the end, after ';' or '&'.
            if (op != OP_END || prev == OP_AND || prev == OP_OR) { return 0; }
            return 1;
        }
        if (op == OP_END) { return 1; }
        prev = op;
        start = at + oplen;
    }
    return 1;
}

// Split line into the list. Returns the number of parts (0 for a blank line);
// -1 when it is not a well-formed list (list_valid); -2 when the line could
// not be kept (room_error says why).
fn list_begin(line as *u8, len as i64) as i64 {
    l_n = 0;
    l_next = 0;
    room_err = 0;
    if (list_valid(line, len) == 0) { return 0 - 1; }
    let is i64 as rd = _ready();
    if (rd != 0) { room_err = rd; return 0 - 2; }
    if (_room(&list_g, len + 1) == 0) { return 0 - 2; }
    let is i64 as k with mut = 0;
    while (k < len) { l_line[k] = line[k]; k = k + 1; }
    let is i64 as start with mut = 0;
    while (1 == 1) {
        let is i64 as at with mut = 0;
        let is i64 as oplen with mut = 0;
        let is i64 as op = list_scan(l_line, len, start, &at, &oplen);
        let is i64 as a with mut = start;
        let is i64 as b with mut = at;
        while (a < b && _blank(l_line[a]) == 1) { a = a + 1; }
        while (b > a && _blank(l_line[b - 1]) == 1) { b = b - 1; }
        if (a == b) { return l_n; }                     // the end, after ';' or '&'
        if (_room(&loff_g, (l_n + 1) * 8) == 0 || _room(&llen_g, (l_n + 1) * 8) == 0
            || _room(&lop_g, (l_n + 1) * 8) == 0) { l_n = 0; return 0 - 2; }
        l_off[l_n] = a; l_len[l_n] = b - a; l_op[l_n] = op;
        l_n = l_n + 1;
        if (op == OP_END) { return l_n; }
        start = at + oplen;
    }
    return l_n;
}

// The next part to run, if any: *p/*n its text, *bg 1 when it is to run in the
// background. A part after && runs only if the status so far is 0, after || only
// if it is not; one that does not run leaves the status as it was. 1 = a part,
// 0 = the list is done.
fn list_next(p as *i64, n as *i64, bg as *i64) as i64 {
    while (l_next < l_n) {
        let is i64 as i = l_next;
        l_next = i + 1;
        let is i64 as run with mut = 1;
        if (i > 0) {
            if (l_op[i - 1] == OP_AND && last_status != 0) { run = 0; }
            if (l_op[i - 1] == OP_OR && last_status == 0) { run = 0; }
        }
        if (run == 1) {
            p[0] = cast(i64, l_line) + l_off[i];
            n[0] = l_len[i];
            bg[0] = 0;
            if (l_op[i] == OP_BG) { bg[0] = 1; }
            return 1;
        }
    }
    l_n = 0;
    l_next = 0;
    return 0;
}

// Parts still to consider — the shell resumes the list when its foreground job
// ends.
fn list_pending() as i64 { if (l_next < l_n) { return 1; } return 0; }

// Ctrl+C ends the list with the job: the rest of the line was typed to follow
// a command the user just stopped.
fn list_cancel() as void { l_n = 0; l_next = 0; return; }

// ---- pass 2: tokenise ------------------------------------------------------

// Append a word to the table, growing it. 0 with room_err set when it cannot.
fn _wpush(off as i64, len as i64, quoted as i64) as void {
    let is i64 as at = (nword + 1) * 8;
    if (_room(&woff_g, at) == 0 || _room(&wlen_g, at) == 0 || _room(&wq_g, at) == 0) { return; }
    w_off[nword] = off; w_len[nword] = len; w_quoted[nword] = quoted;
    nword = nword + 1;
    return;
}

fn word_ptr(i as i64) as *u8 { return cast(*u8, cast(i64, wbuf) + w_off[i]); }
fn word_len(i as i64) as i64 { return w_len[i]; }

// tokenise — pass 2. Splits on unquoted blanks — space, tab and newline — and
// keeps '|' '<' '>' '>>' as their own words so pass 3 and 4 can see them.
// Quotes are removed here and remembered per word so globbing can skip them.
// The words never take more bytes than the line they came from, so room for
// them is made once, here.
//
// A typed line never holds a newline (Enter ends it), so the newlines here
// are the ones expansion put in — `$(seq 1 3)` is three words, as in every
// shell, where it used to be one word with the newlines inside it and a `for`
// over it ran once. Quoted, "$(seq 1 3)" stays one word, newlines and all.
fn _sep(c as i64) as i64 {
    if (c == 32 || c == 9 || c == 10) { return 1; }
    return 0;
}

fn tokenise(src as *u8, len as i64) as i64 {
    prepared_program = 0;
    nword = 0; wfill = wbase;
    if (_ready() != 0 || _wroom(len + 8) == 0) {
        if (room_err == 0) { room_err = sys.E_NOMEM; }
        return 0;
    }
    let is i64 as i with mut = 0;
    while (i < len) {
        while (i < len && _sep(cast(i64, src[i])) == 1) { i = i + 1; }
        if (i >= len) { i = len; }
        else {
            let is i64 as c = cast(i64, src[i]);
            if (c == 124) {                                    // '|'
                let is i64 as o = wfill;
                wbuf[wfill] = cast(u8, 124); wfill = wfill + 1;
                _wpush(o, 1, 1);
                i = i + 1;
            } else if (c == 60) {                              // '<'
                let is i64 as o = wfill;
                wbuf[wfill] = cast(u8, 60); wfill = wfill + 1;
                _wpush(o, 1, 1);
                i = i + 1;
            } else if (c == 50 && i + 3 < len && src[i+1] == cast(u8, 62)
                       && src[i+2] == cast(u8, 38) && src[i+3] == cast(u8, 49)) {
                // "2>&1" is ONE operator, not the word "2" followed by a
                // redirect to a file named "&1" — which is what splitting it on
                // '>' silently produced, sending the output to a file instead
                // of merging the streams.
                let is i64 as o = wfill;
                wbuf[wfill] = cast(u8, 50); wbuf[wfill+1] = cast(u8, 62);
                wbuf[wfill+2] = cast(u8, 38); wbuf[wfill+3] = cast(u8, 49);
                wfill = wfill + 4;
                _wpush(o, 4, 1);
                i = i + 4;
            } else if (c == 62) {                              // '>' or '>>'
                let is i64 as o = wfill;
                wbuf[wfill] = cast(u8, 62); wfill = wfill + 1;
                let is i64 as wl with mut = 1;
                if (i + 1 < len && src[i + 1] == cast(u8, 62)) {
                    wbuf[wfill] = cast(u8, 62); wfill = wfill + 1; wl = 2; i = i + 1;
                }
                _wpush(o, wl, 1);
                i = i + 1;
            } else {
                let is i64 as o = wfill;
                let is i64 as q with mut = 0;
                let is i64 as done with mut = 0;
                while (i < len && done == 0) {
                    let is i64 as ch = cast(i64, src[i]);
                    if (ch == 34 || ch == 39) {                // '"' or '\''
                        let is i64 as close = ch;
                        q = 1;
                        i = i + 1;
                        while (i < len && cast(i64, src[i]) != close) {
                            wbuf[wfill] = src[i]; wfill = wfill + 1;
                            i = i + 1;
                        }
                        if (i < len) { i = i + 1; }            // skip the closer
                    } else if (_sep(ch) == 1 || ch == 124 || ch == 60 || ch == 62) {
                        done = 1;
                    } else {
                        wbuf[wfill] = src[i]; wfill = wfill + 1;
                        i = i + 1;
                    }
                }
                _wpush(o, wfill - o, q);
            }
        }
    }
    return nword;
}

// ---- pass 5: glob ----------------------------------------------------------

// fnmatch — a name against a pattern, the way every shell does it: lib/glob
// with a leading '.' matched only by a '.', so `*` leaves hidden files and the
// directory's own "." and ".." alone.
fn fnmatch(pat as *u8, plen as i64, nm as *u8, nlen as i64) as i64 {
    return glob.fnmatch(pat, plen, nm, nlen, glob.FL_PERIOD);
}

fn has_meta(w as i64) as i64 {
    if (w_quoted[w] == 1) { return 0; }
    let is *u8 as p = word_ptr(w);
    let is i64 as i with mut = 0;
    while (i < w_len[w]) {
        let is i64 as c = cast(i64, p[i]);
        if (c == 42 || c == 63 || c == 91) { return 1; }
        i = i + 1;
    }
    return 0;
}

// glob_words — pass 5. Rebuilds the word table with every pattern replaced by
// the names it matched, sorted the way readdir returns them. A pattern that
// matches nothing is kept verbatim: that is what a user typing a literal '?'
// means, and it is what every shell does by default. Every match is kept —
// the new table grows with them (room_err when it cannot, and the line fails
// rather than run with part of a directory).
fn _gpush(nn as i64, off as i64, len as i64, q as i64) as i64 {
    let is i64 as at = (nn + 1) * 8;
    if (_room(&goff_g, at) == 0 || _room(&glen_g, at) == 0 || _room(&gq_g, at) == 0) { return nn; }
    let is *i64 as go = grow.words(&goff_g);
    let is *i64 as gl = grow.words(&glen_g);
    let is *i64 as gq = grow.words(&gq_g);
    go[nn] = off; gl[nn] = len; gq[nn] = q;
    return nn + 1;
}

fn glob_words() as void {
    let is i64 as nn with mut = 0;
    let is i64 as w with mut = 0;
    while (w < nword && room_err == 0) {
        if (has_meta(w) == 0) {
            nn = _gpush(nn, w_off[w], w_len[w], w_quoted[w]);
        } else {
            // Split "dir/pat" so only the last component is matched; the
            // directory part is a literal prefix on every result.
            let is *u8 as pw = word_ptr(w);
            let is i64 as slash with mut = 0 - 1;
            let is i64 as k with mut = 0;
            while (k < w_len[w]) { if (pw[k] == cast(u8, 47)) { slash = k; } k = k + 1; }
            // The prefix every match gets, and the directory to read. Without
            // a directory part both are the shell's own directory; with one,
            // the prefix is as typed and the directory is it resolved here —
            // the VFS takes absolute paths only, so `docs/*.txt` opened "docs/"
            // and never matched anything.
            let is [256]u8 as dir;
            let is i64 as dlen with mut = 0;
            let is *u8 as prefix with mut = cast(*u8, &cwd[0]);
            let is i64 as plen0 with mut = cwd_len;
            if (slash >= 0) { prefix = pw; plen0 = slash + 1; }
            let is *u8 as abs = resolve(prefix, plen0);
            if (cast(i64, abs) != 0) {
                while (abs[dlen] != cast(u8, 0)) { dir[dlen] = abs[dlen]; dlen = dlen + 1; }
            }
            dir[dlen] = cast(u8, 0);
            let is i64 as poff = w_off[w] + slash + 1;
            let is i64 as plen = w_len[w] - slash - 1;

            let is i64 as hits with mut = 0;
            let is i64 as fd with mut = 0 - 1;
            if (dlen > 0) { fd = sys.open_read(cast(*u8, &dir[0])); }
            if (fd >= 0) {
                let is [320]u8 as de;
                while (room_err == 0 && sys.readdir(fd, cast(*u8, &de[0])) == 0) {
                    let is *u8 as nm = cast(*u8, &de[0]);
                    let is *i64 as nlp = cast(*i64, cast(i64, &de[0]) + 256);
                    let is i64 as nl = nlp[0];
                    if (fnmatch(cast(*u8, cast(i64, wbuf) + poff), plen, nm, nl) == 1
                        && _wroom(plen0 + nl + 1) == 1) {
                        let is i64 as o = wfill;
                        // The directory is ALWAYS prefixed, even when the
                        // pattern carried none: the match reaches the child
                        // as the path it is, the same file in whatever
                        // directory the child resolves against.
                        let is i64 as d2 with mut = 0;
                        while (d2 < plen0) { wbuf[wfill] = prefix[d2]; wfill = wfill + 1; d2 = d2 + 1; }
                        if (wfill > o && wbuf[wfill - 1] != cast(u8, 47)) {
                            wbuf[wfill] = cast(u8, 47); wfill = wfill + 1;
                        }
                        let is i64 as m with mut = 0;
                        while (m < nl) { wbuf[wfill] = nm[m]; wfill = wfill + 1; m = m + 1; }
                        nn = _gpush(nn, o, wfill - o, 1);
                        hits = hits + 1;
                    }
                }
                sys.close(fd);
            }
            if (hits == 0) { nn = _gpush(nn, w_off[w], w_len[w], w_quoted[w]); }
        }
        w = w + 1;
    }
    if (room_err != 0) { return; }
    // The new table back into the word table, which has room for it: every
    // word it holds is either one of the old ones or a match pushed past them.
    let is *i64 as go = grow.words(&goff_g);
    let is *i64 as gl = grow.words(&glen_g);
    let is *i64 as gq = grow.words(&gq_g);
    let is i64 as at = (nn + 1) * 8;
    if (_room(&woff_g, at) == 0 || _room(&wlen_g, at) == 0 || _room(&wq_g, at) == 0) { return; }
    let is i64 as c with mut = 0;
    while (c < nn) { w_off[c] = go[c]; w_len[c] = gl[c]; w_quoted[c] = gq[c]; c = c + 1; }
    nword = nn;
    return;
}

// ---- passes 3 + 4: pipeline and redirects ----------------------------------

fn _is_op(w as i64, lit as i64) as i64 {
    if (w_len[w] != 1) { return 0; }
    if (cast(i64, wbuf[w_off[w]]) != lit) { return 0; }
    return 1;
}

// build_cmds — cut the word list into stages on '|', then lift each stage's
// redirects out of its argv. Returns the stage count; -2 for a redirect with
// no target; -1 when the stage table cannot grow (room_error says why).
fn build_cmds() as i64 {
    ncmd = 0;
    if (room_err != 0) { return 0 - 1; }
    let is i64 as w with mut = 0;
    let is i64 as start with mut = 0;
    while (w <= nword) {
        if (w == nword || _is_op(w, 124) == 1) {
            if (_room(&cmd_g, (ncmd + 1) * sizeof(Cmd)) == 0) { ncmd = 0; return 0 - 1; }
            let is *Cmd as cm = cmd_at(ncmd);
            cm.w0 = start;
            cm.wn = w - start;
            cm.in_w = 0 - 1;
            cm.out_w = 0 - 1;
            cm.append = 0;
            cm.err_to_out = 0;
            ncmd = ncmd + 1;
            start = w + 1;
        }
        w = w + 1;
    }
    // Lift redirects: scan each stage, moving '<'/'>' and their target out of
    // argv by compacting the remaining words down.
    let is i64 as c with mut = 0;
    while (c < ncmd) {
        let is *Cmd as cc = cmd_at(c);
        let is i64 as rd with mut = cc.w0;
        let is i64 as wr with mut = cc.w0;
        let is i64 as end = cc.w0 + cc.wn;
        while (rd < end) {
            let is *u8 as rp = word_ptr(rd);
            if (_is_op(rd, 60) == 1) {                          // '<'
                if (rd + 1 >= end) { return 0 - 2; }
                cc.in_w = rd + 1; rd = rd + 2;
            } else if (w_len[rd] == 1 && cast(i64, rp[0]) == 62) {   // '>'
                if (rd + 1 >= end) { return 0 - 2; }
                cc.out_w = rd + 1; cc.append = 0; rd = rd + 2;
            } else if (w_len[rd] == 2 && cast(i64, rp[0]) == 62
                                      && cast(i64, rp[1]) == 62) { // '>>'
                if (rd + 1 >= end) { return 0 - 2; }
                cc.out_w = rd + 1; cc.append = 1; rd = rd + 2;
            } else if (w_len[rd] == 4 && cast(i64, rp[0]) == 50
                       && cast(i64, rp[1]) == 62
                       && cast(i64, rp[2]) == 38
                       && cast(i64, rp[3]) == 49) {  // "2>&1"
                cc.err_to_out = 1; rd = rd + 1;
            } else {
                w_off[wr] = w_off[rd]; w_len[wr] = w_len[rd]; w_quoted[wr] = w_quoted[rd];
                // A redirect target moved down with the words; keep the index
                // pointing at the same word after compaction.
                if (cc.in_w == rd)  { cc.in_w = wr; }
                if (cc.out_w == rd) { cc.out_w = wr; }
                wr = wr + 1; rd = rd + 1;
            }
        }
        cc.wn = wr - cc.w0;
        c = c + 1;
    }
    return ncmd;
}

fn cmd_count() as i64 { return ncmd; }

// ---- execution -------------------------------------------------------------

// A redirect's file as an absolute path, or 0 when it is longer than a path
// can be. Redirect targets are FILES, so they resolve against the shell's cwd
// — unlike a command name, which is looked up where the programs live.
fn _cpath(w as i64) as *u8 { return resolve(word_ptr(w), w_len[w]); }

// prog_path — the file a command word names, into `out` (NUL-terminated, 256
// bytes), and whether a program is there. 1 = found, 0 = no such command.
//
// A bare name is a program where the programs live: "/<name>.cse". A word
// with a '/' in it is a PATH — `/greet.cse`, `./prog.cse`, `../bin/tool` —
// resolved against the shell's directory like any other file name, with
// ".cse" tried after it when the name as written is not there. It used to get
// the bare-name treatment too, so `/greet.cse` looked for "//greet.cse.cse"
// and a program anywhere but / could not be run at all.
//
// This used to be `load`: open, lseek to the end, mmap a page-rounded buffer,
// read the whole image in, and hand the bytes to spawn — which copied them
// again on its way into the child. A spawn names its source now, so the shell
// carries a path and one stat instead of a full eager-committed copy of every
// program it launches. The stat is what keeps "command not found" a distinct
// answer from "it failed to start".
fn prog_path(w as i64, out as *u8) as i64 {
    let is *u8 as wp = word_ptr(w);
    let is i64 as wl = w_len[w];
    let is i64 as slash with mut = 0;
    let is i64 as i with mut = 0;
    while (i < wl) { if (wp[i] == cast(u8, 47)) { slash = 1; } i = i + 1; }

    if (slash == 0) {
        if (wl + 5 > prog.PATH_MAX) { return 0; }          // "/" + name + ".cse"
        out[0] = cast(u8, 47);
        i = 0;
        while (i < wl) { out[1 + i] = wp[i]; i = i + 1; }
        let is *u8 as ext = ".cse";
        let is i64 as j with mut = 0;
        while (j < 4) { out[1 + wl + j] = ext[j]; j = j + 1; }
        out[1 + wl + 4] = cast(u8, 0);
        return _is_prog(out);
    }

    let is *u8 as abs = resolve(wp, wl);
    if (cast(i64, abs) == 0) { return 0; }                  // longer than any path
    let is i64 as n with mut = 0;
    while (abs[n] != cast(u8, 0)) { out[n] = abs[n]; n = n + 1; }
    out[n] = cast(u8, 0);
    if (n + 4 > prog.PATH_MAX) { return _is_prog(out); }   // no room to try ".cse"
    if (_is_prog(out) == 1) { return 1; }
    if (n >= 4 && out[n - 4] == cast(u8, 46) && out[n - 3] == cast(u8, 99)
        && out[n - 2] == cast(u8, 115) && out[n - 1] == cast(u8, 101)) {
        return 0;                                  // already ".cse": nothing else to try
    }
    out[n] = cast(u8, 46); out[n + 1] = cast(u8, 99);
    out[n + 2] = cast(u8, 115); out[n + 3] = cast(u8, 101);
    out[n + 4] = cast(u8, 0);
    return _is_prog(out);
}

// A file that is not a directory. Whether it is a program the kernel can run
// is the kernel's answer, given by spawn with the reason (E_NOEXEC, E_RANGE,
// ...); judging it here by size made an empty or oversized file "not found".
fn _is_prog(path as *u8) as i64 {
    let is [4]i64 as st;
    if (sys.stat(path, cast(*u8, &st[0])) != 0) { return 0; }
    if (st[3] != 0) { return 0; }                  // a directory is not a command
    return 1;
}

// exec — build the whole pipeline and register it as one job.
//
// Every stage is spawned before any is waited on, and each one's stdout is the
// next one's stdin: a plain chain of channel pairs, which is exactly what the
// architecture says a pipe is. The shell keeps only the ends it needs — the
// first stage's stdin and the last stage's stdout — and drops the rest as soon
// as the child that owns them exists, or the reader would never see EOF.
//
// aux_fd_slot: the child fd to install the caller's extra channel on, or -1.
// aux_maker: a channel pair the caller minted, or 0 for none.
// want_tty: 1 = the caller is a terminal and will answer ttyproto requests on
// jb.tty_fd: the stage whose stdout comes back to it gets TTY_FD.
//
// A negative result is one of EXEC_* below, and failure_text says it in words
// — with the word it was about. A redirect whose file would not open came back
// as the same -2 as a full job table, and both shells said "too many jobs" for
// `seq 1 5 > /nodir/x`; "not found" never said what was not found.
let is i64 as EXEC_NOT_FOUND with imut = 0 - 1;   // no program by that name
let is i64 as EXEC_NO_FILE   with imut = 0 - 2;   // a redirect's file would not open
let is i64 as EXEC_SPAWN     with imut = 0 - 3;   // a channel or the spawn failed
let is i64 as EXEC_EMPTY     with imut = 0 - 4;   // a pipeline stage with no command
let is i64 as EXEC_NO_SLOT   with imut = 0 - 5;   // the job table is full

let is [128]u8 as fail_word with mut;
let is i64 as fail_wlen with mut = 0;
// With EXEC_SPAWN: the errno the kernel gave, so the message can say WHY. A
// spawn fails for reasons that need different fixes — a Linux binary, a full
// memory, a file too big — and "could not start the command" named none.
let is i64 as fail_errno with mut = 0;
let is i64 as fail_spawned with mut = 0;          // 1 = spawn itself refused, 0 = a channel did

fn _set_fail_word(p as *u8, n as i64) as void {
    let is i64 as k with mut = 0;
    while (k < n && k < 127 && p[k] != cast(u8, 0)) { fail_word[k] = p[k]; k = k + 1; }
    fail_wlen = k;
    return;
}

// exec's failure `code` as a message, NUL-terminated into out (room for 192
// bytes); returns its length. The shells print it in their own error style.
fn failure_text(code as i64, out as *u8) as i64 {
    let is i64 as n with mut = 0;
    let is *u8 as what with mut = cast(*u8, "");
    let is i64 as named with mut = 1;
    if (code == EXEC_NOT_FOUND) { what = cast(*u8, ": not found"); }
    else if (code == EXEC_NO_FILE) { what = _redirect_words(fail_errno); }
    else if (code == EXEC_SPAWN && fail_spawned == 1) { what = _spawn_words(fail_errno); }
    else if (code == EXEC_SPAWN) {
        what = cast(*u8, "could not start the command: no channel for its input or output");
        if (fail_errno == sys.E_NOMEM) {
            what = cast(*u8, "could not start the command: out of memory for its input or output");
        } else if (fail_errno == sys.E_MFILE) {
            what = cast(*u8, "could not start the command: the shell has too many files open");
        }
        named = 0;
    }
    else if (code == EXEC_EMPTY) { what = cast(*u8, "syntax: | with no command on one side"); named = 0; }
    else if (code == EXEC_NO_SLOT) { what = cast(*u8, "too many jobs running; wait for one to end"); named = 0; }
    else { what = cast(*u8, "bad command"); named = 0; }
    if (named == 1) {
        let is i64 as k with mut = 0;
        while (k < fail_wlen) { out[n] = fail_word[k]; n = n + 1; k = k + 1; }
    }
    let is i64 as k2 with mut = 0;
    while (what[k2] != cast(u8, 0) && n < 189) { out[n] = what[k2]; n = n + 1; k2 = k2 + 1; }
    out[n] = cast(u8, 10); n = n + 1;
    out[n] = cast(u8, 0);
    return n;
}

// Why the kernel refused to spawn a program, after its name.
fn _spawn_words(e as i64) as *u8 {
    if (e == sys.E_NOEXEC) {
        return cast(*u8, ": not a program CausticOS runs (built for another system?)");
    }
    if (e == sys.E_NOMEM) { return cast(*u8, ": not enough free memory to start it"); }
    if (e == sys.E_RANGE) { return cast(*u8, ": too large to run (a program is at most 4 MiB)"); }
    if (e == sys.E_IO)    { return cast(*u8, ": could not be read from the disk"); }
    if (e == sys.E_MFILE) { return cast(*u8, ": too many different programs are loaded"); }
    if (e == sys.E_NOENT) { return cast(*u8, ": not found"); }
    if (e == sys.E_ISDIR) { return cast(*u8, ": is a directory"); }
    if (e == sys.E_2BIG)  { return cast(*u8, ": argument list too long (spawn takes 256 KiB of arguments)"); }
    return cast(*u8, ": could not be started");
}

// Why a redirect's file would not open, after its name. E_RANGE is the shell's
// own: a path longer than any path can be, which it does not hand the VFS.
fn _redirect_words(e as i64) as *u8 {
    if (e == sys.E_RANGE)  { return cast(*u8, ": cannot open (redirect): the path is longer than 255 bytes"); }
    if (e == sys.E_NOENT)  { return cast(*u8, ": cannot open (redirect): no such file or directory"); }
    if (e == sys.E_ISDIR)  { return cast(*u8, ": cannot open (redirect): is a directory"); }
    if (e == sys.E_NOTDIR) { return cast(*u8, ": cannot open (redirect): a part of the path is not a directory"); }
    if (e == sys.E_NOSPC)  { return cast(*u8, ": cannot open (redirect): no space left on the volume"); }
    if (e == sys.E_TXTBSY) { return cast(*u8, ": cannot open (redirect): a running program was loaded from it"); }
    return cast(*u8, ": cannot open (redirect)");
}

// Open a redirect's file: `mode` 0 read, 1 write, 2 append. The fd, or the
// errno — E_RANGE for a path too long to be one.
fn _open_redirect(w as i64, mode as i64) as i64 {
    let is *u8 as p = _cpath(w);
    if (cast(i64, p) == 0) { return sys.E_RANGE; }
    if (mode == 0) { return sys.open_read(p); }
    if (mode == 2) { return sys.open_append(p); }
    return sys.open_write(p);
}

// crash_line — if job `slot` crashed, say so on t, on a line of its own, in
// colour `col`. Returns 1 when it did. Shown where the program was running:
// the serial line is not where anyone is looking. The colour goes back before
// the line ends — a newline clears the next line in the colour current then.
fn crash_line(t as *term.Term, slot as i64, col as u32) as i64 {
    let is [192]u8 as cb;
    let is i64 as cn = jobs.crash_text(slot, cast(*u8, &cb[0]), 190);
    if (cn <= 0) { return 0; }
    let is u32 as fg = t.fg;
    let is u32 as bg = t.bg;
    if (t.cx != 0 || t.wrap_pend != 0) { term.putc(t, 10); }
    term.set_color(t, col, bg);
    term.puts(t, cast(*u8, &cb[0]), cn);
    term.set_color(t, fg, bg);
    term.putc(t, 10);
    return 1;
}

// The exit status a failure leaves, as shells report it: 127 for no such
// program, 126 for one that could not be started, 1 otherwise.
fn failure_status(code as i64) as i64 {
    if (code == EXEC_NOT_FOUND) { return 127; }
    if (code == EXEC_SPAWN) { return 126; }
    return 1;
}

fn exec(bg as i64, cmdline as *u8, cmdlen as i64,
        aux_fd_slot as i64, aux_out as *i64, want_tty as i64) as i64 {
    if (ncmd <= 0) { return EXEC_EMPTY; }
    let is i64 as slot = jobs.alloc();
    if (slot < 0) { return EXEC_NO_SLOT; }
    let is *jobs.Job as jb = jobs.get(slot);

    let is i64 as prev_read with mut = 0 - 1;      // read end of the previous stage
    let is i64 as c with mut = 0;
    let is i64 as failed with mut = 0;

    // Where the job's errors go. Every stage's fd 2 is the write end of one
    // channel per job; on a terminal it is the same channel the last stage's
    // stdout goes to, the one the shell already reads — the way a tty takes
    // both — so a complaint from the first stage of a pipeline reaches the
    // screen instead of the next stage's input, and one from `cmd > file` is
    // not lost into the file. With no terminal ($(...)) it is a channel of its
    // own (err_fd), so what a substituted command says is shown, not
    // substituted. There was no fd 2 at all unless the line said 2>&1: every
    // error a program wrote to stderr vanished, and the compiler's included.
    let is i64 as term_r with mut = 0 - 1;
    let is i64 as term_w with mut = 0 - 1;
    let is [2]i64 as ech;
    fail_spawned = 0;
    fail_errno = sys.channel_create(&ech[0]);
    if (fail_errno == 0) { term_r = ech[0]; term_w = ech[1]; }
    else { failed = 3; }

    while (c < ncmd && failed == 0) {
        let is *Cmd as cc = cmd_at(c);
        if (cc.wn <= 0) { failed = 4; }
        else {
            let is [256]u8 as ipath;
            let is *u8 as image_path with mut = cast(*u8, &ipath[0]);
            let is i64 as found with mut = 1;
            if (prepared_program == 1) { image_path = word_ptr(cc.w0); }
            else { found = prog_path(cc.w0, image_path); }
            if (found == 0) {
                failed = 1;
                _set_fail_word(word_ptr(cc.w0), word_len(cc.w0));
            }
            else {
                // stdin: the previous stage's output, an explicit '<' file, or
                // a fresh channel the shell can type into (first stage only).
                let is i64 as child_in with mut = 0 - 1;
                let is i64 as keep_in with mut = 0 - 1;
                if (prev_read >= 0) { child_in = prev_read; }
                else if (cc.in_w >= 0) {
                    child_in = _open_redirect(cc.in_w, 0);
                    if (child_in < 0) {
                        failed = 2; fail_errno = child_in;
                        _set_fail_word(word_ptr(cc.in_w), word_len(cc.in_w));
                    }
                } else {
                    let is [2]i64 as ich;
                    fail_errno = sys.channel_create(&ich[0]);
                    if (fail_errno != 0) { failed = 3; }
                    else { keep_in = ich[0]; child_in = ich[1]; }
                }

                let is i64 as child_out with mut = 0 - 1;
                let is i64 as keep_out with mut = 0 - 1;
                let is i64 as next_read with mut = 0 - 1;
                let is i64 as tty_keep with mut = 0 - 1;    // the terminal's end of TTY_FD
                let is i64 as tty_child with mut = 0 - 1;
                if (failed == 0) {
                    if (cc.out_w >= 0) {
                        if (cc.append == 1) { child_out = _open_redirect(cc.out_w, 2); }
                        else { child_out = _open_redirect(cc.out_w, 1); }
                        if (child_out < 0) {
                            failed = 2; fail_errno = child_out;
                            _set_fail_word(word_ptr(cc.out_w), word_len(cc.out_w));
                        }
                    } else if (c + 1 == ncmd && want_tty == 1) {
                        // The terminal: the job's channel, shared with every
                        // stage's stderr and closed once they all have it. This
                        // stage, and only this one, is told it has a terminal
                        // (ttyproto).
                        child_out = term_w;
                        let is [2]i64 as tch;
                        if (sys.channel_create(&tch[0]) == 0) { tty_keep = tch[0]; tty_child = tch[1]; }
                    } else {
                        let is [2]i64 as och;
                        fail_errno = sys.channel_create(&och[0]);
                        if (fail_errno != 0) { failed = 3; }
                        else {
                            child_out = och[1];
                            if (c + 1 < ncmd) { next_read = och[0]; }   // feeds the next stage
                            else { keep_out = och[0]; }                 // captured: the shell reads it
                        }
                    }
                }

                // argv: {pointer, length} for every word of the stage, in a
                // table that grows with them. The kernel takes ARGV_MAX bytes
                // of arguments and says E_2BIG past it, which is reported.
                if (failed == 0 && grow.need(&av_g, cc.wn * 16) != 0) {
                    failed = 3; fail_errno = sys.E_NOMEM; fail_spawned = 1;
                    _set_fail_word(word_ptr(cc.w0), word_len(cc.w0));
                }

                if (failed == 0) {
                    // Nine pairs at most: stdin/stdout/stderr, aux, network,
                    // audio, TTY control, the stderr-terminal marker and the
                    // directory.
                    let is [18]i64 as fdacts;
                    let is i64 as nact with mut = 2;
                    fdacts[0] = 0; fdacts[1] = child_in;
                    fdacts[2] = 1; fdacts[3] = child_out;
                    // fd 2: the job's error channel, or with '2>&1' the SAME
                    // endpoint as fd 1. There is no dup: handing one object to
                    // two slots IS the duplication.
                    fdacts[4] = 2; fdacts[5] = term_w; nact = 3;
                    let is i64 as err_tty with mut = 0;
                    if (want_tty == 1) {
                        if (cc.err_to_out == 0 || child_out == term_w) { err_tty = 1; }
                    }
                    if (cc.err_to_out == 1) { fdacts[5] = child_out; }
                    if (aux_fd_slot >= 0 && aux_out[0] >= 0) {
                        fdacts[nact*2] = aux_fd_slot; fdacts[nact*2+1] = aux_out[1];
                        nact = nact + 1;
                    }
                    // netd's and soundd's gates. A stage that uses either
                    // becomes a client of its own through the gate, so socket
                    // and stream ids still belong to one process each; a stage
                    // that does not costs the daemons nothing. -1 when there
                    // is none, and the child then finds NET_FD absent and says
                    // so — which is the correct outcome for a shell running
                    // with no network, not a reason to refuse `ls`. Borrowed:
                    // the shell keeps them for the next command.
                    let is i64 as net_g = netsvc.gate();
                    if (net_g >= 0) {
                        fdacts[nact*2] = np.NET_FD; fdacts[nact*2+1] = net_g;
                        nact = nact + 1;
                    }
                    let is i64 as snd_g = sndcli.gate();
                    if (snd_g >= 0) {
                        fdacts[nact*2] = sp.SND_FD; fdacts[nact*2+1] = snd_g;
                        nact = nact + 1;
                    }
                    if (tty_child >= 0) {
                        fdacts[nact*2] = tty.TTY_FD; fdacts[nact*2+1] = tty_child;
                        nact = nact + 1;
                    }
                    // A non-written alias marks terminal-bound stderr to programs.
                    if (err_tty == 1) {
                        fdacts[nact*2] = sys.STDERR_TTY_FD; fdacts[nact*2+1] = term_w;
                        nact = nact + 1;
                    }
                    // The directory the shell is in now: a relative path this
                    // stage is given means here, and a later cd does not move
                    // it. Its own copy, so no stage can change another's.
                    let is i64 as dir_fd = prog.dir_handoff(cast(*u8, &cwd[0]), cwd_len);
                    if (dir_fd >= 0) {
                        fdacts[nact*2] = sys.DIR_FD; fdacts[nact*2+1] = dir_fd;
                        nact = nact + 1;
                    }
                    let is *i64 as av = grow.words(&av_g);
                    let is i64 as k with mut = 0;
                    while (k < cc.wn) {
                        av[2 * k] = cast(i64, word_ptr(cc.w0 + k));
                        av[2 * k + 1] = w_len[cc.w0 + k];
                        k = k + 1;
                    }
                    let is i64 as pid = sys.spawn_path(image_path,
                                                       cast(*u8, &fdacts[0]), nact,
                                                       cast(*u8, av), k);
                    // The child owns its ends now; the shell must let go of them
                    // or the next stage never sees end-of-stream.
                    if (child_in >= 0) { sys.close(child_in); }
                    if (child_out >= 0 && child_out != term_w) { sys.close(child_out); }
                    if (tty_child >= 0) { sys.close(tty_child); tty_child = 0 - 1; }
                    if (dir_fd >= 0) { sys.close(dir_fd); }
                    let is i64 as added with mut = 0;
                    if (pid >= 0) {
                        added = jobs.add_pid(slot, pid);
                        // A stage the job cannot hold could never be reaped:
                        // it is ended now, and the line fails for want of
                        // memory like a spawn that never happened.
                        if (added != 0) { sys.kill(pid); }
                    }
                    if (pid < 0 || added != 0) {
                        failed = 3;
                        fail_errno = pid;
                        if (pid >= 0) { fail_errno = added; }
                        fail_spawned = 1;
                        _set_fail_word(word_ptr(cc.w0), word_len(cc.w0));
                        if (keep_in >= 0) { sys.close(keep_in); }
                        if (keep_out >= 0) { sys.close(keep_out); }
                        if (next_read >= 0) { sys.close(next_read); }
                        if (tty_keep >= 0) { sys.close(tty_keep); }
                    } else {
                        if (keep_in >= 0)  { jb.in_fd = keep_in; }
                        if (keep_out >= 0) { jb.out_fd = keep_out; }
                        if (tty_keep >= 0) { jb.tty_fd = tty_keep; jb.tty_fill = 0; }
                        prev_read = next_read;
                    }
                } else {
                    if (keep_in >= 0) { sys.close(keep_in); }
                    if (child_in >= 0) { sys.close(child_in); }
                    if (keep_out >= 0) { sys.close(keep_out); }
                    if (child_out >= 0 && child_out != term_w) { sys.close(child_out); }
                    if (next_read >= 0) { sys.close(next_read); }
                    if (tty_keep >= 0) { sys.close(tty_keep); }
                    if (tty_child >= 0) { sys.close(tty_child); }
                }
            }
        }
        c = c + 1;
    }
    // The stages hold the write end now; ours would keep the channel from ever
    // reaching end-of-stream.
    if (term_w >= 0) { sys.close(term_w); }
    if (term_r >= 0) {
        if (jb.npids == 0) { sys.close(term_r); }
        else if (want_tty == 1) { jb.out_fd = term_r; }
        else { jb.err_fd = term_r; }
    }
    if (failed != 0) {
        if (prev_read >= 0) { sys.close(prev_read); }
        if (jobs.get(slot).npids == 0) { jobs.release(slot); return 0 - failed; }
        // Some stages started: keep the job so they are reaped, and report.
        return 0 - failed;
    }
    jb.bg = bg;
    jobs.set_cmd(slot, cmdline, cmdlen);
    return slot;
}

// capture — $(cmd): run a line and append its stdout to `out`, all of it.
// Trailing newlines are stripped, the way command substitution is expected to
// behave. It kept 1024 bytes of the output and refused the line past them,
// and copied the command into 4096 bytes. It does not recurse — what it runs
// is tokenised, not expanded — so there is no depth to cap.
//
// The line is a list, as at the prompt: `a ; b`, `a && b`, `a || b`. Its
// commands run one after the other and what they all print is the value. A
// `&` in it separates like `;` — the value is everything printed, so the
// substitution waits for that command anyway. The whole text ran as one
// command, and `$(echo a ; echo b)` was "a ; echo b".
//
// What the commands of $(...) wrote to stderr, held until the shell that is
// expanding the line can put it on its terminal (cap_err_show). Past the
// buffer, the rest is counted and the count shown.
let is [2048]u8 as cap_err with mut;
let is i64 as cap_err_len with mut = 0;
let is i64 as cap_err_lost with mut = 0;

// Read once from `fd` into cap_err. 0 at end-of-stream or on an error.
fn _cap_err_take(fd as i64) as i64 {
    let is [256]u8 as b;
    let is i64 as got = sys.read(fd, cast(*u8, &b[0]), 256);
    if (got <= 0) { return 0; }
    let is i64 as k with mut = 0;
    while (k < got) {
        if (cap_err_len < 2048) { cap_err[cap_err_len] = b[k]; cap_err_len = cap_err_len + 1; }
        else { cap_err_lost = cap_err_lost + 1; }
        k = k + 1;
    }
    return 1;
}

// Append m[0, len) to cap_err: a complaint about $(...) that is the shell's
// own, shown with what its commands said on stderr.
fn _cap_err_add(m as *u8, len as i64) as void {
    let is i64 as k with mut = 0;
    while (k < len) {
        if (cap_err_len < 2048) { cap_err[cap_err_len] = m[k]; cap_err_len = cap_err_len + 1; }
        else { cap_err_lost = cap_err_lost + 1; }
        k = k + 1;
    }
    return;
}

fn _cap_err_add_z(m as *u8) as void {
    let is i64 as n with mut = 0;
    while (m[n] != cast(u8, 0)) { n = n + 1; }
    _cap_err_add(m, n);
    return;
}

// Put what $(...) said on stderr on the terminal, after the expansion that ran
// it. The shells call this right after prepare().
fn cap_err_show(t as *term.Term) as void {
    let is u32 as fg = t.fg;
    let is u32 as bg = t.bg;
    if (cap_err_len > 0 || cap_err_lost > 0) {
        term.set_color(t, 0x00ef5350, bg);
        if (cap_err_len > 0) {
            term.puts(t, cast(*u8, &cap_err[0]), cap_err_len);
            if (cap_err[cap_err_len - 1] != cast(u8, 10)) { term.puts(t, "\n", 1); }
        }
        if (cap_err_lost > 0) {
            let is [24]u8 as d;
            let is i64 as i with mut = 24;
            let is i64 as x with mut = cap_err_lost;
            while (x > 0) { i = i - 1; d[i] = cast(u8, 48 + (x % 10)); x = x / 10; }
            term.puts(t, "(", 1);
            term.puts(t, cast(*u8, &d[i]), 24 - i);
            term.puts(t, " more bytes on stderr not shown)\n", 33);
        }
        term.set_color(t, fg, bg);
    }
    cap_err_len = 0;
    cap_err_lost = 0;
    term.flush(t);
}

// _capture_one — one command of a $(...) list (wbase already past the
// caller's words): run it, append its stdout to out, and return its status,
// the last stage's exit code. A command that cannot start says why, with
// what the list said on stderr; it used to come out empty without a word.
fn _capture_one(src as *u8, len as i64, out as *u8, n as *i64) as i64 {
    tokenise(src, len);
    glob_words();
    let is i64 as nc = build_cmds();
    if (nc == 0 - 2) { _cap_err_add_z("syntax: redirect with no target, in $(...)\n"); return 2; }
    if (nc < 0) { _cap_err_add_z("syntax: | with no command on one side, in $(...)\n"); return 2; }
    if (nc == 0) { return 0; }
    let is i64 as slot = exec(0, src, len, 0 - 1, cast(*i64, 0), 0);
    if (slot < 0) {
        let is [192]u8 as m;
        let is i64 as ml = failure_text(slot, cast(*u8, &m[0]));
        _cap_err_add(cast(*u8, &m[0]), ml);
        return failure_status(slot);
    }
    let is *jobs.Job as jb = jobs.get(slot);
    let is [256]u8 as buf;
    let is i64 as reading with mut = 1;
    while (reading == 1) {
        let is [6]i64 as pe;
        pe[0] = jb.out_fd; pe[1] = sys.POLL_READABLE; pe[2] = 0;
        let is i64 as np with mut = 1;
        if (jb.err_fd >= 0) { pe[3] = jb.err_fd; pe[4] = sys.POLL_READABLE; pe[5] = 0; np = 2; }
        sys.poll(&pe[0], np, 1000000000);
        // Its complaints, kept for the shell to show (cap_err_show): a stage
        // blocked on a full error channel would otherwise never finish the
        // output this is waiting for.
        if (np == 2 && (pe[5] & (sys.POLL_READABLE | sys.POLL_CLOSED)) != 0) {
            if (_cap_err_take(jb.err_fd) == 0) { sys.close(jb.err_fd); jb.err_fd = 0 - 1; }
        }
        if ((pe[2] & sys.POLL_READABLE) != 0) {
            let is i64 as got = sys.read(jb.out_fd, cast(*u8, &buf[0]), 256);
            if (got <= 0) { reading = 0; }
            else {
                let is i64 as k with mut = 0;
                while (k < got) { _put(out, n, cast(i64, buf[k])); k = k + 1; }
            }
        } else if ((pe[2] & sys.POLL_CLOSED) != 0) { reading = 0; }
        else if (jobs.get(slot).status != jobs.JOB_RUN) { reading = 0; }
    }
    // Whatever it said on its way out, up to the end of the channel.
    let is i64 as eg with mut = 0;
    while (jb.err_fd >= 0 && eg < 64) {
        let is [3]i64 as ep;
        ep[0] = jb.err_fd; ep[1] = sys.POLL_READABLE; ep[2] = 0;
        sys.poll(&ep[0], 1, 200000000);
        if ((ep[2] & (sys.POLL_READABLE | sys.POLL_CLOSED)) == 0) { eg = 64; }
        else if (_cap_err_take(jb.err_fd) == 0) { eg = 64; }
        eg = eg + 1;
    }
    // The status is the last stage's, for the && and || after it. Its output
    // ended, so it has exited or is about to; the stages before it may still
    // be writing to a reader that is gone, and end_job stops those.
    let is i64 as code with mut = 0;
    sys.wait_exit(jobs.last_pid(slot), &code);
    jobs.end_job(slot);
    return code;
}

fn capture(src as *u8, len as i64, out as *u8, n as *i64) as void {
    // The word and stage tables are global and the caller may be in the middle
    // of using them, so they are saved around the nested parse, and the
    // nested words go into wbuf past the caller's (wbase).
    let is i64 as s_nword = nword;
    let is i64 as s_wfill = wfill;
    let is i64 as s_wbase = wbase;
    let is i64 as s_ncmd = ncmd;
    let is i64 as save_words = s_nword * 3 + s_ncmd * 6;
    let is i64 as save_sz = ((save_words * 8 + 4095) / 4096) * 4096;
    let is *i64 as sv with mut = cast(*i64, 0);
    if (save_words > 0) {
        let is i64 as va = sys.mmap(0, save_sz, sys.PROT_READ | sys.PROT_WRITE);
        if (va < 0) { if (room_err == 0) { room_err = sys.E_NOMEM; } return; }
        sv = cast(*i64, va);
    }
    let is i64 as i with mut = 0;
    while (i < s_nword) {
        sv[i * 3] = w_off[i]; sv[i * 3 + 1] = w_len[i]; sv[i * 3 + 2] = w_quoted[i];
        i = i + 1;
    }
    // Field by field: a whole-struct assignment would depend on the compiler
    // emitting a copy, and this is the one place a silent aliasing bug would
    // corrupt the caller's half-parsed line rather than fail loudly.
    let is i64 as cb = s_nword * 3;
    i = 0;
    while (i < s_ncmd) {
        let is *Cmd as sc = cmd_at(i);
        sv[cb + i*6+0] = sc.w0;     sv[cb + i*6+1] = sc.wn;
        sv[cb + i*6+2] = sc.in_w;   sv[cb + i*6+3] = sc.out_w;
        sv[cb + i*6+4] = sc.append; sv[cb + i*6+5] = sc.err_to_out;
        i = i + 1;
    }

    let is i64 as start = n[0];
    if (list_valid(src, len) == 0) {
        _cap_err_add_z("syntax: ; && || or & with no command on one side, in $(...)\n");
    } else {
        let is i64 as p with mut = 0;
        let is i64 as prev with mut = OP_SEMI;         // the operator before this part
        let is i64 as status with mut = 0;
        let is i64 as going with mut = 1;
        while (going == 1) {
            let is i64 as at with mut = 0;
            let is i64 as oplen with mut = 0;
            let is i64 as op = list_scan(src, len, p, &at, &oplen);
            let is i64 as a with mut = p;
            let is i64 as b with mut = at;
            while (a < b && _blank(src[a]) == 1) { a = a + 1; }
            while (b > a && _blank(src[b - 1]) == 1) { b = b - 1; }
            if (a == b) { going = 0; }                  // the end, after ';' or '&'
            else {
                let is i64 as run with mut = 1;
                if (prev == OP_AND && status != 0) { run = 0; }
                if (prev == OP_OR && status == 0) { run = 0; }
                if (run == 1) {
                    wbase = s_wfill;
                    status = _capture_one(cast(*u8, cast(i64, src) + a), b - a, out, n);
                }
                if (op == OP_END) { going = 0; }
                prev = op;
                p = at + oplen;
            }
        }
    }
    while (n[0] > start && (out[n[0] - 1] == cast(u8, 10) || out[n[0] - 1] == cast(u8, 13))) {
        n[0] = n[0] - 1;
    }

    // Restore the caller's parse state.
    i = 0;
    while (i < s_nword) {
        w_off[i] = sv[i * 3]; w_len[i] = sv[i * 3 + 1]; w_quoted[i] = sv[i * 3 + 2];
        i = i + 1;
    }
    nword = s_nword; wfill = s_wfill; wbase = s_wbase; ncmd = s_ncmd;
    i = 0;
    while (i < s_ncmd) {
        let is *Cmd as dc = cmd_at(i);
        dc.w0 = sv[cb + i*6+0];     dc.wn = sv[cb + i*6+1];
        dc.in_w = sv[cb + i*6+2];   dc.out_w = sv[cb + i*6+3];
        dc.append = sv[cb + i*6+4]; dc.err_to_out = sv[cb + i*6+5];
        i = i + 1;
    }
    if (save_words > 0) { sys.munmap(cast(i64, sv), save_sz); }
    return;
}

// A line of red on the terminal, the way the shells say a command failed.
fn _say_err(t as *term.Term, m as *u8, n as i64) as void {
    let is u32 as fg = t.fg;
    let is u32 as bg = t.bg;
    term.set_color(t, 0x00ef5350, bg);
    term.puts(t, m, n);
    term.set_color(t, fg, bg);
    return;
}

fn _say_err_z(t as *term.Term, m as *u8) as void {
    let is i64 as n with mut = 0;
    while (m[n] != cast(u8, 0)) { n = n + 1; }
    _say_err(t, m, n);
    return;
}

// Why prepare refused a script's line, said, and the status it leaves; 0 when
// it did not refuse (nc > 0).
fn _prepare_failed(t as *term.Term, nc as i64) as i64 {
    if (nc > 0) { return 0; }
    if (room_err != 0) { _say_err_z(t, room_text(room_err)); _say_err_z(t, "\n"); }
    else if (nc == 0 - 2) { _say_err_z(t, "syntax: redirect with no target\n"); }
    else if (nc < 0) { _say_err_z(t, "syntax: | with no command on one side\n"); }
    last_status = 2;
    return 2;
}

// The failure of exec, said in the shells' words; the status it leaves.
fn _exec_failed(t as *term.Term, slot as i64) as i64 {
    let is [192]u8 as m;
    let is i64 as ml = failure_text(slot, cast(*u8, &m[0]));
    _say_err(t, cast(*u8, &m[0]), ml);
    last_status = failure_status(slot);
    return last_status;
}

// run_sync — run one line and WAIT, pumping its output to the terminal, then
// return its exit status.
//
// The interactive prompt runs jobs asynchronously (that is what makes '&' and
// job control possible), but a script is a sequence: the next statement cannot
// start before this one's status is known, because that status is what `if` and
// `while` branch on. So scripting gets its own synchronous path rather than
// bending the interactive loop into one.
fn run_sync(t as *term.Term, line as *u8, len as i64) as i64 {
    let is i64 as nc = prepare(line, len);
    cap_err_show(t);
    // A line that could not be held whole says so; it used to leave status 2
    // without a word.
    if (nc <= 0) { return _prepare_failed(t, nc); }
    let is i64 as slot = exec(0, line, len, 0 - 1, cast(*i64, 0), 1);
    // A command in a script that cannot start says so, like one typed at the
    // prompt; it used to fail without a word.
    if (slot < 0) { return _exec_failed(t, slot); }
    let is *jobs.Job as jb = jobs.get(slot);
    let is [256]u8 as buf;
    let is i64 as guard with mut = 0;
    let is i64 as running with mut = 1;
    while (running == 1 && guard < 1000000) {
        let is [9]i64 as pe;
        let is i64 as n with mut = 0;
        let is i64 as out_e with mut = 0 - 1;
        let is i64 as tty_e with mut = 0 - 1;
        if (jb.out_fd >= 0) { pe[0] = jb.out_fd; pe[1] = sys.POLL_READABLE; pe[2] = 0; out_e = 0; n = 1; }
        if (jobs.event_fd() >= 0) {
            pe[n*3+0] = jobs.event_fd(); pe[n*3+1] = sys.POLL_READABLE; pe[n*3+2] = 0;
            n = n + 1;
        }
        // The script's command may ask the terminal its size (ttyproto); it
        // waits for the answer, so it has to be served here too.
        if (jb.tty_fd >= 0) {
            pe[n*3+0] = jb.tty_fd; pe[n*3+1] = sys.POLL_READABLE; pe[n*3+2] = 0;
            tty_e = n; n = n + 1;
        }
        if (n == 0) { running = 0; }
        else {
            sys.poll(&pe[0], n, 100000000);
            if (out_e >= 0 && (pe[out_e*3+2] & sys.POLL_READABLE) != 0) {
                let is i64 as got = sys.read(jb.out_fd, cast(*u8, &buf[0]), 256);
                if (got > 0) { term.puts(t, cast(*u8, &buf[0]), got); }
            }
            if (tty_e >= 0 && (pe[tty_e*3+2] & (sys.POLL_READABLE | sys.POLL_CLOSED)) != 0) {
                let is i64 as kp with mut = 0;
                let is i64 as ar = tty.answer(jb.tty_fd, &jb.tty_fill, jobs.tty_acc(slot), t.cols, t.rows, &jb.tty_catch, &kp);
                // A kill asked from inside a script: what the shell itself
                // started is all it can reach from here.
                if (ar == 1) { tty.kill_reply(jb.tty_fd, kp, sys.kill(kp)); }
                if (ar < 0) {
                    sys.close(jb.tty_fd); jb.tty_fd = 0 - 1;
                }
            }
            jobs.poll_events();
            if (jobs.get(slot).status == jobs.JOB_DONE) {
                // Drain whatever the child wrote just before exiting.
                let is i64 as tail with mut = 0;
                while (jb.out_fd >= 0 && tail < 4096) {
                    let is i64 as g2 = sys.read(jb.out_fd, cast(*u8, &buf[0]), 256);
                    if (g2 <= 0) { tail = 4096; }
                    else { term.puts(t, cast(*u8, &buf[0]), g2); tail = tail + 1; }
                }
                running = 0;
            }
        }
        guard = guard + 1;
    }
    let is i64 as st = jobs.get(slot).exit_code;
    crash_line(t, slot, t.fg);
    jobs.release(slot);
    last_status = st;
    return st;
}

// run_bg — `cmd &` inside a script: start the line in the background and go
// on, the way the prompt does. It is a job of the shell's like any other, so
// its loop shows the job's output and reaps it, and says "[n] Done" — the
// script does not wait for it. The notice is the one the shells print for a
// job they put in the background. 0, or the failure's status (said). In a
// script the & used to reach the program as an argument: `sleep 100 &` said
// "sleep: invalid time interval '&'".
fn run_bg(t as *term.Term, line as *u8, len as i64) as i64 {
    let is i64 as nc = prepare(line, len);
    cap_err_show(t);
    if (nc <= 0) { return _prepare_failed(t, nc); }
    let is i64 as slot = exec(1, line, len, 0 - 1, cast(*i64, 0), 1);
    if (slot < 0) { return _exec_failed(t, slot); }
    let is [24]u8 as d;
    term.putc(t, 91);
    let is i64 as x with mut = slot + 1;
    let is i64 as i with mut = 24;
    while (x > 0) { i = i - 1; d[i] = cast(u8, 48 + (x % 10)); x = x / 10; }
    term.puts(t, cast(*u8, &d[i]), 24 - i);
    term.puts(t, "] ", 2);
    x = jobs.last_pid(slot);
    i = 24;
    if (x == 0) { i = 23; d[23] = cast(u8, 48); }
    while (x > 0) { i = i - 1; d[i] = cast(u8, 48 + (x % 10)); x = x / 10; }
    term.puts(t, cast(*u8, &d[i]), 24 - i);
    term.putc(t, 32);
    let is [32]u8 as sw;
    let is i64 as swn = jobs.state_word(slot, cast(*u8, &sw[0]));
    term.puts(t, cast(*u8, &sw[0]), swn);
    term.puts(t, jobs.cmd_ptr(slot), jobs.cmd_len(slot));
    term.putc(t, 10);
    last_status = 0;
    return 0;
}

// held_show — background job slot's output, shown above the prompt in whole
// lines (jobs.out_lines): the first k bytes it holds, as lines of their own —
// a newline after a last piece that has none — and then dropped. k < 0: the
// job could not hold p[0, n), so what it holds and then those are shown as
// they are. The caller has put the line being typed out of the way.
fn held_show(t as *term.Term, slot as i64, k as i64, p as *u8, n as i64) as void {
    if (k > 0) {
        let is *u8 as h = jobs.held(slot);
        term.puts(t, h, k);
        if (h[k - 1] != cast(u8, 10)) { term.putc(t, 10); }
        jobs.held_drop(slot, k);
        return;
    }
    if (k == 0) { return; }
    term.puts(t, jobs.held(slot), jobs.held_len(slot));
    jobs.held_drop(slot, jobs.held_len(slot));
    term.puts(t, p, n);
    if (n > 0 && p[n - 1] != cast(u8, 10)) { term.putc(t, 10); }
    return;
}

// anchor_dots — rewrite every word that STARTS with "./" or "../" into its
// absolute form.
//
// A child has no directory of its own, so a bare `note.txt` handed to one is
// resolved from the root and there is no way for the shell to know it was meant
// as a path — `echo note.txt` must stay text. But "./" and "../" are path
// SYNTAX: a word beginning with them can only be a path, so the shell can
// resolve it without guessing. That is what makes `cat ./note.txt` work after
// `cd docs` while `echo note.txt` still prints what was typed.
fn anchor_dots() as void {
    let is i64 as w with mut = 0;
    while (w < nword && room_err == 0) {
        let is *u8 as p = word_ptr(w);
        let is i64 as l = w_len[w];
        let is i64 as is_dot with mut = 0;
        if (l >= 2 && p[0] == cast(u8, 46) && p[1] == cast(u8, 47)) { is_dot = 1; }
        if (l >= 3 && p[0] == cast(u8, 46) && p[1] == cast(u8, 46) && p[2] == cast(u8, 47)) { is_dot = 1; }
        // A path too long to be one stays as typed: the child gets the same
        // word and the same answer from the VFS it would get anyway.
        let is *u8 as abs with mut = cast(*u8, 0);
        if (is_dot == 1) { abs = resolve(p, l); }
        if (cast(i64, abs) != 0) {
            let is i64 as al with mut = 0;
            while (abs[al] != cast(u8, 0)) { al = al + 1; }
            if (_wroom(al) == 1) {
                let is i64 as o = wfill;
                let is i64 as k with mut = 0;
                while (k < al) { wbuf[wfill] = abs[k]; wfill = wfill + 1; k = k + 1; }
                w_off[w] = o; w_len[w] = al;
            }
        }
        w = w + 1;
    }
    return;
}

// The desktop has already selected a concrete file. Keep it as one argv word,
// with no expansion, globbing, command lookup, or line-editor round trip.
fn prepare_program(path as *u8, len as i64) as i64 {
    ncmd = 0; nword = 0; wfill = 0; wbase = 0;
    prepared_program = 0; room_err = 0;
    if (len <= 0 || len > prog.PATH_MAX) { return sys.E_INVAL; }
    let is i64 as rd = _ready();
    if (rd != 0) { return rd; }
    if (_wroom(len + 1) == 0 || _room(&woff_g, 8) == 0 || _room(&wlen_g, 8) == 0
        || _room(&wq_g, 8) == 0 || _room(&cmd_g, sizeof(Cmd)) == 0) { return room_err; }
    let is i64 as k with mut = 0;
    while (k < len) { wbuf[k] = path[k]; k = k + 1; }
    wbuf[len] = cast(u8, 0);
    w_off[0] = 0; w_len[0] = len; w_quoted[0] = 1;
    nword = 1; wfill = len + 1;
    let is *Cmd as c0 = cmd_at(0);
    c0.w0 = 0; c0.wn = 1;
    c0.in_w = 0 - 1; c0.out_w = 0 - 1;
    c0.append = 0; c0.err_to_out = 0;
    ncmd = 1; prepared_program = 1;
    return 1;
}

// prepare — passes 1..5 for one line. Returns the stage count, -2 for a
// redirect with no target, or -1 when the line could not be held whole
// (room_error says why; nothing of it may run).
fn prepare(line as *u8, len as i64) as i64 {
    wbase = 0;
    let is i64 as elen = expand_line(line, len);
    if (elen < 0) { ncmd = 0; return 0 - 1; }
    tokenise(expbuf, elen);
    glob_words();
    anchor_dots();
    return build_cmds();
}

// ---- words for builtins ----------------------------------------------------
//
// args_split — the words of `line` split on runs of blanks, in place: pointer
// and length pairs INTO the line, no copy. *pp gets the pointers, *pl the
// lengths. The count, or room_err's errno when they cannot be held. They were
// 16 words on the caller's stack, and a builtin given more (`kill` with twenty
// pids) quietly saw the first sixteen.
//
// The pairs live on a stack in args_g, because a builtin can run a function
// whose lines are split while the builtin's own words are still in use. A
// caller takes args_mark() first and gives it back to args_release() when it
// is done with the words.
fn args_mark() as i64 { return args_top; }
fn args_release(m as i64) as void { args_top = m; return; }

fn args_split(line as *u8, len as i64, pp as *i64, pl as *i64) as i64 {
    let is i64 as rd = _ready();
    if (rd != 0) { return rd; }
    // Count first: the table is two runs, pointers then lengths.
    let is i64 as argc with mut = 0;
    let is i64 as i with mut = 0;
    while (i < len) {
        while (i < len && (line[i] == cast(u8, 32) || line[i] == cast(u8, 9))) { i = i + 1; }
        if (i < len) {
            argc = argc + 1;
            while (i < len && line[i] != cast(u8, 32) && line[i] != cast(u8, 9)) { i = i + 1; }
        }
    }
    let is i64 as base = args_top;
    let is i64 as rc = grow.need(&args_g, (base + 2 * argc + 2) * 8);
    if (rc != 0) { return rc; }
    let is *i64 as ptrs = cast(*i64, args_g.base + base * 8);
    let is *i64 as lens = cast(*i64, args_g.base + (base + argc + 1) * 8);
    let is i64 as n with mut = 0;
    i = 0;
    while (i < len) {
        while (i < len && (line[i] == cast(u8, 32) || line[i] == cast(u8, 9))) { i = i + 1; }
        if (i < len) {
            let is i64 as start = i;
            while (i < len && line[i] != cast(u8, 32) && line[i] != cast(u8, 9)) { i = i + 1; }
            ptrs[n] = cast(i64, line) + start;
            lens[n] = i - start;
            n = n + 1;
        }
    }
    args_top = base + 2 * argc + 2;
    pp[0] = cast(i64, ptrs);
    pl[0] = cast(i64, lens);
    return argc;
}
