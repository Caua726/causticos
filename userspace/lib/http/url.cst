// url — taking a URL apart.
//
// Only what a client actually needs to open a connection and ask for a
// resource: scheme, host, port, path. It stores OFFSETS INTO THE CALLER'S
// STRING rather than copies, so parsing a URL costs no memory and a caller
// that already has the bytes does not get a second set of them to keep in
// sync.
//
// WHAT IT DELIBERATELY DOES NOT DO, stated rather than left to be discovered:
//
//   userinfo (`http://user:pass@host/`) is rejected, not ignored. Ignoring it
//   would connect to `host` while the caller believes it authenticated, and
//   silently dropping credentials is worse than refusing the URL.
//
//   IPv6 literals (`http://[::1]/`) are rejected because the stack under this
//   is IPv4 only. Parsing an address family that cannot be connected to would
//   be a parser that succeeds into a failure further down.
//
//   Percent-decoding does not happen to the path, and must not: the path goes
//   on the wire exactly as the user wrote it. Decoding it here would turn an
//   escaped `%2F` into a path separator and change which resource is asked
//   for.
//
//   A fragment is dropped, because it is never sent to a server — it is the
//   client's business and no part of the request.

let is i64 as HTTP  with imut = 0;
let is i64 as HTTPS with imut = 1;

let is i64 as PORT_HTTP  with imut = 80;
let is i64 as PORT_HTTPS with imut = 443;

struct Url {
    scheme  as i64;
    host    as i64;      // *u8 into the caller's buffer
    hostlen as i64;
    port    as i64;
    path    as i64;      // *u8, or 0 when the URL had none
    pathlen as i64;
}

fn lower(c as i64) as i64 {
    if (c >= 65 && c <= 90) { return c + 32; }
    return c;
}

// Case-insensitive compare of a fixed-length literal against s[at..].
fn matches(s as *u8, len as i64, at as i64, lit as *u8, litlen as i64) as i64 {
    if (at + litlen > len) { return 0; }
    let is i64 as i with mut = 0;
    while (i < litlen) {
        if (lower(cast(i64, s[at + i])) != lower(cast(i64, lit[i]))) { return 0; }
        i = i + 1;
    }
    return 1;
}

// 0 on success, negative on a URL this cannot honestly represent.
fn parse(s as *u8, len as i64, u as *Url) as i64 {
    u.scheme = HTTP;
    u.host = 0; u.hostlen = 0;
    u.port = 0;
    u.path = 0; u.pathlen = 0;
    if (len <= 0) { return 0 - 1; }

    let is i64 as at with mut = 0;
    let is i64 as have_scheme with mut = 0;
    if (matches(s, len, 0, cast(*u8, "http://"), 7) == 1) {
        u.scheme = HTTP; at = 7; have_scheme = 1;
    } else {
        if (matches(s, len, 0, cast(*u8, "https://"), 8) == 1) {
            u.scheme = HTTPS; at = 8; have_scheme = 1;
        }
    }
    if (have_scheme == 0) {
        // A scheme-relative or bare host: "example.com/x". Accepting it is
        // what people type. Rejecting a string that merely LOOKS like it has
        // another scheme is the important half — "ftp://x" must not be
        // silently fetched over HTTP.
        // A scheme ends at the first ':' and can contain no '/', so the scan
        // stops at either. Without that stop, a path with "://" in it — which
        // is legal — would be mistaken for a scheme far to its left.
        let is i64 as i with mut = 0;
        while (i < len) {
            if (s[i] == cast(u8, 47)) { break; }        // '/': authority ended
            if (s[i] == cast(u8, 58)) {                 // ':'
                if (i + 2 < len && s[i+1] == cast(u8, 47) && s[i+2] == cast(u8, 47)) {
                    return 0 - 2;                       // some other scheme
                }
                break;                                  // "host:port", fine
            }
            i = i + 1;
        }
    }

    // The authority runs to the first '/', '?' or '#'.
    let is i64 as astart = at;
    while (at < len) {
        let is i64 as c = cast(i64, s[at]);
        if (c == 47 || c == 63 || c == 35) { break; }      // / ? #
        at = at + 1;
    }
    let is i64 as aend = at;
    if (aend == astart) { return 0 - 3; }

    // Refuse what cannot be honoured rather than guessing.
    let is i64 as i with mut = astart;
    while (i < aend) {
        if (s[i] == cast(u8, 64)) { return 0 - 4; }        // '@' userinfo
        if (s[i] == cast(u8, 91)) { return 0 - 5; }        // '[' IPv6 literal
        i = i + 1;
    }

    // An explicit port after the last colon.
    let is i64 as colon with mut = 0 - 1;
    i = astart;
    while (i < aend) {
        if (s[i] == cast(u8, 58)) { colon = i; }
        i = i + 1;
    }
    let is i64 as hend with mut = aend;
    if (colon >= 0) {
        hend = colon;
        let is i64 as p with mut = 0;
        let is i64 as digits with mut = 0;
        i = colon + 1;
        while (i < aend) {
            let is i64 as c = cast(i64, s[i]);
            if (c < 48 || c > 57) { return 0 - 6; }
            p = p * 10 + (c - 48);
            digits = digits + 1;
            if (p > 65535) { return 0 - 6; }
            i = i + 1;
        }
        if (digits == 0) { return 0 - 6; }
        u.port = p;
    } else {
        if (u.scheme == HTTPS) { u.port = PORT_HTTPS; } else { u.port = PORT_HTTP; }
    }

    if (hend == astart) { return 0 - 3; }
    u.host = cast(i64, cast(*u8, cast(i64, s) + astart));
    u.hostlen = hend - astart;

    // The path is everything from the '/' up to a fragment. A query string is
    // part of it: it identifies the resource and the server needs it.
    if (aend < len) {
        let is i64 as pend with mut = len;
        i = aend;
        while (i < len) {
            if (s[i] == cast(u8, 35)) { pend = i; i = len; }    // '#'
            else { i = i + 1; }
        }
        if (pend > aend) {
            u.path = cast(i64, cast(*u8, cast(i64, s) + aend));
            u.pathlen = pend - aend;
        }
    }
    return 0;
}

fn host_ptr(u as *Url) as *u8 { return cast(*u8, u.host); }
fn path_ptr(u as *Url) as *u8 { return cast(*u8, u.path); }

// Whether the port is the one the scheme implies, which is what decides
// whether it belongs in the Host header (RFC 7230 §5.4: the default port is
// omitted, and sending it anyway breaks virtual hosts that match on the
// literal string).
fn port_is_default(u as *Url) as i64 {
    if (u.scheme == HTTPS && u.port == PORT_HTTPS) { return 1; }
    if (u.scheme == HTTP && u.port == PORT_HTTP) { return 1; }
    return 0;
}
