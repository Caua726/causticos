// glob.cst — shell-style wildcard matching: the one copy the shell, ls and
// find share. There were two, neither complete: the shell's recursed on every
// '*' (a pattern with a few stars against a long name took exponential time)
// and ls's had no character classes. Both compared bytes, so '?' did not match
// "ç".
//
//   *          any run of characters, none included
//   ?          one character
//   [abc]      one of them; [a-z] a range; [!abc] or [^abc] none of them. A ]
//              first in the set is a member, so is a - first or last.
//   [[:alpha:]]  a class inside a set: alpha digit alnum upper lower space
//              blank punct xdigit cntrl print graph
//   \c         c itself (the backslash quotes it), unless FL_NOESCAPE
//
// Characters are UTF-8 code points: '?' takes all the bytes of one, and a
// range compares code points. A byte that does not start a valid sequence is a
// character of its own, so a name that is not UTF-8 still matches sensibly.
//
// An unterminated '[' is an ordinary character, as POSIX has it.
use "std/unicode/utf8.cst" as utf8;

let is i64 as FL_NOESCAPE with imut = 1;   // '\' is an ordinary character
let is i64 as FL_PATHNAME with imut = 2;   // '/' only matches a '/' in the pattern
let is i64 as FL_PERIOD   with imut = 4;   // a leading '.' only matches a '.' in the pattern
let is i64 as FL_CASEFOLD with imut = 8;   // a letter matches either case

// The code point at s[i] and how many bytes it takes. A malformed byte is a
// character of its own, one byte long, numbered past the end of Unicode so it
// matches only the same malformed byte — a stray 0xE7 is not U+00E7, "ç".
fn _cp(s as *u8, n as i64, i as i64, len as *i64) as i64 {
    let is i32 as c with mut = 0;
    let is i64 as k = utf8.decode1(s, n, i, &c);
    if (k <= 0) { len[0] = 1; return 0x110000 + cast(i64, s[i]); }
    len[0] = k;
    return cast(i64, c);
}

// Lower case for the letters this folds: ASCII and Latin-1 (the ones the
// keymaps type). Anything else is itself.
fn _lower(c as i64) as i64 {
    if (c >= 65 && c <= 90) { return c + 32; }
    if (c >= 0xC0 && c <= 0xDE && c != 0xD7) { return c + 32; }
    return c;
}

fn _is_alpha(c as i64) as i64 {
    if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122)) { return 1; }
    if (c >= 0xC0 && c <= 0xFF && c != 0xD7 && c != 0xF7) { return 1; }
    return 0;
}
fn _is_upper(c as i64) as i64 {
    if (c >= 65 && c <= 90) { return 1; }
    if (c >= 0xC0 && c <= 0xDE && c != 0xD7) { return 1; }
    return 0;
}
fn _is_lower(c as i64) as i64 {
    if (c >= 97 && c <= 122) { return 1; }
    if (c >= 0xDF && c <= 0xFF && c != 0xF7) { return 1; }
    return 0;
}
fn _is_digit(c as i64) as i64 { if (c >= 48 && c <= 57) { return 1; } return 0; }

// Whether c is in the class named by p[0..n] ("alpha", ...). -1 = no such class.
fn _in_class(p as *u8, n as i64, c as i64) as i64 {
    if (_named(p, n, "alpha") == 1) { return _is_alpha(c); }
    if (_named(p, n, "digit") == 1) { return _is_digit(c); }
    if (_named(p, n, "alnum") == 1) { if (_is_alpha(c) == 1 || _is_digit(c) == 1) { return 1; } return 0; }
    if (_named(p, n, "upper") == 1) { return _is_upper(c); }
    if (_named(p, n, "lower") == 1) { return _is_lower(c); }
    if (_named(p, n, "space") == 1) { if (c == 32 || (c >= 9 && c <= 13)) { return 1; } return 0; }
    if (_named(p, n, "blank") == 1) { if (c == 32 || c == 9) { return 1; } return 0; }
    if (_named(p, n, "xdigit") == 1) {
        if (_is_digit(c) == 1 || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)) { return 1; }
        return 0;
    }
    if (_named(p, n, "cntrl") == 1) { if (c < 32 || c == 127) { return 1; } return 0; }
    if (_named(p, n, "print") == 1) { if (c >= 32 && c != 127) { return 1; } return 0; }
    if (_named(p, n, "graph") == 1) { if (c > 32 && c != 127) { return 1; } return 0; }
    if (_named(p, n, "punct") == 1) {
        if ((c >= 33 && c <= 47) || (c >= 58 && c <= 64) || (c >= 91 && c <= 96) || (c >= 123 && c <= 126)) { return 1; }
        return 0;
    }
    return 0 - 1;
}

fn _named(p as *u8, n as i64, lit as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (lit[i] == cast(u8, 0) || lit[i] != p[i]) { return 0; }
        i = i + 1;
    }
    if (lit[n] != cast(u8, 0)) { return 0; }
    return 1;
}

// The set that opens at pat[at] ('['), against code point c. Returns the
// offset just past its ']' and sets hit[0]; 0 when there is no ']' (the '['
// is then an ordinary character).
fn _set(pat as *u8, plen as i64, at as i64, c as i64, flags as i64, hit as *i64) as i64 {
    let is i64 as k with mut = at + 1;
    let is i64 as neg with mut = 0;
    if (k < plen && (pat[k] == cast(u8, 33) || pat[k] == cast(u8, 94))) { neg = 1; k = k + 1; }   // ! ^
    let is i64 as lc = _lower(c);
    let is i64 as fold = flags & FL_CASEFOLD;
    let is i64 as found with mut = 0;
    let is i64 as first with mut = 1;
    let is [1]i64 as ln;
    while (k < plen) {
        let is i64 as ch = cast(i64, pat[k]);
        if (ch == 93 && first == 0) {                              // ']' closes
            if (neg == 1) { found = 1 - found; }
            hit[0] = found;
            return k + 1;
        }
        first = 0;
        // [:class:]
        if (ch == 91 && k + 1 < plen && pat[k + 1] == cast(u8, 58)) {
            let is i64 as e with mut = k + 2;
            while (e + 1 < plen && (pat[e] != cast(u8, 58) || pat[e + 1] != cast(u8, 93))) { e = e + 1; }
            if (e + 1 < plen) {
                let is i64 as r = _in_class(cast(*u8, cast(i64, pat) + k + 2), e - k - 2, c);
                if (r == 1) { found = 1; }
                if (r == 0 && fold != 0 && (_named(cast(*u8, cast(i64, pat) + k + 2), e - k - 2, "upper") == 1
                                         || _named(cast(*u8, cast(i64, pat) + k + 2), e - k - 2, "lower") == 1)) {
                    if (_is_alpha(c) == 1) { found = 1; }
                }
                k = e + 2;
                continue;
            }
        }
        // one member, maybe escaped, maybe the start of a range
        let is i64 as lo with mut = 0;
        if (ch == 92 && (flags & FL_NOESCAPE) == 0 && k + 1 < plen) { k = k + 1; }
        lo = _cp(pat, plen, k, cast(*i64, &ln[0]));
        k = k + ln[0];
        let is i64 as hi with mut = lo;
        if (k + 1 < plen && pat[k] == cast(u8, 45) && pat[k + 1] != cast(u8, 93)) {   // a-b
            k = k + 1;
            if (pat[k] == cast(u8, 92) && (flags & FL_NOESCAPE) == 0 && k + 1 < plen) { k = k + 1; }
            hi = _cp(pat, plen, k, cast(*i64, &ln[0]));
            k = k + ln[0];
        }
        if (c >= lo && c <= hi) { found = 1; }
        else if (fold != 0) {
            if (lc >= _lower(lo) && lc <= _lower(hi)) { found = 1; }
            else if (lc >= lo && lc <= hi) { found = 1; }
        }
    }
    return 0;
}

// Whether s[i] is where a name starts, for FL_PERIOD: the first character, or
// one right after a '/' when FL_PATHNAME is set.
fn _leading(s as *u8, i as i64, flags as i64) as i64 {
    if (i == 0) { return 1; }
    if ((flags & FL_PATHNAME) != 0 && s[i - 1] == cast(u8, 47)) { return 1; }
    return 0;
}

// fnmatch — 1 when pat[0..plen] matches all of s[0..slen], else 0.
//
// One pass with a single remembered '*': on a mismatch the last star takes
// one more character and the match resumes after it. That is complete for
// globs, where '*' is the only thing of variable length — a later star
// supersedes an earlier one — and it is O(len(pat) * len(s)) at worst.
fn fnmatch(pat as *u8, plen as i64, s as *u8, slen as i64, flags as i64) as i64 {
    let is i64 as pi with mut = 0;
    let is i64 as si with mut = 0;
    let is i64 as star_pi with mut = 0 - 1;     // pattern offset just past the last '*'
    let is i64 as star_si with mut = 0;         // where that star's run ends now
    let is [1]i64 as ln;
    let is [1]i64 as hit;
    while (1 == 1) {
        let is i64 as advanced with mut = 0;
        if (pi < plen) {
            let is i64 as pc = cast(i64, pat[pi]);
            if (pc == 42) {                                          // '*'
                while (pi < plen && pat[pi] == cast(u8, 42)) { pi = pi + 1; }
                star_pi = pi;
                star_si = si;
                // A leading '.' is not the star's to take.
                if ((flags & FL_PERIOD) != 0 && si < slen && s[si] == cast(u8, 46) && _leading(s, si, flags) == 1) {
                    star_pi = 0 - 1;
                }
                advanced = 1;
            } else if (si < slen) {
                let is i64 as c = _cp(s, slen, si, cast(*i64, &ln[0]));
                let is i64 as clen = ln[0];
                let is i64 as ok with mut = 0;
                let is i64 as pnext with mut = pi + 1;
                let is i64 as special with mut = 0;   // matched by ? or a set, not a literal
                if (pc == 63) { ok = 1; special = 1; }                // '?'
                else if (pc == 91) {                                   // '['
                    let is i64 as e = _set(pat, plen, pi, c, flags, cast(*i64, &hit[0]));
                    if (e > 0) { ok = hit[0]; pnext = e; special = 1; }
                    else { if (c == 91) { ok = 1; } }                 // no ']': a literal '['
                } else {
                    let is i64 as lp with mut = pi;
                    if (pc == 92 && (flags & FL_NOESCAPE) == 0 && pi + 1 < plen) { lp = pi + 1; }
                    let is i64 as want = _cp(pat, plen, lp, cast(*i64, &ln[0]));
                    pnext = lp + ln[0];
                    if (want == c) { ok = 1; }
                    else if ((flags & FL_CASEFOLD) != 0 && _lower(want) == _lower(c)) { ok = 1; }
                }
                if (ok == 1 && special == 1) {
                    if ((flags & FL_PATHNAME) != 0 && c == 47) { ok = 0; }
                    if ((flags & FL_PERIOD) != 0 && c == 46 && _leading(s, si, flags) == 1) { ok = 0; }
                }
                if (ok == 1) { pi = pnext; si = si + clen; advanced = 1; }
            }
        } else if (si == slen) {
            return 1;
        }
        if (advanced == 0) {
            // Mismatch, or the pattern ran out with the name left over: let
            // the last star take one more character, if it can.
            if (star_pi < 0 || star_si >= slen) { return 0; }
            let is i64 as c2 = _cp(s, slen, star_si, cast(*i64, &ln[0]));
            if ((flags & FL_PATHNAME) != 0 && c2 == 47) { return 0; }
            star_si = star_si + ln[0];
            si = star_si;
            pi = star_pi;
        }
    }
    return 0;
}

// has_magic — whether pat[0..plen] has a '*', '?' or '[' not quoted by a
// backslash: whether it is a pattern at all, or just a name.
fn has_magic(pat as *u8, plen as i64, flags as i64) as i64 {
    let is i64 as i with mut = 0;
    while (i < plen) {
        let is i64 as c = cast(i64, pat[i]);
        if (c == 92 && (flags & FL_NOESCAPE) == 0) { i = i + 2; }
        else {
            if (c == 42 || c == 63 || c == 91) { return 1; }
            i = i + 1;
        }
    }
    return 0;
}
