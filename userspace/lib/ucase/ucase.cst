// ucase.cst — upper and lower case of a code point, for the scripts the
// console font draws: Latin (ASCII, Latin-1, Latin Extended-A), Greek and
// Cyrillic. Case-insensitive matching (glob, regex) folds with lower(); sed's
// \U \L \u \l convert with both. Anything outside those blocks has no case
// here and is returned as it is.
//
// The std's Unicode module carries General_Category but deliberately not the
// case tables (megabytes of .rodata); these blocks are what a user of this
// system types and reads.

fn lower(c as i64) as i64 {
    if (c < 0x80) {
        if (c >= 65 && c <= 90) { return c + 32; }
        return c;
    }
    if (c >= 0xC0 && c <= 0xDE && c != 0xD7) { return c + 32; }
    if (c >= 0x100 && c <= 0x17F) { return _ext_a(c, 0); }
    if (c >= 0x391 && c <= 0x3AB && c != 0x3A2) { return c + 32; }   // Α..Ϋ
    if (c == 0x386) { return 0x3AC; }
    if (c >= 0x388 && c <= 0x38A) { return c + 37; }
    if (c == 0x38C) { return 0x3CC; }
    if (c == 0x38E || c == 0x38F) { return c + 63; }
    if (c == 0x3C2) { return 0x3C3; }                                 // final sigma folds to σ
    if (c >= 0x410 && c <= 0x42F) { return c + 32; }                 // А..Я
    if (c >= 0x400 && c <= 0x40F) { return c + 80; }                 // Ѐ..Џ
    return c;
}

fn upper(c as i64) as i64 {
    if (c < 0x80) {
        if (c >= 97 && c <= 122) { return c - 32; }
        return c;
    }
    if (c >= 0xE0 && c <= 0xFE && c != 0xF7) { return c - 32; }
    if (c == 0xFF) { return 0x178; }
    if (c >= 0x100 && c <= 0x17F) { return _ext_a(c, 1); }
    if (c >= 0x3B1 && c <= 0x3CB && c != 0x3C2) { return c - 32; }
    if (c == 0x3C2) { return 0x3A3; }
    if (c == 0x3AC) { return 0x386; }
    if (c >= 0x3AD && c <= 0x3AF) { return c - 37; }
    if (c == 0x3CC) { return 0x38C; }
    if (c == 0x3CD || c == 0x3CE) { return c - 63; }
    if (c >= 0x430 && c <= 0x44F) { return c - 32; }
    if (c >= 0x450 && c <= 0x45F) { return c - 80; }
    return c;
}

// Latin Extended-A is pairs, capital first — except where the pairs start on
// an odd code point (Ĺ..ň, Ź..ž), and the few with no partner (ĸ ŉ ſ) or a
// partner elsewhere (İ ı, Ÿ).
fn _ext_a(c as i64, to_upper as i64) as i64 {
    if (c == 0x130) { if (to_upper == 0) { return 0x69; } return c; }      // İ → i
    if (c == 0x131) { if (to_upper == 1) { return 0x49; } return c; }      // ı → I
    if (c == 0x138 || c == 0x149 || c == 0x17F) { return c; }
    if (c == 0x178) { if (to_upper == 0) { return 0xFF; } return c; }
    let is i64 as odd_first with mut = 0;
    if ((c >= 0x139 && c <= 0x148) || (c >= 0x179 && c <= 0x17E)) { odd_first = 1; }
    let is i64 as is_upper with mut = 0;
    if (odd_first == 0 && (c & 1) == 0) { is_upper = 1; }
    if (odd_first == 1 && (c & 1) == 1) { is_upper = 1; }
    if (to_upper == 0 && is_upper == 1) { return c + 1; }
    if (to_upper == 1 && is_upper == 0) { return c - 1; }
    return c;
}

fn is_upper(c as i64) as i64 { if (lower(c) != c) { return 1; } return 0; }
fn is_lower(c as i64) as i64 { if (upper(c) != c) { return 1; } return 0; }
