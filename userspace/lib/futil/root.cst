// root.cst — the stub root libfutil.csl is built through.
//
// A .csl exports what the compilation defines, and a symbol's mangled name is
// relative to the module's path FROM THE ROOT. Building futil.cst directly
// would export a bare `slurp`; its users emit `_lib_futil_futil_cst_slurp`.
// Importing it from here produces exactly the names they reference.
//
// Every entry point is referenced below so dead-code elimination keeps it:
// what this file names is what the library exports, and a program calling
// something it does not name would fail to load rather than fail to link.
use "futil.cst" as f;

fn _keep(argc as i64, argv as *u8) as i64 {
    let is [64]u8 as buf;
    let is [4]i64 as nums;
    let is f.Reader as r;
    let is f.Opt as o;

    f.rd_open(&r, cast(*u8, "/x"), cast(*u8, &buf[0]), 64);
    f.rd_open_fd(&r, 0, cast(*u8, &buf[0]), 64);
    f.rd_byte(&r);
    f.rd_close(&r);
    f.page_round(1);
    f.slurp(cast(*u8, "/x"), &nums[0]);
    f.slurp_fd(0, &nums[0]);
    f.unslurp(0, 0);
    f.parse_uint(cast(*u8, &buf[0]), 1);
    f.parse_int(cast(*u8, &buf[0]), 1);
    f.mem_find(cast(*u8, &buf[0]), 1, cast(*u8, &buf[0]), 1);
    f.path_join(cast(*u8, &buf[0]), cast(*u8, &buf[0]), 1, cast(*u8, &buf[0]), 1);
    f.is_dot(cast(*u8, &buf[0]), 1);
    f.de_name_len(cast(*u8, &buf[0]));
    f.de_size(cast(*u8, &buf[0]));
    f.de_is_dir(cast(*u8, &buf[0]));
    f.read_dir(cast(*u8, "/"), cast(*u8, &buf[0]), 64, &nums[0], &nums[1], &nums[2], 1);
    f.opt_init(&o, argc, argv);
    f.opt_next(&o, cast(*u8, "a"));
    f.statx_mtime(cast(*u8, "/x"));
    f.mtime_fmt(0, cast(*u8, &buf[0]), 64);
    return 0;
}
