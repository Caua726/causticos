// netdhcp — getting an address from whoever is handing them out (RFC 2131).
//
// The protocol is a four-message handshake wearing BOOTP's clothes, and the
// clothes are most of the awkwardness: a 236-byte fixed header from 1985 with
// a magic cookie bolted on the end, after which the useful content lives in
// type-length-value options.
//
// DISCOVER (broadcast, "is anyone there") -> OFFER ("here is one you can
// have") -> REQUEST (broadcast, "I am taking it") -> ACK.
//
// The REQUEST is broadcast even though we know who offered, and that is not
// an oversight: on a network with two servers, both saw the DISCOVER and both
// may have reserved an address. The broadcast REQUEST names the one we chose
// in option 54, which is how the other one learns to release its reservation.
// Unicasting it leaks an address per boot on every multi-server network.
//
// A LEASE IS NOT A GRANT. It expires, and RFC 2131 §4.4.5 sets the timers:
// renew at half the lease (unicast to the server that gave it), rebind at
// 87.5% (broadcast, in case that server is gone), and at expiry the address
// must be given up — a host that keeps using an expired address will collide
// with whoever gets it next, and the failure will look like anything except
// what it is.

use "../netbuf/netbuf.cst" as nb;
use "../netip/netip.cst" as ip;

let is i64 as CLIENT_PORT = 68;
let is i64 as SERVER_PORT = 67;

// The fixed BOOTP header, then the cookie, then options.
let is i64 as HDR_LEN = 236;
let is i64 as MAGIC   = 0x63825363;

// A message must be at least 300 bytes total, because BOOTP relays from the
// eighties drop anything shorter. Padding to it costs nothing and not doing
// it produces a client that works on a LAN and fails behind a relay.
let is i64 as MIN_LEN = 300;
let is i64 as MAX_LEN = 590;

let is i64 as OP_REQUEST = 1;
let is i64 as OP_REPLY   = 2;
let is i64 as HTYPE_ETHER = 1;

// Option codes.
let is i64 as OPT_PAD          = 0;
let is i64 as OPT_SUBNET       = 1;
let is i64 as OPT_ROUTER       = 3;
let is i64 as OPT_DNS          = 6;
let is i64 as OPT_HOSTNAME     = 12;
let is i64 as OPT_REQUESTED_IP = 50;
let is i64 as OPT_LEASE_TIME   = 51;
let is i64 as OPT_MSG_TYPE     = 53;
let is i64 as OPT_SERVER_ID    = 54;
let is i64 as OPT_PARAM_LIST   = 55;
let is i64 as OPT_RENEWAL      = 58;   // T1
let is i64 as OPT_REBINDING    = 59;   // T2
let is i64 as OPT_END          = 255;

// Message types (option 53).
let is i64 as DISCOVER = 1;
let is i64 as OFFER    = 2;
let is i64 as REQUEST  = 3;
let is i64 as DECLINE  = 4;
let is i64 as ACK      = 5;
let is i64 as NAK      = 6;
let is i64 as RELEASE  = 7;

// Client states (RFC 2131 §4.4).
let is i64 as ST_INIT       = 0;
let is i64 as ST_SELECTING  = 1;   // DISCOVER sent, waiting for an OFFER
let is i64 as ST_REQUESTING = 2;   // REQUEST sent, waiting for an ACK
let is i64 as ST_BOUND      = 3;
let is i64 as ST_RENEWING   = 4;   // past T1, unicasting to our server
let is i64 as ST_REBINDING  = 5;   // past T2, broadcasting to anyone

// Retransmission. RFC 2131 §4.1 asks for 4s doubling to 64s with randomised
// jitter; this keeps the doubling and the ceiling. Without the backoff, a
// network with no DHCP server gets a broadcast storm from every host on it.
let is i64 as RETRY_INITIAL_NS = 2000000000;
let is i64 as RETRY_MAX_NS     = 32000000000;
let is i64 as MAX_TRIES        = 5;

struct Client {
    state      as i64;
    xid        as i64;      // our transaction id; replies that do not match are not ours
    deadline   as i64;      // when to retransmit, or advance a lease timer
    backoff    as i64;
    tries      as i64;
    // What was offered or acked.
    offered_ip as i64;
    server_id  as i64;
    my_ip      as i64;
    mask       as i64;
    router     as i64;
    dns        as i64;
    lease_ns   as i64;
    t1_at      as i64;      // absolute; renew after this
    t2_at      as i64;      // absolute; rebind after this
    expires_at as i64;
    mac        as [8]u8;    // 6 used
}

fn init(c as *Client, mac as *u8, now as i64) as void {
    c.state = ST_INIT;
    c.xid = 0;
    c.deadline = now;
    c.backoff = RETRY_INITIAL_NS;
    c.tries = 0;
    c.offered_ip = 0; c.server_id = 0; c.my_ip = 0;
    c.mask = 0; c.router = 0; c.dns = 0;
    c.lease_ns = 0; c.t1_at = 0; c.t2_at = 0; c.expires_at = 0;
    let is i64 as i with mut = 0;
    while (i < 6) { c.mac[i] = mac[i]; i = i + 1; }
    return;
}

// ---- building ----

// The fixed header. `ciaddr` is our current address and must be set only when
// we already hold a valid lease (renewing); during acquisition it is zero,
// because we do not have one yet and claiming otherwise confuses the server
// about what it is being asked for.
fn put_header(out as *u8, xid as i64, ciaddr as i64, mac as *u8, broadcast as i64) as void {
    nb.fill(out, 0, HDR_LEN);
    out[0] = cast(u8, OP_REQUEST);
    out[1] = cast(u8, HTYPE_ETHER);
    out[2] = cast(u8, 6);              // hlen
    out[3] = cast(u8, 0);              // hops
    nb.put_be32(out, 4, xid);
    nb.put_be16(out, 8, 0);            // secs
    // The broadcast flag asks the server to broadcast its reply. We set it
    // because until a lease is bound we have no address, and a unicast reply
    // to an address we do not yet own is one our own receive path would
    // discard — a bootstrap that fails in a way that looks like packet loss.
    if (broadcast != 0) { nb.put_be16(out, 10, 0x8000); }
    else { nb.put_be16(out, 10, 0); }
    nb.put_be32(out, 12, ciaddr);
    nb.copy(cast(*u8, cast(i64, out) + 28), mac, 6);   // chaddr
    return;
}

fn put_opt_u8(out as *u8, off as i64, code as i64, v as i64) as i64 {
    out[off] = cast(u8, code);
    out[off + 1] = cast(u8, 1);
    out[off + 2] = cast(u8, v);
    return off + 3;
}

fn put_opt_ip(out as *u8, off as i64, code as i64, v as i64) as i64 {
    out[off] = cast(u8, code);
    out[off + 1] = cast(u8, 4);
    nb.put_be32(out, off + 2, v);
    return off + 6;
}

// Pad to the BOOTP minimum after the END marker.
fn finish(out as *u8, off as i64) as i64 {
    let is i64 as o with mut = off;
    out[o] = cast(u8, OPT_END);
    o = o + 1;
    while (o < MIN_LEN) { out[o] = cast(u8, OPT_PAD); o = o + 1; }
    return o;
}

// The options every message carries: which type it is, and what we would
// like to be told. Asking explicitly matters — a server sends the mask,
// router and DNS list only if the parameter request list names them.
fn put_common(out as *u8, off as i64, mtype as i64) as i64 {
    let is i64 as o with mut = put_opt_u8(out, off, OPT_MSG_TYPE, mtype);
    out[o] = cast(u8, OPT_PARAM_LIST);
    out[o + 1] = cast(u8, 3);
    out[o + 2] = cast(u8, OPT_SUBNET);
    out[o + 3] = cast(u8, OPT_ROUTER);
    out[o + 4] = cast(u8, OPT_DNS);
    return o + 5;
}

fn build_discover(c as *Client, out as *u8) as i64 {
    put_header(out, c.xid, 0, cast(*u8, &c.mac[0]), 1);
    nb.put_be32(out, HDR_LEN, MAGIC);
    let is i64 as o with mut = put_common(out, HDR_LEN + 4, DISCOVER);
    return finish(out, o);
}

// The REQUEST. Which fields it carries depends on WHY it is being sent, and
// getting that wrong is the classic DHCP client bug:
//
//   Acquiring — the address goes in option 50 and the chosen server in 54,
//   and ciaddr stays zero, because we do not hold the address yet.
//
//   Renewing or rebinding — the address goes in CIADDR and neither option is
//   present, because we already hold it and are asking for more time. A
//   server that sees option 50 during renewal is entitled to NAK.
fn build_request(c as *Client, out as *u8, renewing as i64) as i64 {
    let is i64 as ci with mut = 0;
    if (renewing != 0) { ci = c.my_ip; }
    put_header(out, c.xid, ci, cast(*u8, &c.mac[0]), 1 - renewing);
    nb.put_be32(out, HDR_LEN, MAGIC);
    let is i64 as o with mut = put_common(out, HDR_LEN + 4, REQUEST);
    if (renewing == 0) {
        o = put_opt_ip(out, o, OPT_REQUESTED_IP, c.offered_ip);
        o = put_opt_ip(out, o, OPT_SERVER_ID, c.server_id);
    }
    return finish(out, o);
}

fn build_release(c as *Client, out as *u8) as i64 {
    put_header(out, c.xid, c.my_ip, cast(*u8, &c.mac[0]), 0);
    nb.put_be32(out, HDR_LEN, MAGIC);
    let is i64 as o with mut = put_opt_u8(out, HDR_LEN + 4, OPT_MSG_TYPE, RELEASE);
    o = put_opt_ip(out, o, OPT_SERVER_ID, c.server_id);
    return finish(out, o);
}

// ---- parsing ----

fn yiaddr(p as *u8) as i64 { return nb.get_be32(p, 16); }
fn xid_of(p as *u8) as i64 { return nb.get_be32(p, 4); }

// Find an option and return its offset, or -1. Walks the TLV chain, stopping
// at END and skipping PAD. A length that runs past the end of the buffer ends
// the walk rather than being followed — a malformed reply must not be able to
// read past what arrived.
fn find_opt(p as *u8, len as i64, code as i64) as i64 {
    if (len < HDR_LEN + 4) { return 0 - 1; }
    if (nb.get_be32(p, HDR_LEN) != MAGIC) { return 0 - 1; }
    let is i64 as o with mut = HDR_LEN + 4;
    while (o < len) {
        let is i64 as c = cast(i64, p[o]);
        if (c == OPT_END) { return 0 - 1; }
        if (c == OPT_PAD) { o = o + 1; }
        else {
            if (o + 1 >= len) { return 0 - 1; }
            let is i64 as l = cast(i64, p[o + 1]);
            if (o + 2 + l > len) { return 0 - 1; }
            if (c == code) { return o + 2; }
            o = o + 2 + l;
        }
    }
    return 0 - 1;
}

fn opt_len(p as *u8, off as i64) as i64 {
    return cast(i64, p[off - 1]);
}

fn opt_ip(p as *u8, len as i64, code as i64) as i64 {
    let is i64 as o = find_opt(p, len, code);
    if (o < 0) { return 0; }
    if (opt_len(p, o) < 4) { return 0; }
    return nb.get_be32(p, o);
}

fn opt_u32(p as *u8, len as i64, code as i64) as i64 {
    let is i64 as o = find_opt(p, len, code);
    if (o < 0) { return 0; }
    if (opt_len(p, o) < 4) { return 0; }
    return nb.get_be32(p, o);
}

fn msg_type(p as *u8, len as i64) as i64 {
    let is i64 as o = find_opt(p, len, OPT_MSG_TYPE);
    if (o < 0) { return 0; }
    return cast(i64, p[o]);
}

// Is this reply ours to act on? A server reply, our transaction, our MAC.
// All three: a shared network carries other hosts' DHCP traffic, and a client
// that acts on someone else's OFFER takes an address that was never offered
// to it.
fn is_for_us(c as *Client, p as *u8, len as i64) as i64 {
    if (len < HDR_LEN + 4) { return 0; }
    if (cast(i64, p[0]) != OP_REPLY) { return 0; }
    if (xid_of(p) != c.xid) { return 0; }
    let is i64 as i with mut = 0;
    while (i < 6) {
        if (p[28 + i] != c.mac[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// ---- the state machine ----

let is i64 as ACT_NONE      = 0;
let is i64 as ACT_DISCOVER  = 1;   // broadcast a DISCOVER
let is i64 as ACT_REQUEST   = 2;   // broadcast a REQUEST
let is i64 as ACT_RENEW     = 3;   // unicast a REQUEST to server_id
let is i64 as ACT_REBIND    = 4;   // broadcast a REQUEST
let is i64 as ACT_BOUND     = 5;   // a lease was just acquired
let is i64 as ACT_EXPIRED   = 6;   // the lease ran out; the address is gone
let is i64 as ACT_FAILED    = 7;   // nobody answered

// A fresh transaction. Each attempt gets its own id so a late reply to a
// previous one cannot be mistaken for an answer to this.
fn new_xid(c as *Client, rnd as i64) as void {
    c.xid = rnd & 0xFFFFFFFF;
    if (c.xid == 0) { c.xid = 1; }
    return;
}

fn start(c as *Client, now as i64, rnd as i64) as i64 {
    new_xid(c, rnd);
    c.state = ST_SELECTING;
    c.tries = 1;
    c.backoff = RETRY_INITIAL_NS;
    c.deadline = now + c.backoff;
    return ACT_DISCOVER;
}

// What to do now, given the clock. Called from the daemon's timer sweep.
fn tick(c as *Client, now as i64, rnd as i64) as i64 {
    if (c.state == ST_BOUND) {
        if (now >= c.expires_at) {
            // The lease is over. Give the address up: continuing to use it
            // collides with whoever gets it next, and that failure looks like
            // anything except an expired lease.
            c.my_ip = 0; c.mask = 0; c.router = 0;
            c.state = ST_INIT;
            return ACT_EXPIRED;
        }
        if (now >= c.t2_at) {
            c.state = ST_REBINDING;
            new_xid(c, rnd);
            c.deadline = now + RETRY_INITIAL_NS;
            return ACT_REBIND;
        }
        if (now >= c.t1_at) {
            c.state = ST_RENEWING;
            new_xid(c, rnd);
            c.deadline = now + RETRY_INITIAL_NS;
            return ACT_RENEW;
        }
        return ACT_NONE;
    }

    if (now < c.deadline) { return ACT_NONE; }

    if (c.state == ST_SELECTING) {
        if (c.tries >= MAX_TRIES) { c.state = ST_INIT; return ACT_FAILED; }
        c.tries = c.tries + 1;
        c.backoff = c.backoff * 2;
        if (c.backoff > RETRY_MAX_NS) { c.backoff = RETRY_MAX_NS; }
        c.deadline = now + c.backoff;
        return ACT_DISCOVER;
    }
    if (c.state == ST_REQUESTING) {
        if (c.tries >= MAX_TRIES) {
            // The offer went stale. Start over rather than keep asking for an
            // address that may now belong to someone else.
            c.state = ST_INIT;
            return ACT_FAILED;
        }
        c.tries = c.tries + 1;
        c.deadline = now + RETRY_INITIAL_NS;
        return ACT_REQUEST;
    }
    if (c.state == ST_RENEWING) {
        if (now >= c.t2_at) { c.state = ST_REBINDING; return ACT_REBIND; }
        c.deadline = now + RETRY_INITIAL_NS;
        return ACT_RENEW;
    }
    if (c.state == ST_REBINDING) {
        if (now >= c.expires_at) {
            c.my_ip = 0; c.state = ST_INIT;
            return ACT_EXPIRED;
        }
        c.deadline = now + RETRY_INITIAL_NS;
        return ACT_REBIND;
    }
    return ACT_NONE;
}

// Feed a received message. Returns what changed.
fn on_message(c as *Client, p as *u8, len as i64, now as i64) as i64 {
    if (is_for_us(c, p, len) == 0) { return ACT_NONE; }
    let is i64 as t = msg_type(p, len);

    if (t == OFFER && c.state == ST_SELECTING) {
        c.offered_ip = yiaddr(p);
        c.server_id = opt_ip(p, len, OPT_SERVER_ID);
        if (c.offered_ip == 0 || c.server_id == 0) { return ACT_NONE; }
        c.state = ST_REQUESTING;
        c.tries = 1;
        c.deadline = now + RETRY_INITIAL_NS;
        return ACT_REQUEST;
    }

    if (t == ACK) {
        if (c.state != ST_REQUESTING && c.state != ST_RENEWING
            && c.state != ST_REBINDING) { return ACT_NONE; }
        c.my_ip = yiaddr(p);
        if (c.my_ip == 0) { return ACT_NONE; }
        let is i64 as m = opt_ip(p, len, OPT_SUBNET);
        if (m != 0) { c.mask = m; }
        else if (c.mask == 0) { c.mask = ip.prefix_mask(24); }
        let is i64 as r = opt_ip(p, len, OPT_ROUTER);
        if (r != 0) { c.router = r; }
        let is i64 as d = opt_ip(p, len, OPT_DNS);
        if (d != 0) { c.dns = d; }

        let is i64 as lease with mut = opt_u32(p, len, OPT_LEASE_TIME);
        if (lease <= 0) { lease = 3600; }
        c.lease_ns = lease * 1000000000;
        c.expires_at = now + c.lease_ns;
        // T1 and T2 default to half and seven-eighths of the lease, but a
        // server may state them, and its numbers win over the defaults.
        let is i64 as t1 with mut = opt_u32(p, len, OPT_RENEWAL);
        let is i64 as t2 with mut = opt_u32(p, len, OPT_REBINDING);
        if (t1 <= 0 || t1 >= lease) { t1 = lease / 2; }
        if (t2 <= 0 || t2 >= lease || t2 <= t1) { t2 = (lease * 7) / 8; }
        c.t1_at = now + t1 * 1000000000;
        c.t2_at = now + t2 * 1000000000;
        c.state = ST_BOUND;
        return ACT_BOUND;
    }

    if (t == NAK) {
        // The server refuses. Everything learned is void — including the
        // address, which is why this drops back to INIT rather than retrying
        // a REQUEST the server has already rejected.
        c.my_ip = 0; c.offered_ip = 0; c.server_id = 0;
        c.state = ST_INIT;
        return ACT_FAILED;
    }
    return ACT_NONE;
}
