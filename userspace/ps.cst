// ps — list processes. `ps`. Reads SYS_PROC_LIST: a snapshot of the process
// tree, each entry [pid, ppid, state, exit_code, thread_count, committed_bytes].
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;

fn state_name(s as i64) as *u8 {
    if (s == 1) { return "alive"; }
    if (s == 2) { return "exiting"; }
    if (s == 3) { return "zombie"; }
    if (s == 4) { return "dead"; }
    return "?";
}

fn main(argc as i64, argv as *u8) as i32 {
    let is [384]i64 as ents;                    // PROC_LIST_MAX(64) * 6
    let is i64 as total = sys.proc_list(cast(*i64, &ents[0]), 64);
    if (total < 0) { prog.outs("ps: SYS_PROC_LIST failed\n"); return cast(i32, 1); }
    prog.outs("  PID  PPID  STATE      THR        MEM\n");
    let is i64 as n with mut = total;
    if (n > 64) { n = 64; }
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as b = i * 6;
        prog.pad_num(ents[b + 0], 5); prog.outs("  ");
        prog.pad_num(ents[b + 1], 4); prog.outs("  ");
        let is *u8 as st = state_name(ents[b + 2]);
        prog.outs(st);
        let is i64 as k with mut = prog.slen(st);
        while (k < 9) { prog.outs(" "); k = k + 1; }
        prog.pad_num(ents[b + 4], 3); prog.outs("  ");
        prog.pad_num(ents[b + 5], 9);
        prog.out("\n", 1);
        i = i + 1;
    }
    if (total > 64) { prog.outs("(+ "); prog.out_num(total - 64); prog.outs(" more)\n"); }
    return 0;
}
