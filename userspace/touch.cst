// touch — create each file if it doesn't exist (never truncates). touch file...
// (CausticOS has no wall clock, so there are no timestamps to update.)
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;
use "futil.cst" as fu;

fn main(argc as i64, argv as *u8) as i32 {
    let is fu.Opt as o;
    fu.opt_init(&o, argc, argv);
    while (1 == 1) {
        let is i64 as f = fu.opt_next(&o, "");
        if (f < 0) { break; }
        prog.outs("usage: touch file ...\n"); return cast(i32, 1);
    }
    if (argc - o.ind <= 0) { prog.outs("usage: touch file ...\n"); return cast(i32, 1); }
    let is i32 as rc with mut = 0;
    let is i64 as i with mut = o.ind;
    while (i < argc) {
        let is *u8 as name = prog.arg(argv, i);
        let is [256]u8 as pb;
        let is *u8 as path = prog.abspath(name, cast(*u8, &pb[0]));
        let is i64 as fd = syscall(sys.SYS_OPEN, path, prog.slen(path), sys.O_WRONLY | sys.O_CREAT);
        if (fd < 0) { prog.outs("touch: "); prog.outs(name); prog.outs(": cannot create\n"); rc = cast(i32, 1); }
        else { sys.close(fd); }
        i = i + 1;
    }
    return rc;
}
