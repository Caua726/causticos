// touch — create a file if it doesn't exist (never truncates). `touch <file>`.
use "../../Caustic/std/causticos/prog.cst" as prog;
use "../../Caustic/std/os/causticos.cst" as sys;

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 2) { prog.outs("usage: touch <file>\n"); return cast(i32, 1); }
    let is [256]u8 as pb;
    let is *u8 as path = prog.abspath(prog.arg(argv, 1), cast(*u8, &pb[0]));
    let is i64 as fd = syscall(sys.SYS_OPEN, path, prog.slen(path), sys.O_WRONLY | sys.O_CREAT);
    if (fd < 0) {
        prog.outs("touch: cannot create "); prog.outs(path); prog.out("\n", 1);
        return cast(i32, 1);
    }
    sys.close(fd);
    return 0;
}
