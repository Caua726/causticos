name "causticos"
version "0.0.2"
author "Caua"

// causticos — build, boot and test surface.
//
//   caustic-mk run doctor          check that everything a build needs is here
//   caustic-mk run run             build it and boot it (no disk: the root is in the ISO)
//   caustic-mk run libvirt         build it and boot it as a libvirt domain
//   caustic-mk run build           just the build: kernel + userspace + live ISO
//   caustic-mk run verify          the regression sweep
//   caustic-mk run profiles        what each profile would ship
//
// `run` and `libvirt` BUILD before they boot — everything downstream of an
// edited source file is stale by definition, and a boot that silently shows the
// previous build is the most expensive kind of wrong answer. Pass --no-build to
// boot what is already there. scripts/rebuild.sh is where that policy lives.
//
// Anything past `--` reaches the script as its own arguments:
//   caustic-mk run run -- --headless --smp 4
//   caustic-mk run run -- --profile shell
//
// The userspace lives in its own Causticfile (userspace/Causticfile, 75
// targets); this one owns the kernel and everything around it.

// The default userspace profile — which programs a root image carries. Override
// per invocation with `-- --profile shell`, or in the environment.
env_default "COS_PROFILE" "desktop"
env_default "LIMINE_DIR" "/usr/share/limine"
// Python is `python3` on Linux and in MSYS2, and often just `python` on
// Windows. Overriding it is one variable rather than an edit.
env_default "PY" "python3"

// ── Dependencies ─────────────────────────────────────────────────────
//
// The kernel's ramvol driver decompresses its container with caustic-compact.
// Declared project-wide rather than on the kernel target, because the userspace
// reaches for the same two libraries and its manifest declares them the same
// way — one shape for the whole OS.
//
// These used to be relative paths climbing out of the repository
// (`use "../../../caustic-compact/..."`), which resolved only when the sibling
// repositories happened to be checked out next to this one, under exactly those
// names. Nothing recorded that requirement and nothing checked it, so a clone of
// causticos did not build and gave no hint why. Pinned tags now say which
// version this tree was built against.
depend "caustic-compact" in "https://github.com/Caua726/caustic-compact" tag "v0.1.0"

// ── Targets ──────────────────────────────────────────────────────────

// The kernel is a staged build: the Caustic source compiles to one object, the
// three hand-written .s sources assemble to three more, and caustic-ld links all
// four. The compiler's one-shot mode links exactly one object and rejects
// linker-only flags, so `asm` + `ldflags` are what make this expressible at all.
//
// Objects reach the linker in declaration order, main source first — the order
// below is the order the kernel has always been linked in.
//
// --strip is load-bearing, not cosmetic: Limine inspects section headers when
// they are present and the resulting load behaviour diverges from
// program-header-only mode. Non-stripped kernels page-fault inside sched.init.
// The bug is in Limine's handling of an embedded symtab/strtab rather than in
// caustic-ld's section layout, so kernels stay stripped by policy.
//
// cdvrspec_data.s .incbin's the driver .cdvrspec text blobs. The staged pipeline
// re-assembles every `asm` on every build, so editing a driver's spec always
// reaches the kernel — a stale .s.o can never silently run the old specs.
target "kernel" {
    src "kernel/main.cst"
    out "build/kernel.elf"
    flags "--path kernel --path kernel/arch --path kernel/time --path kernel/mm --path kernel/task --path kernel/drivers --path kernel/fs --path kernel/ipc --path kernel/sys --path kernel/lib --path kernel/test --path font"
    asm "kernel/cdvrspec_data.s"
    asm "kernel/smp_asm.s"
    asm "kernel/syscall_entry.s"
    asm "kernel/random_asm.s"
    ldflags "--strip --freestanding --entry=_kernel_start --base=0xFFFFFFFF80000000"
}

// The standalone assembler and linker, cross-built for CausticOS so the `dev`
// profile can ship the whole toolchain. The CANONICAL binaries come out of the
// on-device bootstrap; these are the development shortcut.
target "caustic-as-cse" {
    src "${CAUSTIC_DIR}/caustic-assembler/main.cst"
    out "build/caustic-as.cse"
    flags "--target=caustic-x86_64"
}

target "caustic-ld-cse" {
    src "${CAUSTIC_DIR}/caustic-linker/main.cst"
    out "build/caustic-ld.cse"
    flags "--target=caustic-x86_64"
}

// ── Scripts ──────────────────────────────────────────────────────────

script "doctor" {
    "bash scripts/doctor.sh"
}

// Everything, in dependency order. The userspace is its own project, so it gets
// its own caustic-mk invocation rather than being duplicated here.
//
// This is the ONE definition of what a build is: `run` and `libvirt` reach it
// through scripts/rebuild.sh rather than repeating the three steps, so a step
// added here reaches every path that boots.
script "build" {
    "caustic-mk build kernel"
    "cd userspace && caustic-mk build all"
    "bash scripts/mkiso.sh $@"
}

// Just the ISO, assuming the kernel and userspace are already built. This is the
// loop for changing what SHIPS rather than what the code does — a profile edit
// repacks in well under a second and recompiles nothing.
script "iso" {
    "bash scripts/mkiso.sh $@"
}

// Builds first, then boots. `run -- --no-build` is the old behaviour.
script "run" {
    "bash scripts/qemu.sh $@"
}

// The same build and the same machine, hosted by libvirtd instead of a bare
// QEMU process. Worth having for two reasons: QEMU's own GTK window does not
// open under native Wayland and the SPICE console does, and a libvirt domain
// outlives the shell that started it. The domain is redefined from
// causticos.libvirt.xml every time, so it always boots what was just built.
script "libvirt" {
    "bash scripts/libvirt.sh $@"
}

script "verify" {
    "bash scripts/verify.sh $@"
}

// What a profile actually resolves to. "What is on the ISO" should be one
// command, not an archaeology exercise across a pile of shell scripts.
script "profiles" {
    "$PY scripts/mkroot.py --profile ${COS_PROFILE} --list $@"
}

// Just the root volume, as a raw image and a container — handy when the question
// is about the image itself rather than about booting it.
script "root" {
    "$PY scripts/mkroot.py --profile ${COS_PROFILE} --img build/rootfs.img --csvi build/rootfs.csvi $@"
}

script "clean" {
    "rm -rf build/iso build/*.img build/*.csvi build/kernel.elf build/causticos.iso"
    "rm -rf userspace/build .caustic userspace/.caustic"
    "echo 'clean: build artifacts removed (sources and the self-hosted caustic.cse kept)'"
}

// Deep clean: also the generated assembly and objects that no build regenerates
// and nothing ever removed. The discriminator is exact — compiler output always
// ends in .cst.s, so the four hand-written .s sources the kernel needs are never
// touched.
script "distclean" {
    "caustic-mk run clean"
    "find . -name '*.cst.s' -delete"
    "find . -name '*.s.o' -delete"
    "rm -rf scripts/__pycache__"
    "echo 'distclean: generated assembly and objects removed too'"
}

script "usb" {
    "bash scripts/usb.sh $@"
}
