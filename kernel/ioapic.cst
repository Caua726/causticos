// ioapic.cst — IOAPIC discovery + redirection management.
//
// Pulls the IOAPIC physical address from ACPI MADT (acpi.cst) instead
// of the legacy 0xFEC00000 hardcode so boards that remap the IOAPIC
// (multi-socket, QEMU -smp > some layouts, hardware with non-default
// chipsets) are handled correctly. Falls back to the legacy address
// if ACPI didn't find any IOAPIC entry — that's the 1-IOAPIC, 1-CPU
// PC-AT defaults worst case, good enough for bring-up.

use "vmm.cst" as vmm;
use "serial.cst" as serial;
use "sched.cst" as sched;
use "util.cst" as util;
use "acpi.cst" as acpi;

let is i64 as IOAPIC_FALLBACK_PHYS = 0xFEC00000;

let is i64 as ioapic_base  with mut = 0;
let is i64 as redir_count  with mut = 0;

// Vector bitmap for driver-framework allocation. 256 vectors total,
// covered by 4 × i64 (one bit per vector). Set = in use. Vectors below
// 32 are reserved for CPU exceptions, 32-47 for the legacy PIC/LAPIC
// plumbing already installed in idt.cst, 48+ for driver use.
let is [4]i64 as vector_bitmap with mut;

fn read_reg(reg as i64) as i64 {
    let is *u32 as sel = cast(*u32, ioapic_base);
    let is *u32 as win = cast(*u32, ioapic_base + 0x10);
    *sel = cast(u32, reg);
    return cast(i64, *win) & 0xFFFFFFFF;
}

fn write_reg(reg as i64, val as i64) as void {
    let is *u32 as sel = cast(*u32, ioapic_base);
    let is *u32 as win = cast(*u32, ioapic_base + 0x10);
    *sel = cast(u32, reg);
    *win = cast(u32, val);
}

fn init() as void {
    // Discovery: prefer the MADT-derived address. acpi.parse() runs
    // before ioapic.init() in main.cst's boot sequence.
    let is i64 as phys with mut = acpi.first_ioapic_addr();
    if (phys == 0) {
        serial.println("ioapic: no MADT entry, using legacy 0xFEC00000", 46);
        phys = IOAPIC_FALLBACK_PHYS;
    }

    ioapic_base = vmm.kvmap(4096, vmm.KV_MMIO, 0, phys);
    if (ioapic_base == 0) {
        serial.println("ioapic: mmio_map failed", 23);
        return;
    }
    let is i64 as ver = read_reg(0x01);
    redir_count = ((ver >> 16) & 0xFF) + 1;
    serial.print("ioapic: phys=", 13);
    util.print_hex(phys);
    serial.print(" version=", 9);
    util.print_hex(ver & 0xFF);
    serial.print(" entries=", 9);
    util.print_num(redir_count);
    serial.println("", 0);
    // Publish the GSI end for the first IOAPIC so acpi queries can
    // route by range. Only IOAPIC 0 is active today; multi-IOAPIC
    // systems are rare on x86 and we extend when we meet one.
    if (acpi.ioapic_count > 0) {
        acpi.ioapics[0].gsi_end = acpi.ioapics[0].gsi_base + redir_count;
    }

    // Pre-reserve vectors that already have dedicated handlers. idt.cst
    // installs stubs for exceptions (0-31), PIC IRQs (32-47), driver IRQ
    // slots 48-63 (.Ldrvirq48..63), and the LAPIC timer (64). 48 is
    // the smoke-test int 0x30 target; real driver allocations land in
    // 49-63 (15 slots). Vectors 65+ are unassigned.
    let is i64 as vv with mut = 0;
    while (vv < 48) { bitmap_set(vv); vv = vv + 1; }    // exceptions + PIC
    bitmap_set(48);                                      // smoke-test target
    bitmap_set(64);                                      // LAPIC timer
}

// Program redirection entry for `irq` — interpreted as a legacy ISA
// line number. We apply any ACPI Interrupt Source Override to translate
// it to the real GSI, then combine the ISO polarity/trigger flags with
// fixed delivery mode + physical destination.
//
// ISO flags (MADT spec §5.2.12):
//   bits 0-1: polarity   — 00 = conforms-to-bus, 01 = active-high,
//                           11 = active-low
//   bits 2-3: trigger    — 00 = conforms-to-bus, 01 = edge,
//                           11 = level
// IOAPIC redirection entry:
//   bit 13: polarity (0 = high, 1 = low)
//   bit 15: trigger  (0 = edge, 1 = level)
// "Conforms" for ISA defaults to edge + active-high, which is what we
// emit when no ISO is present (the legacy PC-AT wiring).
fn set_redirection(irq as i64, vector as i64, dest as i64) as void {
    let is i64 as gsi = acpi.remap_isa_irq(irq);
    let is i64 as flags = acpi.isa_flags(irq);

    let is i64 as entry_idx with mut = gsi;
    if (acpi.ioapic_count > 0) {
        // Subtract gsi_base so the IOAPIC register index is relative
        // to that IOAPIC's range. Single-IOAPIC systems have base=0.
        entry_idx = gsi - acpi.ioapics[0].gsi_base;
    }
    if (entry_idx < 0 || entry_idx >= redir_count) { return; }

    let is i64 as polarity = (flags >> 0) & 0x3;
    let is i64 as trigger  = (flags >> 2) & 0x3;
    let is i64 as lo_extra with mut = 0;
    if (polarity == 3) { lo_extra = lo_extra | (cast(i64, 1) << 13); }
    if (trigger  == 3) { lo_extra = lo_extra | (cast(i64, 1) << 15); }

    let is i64 as lo_reg = 0x10 + entry_idx * 2;
    let is i64 as hi_reg = lo_reg + 1;
    write_reg(hi_reg, (dest & 0xFF) << 24);
    write_reg(lo_reg, (vector & 0xFF) | lo_extra);
}

fn mask(irq as i64) as void {
    let is i64 as gsi = acpi.remap_isa_irq(irq);
    let is i64 as entry_idx with mut = gsi;
    if (acpi.ioapic_count > 0) {
        entry_idx = gsi - acpi.ioapics[0].gsi_base;
    }
    if (entry_idx < 0 || entry_idx >= redir_count) { return; }
    let is i64 as lo_reg = 0x10 + entry_idx * 2;
    let is i64 as lo = read_reg(lo_reg);
    write_reg(lo_reg, lo | 0x10000);
}

// Vector bitmap helpers. Each i64 entry covers 64 vectors; vector v
// lives in vector_bitmap[v>>6] bit (v & 63).
fn bitmap_get(v as i64) as i32 {
    if (v < 0) { return 1; }
    if (v >= 256) { return 1; }
    let is i64 as word = vector_bitmap[v >> 6];
    if (((word >> (v & 63)) & 1) == 1) { return 1; }
    return 0;
}

fn bitmap_set(v as i64) as void {
    if (v < 0) { return; }
    if (v >= 256) { return; }
    vector_bitmap[v >> 6] = vector_bitmap[v >> 6] | (cast(i64, 1) << (v & 63));
}

fn bitmap_clear(v as i64) as void {
    if (v < 0) { return; }
    if (v >= 256) { return; }
    let is i64 as mask_val = cast(i64, 1) << (v & 63);
    vector_bitmap[v >> 6] = vector_bitmap[v >> 6] & (0 - 1 - mask_val);
}

// Mark vector `v` as already taken. Called for hardcoded vectors
// (LAPIC timer 64, smoke-test 48, etc.) so alloc_vector skips them.
fn reserve_vector(v as i64) as void {
    sched.preempt_disable();
    bitmap_set(v);
    sched.preempt_enable();
}

// Allocate the first free vector in [start, end). Returns the vector,
// or -1 if none available. Caller is responsible for calling
// release_vector when done.
fn alloc_vector(start as i64, end as i64) as i64 {
    let is i64 as lo with mut = start;
    let is i64 as hi with mut = end;
    if (lo < 0) { lo = 0; }
    if (hi > 256) { hi = 256; }
    sched.preempt_disable();
    let is i64 as v with mut = lo;
    let is i64 as found with mut = 0 - 1;
    while (v < hi) {
        if (bitmap_get(v) == 0) {
            bitmap_set(v);
            found = v;
            v = hi;
        } else {
            v = v + 1;
        }
    }
    sched.preempt_enable();
    return found;
}

fn release_vector(v as i64) as void {
    sched.preempt_disable();
    bitmap_clear(v);
    sched.preempt_enable();
}
