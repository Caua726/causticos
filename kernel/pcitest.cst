// pcitest.cst — e1000 (82540EM) driver.
//
// Phase 2.5: declarative spec in kernel/e1000.cdvrspec drives match +
// lifecycle. This module only exposes the bind callback and publishes
// it in the kernel symbol table; no DriverImpl, no bus_register_driver.

use "driver.cst" as driver;
use "pci.cst" as pci;
use "spec.cst" as spec;
use "ksym.cst" as ksym;
use "serial.cst" as serial;
use "util.cst" as util;

// BAR0 is 128 KB of memory-mapped registers.
let is i64 as E1000_BAR0_SIZE = 0x20000;

// Vtable shape mirroring the methods declared in e1000.cdvrspec's
// `implements { NetworkController { send; recv; mac; } }` block.
// Order is the source-order from the .cdvrspec — Phase 4 vtable
// codegen (slice 4) will eventually generate this struct from the
// `interface NetworkController { ... }` declaration directly.
struct NetworkControllerVtable {
    send as fn(*u8, i64) as i32;
    recv as fn(*u8, i64) as i32;
    mac  as fn() as *u8;
}

// Register offsets we touch in step 1.
let is i64 as E1000_STATUS = 0x0008;
let is i64 as E1000_RAL0   = 0x5400;
let is i64 as E1000_RAH0   = 0x5404;

fn read32(regs as *u8, off as i64) as i64 {
    let is *u32 as p = cast(*u32, cast(i64, regs) + off);
    return cast(i64, *p) & 0xFFFFFFFF;
}

fn print_mac(ral as i64, rah as i64) as void {
    let is i64 as b0 = ral & 0xFF;
    let is i64 as b1 = (ral >> 8)  & 0xFF;
    let is i64 as b2 = (ral >> 16) & 0xFF;
    let is i64 as b3 = (ral >> 24) & 0xFF;
    let is i64 as b4 = rah & 0xFF;
    let is i64 as b5 = (rah >> 8) & 0xFF;
    util.print_hex(b0); serial.putc(58);
    util.print_hex(b1); serial.putc(58);
    util.print_hex(b2); serial.putc(58);
    util.print_hex(b3); serial.putc(58);
    util.print_hex(b4); serial.putc(58);
    util.print_hex(b5);
}

// Lifecycle callback resolved by specparse via ksym. Phase 3: the
// framework populates b.caps.mmio from the `mmio: 0, 0x20000`
// capability declared in e1000.cdvrspec — no direct driver.mmio_map
// call anymore.
fn e1000_bind(b as *spec.Binding) as i32 {
    let is *pci.PciHardware as pd = cast(*pci.PciHardware, b.hardware);
    serial.print("e1000: probe ", 13);
    util.print_num(cast(i64, pd.bus));
    serial.putc(58);
    util.print_num(cast(i64, pd.dev));
    serial.putc(46);
    util.print_num(cast(i64, pd.func));
    serial.print(" bar0=", 6);
    util.print_hex(cast(i64, pd.bar0));
    serial.println("", 0);

    let is *u8 as regs = b.caps.mmio;
    if (cast(i64, regs) == 0) {
        serial.println("e1000: no mmio capability", 25);
        return cast(i32, 0 - 1);
    }

    // Phase 4 slice 2 demo: find our own NetworkController vtable on the
    // binding's spec and call mac() through it. The vtable layout matches
    // the declaration order in e1000.cdvrspec's implements block:
    // 0=send, 1=recv, 2=mac.
    let is *u8 as vt = spec.lookup_iface(b, cast(*u8, "NetworkController"), 17);
    if (cast(i64, vt) != 0) {
        let is *NetworkControllerVtable as vtable = cast(*NetworkControllerVtable, vt);
        let is *u8 as mac_ptr = call(vtable.mac);
        serial.print("e1000.iface: mac fn returned ", 29);
        util.print_hex(cast(i64, mac_ptr));
        serial.println("", 0);
    } else {
        serial.println("e1000.iface: NetworkController not implemented", 46);
    }

    let is i64 as status = read32(regs, E1000_STATUS);
    serial.print("e1000: status=", 14);
    util.print_hex(status);
    if ((status & 0x2) != 0) {
        serial.print(" link=up", 8);
    } else {
        serial.print(" link=down", 10);
    }
    if ((status & 0x1) != 0) {
        serial.print(" fd", 3);
    }
    serial.println("", 0);

    let is i64 as ral = read32(regs, E1000_RAL0);
    let is i64 as rah = read32(regs, E1000_RAH0);
    serial.print("e1000: mac=", 11);
    print_mac(ral, rah);
    serial.println("", 0);

    return driver.OK;
}

// Phase 4 slice 2 demo: stub implementations of a NetworkController
// interface. Real send/recv would need ring setup; for now they just
// log and return.
fn e1000_send(packet as *u8, len as i64) as i32 {
    serial.print("e1000.send len=", 15);
    util.print_num(len);
    serial.println("", 0);
    return 0;
}

fn e1000_recv(packet as *u8, max_len as i64) as i32 {
    return 0;
}

let is [6]u8 as e1000_mac_buf;

fn e1000_mac() as *u8 {
    return &e1000_mac_buf[0];
}

let is ksym.KSym as ksym_e1000_bind;
let is ksym.KSym as ksym_e1000_send;
let is ksym.KSym as ksym_e1000_recv;
let is ksym.KSym as ksym_e1000_mac;

fn register() as void {
    ksym_e1000_bind.name_ptr = cast(*u8, "pcitest.e1000_bind");
    ksym_e1000_bind.name_len = 18;
    ksym_e1000_bind.addr     = cast(i64, fn_ptr(e1000_bind));
    ksym_e1000_bind.kind     = ksym.KIND_FUNC;
    ksym.register(&ksym_e1000_bind);

    ksym_e1000_send.name_ptr = cast(*u8, "pcitest.e1000_send");
    ksym_e1000_send.name_len = 18;
    ksym_e1000_send.addr     = cast(i64, fn_ptr(e1000_send));
    ksym_e1000_send.kind     = ksym.KIND_FUNC;
    ksym.register(&ksym_e1000_send);

    ksym_e1000_recv.name_ptr = cast(*u8, "pcitest.e1000_recv");
    ksym_e1000_recv.name_len = 18;
    ksym_e1000_recv.addr     = cast(i64, fn_ptr(e1000_recv));
    ksym_e1000_recv.kind     = ksym.KIND_FUNC;
    ksym.register(&ksym_e1000_recv);

    ksym_e1000_mac.name_ptr = cast(*u8, "pcitest.e1000_mac");
    ksym_e1000_mac.name_len = 17;
    ksym_e1000_mac.addr     = cast(i64, fn_ptr(e1000_mac));
    ksym_e1000_mac.kind     = ksym.KIND_FUNC;
    ksym.register(&ksym_e1000_mac);
}
