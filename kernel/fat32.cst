// fat32.cst — FAT32 volume parse + mount.
//
// Phase 2 of the FAT32 stack: read sector 0 (BPB), validate the volume
// is really FAT32, extract layout parameters, and publish the mounted
// volume for later phases (FAT walk, directory traversal, file I/O).
//
// Reference: Microsoft FAT Specification (FATGEN103), section BPB/BS.
// We support bytes_per_sector in {512, 1024, 2048, 4096}, sectors_per_
// cluster that is a power of two in [1, 128], num_fats in {1, 2}, and
// require the "FAT32   " fs_type string + 0x55AA signature.
//
// No heap dependency: a single static Fat32Volume slot is the V1 mount
// table. Adding more mounts means promoting to a linked list.

use "storage.cst" as storage;
use "serial.cst"  as serial;
use "util.cst"    as util;
use "pmm.cst"     as pmm;
use "sched.cst"   as sched;

// ============================================================
// BPB offsets (see FAT spec). Bytes unless suffixed _w (u16) or _d (u32).
// ============================================================
let is i64 as BPB_JMP           = 0x00;   // 3 bytes: short jump + nop
let is i64 as BPB_OEM           = 0x03;   // 8 bytes
let is i64 as BPB_BYTES_PER_SEC = 0x0B;   // u16
let is i64 as BPB_SEC_PER_CLUS  = 0x0D;   // u8
let is i64 as BPB_RSVD_SEC_CNT  = 0x0E;   // u16
let is i64 as BPB_NUM_FATS      = 0x10;   // u8
let is i64 as BPB_ROOT_ENT_CNT  = 0x11;   // u16 (must be 0 for FAT32)
let is i64 as BPB_TOT_SEC_16    = 0x13;   // u16 (must be 0 for FAT32)
let is i64 as BPB_MEDIA         = 0x15;   // u8
let is i64 as BPB_FAT_SZ_16     = 0x16;   // u16 (must be 0 for FAT32)
let is i64 as BPB_TOT_SEC_32    = 0x20;   // u32
let is i64 as BPB_FAT_SZ_32     = 0x24;   // u32
let is i64 as BPB_EXT_FLAGS     = 0x28;   // u16
let is i64 as BPB_FS_VER        = 0x2A;   // u16 (must be 0)
let is i64 as BPB_ROOT_CLUS     = 0x2C;   // u32
let is i64 as BPB_FS_INFO       = 0x30;   // u16
let is i64 as BPB_BK_BOOT       = 0x32;   // u16
let is i64 as BPB_VOL_ID        = 0x43;   // u32
let is i64 as BPB_VOL_LAB       = 0x47;   // 11 bytes
let is i64 as BPB_FS_TYPE       = 0x52;   // 8 bytes, "FAT32   "
let is i64 as BPB_SIG           = 0x1FE;  // u16, must be 0xAA55

struct Fat32Volume {
    dev as *storage.StorageDevice;

    // Raw BPB values (as i64 for consistent arithmetic).
    bytes_per_sector  as i64;
    sectors_per_clus  as i64;
    reserved_sectors  as i64;
    num_fats          as i64;
    fat_size_sectors  as i64;   // BPB_FAT_SZ_32
    total_sectors     as i64;   // BPB_TOT_SEC_32
    root_cluster      as i64;
    fs_info_sector    as i64;
    volume_id         as i64;
    volume_label      as [12]u8;   // zero-terminated copy of BPB_VOL_LAB

    // Derived.
    cluster_size_bytes as i64;
    fat_start_lba      as i64;   // reserved_sectors
    data_start_lba     as i64;   // reserved + num_fats * fat_size
    cluster_count      as i64;   // (total - data_start) / sectors_per_clus
    is_mounted         as i32;   // 1 if valid, 0 otherwise
}

// Single static mount slot (V1).
let is Fat32Volume as vol;

// Scratch buffer for sector reads. AHCI requires DMA-safe memory in the
// HHDM region (not kernel .bss), so we lazily allocate a page via pmm
// on first use. One 4KB page fits a max-size sector (4096B).
// Two dedicated scratch pages: one for FAT sector reads, one for the
// data cluster currently being consumed. Separating them means FAT
// lookups during a file read don't clobber the payload buffer.
let is i64 as scratch_virt     with mut = 0;
let is i64 as clus_scratch_virt with mut = 0;

fn alloc_dma_page() as i64 {
    let is i32 as pfn = pmm.alloc_pages(
        pmm.ZONE_DMA32,
        pmm.ALLOC_ZERO,
        cast(i32, 0),
        pmm.USAGE_KERNEL,
        cast(i32, 0));
    if (pfn == pmm.PFN_NONE) { return 0; }
    return pmm.pfn_to_phys(pfn) + pmm.hhdm;
}

fn ensure_scratch() as i32 {
    if (scratch_virt == 0) {
        scratch_virt = alloc_dma_page();
        if (scratch_virt == 0) { return cast(i32, 0 - 1); }
    }
    if (clus_scratch_virt == 0) {
        clus_scratch_virt = alloc_dma_page();
        if (clus_scratch_virt == 0) { return cast(i32, 0 - 1); }
    }
    return 0;
}

// ============================================================
// Little-endian readers from a byte buffer. FAT32 is defined LE.
// ============================================================

fn read_u16(buf as *u8, off as i64) as i64 {
    return cast(i64, buf[off]) | (cast(i64, buf[off + 1]) << 8);
}

fn read_u32(buf as *u8, off as i64) as i64 {
    return cast(i64, buf[off])
         | (cast(i64, buf[off + 1]) << 8)
         | (cast(i64, buf[off + 2]) << 16)
         | (cast(i64, buf[off + 3]) << 24);
}

// Validate bytes_per_sector is one of {512, 1024, 2048, 4096} (spec).
fn is_valid_sector_size(n as i64) as i32 {
    if (n == 512)  { return 1; }
    if (n == 1024) { return 1; }
    if (n == 2048) { return 1; }
    if (n == 4096) { return 1; }
    return 0;
}

// Validate sectors_per_cluster is a power of two in [1, 128].
fn is_valid_spc(n as i64) as i32 {
    if (n < 1)   { return 0; }
    if (n > 128) { return 0; }
    if ((n & (n - 1)) != 0) { return 0; }
    return 1;
}

// ============================================================
// mount — read BPB, validate, derive layout, publish volume.
// Returns null on any validation failure; logs the reason.
// ============================================================

fn mount(dev as *storage.StorageDevice) as *Fat32Volume {
    if (cast(i64, dev) == 0) {
        serial.println("fat32: mount null dev", 21);
        return cast(*Fat32Volume, 0);
    }

    // Read sector 0. dev.sector_size may be >512, so we read one sector
    // into the 4KB scratch (always big enough).
    let is i64 as ss = storage.sector_size(dev);
    if (ss < 512 || ss > 4096) {
        serial.print("fat32: bad dev sector_size=", 27);
        util.print_num(ss);
        serial.println("", 0);
        return cast(*Fat32Volume, 0);
    }

    if (ensure_scratch() != 0) {
        serial.println("fat32: scratch alloc failed", 27);
        return cast(*Fat32Volume, 0);
    }
    let is *u8 as buf = cast(*u8, scratch_virt);
    let is i32 as rc = storage.read_lba(dev, 0, 1, buf);
    if (rc != 0) {
        serial.print("fat32: read sector 0 failed rc=", 31);
        util.print_num(cast(i64, rc));
        serial.println("", 0);
        return cast(*Fat32Volume, 0);
    }

    // Signature check first — cheapest rejection.
    let is i64 as sig = read_u16(buf, BPB_SIG);
    if (sig != 0xAA55) {
        serial.print("fat32: bad signature 0x", 23);
        util.print_hex(sig);
        serial.println("", 0);
        return cast(*Fat32Volume, 0);
    }

    // fs_type string must match "FAT32   " (8 bytes).
    let is i64 as fs0 = cast(i64, buf[BPB_FS_TYPE + 0]);
    let is i64 as fs1 = cast(i64, buf[BPB_FS_TYPE + 1]);
    let is i64 as fs2 = cast(i64, buf[BPB_FS_TYPE + 2]);
    let is i64 as fs3 = cast(i64, buf[BPB_FS_TYPE + 3]);
    let is i64 as fs4 = cast(i64, buf[BPB_FS_TYPE + 4]);
    if (fs0 != 70 || fs1 != 65 || fs2 != 84 || fs3 != 51 || fs4 != 50) {
        serial.println("fat32: fs_type not FAT32", 24);
        return cast(*Fat32Volume, 0);
    }

    // Pull raw BPB fields.
    let is i64 as bps   = read_u16(buf, BPB_BYTES_PER_SEC);
    let is i64 as spc   = cast(i64, buf[BPB_SEC_PER_CLUS]);
    let is i64 as rsvd  = read_u16(buf, BPB_RSVD_SEC_CNT);
    let is i64 as nfats = cast(i64, buf[BPB_NUM_FATS]);
    let is i64 as re16  = read_u16(buf, BPB_ROOT_ENT_CNT);
    let is i64 as ts16  = read_u16(buf, BPB_TOT_SEC_16);
    let is i64 as fs16  = read_u16(buf, BPB_FAT_SZ_16);
    let is i64 as ts32  = read_u32(buf, BPB_TOT_SEC_32);
    let is i64 as fs32  = read_u32(buf, BPB_FAT_SZ_32);
    let is i64 as rclus = read_u32(buf, BPB_ROOT_CLUS);
    let is i64 as fsver = read_u16(buf, BPB_FS_VER);
    let is i64 as fsi   = read_u16(buf, BPB_FS_INFO);

    // Validations per FAT32 spec.
    if (is_valid_sector_size(bps) == 0) {
        serial.print("fat32: bad bytes_per_sector=", 28);
        util.print_num(bps); serial.println("", 0);
        return cast(*Fat32Volume, 0);
    }
    if (bps != ss) {
        // BPB must agree with the physical device sector size.
        serial.print("fat32: BPB bps=", 15);
        util.print_num(bps);
        serial.print(" != dev ss=", 11);
        util.print_num(ss);
        serial.println("", 0);
        return cast(*Fat32Volume, 0);
    }
    if (is_valid_spc(spc) == 0) {
        serial.print("fat32: bad sectors_per_clus=", 28);
        util.print_num(spc); serial.println("", 0);
        return cast(*Fat32Volume, 0);
    }
    if (rsvd < 1) {
        serial.println("fat32: reserved_sectors<1", 25);
        return cast(*Fat32Volume, 0);
    }
    if (nfats < 1 || nfats > 2) {
        serial.print("fat32: bad num_fats=", 20);
        util.print_num(nfats); serial.println("", 0);
        return cast(*Fat32Volume, 0);
    }
    // FAT32 requires these to be zero.
    if (re16 != 0) { serial.println("fat32: root_ent_cnt!=0", 22); return cast(*Fat32Volume, 0); }
    if (ts16 != 0) { serial.println("fat32: tot_sec_16!=0",   20); return cast(*Fat32Volume, 0); }
    if (fs16 != 0) { serial.println("fat32: fat_sz_16!=0",    19); return cast(*Fat32Volume, 0); }
    if (fsver != 0) { serial.println("fat32: fs_ver!=0",      16); return cast(*Fat32Volume, 0); }
    if (fs32 < 1) { serial.println("fat32: fat_sz_32<1",      18); return cast(*Fat32Volume, 0); }
    if (ts32 < 1) { serial.println("fat32: tot_sec_32<1",     19); return cast(*Fat32Volume, 0); }
    if (rclus < 2) {
        serial.print("fat32: root_clus<2 =", 20);
        util.print_num(rclus); serial.println("", 0);
        return cast(*Fat32Volume, 0);
    }

    // Derived layout.
    let is i64 as fat_lba   = rsvd;
    let is i64 as data_lba  = rsvd + nfats * fs32;
    if (data_lba >= ts32) {
        serial.println("fat32: data_lba past end", 24);
        return cast(*Fat32Volume, 0);
    }
    let is i64 as data_secs = ts32 - data_lba;
    let is i64 as ccount    = data_secs / spc;
    // FAT32 spec: cluster_count must be >= 65525 to be a valid FAT32.
    if (ccount < 65525) {
        serial.print("fat32: cluster_count=", 21);
        util.print_num(ccount);
        serial.println(" < 65525 (not FAT32)", 20);
        return cast(*Fat32Volume, 0);
    }
    if (rclus >= ccount + 2) {
        serial.println("fat32: root_clus out of range", 29);
        return cast(*Fat32Volume, 0);
    }

    // Cross-check device has enough sectors for the volume.
    let is i64 as devsecs = storage.sector_count(dev);
    if (devsecs > 0 && ts32 > devsecs) {
        serial.print("fat32: BPB tot_sec=", 19);
        util.print_num(ts32);
        serial.print(" > dev=", 7);
        util.print_num(devsecs);
        serial.println("", 0);
        return cast(*Fat32Volume, 0);
    }

    // Commit to volume struct.
    vol.dev                = dev;
    vol.bytes_per_sector   = bps;
    vol.sectors_per_clus   = spc;
    vol.reserved_sectors   = rsvd;
    vol.num_fats           = nfats;
    vol.fat_size_sectors   = fs32;
    vol.total_sectors      = ts32;
    vol.root_cluster       = rclus;
    vol.fs_info_sector     = fsi;
    vol.volume_id          = read_u32(buf, BPB_VOL_ID);
    vol.cluster_size_bytes = bps * spc;
    vol.fat_start_lba      = fat_lba;
    vol.data_start_lba     = data_lba;
    vol.cluster_count      = ccount;

    // Copy volume label (11 bytes, space-padded in BPB).
    let is i64 as i with mut = 0;
    while (i < 11) {
        vol.volume_label[i] = buf[BPB_VOL_LAB + i];
        i = i + 1;
    }
    vol.volume_label[11] = cast(u8, 0);
    vol.is_mounted = 1;

    // Log concise summary.
    serial.print("fat32: mounted ", 15);
    let is i64 as j with mut = 0;
    while (j < 11) {
        let is u8 as c = vol.volume_label[j];
        if (c == cast(u8, 0)) { j = 11; }
        else { serial.putc(cast(i64, c)); j = j + 1; }
    }
    serial.print(" bps=", 5);   util.print_num(bps);
    serial.print(" spc=", 5);   util.print_num(spc);
    serial.print(" rsvd=", 6);  util.print_num(rsvd);
    serial.print(" fatsz=", 7); util.print_num(fs32);
    serial.print(" clusters=", 10); util.print_num(ccount);
    serial.print(" root=", 6);  util.print_num(rclus);
    serial.println("", 0);

    return &vol;
}

// ============================================================
// Accessors / helpers for later phases.
// ============================================================

fn head() as *Fat32Volume {
    if (vol.is_mounted == 0) { return cast(*Fat32Volume, 0); }
    return &vol;
}

// Convert a cluster number (>=2) to its absolute LBA on the device.
// Returns -1 if cluster is out of range.
fn cluster_to_lba(v as *Fat32Volume, cluster as i64) as i64 {
    if (cast(i64, v) == 0) { return 0 - 1; }
    if (cluster < 2) { return 0 - 1; }
    if (cluster >= v.cluster_count + 2) { return 0 - 1; }
    return v.data_start_lba + (cluster - 2) * v.sectors_per_clus;
}

// ============================================================
// FAT entry walk — read next-cluster value for `cluster`.
// Returns the raw 28-bit entry value. Callers interpret:
//   0             -> free (unexpected during walk)
//   2..0x0FFFFFEF -> next cluster
//   0x0FFFFFF7    -> bad cluster
//   0x0FFFFFF8..  -> EOF
// Returns -1 on I/O failure.
// ============================================================

fn fat_read(v as *Fat32Volume, cluster as i64) as i64 {
    if (cast(i64, v) == 0) { return 0 - 1; }
    if (cluster < 2) { return 0 - 1; }
    if (cluster >= v.cluster_count + 2) { return 0 - 1; }
    let is i64 as byte_off = cluster * 4;
    let is i64 as sec  = v.fat_start_lba + byte_off / v.bytes_per_sector;
    let is i64 as soff = byte_off % v.bytes_per_sector;
    let is *u8 as buf = cast(*u8, scratch_virt);
    let is i32 as rc = storage.read_lba(v.dev, sec, 1, buf);
    if (rc != 0) { return 0 - 1; }
    return read_u32(buf, soff) & 0x0FFFFFFF;
}

fn cluster_is_eof(entry as i64) as i32 {
    if (entry >= 0x0FFFFFF8 && entry <= 0x0FFFFFFF) { return 1; }
    return 0;
}

// Read one full cluster into the provided HHDM-resident buffer.
// buf must hold at least cluster_size_bytes. Returns 0 on success.
fn cluster_read(v as *Fat32Volume, cluster as i64, buf as *u8) as i32 {
    if (cast(i64, v) == 0) { return cast(i32, 0 - 1); }
    let is i64 as lba = cluster_to_lba(v, cluster);
    if (lba < 0) { return cast(i32, 0 - 2); }
    return storage.read_lba(v.dev, lba, v.sectors_per_clus, buf);
}

// ============================================================
// 8.3 short-name formatting — converts a caller-supplied name like
// "hello.txt" to the 11-byte uppercase space-padded form "HELLO   TXT"
// that the directory entry stores. Accepts only ASCII; any character
// outside A-Z/0-9/a-z/._ is rejected (return != 0).
// ============================================================

fn upper_ascii(c as i64) as i64 {
    if (c >= 97 && c <= 122) { return c - 32; }   // 'a'-'z'
    return c;
}

fn format_8_3(name as *u8, name_len as i64, out as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < 11) { out[i] = cast(u8, 32); i = i + 1; }   // space-pad
    if (name_len <= 0 || name_len > 12) { return cast(i32, 0 - 1); }

    // Split at '.' (last one before the extension).
    let is i64 as dot with mut = 0 - 1;
    let is i64 as j with mut = 0;
    while (j < name_len) {
        if (name[j] == cast(u8, 46)) { dot = j; }   // '.'
        j = j + 1;
    }

    let is i64 as base_end with mut = name_len;
    if (dot >= 0) { base_end = dot; }
    if (base_end == 0 || base_end > 8) { return cast(i32, 0 - 2); }

    let is i64 as k with mut = 0;
    while (k < base_end) {
        let is i64 as ch = upper_ascii(cast(i64, name[k]));
        if (ch < 32 || ch > 126) { return cast(i32, 0 - 3); }
        out[k] = cast(u8, ch);
        k = k + 1;
    }
    if (dot >= 0) {
        let is i64 as ext_len = name_len - (dot + 1);
        if (ext_len > 3) { return cast(i32, 0 - 4); }
        let is i64 as e with mut = 0;
        while (e < ext_len) {
            let is i64 as ch = upper_ascii(cast(i64, name[dot + 1 + e]));
            if (ch < 32 || ch > 126) { return cast(i32, 0 - 5); }
            out[8 + e] = cast(u8, ch);
            e = e + 1;
        }
    }
    return 0;
}

// Compare 11 bytes starting at buf+base against target (11-byte array).
// Returns 1 on match, 0 on mismatch. Kept inline-arithmetic instead of
// taking two pointers so we avoid any Caustic quirk around & on array
// indexing with *u8 bases.
fn name_matches(buf as *u8, base as i64, target as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < 11) {
        if (buf[base + i] != target[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// Case-insensitive ASCII compare between lfn_buf[0..lfn_len] and
// query name[0..name_len]. Returns 1 on match, 0 otherwise. Any char
// above 0x7F on either side is a mismatch (Phase 4 ASCII-only).
fn lfn_matches(name as *u8, name_len as i64) as i32 {
    if (lfn_len != name_len) { return 0; }
    let is i64 as i with mut = 0;
    while (i < name_len) {
        let is i64 as a = cast(i64, lfn_buf[i]);
        let is i64 as b = cast(i64, name[i]);
        if (a > 127 || b > 127) { return 0; }
        if (upper_ascii(a) != upper_ascii(b)) { return 0; }
        i = i + 1;
    }
    return 1;
}

// Extract 13 UCS-2 code units from an LFN entry at buf[pos], writing
// low bytes into lfn_buf[dest..dest+13]. High byte > 0 is stored as
// that byte directly — lfn_matches rejects >127 as a compare-miss.
// Returns the index (0..13) of the first 0x0000 terminator found in
// this entry, or 13 if no terminator here.
fn lfn_copy_chars(buf as *u8, pos as i64, dest as i64) as i64 {
    // Byte layout of a 13-char LFN segment within the 32-byte entry:
    //   bytes  1..10   (5 UCS-2 chars, little-endian) -> name[0..4]
    //   bytes 14..25   (6 UCS-2 chars)                -> name[5..10]
    //   bytes 28..31   (2 UCS-2 chars)                -> name[11..12]
    let is [13]i64 as offs;
    offs[0]  = 1;  offs[1]  = 3;  offs[2]  = 5;  offs[3]  = 7;  offs[4]  = 9;
    offs[5]  = 14; offs[6]  = 16; offs[7]  = 18; offs[8]  = 20; offs[9]  = 22; offs[10] = 24;
    offs[11] = 28; offs[12] = 30;

    let is i64 as term with mut = 13;
    let is i64 as i with mut = 0;
    while (i < 13) {
        let is i64 as lo = cast(i64, buf[pos + offs[i]]);
        let is i64 as hi = cast(i64, buf[pos + offs[i] + 1]);
        let is i64 as slot = dest + i;
        if (slot < 0 || slot >= 256) { return term; }
        if (lo == 0 && hi == 0) {
            if (term == 13) { term = i; }
            lfn_buf[slot] = cast(u8, 0);
        } else if (hi == 0) {
            lfn_buf[slot] = cast(u8, lo);
        } else {
            // Non-ASCII: store sentinel 0x7F+1 so lfn_matches rejects
            // even if the target happens to have the same low byte.
            lfn_buf[slot] = cast(u8, 0xFF);
        }
        i = i + 1;
    }
    return term;
}

// Process an LFN entry encountered at buf[pos] during directory scan.
// Maintains the accumulator buffer and tracks sequence ordering. Sets
// lfn_len on the final (seq=1) entry; resets expected_seq to 0 on any
// out-of-order or stale entry.
fn lfn_ingest(buf as *u8, pos as i64) as void {
    let is i64 as order = cast(i64, buf[pos]) & 0xFF;
    let is i64 as seq = order & 0x3F;
    if (seq < 1 || seq > 20) {
        lfn_expected_seq = 0;
        lfn_len = 0;
        return;
    }
    if ((order & 0x40) != 0) {
        // First physical = last logical: starts a fresh assembly.
        lfn_expected_seq = seq;
        lfn_total_entries = seq;
        lfn_len = 0;
        // Zero out the buffer up to the max this LFN can reach so
        // stale bytes from a prior entry can't leak into a shorter
        // one that misses its terminator.
        let is i64 as j with mut = 0;
        while (j < seq * 13) {
            lfn_buf[j] = cast(u8, 0);
            j = j + 1;
        }
    } else {
        if (seq + 1 != lfn_expected_seq) {
            // Out of order; discard.
            lfn_expected_seq = 0;
            lfn_len = 0;
            return;
        }
        lfn_expected_seq = seq;
    }
    let is i64 as dest = (seq - 1) * 13;
    let is i64 as term_idx = lfn_copy_chars(buf, pos, dest);
    if (seq == 1) {
        // Last to arrive physically is the first logical segment;
        // compute actual LFN length from the terminator or segment
        // boundary. Use lfn_total_entries (captured from the 0x40
        // marker) rather than the now-decremented expected_seq.
        let is i64 as max_end = lfn_total_entries * 13;
        let is i64 as scan with mut = 0;
        let is i64 as found_term with mut = 0;
        while (scan < max_end) {
            if (lfn_buf[scan] == cast(u8, 0)) {
                lfn_len = scan;
                found_term = 1;
                scan = max_end;
            } else {
                scan = scan + 1;
            }
        }
        if (found_term == 0) { lfn_len = max_end; }
        lfn_expected_seq = 0;
    }
}

// ============================================================
// Directory entry lookup — walk the cluster chain of `start_cluster`
// (typically root_cluster) scanning 32-byte records. On match, writes
// the first-cluster and file-size to *out_cluster / *out_size and
// returns 0. Returns -1 on not-found, -2 on I/O, -3 on chain loop.
//
// Handles standard 8.3 entries only; 0xE5 deleted entries are skipped,
// 0x00 terminator ends scan, attribute 0x0F (LFN) entries are skipped
// without interpretation (Phase 4 will parse LFN).
// ============================================================

let is i32 as ATTR_LFN       = 0x0F;
let is i32 as ATTR_DIRECTORY = 0x10;
let is i32 as ATTR_VOLUME_ID = 0x08;

// Static scratch holding the formatted 8.3 target during dir_find.
// Local [11]u8 declarations inside functions produced crashes via
// &target[0], so the name buffer lives in .bss where addressing is
// stable. dir_find is single-threaded today so no locking needed.
let is [11]u8 as target_name with mut;

// Long-file-name assembly scratch. FAT32 LFN encodes up to 20
// 13-char UCS-2 segments per entry chain; we accept ASCII-compatible
// names up to 255 bytes (chars above 0x7F are rejected as mismatch).
// lfn_len is the last assembled length (0 when no LFN precedes the
// 8.3 slot). Reset on dir_find entry and between entries.
let is [260]u8 as lfn_buf with mut;
let is i64 as lfn_len with mut = 0;
let is i64 as lfn_expected_seq with mut = 0;   // 0 if no LFN in progress
let is i64 as lfn_total_entries with mut = 0;  // N from the last-physical marker

fn dir_find(v as *Fat32Volume,
            start_cluster as i64,
            name as *u8,
            name_len as i64,
            out_cluster as *i64,
            out_size as *i64,
            out_attr as *i32) as i32 {
    if (cast(i64, v) == 0) { return cast(i32, 0 - 2); }
    // Reset LFN accumulator state. LFN is consumed per 8.3 entry, but
    // any orphan stays in the buffer between dir_find calls otherwise.
    lfn_len = 0;
    lfn_expected_seq = 0;
    // Pre-format the 8.3 target once: fast path for names that already
    // fit 8.3 (no LFN preamble). Failure is not fatal — names like
    // "long-name.txt" only match via LFN.
    let is i32 as fr = format_8_3(name, name_len, cast(*u8, &target_name[0]));

    let is *u8 as buf = cast(*u8, clus_scratch_virt);
    let is i64 as cluster with mut = start_cluster;
    let is i64 as guard with mut = 0;
    let is i64 as max_steps = v.cluster_count + 2;

    while (cluster >= 2 && cluster < v.cluster_count + 2) {
        if (guard > max_steps) { return cast(i32, 0 - 3); }
        guard = guard + 1;

        let is i32 as rc = cluster_read(v, cluster, buf);
        if (rc != 0) { return cast(i32, 0 - 2); }

        let is i64 as i with mut = 0;
        let is i64 as cbytes = v.cluster_size_bytes;
        while (i < cbytes) {
            let is u8 as marker = buf[i];
            if (marker == cast(u8, 0)) {
                return cast(i32, 0 - 1);   // end of directory
            }
            let is i32 as attr = cast(i32, buf[i + 11]) & 0xFF;
            if (marker == cast(u8, 0xE5)) {
                // Deleted slot — invalidate any LFN run in progress.
                lfn_len = 0;
                lfn_expected_seq = 0;
            } else if (attr == ATTR_LFN) {
                lfn_ingest(buf, i);
            } else {
                // Real 8.3 slot. Try LFN match first (case-insensitive),
                // then fall back to canonical 8.3.
                let is i32 as hit with mut = 0;
                if (lfn_len > 0 && lfn_matches(name, name_len) == 1) {
                    hit = 1;
                }
                if (hit == 0) {
                    if (name_matches(buf, i, cast(*u8, &target_name[0])) == 1) {
                        hit = 1;
                    }
                }
                if (hit == 1) {
                    let is i64 as lo = read_u16(buf, i + 26);
                    let is i64 as hi = read_u16(buf, i + 20);
                    *out_cluster = lo | (hi << 16);
                    *out_size    = read_u32(buf, i + 28);
                    *out_attr    = attr;
                    return 0;
                }
                // Consumed the preceding LFN run regardless of match.
                lfn_len = 0;
                lfn_expected_seq = 0;
            }
            i = i + 32;
        }

        // Advance to next cluster in the directory chain.
        let is i64 as nxt = fat_read(v, cluster);
        if (nxt < 0) { return cast(i32, 0 - 2); }
        if (cluster_is_eof(nxt) == 1) { return cast(i32, 0 - 1); }
        cluster = nxt;
    }
    return cast(i32, 0 - 1);
}

// ============================================================
// Path resolution — walk a '/'-separated absolute path from the root
// cluster, resolving each component via dir_find. Components other
// than the last must resolve to directories (ATTR_DIRECTORY bit).
// Returns 0 on success with out_cluster/out_size/out_attr populated;
// negative rc on not-found / not-a-directory / I/O.
// ============================================================

fn path_lookup(v as *Fat32Volume,
               path as *u8,
               path_len as i64,
               out_cluster as *i64,
               out_size as *i64,
               out_attr as *i32) as i32 {
    if (cast(i64, v) == 0) { return cast(i32, 0 - 2); }
    if (path_len <= 0) { return cast(i32, 0 - 1); }

    // Accept both "/foo/bar" and "foo/bar". Skip leading slashes.
    let is i64 as p with mut = 0;
    while (p < path_len && path[p] == cast(u8, 47)) { p = p + 1; }   // '/'

    // Empty path after stripping = the root itself.
    if (p == path_len) {
        *out_cluster = v.root_cluster;
        *out_size    = 0;
        *out_attr    = ATTR_DIRECTORY;
        return 0;
    }

    let is i64 as cur_cluster with mut = v.root_cluster;
    let is i64 as cur_size    with mut = 0;
    let is i32 as cur_attr    with mut = ATTR_DIRECTORY;

    while (p < path_len) {
        // Find next component end.
        let is i64 as start = p;
        while (p < path_len && path[p] != cast(u8, 47)) { p = p + 1; }
        let is i64 as comp_len = p - start;
        if (comp_len == 0) { return cast(i32, 0 - 1); }   // "//" illegal

        // The component we're resolving must live in a directory.
        if ((cast(i32, cur_attr) & ATTR_DIRECTORY) == 0) {
            return cast(i32, 0 - 4);   // mid-path non-dir
        }

        let is i64 as found_c with mut = 0;
        let is i64 as found_s with mut = 0;
        let is i32 as found_a with mut = 0;
        let is *u8 as comp_ptr = cast(*u8, cast(i64, path) + start);
        let is i32 as rc = dir_find(v, cur_cluster, comp_ptr, comp_len,
                                    &found_c, &found_s, &found_a);
        if (rc != 0) { return rc; }

        cur_cluster = found_c;
        cur_size    = found_s;
        cur_attr    = found_a;

        // Skip trailing slashes so "/docs/" resolves the same as
        // "/docs".
        while (p < path_len && path[p] == cast(u8, 47)) { p = p + 1; }
    }

    *out_cluster = cur_cluster;
    *out_size    = cur_size;
    *out_attr    = cur_attr;
    return 0;
}

// ============================================================
// File read — walk the cluster chain of `first_cluster`, copying up
// to min(size, max_bytes) bytes into `dst`. Returns bytes copied or
// a negative errno on failure.
// ============================================================

fn file_read(v as *Fat32Volume,
             first_cluster as i64,
             size as i64,
             dst as *u8,
             max_bytes as i64) as i64 {
    if (cast(i64, v) == 0) { return 0 - 1; }
    if (max_bytes <= 0) { return 0; }
    if (size <= 0)      { return 0; }

    let is i64 as to_copy with mut = size;
    if (to_copy > max_bytes) { to_copy = max_bytes; }
    let is i64 as copied with mut = 0;
    let is *u8 as buf = cast(*u8, clus_scratch_virt);
    let is i64 as cluster with mut = first_cluster;
    let is i64 as cbytes = v.cluster_size_bytes;
    let is i64 as guard with mut = 0;
    let is i64 as max_steps = v.cluster_count + 2;

    while (copied < to_copy) {
        if (cluster < 2 || cluster >= v.cluster_count + 2) { return 0 - 2; }
        if (guard > max_steps) { return 0 - 3; }
        guard = guard + 1;

        let is i32 as rc = cluster_read(v, cluster, buf);
        if (rc != 0) { return 0 - 4; }

        let is i64 as chunk with mut = cbytes;
        if (chunk > to_copy - copied) { chunk = to_copy - copied; }
        let is i64 as j with mut = 0;
        while (j < chunk) {
            dst[copied + j] = buf[j];
            j = j + 1;
        }
        copied = copied + chunk;
        if (copied >= to_copy) { return copied; }

        let is i64 as nxt = fat_read(v, cluster);
        if (nxt < 0) { return 0 - 5; }
        if (cluster_is_eof(nxt) == 1) {
            // File size claimed more bytes than the chain provides —
            // treat as truncated rather than surfacing EOF as an error.
            return copied;
        }
        cluster = nxt;
    }
    return copied;
}

// ============================================================
// FAT write side — update a single 28-bit FAT entry in all FAT copies
// (FAT32 typically has 2). Preserves the upper 4 reserved bits.
// Reads the sector, patches the entry, writes it back to every FAT.
// ============================================================

fn fat_write(v as *Fat32Volume, cluster as i64, value as i64) as i32 {
    if (cast(i64, v) == 0) { return cast(i32, 0 - 1); }
    if (cluster < 0) { return cast(i32, 0 - 1); }
    if (cluster >= v.cluster_count + 2) { return cast(i32, 0 - 1); }

    let is i64 as byte_off = cluster * 4;
    let is i64 as sec_off  = byte_off / v.bytes_per_sector;
    let is i64 as b_in_sec = byte_off % v.bytes_per_sector;
    let is *u8 as buf = cast(*u8, scratch_virt);

    let is i64 as fi with mut = 0;
    while (fi < v.num_fats) {
        let is i64 as lba = v.fat_start_lba + fi * v.fat_size_sectors + sec_off;
        let is i32 as rc = storage.read_lba(v.dev, lba, 1, buf);
        if (rc != 0) { return cast(i32, 0 - 2); }
        // Preserve upper 4 bits of the existing 32-bit slot per spec.
        let is i64 as old = read_u32(buf, b_in_sec);
        let is i64 as new_val = (old & 0xF0000000) | (value & 0x0FFFFFFF);
        buf[b_in_sec]     = cast(u8, new_val & 0xFF);
        buf[b_in_sec + 1] = cast(u8, (new_val >> 8) & 0xFF);
        buf[b_in_sec + 2] = cast(u8, (new_val >> 16) & 0xFF);
        buf[b_in_sec + 3] = cast(u8, (new_val >> 24) & 0xFF);
        let is i32 as wc = storage.write_lba(v.dev, lba, 1, buf);
        if (wc != 0) { return cast(i32, 0 - 3); }
        fi = fi + 1;
    }
    return 0;
}

// Linear scan for a free FAT entry starting at cluster 3 (reserve 2
// for the root). Returns the cluster number or -1 on ENOSPC.
fn cluster_alloc(v as *Fat32Volume) as i64 {
    if (cast(i64, v) == 0) { return 0 - 1; }
    let is i64 as max_c = v.cluster_count + 2;
    let is i64 as c with mut = 3;
    while (c < max_c) {
        let is i64 as entry = fat_read(v, c);
        if (entry == 0) {
            // Mark as end-of-chain so a second alloc can't pick it
            // before the caller chains further.
            if (fat_write(v, c, 0x0FFFFFFF) != 0) { return 0 - 2; }
            return c;
        }
        if (entry < 0) { return 0 - 2; }   // I/O
        c = c + 1;
    }
    return 0 - 1;
}

fn cluster_free(v as *Fat32Volume, cluster as i64) as i32 {
    return fat_write(v, cluster, 0);
}

// Free an entire cluster chain starting at `first`. Handy for unlink
// and truncate-to-zero.
fn chain_free(v as *Fat32Volume, first as i64) as i32 {
    if (cast(i64, v) == 0) { return cast(i32, 0 - 1); }
    let is i64 as cur with mut = first;
    let is i64 as guard with mut = 0;
    let is i64 as max_steps = v.cluster_count + 2;
    while (cur >= 2 && cur < v.cluster_count + 2) {
        if (guard > max_steps) { return cast(i32, 0 - 3); }
        guard = guard + 1;
        let is i64 as nxt = fat_read(v, cur);
        if (nxt < 0) { return cast(i32, 0 - 2); }
        if (cluster_free(v, cur) != 0) { return cast(i32, 0 - 4); }
        if (cluster_is_eof(nxt) == 1) { return 0; }
        cur = nxt;
    }
    return 0;
}

// ============================================================
// Cluster write — whole-cluster helper matching cluster_read. Writes
// sectors_per_clus sectors at cluster_to_lba(cluster). buf must be in
// HHDM-resident memory (DMA-safe) and at least cluster_size_bytes.
// ============================================================
fn cluster_write(v as *Fat32Volume, cluster as i64, buf as *u8) as i32 {
    if (cast(i64, v) == 0) { return cast(i32, 0 - 1); }
    let is i64 as lba = cluster_to_lba(v, cluster);
    if (lba < 0) { return cast(i32, 0 - 2); }
    return storage.write_lba(v.dev, lba, v.sectors_per_clus, buf);
}

// Zero-fill a cluster. Used when extending a directory or materialising
// a fresh allocation where stale data would leak.
fn cluster_zero(v as *Fat32Volume, cluster as i64) as i32 {
    if (ensure_scratch() != 0) { return cast(i32, 0 - 1); }
    let is *u8 as buf = cast(*u8, clus_scratch_virt);
    let is i64 as i with mut = 0;
    while (i < v.cluster_size_bytes) { buf[i] = cast(u8, 0); i = i + 1; }
    return cluster_write(v, cluster, buf);
}

// ============================================================
// Directory entry creation — implements the short-name + LFN write
// logic mirroring fat32_add_file.py. Allocates a run of contiguous
// 32-byte slots in the directory, extending it by one cluster if
// needed. Emits LFN entries in reverse physical order so they
// precede the 8.3 slot during a forward scan.
//
// Naming strategy: if the name fits the canonical 8.3 form (all
// uppercase, valid chars, short), store only a short entry. Otherwise
// derive a mangled 8.3 (BASE~N.EXT) + one or more LFN entries.
// ============================================================

// Compute the FAT LFN checksum of an 11-byte short name.
fn lfn_checksum(short as *u8) as i64 {
    let is i64 as s with mut = 0;
    let is i64 as i with mut = 0;
    while (i < 11) {
        let is i64 as b = cast(i64, short[i]) & 0xFF;
        s = (((s & 1) << 7) + (s >> 1) + b) & 0xFF;
        i = i + 1;
    }
    return s;
}

// Derive a mangled 8.3 short name from a long name. Strategy:
//   - Sanitize to uppercase, replace invalid chars with '_'
//   - Take first 6 chars of base, append ~N where N is 1..99
//   - Extension is first 3 chars of the last '.' component
//   - Ensure uniqueness in the target directory
let is [11]u8 as short_scratch with mut;

fn sanitize_char(c as i64) as i64 {
    if (c >= 97 && c <= 122) { return c - 32; }          // 'a'-'z' -> 'A'-'Z'
    if (c >= 65 && c <= 90)  { return c; }               // 'A'-'Z'
    if (c >= 48 && c <= 57)  { return c; }               // '0'-'9'
    if (c == 45 || c == 95)  { return c; }               // '-', '_'
    return 95;                                            // everything else -> '_'
}

// Build a dir entry 11-byte name in short_scratch. Returns 0 if name
// already fits 8.3 (no LFN needed), 1 if mangled (LFN required), -1 on
// invalid input.
fn derive_short_name(name as *u8, name_len as i64,
                     parent_cluster as i64, v as *Fat32Volume) as i32 {
    if (name_len <= 0) { return cast(i32, 0 - 1); }

    // Pass 1: exact 8.3 fit test.
    let is i32 as fits = format_8_3(name, name_len, cast(*u8, &short_scratch[0]));
    if (fits == 0) {
        // All-uppercase ASCII check — if any input lower case, we still
        // need LFN to preserve case.
        let is i32 as has_lower with mut = 0;
        let is i64 as k with mut = 0;
        while (k < name_len) {
            let is i64 as cc = cast(i64, name[k]);
            if (cc >= 97 && cc <= 122) { has_lower = 1; k = name_len; }
            else { k = k + 1; }
        }
        if (has_lower == 0) { return 0; }
        // Fall through: generate a mangled short name but still need LFN
        // to preserve the original-case long name.
    }

    // Pass 2: mangled short. Find last '.' for extension.
    let is i64 as dot with mut = 0 - 1;
    let is i64 as j with mut = 0;
    while (j < name_len) {
        if (name[j] == cast(u8, 46)) { dot = j; }
        j = j + 1;
    }
    let is i64 as base_end with mut = name_len;
    if (dot >= 0) { base_end = dot; }

    // Build base (up to 6 chars of sanitized input).
    let is i64 as b with mut = 0;
    let is [6]u8 as base_chars with mut;
    let is i64 as bp with mut = 0;
    while (bp < base_end && b < 6) {
        let is i64 as c = sanitize_char(cast(i64, name[bp]));
        base_chars[b] = cast(u8, c);
        b = b + 1;
        bp = bp + 1;
    }

    // Pick ~N suffix that keeps uniqueness in parent_cluster.
    let is i64 as n with mut = 1;
    while (n < 100) {
        let is i64 as i with mut = 0;
        while (i < 11) { short_scratch[i] = cast(u8, 32); i = i + 1; }
        let is i64 as copy_n with mut = 0;
        while (copy_n < b) { short_scratch[copy_n] = base_chars[copy_n]; copy_n = copy_n + 1; }
        short_scratch[b] = cast(u8, 126);   // '~'
        // N is 1-9 (single digit) or 10-99.
        if (n < 10) {
            short_scratch[b + 1] = cast(u8, 48 + n);
        } else {
            short_scratch[b + 1] = cast(u8, 48 + (n / 10));
            short_scratch[b + 2] = cast(u8, 48 + (n % 10));
        }
        // Extension.
        if (dot >= 0) {
            let is i64 as e with mut = 0;
            let is i64 as ep with mut = dot + 1;
            while (ep < name_len && e < 3) {
                short_scratch[8 + e] = cast(u8, sanitize_char(cast(i64, name[ep])));
                e = e + 1; ep = ep + 1;
            }
        }
        // Check uniqueness: scan parent dir for this short name.
        if (short_name_exists(v, parent_cluster,
                              cast(*u8, &short_scratch[0])) == 0) {
            return 1;
        }
        n = n + 1;
    }
    return cast(i32, 0 - 2);
}

// Returns 1 if any non-deleted 8.3 entry in the directory chain
// matches `target11` exactly.
fn short_name_exists(v as *Fat32Volume, start_cluster as i64,
                     target11 as *u8) as i32 {
    let is *u8 as buf = cast(*u8, clus_scratch_virt);
    let is i64 as cluster with mut = start_cluster;
    let is i64 as guard with mut = 0;
    let is i64 as max_steps = v.cluster_count + 2;
    while (cluster >= 2 && cluster < v.cluster_count + 2) {
        if (guard > max_steps) { return 0; }
        guard = guard + 1;
        if (cluster_read(v, cluster, buf) != 0) { return 0; }
        let is i64 as i with mut = 0;
        let is i64 as cbytes = v.cluster_size_bytes;
        while (i < cbytes) {
            let is u8 as m = buf[i];
            if (m == cast(u8, 0)) { return 0; }
            let is i32 as a = cast(i32, buf[i + 11]) & 0xFF;
            if (m != cast(u8, 0xE5) && a != ATTR_LFN) {
                if (name_matches(buf, i, target11) == 1) { return 1; }
            }
            i = i + 32;
        }
        let is i64 as nxt = fat_read(v, cluster);
        if (nxt < 0) { return 0; }
        if (cluster_is_eof(nxt) == 1) { return 0; }
        cluster = nxt;
    }
    return 0;
}

// Emit a single 32-byte 8.3 entry into buf at offset `off`.
fn emit_sfn(buf as *u8, off as i64, short11 as *u8, attr as i32,
            first_cluster as i64, size as i64) as void {
    let is i64 as i with mut = 0;
    while (i < 11) { buf[off + i] = short11[i]; i = i + 1; }
    buf[off + 11] = cast(u8, attr & 0xFF);
    // 12..21 zeroed (NTRes, ctime tenths, ctime/cdate/adate) — we
    // intentionally leave timestamps at 0; a future pass wires an RTC.
    let is i64 as j with mut = 12;
    while (j < 22) { buf[off + j] = cast(u8, 0); j = j + 1; }
    // First cluster high (20..21), time/date write (22..25), first
    // cluster low (26..27), size (28..31).
    let is i64 as hi = (first_cluster >> 16) & 0xFFFF;
    let is i64 as lo = first_cluster & 0xFFFF;
    buf[off + 20] = cast(u8, hi & 0xFF);
    buf[off + 21] = cast(u8, (hi >> 8) & 0xFF);
    buf[off + 22] = cast(u8, 0); buf[off + 23] = cast(u8, 0);
    buf[off + 24] = cast(u8, 0); buf[off + 25] = cast(u8, 0);
    buf[off + 26] = cast(u8, lo & 0xFF);
    buf[off + 27] = cast(u8, (lo >> 8) & 0xFF);
    buf[off + 28] = cast(u8, size & 0xFF);
    buf[off + 29] = cast(u8, (size >> 8) & 0xFF);
    buf[off + 30] = cast(u8, (size >> 16) & 0xFF);
    buf[off + 31] = cast(u8, (size >> 24) & 0xFF);
}

// Emit one LFN entry at buf[off] for characters at logical slot
// [(seq-1)*13, seq*13), taking chars from `name` (length name_len;
// pad with 0x0000 terminator + 0xFFFF thereafter).
fn emit_lfn(buf as *u8, off as i64, seq as i64, is_last_physical as i32,
            name as *u8, name_len as i64, checksum as i64) as void {
    let is [13]i64 as offs;
    offs[0]=1;  offs[1]=3;  offs[2]=5;  offs[3]=7;  offs[4]=9;
    offs[5]=14; offs[6]=16; offs[7]=18; offs[8]=20; offs[9]=22; offs[10]=24;
    offs[11]=28; offs[12]=30;

    let is i64 as ord_byte with mut = seq;
    if (is_last_physical == 1) { ord_byte = ord_byte | 0x40; }
    buf[off + 0]  = cast(u8, ord_byte & 0xFF);
    buf[off + 11] = cast(u8, 0x0F);
    buf[off + 12] = cast(u8, 0);
    buf[off + 13] = cast(u8, checksum & 0xFF);
    buf[off + 26] = cast(u8, 0); buf[off + 27] = cast(u8, 0);

    let is i64 as base = (seq - 1) * 13;
    let is i64 as k with mut = 0;
    let is i32 as past_term with mut = 0;
    while (k < 13) {
        let is i64 as o = offs[k];
        let is i64 as idx = base + k;
        if (past_term == 1) {
            buf[off + o]     = cast(u8, 0xFF);
            buf[off + o + 1] = cast(u8, 0xFF);
        } else if (idx < name_len) {
            buf[off + o]     = name[idx];
            buf[off + o + 1] = cast(u8, 0);
        } else if (idx == name_len) {
            // terminator
            buf[off + o]     = cast(u8, 0);
            buf[off + o + 1] = cast(u8, 0);
            past_term = 1;
        } else {
            buf[off + o]     = cast(u8, 0xFF);
            buf[off + o + 1] = cast(u8, 0xFF);
        }
        k = k + 1;
    }
}

// Slot-by-slot directory placement. Walks `parent_cluster`'s chain,
// locates the first 0x00 terminator, and writes `total` 32-byte entries
// contiguously starting there — extending the chain with freshly-zeroed
// clusters as needed. Because we only ever overwrite the dir's 0x00
// tail, no existing entries are disturbed and no 0xE5 gap-patching is
// required.
fn dir_place_entries(v as *Fat32Volume, parent_cluster as i64,
                     entries_buf as *u8, total as i64) as i32 {
    if (total <= 0) { return 0; }
    let is *u8 as buf = cast(*u8, clus_scratch_virt);
    let is i64 as cluster with mut = parent_cluster;
    let is i64 as guard with mut = 0;
    let is i64 as max_steps = v.cluster_count + 2;
    let is i64 as n_slots = v.cluster_size_bytes / 32;
    let is i64 as remaining with mut = total;
    let is i64 as src_off with mut = 0;
    let is i32 as started with mut = 0;
    let is i64 as cur_slot with mut = 0;

    while (cluster >= 2 && cluster < v.cluster_count + 2) {
        if (guard > max_steps) { return cast(i32, 0 - 3); }
        guard = guard + 1;
        if (cluster_read(v, cluster, buf) != 0) { return cast(i32, 0 - 2); }

        // Once we've started placing, continue from slot 0 in the new
        // cluster; otherwise find the first 0x00 terminator.
        if (started == 0) {
            cur_slot = 0 - 1;
            let is i64 as i with mut = 0;
            while (i < n_slots) {
                if (buf[i * 32] == cast(u8, 0)) {
                    cur_slot = i;
                    i = n_slots;
                } else {
                    i = i + 1;
                }
            }
            if (cur_slot < 0) {
                // Cluster full, advance or extend.
            } else {
                started = 1;
            }
        } else {
            cur_slot = 0;
        }

        if (started == 1) {
            let is i64 as dirty with mut = 0;
            while (cur_slot < n_slots && remaining > 0) {
                let is i64 as dst = cur_slot * 32;
                let is i64 as j with mut = 0;
                while (j < 32) {
                    buf[dst + j] = entries_buf[src_off + j];
                    j = j + 1;
                }
                src_off = src_off + 32;
                remaining = remaining - 1;
                cur_slot = cur_slot + 1;
                dirty = 1;
            }
            if (dirty == 1 && cluster_write(v, cluster, buf) != 0) {
                return cast(i32, 0 - 4);
            }
            if (remaining == 0) { return 0; }
        }

        // Need more room: follow chain or extend.
        let is i64 as nxt = fat_read(v, cluster);
        if (nxt < 0) { return cast(i32, 0 - 2); }
        if (cluster_is_eof(nxt) == 1) {
            let is i64 as new_c = cluster_alloc(v);
            if (new_c < 0) { return cast(i32, 0 - 5); }
            if (cluster_zero(v, new_c) != 0) { return cast(i32, 0 - 6); }
            if (fat_write(v, cluster, new_c) != 0) { return cast(i32, 0 - 7); }
            cluster = new_c;
        } else {
            cluster = nxt;
        }
    }
    return cast(i32, 0 - 8);
}

// Scratch buffer holding up to 21 entries (20 LFN + 1 SFN = 672B).
let is [672]u8 as entry_scratch with mut;

// Add a new entry named `name` (long) to `parent_cluster`, pointing at
// `first_cluster` with size=size and attr=attr. Returns 0 on success.
fn dir_add_entry(v as *Fat32Volume, parent_cluster as i64,
                 name as *u8, name_len as i64,
                 attr as i32, first_cluster as i64, size as i64) as i32 {
    if (cast(i64, v) == 0) { return cast(i32, 0 - 1); }
    if (name_len <= 0 || name_len > 255) { return cast(i32, 0 - 1); }
    if (ensure_scratch() != 0) { return cast(i32, 0 - 2); }

    let is i32 as sr = derive_short_name(name, name_len, parent_cluster, v);
    if (sr < 0) { return cast(i32, 0 - 3); }
    let is i64 as need_lfn with mut = 0;
    if (sr == 1) {
        need_lfn = (name_len / 13) + 1;
        if (name_len % 13 == 0) { need_lfn = name_len / 13 + 1; }
    }
    let is i64 as total_slots = need_lfn + 1;
    if (total_slots > 21) { return cast(i32, 0 - 4); }

    // Zero the entry scratch region we'll populate.
    let is i64 as z with mut = 0;
    while (z < total_slots * 32) { entry_scratch[z] = cast(u8, 0); z = z + 1; }

    if (need_lfn > 0) {
        let is i64 as ck = lfn_checksum(cast(*u8, &short_scratch[0]));
        let is i64 as k with mut = 0;
        while (k < need_lfn) {
            let is i64 as seq = need_lfn - k;
            let is i32 as is_last with mut = 0;
            if (k == 0) { is_last = 1; }
            emit_lfn(cast(*u8, &entry_scratch[0]), k * 32, seq, is_last,
                     name, name_len, ck);
            k = k + 1;
        }
    }
    emit_sfn(cast(*u8, &entry_scratch[0]), need_lfn * 32,
             cast(*u8, &short_scratch[0]), attr, first_cluster, size);

    return dir_place_entries(v, parent_cluster,
                             cast(*u8, &entry_scratch[0]), total_slots);
}

// Remove the directory entry (and its preceding LFN entries) named
// `name` from `parent_cluster`. Returns the first_cluster of the
// removed entry on success, or a negative rc. Does NOT free the file's
// data clusters; callers combine with chain_free for unlink semantics.
fn dir_remove_entry(v as *Fat32Volume, parent_cluster as i64,
                    name as *u8, name_len as i64,
                    out_first_cluster as *i64, out_size as *i64,
                    out_attr as *i32) as i32 {
    let is i32 as at with mut = 0;
    let is i32 as rc = dir_find(v, parent_cluster, name, name_len,
                                out_first_cluster, out_size, &at);
    if (rc != 0) { return rc; }
    *out_attr = at;

    // Re-walk the directory to mark the SFN and any preceding LFN run
    // with 0xE5. We locate the SFN by first_cluster match — safe even
    // if duplicate short names existed because a cluster number is
    // unique per live file (we just allocated fresh one).
    let is *u8 as buf = cast(*u8, clus_scratch_virt);
    let is i64 as cluster with mut = parent_cluster;
    let is i64 as guard with mut = 0;
    let is i64 as max_steps = v.cluster_count + 2;
    let is i64 as lfn_run_start_slot with mut = 0 - 1;
    let is i64 as lfn_run_cluster with mut = 0 - 1;
    let is i64 as target_cluster = *out_first_cluster;

    while (cluster >= 2 && cluster < v.cluster_count + 2) {
        if (guard > max_steps) { return cast(i32, 0 - 3); }
        guard = guard + 1;
        if (cluster_read(v, cluster, buf) != 0) { return cast(i32, 0 - 4); }

        let is i64 as n_slots = v.cluster_size_bytes / 32;
        let is i64 as i with mut = 0;
        while (i < n_slots) {
            let is i64 as boff = i * 32;
            let is u8 as m = buf[boff];
            if (m == cast(u8, 0)) { return cast(i32, 0 - 5); }   // unreachable if dir_find matched
            if (m == cast(u8, 0xE5)) {
                lfn_run_start_slot = 0 - 1;
            } else {
                let is i32 as a = cast(i32, buf[boff + 11]) & 0xFF;
                if (a == ATTR_LFN) {
                    if (lfn_run_start_slot < 0) {
                        lfn_run_start_slot = i;
                        lfn_run_cluster = cluster;
                    }
                } else {
                    let is i64 as fc_lo = read_u16(buf, boff + 26);
                    let is i64 as fc_hi = read_u16(buf, boff + 20);
                    let is i64 as fc = fc_lo | (fc_hi << 16);
                    if (fc == target_cluster) {
                        // Mark this entry + preceding LFN run deleted.
                        if (lfn_run_start_slot >= 0 && lfn_run_cluster == cluster) {
                            let is i64 as r with mut = lfn_run_start_slot;
                            while (r <= i) { buf[r * 32] = cast(u8, 0xE5); r = r + 1; }
                        } else {
                            buf[boff] = cast(u8, 0xE5);
                        }
                        if (cluster_write(v, cluster, buf) != 0) {
                            return cast(i32, 0 - 6);
                        }
                        return 0;
                    }
                    lfn_run_start_slot = 0 - 1;
                }
            }
            i = i + 1;
        }
        let is i64 as nxt = fat_read(v, cluster);
        if (nxt < 0) { return cast(i32, 0 - 4); }
        if (cluster_is_eof(nxt) == 1) { return cast(i32, 0 - 5); }
        cluster = nxt;
    }
    return cast(i32, 0 - 5);
}

// ============================================================
// High-level file API — create, write-all, unlink. Persists via a
// final FLUSH so data survives a reset. For Phase 5 we keep the
// contract simple: file_create/write_all take a complete buffer and
// fully (re)populate the file; streamed writes arrive later.
// ============================================================

// Split `path` at the last '/' into parent path (may be empty) and
// leaf name. Returns -1 if the path has no leaf component.
fn path_split_parent(path as *u8, path_len as i64,
                     out_leaf_off as *i64, out_leaf_len as *i64,
                     out_parent_end as *i64) as i32 {
    if (path_len <= 0) { return cast(i32, 0 - 1); }
    let is i64 as end with mut = path_len;
    while (end > 0 && path[end - 1] == cast(u8, 47)) { end = end - 1; }
    if (end == 0) { return cast(i32, 0 - 1); }   // bare "/"
    let is i64 as last_slash with mut = 0 - 1;
    let is i64 as i with mut = 0;
    while (i < end) {
        if (path[i] == cast(u8, 47)) { last_slash = i; }
        i = i + 1;
    }
    if (last_slash < 0) {
        *out_leaf_off = 0;
        *out_leaf_len = end;
        *out_parent_end = 0;
    } else {
        *out_leaf_off = last_slash + 1;
        *out_leaf_len = end - (last_slash + 1);
        *out_parent_end = last_slash;
    }
    if (*out_leaf_len == 0) { return cast(i32, 0 - 1); }
    return 0;
}

// Create a regular file at `path` containing `data[0..data_len]`.
// parent directories must already exist. Returns 0 on success.
// On failure leaves no partial state (rolls back cluster allocations).
fn file_create(v as *Fat32Volume, path as *u8, path_len as i64,
               data as *u8, data_len as i64) as i32 {
    if (cast(i64, v) == 0) { return cast(i32, 0 - 1); }

    let is i64 as leaf_off with mut = 0;
    let is i64 as leaf_len with mut = 0;
    let is i64 as parent_end with mut = 0;
    if (path_split_parent(path, path_len, &leaf_off, &leaf_len, &parent_end) != 0) {
        return cast(i32, 0 - 2);
    }

    // Resolve parent directory cluster.
    let is i64 as parent_cluster with mut = v.root_cluster;
    let is i64 as psz with mut = 0;
    let is i32 as pattr with mut = 0;
    if (parent_end > 0) {
        let is i32 as rc = path_lookup(v, path, parent_end,
                                       &parent_cluster, &psz, &pattr);
        if (rc != 0) { return cast(i32, 0 - 3); }
        if ((pattr & ATTR_DIRECTORY) == 0) { return cast(i32, 0 - 4); }
    }

    // Refuse creation when the name already exists.
    let is i64 as dummy_c with mut = 0;
    let is i64 as dummy_s with mut = 0;
    let is i32 as dummy_a with mut = 0;
    let is *u8 as leaf_ptr = cast(*u8, cast(i64, path) + leaf_off);
    if (dir_find(v, parent_cluster, leaf_ptr, leaf_len,
                 &dummy_c, &dummy_s, &dummy_a) == 0) {
        return cast(i32, 0 - 5);   // EEXIST
    }

    // Allocate cluster chain for the payload. data_len=0 => empty file
    // with first_cluster=0 per FAT32 convention.
    let is i64 as first_cluster with mut = 0;
    if (data_len > 0) {
        let is i64 as n_clusters = (data_len + v.cluster_size_bytes - 1)
                                 / v.cluster_size_bytes;
        let is i64 as prev with mut = 0;
        let is i64 as k with mut = 0;
        while (k < n_clusters) {
            let is i64 as c = cluster_alloc(v);
            if (c < 0) {
                if (first_cluster != 0) { chain_free(v, first_cluster); }
                return cast(i32, 0 - 6);
            }
            if (prev == 0) { first_cluster = c; }
            else          { fat_write(v, prev, c); }
            prev = c;
            k = k + 1;
        }
        // Tail is already EOC from cluster_alloc.

        // Write data clusters.
        let is *u8 as wbuf = cast(*u8, clus_scratch_virt);
        let is i64 as cur with mut = first_cluster;
        let is i64 as offset with mut = 0;
        while (offset < data_len) {
            let is i64 as chunk with mut = v.cluster_size_bytes;
            if (chunk > data_len - offset) { chunk = data_len - offset; }
            let is i64 as j with mut = 0;
            while (j < chunk) { wbuf[j] = data[offset + j]; j = j + 1; }
            while (j < v.cluster_size_bytes) { wbuf[j] = cast(u8, 0); j = j + 1; }
            if (cluster_write(v, cur, wbuf) != 0) {
                chain_free(v, first_cluster);
                return cast(i32, 0 - 7);
            }
            offset = offset + chunk;
            if (offset < data_len) {
                let is i64 as nxt = fat_read(v, cur);
                if (nxt < 0) {
                    chain_free(v, first_cluster);
                    return cast(i32, 0 - 8);
                }
                cur = nxt;
            }
        }
    }

    // Create the directory entry. Roll back clusters on failure.
    let is i32 as de = dir_add_entry(v, parent_cluster, leaf_ptr, leaf_len,
                                     cast(i32, 0x20), first_cluster, data_len);
    if (de != 0) {
        if (first_cluster != 0) { chain_free(v, first_cluster); }
        return cast(i32, 0 - 9);
    }

    // Durability barrier.
    storage.flush(v.dev);
    return 0;
}

// ============================================================
// Directory mutation — mkdir, rmdir, rename.
// ============================================================

// Create a new directory at `path`. Synthesises the canonical '.' and
// '..' self-references inside the fresh cluster before registering
// the entry in the parent. '..' reads as 0 when the parent is the
// root (FAT32 convention).
fn dir_create(v as *Fat32Volume, path as *u8, path_len as i64) as i32 {
    if (cast(i64, v) == 0) { return cast(i32, 0 - 1); }

    let is i64 as leaf_off with mut = 0;
    let is i64 as leaf_len with mut = 0;
    let is i64 as parent_end with mut = 0;
    if (path_split_parent(path, path_len, &leaf_off, &leaf_len, &parent_end) != 0) {
        return cast(i32, 0 - 2);
    }
    let is i64 as parent_cluster with mut = v.root_cluster;
    let is i64 as psz with mut = 0;
    let is i32 as pattr with mut = 0;
    if (parent_end > 0) {
        if (path_lookup(v, path, parent_end,
                        &parent_cluster, &psz, &pattr) != 0) {
            return cast(i32, 0 - 3);
        }
        if ((pattr & ATTR_DIRECTORY) == 0) { return cast(i32, 0 - 4); }
    }

    let is *u8 as leaf_ptr = cast(*u8, cast(i64, path) + leaf_off);
    let is i64 as dc with mut = 0;
    let is i64 as ds with mut = 0;
    let is i32 as da with mut = 0;
    if (dir_find(v, parent_cluster, leaf_ptr, leaf_len,
                 &dc, &ds, &da) == 0) {
        return cast(i32, 0 - 5);   // EEXIST
    }

    let is i64 as new_c = cluster_alloc(v);
    if (new_c < 0) { return cast(i32, 0 - 6); }
    if (cluster_zero(v, new_c) != 0) {
        cluster_free(v, new_c);
        return cast(i32, 0 - 7);
    }

    // Write '.' and '..' as two 8.3 entries at the start of the new
    // cluster. '..' = 0 when the parent is the root per FAT spec.
    if (ensure_scratch() != 0) { return cast(i32, 0 - 8); }
    let is *u8 as buf = cast(*u8, clus_scratch_virt);
    let is i64 as k with mut = 0;
    while (k < v.cluster_size_bytes) { buf[k] = cast(u8, 0); k = k + 1; }

    let is [11]u8 as dot_name with mut;
    let is i64 as d with mut = 0;
    while (d < 11) { dot_name[d] = cast(u8, 32); d = d + 1; }
    dot_name[0] = cast(u8, 46);   // '.'
    emit_sfn(buf, 0, cast(*u8, &dot_name[0]),
             cast(i32, ATTR_DIRECTORY), new_c, 0);

    dot_name[1] = cast(u8, 46);   // '..'
    let is i64 as dotdot_parent with mut = parent_cluster;
    if (parent_cluster == v.root_cluster) { dotdot_parent = 0; }
    emit_sfn(buf, 32, cast(*u8, &dot_name[0]),
             cast(i32, ATTR_DIRECTORY), dotdot_parent, 0);

    if (cluster_write(v, new_c, buf) != 0) {
        chain_free(v, new_c);
        return cast(i32, 0 - 9);
    }

    // Register the entry in the parent.
    let is i32 as de = dir_add_entry(v, parent_cluster, leaf_ptr, leaf_len,
                                     cast(i32, ATTR_DIRECTORY), new_c, 0);
    if (de != 0) {
        chain_free(v, new_c);
        return cast(i32, 0 - 10);
    }

    storage.flush(v.dev);
    return 0;
}

// True (returns 1) when a directory starting at `dir_cluster` contains
// anything beyond '.' and '..' (i.e. is non-empty in user-visible
// terms). Used to guard rmdir against stomping populated trees.
fn dir_is_empty(v as *Fat32Volume, dir_cluster as i64) as i32 {
    let is *u8 as buf = cast(*u8, clus_scratch_virt);
    let is i64 as cluster with mut = dir_cluster;
    let is i64 as guard with mut = 0;
    let is i64 as max_steps = v.cluster_count + 2;
    let is i64 as n_slots = v.cluster_size_bytes / 32;

    while (cluster >= 2 && cluster < v.cluster_count + 2) {
        if (guard > max_steps) { return 0; }
        guard = guard + 1;
        if (cluster_read(v, cluster, buf) != 0) { return 0; }
        let is i64 as i with mut = 0;
        while (i < n_slots) {
            let is i64 as boff = i * 32;
            let is u8 as m = buf[boff];
            if (m == cast(u8, 0)) { return 1; }   // end-of-dir reached
            if (m == cast(u8, 0xE5)) { i = i + 1; }
            else {
                let is i32 as a = cast(i32, buf[boff + 11]) & 0xFF;
                if (a == ATTR_LFN) { i = i + 1; }
                else {
                    // Skip the two canonical '.' and '..' self-refs.
                    if (buf[boff] == cast(u8, 46) &&
                        buf[boff + 1] == cast(u8, 32)) {
                        i = i + 1;
                    } else if (buf[boff] == cast(u8, 46) &&
                               buf[boff + 1] == cast(u8, 46) &&
                               buf[boff + 2] == cast(u8, 32)) {
                        i = i + 1;
                    } else {
                        return 0;
                    }
                }
            }
        }
        let is i64 as nxt = fat_read(v, cluster);
        if (nxt < 0) { return 0; }
        if (cluster_is_eof(nxt) == 1) { return 1; }
        cluster = nxt;
    }
    return 1;
}

fn dir_remove(v as *Fat32Volume, path as *u8, path_len as i64) as i32 {
    if (cast(i64, v) == 0) { return cast(i32, 0 - 1); }

    let is i64 as leaf_off with mut = 0;
    let is i64 as leaf_len with mut = 0;
    let is i64 as parent_end with mut = 0;
    if (path_split_parent(path, path_len, &leaf_off, &leaf_len, &parent_end) != 0) {
        return cast(i32, 0 - 2);
    }
    let is i64 as parent_cluster with mut = v.root_cluster;
    let is i64 as psz with mut = 0;
    let is i32 as pattr with mut = 0;
    if (parent_end > 0) {
        if (path_lookup(v, path, parent_end,
                        &parent_cluster, &psz, &pattr) != 0) {
            return cast(i32, 0 - 3);
        }
        if ((pattr & ATTR_DIRECTORY) == 0) { return cast(i32, 0 - 4); }
    }
    let is *u8 as leaf_ptr = cast(*u8, cast(i64, path) + leaf_off);

    let is i64 as fc with mut = 0;
    let is i64 as fs with mut = 0;
    let is i32 as fa with mut = 0;
    let is i32 as rc = dir_find(v, parent_cluster, leaf_ptr, leaf_len,
                                &fc, &fs, &fa);
    if (rc != 0) { return rc; }
    if ((fa & ATTR_DIRECTORY) == 0) {
        return cast(i32, 0 - 5);   // not a directory
    }
    if (dir_is_empty(v, fc) == 0) {
        return cast(i32, 0 - 6);   // ENOTEMPTY
    }

    let is i64 as junk_c with mut = 0;
    let is i64 as junk_s with mut = 0;
    let is i32 as junk_a with mut = 0;
    let is i32 as r2 = dir_remove_entry(v, parent_cluster,
                                        leaf_ptr, leaf_len,
                                        &junk_c, &junk_s, &junk_a);
    if (r2 != 0) { return r2; }
    chain_free(v, fc);
    storage.flush(v.dev);
    return 0;
}

// Rename a file or directory. Implemented as an atomic-looking pair:
// create new entry at dst, then delete old entry. On failure after
// create we roll back the new entry. Cross-directory renames are
// supported; the underlying data/cluster chain is NOT touched so the
// operation is O(dir) in metadata, not O(file) in bytes.
fn path_rename(v as *Fat32Volume,
               src as *u8, src_len as i64,
               dst as *u8, dst_len as i64) as i32 {
    if (cast(i64, v) == 0) { return cast(i32, 0 - 1); }

    // Resolve source.
    let is i64 as s_leaf_off with mut = 0;
    let is i64 as s_leaf_len with mut = 0;
    let is i64 as s_parent_end with mut = 0;
    if (path_split_parent(src, src_len, &s_leaf_off, &s_leaf_len, &s_parent_end) != 0) {
        return cast(i32, 0 - 2);
    }
    let is i64 as sp_cluster with mut = v.root_cluster;
    let is i64 as psz with mut = 0;
    let is i32 as pattr with mut = 0;
    if (s_parent_end > 0) {
        if (path_lookup(v, src, s_parent_end,
                        &sp_cluster, &psz, &pattr) != 0) {
            return cast(i32, 0 - 3);
        }
        if ((pattr & ATTR_DIRECTORY) == 0) { return cast(i32, 0 - 4); }
    }
    let is *u8 as s_leaf = cast(*u8, cast(i64, src) + s_leaf_off);

    let is i64 as src_cluster with mut = 0;
    let is i64 as src_size    with mut = 0;
    let is i32 as src_attr    with mut = 0;
    let is i32 as sr = dir_find(v, sp_cluster, s_leaf, s_leaf_len,
                                &src_cluster, &src_size, &src_attr);
    if (sr != 0) { return sr; }

    // Resolve destination.
    let is i64 as d_leaf_off with mut = 0;
    let is i64 as d_leaf_len with mut = 0;
    let is i64 as d_parent_end with mut = 0;
    if (path_split_parent(dst, dst_len, &d_leaf_off, &d_leaf_len, &d_parent_end) != 0) {
        return cast(i32, 0 - 5);
    }
    let is i64 as dp_cluster with mut = v.root_cluster;
    if (d_parent_end > 0) {
        if (path_lookup(v, dst, d_parent_end,
                        &dp_cluster, &psz, &pattr) != 0) {
            return cast(i32, 0 - 6);
        }
        if ((pattr & ATTR_DIRECTORY) == 0) { return cast(i32, 0 - 7); }
    }
    let is *u8 as d_leaf = cast(*u8, cast(i64, dst) + d_leaf_off);

    let is i64 as dummy_c with mut = 0;
    let is i64 as dummy_s with mut = 0;
    let is i32 as dummy_a with mut = 0;
    if (dir_find(v, dp_cluster, d_leaf, d_leaf_len,
                 &dummy_c, &dummy_s, &dummy_a) == 0) {
        return cast(i32, 0 - 8);   // destination exists
    }

    // Add new entry first (keeps data reachable even if the crash
    // window hits mid-operation; old entry still points to the same
    // chain and we free it only on success).
    let is i32 as de = dir_add_entry(v, dp_cluster, d_leaf, d_leaf_len,
                                     src_attr, src_cluster, src_size);
    if (de != 0) { return cast(i32, 0 - 9); }

    // Drop the old entry. On failure we have two names pointing at
    // the same chain; the next mount rebuild would flag it, but no
    // data is lost.
    let is i64 as junk_c with mut = 0;
    let is i64 as junk_s with mut = 0;
    let is i32 as junk_a with mut = 0;
    let is i32 as r2 = dir_remove_entry(v, sp_cluster, s_leaf, s_leaf_len,
                                        &junk_c, &junk_s, &junk_a);
    if (r2 != 0) {
        // Roll back: remove the new entry too. If the roll-back
        // itself fails the dir has a dup; explicit error propagation
        // matters more than paper-over.
        dir_remove_entry(v, dp_cluster, d_leaf, d_leaf_len,
                         &junk_c, &junk_s, &junk_a);
        return cast(i32, 0 - 10);
    }

    // If this was a directory rename across parents, patch its '..'
    // to point at the new parent. Same-parent renames leave '..'
    // untouched (pointer equivalence).
    if ((src_attr & ATTR_DIRECTORY) != 0 && sp_cluster != dp_cluster
        && src_cluster != 0) {
        let is *u8 as cbuf = cast(*u8, clus_scratch_virt);
        if (cluster_read(v, src_cluster, cbuf) == 0) {
            // Slot 1 is '..'. Patch first-cluster hi/lo.
            let is i64 as new_parent with mut = dp_cluster;
            if (dp_cluster == v.root_cluster) { new_parent = 0; }
            let is i64 as hi = (new_parent >> 16) & 0xFFFF;
            let is i64 as lo = new_parent & 0xFFFF;
            cbuf[32 + 20] = cast(u8, hi & 0xFF);
            cbuf[32 + 21] = cast(u8, (hi >> 8) & 0xFF);
            cbuf[32 + 26] = cast(u8, lo & 0xFF);
            cbuf[32 + 27] = cast(u8, (lo >> 8) & 0xFF);
            cluster_write(v, src_cluster, cbuf);
        }
    }

    storage.flush(v.dev);
    return 0;
}

fn file_unlink(v as *Fat32Volume, path as *u8, path_len as i64) as i32 {
    if (cast(i64, v) == 0) { return cast(i32, 0 - 1); }

    let is i64 as leaf_off with mut = 0;
    let is i64 as leaf_len with mut = 0;
    let is i64 as parent_end with mut = 0;
    if (path_split_parent(path, path_len, &leaf_off, &leaf_len, &parent_end) != 0) {
        return cast(i32, 0 - 2);
    }
    let is i64 as parent_cluster with mut = v.root_cluster;
    let is i64 as psz with mut = 0;
    let is i32 as pattr with mut = 0;
    if (parent_end > 0) {
        if (path_lookup(v, path, parent_end,
                        &parent_cluster, &psz, &pattr) != 0) {
            return cast(i32, 0 - 3);
        }
        if ((pattr & ATTR_DIRECTORY) == 0) { return cast(i32, 0 - 4); }
    }
    let is *u8 as leaf_ptr = cast(*u8, cast(i64, path) + leaf_off);

    let is i64 as fc with mut = 0;
    let is i64 as fs with mut = 0;
    let is i32 as fa with mut = 0;
    let is i32 as rc = dir_remove_entry(v, parent_cluster,
                                        leaf_ptr, leaf_len,
                                        &fc, &fs, &fa);
    if (rc != 0) { return rc; }
    if ((fa & ATTR_DIRECTORY) != 0) {
        // Refuse rmdir through unlink. mkdir/rmdir land in a later phase.
        return cast(i32, 0 - 6);
    }
    if (fc != 0) { chain_free(v, fc); }
    storage.flush(v.dev);
    return 0;
}

// ============================================================
// Mount thread — yields until a storage device appears in the
// registry, then tries to mount it as FAT32. Intended to be
// started after driver phase 2 has kicked off probing.
// ============================================================

fn mount_thread() as void {
    // Bounded wait for storage to show up (probing runs on its own
    // thread after phase 2). Each yield lets the scheduler run other
    // threads; ~1000 iterations is generous given AHCI bind completes
    // within a few quanta.
    let is i64 as tries with mut = 0;
    let is *storage.StorageDevice as d with mut = storage.head();
    while (cast(i64, d) == 0 && tries < 1000) {
        sched.yield_cpu();
        d = storage.head();
        tries = tries + 1;
    }
    if (cast(i64, d) == 0) {
        serial.println("fat32: no storage device after wait", 35);
        return;
    }
    let is *Fat32Volume as v = mount(d);
    if (cast(i64, v) == 0) { return; }
    self_test_read(v);
}

// ============================================================
// self_test_read — look up HELLO.TXT and BIGFILE.BIN (seeded by
// scripts/fat32_add_file.py), read their contents, and validate the
// payloads match expectations. Exercises dir_find, fat_read, and
// file_read end-to-end.
// ============================================================

let is i64 as HELLO_EXPECTED_SIZE = 27;
let is i64 as BIGFILE_EXPECTED_SIZE = 1200;

fn self_test_read(v as *Fat32Volume) as void {
    let is i64 as clus with mut = 0;
    let is i64 as size with mut = 0;
    let is i32 as attr with mut = 0;

    let is i32 as r1 = dir_find(v, v.root_cluster,
                                cast(*u8, "hello.txt"), 9,
                                &clus, &size, &attr);
    if (r1 != 0) {
        serial.print("fat32.test: find hello.txt FAIL rc=", 35);
        util.print_num(cast(i64, r1));
        serial.println("", 0);
        return;
    }
    serial.print("fat32.test: hello.txt cluster=", 30);
    util.print_num(clus);
    serial.print(" size=", 6);
    util.print_num(size);
    serial.println("", 0);

    if (size != HELLO_EXPECTED_SIZE) {
        serial.println("fat32.test: hello.txt size mismatch", 35);
        return;
    }

    let is i64 as rbuf_virt = alloc_dma_page();
    if (rbuf_virt == 0) {
        serial.println("fat32.test: rbuf alloc fail", 27);
        return;
    }
    let is *u8 as rbuf = cast(*u8, rbuf_virt);
    let is i64 as n = file_read(v, clus, size, rbuf, 4096);
    if (n != size) {
        serial.print("fat32.test: file_read short n=", 30);
        util.print_num(n);
        serial.println("", 0);
        return;
    }
    // Print the content (zero-term for safety since we know size < 4096).
    rbuf[size] = cast(u8, 0);
    serial.print("fat32.test: hello.txt='", 23);
    let is i64 as k with mut = 0;
    while (k < size) {
        serial.putc(cast(i64, rbuf[k]));
        k = k + 1;
    }
    serial.println("'", 1);

    // Bigfile: 600 'A' + 600 'B'. Read and byte-verify.
    let is i32 as r2 = dir_find(v, v.root_cluster,
                                cast(*u8, "bigfile.bin"), 11,
                                &clus, &size, &attr);
    if (r2 != 0) {
        serial.print("fat32.test: find bigfile.bin FAIL rc=", 37);
        util.print_num(cast(i64, r2));
        serial.println("", 0);
        return;
    }
    if (size != BIGFILE_EXPECTED_SIZE) {
        serial.print("fat32.test: bigfile size mismatch size=", 39);
        util.print_num(size);
        serial.println("", 0);
        return;
    }
    // Need a bigger buffer for 1200 bytes; alloc 1 extra page.
    let is i64 as big_virt = alloc_dma_page();
    if (big_virt == 0) {
        serial.println("fat32.test: big rbuf alloc fail", 31);
        return;
    }
    let is *u8 as big = cast(*u8, big_virt);
    let is i64 as nb = file_read(v, clus, size, big, 4096);
    if (nb != size) {
        serial.print("fat32.test: bigfile read short nb=", 34);
        util.print_num(nb);
        serial.println("", 0);
        return;
    }
    let is i64 as mis with mut = 0;
    let is i64 as i with mut = 0;
    while (i < 600) {
        if (big[i] != cast(u8, 65)) { mis = mis + 1; }   // 'A'
        i = i + 1;
    }
    while (i < 1200) {
        if (big[i] != cast(u8, 66)) { mis = mis + 1; }   // 'B'
        i = i + 1;
    }
    if (mis == 0) {
        serial.println("fat32.test: bigfile verify OK (1200B across 3 clusters)", 55);
    } else {
        serial.print("fat32.test: bigfile mismatch=", 29);
        util.print_num(mis);
        serial.println("", 0);
    }

    // Long-file-name lookup: "long-name-with-spaces and mixed case.txt"
    // stores 4 LFN entries + a mangled 8.3 short name. Query must
    // match via LFN, case-insensitive.
    let is i32 as r3 = path_lookup(v,
        cast(*u8, "/long-name-with-spaces and mixed case.txt"), 41,
        &clus, &size, &attr);
    if (r3 != 0) {
        serial.print("fat32.test: LFN lookup FAIL rc=", 31);
        util.print_num(cast(i64, r3));
        serial.println("", 0);
    } else {
        let is i64 as lfn_virt = alloc_dma_page();
        let is *u8 as lb = cast(*u8, lfn_virt);
        let is i64 as ln = file_read(v, clus, size, lb, 4096);
        lb[size] = cast(u8, 0);
        serial.print("fat32.test: LFN='", 17);
        let is i64 as kk with mut = 0;
        while (kk < ln) { serial.putc(cast(i64, lb[kk])); kk = kk + 1; }
        serial.println("'", 1);
    }

    // Subdirectory traversal: /docs/readme.md was placed inside the
    // docs/ subdir (created via mkdir). Tests both path parsing and
    // walking into a non-root cluster.
    let is i32 as r4 = path_lookup(v,
        cast(*u8, "/docs/readme.md"), 15,
        &clus, &size, &attr);
    if (r4 != 0) {
        serial.print("fat32.test: subdir lookup FAIL rc=", 34);
        util.print_num(cast(i64, r4));
        serial.println("", 0);
    } else {
        let is i64 as sub_virt = alloc_dma_page();
        let is *u8 as sb = cast(*u8, sub_virt);
        let is i64 as sn = file_read(v, clus, size, sb, 4096);
        sb[size] = cast(u8, 0);
        serial.print("fat32.test: /docs/readme.md='", 29);
        let is i64 as mm with mut = 0;
        while (mm < sn) { serial.putc(cast(i64, sb[mm])); mm = mm + 1; }
        serial.println("'", 1);
    }

    self_test_write(v);
}

// ============================================================
// self_test_write — create, read-back, unlink round-trip. Covers the
// Phase 5 write path end-to-end:
//   1. Create /roundtrip.txt with ASCII payload → read back, compare
//   2. Create /long round-trip name with spaces.md (LFN+mangle) →
//      read back via both long-name and short-name queries, compare
//   3. Create /large.bin spanning 5 clusters with deterministic
//      pattern → read back, byte-verify
//   4. Unlink each, verify dir_find returns not-found
// ============================================================

let is [2600]u8 as large_payload with mut;

fn self_test_write(v as *Fat32Volume) as void {
    serial.println("fat32.test: write-path start", 28);

    // --- Test 1: simple ASCII file ---
    let is *u8 as payload1 = cast(*u8, "causticos FAT32 write-path works");
    let is i32 as c1 = file_create(v,
        cast(*u8, "/roundtrip.txt"), 14,
        payload1, 32);
    if (c1 != 0) {
        serial.print("fat32.test: create roundtrip.txt FAIL rc=", 41);
        util.print_num(cast(i64, c1)); serial.println("", 0);
        return;
    }
    let is i64 as back_virt = alloc_dma_page();
    let is *u8 as back = cast(*u8, back_virt);
    let is i64 as cc with mut = 0;
    let is i64 as ss with mut = 0;
    let is i32 as aa with mut = 0;
    if (path_lookup(v, cast(*u8, "/roundtrip.txt"), 14,
                    &cc, &ss, &aa) != 0) {
        serial.println("fat32.test: roundtrip lookup FAIL", 33);
        return;
    }
    if (ss != 32) {
        serial.print("fat32.test: roundtrip size=", 27);
        util.print_num(ss); serial.println(" expected 32", 12);
        return;
    }
    if (file_read(v, cc, ss, back, 4096) != 32) {
        serial.println("fat32.test: roundtrip read short", 32);
        return;
    }
    let is i64 as mm with mut = 0;
    let is i64 as mis1 with mut = 0;
    while (mm < 32) {
        if (back[mm] != payload1[mm]) { mis1 = mis1 + 1; }
        mm = mm + 1;
    }
    if (mis1 != 0) {
        serial.print("fat32.test: roundtrip mismatch=", 31);
        util.print_num(mis1); serial.println("", 0);
        return;
    }
    serial.println("fat32.test: roundtrip.txt OK", 28);

    // --- Test 2: long-name file requiring LFN + 8.3 mangle ---
    let is *u8 as payload2 = cast(*u8, "write-path LFN works");
    let is i32 as c2 = file_create(v,
        cast(*u8, "/long round-trip name with spaces.md"), 36,
        payload2, 20);
    if (c2 != 0) {
        serial.print("fat32.test: create LFN FAIL rc=", 31);
        util.print_num(cast(i64, c2)); serial.println("", 0);
        return;
    }
    if (path_lookup(v, cast(*u8, "/long round-trip name with spaces.md"), 36,
                    &cc, &ss, &aa) != 0) {
        serial.println("fat32.test: LFN lookup-after-create FAIL", 40);
        return;
    }
    if (file_read(v, cc, ss, back, 4096) != 20) {
        serial.println("fat32.test: LFN read-back size mismatch", 39);
        return;
    }
    let is i64 as p with mut = 0;
    let is i64 as mis2 with mut = 0;
    while (p < 20) {
        if (back[p] != payload2[p]) { mis2 = mis2 + 1; }
        p = p + 1;
    }
    if (mis2 == 0) { serial.println("fat32.test: LFN round-trip OK", 29); }
    else {
        serial.print("fat32.test: LFN payload mismatch=", 33);
        util.print_num(mis2); serial.println("", 0);
    }

    // --- Test 3: multi-cluster file (2600 bytes = 6 clusters of 512B) ---
    let is i64 as fill with mut = 0;
    while (fill < 2600) {
        large_payload[fill] = cast(u8, (fill * 31 + 7) & 0xFF);
        fill = fill + 1;
    }
    let is i32 as c3 = file_create(v,
        cast(*u8, "/large.bin"), 10,
        cast(*u8, &large_payload[0]), 2600);
    if (c3 != 0) {
        serial.print("fat32.test: create large FAIL rc=", 33);
        util.print_num(cast(i64, c3)); serial.println("", 0);
        return;
    }
    if (path_lookup(v, cast(*u8, "/large.bin"), 10, &cc, &ss, &aa) != 0) {
        serial.println("fat32.test: large lookup FAIL", 29);
        return;
    }
    // Reuse clus_scratch via a fresh page to avoid colliding with FAT walks.
    let is i64 as big_virt = alloc_dma_page();
    let is *u8 as big = cast(*u8, big_virt);
    if (file_read(v, cc, ss, big, 4096) != 2600) {
        serial.println("fat32.test: large read-back size mismatch", 41);
        return;
    }
    let is i64 as bi with mut = 0;
    let is i64 as mis3 with mut = 0;
    while (bi < 2600) {
        if (big[bi] != cast(u8, (bi * 31 + 7) & 0xFF)) { mis3 = mis3 + 1; }
        bi = bi + 1;
    }
    if (mis3 == 0) { serial.println("fat32.test: large.bin 2600B round-trip OK", 41); }
    else {
        serial.print("fat32.test: large mismatch=", 27);
        util.print_num(mis3); serial.println("", 0);
    }

    // --- Test 4: unlink + verify gone ---
    if (file_unlink(v, cast(*u8, "/roundtrip.txt"), 14) != 0) {
        serial.println("fat32.test: unlink roundtrip FAIL", 33);
        return;
    }
    if (path_lookup(v, cast(*u8, "/roundtrip.txt"), 14,
                    &cc, &ss, &aa) == 0) {
        serial.println("fat32.test: unlinked file still visible!", 40);
        return;
    }
    serial.println("fat32.test: unlink+verify OK", 28);

    self_test_dirs(v);
}

// ============================================================
// Phase 6 self-tests: mkdir, rename, rmdir round-trips.
// ============================================================

fn self_test_dirs(v as *Fat32Volume) as void {
    serial.println("fat32.test: dir-path start", 26);
    let is i64 as cc with mut = 0;
    let is i64 as ss with mut = 0;
    let is i32 as aa with mut = 0;

    // mkdir /data
    if (dir_create(v, cast(*u8, "/data"), 5) != 0) {
        serial.println("fat32.test: mkdir /data FAIL", 28);
        return;
    }
    if (path_lookup(v, cast(*u8, "/data"), 5, &cc, &ss, &aa) != 0) {
        serial.println("fat32.test: /data lookup FAIL", 29);
        return;
    }
    if ((aa & 0x10) == 0) {
        serial.println("fat32.test: /data not DIR", 25);
        return;
    }
    serial.println("fat32.test: mkdir /data OK", 26);

    // Create file inside /data
    if (file_create(v, cast(*u8, "/data/notes.txt"), 15,
                    cast(*u8, "inside data"), 11) != 0) {
        serial.println("fat32.test: create /data/notes FAIL", 35);
        return;
    }
    let is i64 as rb_virt = alloc_dma_page();
    let is *u8 as rb = cast(*u8, rb_virt);
    if (path_lookup(v, cast(*u8, "/data/notes.txt"), 15,
                    &cc, &ss, &aa) != 0) {
        serial.println("fat32.test: /data/notes lookup FAIL", 35);
        return;
    }
    if (file_read(v, cc, ss, rb, 4096) != 11) {
        serial.println("fat32.test: /data/notes read short", 34);
        return;
    }
    rb[11] = cast(u8, 0);
    serial.print("fat32.test: /data/notes.txt='", 29);
    let is i64 as k0 with mut = 0;
    while (k0 < 11) { serial.putc(cast(i64, rb[k0])); k0 = k0 + 1; }
    serial.println("'", 1);

    // rmdir on non-empty /data must be refused.
    let is i32 as rm_busy = dir_remove(v, cast(*u8, "/data"), 5);
    if (rm_busy == 0) {
        serial.println("fat32.test: rmdir accepted non-empty!", 37);
        return;
    }
    serial.println("fat32.test: rmdir refuses non-empty OK", 38);

    // rename /data/notes.txt -> /data/notebook.md (same parent)
    if (path_rename(v,
                    cast(*u8, "/data/notes.txt"), 15,
                    cast(*u8, "/data/notebook.md"), 17) != 0) {
        serial.println("fat32.test: rename (same-parent) FAIL", 37);
        return;
    }
    if (path_lookup(v, cast(*u8, "/data/notes.txt"), 15,
                    &cc, &ss, &aa) == 0) {
        serial.println("fat32.test: old name still present after rename", 47);
        return;
    }
    if (path_lookup(v, cast(*u8, "/data/notebook.md"), 17,
                    &cc, &ss, &aa) != 0) {
        serial.println("fat32.test: new name missing after rename", 41);
        return;
    }
    if (file_read(v, cc, ss, rb, 4096) != 11) {
        serial.println("fat32.test: renamed read short", 30);
        return;
    }
    rb[11] = cast(u8, 0);
    serial.print("fat32.test: rename same-parent OK '", 35);
    let is i64 as k1 with mut = 0;
    while (k1 < 11) { serial.putc(cast(i64, rb[k1])); k1 = k1 + 1; }
    serial.println("'", 1);

    // rename /data/notebook.md -> /docs/notebook.md (cross-parent)
    if (path_rename(v,
                    cast(*u8, "/data/notebook.md"), 17,
                    cast(*u8, "/docs/notebook.md"), 17) != 0) {
        serial.println("fat32.test: rename cross-parent FAIL", 36);
        return;
    }
    if (path_lookup(v, cast(*u8, "/docs/notebook.md"), 17,
                    &cc, &ss, &aa) != 0) {
        serial.println("fat32.test: moved file not in /docs", 35);
        return;
    }
    serial.println("fat32.test: rename cross-parent OK", 34);

    // Now /data is empty — rmdir should succeed.
    if (dir_remove(v, cast(*u8, "/data"), 5) != 0) {
        serial.println("fat32.test: rmdir empty /data FAIL", 34);
        return;
    }
    if (path_lookup(v, cast(*u8, "/data"), 5, &cc, &ss, &aa) == 0) {
        serial.println("fat32.test: /data still visible after rmdir", 43);
        return;
    }
    serial.println("fat32.test: rmdir empty OK", 26);
    serial.println("fat32.test: ALL PHASE-6 TESTS PASS", 34);
}
