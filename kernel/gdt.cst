// gdt.cst — Global Descriptor Table setup
//
// Layout (long mode, with userspace support):
//   slot 0    (sel 0x00): null
//   slot 1    (sel 0x08): kernel code        (DPL=0, L=1)
//   slot 2    (sel 0x10): kernel data / SS   (DPL=0)
//   slot 3    (sel 0x18): user code 32-bit   (DPL=3, L=0, D=1) — compat mode placeholder
//   slot 4    (sel 0x20): user data / SS     (DPL=3)
//   slot 5    (sel 0x28): user code 64-bit   (DPL=3, L=1)
//   slot 6+2i (sel 0x30 + 0x10*i): per-cpu TSS descriptor low half
//   slot 7+2i:                       per-cpu TSS descriptor high half
//
// The kernel CS / kernel SS / user CS-32 / user SS / user CS-64 ordering
// is mandated by SYSCALL/SYSRET: STAR[47:32] = kernel-base CS, kernel SS
// is taken from kernel-base+8; STAR[63:48] = user-base, user SS comes
// from user-base+8, user CS from user-base+16 on SYSRETQ. See
// IA-32 SDM Vol 2A SYSRET.
//
// TSS descriptors in long mode are 16 bytes (two 8-byte slots) so we
// reserve 2 slots per cpu. With MAX_CPUS_GDT=16 the GDT is now
// 6 fixed + 32 TSS = 38 slots = 304 bytes.

use "serial.cst" as serial;

let is i64 as MAX_CPUS_GDT = 16;
let is [304]u8 as gdt_raw;          // 38 i64 slots, zero-init

// Selectors. RPL bits stripped on the kernel ones, RPL=3 baked in on
// the user ones since SYSRETQ forces RPL=3 anyway.
let is i64 as KERNEL_CS_SEL  = 0x08;
let is i64 as KERNEL_DS_SEL  = 0x10;
let is i64 as USER_CS32_SEL  = 0x18 | 3;     // 0x1B
let is i64 as USER_DS_SEL    = 0x20 | 3;     // 0x23
let is i64 as USER_CS64_SEL  = 0x28 | 3;     // 0x2B

// GDTR: 2 bytes limit + 8 bytes base (10 bytes, packed)
let is i64 as gdtr_limit_base with mut = 0;
let is i64 as gdtr_base_hi with mut = 0;

// Per-cpu TSS structs. x86_64 TSS is 104 bytes — fields are NOT
// 8-byte aligned (RSP0 starts at offset 4) so we keep a raw byte
// array and poke the offsets manually. One per cpu, indexed by
// cpu_id. Each cpu loads ltr (0x30 + cpu*0x10) at boot.
let is i64 as TSS_SIZE = 104;
let is [1664]u8 as tss_raw;         // 16 cpus * 104 bytes

// IST1 stacks — separate kstack used by exception handlers (IDT
// gates with IST=1 force-switch RSP to this stack on entry, even
// for same-priv interrupts). 16 KiB per cpu.
let is [128]u8 as ist1_tops;        // 16 cpus * 8 bytes

fn ist1_top_get(cpu as i64) as i64 {
    let is *i64 as p = cast(*i64, &ist1_tops);
    return p[cpu];
}

fn ist1_top_set(cpu as i64, v as i64) as void {
    let is *i64 as p = cast(*i64, &ist1_tops);
    p[cpu] = v;
}

// TSS field accessors (raw-byte writes at fixed offsets per AMD64
// SDM Vol 2 §7.7).
//   offset 4   : RSP0  (i64) — kernel stack used on a ring-3 → ring-0
//                              transition (IRQ / exception without
//                              IST / SYSCALL via TSS)
//   offset 36  : IST1  (i64) — exception stack
//   offset 102 : iomap (u16)
fn tss_base_for(cpu as i64) as i64 {
    return cast(i64, &tss_raw) + cpu * TSS_SIZE;
}

fn tss_set_rsp0(cpu as i64, rsp as i64) as void {
    let is *i64 as p = cast(*i64, tss_base_for(cpu) + 4);
    p[0] = rsp;
}

fn tss_get_rsp0(cpu as i64) as i64 {
    let is *i64 as p = cast(*i64, tss_base_for(cpu) + 4);
    return p[0];
}

fn tss_set_ist1(cpu as i64, rsp as i64) as void {
    let is *i64 as p = cast(*i64, tss_base_for(cpu) + 36);
    p[0] = rsp;
}

fn tss_set_iomap_base(cpu as i64, base as i64) as void {
    // I/O permission map base at TSS+102. Writing TSS_SIZE here
    // means "no I/O map" (any in/out from ring >0 traps to #GP).
    let is *u16 as p = cast(*u16, tss_base_for(cpu) + 102);
    p[0] = cast(u16, base);
}

// Build a 16-byte 64-bit TSS descriptor in the GDT for `cpu`.
// Format (Intel SDM Vol 3A §7.2.3):
//   bytes 0-1:  limit[0:15]
//   bytes 2-4:  base[0:23]
//   byte  5:    type=0x9 (available 64-bit TSS) | S=0 | DPL=00 | P=1 → 0x89
//   byte  6:    limit[16:19] | flags (G=0, AVL=0) → 0x00
//   byte  7:    base[24:31]
//   bytes 8-11: base[32:63]
//   bytes 12-15: reserved (zero)
fn install_tss_descriptor(cpu as i64) as void {
    let is i64 as base = tss_base_for(cpu);
    let is i64 as limit = TSS_SIZE - 1;
    let is i64 as slot_offset = (6 + cpu * 2) * 8;

    let is i64 as lo with mut = 0;
    lo = limit & 0xFFFF;
    lo = lo | ((base & 0xFFFFFF) << 16);
    lo = lo | (0x89 << 40);                       // type+P+DPL=0
    lo = lo | (((limit >> 16) & 0xF) << 48);
    lo = lo | (((base >> 24) & 0xFF) << 56);

    let is i64 as hi = (base >> 32) & 0xFFFFFFFF;

    let is *i64 as g = cast(*i64, cast(i64, &gdt_raw) + slot_offset);
    g[0] = lo;
    g[1] = hi;
}

// Slot indices used by IDT gates / ltr.
fn tss_selector(cpu as i64) as i64 {
    return (6 + cpu * 2) * 8;       // GDT byte offset = selector value
}

fn init() as void {
    let is *i64 as g = cast(*i64, &gdt_raw);
    g[0] = 0;
    // slot 1: kernel CS — present, DPL=0, type=0xA (exec/read), L=1
    g[1] = 0x00AF9A000000FFFF;
    // slot 2: kernel SS / data — present, DPL=0, type=2 (read/write)
    g[2] = 0x00CF92000000FFFF;
    // slot 3: user CS 32-bit (compat) — present, DPL=3, type=0xA, L=0, D=1
    //   Required by SYSRETL even when we never actually run 32-bit code:
    //   the slot has to exist at STAR_user_base + 0 with DPL=3.
    g[3] = 0x00CFFA000000FFFF;
    // slot 4: user SS / data — present, DPL=3, type=2 (read/write)
    g[4] = 0x00CFF2000000FFFF;
    // slot 5: user CS 64-bit — present, DPL=3, type=0xA, L=1
    g[5] = 0x00AFFA000000FFFF;

    // TSS slots are filled per-cpu later. install_tss_descriptor
    // pokes (6 + 2*cpu) and (7 + 2*cpu).

    let is i64 as gdt_base = cast(i64, &gdt_raw);
    let is i64 as limit = 304 - 1;   // 38 slots * 8 - 1

    gdtr_limit_base = limit + ((gdt_base & 0xFFFFFFFFFFFF) << 16);
    gdtr_base_hi = (gdt_base >> 48) & 0xFFFF;

    ap_load();

    serial.println("gdt: ok", 7);
}

// Per-cpu TSS load. Caller must have installed the TSS descriptor
// for this cpu (install_tss_descriptor) AND populated the IST1 stack
// + iomap base in tss_raw before calling. Uses raw `ltr` opcode
// because caustic-as drops the mnemonic.
let is i64 as ltr_selector with mut = 0;

fn load_tss(cpu as i64) as void {
    ltr_selector = tss_selector(cpu);
    asm("lea rax, [rip+_kernel_gdt_cst_ltr_selector]\n");
    asm("mov ax, WORD PTR [rax]\n");
    asm(".byte 0x0F, 0x00, 0xD8\n");   // ltr ax
}

// Per-cpu GDT install. BSP does this as part of init() after
// building the GDTR; APs call it once at entry so they load the same
// (shared, read-only) descriptor table and end up with well-defined
// CS/DS/ES/FS/GS/SS caches. `mov gs, ax` in 64-bit mode clobbers the
// hidden GS.BASE, so the caller must follow this with an
// `smp.install_gs_base(me)` wrmsr before touching any per-cpu state.
fn ap_load() as void {
    asm("lea rax, [rip+_kernel_gdt_cst_gdtr_limit_base]\n");
    asm(".byte 0x0F, 0x01, 0x10\n");  // lgdt [rax]

    // Reload CS via far return
    asm("mov rax, 0x08\n");            // kernel code selector
    asm("push rax\n");
    asm("lea rax, [rip+.Lreload_cs_ap]\n");
    asm("push rax\n");
    asm(".byte 0x48, 0xCB\n");        // retfq (far return)
    asm(".Lreload_cs_ap:\n");

    // Reload data segments (caustic-as drops mov to segment regs, use raw opcodes)
    asm("mov rax, 0x10\n");           // kernel data selector
    asm(".byte 0x8E, 0xD8\n");        // mov ds, ax
    asm(".byte 0x8E, 0xC0\n");        // mov es, ax
    asm(".byte 0x8E, 0xE0\n");        // mov fs, ax
    asm(".byte 0x8E, 0xE8\n");        // mov gs, ax
    asm(".byte 0x8E, 0xD0\n");        // mov ss, ax
}
