// fd_smoke.cst — descriptors and IPC: the per-aspace fd table and its growth,
// closing on exit, a channel handed to a child, the fd handoff at spawn, and
// SYS_POLL readiness from the kernel side and from ring 3. Run by
// user_smoke.cst on a smoke boot.

use "serial.cst" as serial;
use "util.cst" as util;
use "pmm.cst" as pmm;
use "vma.cst" as vma;
use "sched.cst" as sched;
use "vfs.cst" as vfs;
use "abi.cst" as abi;
use "process.cst" as proc;
use "channel.cst" as channel;
use "kobject.cst" as kobject;
use "kbd.cst" as kbd;
use "mouse.cst" as mouse;
use "driver.cst" as driver;
use "userspace.cst" as userspace;
use "ucode.cst" as uc;

// ============================================================
// Embedded "channel child" CSE — proves the IPC handoff from ring 3:
// read(fd 0, &b, 1) then exit(b). fd 0 is a channel endpoint handed to it
// at spawn (the fdacts mechanism). The kernel writes a byte on the other
// end; the child echoes it as its exit code.
// ============================================================

let is i64 as CSE_CC_ENTRY  = 0x401000;
let is i64 as CSE_CC_BSS_VA = 0x402000;
let is i64 as CSE_CC_FOFF   = 0x50;
let is i64 as child_cc_len with mut = 0;
let is [256]u8 as child_cc;

fn build_child_chan_cse() as void {
    let is *u8 as e = cast(*u8, &child_cc[0]);
    let is i64 as z with mut = 0;
    while (z < 256) { e[z] = cast(u8, 0); z = z + 1; }

    e[0]=cast(u8,0x43); e[1]=cast(u8,0x53); e[2]=cast(u8,0x54); e[3]=cast(u8,0x5F); // "CST_"
    e[4]=cast(u8,2); e[5]=cast(u8,0); e[6]=cast(u8,1); e[7]=cast(u8,0);
    uc.write_le_u64(e, 0x08, CSE_CC_ENTRY);
    uc.write_le_u64(e, 0x10, 0x400000);
    uc.write_le_u32(e, 0x18, 2);
    uc.write_le_u32(e, 0x1C, 0);
    uc.write_le_u64(e, 0x20, CSE_CC_ENTRY);
    uc.write_le_u32(e, 0x28, CSE_CC_FOFF);
    uc.write_le_u32(e, 0x34, 5);
    uc.write_le_u64(e, 0x38, CSE_CC_BSS_VA);
    uc.write_le_u32(e, 0x40, 0);
    uc.write_le_u32(e, 0x44, 0);
    uc.write_le_u32(e, 0x48, 0x1000);
    uc.write_le_u32(e, 0x4C, 3);

    let is i64 as c with mut = CSE_CC_FOFF;
    // movabs r15, BSS
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0xBF); uc.write_le_u64(e, c+2, CSE_CC_BSS_VA); c = c + 10;
    // read(0, r15, 1): mov rax,10; xor edi,edi; mov rsi,r15; mov rdx,1; syscall
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,10); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;
    e[c+0]=cast(u8,0x31); e[c+1]=cast(u8,0xFF); c = c + 2;                        // xor edi,edi
    e[c+0]=cast(u8,0x4C); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0xFE); c = c + 3;  // mov rsi,r15
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC2);
    e[c+3]=cast(u8,1); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;                        // syscall
    // movzx edi, byte [r15]
    e[c+0]=cast(u8,0x41); e[c+1]=cast(u8,0x0F); e[c+2]=cast(u8,0xB6); e[c+3]=cast(u8,0x3F); c = c + 4;
    // exit(edi): mov rax,3; syscall
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,3); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;                        // syscall

    let is i64 as text_size = c - CSE_CC_FOFF;
    uc.write_le_u32(e, 0x2C, text_size);
    uc.write_le_u32(e, 0x30, text_size);
    child_cc_len = c;
}

// Proves channel + handoff + ring-3 channel read end to end: mint a pair,
// spawn the child with endpoint B as its fd 0 (the fdacts mechanism — same
// ko_ref + fd_install the SYS_SPAWN handler does), write a byte on endpoint
// A, and confirm the child exits with that byte.
fn spawn_channel_smoke() as void {
    serial.println("userspace.chan_smoke: start", 27);
    build_child_chan_cse();

    let is i64 as ko_a with mut = 0;
    let is i64 as ko_b with mut = 0;
    if (channel.channel_create(&ko_a, &ko_b) != 0) {
        serial.println("userspace.chan_smoke: create FAIL", 33);
        return;
    }

    let is i64 as child = userspace.proc_spawn(proc.root_proc, cast(*u8, &child_cc[0]), child_cc_len);
    if (child == 0) {
        kobject.ko_unref(ko_a); kobject.ko_unref(ko_b);
        serial.println("userspace.chan_smoke: spawn FAIL", 32);
        return;
    }

    // Handoff: install endpoint B as the child's fd 0.
    let is i64 as child_asp = proc.proc_aspace(child);
    kobject.ko_ref(ko_b);
    vma.fd_install(cast(*vma.Aspace, child_asp), 0, ko_b);
    userspace.proc_start(child);

    // Write the sentinel on endpoint A; the child's blocking read wakes.
    let is *kobject.KObject as ka = cast(*kobject.KObject, ko_a);
    let is [1]u8 as msg;
    msg[0] = cast(u8, 7);
    channel.chan_write(ka.priv, cast(i64, &msg[0]), 1);

    let is i64 as code = userspace.proc_wait(proc.root_proc, proc.proc_pid(child));

    kobject.ko_unref(ko_a);     // my endpoint A
    kobject.ko_unref(ko_b);     // my original ref to endpoint B (child's was freed at teardown)

    if (code == 7) {
        serial.println("userspace.chan_smoke: PASS", 26);
    } else {
        serial.print("userspace.chan_smoke: exit=", 27);
        util.print_num(code);
        serial.println(" FAIL", 5);
    }
}

// ============================================================
// Embedded "fdacts parent" CSE — proves the SYS_SPAWN fdacts path from
// ring 3, end to end ring-3 → ring-3: the parent does
//   channel_create → spawn(child, fdacts=[{0, fd_b}]) → write(fd_a, 7) →
//   wait(child) → exit(code)
// all via real syscalls. The child CSE (build_child_chan_cse) is embedded at
// a fixed file offset so its VA is known. The kernel only spawns the parent
// and checks it exits with 7 — the byte the child read off the handed-off
// channel endpoint and echoed back.
// ============================================================

let is i64 as CSE_PF_ENTRY      = 0x401000;
let is i64 as CSE_PF_BSS_VA     = 0x402000;
let is i64 as CSE_PF_FOFF       = 0x50;
let is i64 as CSE_PF_CHILD_FOFF = 0x200;     // child image embedded here (code fits below)
let is i64 as parent_fd_len with mut = 0;
let is [1024]u8 as parent_fd;

fn build_parent_fdacts_cse() as void {
    let is *u8 as e = cast(*u8, &parent_fd[0]);
    let is i64 as z with mut = 0;
    while (z < 1024) { e[z] = cast(u8, 0); z = z + 1; }

    e[0]=cast(u8,0x43); e[1]=cast(u8,0x53); e[2]=cast(u8,0x54); e[3]=cast(u8,0x5F); // "CST_"
    e[4]=cast(u8,2); e[5]=cast(u8,0); e[6]=cast(u8,1); e[7]=cast(u8,0);
    uc.write_le_u64(e, 0x08, CSE_PF_ENTRY);
    uc.write_le_u64(e, 0x10, 0x400000);
    uc.write_le_u32(e, 0x18, 2);
    uc.write_le_u32(e, 0x1C, 0);
    uc.write_le_u64(e, 0x20, CSE_PF_ENTRY);
    uc.write_le_u32(e, 0x28, CSE_PF_FOFF);
    uc.write_le_u32(e, 0x34, 5);
    uc.write_le_u64(e, 0x38, CSE_PF_BSS_VA);
    uc.write_le_u32(e, 0x40, 0);
    uc.write_le_u32(e, 0x44, 0);
    uc.write_le_u32(e, 0x48, 0x1000);
    uc.write_le_u32(e, 0x4C, 3);

    // child VA = where CSE_PF_CHILD_FOFF maps in the parent's .text.
    let is i64 as child_va = CSE_PF_ENTRY + (CSE_PF_CHILD_FOFF - CSE_PF_FOFF);

    // BSS layout (r15): +0 fd_a, +8 fd_b, +16/+24 fdacts{child_fd,src_fd},
    //                   +32 child_pid, +40 sentinel byte, +48 wait status.
    let is i64 as c with mut = CSE_PF_FOFF;
    // movabs r15, BSS
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0xBF); uc.write_le_u64(e, c+2, CSE_PF_BSS_VA); c = c + 10;

    // channel_create(out = r15): mov rax,24; mov rdi,r15; syscall
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,24); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;
    e[c+0]=cast(u8,0x4C); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0xFF); c = c + 3;   // mov rdi,r15
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;                          // syscall

    // fdacts[0] = {child_fd=0, src_fd=fd_b}
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x10);
    e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); e[c+7]=cast(u8,0); c = c + 8;   // mov qword [r15+16],0
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x8B); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x08); c = c + 4;  // mov rax,[r15+8]
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x18); c = c + 4;  // mov [r15+24],rax

    // SYS_SPAWN(*SpawnParams): img=child_va, fdacts=BSS+16 (the {0,fd_b} pair
    // just written), n_acts=1, no argv, budget=0. The fdacts VA is the fixed BSS
    // address (= r15+16), so the helper's imm64 store is correct.
    c = uc.emit_spawn_params(e, c, child_va, child_cc_len, CSE_PF_BSS_VA + 16, 1, 0, 0, 0);
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x20); c = c + 4;  // mov [r15+32],rax (pid)

    // write(fd_a, &sentinel=r15+40, 1) — sentinel = 7
    e[c+0]=cast(u8,0x41); e[c+1]=cast(u8,0xC6); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x28); e[c+4]=cast(u8,7); c = c + 5;  // mov byte [r15+40],7
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,11); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;    // mov rax,11
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x8B); e[c+2]=cast(u8,0x7F); e[c+3]=cast(u8,0x00); c = c + 4;  // mov rdi,[r15+0]
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x8D); e[c+2]=cast(u8,0x77); e[c+3]=cast(u8,0x28); c = c + 4;  // lea rsi,[r15+40]
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC2);
    e[c+3]=cast(u8,1); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;     // mov rdx,1
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;                                     // syscall

    // wait(child_pid, status=r15+48)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,15); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;    // mov rax,15
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x8B); e[c+2]=cast(u8,0x7F); e[c+3]=cast(u8,0x20); c = c + 4;  // mov rdi,[r15+32]
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x8D); e[c+2]=cast(u8,0x77); e[c+3]=cast(u8,0x30); c = c + 4;  // lea rsi,[r15+48]
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;                                     // syscall

    // exit(rax): mov rdi,rax; mov rax,3; syscall
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0xC7); c = c + 3;               // mov rdi,rax
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,3); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;     // mov rax,3
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;                                     // syscall

    // Embed the child image at CSE_PF_CHILD_FOFF (code above ends well before it).
    let is i64 as j with mut = 0;
    while (j < child_cc_len) { e[CSE_PF_CHILD_FOFF + j] = child_cc[j]; j = j + 1; }

    let is i64 as text_size = (CSE_PF_CHILD_FOFF + child_cc_len) - CSE_PF_FOFF;
    uc.write_le_u32(e, 0x2C, text_size);     // seg0 file_size
    uc.write_le_u32(e, 0x30, text_size);     // seg0 mem_size
    parent_fd_len = CSE_PF_CHILD_FOFF + child_cc_len;
}

// Spawn the parent (a Process — only a Process may SYS_SPAWN) and confirm it
// exits with 7: the whole channel_create / spawn-with-fdacts / write / wait
// dance happened in ring 3, child included.
fn spawn_fdacts_smoke() as void {
    serial.println("userspace.fdacts_smoke: start", 29);
    build_child_chan_cse();        // must run first — parent embeds it + needs its len
    build_parent_fdacts_cse();

    let is i64 as parent = userspace.proc_spawn(proc.root_proc, cast(*u8, &parent_fd[0]), parent_fd_len);
    if (parent == 0) {
        serial.println("userspace.fdacts_smoke: spawn FAIL", 34);
        return;
    }
    userspace.proc_start(parent);
    let is i64 as code = userspace.proc_wait(proc.root_proc, proc.proc_pid(parent));
    if (code == 7) {
        serial.println("userspace.fdacts_smoke: PASS", 28);
    } else {
        serial.print("userspace.fdacts_smoke: exit=", 29);
        util.print_num(code);
        serial.println(" FAIL", 5);
    }
}

// FD table smoke — kernel-side test of the per-aspace fd table.
// Opens /hello.txt twice, validates fd allocation / lookup / close /
// install semantics. Doesn't go through the (yet-unwritten) syscall
// surface, but proves the foundation is correct ahead of it.
fn fd_table_smoke() as void {
    serial.println("userspace.fd_smoke: start", 25);
    let is *vma.Aspace as a = vma.aspace_create();
    if (cast(i64, a) == 0) {
        serial.println("userspace.fd_smoke: aspace FAIL", 31);
        return;
    }

    let is *vfs.VfsFile as f1 = vfs.open(cast(*u8, "/hello.txt"), 10, cast(i32, 0));
    if (cast(i64, f1) == 0) {
        serial.println("userspace.fd_smoke: open #1 FAIL", 32);
        return;
    }
    // FD_FIRST_DYNAMIC, not 0: fd 0..9 are the slots a spawner puts keys in
    // and are never handed out by allocation, empty or not. A program launched
    // with no stdio has those slots free, and a descriptor landing on one of
    // them silently redirects everything the program prints into it — or, at
    // 6, is taken for netd's gate.
    let is i64 as fd1 = vma.fd_alloc(a, cast(i64, f1));
    if (fd1 != vma.FD_FIRST_DYNAMIC) {
        serial.print("userspace.fd_smoke: expected the first dynamic fd, got ", 55);
        util.print_num(fd1);
        serial.println(" FAIL", 5);
        return;
    }
    if (vma.fd_get(a, fd1) != cast(i64, f1)) {
        serial.println("userspace.fd_smoke: fd_get mismatch FAIL", 40);
        return;
    }

    let is *vfs.VfsFile as f2 = vfs.open(cast(*u8, "/hello.txt"), 10, cast(i32, 0));
    let is i64 as fd2 = vma.fd_alloc(a, cast(i64, f2));
    if (fd2 != vma.FD_FIRST_DYNAMIC + 1) {
        serial.println("userspace.fd_smoke: expected the next dynamic fd FAIL", 53);
        return;
    }
    // The reserved slots are still empty and must have stayed that way.
    let is i64 as r with mut = 0;
    while (r < vma.FD_FIRST_DYNAMIC) {
        if (vma.fd_get(a, r) != 0) {
            serial.println("userspace.fd_smoke: alloc took a reserved slot FAIL", 51);
            return;
        }
        r = r + 1;
    }
    // fd_install may still name one: that is how a spawn hands a child its
    // stdout, and the reservation exists for that rather than against it.
    let is *vfs.VfsFile as f3 = vfs.open(cast(*u8, "/hello.txt"), 10, cast(i32, 0));
    if (cast(i64, f3) == 0) {
        serial.println("userspace.fd_smoke: open #3 FAIL", 32);
        return;
    }
    if (vma.fd_install(a, 1, cast(i64, f3)) != 0) {
        serial.println("userspace.fd_smoke: fd_install of a reserved slot refused FAIL", 62);
        return;
    }
    if (vma.fd_close(a, 1) != 0) {
        serial.println("userspace.fd_smoke: fd_close of a reserved slot FAIL", 52);
        return;
    }

    if (vma.fd_install(a, fd2, cast(i64, f2)) == 0) {
        serial.println("userspace.fd_smoke: fd_install of busy slot succeeded FAIL", 58);
        return;
    }

    if (vma.fd_close(a, fd1) != 0) {
        serial.println("userspace.fd_smoke: fd_close FAIL", 33);
        return;
    }
    if (vma.fd_get(a, fd1) != 0) {
        serial.println("userspace.fd_smoke: closed slot still occupied FAIL", 51);
        return;
    }

    let is i64 as fd3 = vma.fd_alloc(a, cast(i64, f1));
    if (fd3 != vma.FD_FIRST_DYNAMIC) {
        serial.println("userspace.fd_smoke: realloc didn't reuse FAIL", 45);
        return;
    }

    serial.println("userspace.fd_smoke: PASS", 24);
}

// fd-table growth smoke — the table outgrows its inline slots. 200
// descriptors on one object land one after another from FD_FIRST_DYNAMIC,
// never in a key slot; the grown table is charged to the process; a budget
// stops it growing; fd_install far up grows it to hold the slot; teardown
// drains every slot and gives the table back, leaving only the smoke's own
// reference on the object.
fn fd_grow_smoke() as void {
    serial.println("userspace.fdgrow_smoke: start", 29);
    let is *vma.Aspace as a = vma.aspace_create();
    if (cast(i64, a) == 0) { serial.println("userspace.fdgrow_smoke: aspace FAIL", 35); return; }
    let is *vfs.VfsFile as fp = vfs.open(cast(*u8, "/hello.txt"), 10, cast(i32, 0));
    if (cast(i64, fp) == 0) { serial.println("userspace.fdgrow_smoke: open FAIL", 33); return; }
    let is i64 as ko = vfs.make_file_kobject(fp);
    if (ko == 0) { serial.println("userspace.fdgrow_smoke: wrap FAIL", 33); return; }
    let is i32 as ok with mut = cast(i32, 1);
    let is i64 as first = vma.FD_FIRST_DYNAMIC;
    let is i64 as i with mut = 0;
    while (i < 200) {
        kobject.ko_ref(ko);
        if (vma.fd_alloc(a, ko) != first + i) { ok = cast(i32, 0); }
        i = i + 1;
    }
    if (vma.fd_capacity(a) < first + 200) { ok = cast(i32, 0); }
    if (vma.fd_get(a, first + 199) != ko) { ok = cast(i32, 0); }
    if (vma.fd_get(a, vma.FD_STDERR_TTY) != 0) { ok = cast(i32, 0); }
    if (a.bookkeeping_bytes != vma.fd_capacity(a) * 8) { ok = cast(i32, 0); }
    // Full, with a budget that leaves no room to grow: refused.
    let is i64 as cap = vma.fd_capacity(a);
    let is i64 as fd with mut = first + 200;
    while (fd < cap) {
        kobject.ko_ref(ko);
        if (vma.fd_alloc(a, ko) != fd) { ok = cast(i32, 0); }
        fd = fd + 1;
    }
    a.budget = a.committed_bytes + a.bookkeeping_bytes + 8;
    kobject.ko_ref(ko);
    if (vma.fd_alloc(a, ko) != 0 - 1) { ok = cast(i32, 0); }
    else { kobject.ko_unref(ko); }
    if (vma.fd_capacity(a) != cap) { ok = cast(i32, 0); }
    a.budget = 0;
    // A slot far past the table: it grows to hold it.
    kobject.ko_ref(ko);
    if (vma.fd_install(a, 1000, ko) != cast(i32, 0)) { ok = cast(i32, 0); }
    if (vma.fd_capacity(a) <= 1000 || vma.fd_get(a, 1000) != ko) { ok = cast(i32, 0); }
    vma.aspace_destroy(a);
    if (fp.in_use == 0) { ok = cast(i32, 0); }                   // ours is still there
    kobject.ko_unref(ko);
    if (fp.in_use != 0) { ok = cast(i32, 0); }                   // and was the last
    if (ok == cast(i32, 1)) { serial.println("userspace.fdgrow_smoke: PASS", 28); }
    else { serial.println("userspace.fdgrow_smoke: FAIL", 28); }
}

// Close-on-exit smoke — proves aspace teardown drains the fd table.
// Opens a file, wraps it in a KObject, installs it as an fd, then tears
// the aspace down WITHOUT closing the fd. aspace_destroy must ko_unref it
// for us, returning the VfsFile to the pool (fp.in_use → 0). Without the
// drain this leaks; with it, a process that exits with open fds is clean.
fn close_on_exit_smoke() as void {
    serial.println("userspace.coe_smoke: start", 26);
    let is *vma.Aspace as a = vma.aspace_create();
    if (cast(i64, a) == 0) {
        serial.println("userspace.coe_smoke: aspace FAIL", 32);
        return;
    }
    let is *vfs.VfsFile as fp = vfs.open(cast(*u8, "/hello.txt"), 10, cast(i32, 0));
    if (cast(i64, fp) == 0) {
        serial.println("userspace.coe_smoke: open FAIL", 30);
        return;
    }
    let is i64 as ko = vfs.make_file_kobject(fp);
    if (ko == 0) {
        serial.println("userspace.coe_smoke: wrap FAIL", 30);
        return;
    }
    let is i64 as fd = vma.fd_alloc(a, ko);
    if (fd < 0) {
        serial.println("userspace.coe_smoke: fd_alloc FAIL", 34);
        return;
    }
    if (fp.in_use == 0) {
        serial.println("userspace.coe_smoke: not in_use before FAIL", 43);
        return;
    }
    // Tear down without closing the fd — the drain must do it.
    vma.aspace_destroy(a);
    if (fp.in_use != 0) {
        serial.println("userspace.coe_smoke: LEAK on exit FAIL", 38);
        return;
    }
    serial.println("userspace.coe_smoke: PASS", 25);
}

// ============================================================
// poll_unit_smoke — kernel-side readiness checks across kinds, straight
// through ko_poll (the exact dispatch SYS_POLL uses). Pins the contract:
// channel empty/with-data/full/threshold/peer-closed, keyboard and mouse
// inject→readable→drain→idle, and a no-poll-op kind (vfs file) reporting
// always-ready. Failures panic — verify.sh greps panics, not FAIL lines.
// ============================================================

fn poll_drain_device(ko as i64, recsz as i64, who as *u8, who_len as i64) as void {
    let is [8]u8 as scratch;
    let is i64 as guard with mut = 0;
    while ((kobject.ko_poll(ko) & abi.POLL_READABLE) != 0) {
        kobject.ko_read(ko, cast(i64, &scratch[0]), recsz);
        guard = guard + 1;
        if (guard > 256) { pmm.panic(who, who_len); }
    }
}

fn poll_unit_smoke() as void {
    serial.println("poll_unit_smoke: start", 22);

    // -- channel readiness --
    let is i64 as ko_a with mut = 0;
    let is i64 as ko_b with mut = 0;
    if (channel.channel_create(&ko_a, &ko_b) != cast(i32, 0)) {
        pmm.panic("poll_smoke: chan create FAIL", 28);
    }
    if (kobject.ko_poll(ko_a) != abi.POLL_WRITABLE) {
        pmm.panic("poll_smoke: empty chan FAIL", 27);
    }
    let is [1]u8 as one;
    one[0] = cast(u8, 7);
    channel.chan_write(kobject.ko_priv(ko_a), cast(i64, &one[0]), 1);
    if (kobject.ko_poll(ko_b) != (abi.POLL_READABLE | abi.POLL_WRITABLE)) {
        pmm.panic("poll_smoke: data chan FAIL", 26);
    }
    let is [32]u8 as sink;
    channel.chan_read(kobject.ko_priv(ko_b), cast(i64, &sink[0]), 1);
    if (kobject.ko_poll(ko_b) != abi.POLL_WRITABLE) {
        pmm.panic("poll_smoke: drained chan FAIL", 29);
    }
    // Fill a→b completely: A loses WRITABLE; drain past the threshold and it
    // returns exactly at POLL_WRITE_UNIT free — the no-partial-write contract.
    let is [256]u8 as blk;
    let is i64 as zz with mut = 0;
    while (zz < 256) { blk[zz] = cast(u8, 0x55); zz = zz + 1; }
    // Fill to the channel's OWN capacity, asked for rather than assumed. This
    // loop stopped at a hardcoded 1024 — which was the capacity, until the
    // buffer grew to 8 KiB to stop throttling the shell and this was not
    // touched. It then filled an eighth of the ring, found it still writable,
    // and panicked about a contract the channel was honouring correctly.
    let is i64 as pushed with mut = 0;
    while (pushed < channel.BUF_CAP) {
        let is i64 as w = channel.chan_write(kobject.ko_priv(ko_a), cast(i64, &blk[0]), 256);
        if (w <= 0) { pmm.panic("poll_smoke: fill FAIL", 21); }
        pushed = pushed + w;
    }
    if ((kobject.ko_poll(ko_a) & abi.POLL_WRITABLE) != 0) {
        pmm.panic("poll_smoke: full chan FAIL", 26);
    }
    channel.chan_read(kobject.ko_priv(ko_b), cast(i64, &sink[0]), 32);
    if ((kobject.ko_poll(ko_a) & abi.POLL_WRITABLE) != 0) {
        pmm.panic("poll_smoke: threshold-32 FAIL", 29);
    }
    channel.chan_read(kobject.ko_priv(ko_b), cast(i64, &sink[0]), 32);
    if ((kobject.ko_poll(ko_a) & abi.POLL_WRITABLE) == 0) {
        pmm.panic("poll_smoke: threshold-64 FAIL", 29);
    }
    // Peer hangup: closing B makes A fully "ready" (EOF/E_PIPE pending) + CLOSED.
    kobject.ko_unref(ko_b);
    if (kobject.ko_poll(ko_a) != (abi.POLL_READABLE | abi.POLL_WRITABLE | abi.POLL_CLOSED)) {
        pmm.panic("poll_smoke: closed chan FAIL", 28);
    }
    kobject.ko_unref(ko_a);

    // -- keyboard: inject → readable → drain → idle --
    let is i64 as kko = driver.device_open(abi.DEV_KEYBOARD, 0);
    if (kko == 0) { pmm.panic("poll_smoke: kbd open FAIL", 25); }
    poll_drain_device(kko, 2, "poll_smoke: kbd drain FAIL", 26);
    if (kobject.ko_poll(kko) != 0) { pmm.panic("poll_smoke: kbd idle FAIL", 25); }
    kbd.inject_event(3, 1);
    if (kobject.ko_poll(kko) != abi.POLL_READABLE) {
        pmm.panic("poll_smoke: kbd ready FAIL", 26);
    }
    poll_drain_device(kko, 2, "poll_smoke: kbd redrain FAIL", 28);
    kobject.ko_unref(kko);

    // -- mouse: same shape over 4-byte records --
    let is i64 as mko = driver.device_open(abi.DEV_MOUSE, 0);
    if (mko == 0) { pmm.panic("poll_smoke: mouse open FAIL", 27); }
    poll_drain_device(mko, 4, "poll_smoke: mouse drain FAIL", 28);
    if (kobject.ko_poll(mko) != 0) { pmm.panic("poll_smoke: mouse idle FAIL", 27); }
    mouse.inject_event(5, 0, 0, 0);
    if (kobject.ko_poll(mko) != abi.POLL_READABLE) {
        pmm.panic("poll_smoke: mouse ready FAIL", 28);
    }
    poll_drain_device(mko, 4, "poll_smoke: mouse redrain FAIL", 30);
    kobject.ko_unref(mko);

    // -- a kind with no poll op (vfs file): always ready, honestly --
    let is *vfs.VfsFile as vf = vfs.open(cast(*u8, "/hello.txt"), 10, cast(i32, 0));
    if (cast(i64, vf) == 0) { pmm.panic("poll_smoke: vfs open FAIL", 25); }
    let is i64 as fko = vfs.make_file_kobject(vf);
    if (fko == 0) { pmm.panic("poll_smoke: vfs ko FAIL", 23); }
    if (kobject.ko_poll(fko) != (abi.POLL_READABLE | abi.POLL_WRITABLE)) {
        pmm.panic("poll_smoke: vfs ready FAIL", 26);
    }
    kobject.ko_unref(fko);

    serial.println("poll_unit_smoke: PASS", 21);
}

// ============================================================
// Ring-3 SYS_POLL smokes — the syscall path end to end, three children:
//   mode 0: poll fd 0 (a channel) with INFINITE timeout → read 1 → exit(byte).
//           The kernel starts it, sleeps 100ms (the child is parked inside
//           sys_poll, not racing), then writes 7 — exit must be 7.
//   mode 1: poll an empty channel with a 100ms timeout → exit(5 + ret + got).
//           Nothing ever arrives — poll must return 0 with got 0: exit 5.
//   mode 2: dev_open(DEV_KEYBOARD) → poll it (infinite) → read 2 → exit(sc).
//           Kernel injects scancode 9 after 100ms — exit must be 9.
// ============================================================

let is i64 as CSE_PL_ENTRY  = 0x401000;
let is i64 as CSE_PL_BSS_VA = 0x402000;
let is i64 as CSE_PL_FOFF   = 0x50;
let is i64 as child_pl_len with mut = 0;
let is [256]u8 as child_pl;

// One builder, three bodies. The PollEntry lives at BSS+0 ({fd, want, got},
// fd/got pre-zeroed by the loader's BSS fill); the read buffer at BSS+24.
fn build_poll_child_cse(mode as i64) as void {
    let is *u8 as e = cast(*u8, &child_pl[0]);
    let is i64 as z with mut = 0;
    while (z < 256) { e[z] = cast(u8, 0); z = z + 1; }

    e[0]=cast(u8,0x43); e[1]=cast(u8,0x53); e[2]=cast(u8,0x54); e[3]=cast(u8,0x5F); // "CST_"
    e[4]=cast(u8,2); e[5]=cast(u8,0); e[6]=cast(u8,1); e[7]=cast(u8,0);
    uc.write_le_u64(e, 0x08, CSE_PL_ENTRY);
    uc.write_le_u64(e, 0x10, 0x400000);
    uc.write_le_u32(e, 0x18, 2);
    uc.write_le_u32(e, 0x1C, 0);
    uc.write_le_u64(e, 0x20, CSE_PL_ENTRY);
    uc.write_le_u32(e, 0x28, CSE_PL_FOFF);
    uc.write_le_u32(e, 0x34, 5);
    uc.write_le_u64(e, 0x38, CSE_PL_BSS_VA);
    uc.write_le_u32(e, 0x40, 0);
    uc.write_le_u32(e, 0x44, 0);
    uc.write_le_u32(e, 0x48, 0x1000);
    uc.write_le_u32(e, 0x4C, 3);

    let is i64 as c with mut = CSE_PL_FOFF;
    // movabs r15, BSS
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0xBF); uc.write_le_u64(e, c+2, CSE_PL_BSS_VA); c = c + 10;

    if (mode == 2) {
        // dev_open(DEV_KEYBOARD=1, 0, 0); PollEntry.fd = returned fd
        e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
        e[c+3]=cast(u8,22); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;  // mov rax,22
        e[c+0]=cast(u8,0xBF); e[c+1]=cast(u8,1); e[c+2]=cast(u8,0); e[c+3]=cast(u8,0); e[c+4]=cast(u8,0); c = c + 5;  // mov edi,1
        e[c+0]=cast(u8,0x31); e[c+1]=cast(u8,0xF6); c = c + 2;                        // xor esi,esi
        e[c+0]=cast(u8,0x31); e[c+1]=cast(u8,0xD2); c = c + 2;                        // xor edx,edx
        e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;                        // syscall
        e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x00); c = c + 4;  // mov [r15+0],rax
    }
    // PollEntry.want = POLL_READABLE
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x08);
    e[c+4]=cast(u8,1); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); e[c+7]=cast(u8,0); c = c + 8;       // mov qword [r15+8],1
    // poll(r15, 1, timeout)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,34); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;      // mov rax,34
    e[c+0]=cast(u8,0x4C); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0xFF); c = c + 3;                 // mov rdi,r15
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC6);
    e[c+3]=cast(u8,1); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;       // mov rsi,1
    if (mode == 1) {
        // mov rdx, 100000000 (0x05F5E100) — finite 100ms deadline
        e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC2);
        e[c+3]=cast(u8,0x00); e[c+4]=cast(u8,0xE1); e[c+5]=cast(u8,0xF5); e[c+6]=cast(u8,0x05); c = c + 7;
    } else {
        // mov rdx, -1 — infinite
        e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC2);
        e[c+3]=cast(u8,0xFF); e[c+4]=cast(u8,0xFF); e[c+5]=cast(u8,0xFF); e[c+6]=cast(u8,0xFF); c = c + 7;
    }
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;                                        // syscall

    if (mode == 1) {
        // exit(5 + ret + got): clean timeout ⇒ ret 0, got 0 ⇒ 5
        e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x8B); e[c+2]=cast(u8,0x7F); e[c+3]=cast(u8,0x10); c = c + 4;  // mov rdi,[r15+16]
        e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0x01); e[c+2]=cast(u8,0xC7); c = c + 3;                        // add rdi,rax
        e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0x83); e[c+2]=cast(u8,0xC7); e[c+3]=cast(u8,5); c = c + 4;     // add rdi,5
    } else {
        // read(PollEntry.fd, r15+24, mode==2 ? 2 : 1)
        e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
        e[c+3]=cast(u8,10); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;  // mov rax,10
        e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x8B); e[c+2]=cast(u8,0x7F); e[c+3]=cast(u8,0x00); c = c + 4;  // mov rdi,[r15+0]
        e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x8D); e[c+2]=cast(u8,0x77); e[c+3]=cast(u8,0x18); c = c + 4;  // lea rsi,[r15+24]
        let is i64 as rdlen with mut = 1;
        if (mode == 2) { rdlen = 2; }
        e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC2);
        e[c+3]=cast(u8, rdlen); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;
        e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;                                    // syscall
        // exit(byte [r15+24])
        e[c+0]=cast(u8,0x41); e[c+1]=cast(u8,0x0F); e[c+2]=cast(u8,0xB6); e[c+3]=cast(u8,0x7F); e[c+4]=cast(u8,0x18); c = c + 5;
    }
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,3); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;        // mov rax,3
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;                                        // syscall

    let is i64 as text_size = c - CSE_PL_FOFF;
    uc.write_le_u32(e, 0x2C, text_size);
    uc.write_le_u32(e, 0x30, text_size);
    child_pl_len = c;
}

fn spawn_poll_smoke() as void {
    serial.println("userspace.poll_smoke: start", 27);

    // -- mode 0: park in poll (infinite), wake by a channel write --
    build_poll_child_cse(0);
    let is i64 as ko_a with mut = 0;
    let is i64 as ko_b with mut = 0;
    if (channel.channel_create(&ko_a, &ko_b) != cast(i32, 0)) {
        pmm.panic("poll_smoke: chan FAIL", 21);
    }
    let is i64 as child = userspace.proc_spawn(proc.root_proc, cast(*u8, &child_pl[0]), child_pl_len);
    if (child == 0) { pmm.panic("poll_smoke: spawn A FAIL", 24); }
    let is i64 as child_asp = proc.proc_aspace(child);
    kobject.ko_ref(ko_b);
    vma.fd_install(cast(*vma.Aspace, child_asp), 0, ko_b);
    userspace.proc_start(child);
    // Let the child reach and park inside sys_poll — the wakeup is then a
    // real unblock, not a lucky race.
    sched.sleep_for_ns(100000000);
    let is *kobject.KObject as ka = cast(*kobject.KObject, ko_a);
    let is [1]u8 as msg;
    msg[0] = cast(u8, 7);
    channel.chan_write(ka.priv, cast(i64, &msg[0]), 1);
    let is i64 as code = userspace.proc_wait(proc.root_proc, proc.proc_pid(child));
    kobject.ko_unref(ko_a);
    kobject.ko_unref(ko_b);
    if (code != 7) {
        serial.print("userspace.poll_smoke: wakeup exit=", 34);
        util.print_num(code);
        serial.println("", 0);
        pmm.panic("poll_smoke wakeup FAIL", 22);
    }
    serial.println("userspace.poll_smoke: wakeup PASS", 33);

    // -- mode 1: timeout expiry on a silent channel --
    build_poll_child_cse(1);
    let is i64 as ko_a2 with mut = 0;
    let is i64 as ko_b2 with mut = 0;
    if (channel.channel_create(&ko_a2, &ko_b2) != cast(i32, 0)) {
        pmm.panic("poll_smoke: chan2 FAIL", 22);
    }
    let is i64 as child2 = userspace.proc_spawn(proc.root_proc, cast(*u8, &child_pl[0]), child_pl_len);
    if (child2 == 0) { pmm.panic("poll_smoke: spawn B FAIL", 24); }
    let is i64 as child2_asp = proc.proc_aspace(child2);
    kobject.ko_ref(ko_b2);
    vma.fd_install(cast(*vma.Aspace, child2_asp), 0, ko_b2);
    userspace.proc_start(child2);
    let is i64 as code2 = userspace.proc_wait(proc.root_proc, proc.proc_pid(child2));
    kobject.ko_unref(ko_a2);
    kobject.ko_unref(ko_b2);
    if (code2 != 5) {
        serial.print("userspace.poll_smoke: timeout exit=", 35);
        util.print_num(code2);
        serial.println("", 0);
        pmm.panic("poll_smoke timeout FAIL", 23);
    }
    serial.println("userspace.poll_smoke: timeout PASS", 34);

    // -- mode 2: poll the keyboard device, wake by injection --
    build_poll_child_cse(2);
    let is i64 as child3 = userspace.proc_spawn(proc.root_proc, cast(*u8, &child_pl[0]), child_pl_len);
    if (child3 == 0) { pmm.panic("poll_smoke: spawn C FAIL", 24); }
    userspace.proc_start(child3);
    sched.sleep_for_ns(100000000);
    kbd.inject_event(9, 1);
    let is i64 as code3 = userspace.proc_wait(proc.root_proc, proc.proc_pid(child3));
    if (code3 != 9) {
        serial.print("userspace.poll_smoke: kbd exit=", 31);
        util.print_num(code3);
        serial.println("", 0);
        pmm.panic("poll_smoke kbd FAIL", 19);
    }
    serial.println("userspace.poll_smoke: kbd PASS", 30);
}
