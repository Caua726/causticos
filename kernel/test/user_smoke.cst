// user_smoke.cst — the ring-3 smoke gauntlet, run on its own kernel thread
// when the kernel boots with `smoke` on its command line (verify.sh does). It
// never launches /init, so a smoke boot and a real boot never interleave.
//
// The tests live by subject: mem_smoke (address spaces, threads, faults,
// segments), load_smoke (the ELF and CSE loaders), proc_smoke (processes,
// spawn from ring 3, argv, budgets, kill), fd_smoke (descriptors, channels,
// fd handoff, poll) and input_smoke (framebuffer, keyboard, mouse, tablet,
// grabs). ucode.cst holds the byte writers their hand-built images share.

use "driver.cst" as driver;
use "userspace.cst" as userspace;
use "mem_smoke.cst" as mem_smoke;
use "load_smoke.cst" as load_smoke;
use "proc_smoke.cst" as proc_smoke;
use "fd_smoke.cst" as fd_smoke;
use "input_smoke.cst" as input_smoke;

fn smoke_init() as void {
    userspace.wait_boot_ready();
    driver.enumerate_smoke();   // SYS_QUERY_DEVS backing: enumerate device instances
    mem_smoke.spawn_user_smoke();
    mem_smoke.spawn_user_fault_smoke();
    mem_smoke.vma_strict_smoke();
    mem_smoke.vma_split_smoke();
    mem_smoke.vma_tree_smoke();
    mem_smoke.spawn_user_reserve_fault_smoke();
    mem_smoke.spawn_user_commit_chunk_smoke();
    fd_smoke.fd_table_smoke();
    fd_smoke.fd_grow_smoke();
    fd_smoke.close_on_exit_smoke();
    load_smoke.spawn_user_elf_smoke();
    load_smoke.spawn_user_cse_smoke();
    input_smoke.spawn_user_fb_smoke();
    fd_smoke.spawn_channel_smoke();
    mem_smoke.thread_spawn_smoke();
    fd_smoke.spawn_fdacts_smoke();
    input_smoke.spawn_kbd_smoke();
    input_smoke.spawn_mouse_smoke();
    input_smoke.spawn_tablet_smoke();
    proc_smoke.spawn_user_proc_smoke();
    proc_smoke.spawn_user_syscall_smoke();
    proc_smoke.spawn_argv_smoke();
    proc_smoke.spawn_budget_smoke();
    proc_smoke.spawn_budget_ring3_smoke();
    mem_smoke.spawn_seg_share_smoke();
    fd_smoke.poll_unit_smoke();
    fd_smoke.spawn_poll_smoke();
    input_smoke.grab_smoke();
    proc_smoke.spawn_kill_smoke();
}
