// smoke.cst — MMIO + IRQ smoke tests, decoupled from any particular driver.
//
// Previously these were inlined into dummy_probe; moving them out gives
// dummybus.cst a single responsibility (being a synthetic bus for the
// framework) and lets the smoke runner own per-device state via Hardware.private.

use "driver.cst" as driver;
use "heap.cst" as heap;
use "serial.cst" as serial;
use "util.cst" as util;
use "io.cst" as io;

// Per-device smoke state. Allocated by setup_state and stashed in
// dev.private; irq_handler reads it back from the same field.
struct SmokeState {
    irq_hit_count as i64;
    mmio_done as i32;
    irq_done as i32;
}

fn setup_state(dev as *driver.Hardware) as *SmokeState {
    if (cast(i64, dev.private) != 0) {
        return cast(*SmokeState, dev.private);
    }
    let is i64 as addr = heap.kmalloc(sizeof(SmokeState), 0);
    if (addr == 0) { return cast(*SmokeState, 0); }
    let is *SmokeState as s = cast(*SmokeState, addr);
    s.irq_hit_count = 0;
    s.mmio_done = 0;
    s.irq_done = 0;
    dev.private = cast(*u8, addr);
    return s;
}

fn irq_handler(dev as *driver.Hardware, ctx as *u8) as i32 {
    let is *SmokeState as s = cast(*SmokeState, dev.private);
    if (cast(i64, s) != 0) { s.irq_hit_count = s.irq_hit_count + 1; }
    return 0;  // HANDLED
}

// Exercises the framework's mmio_map primitive by mapping the LAPIC base
// (0xFEE00000) uncached and reading its APIC ID register.
fn run_mmio(dev as *driver.Hardware) as void {
    let is *SmokeState as s = setup_state(dev);
    if (cast(i64, s) == 0 || s.mmio_done == 1) { return; }
    s.mmio_done = 1;

    serial.println("smoke: calling mmio_map...", 26);
    let is *u8 as lapic_virt with mut = cast(*u8, 0);
    let is i32 as rc = driver.mmio_map(dev, cast(u64, 0xFEE00000),
                                       cast(u64, 4096), cast(u32, 0),
                                       &lapic_virt);
    serial.print("smoke: mmio_map rc=", 19);
    util.print_num(cast(i64, rc));
    serial.println("", 0);
    if (rc != driver.OK) { return; }

    serial.print("smoke: lapic vaddr=", 19);
    util.print_hex(cast(i64, lapic_virt));
    serial.println("", 0);
    let is *u32 as id_reg = cast(*u32, cast(i64, lapic_virt) + 0x20);
    let is u32 as raw = *id_reg;
    serial.print("smoke: lapic id=", 16);
    util.print_num(cast(i64, raw) >> 24);
    serial.println("", 0);
}

// Exercises the framework's irq_register dispatch path by registering a
// handler on vector 48 and firing `int 0x30` in software.
fn run_irq(dev as *driver.Hardware) as void {
    let is *SmokeState as s = setup_state(dev);
    if (cast(i64, s) == 0 || s.irq_done == 1) { return; }
    s.irq_done = 1;

    let is i32 as rc = driver.irq_register(dev, cast(u32, 48), cast(i32, 0),
                                           fn_ptr(irq_handler),
                                           cast(*u8, 0));
    serial.print("smoke: irq_register rc=", 23);
    util.print_num(cast(i64, rc));
    serial.println("", 0);
    if (rc != driver.OK) { return; }

    serial.println("smoke: firing int 0x30...", 25);
    asm("int 0x30\n");
    serial.println("smoke: int 0x30 returned", 24);
    serial.print("smoke: irq_hit_count=", 21);
    util.print_num(s.irq_hit_count);
    serial.println("", 0);
}

// ============================================================
// io.cst smoke test — fake block provider that completes inline.
//
// Exercises the framework-owned queue. submit_io stashes the request
// in a per-provider "hw queue" (just a single slot here); harvest_io
// pops it and hands it back. No real hardware, no real IRQs — this
// validates the framework's push/pop/state transitions end-to-end
// before AHCI lands.
// ============================================================

struct FakeState {
    slot as *io.BlockRequest;   // single-slot "hardware queue"
    // done is i64 (was i32). Caustic miscompiles a 32-bit scalar
    // followed by a nested struct — the embedded provider's
    // function-pointer fields end up at the wrong offset depending
    // on the access path, which manifested as `call rax` jumping
    // to garbage on -smp 4.
    done as i64;
    provider as io.BlockIOProvider;
}

fn fake_submit(p as *io.BlockIOProvider, r as *io.BlockRequest) as i32 {
    let is *FakeState as f = cast(*FakeState, p.private);
    if (cast(i64, f.slot) != 0) { return driver.DEVICE_BUSY; }
    f.slot = r;
    r.status = 0;
    return 0;
}

fn fake_harvest(p as *io.BlockIOProvider, out as **io.BlockRequest) as i32 {
    let is *FakeState as f = cast(*FakeState, p.private);
    if (cast(i64, f.slot) == 0) { *out = cast(*io.BlockRequest, 0); return 0; }
    *out = f.slot;
    f.slot = cast(*io.BlockRequest, 0);
    return 1;
}

fn run_io(dev as *driver.Hardware) as void {
    let is *SmokeState as s = setup_state(dev);
    if (cast(i64, s) == 0) { return; }
    if (s.irq_hit_count < 0) { return; }  // placeholder; no io_done field yet
    // Run once per device using irq_done as a convenient guard; safe because
    // run_irq runs before run_io and flipping the flag doesn't affect anything.
    if (s.irq_done != 1) { return; }
    // Use mmio_done as the io-already-ran guard (it starts cleared after irq).
    // Actually use a different approach: allocate FakeState once and key off it.

    let is i64 as addr = heap.kmalloc(sizeof(FakeState), 0);
    if (addr == 0) { return; }
    let is *FakeState as f = cast(*FakeState, addr);
    f.slot = cast(*io.BlockRequest, 0);
    f.done = 0;
    f.provider.device = dev;
    f.provider.submit_io = fn_ptr(fake_submit);
    f.provider.harvest_io = fn_ptr(fake_harvest);
    f.provider.private = cast(*u8, f);
    f.provider.pending_head = cast(*io.BlockRequest, 0);
    f.provider.pending_count = 0;
    f.provider.next = cast(*io.BlockIOProvider, 0);

    if (io.register(&f.provider) != driver.OK) {
        serial.println("smoke.io: register failed", 25);
        return;
    }

    // Submit a fake read and harvest it. This bypasses read_sync to
    // avoid the wait/wake primitive until AHCI exercises it with real IRQs.
    let is i64 as buf_addr = heap.kmalloc(512, 0);
    if (buf_addr == 0) { return; }
    let is *u8 as buf = cast(*u8, buf_addr);
    let is *io.BlockRequest as r = io.new_request(io.OP_READ, 0, 1024, 1, buf);
    if (cast(i64, r) == 0) { heap.kfree(buf_addr); return; }

    let is i32 as rc = io.submit(&f.provider, r);
    serial.print("smoke.io: submit rc=", 20);
    util.print_num(cast(i64, rc));
    serial.println("", 0);

    let is i64 as harvested = io.harvest_all(&f.provider);
    serial.print("smoke.io: harvested=", 20);
    util.print_num(harvested);
    serial.println("", 0);

    serial.print("smoke.io: req.state=", 20);
    util.print_num(r.state);
    serial.println("", 0);

    io.free_request(r);
    heap.kfree(buf_addr);
}
