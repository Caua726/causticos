// platform_bus.cst — synthetic bus for legacy/on-board devices that
// aren't on a discoverable bus like PCI. Today: kbd (PS/2).
// Enumerates a small fixed set of Hardware nodes so the spec framework
// can match + bind them the same way it does PCI.

use "driver.cst" as driver;
use "serial.cst" as serial;

let is driver.Bus as platform_bt;
let is driver.BusNode as platform_bi;

// Platform devices are identified by their Hardware.name. get_match_field
// is not used — MATCH_NAME/MATCH_BUS go through name32_eq_bytes in spec.cst
// and never dispatch here. Provide a stub that returns -1 for scalar
// predicates so a spec that accidentally asks for vendor/device on a
// platform device fails cleanly.
fn platform_get_match_field(hw as *driver.Hardware, kind as i64) as i64 {
    return cast(i64, 0 - 1);
}

// Platform devices have hardcoded IRQ lines by device name. Today only
// kbd (IRQ 1) exists; extend as more devices arrive. Returning -1 makes
// the spec framework fall back to whatever irq: N the .cdvrspec declares.
fn platform_get_irq_line(hw as *driver.Hardware) as i64 {
    // name "kbd" → IRQ 1
    if (hw.name[0] == cast(u8, 107)) {
        if (hw.name[1] == cast(u8, 98)) {
            if (hw.name[2] == cast(u8, 100)) { return 1; }
        }
    }
    return cast(i64, 0 - 1);
}

fn platform_enumerate(bi as *driver.BusNode) as void {
    serial.println("platform: enumerate", 19);
    // Single child: "kbd"
    let is *driver.Hardware as kbd = driver.hardware_alloc(sizeof(driver.Hardware), 8);
    if (cast(i64, kbd) == 0) {
        serial.println("platform: hardware_alloc failed", 30);
        return;
    }
    // Name: "kbd"
    kbd.name[0] = cast(u8, 107);    // 'k'
    kbd.name[1] = cast(u8, 98);     // 'b'
    kbd.name[2] = cast(u8, 100);    // 'd'
    let is i32 as rc = driver.hardware_register(kbd, cast(*driver.Hardware, bi));
    if (rc != driver.OK) {
        serial.println("platform: hardware_register failed", 33);
    }
}

fn register() as void {
    // Bus name "platform"
    platform_bt.name[0] = cast(u8, 112);    // 'p'
    platform_bt.name[1] = cast(u8, 108);    // 'l'
    platform_bt.name[2] = cast(u8, 97);     // 'a'
    platform_bt.name[3] = cast(u8, 116);    // 't'
    platform_bt.name[4] = cast(u8, 102);    // 'f'
    platform_bt.name[5] = cast(u8, 111);    // 'o'
    platform_bt.name[6] = cast(u8, 114);    // 'r'
    platform_bt.name[7] = cast(u8, 109);    // 'm'
    platform_bt.enumerate_node = fn_ptr(platform_enumerate);
    platform_bt.get_match_field = fn_ptr(platform_get_match_field);
    platform_bt.get_irq_line = fn_ptr(platform_get_irq_line);
    driver.bus_register(&platform_bt);

    platform_bi.base.bus = &platform_bt;
    platform_bi.base.name[0] = cast(u8, 112);    // 'p'
    platform_bi.base.name[1] = cast(u8, 108);    // 'l'
    platform_bi.base.name[2] = cast(u8, 97);     // 'a'
    platform_bi.base.name[3] = cast(u8, 116);    // 't'
    platform_bi.base.name[4] = cast(u8, 48);     // '0'
    driver.bus_node_register(&platform_bi, driver.get_root());

    serial.println("platform: registered", 20);
}
