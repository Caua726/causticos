// fb.cst — Framebuffer rendering

use "limine.cst" as limine;
use "../font/font8x8.cst" as font;
use "serial.cst" as serial;
use "util.cst" as util;
use "pmm.cst" as pmm;

// ============================================================
// Module state
// ============================================================

let is i64 as fb_addr with mut = 0;       // virtual addr we draw through (Limine HHDM today)
let is i64 as fb_phys with mut = 0;       // physical scanout base (for an explicit WC remap, 1b-PAT)
let is i64 as fb_width with mut = 0;
let is i64 as fb_height with mut = 0;
let is i64 as fb_pitch with mut = 0;
let is i64 as fb_bpp_bytes with mut = 4;  // bytes per pixel = bpp / 8 (read from Limine, not assumed)

// ============================================================
// Functions
// ============================================================

fn init(fb as *limine.LimineFramebuffer) as void {
    fb_addr = cast(i64, fb.address);
    fb_width = fb.width;
    fb_height = fb.height;
    fb_pitch = fb.pitch;

    // Read the real pixel depth instead of assuming 32bpp. Drawing still
    // packs a 32-bit pixel; warn (don't pretend) on anything else.
    let is i64 as bpp with mut = limine.fb_bpp(fb);
    if (bpp == 0) { bpp = 32; }
    fb_bpp_bytes = bpp / 8;
    if (bpp != 32) {
        serial.print("fb: WARNING bpp=", 16);
        util.print_num(bpp);
        serial.println(" (renderer assumes 32)", 22);
    }

    // Limine hands a higher-half HHDM virtual address; recover the physical
    // scanout base so 1b-PAT can map it explicitly with write-combining.
    // Defensive: if it's already a raw physical (below the HHDM window),
    // keep it as-is.
    if (fb_addr >= pmm.hhdm) { fb_phys = fb_addr - pmm.hhdm; }
    else                     { fb_phys = fb_addr; }
}

// Scanout geometry — the surface object (KOBJ_SURFACE) reads these to size
// its backbuffer and blit on present.
fn scanout_virt() as i64 { return fb_addr; }
fn scanout_phys() as i64 { return fb_phys; }
fn width() as i64        { return fb_width; }
fn height() as i64       { return fb_height; }
fn pitch() as i64        { return fb_pitch; }
fn bpp_bytes() as i64    { return fb_bpp_bytes; }

fn put_pixel(x as i64, y as i64, color as i32) as void {
    if (x < 0) { return; }
    if (y < 0) { return; }
    if (x >= fb_width) { return; }
    if (y >= fb_height) { return; }
    let is i64 as offset = y * fb_pitch + x * fb_bpp_bytes;
    let is *i32 as pixel = cast(*i32, fb_addr + offset);
    pixel[0] = color;
}

fn draw_char(ch as i32, cx as i64, cy as i64, color as i32) as void {
    let is *u8 as glyph = font.get_glyph(ch);
    let is i64 as row with mut = 0;
    while (row < 8) {
        let is i64 as bits = cast(i64, glyph[row]);
        let is i64 as col with mut = 0;
        while (col < 8) {
            // MSB = leftmost pixel: bit 7 is col 0, bit 6 is col 1, etc.
            let is i64 as mask = 128 >> col;
            if ((bits & mask) != 0) {
                put_pixel(cx + col, cy + row, color);
            }
            col = col + 1;
        }
        row = row + 1;
    }
}

fn print(str as *u8, len as i64, x as i64, y as i64, color as i32) as void {
    let is i64 as i with mut = 0;
    while (i < len) {
        let is i32 as ch = cast(i32, str[i]);
        draw_char(ch, x + i * 8, y, color);
        i = i + 1;
    }
}

fn clear(color as i32) as void {
    let is i64 as y with mut = 0;
    while (y < fb_height) {
        let is i64 as x with mut = 0;
        while (x < fb_width) {
            let is i64 as offset = y * fb_pitch + x * fb_bpp_bytes;
            let is *i32 as pixel = cast(*i32, fb_addr + offset);
            pixel[0] = color;
            x = x + 1;
        }
        y = y + 1;
    }
}
