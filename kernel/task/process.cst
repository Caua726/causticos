// process.cst — Process model: Process ≠ Thread.
//
// A Process is the OS's unit of isolation + ownership: it owns one
// address space (*vma.Aspace — memory + the fd table = its authority)
// plus identity (pid), lineage (parent/children), and lifecycle
// (state, exit_code). A user process owns >=1 Thread; the Thread is the
// schedulable execution unit and points back here via its process_ptr slot.
//
// causticos identity: "tudo é uma chave" — a process IS the set of
// handles (fds) it holds, and that set lives in its Aspace's fd table.
// Authority is never ambient: a child inherits nothing by default; the
// spawner installs explicitly. This file is pure mechanism (the object
// + tree + lifecycle state). Image loading + thread creation live in the
// spawn orchestration (userspace.cst), and resource reclamation (reap)
// is driven from there too — keeping this module free of sched/vma/loader
// imports and the import cycles they'd close.
//
// Speculative scaffolding from the old v1 spec (refcounted Limit,
// capability bitsets, a separate HandleTable) is intentionally gone: the
// fd table already lives in the Aspace, and limits/caps land only when a
// real workload forces them.

use "serial.cst" as serial;
use "pmm.cst" as pmm;
use "heap.cst" as heap;
use "util.cst" as util;
use "timer.cst" as timer;
use "abi.cst" as abi;
use "lock.cst" as lock;

// ============================================================
// Process states
// ============================================================
let is i64 as PROC_ALIVE   = 1;
let is i64 as PROC_EXITING = 2;   // exit() entered; thread not yet off-cpu
let is i64 as PROC_ZOMBIE  = 3;   // dead, exit_code valid, awaiting wait()
let is i64 as PROC_DEAD    = 4;   // collected; struct about to be freed

// Flags
let is i64 as FLAG_ROOT   = 1;    // pid 0: kernel tree root, cannot exit
let is i64 as FLAG_ORPHAN = 2;    // reparented to the root when its parent exited
                                  // nobody will wait() for it, so the kernel reaper does
let is i64 as FLAG_FAULTED = 4;   // ended by a CPU exception in ring 3; the fault_*
                                  // fields say which (an exit(139) is not a crash)

// ============================================================
// Process struct (160 bytes). Raw-offset accessors (same style the
// scheduler uses for Thread) — no struct decl so the layout is explicit.
// ============================================================
// 0    pid              i64
// 8    parent           i64   (*Process; 0 = no parent / kernel root)
// 16   first_child      i64   (*Process)
// 24   next_sibling     i64   (*Process)
// 32   prev_sibling     i64   (*Process)
// 40   state            i64   (PROC_*)
// 48   exit_code        i64   (valid once ZOMBIE)
// 56   aspace           i64   (*vma.Aspace; 0 for the kernel root)
// 64   first_tid        i64   (main thread tid; -1 = none)
// 72   thread_count     i64
// 80   create_time      i64   (ns)
// 88   flags            i64   (FLAG_*)
// 96   collected        i64   (1 once wait() has returned this child's status)
// 104  reap_done        i64   (1 once the deferred reaper freed thread resources)
// 112  name             16 bytes (argv[0] display label, NUL-terminated)
// 128  fault_vector     i64   (the CPU exception that ended it; valid when
// 136  fault_err        i64    flags has FLAG_FAULTED)
// 144  fault_rip        i64
// 152  fault_addr       i64   (cr2 for a page fault, else 0)
// Total: 160
let is i64 as PROC_SIZE = 160;
// Typed pool (Phase B sub-phase 2). Created lazily on first use under heap_lock.
let is i64 as proc_pool with mut = 0;

// PID counter — monotonic, never reused. The kernel root takes pid 0;
// the first user process takes pid 1.
let is i64 as next_pid with mut = 0;

let is i64 as root_proc with mut = 0;

// Child-exit hook, wired by main.cst to eventfd.event_post. Kept as a raw
// fn-pointer (0 until wired) so process.cst carries no eventfd import edge —
// the same composition trick main uses for the syscall dispatch table.
let is i64 as event_post_fn with mut = 0;

fn proc_get(proc as i64, off as i64) as i64 {
    let is *i64 as p = cast(*i64, proc + off);
    return p[0];
}
fn proc_set(proc as i64, off as i64, v as i64) as void {
    let is *i64 as p = cast(*i64, proc + off);
    p[0] = v;
}

fn proc_pid(proc as i64) as i64          { return proc_get(proc, 0); }
fn proc_parent(proc as i64) as i64       { return proc_get(proc, 8); }
fn proc_first_child(proc as i64) as i64  { return proc_get(proc, 16); }
fn proc_next_sib(proc as i64) as i64     { return proc_get(proc, 24); }
fn proc_prev_sib(proc as i64) as i64     { return proc_get(proc, 32); }
fn proc_state(proc as i64) as i64        { return proc_get(proc, 40); }
fn proc_exit_code(proc as i64) as i64    { return proc_get(proc, 48); }
fn proc_aspace(proc as i64) as i64       { return proc_get(proc, 56); }
fn proc_first_tid(proc as i64) as i64    { return proc_get(proc, 64); }
fn proc_thread_count(proc as i64) as i64 { return proc_get(proc, 72); }
fn proc_flags(proc as i64) as i64        { return proc_get(proc, 88); }
fn proc_collected(proc as i64) as i64    { return proc_get(proc, 96); }
fn proc_reap_done(proc as i64) as i64    { return proc_get(proc, 104); }

// Atomic: threads of one process start and leave on different cpus at once,
// and "was I the last one out?" must have exactly one yes.
fn proc_inc_threads(proc as i64) as void {
    lock.atomic_add(cast(*i64, proc + 72), 1);
}
// Returns the count AFTER the decrement.
fn proc_dec_threads(proc as i64) as i64 {
    return lock.atomic_add(cast(*i64, proc + 72), 0 - 1) - 1;
}

// A crash, as the CPU reported it. Recorded by lifecycle.terminate_fault
// as the exit begins, so the parent's wait can say why.
fn proc_set_fault(proc as i64, vector as i64, err as i64, rip as i64, addr as i64) as void {
    proc_set(proc, 88, proc_flags(proc) | FLAG_FAULTED);
    proc_set(proc, 128, vector);
    proc_set(proc, 136, err);
    proc_set(proc, 144, rip);
    proc_set(proc, 152, addr);
}

fn proc_set_state(proc as i64, v as i64) as void     { proc_set(proc, 40, v); }
fn proc_set_aspace(proc as i64, v as i64) as void    { proc_set(proc, 56, v); }
fn proc_set_first_tid(proc as i64, v as i64) as void { proc_set(proc, 64, v); }
fn proc_set_reap_done(proc as i64, v as i64) as void { proc_set(proc, 104, v); }

// ============================================================
// Display name (Process+112, 16 bytes, NUL-terminated). A label for
// ps/top — DATA, never authority. The kernel guarantees it is ALWAYS
// non-empty: a process with no declared name still appears AS such (a
// visible placeholder) rather than as a blank row that hides it. The
// real label (argv[0]) is written later by the spawn path when present.
// ============================================================

// Overwrite the name with a kernel-chosen placeholder so no process is
// ever nameless on screen. FLAG_ROOT (pid 0) gets "kernel"; everything else
// gets "proc<pid>" (e.g. "proc7"). The spawn path overrides this with
// argv[0] when the spawner supplied one.
fn proc_set_name_default(proc as i64, pid as i64, flags as i64) as void {
    let is *u8 as nm = cast(*u8, proc + 112);
    if ((flags & FLAG_ROOT) != 0) {
        nm[0] = cast(u8, 107); nm[1] = cast(u8, 101);   // k e
        nm[2] = cast(u8, 114); nm[3] = cast(u8, 110);   // r n
        nm[4] = cast(u8, 101); nm[5] = cast(u8, 108);   // e l
        nm[6] = cast(u8, 0);
        return;
    }
    // "proc" + decimal pid, truncated to fit the 15-char body.
    nm[0] = cast(u8, 112); nm[1] = cast(u8, 114);       // 'p' 'r'
    nm[2] = cast(u8, 111); nm[3] = cast(u8, 99);        // 'o' 'c'
    let is i64 as w with mut = 4;
    // Render the pid decimal into a small reversed buffer, then copy it in.
    let is [16]u8 as dig;
    let is i64 as nd with mut = 0;
    let is i64 as v with mut = pid;
    if (v < 0) { v = 0; }
    if (v == 0) { dig[0] = cast(u8, 48); nd = 1; }
    else {
        while (v > 0) {
            dig[nd] = cast(u8, 48 + (v - (v / 10) * 10));   // '0' + (v % 10)
            nd = nd + 1;
            v = v / 10;
        }
    }
    let is i64 as di with mut = nd - 1;
    while (di >= 0) {
        if (w < 15) { nm[w] = dig[di]; w = w + 1; }
        di = di - 1;
    }
    nm[w] = cast(u8, 0);
}

// ============================================================
// Hierarchy. Every link in the tree, and every state transition, is made
// under tree_lock: spawns, exits, waits and the proc_list snapshot run on
// different cpus at once, and an unlocked walk could follow a sibling pointer
// into a Process being freed. A plain spinlock — every section is a few
// pointer moves, never a sleep.
// ============================================================

let is lock.TicketLock as tree_lk with mut;

fn tree_lock() as void   { lock.acquire(&tree_lk); }
fn tree_unlock() as void { lock.release(&tree_lk); }

fn add_child(parent as i64, child as i64) as void {
    proc_set(child, 8, parent);                 // child.parent = parent
    let is i64 as old_first = proc_first_child(parent);
    proc_set(child, 24, old_first);             // child.next_sibling = old first
    proc_set(child, 32, 0);                     // child.prev_sibling = null
    if (old_first != 0) {
        proc_set(old_first, 32, child);         // old_first.prev_sibling = child
    }
    proc_set(parent, 16, child);                // parent.first_child = child
}

fn remove_child(parent as i64, child as i64) as void {
    let is i64 as prev = proc_prev_sib(child);
    let is i64 as next = proc_next_sib(child);
    if (prev != 0) {
        proc_set(prev, 24, next);
    } else {
        proc_set(parent, 16, next);             // child was first
    }
    if (next != 0) {
        proc_set(next, 32, prev);
    }
    proc_set(child, 24, 0);
    proc_set(child, 32, 0);
}

// Orphans go to the kernel root (pid 0). Its orphan reaper collects exactly
// the FLAG_ORPHAN children; direct kernel children (boot spawn and smokes)
// are waited for by whoever spawned them. Caller holds tree_lock.
fn reparent_children_to_root(proc as i64) as void {
    let is i64 as child with mut = proc_first_child(proc);
    while (child != 0) {
        let is i64 as next = proc_next_sib(child);
        remove_child(proc, child);
        add_child(root_proc, child);
        proc_set(child, 88, proc_flags(child) | FLAG_ORPHAN);
        child = next;
    }
}

// ============================================================
// Lifecycle
// ============================================================

// Create a Process around an already-built address space (aspace = 0 for
// the kernel root). Adds it under `parent` (0 = no parent).
// Returns the Process pointer (as i64), or 0 on alloc failure.
fn process_create(parent as i64, aspace as i64, flags as i64) as i64 {
    let is i64 as proc = heap.kpool_alloc_ensure(cast(i64, &proc_pool), PROC_SIZE, 1);
    if (proc == 0) { return 0; }
    let is *u8 as zp = cast(*u8, proc);
    let is i64 as zi with mut = 0;
    while (zi < PROC_SIZE) { zp[zi] = 0; zi = zi + 1; }

    let is i64 as pid = next_pid;
    next_pid = next_pid + 1;

    proc_set(proc, 0, pid);                     // pid
    proc_set(proc, 40, PROC_ALIVE);             // state
    proc_set(proc, 56, aspace);                 // aspace
    proc_set(proc, 64, 0 - 1);                  // first_tid = none
    proc_set(proc, 72, 0);                      // thread_count
    proc_set(proc, 80, timer.current_time_ns());// create_time
    proc_set(proc, 88, flags);                  // flags

    // Always give the process a visible name. The spawn path overwrites this
    // with argv[0] when supplied; otherwise the placeholder ("kernel" for the
    // root, "proc<pid>" for user processes) keeps the process from showing as
    // a blank row in ps.
    proc_set_name_default(proc, pid, flags);

    if (parent != 0) {
        tree_lock();
        add_child(parent, proc);
        tree_unlock();
    }

    serial.print("proc: created pid=", 18);
    util.print_num(pid);
    serial.println("", 0);
    return proc;
}

// Bind the main thread to a process (called by the spawn orchestration
// right after create_user_thread_ex has set the thread's process_ptr).
fn attach_main_thread(proc as i64, tid as i64) as void {
    proc_set(proc, 64, tid);                    // first_tid
    proc_inc_threads(proc);
}

// Exit is two steps, because a process with several threads finishes leaving
// only when its last thread does (see lifecycle.cst):
//
//   begin_exit   ALIVE -> EXITING, recording the code. The FIRST code stands:
//                a process killed while it was calling exit reports whichever
//                happened first, never a mix.
//   finish_exit  EXITING -> ZOMBIE, by the last thread out once the fd table is
//                drained: children go to the kernel root; subscribers hear.
//
// begin_exit returns 1 if this call started the exit, 0 if it was already on
// its way (or gone).
fn begin_exit(proc as i64, code as i64) as i64 {
    if (proc == 0) { return 0; }
    tree_lock();
    let is i64 as r = begin_exit_locked(proc, code);
    tree_unlock();
    return r;
}

// The same, for a caller already holding tree_lock.
fn begin_exit_locked(proc as i64, code as i64) as i64 {
    if ((proc_flags(proc) & FLAG_ROOT) != 0) {
        pmm.panic("kernel root exited", 18);
    }
    if (proc_state(proc) != PROC_ALIVE) { return 0; }
    proc_set(proc, 48, code);                   // exit_code
    proc_set(proc, 40, PROC_EXITING);
    return 1;
}

fn finish_exit(proc as i64) as void {
    if (proc == 0) { return; }
    tree_lock();
    if (proc_state(proc) != PROC_EXITING) {
        tree_unlock();
        return;
    }
    reparent_children_to_root(proc);
    proc_set(proc, 40, PROC_ZOMBIE);
    let is i64 as parent = proc_get(proc, 8);
    let is i64 as parent_pid with mut = 0;
    if (parent != 0) { parent_pid = proc_pid(parent); }
    let is i64 as pid = proc_pid(proc);
    let is i64 as code = proc_exit_code(proc);
    tree_unlock();

    // Signal-replacement: post {child pid, EVENT_EXIT, code} to the parent's
    // event subscribers. No-op before main wires event_post_fn (early boot).
    // Outside the tree lock: posting wakes pollers through the scheduler.
    if (parent != 0) {
        if (event_post_fn != 0) {
            let is fn(i64,i64,i64,i64) as void as fp =
                cast(fn(i64,i64,i64,i64) as void, event_post_fn);
            call(fp, parent_pid, pid, abi.EVENT_EXIT, code);
        }
    }
}

// Find a child of `parent` by pid, in ANY state. The pointer is only good
// while the caller keeps the child from being collected; the kill path does
// its whole job under tree_lock instead (lifecycle.terminate_descendant).
fn find_child(parent as i64, pid as i64) as i64 {
    tree_lock();
    let is i64 as child with mut = proc_first_child(parent);
    while (child != 0) {
        if (proc_pid(child) == pid) { tree_unlock(); return child; }
        child = proc_next_sib(child);
    }
    tree_unlock();
    return 0;
}

// Detach a (zombie) child from the parent tree and free the Process
// struct. Caller has already collected exit_code and reclaimed the
// child's thread + aspace (see the spawn/reap path). Marks DEAD first so
// a racing scanner never sees a half-freed struct as a zombie.
fn process_free(parent as i64, child as i64) as void {
    tree_lock();
    proc_set(child, 40, PROC_DEAD);
    remove_child(proc_parent(child), child);
    tree_unlock();
    heap.kpool_free(proc_pool, child);
}

// Claim a zombie child for collection: the first caller to find it marks it
// collected under the lock, so two threads of one parent waiting at once can
// never both tear the same child down. `ready` decides whether a found zombie
// may be taken yet (its threads must all be off-cpu) — it is called under the
// tree lock, so it must not sleep. Returns the child, or 0.
fn claim_zombie_child(parent as i64, pid as i64, ready as i64) as i64 {
    tree_lock();
    let is i64 as child with mut = proc_first_child(parent);
    while (child != 0) {
        if (proc_state(child) == PROC_ZOMBIE && proc_collected(child) == 0) {
            if (pid <= 0 || proc_pid(child) == pid) {
                let is fn(i64) as i64 as rf = cast(fn(i64) as i64, ready);
                if (call(rf, child) != 0) {
                    proc_set(child, 96, 1);     // collected
                    tree_unlock();
                    return child;
                }
            }
        }
        child = proc_next_sib(child);
    }
    tree_unlock();
    return 0;
}

// Is an orphan zombie of `parent` still waiting to be collected? The orphan
// reaper polls while one is, and parks when none is.
fn has_orphan_zombie(parent as i64) as i64 {
    tree_lock();
    let is i64 as child with mut = proc_first_child(parent);
    while (child != 0) {
        if (proc_state(child) == PROC_ZOMBIE && proc_collected(child) == 0
            && (proc_flags(child) & FLAG_ORPHAN) != 0) {
            tree_unlock();
            return 1;
        }
        child = proc_next_sib(child);
    }
    tree_unlock();
    return 0;
}

// Is there a child matching pid at all (in any state)? wait() uses it to
// tell "nothing to wait for" from "not exited yet".
fn has_child(parent as i64, pid as i64) as i64 {
    tree_lock();
    let is i64 as child with mut = proc_first_child(parent);
    while (child != 0) {
        if (proc_collected(child) == 0 && (pid <= 0 || proc_pid(child) == pid)) {
            tree_unlock();
            return 1;
        }
        child = proc_next_sib(child);
    }
    tree_unlock();
    return 0;
}

// ============================================================
// Init
// ============================================================

fn init() as void {
    serial.println("proc: init", 10);
    // proc_pool is created lazily on the first process_create (kpool_alloc_ensure).

    // Kernel ownership and orphan collection live under pid 0. It has no
    // user address space; proc_list represents it with real kernel accounting.
    root_proc = process_create(0, 0, FLAG_ROOT);

    serial.print("  root pid=", 11);
    util.print_num(proc_pid(root_proc));
    serial.println("", 0);
    serial.println("proc: ready", 11);
}
