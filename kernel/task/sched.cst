// sched.cst — the scheduler: thread creation, sleep and wakeup, poll parking,
// load balancing, schedule() and the timer tick, idle, and kill delivery.
// Built on thread.cst (the thread record), runq.cst (the per-cpu run
// queues), qos.cst (EEVDF, deadline and anti-abuse policy) and fpu.cst (lazy
// FPU state); tlb.cst sits above it. Based on causticos_sched_spec_v1.
//
// Locking. Every cpu has its own run queue — QoS bands, deadline tree, counters
// — under its own irq-safe spinlock (per_cpu_sched_locks). schedule() on a cpu
// holds that cpu's lock; a wakeup, kill or QoS change takes the lock of the
// thread's home cpu through lock_home(), which follows a thread that a balancing
// cpu moved meanwhile. Two run-queue locks are only ever held together by
// steal_work, lower cpu first. Order: run-queue lock > tid_lock > heap_lock;
// tlb_lock is taken with no run-queue lock held.

use "serial.cst" as serial;
use "pmm.cst" as pmm;
use "heap.cst" as heap;
use "timer.cst" as timer;
use "util.cst" as util;
use "rbtree.cst" as rb;
use "lapic.cst" as lapic;
use "smp.cst" as smp;
use "lock.cst" as lock;
use "vmm.cst" as vmm;
use "gdt.cst" as gdt;
use "syscall.cst" as sysc;
use "thread.cst" as thread;
use "runq.cst" as runq;
use "qos.cst" as qos;
use "fpu.cst" as fpu;

// ============================================================
// Termination — the scheduler's half of the request thread.cst describes at
// thr_kill_pending: whether the running thread was asked, and making a thread
// that was asked get to a boundary where it can act on it.
// ============================================================
fn kill_requested() as i64 {
    let is i64 as tid = runq.current_tid();
    if (tid < 0) { return 0; }
    return thread.thr_get(tid, thread.THR_KILL);
}

// Mark `tid` for termination and make sure it gets to a boundary promptly:
//   SUSPENDED (created, never started) → started, so its trampoline sees the flag
//   SLEEPING interruptibly             → woken; the sleep returns "killed"
//   RUNNING on another cpu             → an interrupt, whose return to ring 3
//                                        checks the flag (a pure user spin has
//                                        no other way out)
//   RUNNABLE, or RUNNING right here    → nothing; it reaches a boundary itself
// The state is read under the thread's run-queue lock — the lock its own sleep
// takes to check the flag — so a sleeper either saw the flag and did not sleep,
// or is SLEEPING with intr_sleep set by the time we look.
fn kill_kick(tid as i64) as void {
    if (thread.thread_ptr(tid) == 0) { return; }
    thread.thr_set(tid, thread.THR_KILL, 1);
    let is i64 as cpu with mut = 0;
    let is i64 as f = runq.lock_home(tid, &cpu);
    let is i64 as st = thread.thr_state(tid);
    let is i64 as intr = thread.thr_get(tid, thread.THR_INTR_SLEEP);
    let is i64 as lapic_id with mut = 0 - 1;
    if (st == thread.THREAD_RUNNING && cpu != runq.this_cpu()) {
        let is *smp.PerCpu as pc = smp.get_per_cpu(cpu);
        if (cast(i64, pc) != 0) { lapic_id = pc.lapic_id; }
    }
    lock.release_irq(runq.sched_lock_ptr(cpu), f);
    if (st == thread.THREAD_SUSPENDED) { make_runnable(tid); return; }
    if (st == thread.THREAD_SLEEPING && intr != 0) { wakeup_thread(tid); return; }
    if (lapic_id >= 0) { lapic.send_resched_ipi_to(lapic_id); }
}

// ============================================================
// Global scheduling state (not per-CPU)
// ============================================================

let is i64 as sched_active with mut = 0;

let is i64 as switch_rsp with mut = 0;
// ctx_old_rsp_ptr / ctx_new_rsp live in smp.PerCpu now (offsets
// 0x58 / 0x60). schedule()'s switch asm reads them via gs:[..]
// so a concurrent switch on another cpu can't stomp our scratch
// between the store and the mov-rsp pair.

// Preempt count lives in smp.PerCpu now — accessed via
// smp.this_cpu_{,set_}preempt_count. Keeping it global would race
// across cpus even though the intent is per-cpu.

// Per-cpu sched locks live in `per_cpu_sched_locks` above. Each
// schedule() call takes its own cpu's lock; cross-cpu interactions
// (wakeup_thread targeting another cpu, create_thread placing a
// new thread on a remote cpu) acquire the *target* cpu's lock.
// No single global serialises the scheduler hot path now.
//
// Lock handoff during context switch: schedule on cpu X holds X's
// lock across the rsp swap, and the resuming side (either
// thread_entry_trampoline for new threads or .Lresume for
// previously-suspended threads) is responsible for dropping it —
// X's lock, the cpu it resumes on, which for a thread an idle cpu
// pulled over (steal_work) is not the cpu it was switched out on.

// ============================================================
// Preempt disable/enable (§11.5)
// ============================================================

// One `inc`/`dec gs:[0x78]` each. Read-the-count-then-write-it-back is two
// steps, and a thread preempted between them on one cpu and resumed on another
// wrote its first cpu's count, plus one, over its second's.
fn preempt_disable() as void {
    lock.preempt_inc();
}

fn preempt_enable() as void {
    lock.preempt_dec();
    lock.preempt_check();
}

// What lock.preempt_check calls once the last spinlock is dropped with a
// reschedule pending (installed by init; lock.cst cannot import this file).
fn preempt_resched() as void {
    schedule();
}

// ============================================================
// Thread creation
// ============================================================

// Round-robin placement counter for create_thread. Bumped under the
// home cpu's sched_lock so two cpus creating threads in parallel
// still get different home cpus.
let is i64 as next_placement_cpu with mut = 0;

// Per-cpu watchdog heartbeat. schedule() stamps this with the current
// time on every entry. The watchdog thread (run from BSP) polls these
// once per second and panics with a dump if any cpu hasn't ticked in
// WATCHDOG_THRESHOLD_NS — that's strong evidence the cpu is wedged
// (deadlock, infinite loop without yield, missed IRQ). Indexed by
// cpu_id; only the first MAX_CPUS_RQ slots are meaningful.
let is [16]i64 as cpu_heartbeat_ns;     // one per cpu (MAX_CPUS_RQ)

fn heartbeat_get(cpu as i64) as i64 { return cpu_heartbeat_ns[cpu]; }
fn heartbeat_set(cpu as i64, ns as i64) as void { cpu_heartbeat_ns[cpu] = ns; return; }

// When each cpu last got into schedule() past the preemption gate. A cpu whose
// timer still ticks (fresh heartbeat) but which has not managed to switch for
// WATCHDOG_THRESHOLD_NS is stuck with preemption held off — spinning on a
// spinlock nobody will release, or looping inside one. The heartbeat alone
// never saw that: the tick keeps firing on a cpu that spins with interrupts on.
let is [16]i64 as cpu_switch_ns;        // one per cpu (MAX_CPUS_RQ)

fn switch_get(cpu as i64) as i64 { return cpu_switch_ns[cpu]; }
fn switch_set(cpu as i64, ns as i64) as void { cpu_switch_ns[cpu] = ns; return; }

fn create_thread(entry as i64, band as i64) as i64 {
    // Pick this thread's home cpu via round-robin BEFORE taking
    // any lock — the placement choice is itself the input that
    // selects which lock to take. Every cpu (including BSP) gets
    // a turn so workload spreads evenly across the topology.
    let is i64 as home_cpu = pick_home_cpu();

    let is i64 as saved_flags = lock.acquire_irq(runq.sched_lock_ptr(home_cpu));

    // Allocate tid + hash slot under tid_lock so concurrent
    // per_cpu_init / create_thread on different cpus don't reuse
    // the same tid or stomp the same hash bucket.
    let is i64 as tid_flags = lock.acquire_irq(&thread.tid_lock);
    let is i64 as tid = thread.next_tid;

    let is i64 as tptr = heap.kpool_alloc_ensure(cast(i64, &thread.thread_pool), thread.THREAD_SIZE, 1);
    if (tptr == 0) { pmm.panic("thread alloc fail", 17); }
    thread.tid_set_ptr(tid, tptr);
    thread.next_tid = tid + 1;
    lock.release_irq(&thread.tid_lock, tid_flags);

    let is *u8 as tp = cast(*u8, tptr);
    let is i64 as z with mut = 0;
    while (z < thread.THREAD_SIZE) { tp[z] = 0; z = z + 1; }

    // Kernel stack
    // Guarded kernel stack: kvmap(KV_DATA | KV_GUARD) is a contiguous kernel VA
    // backed by scattered frames with an UNMAPPED page on each side, so an
    // overflow past the stack faults at once (#PF on the lower guard) instead of
    // silently corrupting the neighbour below it. It lives in the shared kernel
    // half (as_create copies PML4[256..511]), so it is mapped in every aspace.
    let is i64 as stack_base = vmm.kvmap(thread.KSTACK_SIZE, vmm.KV_DATA, vmm.KV_GUARD, 0);
    if (stack_base == 0) { pmm.panic("stack alloc fail", 16); }
    let is i64 as stack_top = stack_base + thread.KSTACK_SIZE;

    let is *i64 as sf = cast(*i64, stack_top - 56);
    asm("lea rax, [rip+_kernel_task_sched_cst_thread_entry_trampoline]\n");
    asm("lea rbx, [rip+_kernel_task_sched_cst_switch_rsp]\n");
    asm("mov QWORD PTR [rbx], rax\n");
    sf[0] = switch_rsp;
    sf[1] = 0; sf[2] = 0; sf[3] = 0; sf[4] = 0; sf[5] = 0; sf[6] = 0;

    let is i64 as fpu_addr = heap.kpool_alloc_ensure(cast(i64, &thread.fpu_pool), thread.FPU_STATE_SIZE, 1);
    if (fpu_addr != 0) { fpu.fpu_area_init(fpu_addr); }

    // EEVDF: a new thread starts at the band's average — owed exactly its
    // share from here on, no credit and no debt.
    let is i64 as w = qos.band_weight(band);
    let is i64 as mvrt = qos.place_vruntime(home_cpu, band, tid, 1);
    let is i64 as vd = mvrt + (thread.DEFAULT_SLICE_NS * thread.BASE_WEIGHT / w);
    let is i64 as now = timer.current_time_ns();

    thread.thr_set(tid, 0, tid);
    thread.thr_set(tid, 8, thread.THREAD_RUNNABLE);
    thread.thr_set(tid, 16, thread.SCHED_CLASS_QOS);
    thread.thr_set(tid, 24, band);
    thread.thr_set(tid, 32, w);
    thread.thr_set(tid, 40, thread.DEFAULT_SLICE_NS);
    thread.thr_set(tid, 48, mvrt);
    thread.thr_set(tid, 56, vd);
    thread.thr_set(tid, 64, stack_top - 56);
    thread.thr_set(tid, 72, stack_base);
    thread.thr_set(tid, 80, entry);
    thread.thr_set(tid, 312, stack_base);   // kstack VA — kvunmap'd by the reaper
    thread.thr_set(tid, 96, 0 - 1);
    thread.thr_set(tid, 104, 0 - 1);
    thread.thr_set(tid, 112, 0);             // lag
    thread.thr_set(tid, 192, now);           // window_start_ns
    thread.thr_set(tid, 216, band);          // original_qos_band
    thread.thr_set(tid, 240, fpu_addr);      // fpu_state_addr
    thread.thr_set(tid, 256, home_cpu);      // home_cpu — every wakeup_thread / sched
                                      //  cross-cpu touch reads this slot to
                                      //  pick the correct lock + runqueue
    thread.thr_set(tid, 280, vmm.kas_pml4_phys);  // aspace_pml4 — kernel AS until a
                                      //  process loader replaces it

    runq.runlist_insert(home_cpu, band, tid);
    runq.set_nr_running(home_cpu, runq.nr_running(home_cpu) + 1);
    lock.atomic_add(&thread.thread_count, 1);
    lock.atomic_add(&thread.kthread_count, 1);

    // Tell the home cpu it has new work so it preempts on next
    // tick — no IPI needed, the per-cpu need_resched flag is
    // visible the next time that cpu enters its scheduler.
    let is *smp.PerCpu as hpc = smp.get_per_cpu(home_cpu);
    if (cast(i64, hpc) != 0) { hpc.need_resched = 1; }

    lock.release_irq(runq.sched_lock_ptr(home_cpu), saved_flags);
    return tid;
}

// Create a thread that will iretq into ring 3 once dispatched. Same
// shape as create_thread but populates aspace_pml4 / user_entry /
// user_rsp under the same sched_lock so the home cpu's pick_next
// can't observe the thread before its user context is in place.
//
// `kentry` is the kernel-side trampoline (typically
// userspace.user_thread_trampoline) that reads thr_user_entry /
// thr_user_rsp and runs the iretq.
fn create_user_thread_ex(kentry as i64, band as i64, aspace_pml4 as i64,
                      user_entry as i64, user_rsp as i64, aspace_ptr as i64,
                      process_ptr as i64, suspended as i64) as i64 {
    let is i64 as home_cpu = pick_home_cpu();

    let is i64 as saved_flags = lock.acquire_irq(runq.sched_lock_ptr(home_cpu));

    let is i64 as tid_flags = lock.acquire_irq(&thread.tid_lock);
    let is i64 as tid = thread.next_tid;

    let is i64 as tptr = heap.kpool_alloc_ensure(cast(i64, &thread.thread_pool), thread.THREAD_SIZE, 1);
    if (tptr == 0) { pmm.panic("thread alloc fail", 17); }
    thread.tid_set_ptr(tid, tptr);
    thread.next_tid = tid + 1;
    lock.release_irq(&thread.tid_lock, tid_flags);

    let is *u8 as tp = cast(*u8, tptr);
    let is i64 as z with mut = 0;
    while (z < thread.THREAD_SIZE) { tp[z] = 0; z = z + 1; }

    // Guarded kernel stack (see the matching comment in the other thread ctor).
    let is i64 as stack_base = vmm.kvmap(thread.KSTACK_SIZE, vmm.KV_DATA, vmm.KV_GUARD, 0);
    if (stack_base == 0) { pmm.panic("ustack alloc fail", 17); }
    let is i64 as stack_top = stack_base + thread.KSTACK_SIZE;

    let is *i64 as sf = cast(*i64, stack_top - 56);
    asm("lea rax, [rip+_kernel_task_sched_cst_thread_entry_trampoline]\n");
    asm("lea rbx, [rip+_kernel_task_sched_cst_switch_rsp]\n");
    asm("mov QWORD PTR [rbx], rax\n");
    sf[0] = switch_rsp;
    sf[1] = 0; sf[2] = 0; sf[3] = 0; sf[4] = 0; sf[5] = 0; sf[6] = 0;

    let is i64 as fpu_addr = heap.kpool_alloc_ensure(cast(i64, &thread.fpu_pool), thread.FPU_STATE_SIZE, 1);
    if (fpu_addr != 0) { fpu.fpu_area_init(fpu_addr); }

    let is i64 as w = qos.band_weight(band);
    let is i64 as mvrt = qos.place_vruntime(home_cpu, band, tid, 1);
    let is i64 as vd = mvrt + (thread.DEFAULT_SLICE_NS * thread.BASE_WEIGHT / w);
    let is i64 as now = timer.current_time_ns();

    thread.thr_set(tid, 0, tid);
    thread.thr_set(tid, 8, thread.THREAD_RUNNABLE);
    thread.thr_set(tid, 16, thread.SCHED_CLASS_QOS);
    thread.thr_set(tid, 24, band);
    thread.thr_set(tid, 32, w);
    thread.thr_set(tid, 40, thread.DEFAULT_SLICE_NS);
    thread.thr_set(tid, 48, mvrt);
    thread.thr_set(tid, 56, vd);
    thread.thr_set(tid, 64, stack_top - 56);
    thread.thr_set(tid, 72, stack_base);
    thread.thr_set(tid, 80, kentry);
    thread.thr_set(tid, 96, 0 - 1);
    thread.thr_set(tid, 104, 0 - 1);
    thread.thr_set(tid, 112, 0);
    thread.thr_set(tid, 192, now);
    thread.thr_set(tid, 216, band);
    thread.thr_set(tid, 240, fpu_addr);
    thread.thr_set(tid, 256, home_cpu);
    thread.thr_set(tid, 280, aspace_pml4);   // user aspace
    thread.thr_set(tid, 288, user_entry);    // ring-3 RIP
    thread.thr_set(tid, 296, user_rsp);      // ring-3 RSP
    thread.thr_set(tid, 304, aspace_ptr);    // *vma.Aspace (for syscall handlers)
    thread.thr_set(tid, 248, process_ptr);   // owning Process (0 for none)
    thread.thr_set(tid, 312, stack_base);  // kstack VA — kvunmap'd by the reaper
    // Suspended: created but parked. The state line above set RUNNABLE;
    // override to SUSPENDED and skip the runqueue insert. proc_start /
    // make_runnable enqueues it once the child's fd table is set up.
    if (suspended != 0) { thread.thr_set(tid, 8, thread.THREAD_SUSPENDED); }

    lock.atomic_add(&thread.thread_count, 1);

    if (suspended == 0) {
        runq.runlist_insert(home_cpu, band, tid);
        runq.set_nr_running(home_cpu, runq.nr_running(home_cpu) + 1);
        let is *smp.PerCpu as hpc = smp.get_per_cpu(home_cpu);
        if (cast(i64, hpc) != 0) { hpc.need_resched = 1; }
    }

    lock.release_irq(runq.sched_lock_ptr(home_cpu), saved_flags);
    return tid;
}

// Thin compatibility wrapper: a user thread with no owning Process,
// started immediately. The pre-Process smokes (and any kernel-internal
// user thread) use this.
fn create_user_thread(kentry as i64, band as i64, aspace_pml4 as i64,
                      user_entry as i64, user_rsp as i64, aspace_ptr as i64) as i64 {
    return create_user_thread_ex(kentry, band, aspace_pml4, user_entry,
                                 user_rsp, aspace_ptr, 0, 0);
}

// Make a SUSPENDED thread runnable: insert it into its home cpu's
// runqueue. The process spawn path calls this (proc_start) after the
// child's fd table is set up. No-op if the thread isn't suspended.
fn make_runnable(tid as i64) as void {
    let is i64 as cpu with mut = 0;
    let is i64 as f = runq.lock_home(tid, &cpu);
    let is i64 as band = thread.thr_band(tid);
    if (thread.thr_state(tid) == thread.THREAD_SUSPENDED) {
        thread.thr_set(tid, 8, thread.THREAD_RUNNABLE);
        if (thread.thr_class(tid) == thread.SCHED_CLASS_DEADLINE) {
            // Out of budget and being killed: it runs to its exit now, off the
            // throttled list and back in the deadline tree it came from.
            qos.dlt_unlink(cpu, tid);
            runq.dl_insert(cpu, tid);
        } else {
            // Re-placed against the band as it is NOW: the average has moved
            // on since the thread was created suspended.
            qos.place_requeue(cpu, band, tid);
            runq.runlist_insert(cpu, band, tid);
        }
        runq.set_nr_running(cpu, runq.nr_running(cpu) + 1);
        let is *smp.PerCpu as pc = smp.get_per_cpu(cpu);
        if (cast(i64, pc) != 0) { pc.need_resched = 1; }
    }
    lock.release_irq(runq.sched_lock_ptr(cpu), f);
}

// ============================================================
// Sleep / Wakeup (§5.4)
// ============================================================

// Per-cpu count of threads currently sleeping with a wake deadline.
// Lets on_timer_tick skip the per-thread scan entirely on cpus that
// have no time-driven sleepers — most ticks. Bumped under the home
// cpu's sched_lock by sleep_for_ns; decremented by tick_wake when a
// timed sleep fires (and by wakeup_thread if a manual wakeup arrives
// while sleep_until_ns > 0).
let is [16]i64 as cpu_timed_sleepers;   // one per cpu (MAX_CPUS_RQ)

fn timed_sleepers_get(cpu as i64) as i64 { return cpu_timed_sleepers[cpu]; }
fn timed_sleepers_set(cpu as i64, v as i64) as void { cpu_timed_sleepers[cpu] = v; return; }

// Who sleeps with a deadline, per cpu: a list through the thread struct, under
// that cpu's sched_lock, and the earliest deadline on it. tick_wake used to
// look at every tid ever handed out, on every tick of every cpu that had any
// timed sleeper — and every parked poller is one, for its cap — so a tick cost
// more with each command the session had run. Now a tick that has nothing due
// compares one number, and one that has walks only the sleepers.
//
// A sleeper is on the list of the cpu it slept on, which stays its home: only
// runnable threads move (steal_work).
let is [16]i64 as tsleep_heads with mut;
let is [16]i64 as tsleep_min with mut;      // earliest wake_at listed, 0 = none

fn tsleep_add(cpu as i64, tid as i64, wake_at as i64) as void {
    thread.thr_set(tid, 272, wake_at);                 // sleep_until_ns
    let is i64 as head = tsleep_heads[cpu];
    thread.thr_set(tid, thread.THR_TSLEEP_NEXT, head);
    thread.thr_set(tid, thread.THR_TSLEEP_PREV, 0);
    if (head != 0) { thread.thr_set(head - 1, thread.THR_TSLEEP_PREV, tid + 1); }
    tsleep_heads[cpu] = tid + 1;
    timed_sleepers_set(cpu, timed_sleepers_get(cpu) + 1);
    if (tsleep_min[cpu] == 0 || wake_at < tsleep_min[cpu]) { tsleep_min[cpu] = wake_at; }
}

// Off the list, if on it. The earliest-deadline mark may now be early; the next
// tick that reaches it finds nothing due and recomputes it.
fn tsleep_remove(cpu as i64, tid as i64) as void {
    if (thread.thr_sleep_until_ns(tid) <= 0) { return; }
    let is i64 as nx = thread.thr_get(tid, thread.THR_TSLEEP_NEXT);
    let is i64 as pv = thread.thr_get(tid, thread.THR_TSLEEP_PREV);
    if (pv != 0) { thread.thr_set(pv - 1, thread.THR_TSLEEP_NEXT, nx); }
    else { tsleep_heads[cpu] = nx; }
    if (nx != 0) { thread.thr_set(nx - 1, thread.THR_TSLEEP_PREV, pv); }
    thread.thr_set(tid, thread.THR_TSLEEP_NEXT, 0);
    thread.thr_set(tid, thread.THR_TSLEEP_PREV, 0);
    thread.thr_set(tid, 272, 0);
    timed_sleepers_set(cpu, timed_sleepers_get(cpu) - 1);
}

// sleep_for_ns: park the current thread until at least `ns` from
// now. Replaces the yield-loop pattern that vfs.self_test_thread
// and fat32.mount_thread used to use — yielding within QOS_ACTIVE
// keeps re-picking the same thread (because pick_next walks bands
// in order and the yielder is the only ACTIVE thread on its cpu),
// which starves the QOS_NORMAL test threads sharing the same cpu.
// A real sleep transitions the thread to SLEEPING, drops it from
// the runqueue, and lets pick_next fall through to lower bands.
// The timer tick on the thread's home cpu wakes it once its
// deadline passes.
fn sleep_for_ns(ns as i64) as void {
    if (ns <= 0) { yield_cpu(); return; }
    sleep_unless(cast(*i64, 0), 0, ns);
}

// sleep_for_ns, unless *word already equals `value` (word may be null: no
// condition). The word is read under the scheduler lock wakeup_thread takes,
// so a waker that stores the value and then calls wakeup_thread is either
// seen here — no sleep — or finds this thread SLEEPING and wakes it. Checking
// the word first and then calling sleep_for_ns loses a wakeup that lands
// between the two, and the waiter sleeps out the whole timeout: a disk read
// that the device finished in 20 us took the full poll interval.
fn sleep_unless(word as *i64, value as i64, ns as i64) as void {
    if (ns <= 0) { return; }
    let is i64 as tid = runq.current_tid();
    if (tid < 0) { return; }
    let is i64 as cpu = thread.thr_home_cpu(tid);
    let is i64 as saved_flags = lock.acquire_irq(runq.sched_lock_ptr(cpu));
    let is i64 as met with mut = 0;
    if (cast(i64, word) != 0) {
        if (word[0] == value) { met = 1; }
    }
    if (met == 1 || thread.thr_state(tid) != thread.THREAD_RUNNING) {
        lock.release_irq(runq.sched_lock_ptr(cpu), saved_flags);
        return;
    }
    let is i64 as wake_at = timer.current_time_ns() + ns;
    tsleep_add(cpu, tid, wake_at);
    thread.thr_set(tid, 8, thread.THREAD_SLEEPING);
    runq.set_nr_running(cpu, runq.nr_running(cpu) - 1);
    lock.release_irq(runq.sched_lock_ptr(cpu), saved_flags);
    schedule();
}

// The same sleep, but one a kill may cut short. Returns 1 if the thread is
// being terminated (now, or it was woken for that), 0 if the time passed. A
// caller in a syscall path returns E_INTR on 1 and lets the boundary finish it.
// Plain sleep_for_ns stays uninterruptible on purpose: a driver polling its
// hardware must finish the poll, killed or not.
fn sleep_interruptible(ns as i64) as i64 {
    let is i64 as tid = runq.current_tid();
    if (tid < 0) { return 0; }
    if (thread.thr_get(tid, thread.THR_KILL) != 0) { return 1; }
    if (ns <= 0) { yield_cpu(); return thread.thr_get(tid, thread.THR_KILL); }
    let is i64 as cpu = thread.thr_home_cpu(tid);
    let is i64 as saved_flags = lock.acquire_irq(runq.sched_lock_ptr(cpu));
    // Checked again under the lock kill_kick reads our state with: either it
    // already set the flag and we do not sleep, or it will see us SLEEPING with
    // intr_sleep set and wake us.
    if (thread.thr_get(tid, thread.THR_KILL) != 0 || thread.thr_state(tid) != thread.THREAD_RUNNING) {
        lock.release_irq(runq.sched_lock_ptr(cpu), saved_flags);
        return thread.thr_get(tid, thread.THR_KILL);
    }
    let is i64 as wake_at = timer.current_time_ns() + ns;
    tsleep_add(cpu, tid, wake_at);
    thread.thr_set(tid, thread.THR_INTR_SLEEP, 1);
    thread.thr_set(tid, 8, thread.THREAD_SLEEPING);
    runq.set_nr_running(cpu, runq.nr_running(cpu) - 1);
    lock.release_irq(runq.sched_lock_ptr(cpu), saved_flags);
    schedule();
    thread.thr_set(tid, thread.THR_INTR_SLEEP, 0);
    return thread.thr_get(tid, thread.THR_KILL);
}

// Called from on_timer_tick on each cpu: wake this cpu's sleepers whose
// deadline has passed. Nothing due — the common case, since a parked poller's
// deadline is its 50 ms cap — costs one comparison and no lock.
fn tick_wake(cpu as i64, now as i64) as void {
    if (timed_sleepers_get(cpu) <= 0) { return; }
    let is i64 as m = tsleep_min[cpu];
    if (m == 0 || now < m) { return; }
    let is i64 as f = lock.acquire_irq(runq.sched_lock_ptr(cpu));
    let is i64 as next_min with mut = 0;
    let is i64 as woke with mut = 0;
    let is i64 as lid with mut = 0 - 1;
    let is i64 as t with mut = tsleep_heads[cpu];
    while (t != 0) {
        let is i64 as tid = t - 1;
        t = thread.thr_get(tid, thread.THR_TSLEEP_NEXT);
        let is i64 as wake_at = thread.thr_sleep_until_ns(tid);
        if (now >= wake_at) {
            // wake_locked takes it off the list; a sleeper that is somehow not
            // SLEEPING any more still has to leave it.
            if (thread.thr_state(tid) == thread.THREAD_SLEEPING) {
                let is i64 as l = wake_locked(tid, cpu);
                if (l >= 0) { lid = l; }
                woke = 1;
            } else {
                tsleep_remove(cpu, tid);
            }
        } else if (next_min == 0 || wake_at < next_min) {
            next_min = wake_at;
        }
    }
    tsleep_min[cpu] = next_min;
    lock.release_irq(runq.sched_lock_ptr(cpu), f);
    if (woke == 1) { wake_finish(cpu, lid); }
}

fn sleep_thread(tid as i64) as void {
    let is i64 as cpu = thread.thr_home_cpu(tid);
    let is i64 as saved_flags = lock.acquire_irq(runq.sched_lock_ptr(cpu));
    if (thread.thr_state(tid) != thread.THREAD_RUNNING) {
        lock.release_irq(runq.sched_lock_ptr(cpu), saved_flags);
        return;
    }
    thread.thr_set(tid, 8, thread.THREAD_SLEEPING);
    runq.set_nr_running(cpu, runq.nr_running(cpu) - 1);
    lock.release_irq(runq.sched_lock_ptr(cpu), saved_flags);
    schedule();
}

// Condition-variable-style sleep. Caller holds THIS cpu's sched_lock
// with IRQs disabled and a copy of the saved flags. The caller is
// always the current thread, so the home_cpu read is just this_cpu()
// — but reading it from the thread struct keeps the locking pattern
// uniform with sleep_thread/wakeup_thread.
fn sleep_locked_and_yield(saved_flags as i64) as void {
    let is i64 as tid = runq.current_tid();
    let is i64 as cpu = thread.thr_home_cpu(tid);
    thread.thr_set(tid, 8, thread.THREAD_SLEEPING);
    runq.set_nr_running(cpu, runq.nr_running(cpu) - 1);
    lock.release_irq(runq.sched_lock_ptr(cpu), saved_flags);
    schedule();
}

// ============================================================
// Poll parking (§ idle cost)
// ============================================================
// A thread with nothing ready used to sleep 1 ms and ask again. That is a
// thousand wake-ups a second PER WAITER, and it is the entire idle cost of a
// desktop: measured, a still machine burned 24% of a host core, and raising
// the interval fourfold cut it fourfold — the work per wake is nothing, the
// wake itself is everything.
//
// Now a waiter PARKS and whoever changes a readiness answer wakes it. The park
// still carries a deadline, and that deadline is capped: it bounds a wakeup
// that never comes (a future object whose writer forgets to call poll_wake_key) to
// one cap instead of a hang. The cap is a safety net on a liveness hazard, not
// the mechanism — events wake a parked poller immediately.
let is i64 as POLL_PARK_CAP_NS = 50000000;      // 50 ms
let is i64 as THR_POLL_PARKED = 344;            // slot in the thread struct (see layout)

// thread_stats — what the threads of some processes are doing, in one pass
// over the tid table: procs[0..n) are *Process values sorted ascending, and
// for the threads of procs[i], cpu[i] gets their cumulative cpu nanoseconds
// (a process's cpu time is the sum of its threads') and ready[i] how many are
// on a cpu or waiting for one. cpu[n] and ready[n] get the same for the
// kernel's own threads — those of no process — leaving out the idle threads,
// whose time is not work. The caller zeroes the arrays.
//
// It used to be a loop over every tid ever handed out, once per process:
// tids are never reused, so the cost of one ps or htop refresh grew with
// everything the system had ever run. The table holds the live threads only.
// Lockless, like thread_ptr: preemption is held off while the table pointer is
// in hand, and a thread leaving meanwhile is counted or not, never a fault.
fn thread_stats(procs as *i64, n as i64, cpu as *i64, ready as *i64) as void {
    let is i64 as track = lock.preempt_track;
    if (track != 0) { lock.preempt_inc(); }
    let is i64 as t = thread.tid_tab;
    if (t != 0) {
        let is *i64 as h = cast(*i64, t);
        let is i64 as cap = h[0];
        let is i64 as nc = runq.num_cpus();
        let is i64 as i with mut = 0;
        while (i < cap) {
            let is *i64 as slot = cast(*i64, t + (thread.TID_HDR_WORDS + i * 2) * 8);
            let is i64 as tid = slot[0];
            let is i64 as tp = slot[1];
            if (tid >= 0 && tp != 0) {
                let is *i64 as th = cast(*i64, tp);
                let is i64 as pp = th[31];                       // process_ptr @248
                let is i64 as k with mut = 0 - 1;
                if (pp == 0) {
                    k = n;
                    let is i64 as c with mut = 0;
                    while (c < nc) {
                        if (smp.cpu_idle_tid(c) == tid) { k = 0 - 1; }
                        c = c + 1;
                    }
                } else {
                    let is i64 as lo with mut = 0;
                    let is i64 as hi with mut = n - 1;
                    while (lo <= hi) {
                        let is i64 as mid = (lo + hi) / 2;
                        if (procs[mid] == pp) { k = mid; lo = hi + 1; }
                        else if (procs[mid] < pp) { lo = mid + 1; }
                        else { hi = mid - 1; }
                    }
                }
                if (k >= 0) {
                    cpu[k] = cpu[k] + th[11];                     // total_runtime_ns @88
                    let is i64 as st = th[1];                     // state @8
                    if (st == thread.THREAD_RUNNING || st == thread.THREAD_RUNNABLE) { ready[k] = ready[k] + 1; }
                }
            }
            i = i + 1;
        }
    }
    if (track != 0) { lock.preempt_dec(); }
}

// Bumped by every poll_wake_key. A poller reads it BEFORE asking whether its
// fds are ready and hands the value back to poll_park_keys, which refuses to
// sleep if the count moved in between.
//
// Without it there is a window with a name: a thread sweeps its fds, finds
// nothing, and is still RUNNING when the interrupt arrives. poll_wake_key looks
// for parked threads, sees none, and the wakeup is lost — the thread then
// parks and sleeps out the full POLL_PARK_CAP_NS. That cap exists precisely
// as the backstop for this, so nothing hangs, but 50 ms of latency on a link
// whose round trip is 0.1 ms is not a backstop anyone should be hitting: ping
// measured 52 ms on three runs in five, and TCP would pay it per round trip.
let is i64 as poll_seq with mut = 1;

fn poll_seq_read() as i64 {
    return lock.load_word(&poll_seq);
}

// Who is parked, per cpu: a doubly-linked list through the thread struct
// (park_next/park_prev, tid + 1 so 0 can mean "none"), touched only under that
// cpu's sched_lock. poll_wake_key walks these instead of every tid the system
// ever handed out — next_tid only grows, so a sweep over it got slower with
// every command run, while the parked set is the handful of threads actually
// waiting.
let is [16]i64 as park_heads with mut;

fn park_link(cpu as i64, tid as i64) as void {
    let is i64 as head = park_heads[cpu];
    thread.thr_set(tid, thread.THR_PARK_NEXT, head);
    thread.thr_set(tid, thread.THR_PARK_PREV, 0);
    if (head != 0) { thread.thr_set(head - 1, thread.THR_PARK_PREV, tid + 1); }
    park_heads[cpu] = tid + 1;
    thread.thr_set(tid, thread.THR_PARK_CPU, cpu);
    thread.thr_set(tid, THR_POLL_PARKED, 1);
}

fn park_unlink(cpu as i64, tid as i64) as void {
    let is i64 as nx = thread.thr_get(tid, thread.THR_PARK_NEXT);
    let is i64 as pv = thread.thr_get(tid, thread.THR_PARK_PREV);
    if (pv != 0) { thread.thr_set(pv - 1, thread.THR_PARK_NEXT, nx); }
    else { park_heads[cpu] = nx; }
    if (nx != 0) { thread.thr_set(nx - 1, thread.THR_PARK_PREV, pv); }
    thread.thr_set(tid, thread.THR_PARK_NEXT, 0);
    thread.thr_set(tid, thread.THR_PARK_PREV, 0);
    thread.thr_set(tid, thread.THR_PARK_KEYS, 0);
    thread.thr_set(tid, thread.THR_PARK_NKEYS, 0);
    thread.thr_set(tid, THR_POLL_PARKED, 0);
}

// Park until something this thread waits on changes, the deadline passes, or
// the thread is killed. `keys` names what it waits on — one key per object,
// kobject.ko_wait_key — and only a poll_wake_key for one of them wakes it; the
// array lives in the caller's frame, which stays put for as long as the thread
// is asleep in here.
//
// `seq` is what poll_seq_read returned before the caller checked readiness: if
// any wake happened since, the news may be the caller's, so it goes round and
// asks again instead of sleeping. The thread goes on the list FIRST and reads
// the counter after, with a fence between: a waker bumps the counter and then
// looks at the list, so of the two, at least one sees the other — the waker
// finds this thread listed, or this thread finds the counter moved. Read in
// the other order, a waker could look at an empty list just before this thread
// joined it, and the thread would then sleep through the wake that was its own.
fn poll_park_keys(deadline as i64, seq as i64, keys as *i64, nkeys as i64) as void {
    let is i64 as tid = runq.current_tid();
    if (tid < 0) { return; }
    let is i64 as now = timer.current_time_ns();
    let is i64 as wake_at with mut = now + POLL_PARK_CAP_NS;
    if (deadline > 0 && deadline < wake_at) { wake_at = deadline; }
    let is i64 as cpu = thread.thr_home_cpu(tid);
    let is i64 as saved_flags = lock.acquire_irq(runq.sched_lock_ptr(cpu));
    // A park is interruptible: a thread being terminated does not go to sleep,
    // and its caller sees kill_requested() on the way round its loop.
    if (thread.thr_state(tid) != thread.THREAD_RUNNING || thread.thr_get(tid, thread.THR_KILL) != 0) {
        lock.release_irq(runq.sched_lock_ptr(cpu), saved_flags);
        return;
    }
    thread.thr_set(tid, thread.THR_PARK_KEYS, cast(i64, keys));
    thread.thr_set(tid, thread.THR_PARK_NKEYS, nkeys);
    park_link(cpu, tid);
    asm(".byte 0x0F, 0xAE, 0xF0\n");     // mfence: the link is visible before the read
    if (lock.load_word(&poll_seq) != seq) {
        park_unlink(cpu, tid);
        lock.release_irq(runq.sched_lock_ptr(cpu), saved_flags);
        return;
    }
    tsleep_add(cpu, tid, wake_at);
    thread.thr_set(tid, thread.THR_INTR_SLEEP, 1);
    thread.thr_set(tid, 8, thread.THREAD_SLEEPING);
    runq.set_nr_running(cpu, runq.nr_running(cpu) - 1);
    lock.release_irq(runq.sched_lock_ptr(cpu), saved_flags);
    schedule();
    // Back. A key's waker took this thread off the list; the deadline and a
    // kill did not, and the list is the cpu's it parked on, whatever cpu runs
    // it now.
    let is i64 as pcpu = thread.thr_get(tid, thread.THR_PARK_CPU);
    let is i64 as f2 = lock.acquire_irq(runq.sched_lock_ptr(pcpu));
    if (thread.thr_get(tid, THR_POLL_PARKED) == 1) { park_unlink(pcpu, tid); }
    lock.release_irq(runq.sched_lock_ptr(pcpu), f2);
    thread.thr_set(tid, thread.THR_INTR_SLEEP, 0);
}

// poll_wake_key — something `key` names changed: bytes into a channel, an
// event posted, a device ring filled, an endpoint closed. Wakes the parked
// threads waiting on that key and nobody else.
//
// It used to wake EVERY parked thread, on the theory that the waiters were a
// handful of desktop processes and per-object lists would buy nothing. Every
// byte written into a pipe then woke the compositor, the window manager, netd,
// soundd, the launcher and every terminal, each to re-check its fds and park
// again: `seq 1 100000 | wc -l` took 84 seconds, two cpus busy waking the
// wrong threads, against under one to write the same lines to a file.
//
// Bump FIRST, look second — the other half of poll_park_keys' ordering: a
// thread not on a list yet notices the counter instead. An empty list is
// skipped without its lock, which that ordering is what makes safe. Safe from
// an IRQ handler: each cpu's lock is taken with acquire_irq, one at a time,
// and a cpu holding its own runs with interrupts off, so the handler cannot
// have preempted a holder on this cpu.
fn poll_wake_key(key as i64) as void {
    lock.atomic_add(&poll_seq, 1);
    let is i64 as nc = runq.num_cpus();
    let is i64 as cpu with mut = 0;
    while (cpu < nc) {
        if (park_heads[cpu] != 0) {
            let is i64 as f = lock.acquire_irq(runq.sched_lock_ptr(cpu));
            let is i64 as woke with mut = 0;
            let is i64 as lid with mut = 0 - 1;
            let is i64 as t with mut = park_heads[cpu];
            while (t != 0) {
                let is i64 as tid = t - 1;
                t = thread.thr_get(tid, thread.THR_PARK_NEXT);
                let is *i64 as keys = cast(*i64, thread.thr_get(tid, thread.THR_PARK_KEYS));
                let is i64 as nk = thread.thr_get(tid, thread.THR_PARK_NKEYS);
                let is i64 as hit with mut = 0;
                let is i64 as k with mut = 0;
                while (k < nk) {
                    if (keys[k] == key) { hit = 1; k = nk; } else { k = k + 1; }
                }
                if (hit == 1 && thread.thr_state(tid) == thread.THREAD_SLEEPING) {
                    park_unlink(cpu, tid);
                    let is i64 as l = wake_locked(tid, cpu);
                    if (l >= 0) { lid = l; }
                    woke = 1;
                }
            }
            lock.release_irq(runq.sched_lock_ptr(cpu), f);
            if (woke == 1) { wake_finish(cpu, lid); }
        }
        cpu = cpu + 1;
    }
    return;
}

// Make a SLEEPING thread runnable on `cpu`, whose sched_lock the caller holds.
// Returns the lapic id to send a reschedule IPI to once that lock is dropped,
// or -1 when none is due (the home is this cpu, or the thread was not asleep).
fn wake_locked(tid as i64, cpu as i64) as i64 {
    if (thread.thr_state(tid) != thread.THREAD_SLEEPING) { return 0 - 1; }

    // A timed sleep pending: off the cpu's timed-sleeper list.
    tsleep_remove(cpu, tid);

    let is i64 as band = thread.thr_band(tid);
    let is i64 as w with mut = thread.thr_weight(tid);
    // Placement keeps what the thread earned before it slept, bounded by the
    // sleeper bonus (place_vruntime). It used to reset every waker to the
    // band's minimum, which handed a thread that slept for a microsecond the
    // same head start as one that slept for a minute.
    let is i64 as new_vrt = qos.place_vruntime(cpu, band, tid, 0);
    let is i64 as slice with mut = thread.thr_slice(tid);
    if (w <= 0) { w = thread.BASE_WEIGHT; }
    if (slice <= 0) { slice = thread.DEFAULT_SLICE_NS; }
    let is i64 as new_vd = new_vrt + (slice * thread.BASE_WEIGHT / w);

    thread.thr_set(tid, 48, new_vrt);
    thread.thr_set(tid, 112, 0);
    thread.thr_set(tid, 56, new_vd);
    thread.thr_set(tid, 8, thread.THREAD_RUNNABLE);

    if (thread.thr_class(tid) == thread.SCHED_CLASS_DEADLINE) {
        runq.dl_insert(cpu, tid);
    } else {
        runq.runlist_insert(cpu, band, tid);
    }
    runq.set_nr_running(cpu, runq.nr_running(cpu) + 1);

    // Flag the home cpu (not all cpus) — the thread can only run
    // on its home, so resched on remote cpus is wasted work.
    let is *smp.PerCpu as hpc = smp.get_per_cpu(cpu);
    let is i64 as target_lapic_id with mut = 0 - 1;
    let is i64 as is_remote with mut = 0;
    if (cast(i64, hpc) != 0) {
        hpc.need_resched = 1;
        target_lapic_id = hpc.lapic_id;
        if (cpu != runq.this_cpu()) { is_remote = 1; }
    }

    if (is_remote == 0) { return 0 - 1; }
    return target_lapic_id;
}

// After wake_locked, with the lock dropped. Targeted reschedule IPI — wake the
// home cpu's idle/HLT (or preempt whatever lower-priority thread it's running)
// so the freshly-runnable thread starts in microseconds instead of waiting for
// the home cpu's next timer tick. Only for a home that is a *different* cpu:
// on this one the local need_resched flag plus the in-flight schedule()/return
// path picks the wakeup up without an IRQ round-trip. The broadcast variant
// this replaces was dangerous on -smp 4 pre-per-cpu-runqueue (cross-cpu lock
// contention exposed a codegen race); a single targeted delivery to a
// runqueue we don't own has none of that.
fn wake_finish(cpu as i64, lapic_id as i64) as void {
    if (lapic_id >= 0) { lapic.send_resched_ipi_to(lapic_id); }
    kick_idle_for(cpu);
}

fn wakeup_thread(tid as i64) as void {
    let is i64 as cpu with mut = 0;
    let is i64 as saved_flags = runq.lock_home(tid, &cpu);
    if (thread.thr_state(tid) != thread.THREAD_SLEEPING) {
        lock.release_irq(runq.sched_lock_ptr(cpu), saved_flags);
        return;
    }
    let is i64 as lid = wake_locked(tid, cpu);
    lock.release_irq(runq.sched_lock_ptr(cpu), saved_flags);
    wake_finish(cpu, lid);
}

// Work just became runnable on `cpu`. If that cpu is already busy and another
// sits idle, wake the idle one so it pulls the work (steal_work) now rather
// than at its next tick — or never, as it was before there was any balancing.
let is i64 as BALANCE_NS = 50000000;       // 50 ms between periodic checks per cpu
let is [16]i64 as cpu_last_balance_ns;      // one per cpu (MAX_CPUS_RQ)

fn kick_idle_for(cpu as i64) as void {
    let is i64 as n = smp.get_cpu_count();
    if (n <= 1) { return; }
    let is *smp.PerCpu as hp = smp.get_per_cpu(cpu);
    if (cast(i64, hp) == 0) { return; }
    if (hp.current_tid == hp.idle_tid) { return; }        // it will run it itself
    if (runq.nr_running(cpu) < 2) { return; }
    // Not this cpu: it is running this code, so it is not halted, and if it is
    // idle the idle loop steals at the top of its next pass. An IPI to itself
    // bought nothing — from an interrupt on an idle cpu (a disk completion's
    // wakeup) it was a self-IPI racing the idle thread's own IPIs.
    let is i64 as me = runq.this_cpu();
    let is i64 as c with mut = 0;
    while (c < n) {
        if (c != cpu && c != me) {
            let is *smp.PerCpu as pc = smp.get_per_cpu(c);
            if (cast(i64, pc) != 0 && pc.is_online != 0
                && pc.current_tid == pc.idle_tid && runq.nr_running(c) == 0) {
                lapic.send_resched_ipi_to(pc.lapic_id);
                return;
            }
        }
        c = c + 1;
    }
}

// ============================================================
// Load balancing
// ============================================================
// Every thread used to stay on the cpu it was created on, forever: a cpu could
// sit idle while another had a queue. Now an idle cpu pulls.
//
// steal_work: takes the busiest other run queue when it holds at least two more
// runnable threads than this one, and moves one queued QoS thread here. Called
// by an idle cpu from its loop (an idle cpu has 0, so any queue with a thread
// waiting behind a running one qualifies), and by every cpu from its timer tick
// every BALANCE_NS, which is what evens out 3-and-1 when nobody is idle. A gap
// of one is left alone: moving would only swap which cpu has the extra thread.
// No lock may be held by the caller; interrupts may be on or off. Not moved:
//   - the source's running thread (it is on that cpu's stack and CR3),
//   - the source's FPU owner: with lazy FPU save its latest registers may still
//     be live on that cpu and not in its save area, and it can only become the
//     owner again by running there — which a queued thread is not doing,
//   - deadline-class threads, whose admission was against that cpu's load.
// Its vruntime keeps its distance from the band average, measured on the old
// queue and re-applied on the new one, so the move is neither credit nor debt.
fn steal_work() as i64 {
    let is i64 as self = runq.this_cpu();
    let is i64 as n = smp.get_cpu_count();
    if (n <= 1) { return 0; }
    let is i64 as mine = runq.nr_running(self);
    let is i64 as src with mut = 0 - 1;
    let is i64 as most with mut = mine + 1;
    let is i64 as c with mut = 0;
    while (c < n) {
        if (c != self && runq.nr_running(c) > most) { most = runq.nr_running(c); src = c; }
        c = c + 1;
    }
    if (src < 0) { return 0; }

    // Both locks, lower cpu first: two cpus stealing from each other must
    // take them in the same order.
    let is i64 as lo with mut = self;
    let is i64 as hi with mut = src;
    if (src < self) { lo = src; hi = self; }
    let is i64 as f = lock.acquire_irq(runq.sched_lock_ptr(lo));
    lock.acquire_raw(runq.sched_lock_ptr(hi));

    let is i64 as moved with mut = 0;
    if (runq.nr_running(src) >= runq.nr_running(self) + 2) {
        let is *smp.PerCpu as sp = smp.get_per_cpu(src);
        let is i64 as busy_tid = sp.current_tid;
        let is i64 as fpu_tid = sp.fpu_owner_tid;
        let is i64 as b with mut = 0;
        while (b < thread.NUM_QOS_BANDS && moved == 0) {
            let is i64 as nd with mut = rb.rb_leftmost(runq.band_root(src, b));
            while (nd != 0 && moved == 0) {
                let is i64 as tid = rb.nd_val(nd);
                nd = rb.rb_next(nd);
                if (tid != busy_tid && tid != fpu_tid
                    && thread.thr_state(tid) == thread.THREAD_RUNNABLE
                    && thread.thr_class(tid) == thread.SCHED_CLASS_QOS) {
                    let is i64 as rel = thread.thr_vruntime(tid)
                        - qos.band_avg_vruntime(src, b, qos.running_in_band(src, b));
                    runq.runlist_remove(src, b, tid);
                    runq.set_nr_running(src, runq.nr_running(src) - 1);
                    thread.thr_set(tid, 256, self);
                    let is i64 as v = qos.band_avg_vruntime(self, b, qos.running_in_band(self, b)) + rel;
                    let is i64 as w with mut = thread.thr_weight(tid);
                    let is i64 as sl with mut = thread.thr_slice(tid);
                    if (w <= 0) { w = thread.BASE_WEIGHT; }
                    if (sl <= 0) { sl = thread.DEFAULT_SLICE_NS; }
                    thread.thr_set(tid, 48, v);
                    thread.thr_set(tid, 56, v + sl * thread.BASE_WEIGHT / w);
                    runq.runlist_insert(self, b, tid);
                    runq.set_nr_running(self, runq.nr_running(self) + 1);
                    smp.this_cpu_set_need_resched(1);
                    moved = 1;
                }
            }
            b = b + 1;
        }
    }
    lock.release_raw(runq.sched_lock_ptr(hi));
    lock.release_irq(runq.sched_lock_ptr(lo), f);
    return moved;
}

// Where a new thread starts: the cpu with the fewest runnable threads. It used
// to be round robin, which spreads threads evenly by COUNT and ignores that one
// cpu may be running three busy programs while another idles.
fn pick_home_cpu() as i64 {
    let is i64 as n = smp.get_cpu_count();
    let is i64 as start with mut = next_placement_cpu;
    if (start >= n) { start = 0; }
    next_placement_cpu = start + 1;
    if (next_placement_cpu >= n) { next_placement_cpu = 0; }
    let is i64 as best with mut = start;
    let is i64 as k with mut = 1;
    while (k < n) {
        let is i64 as c = (start + k) % n;
        if (runq.nr_running(c) < runq.nr_running(best)) { best = c; }
        k = k + 1;
    }
    return best;
}

fn suspend_thread(tid as i64) as void {
    let is i64 as cpu = thread.thr_home_cpu(tid);
    let is i64 as saved_flags = lock.acquire_irq(runq.sched_lock_ptr(cpu));
    if (thread.thr_state(tid) != thread.THREAD_RUNNING) {
        lock.release_irq(runq.sched_lock_ptr(cpu), saved_flags);
        return;
    }
    thread.thr_set(tid, 8, thread.THREAD_SUSPENDED);
    runq.set_nr_running(cpu, runq.nr_running(cpu) - 1);
    lock.release_irq(runq.sched_lock_ptr(cpu), saved_flags);
    schedule();
}

fn resume_thread(tid as i64) as void {
    let is i64 as cpu with mut = 0;
    let is i64 as saved_flags = runq.lock_home(tid, &cpu);
    if (thread.thr_state(tid) != thread.THREAD_SUSPENDED) {
        lock.release_irq(runq.sched_lock_ptr(cpu), saved_flags);
        return;
    }
    let is i64 as band = thread.thr_band(tid);
    if (thread.thr_class(tid) == thread.SCHED_CLASS_QOS) { qos.place_requeue(cpu, band, tid); }
    thread.thr_set(tid, 8, thread.THREAD_RUNNABLE);
    if (thread.thr_class(tid) == thread.SCHED_CLASS_DEADLINE) { qos.dlt_unlink(cpu, tid); runq.dl_insert(cpu, tid); }
    else { runq.runlist_insert(cpu, band, tid); }
    runq.set_nr_running(cpu, runq.nr_running(cpu) + 1);
    lock.release_irq(runq.sched_lock_ptr(cpu), saved_flags);
}

// ============================================================
// Thread entry trampoline
// ============================================================

fn thread_entry_trampoline() as void {
    // First code to run on a brand-new thread. schedule() handed
    // control over to us via a ret off the fake frame create_thread
    // built — THIS cpu's sched_lock is still held from that context
    // switch, drop it before enabling IRQs.
    smp.this_cpu_set_in_irq_context(0);
    let is i64 as cpu = runq.this_cpu();
    lock.release(runq.sched_lock_ptr(cpu));
    asm(".byte 0xFB\n");  // sti
    smp.call_ptr(thread.thr_entry(runq.current_tid()));

    // Thread exited. Mark DEAD + drop from this cpu's nr_running
    // under this cpu's lock, then schedule(); we never come back.
    asm(".byte 0xFA\n");  // cli
    let is i64 as exit_cpu = runq.this_cpu();
    lock.acquire(runq.sched_lock_ptr(exit_cpu));
    thread.thr_set(runq.current_tid(), 8, thread.THREAD_DEAD);
    runq.set_nr_running(exit_cpu, runq.nr_running(exit_cpu) - 1);
    lock.release(runq.sched_lock_ptr(exit_cpu));
    asm(".byte 0xFB\n");  // sti
    schedule();
    while (1 == 1) { asm(".byte 0xF4\n"); }
}

// ============================================================
// pick_next (§10)
// ============================================================

fn pick_next_deadline(cpu as i64) as i64 {
    let is i64 as n with mut = rb.rb_leftmost(runq.dl_root(cpu));
    while (n != 0) {
        let is i64 as tid = rb.nd_val(n);
        if (thread.thr_dl_budget(tid) > 0) { return tid; }
        n = rb.rb_next(n);
    }
    return 0 - 1;
}

// EEVDF: of the threads owed cpu (vruntime <= V), the one whose virtual
// deadline comes first. The tree is ordered by deadline, so that is the first
// eligible node. One always exists: the smallest vruntime is never above the
// average. (schedule() re-inserts the outgoing thread before it gets here, so
// every competitor is in the tree.)
fn pick_next_in_band(cpu as i64, band as i64) as i64 {
    let is i64 as v = qos.band_avg_vruntime(cpu, band, 0 - 1);
    let is i64 as n with mut = rb.rb_leftmost(runq.band_root(cpu, band));
    let is i64 as lowest with mut = 0 - 1;
    while (n != 0) {
        let is i64 as tid = rb.nd_val(n);
        if (thread.thr_vruntime(tid) <= v) { return tid; }
        if (lowest < 0 || thread.thr_vruntime(tid) < thread.thr_vruntime(lowest)) { lowest = tid; }
        n = rb.rb_next(n);
    }
    return lowest;
}

fn pick_next(cpu as i64) as i64 {
    if (runq.dl_count(cpu) > 0) {
        let is i64 as dl = pick_next_deadline(cpu);
        if (dl >= 0) { return dl; }
    }
    let is i64 as b with mut = 0;
    while (b < thread.NUM_QOS_BANDS) {
        if (runq.band_count(cpu, b) > 0) {
            let is i64 as tid = pick_next_in_band(cpu, b);
            if (tid >= 0) { return tid; }
        }
        b = b + 1;
    }
    return runq.idle_tid();
}

// ============================================================
// account_runtime (§10)
// ============================================================

fn account_runtime(cpu as i64, tid as i64, elapsed_ns as i64) as void {
    if (thread.thr_class(tid) == thread.SCHED_CLASS_DEADLINE) {
        qos.dl_account(cpu, tid, elapsed_ns);
    }
    if (thread.thr_class(tid) == thread.SCHED_CLASS_QOS) {
        qos.update_vruntime(cpu, tid, elapsed_ns);
        qos.qos_budget_check(cpu, tid, elapsed_ns);
        qos.update_band_min_vruntime(cpu, thread.thr_band(tid));
    }
}

// ============================================================
// schedule (§10)
// ============================================================

fn schedule() as void {
    if (sched_active == 0) { return; }

    let is i64 as from_irq = smp.this_cpu_in_irq_context();

    // Preemption held off (a spinlock is held, or preempt_disable). From an
    // interrupt that is the normal case: leave need_resched set and return —
    // the release that brings the count to zero takes the switch. A thread
    // calling in to SLEEP with a spinlock held is a bug that would wedge every
    // later ticket on that lock behind a thread that is not running; stop the
    // kernel and say so instead.
    if (smp.this_cpu_preempt_count() != 0) {
        if (from_irq != 0) { return; }
        serial.print("sched: schedule() with preemption held off, count=", 50);
        util.print_num(smp.this_cpu_preempt_count());
        serial.print(" tid=", 5);
        util.print_num(runq.current_tid());
        serial.println("", 0);
        pmm.panic("sleeping while atomic", 21);
    }

    asm(".byte 0xFA\n");  // cli
    let is i64 as cpu = runq.this_cpu();
    lock.acquire(runq.sched_lock_ptr(cpu));

    let is i64 as now = timer.current_time_ns();
    heartbeat_set(cpu, now);
    switch_set(cpu, now);
    thread.tid_quiesce(cpu);
    let is i64 as prev = runq.current_tid();

    // Charge the slice that just ended to this cpu's busy or idle total. Done
    // BEFORE the state checks below, because a thread that blocked has already
    // left THREAD_RUNNING and its time would otherwise vanish — which is most
    // of the time on a machine that waits on input.
    if (prev >= 0) {
        let is i64 as ran = now - runq.current_start_ns();
        let is i64 as was_idle with mut = 0;
        if (prev == runq.idle_tid()) { was_idle = 1; }
        smp.this_cpu_add_time(ran, was_idle);
        // Charge the thread its slice. A thread still RUNNING is charged below
        // by account_runtime (both scheduling classes accumulate offset 88), so
        // only the OTHER case is charged here: a thread that blocked has
        // already left THREAD_RUNNING and account_runtime will not see it — and
        // on a machine that waits on input, blocking is how nearly every slice
        // ends. Charging in both places would count that time twice, which is
        // exactly what made a 1 Hz monitor report 20% of a core.
        if (ran > 0 && thread.thr_state(prev) != thread.THREAD_RUNNING) {
            thread.thr_set(prev, 88, thread.thr_get(prev, 88) + ran);
        }
    }

    // Account and re-insert prev on its home cpu (= cpu, since the
    // running thread always belongs to this cpu's runqueue).
    if (prev >= 0) {
        if (thread.thr_state(prev) == thread.THREAD_RUNNING) {
            let is i64 as elapsed = now - runq.current_start_ns();
            if (elapsed > 0) {
                account_runtime(cpu, prev, elapsed);
            }
            if (thread.thr_state(prev) == thread.THREAD_RUNNING) {
                thread.thr_set(prev, 8, thread.THREAD_RUNNABLE);
                if (thread.thr_class(prev) == thread.SCHED_CLASS_DEADLINE) {
                    runq.dl_insert(cpu, prev);
                }
                if (thread.thr_class(prev) == thread.SCHED_CLASS_QOS) {
                    runq.runlist_insert(cpu, thread.thr_band(prev), prev);
                }
            }
        }
    }

    // A thread that died this trip (state set DEAD by exit_current_thread
    // or the kernel-thread trampoline, both of which then call schedule())
    // is `prev` exactly once — here. Queue it for the deferred reaper and
    // never touch it again. Freeing now would race the rsp/CR3 swap below;
    // idle_fn frees it after the switch. Link via the now-free offset 96.
    if (prev >= 0) {
        if (thread.thr_state(prev) == thread.THREAD_DEAD) {
            thread.thr_set(prev, 96, runq.cpu_reap_head(cpu));
            runq.set_cpu_reap_head(cpu, prev);
        }
    }

    qos.dl_check_replenish(cpu);

    let is i64 as next with mut = pick_next(cpu);
    if (next < 0) { next = runq.idle_tid(); }

    if (thread.thr_class(next) == thread.SCHED_CLASS_DEADLINE) { runq.dl_remove(cpu, next); }
    if (thread.thr_class(next) == thread.SCHED_CLASS_QOS) { runq.runlist_remove(cpu, thread.thr_band(next), next); }

    thread.thr_set(next, 8, thread.THREAD_RUNNING);
    runq.set_current_tid(next);
    let is i64 as t_now = timer.current_time_ns();
    runq.set_current_start_ns(t_now);
    thread.thr_set(next, 264, t_now);   // last_run_ns
    runq.set_nr_switches(cpu, runq.nr_switches(cpu) + 1);
    smp.this_cpu_set_need_resched(0);

    // Context switch. The asm keeps sched_lock held across the
    // rsp swap so the outgoing ctx_old/new_rsp globals can't be
    // stomped by another cpu between the store and load — the
    // resuming side (either .Lresume below for a previously-
    // suspended thread or the top of thread_entry_trampoline for
    // a brand-new one) is responsible for dropping the lock.
    if (prev != next) {
        if (prev >= 0) {
            if (thread.thr_state(prev) == thread.THREAD_RUNNABLE) {
                thread.thr_set(prev, 128, thread.thr_get(prev, 128) + 1);
            } else {
                thread.thr_set(prev, 120, thread.thr_get(prev, 120) + 1);
            }

            // FPU: set TS so next thread triggers #NM on first FPU use
            fpu.cr0_set_ts();

            // Update TSS.RSP0 + per-cpu syscall_kstack = kstack of
            // the incoming thread. TSS.RSP0 covers IDT-style ring-3
            // → ring-0 transitions; the per-cpu mirror is what the
            // SYSCALL entry stub picks up via gs:[0x90].
            // RSP0 / syscall-kstack must be the FIXED top of next's
            // kernel stack (kstack_base + KSTACK_SIZE), NOT thr_kstack_top
            // (offset 64), which the context switch overwrites with the
            // *saved* rsp. Using the saved rsp let each ring3→ring0 entry
            // start lower than the last (the effective top crept down ~one
            // IRQ+schedule frame per preemption), so after enough churn a
            // stack-heavy syscall handler (read/write carry a 4 KiB buffer)
            // overflowed the kstack into the adjacent page — a flaky
            // #GP/#PF/register-corruption that got worse with thread churn.
            let is i64 as next_ktop = thread.thr_kstack_base(next) + thread.KSTACK_SIZE;
            gdt.tss_set_rsp0(cpu, next_ktop);
            smp.set_per_cpu_kstack(cpu, next_ktop);

            // CR3 swap if the incoming thread runs against a
            // different aspace. as_create copies the kernel half
            // of the PML4 from kas_pml4, so the kernel's mapping
            // (including this code, kstacks, MMIO) is identical
            // across aspaces — the swap only changes what the user
            // half resolves to. Do it inside the lock-held section,
            // before the asm rsp swap, so the new stack is already
            // on a CR3 that maps it.
            let is i64 as next_pml4 = thread.thr_aspace_pml4(next);
            if (next_pml4 != 0) {
                // Published BEFORE the load (the CR3 write is serialising, so
                // the store is visible first). A shootdown that misses the new
                // value read it before we loaded — and its PTE was cleared
                // before that read — so this cpu walks the cleared PTE, never
                // a stale one. Switching away, the old space is still loaded
                // for a few instructions after we stop advertising it, but
                // only scheduler code runs there, which touches no user page.
                smp.this_cpu_set_cur_pml4(next_pml4);
                vmm.cr3_load_if_different(next_pml4);
            }

            // The incoming thread's fs base — its own block, which is how code
            // in ring 3 finds what belongs to the thread rather than the
            // process (fs:[0] is how far its stack is committed). Only ring 3
            // reads fs, so a kernel thread coming in changes nothing, and the
            // cpu remembers what is loaded to skip a wrmsr that would not.
            if (thread.thr_aspace_ptr(next) != 0) {
                let is i64 as next_fs = thread.thr_get(next, thread.THR_USER_FS);
                if (smp.this_cpu_user_fs() != next_fs) {
                    smp.wrmsr(smp.IA32_FS_BASE, next_fs);
                    smp.this_cpu_set_user_fs(next_fs);
                }
            }

            // Stash the switch scratch in this cpu's PerCpu slot
            // instead of module globals. sched_lock serialises
            // concurrent switches so globals would "work", but
            // once a cpu releases the lock (in .Lresume below)
            // another cpu can immediately start its own switch —
            // if it races into writing the globals while the first
            // cpu is still about to read them in the asm, ctx_*
            // globals stomp. Per-cpu slots close that window
            // without depending on lock coverage of the asm.
            smp.this_cpu_set_ctx_old_rsp_ptr(thread.thread_ptr(prev) + 64);
            smp.this_cpu_set_ctx_new_rsp(thread.thr_kstack_top(next));

            asm("push r15\n");
            asm("push r14\n");
            asm("push r13\n");
            asm("push r12\n");
            asm("push rbx\n");
            asm("push rbp\n");
            asm("lea rax, [rip+.Lresume]\n");
            asm("push rax\n");
            // mov rax, QWORD PTR gs:[0x58] → ctx_old_rsp_ptr
            asm(".byte 0x65, 0x48, 0x8B, 0x04, 0x25, 0x58, 0x00, 0x00, 0x00\n");
            asm("mov QWORD PTR [rax], rsp\n");
            // mov rsp, QWORD PTR gs:[0x60] → ctx_new_rsp
            asm(".byte 0x65, 0x48, 0x8B, 0x24, 0x25, 0x60, 0x00, 0x00, 0x00\n");
            asm("ret\n");
            asm(".Lresume:\n");
            asm("pop rbp\n");
            asm("pop rbx\n");
            asm("pop r12\n");
            asm("pop r13\n");
            asm("pop r14\n");
            asm("pop r15\n");
        }
    }

    // We are whoever got resumed now, so the cpu's interrupt-context flag must
    // be OURS. A thread that went to sleep voluntarily and is woken by a
    // switch made from an interrupt stub would otherwise run on with the
    // stub's in_irq_context = 1: it would then skip the sti below on its next
    // voluntary schedule(), defer when it should switch, and refuse to take a
    // mutex. from_irq is this invocation's own answer, saved on our stack.
    smp.this_cpu_set_in_irq_context(from_irq);

    // The cpu we are on NOW. `cpu` above is where this invocation began, and a
    // thread can resume somewhere else: it was switched out here, pulled to an
    // idle cpu while queued (steal_work), and picked there — so it comes back
    // out of this same call frame on the other cpu, holding THAT cpu's lock.
    // Releasing the stale one would free a lock we do not hold and leak the
    // one we do.
    let is i64 as here = runq.this_cpu();

    // Program LAPIC for next event under the cpu's lock — both
    // the deadline tree and the suspended-deadline scan are
    // per-cpu state.
    program_next_tick(here);

    lock.release(runq.sched_lock_ptr(here));

    // sti only on the thread-call path. If schedule() was called
    // from an IRQ stub, the stub's iretq will restore IF from the
    // saved frame; an sti here would enable IRQs while the stub is
    // still mid-pop of 15 GPRs, and a recursive IRQ entry would
    // stomp the in-flight register restore (observed as crashes at
    // RIP=0x10/0xe/0x1 — the tail end of return-address pop
    // sequences). Thread-call path (idle_fn, yield_cpu, trampoline
    // tail) came in with IF=1 and expects IF=1 on return; they have
    // no iretq to fix IF for them.
    if (from_irq == 0) {
        asm(".byte 0xFB\n");  // sti
    }
}

// ============================================================
// Timer tick (§11.3)
// ============================================================

fn on_timer_tick() as void {
    if (sched_active == 0) { return; }

    // Runs from the LAPIC timer IRQ stub without sched_lock.
    // Everything this function reads — current_tid() / thr_class /
    // nr_running() / elapsed — is either per-cpu state owned by
    // this cpu or a word-sized shared counter that's fine to read
    // racily (worst case: one tick of drift before schedule()
    // picks the correct next thread under the lock anyway). What
    // we deliberately do NOT do here: touch the deadline RB tree.
    // dl_check_replenish mutates the tree and MUST run under
    // sched_lock; schedule() calls it at the top once we commit
    // to rescheduling, so scheduling the reschedule here is
    // enough.

    let is i64 as now = timer.current_time_ns();
    let is i64 as elapsed = now - runq.current_start_ns();
    let is i64 as cpu = runq.this_cpu();

    // Heartbeat for the watchdog — every cpu's timer tick stamps
    // its own slot. BSP additionally polls for stalled cpus below.
    heartbeat_set(cpu, now);

    // Wake any timed-sleep threads on this cpu whose deadline
    // has passed (no-op when no timed sleeper is registered).
    tick_wake(cpu, now);

    // Every cpu checks every other: a watchdog that runs only on the boot cpu
    // goes blind exactly when the boot cpu is the one that is stuck.
    watchdog_check();

    // Periodic balance (see steal_work). From the tick, with interrupts off and
    // no scheduler lock held — the same conditions steal_work takes its locks
    // under on the idle path.
    if (now - cpu_last_balance_ns[cpu] >= BALANCE_NS) {
        cpu_last_balance_ns[cpu] = now;
        if (steal_work() != 0) { smp.this_cpu_set_need_resched(1); }
    }

    if (runq.current_tid() >= 0) {
        if (thread.thr_class(runq.current_tid()) == thread.SCHED_CLASS_IDLE) {
            if (runq.nr_running(cpu) > 0) { smp.this_cpu_set_need_resched(1); }
            return;
        }
    }

    if (elapsed >= thread.quantum_ns) {
        smp.this_cpu_set_need_resched(1);
    }
}

// ============================================================
// Program next LAPIC tick (§12.2)
// ============================================================

fn program_next_tick(cpu as i64) as void {
    if (lapic.calibrated == 0) { return; }

    let is i64 as now = timer.current_time_ns();
    let is i64 as next_event with mut = now + thread.quantum_ns;

    if (runq.dl_count(cpu) > 0) {
        let is i64 as lm = rb.rb_leftmost(runq.dl_root(cpu));
        if (lm != 0) {
            let is i64 as dl = rb.nd_key(lm);
            if (dl < next_event) { next_event = dl; }
        }
    }

    // This cpu's budget-throttled deadline threads: the next replenishment.
    let is i64 as t with mut = qos.dlt_heads[cpu];
    while (t != 0) {
        let is i64 as tid = t - 1;
        t = thread.thr_get(tid, thread.THR_DLT_NEXT);
        let is i64 as replenish_at = thread.thr_get(tid, 168) + thread.thr_get(tid, 144);
        if (replenish_at < next_event) { next_event = replenish_at; }
    }

    let is i64 as delta with mut = next_event - now;
    if (delta < thread.MIN_QUANTUM_NS) { delta = thread.MIN_QUANTUM_NS; }
    lapic.program_tick_ns(delta);
}

fn yield_cpu() as void { schedule(); }

// Mark the currently-running thread DEAD, drop it from the cpu's
// nr_running, and call schedule(). Never returns — the next thread
// the cpu picks runs on this cpu's stack pair from the context
// switch.
//
// Called from exception_handler when a user fault hits, and (later)
// from the exit syscall. The IRQ stub is on the IST1 stack, not the
// dying thread's kstack; schedule()'s rsp swap saves rsp into the
// dying thread's slot anyway, but since the thread is DEAD nobody
// will ever resume it, so the bogus saved rsp is harmless.
fn exit_current_thread() as void {
    asm(".byte 0xFA\n");                        // cli
    let is i64 as cpu = runq.this_cpu();
    lock.acquire(runq.sched_lock_ptr(cpu));
    let is i64 as tid = runq.current_tid();
    if (tid >= 0) {
        thread.thr_set(tid, 8, thread.THREAD_DEAD);
        runq.set_nr_running(cpu, runq.nr_running(cpu) - 1);
    }
    lock.release(runq.sched_lock_ptr(cpu));
    asm(".byte 0xFB\n");                        // sti
    schedule();
    while (1 == 1) { asm(".byte 0xF4\n"); }
}

// ============================================================
// Idle
// ============================================================

// Watchdog: each cpu's timer tick stamps its heartbeat. The BSP's
// timer additionally polls every cpu's heartbeat — if one hasn't
// ticked in WATCHDOG_THRESHOLD_NS, dump diagnostic state and halt.
// Polling from inside the timer IRQ is safe because we're already
// in IRQ context and the only I/O we do is serial.print which has
// its own ticket lock.
let is i64 as WATCHDOG_THRESHOLD_NS  = 5000000000;   // 5 s — cpu stalled
let is i64 as STARVATION_THRESHOLD_NS = 800000000;   // 800 ms — RUNNABLE not picked
let is i64 as WATCHDOG_WARM_NS       = 3000000000;   // 3 s grace at boot
let is i64 as watchdog_armed_at_ns with mut = 0;
let is i64 as watchdog_fired with mut = 0;

fn watchdog_check() as void {
    if (lock.load_word(&watchdog_fired) != 0) { return; }
    let is i64 as now = timer.current_time_ns();
    if (watchdog_armed_at_ns == 0) {
        watchdog_armed_at_ns = now + WATCHDOG_WARM_NS;
        return;
    }
    if (now < watchdog_armed_at_ns) { return; }

    let is i64 as self = runq.this_cpu();
    let is i64 as cpus = smp.get_cpu_count();
    let is i64 as ci with mut = 0;
    while (ci < cpus) {
        // Stage 1: no timer tick — a cpu stuck with interrupts off. Never this
        // cpu: we are in its tick.
        let is i64 as last = heartbeat_get(ci);
        if (ci != self && last > 0 && now - last > WATCHDOG_THRESHOLD_NS) {
            if (lock.atomic_add(&watchdog_fired, 1) == 0) {
                watchdog_dump_and_halt(ci, now - last);
            }
            return;
        }
        // Stage 2: ticking, busy, and still no switch — stuck with preemption
        // off. This cpu too: its tick still fires while it spins with
        // interrupts on, and on a single cpu there is nobody else to look. An
        // idle cpu sits in HLT and switches only when work arrives, so it is
        // left out.
        let is *smp.PerCpu as pc = smp.get_per_cpu(ci);
        if (cast(i64, pc) != 0 && pc.current_tid >= 0 && pc.current_tid != pc.idle_tid) {
            let is i64 as sw = switch_get(ci);
            if (sw > 0 && now - sw > WATCHDOG_THRESHOLD_NS) {
                if (lock.atomic_add(&watchdog_fired, 1) == 0) {
                    serial.println("", 0);
                    serial.print("=== WATCHDOG: cpu ", 18);
                    util.print_num(ci);
                    serial.print(" has not switched threads for ", 30);
                    util.print_num((now - sw) / 1000000);
                    serial.print(" ms (preempt_count=", 19);
                    util.print_num(pc.preempt_count);
                    serial.print(" current_tid=", 13);
                    util.print_num(pc.current_tid);
                    serial.println(") - stuck with preemption off ===", 33);
                    dump_threads();
                    pmm.panic("watchdog: a cpu is stuck with preemption off", 44);
                }
                return;
            }
        }
        ci = ci + 1;
    }
}

// Every thread's scheduling state on one line each — for a test that just saw
// a thread fail to make progress, so the log says who had the cpu instead.
fn dump_threads() as void {
    let is i64 as now = timer.current_time_ns();
    let is i64 as ntid = thread.next_tid;
    let is i64 as tid with mut = 0;
    while (tid < ntid) {
        if (thread.thread_ptr(tid) != 0) {
            serial.print("  tid=", 6);
            util.print_num(tid);
            serial.print(" state=", 7);
            util.print_num(thread.thr_state(tid));
            serial.print(" class=", 7);
            util.print_num(thread.thr_class(tid));
            serial.print(" band=", 6);
            util.print_num(thread.thr_band(tid));
            serial.print(" home=", 6);
            util.print_num(thread.thr_home_cpu(tid));
            serial.print(" vrt_ms=", 8);
            util.print_num(thread.thr_vruntime(tid) / 1000000);
            serial.print(" run_ms=", 8);
            util.print_num(thread.thr_runtime(tid) / 1000000);
            let is i64 as lr = thread.thr_last_run_ns(tid);
            if (lr > 0) {
                serial.print(" idle_ms=", 9);
                util.print_num((now - lr) / 1000000);
            } else {
                serial.print(" never-ran", 10);
            }
            serial.println("", 0);
        }
        tid = tid + 1;
    }
}

fn starvation_dump_and_halt(starved_tid as i64, age_ns as i64) as void {
    serial.println("", 0);
    serial.println("=== STARVATION: thread RUNNABLE but not picked ===", 50);

    serial.print("starved tid=", 12);
    util.print_num(starved_tid);
    serial.print(" age_ms=", 8);
    util.print_num(age_ns / 1000000);
    serial.print(" home_cpu=", 10);
    util.print_num(thread.thr_home_cpu(starved_tid));
    serial.print(" band=", 6);
    util.print_num(thread.thr_band(starved_tid));
    serial.print(" class=", 7);
    util.print_num(thread.thr_class(starved_tid));
    serial.println("", 0);

    let is i64 as cpus = smp.get_cpu_count();
    let is i64 as ci with mut = 0;
    while (ci < cpus) {
        let is *smp.PerCpu as pc = smp.get_per_cpu(ci);
        if (cast(i64, pc) != 0) {
            serial.print("cpu", 3);
            util.print_num(ci);
            serial.print(": current_tid=", 14);
            util.print_num(pc.current_tid);
            serial.print(" need_resched=", 14);
            util.print_num(pc.need_resched);
            serial.print(" nr_running=", 12);
            util.print_num(runq.nr_running(ci));
            serial.println("", 0);

            let is i64 as bi with mut = 0;
            while (bi < thread.NUM_QOS_BANDS) {
                let is i64 as bc = runq.band_count(ci, bi);
                if (bc > 0) {
                    serial.print("  band[", 7);
                    util.print_num(bi);
                    serial.print("]=", 2);
                    util.print_num(bc);
                    serial.println("", 0);
                }
                bi = bi + 1;
            }
        }
        ci = ci + 1;
    }

    let is i64 as now = timer.current_time_ns();
    let is i64 as ntid with mut = thread.next_tid;
    serial.print("threads (next_tid=", 18);
    util.print_num(ntid);
    serial.println("):", 2);
    let is i64 as tid with mut = 0;
    while (tid < ntid) {
        if (thread.thread_ptr(tid) != 0) {
            serial.print("  tid=", 6);
            util.print_num(tid);
            serial.print(" state=", 7);
            util.print_num(thread.thr_state(tid));
            serial.print(" class=", 7);
            util.print_num(thread.thr_class(tid));
            serial.print(" band=", 6);
            util.print_num(thread.thr_band(tid));
            serial.print(" home=", 6);
            util.print_num(thread.thr_home_cpu(tid));
            let is i64 as lr = thread.thr_last_run_ns(tid);
            if (lr > 0) {
                serial.print(" age_ms=", 8);
                util.print_num((now - lr) / 1000000);
            } else {
                serial.print(" age_ms=never", 13);
            }
            serial.println("", 0);
        }
        tid = tid + 1;
    }

    pmm.panic("starvation: a runnable thread was never picked", 46);
}

fn watchdog_dump_and_halt(stalled_cpu as i64, age_ns as i64) as void {
    serial.println("", 0);
    serial.println("=== WATCHDOG: cpu stalled ===", 29);

    serial.print("stalled cpu=", 12);
    util.print_num(stalled_cpu);
    serial.print(" age_ms=", 8);
    util.print_num(age_ns / 1000000);
    serial.println("", 0);

    let is i64 as cpus = smp.get_cpu_count();
    let is i64 as ci with mut = 0;
    while (ci < cpus) {
        let is *smp.PerCpu as pc = smp.get_per_cpu(ci);
        if (cast(i64, pc) != 0) {
            serial.print("cpu", 3);
            util.print_num(ci);
            serial.print(": current_tid=", 14);
            util.print_num(pc.current_tid);
            serial.print(" need_resched=", 14);
            util.print_num(pc.need_resched);
            serial.print(" in_irq=", 8);
            util.print_num(pc.in_irq_context);
            serial.print(" nr_running=", 12);
            util.print_num(runq.nr_running(ci));
            serial.print(" heartbeat_age_ms=", 18);
            let is i64 as hb = heartbeat_get(ci);
            if (hb > 0) {
                util.print_num((timer.current_time_ns() - hb) / 1000000);
            } else {
                serial.print("never", 5);
            }
            serial.println("", 0);

            // Per-cpu band populations
            let is i64 as bi with mut = 0;
            while (bi < thread.NUM_QOS_BANDS) {
                let is i64 as bc = runq.band_count(ci, bi);
                if (bc > 0) {
                    serial.print("  band[", 7);
                    util.print_num(bi);
                    serial.print("]=", 2);
                    util.print_num(bc);
                    serial.println("", 0);
                }
                bi = bi + 1;
            }
        }
        ci = ci + 1;
    }

    // Walk threads and print state of each. Use a snapshot of next_tid
    // taken under tid_lock so the table read is consistent.
    let is i64 as tflags = lock.acquire_irq(&thread.tid_lock);
    let is i64 as ntid = thread.next_tid;
    lock.release_irq(&thread.tid_lock, tflags);
    serial.print("threads (next_tid=", 18);
    util.print_num(ntid);
    serial.println("):", 2);
    let is i64 as tid with mut = 0;
    while (tid < ntid) {
        if (thread.thread_ptr(tid) != 0) {
            serial.print("  tid=", 6);
            util.print_num(tid);
            serial.print(" state=", 7);
            util.print_num(thread.thr_state(tid));
            serial.print(" class=", 7);
            util.print_num(thread.thr_class(tid));
            serial.print(" band=", 6);
            util.print_num(thread.thr_band(tid));
            serial.print(" home=", 6);
            util.print_num(thread.thr_home_cpu(tid));
            serial.println("", 0);
        }
        tid = tid + 1;
    }

    pmm.panic("watchdog: a cpu stopped taking its timer interrupt", 50);
}

// Free one fully-dead thread's resources: kernel stack page, FPU area,
// and the thread struct itself, and drop it from the tid table. Caller
// (reap_drain) has popped it from the reap list, so it is off-cpu — its
// kstack and CR3 are no longer live. Order matters: snapshot the fields,
// remove from the table FIRST (so any tid<next_tid scanner now skips it),
// then free the backing memory.
fn reap_one(tid as i64) as void {
    let is i64 as tptr = thread.thread_ptr(tid);
    if (tptr == 0) { return; }
    let is i64 as kstack_va = thread.thr_get(tid, 312);    // guarded kstack VA (0 if none)
    let is i64 as io_buf = thread.thr_get(tid, 320);       // per-thread I/O staging (0 if never used)
    let is i64 as fpu = thread.thr_get(tid, 240);    // fpu_state_addr
    let is i64 as kernel = thread.is_kernel_thread(tid);
    // Under tid_lock: a thread being created on another cpu writes the same
    // table, and this ran without it.
    let is i64 as tf = lock.acquire_irq(&thread.tid_lock);
    thread.tid_ht_remove(tid);
    lock.release_irq(&thread.tid_lock, tf);
    lock.atomic_add(&thread.thread_count, 0 - 1);
    if (kernel == 1) { lock.atomic_add(&thread.kthread_count, 0 - 1); }
    if (fpu != 0) { heap.kpool_free(thread.fpu_pool, fpu); }
    if (io_buf != 0) { heap.kfree(io_buf); }
    heap.kpool_free(thread.thread_pool, tptr);
    if (kstack_va != 0) { vmm.kvunmap(kstack_va); }   // guarded kstack via kvmap
}

// Drain this cpu's reap list. Pops each tid under the cpu's sched_lock
// (so a timer-IRQ-driven schedule() on the same cpu can't corrupt the
// list mid-pop), then frees outside the lock (heap/pmm/tid locks nest
// below sched_lock, never above). Runs from idle — never IRQ context,
// no lock held on entry.
fn reap_drain(cpu as i64) as void {
    let is i64 as more with mut = 1;
    while (more == 1) {
        let is i64 as f = lock.acquire_irq(runq.sched_lock_ptr(cpu));
        let is i64 as tid = runq.cpu_reap_head(cpu);
        if (tid < 0) {
            lock.release_irq(runq.sched_lock_ptr(cpu), f);
            more = 0;
        } else {
            // A tid on this list that is no longer a live object means the list
            // is corrupt — the same thread queued twice, or freed behind our
            // back. Following it would "pop" thr_get's 0-for-missing and free
            // tid 0, the boot cpu's idle thread, which is precisely the panic
            // the audit caught (a write to 0x40 inside schedule()). Stop here.
            if (thread.thread_ptr(tid) == 0 || thread.thr_state(tid) != thread.THREAD_DEAD) {
                serial.print("sched: reap list holds tid=", 27);
                util.print_num(tid);
                serial.print(" which is not a dead thread", 27);
                serial.println("", 0);
                pmm.panic("reap list corrupt", 17);
            }
            runq.set_cpu_reap_head(cpu, thread.thr_get(tid, 96));   // pop
            lock.release_irq(runq.sched_lock_ptr(cpu), f);
            reap_one(tid);
        }
    }
}

// Drain every cpu's reap list. Safe from any cpu, in any process context: a
// thread is queued on its cpu's list under that cpu's sched_lock, and the lock
// is dropped only once the switch away from it is complete (schedule() keeps
// it across the rsp/CR3 swap), so a list entry seen under the lock is off its
// stack and page tables for good. Only the cpu's own idle thread used to
// drain it — so on a cpu that never went idle (a program computing), a thread
// that ended was never freed, and a parent's wait() for the process it had
// killed timed out, the child's last thread still "live".
fn reap_drain_all() as void {
    let is i64 as nc = runq.num_cpus();
    let is i64 as c with mut = 0;
    while (c < nc) {
        if (runq.cpu_reap_head(c) >= 0) { reap_drain(c); }      // unlocked peek: a hint
        c = c + 1;
    }
}

fn idle_fn() as void {
    // APs enter with IF=0 (ap_entry deliberately does not sti before
    // calling ap_start so per_cpu_init publishes current_tid without
    // a racing timer tick). Arm IRQs here now that the cpu is fully
    // initialised, then loop sti-hlt. The BSP enters with IF=1
    // already; the sti here is a harmless no-op for it.
    asm(".byte 0xFB\n");   // sti
    while (1 == 1) {
        thread.tid_quiesce(runq.this_cpu());    // holding no tid-table pointer here
        // Nothing of our own to run: take queued work from a busier cpu.
        if (runq.nr_running(runq.this_cpu()) == 0) { steal_work(); }
        if (smp.this_cpu_need_resched() != 0) { schedule(); }
        reap_drain_all();           // free threads that died here, or on a busy cpu
        // Top up the pre-zeroed frame pool while idle (bounded per pass) so a
        // later commit's ALLOC_ZERO skips the inline page wipe. Stops early when
        // the pool is full or memory is tight.
        let is i64 as rf with mut = 0;
        while (rf < 8) {
            if (pmm.pzero_refill_one() == cast(i32, 0)) { rf = 8; }
            else { rf = rf + 1; }
        }
        asm(".byte 0xF4\n");   // hlt
    }
}

// ============================================================
// Init
// ============================================================

fn init() as void {
    serial.println("sched: init", 11);

    // Zero ALL per-cpu runqueues at once (16 cpus * 512 = 8192).
    let is *u8 as rqz = cast(*u8, &runq.per_cpu_rqs);
    let is i64 as zi with mut = 0;
    while (zi < 8192) { rqz[zi] = 0; zi = zi + 1; }

    thread.tid_ht_init(64);

    // Reap lists start empty (-1). MUST be explicit — 0 is a valid tid,
    // so a zero-initialised head would make the reaper try to free tid 0.
    let is i64 as rc with mut = 0;
    while (rc < 16) { runq.cpu_reap_heads[rc] = 0 - 1; rc = rc + 1; }

    // thread_pool / fpu_pool are created lazily on first alloc (kpool_alloc_ensure).

    // Init per-cpu band data + budgets for every possible cpu.
    let is i64 as ci with mut = 0;
    while (ci < runq.MAX_CPUS_RQ) {
        let is i64 as b with mut = 0;
        while (b < thread.NUM_QOS_BANDS) {
            runq.band_set_count(ci, b, 0);
            runq.band_set_min_vruntime(ci, b, 0);
            b = b + 1;
        }
        runq.bb_set(ci, 0, 0, 20);  runq.bb_set(ci, 0, 1, thread.QOS_WINDOW_NS); runq.bb_set(ci, 0, 2, 5); runq.bb_set(ci, 0, 3, 3);
        runq.bb_set(ci, 1, 0, 70);  runq.bb_set(ci, 1, 1, thread.QOS_WINDOW_NS); runq.bb_set(ci, 1, 2, 5); runq.bb_set(ci, 1, 3, 3);
        runq.bb_set(ci, 2, 0, 100); runq.bb_set(ci, 2, 1, thread.QOS_WINDOW_NS); runq.bb_set(ci, 2, 2, 0); runq.bb_set(ci, 2, 3, 0);
        runq.bb_set(ci, 3, 0, 100); runq.bb_set(ci, 3, 1, thread.QOS_WINDOW_NS); runq.bb_set(ci, 3, 2, 0); runq.bb_set(ci, 3, 3, 0);
        runq.bb_set(ci, 4, 0, 100); runq.bb_set(ci, 4, 1, thread.QOS_WINDOW_NS); runq.bb_set(ci, 4, 2, 0); runq.bb_set(ci, 4, 3, 0);
        runq.bb_set(ci, 5, 0, 100); runq.bb_set(ci, 5, 1, thread.QOS_WINDOW_NS); runq.bb_set(ci, 5, 2, 0); runq.bb_set(ci, 5, 3, 0);
        ci = ci + 1;
    }

    // A spinlock release that drops the last hold with a reschedule pending
    // calls back into the scheduler through this.
    lock.set_resched_hook(cast(i64, fn_ptr(preempt_resched)));

    // BSP creates its own idle here; APs do it from ap_start.
    per_cpu_init();

    serial.println("sched: ready", 12);
}

// Per-cpu scheduler bring-up. Creates this cpu's idle thread,
// pins it to this_cpu()'s runqueue, and publishes it as current +
// idle. Each cpu calls this exactly once.
fn per_cpu_init() as void {
    let is i64 as cpu = runq.this_cpu();
    fpu.fpu_cpu_init();
    // fs as this cpu came up with is whatever firmware left; make it the 0 the
    // per-cpu record says, so the first user thread with a block gets it loaded.
    smp.wrmsr(smp.IA32_FS_BASE, 0);
    smp.this_cpu_set_user_fs(0);

    // The idle thread's own stack, guarded like every kernel stack. Each cpu
    // came up on a stack the bootloader handed it, in memory the bootloader
    // still holds; enter_idle moves onto this one for good, and that is what
    // lets that memory be reclaimed. Allocated before any lock: kvmap may
    // take page-table and allocator locks of its own.
    let is i64 as istack = vmm.kvmap(thread.KSTACK_SIZE, vmm.KV_DATA, vmm.KV_GUARD, 0);
    if (istack == 0) { pmm.panic("idle stack alloc fail", 21); }
    smp.this_cpu_set_idle_stack_top(istack + thread.KSTACK_SIZE);

    let is i64 as saved_flags = lock.acquire_irq(runq.sched_lock_ptr(cpu));

    // tid + hash under tid_lock — multiple APs run per_cpu_init
    // concurrently and would otherwise race on next_tid / tid_ht.
    let is i64 as tid_flags = lock.acquire_irq(&thread.tid_lock);
    let is i64 as itid = thread.next_tid;
    let is i64 as iptr = heap.kpool_alloc_ensure(cast(i64, &thread.thread_pool), thread.THREAD_SIZE, 1);
    if (iptr == 0) { pmm.panic("idle alloc fail", 15); }
    thread.tid_set_ptr(itid, iptr);
    thread.next_tid = itid + 1;
    thread.idle_stacks = thread.idle_stacks + 1;   // global, and the APs get here together
    lock.release_irq(&thread.tid_lock, tid_flags);

    let is *u8 as tp = cast(*u8, iptr);
    let is i64 as izi with mut = 0;
    while (izi < thread.THREAD_SIZE) { tp[izi] = 0; izi = izi + 1; }

    thread.thr_set(itid, 0, itid);
    thread.thr_set(itid, 8, thread.THREAD_RUNNING);
    thread.thr_set(itid, 16, thread.SCHED_CLASS_IDLE);
    thread.thr_set(itid, 32, thread.BASE_WEIGHT);
    thread.thr_set(itid, 40, thread.DEFAULT_SLICE_NS);
    thread.thr_set(itid, 72, istack); // kstack_base: schedule() points RSP0 at its top
    thread.thr_set(itid, 256, cpu);   // home_cpu = this cpu
    thread.thr_set(itid, 280, vmm.kas_pml4_phys);  // idle runs in kernel AS

    runq.set_idle_tid(itid);
    runq.set_current_tid(itid);
    runq.set_current_start_ns(timer.current_time_ns());

    lock.release_irq(runq.sched_lock_ptr(cpu), saved_flags);
}

fn start() as void {
    sched_active = 1;
    serial.println("sched: active", 13);
    enter_idle();
}

// Leave the stack this cpu booted on and become its idle thread, on the stack
// per_cpu_init allocated for it. Never returns: the frames below — the whole
// boot path, on the BSP — are abandoned along with the old stack, and nothing
// may hold a pointer into them. RBP is cleared so a backtrace ends here
// instead of walking into memory that is about to be someone else's.
fn enter_idle() as void {
    asm(".byte 0x65, 0x48, 0x8B, 0x04, 0x25, 0x18, 0x00, 0x00, 0x00\n");    // mov rax, QWORD PTR gs:[0x18] (smp.PerCpu.idle_stack_top)
    asm("mov rsp, rax\n");
    asm("xor ebp, ebp\n");
    asm("call _kernel_task_sched_cst_idle_entry\n");
    asm(".byte 0x0F, 0x0B\n");   // ud2
}

fn idle_entry() as void {
    smp.this_cpu_mark_own_stack();
    idle_fn();
}

// Read sched_active from outside this module. APs poll this before
// entering ap_start so they don't start dispatching on a runqueue
// whose data structures (tid_ht, thread_cache, band trees) aren't
// fully set up yet. A plain load is fine — the BSP sets the flag
// long after all init writes are globally visible.
fn is_active() as i64 {
    return sched_active;
}

// External handles on sched_lock for subsystems that need
// atomic check-then-sleep against an IRQ-driven wakeup (io,
// futures, etc). Use pattern:
//
//   flags = sched.take_lock();
//   while (predicate != true) {
//     sched.sleep_locked_and_yield(flags);
//     flags = sched.take_lock();
//   }
//   sched.drop_lock(flags);
//
// `sleep_locked_and_yield` hands the lock off through
// schedule(); on resume the caller re-acquires with
// take_lock() to re-check the predicate without a race.
// take_lock acquires THIS cpu's sched_lock — io.wait_complete and
// futures wait against the cpu they are currently running on.
// sleep_locked_and_yield reads the thread's home_cpu (= this cpu)
// to drop the matching lock.
fn take_lock() as i64 {
    return lock.acquire_irq(runq.sched_lock_ptr(runq.this_cpu()));
}

fn drop_lock(saved_flags as i64) as void {
    lock.release_irq(runq.sched_lock_ptr(runq.this_cpu()), saved_flags);
}

// AP entry point into the scheduler. APs call this after they've
// loaded GDT/IDT, switched to kas_pml4_phys, enabled their LAPIC and
// programmed their local timer. Never returns.
fn ap_start() as void {
    per_cpu_init();
    sysc.init_per_cpu();
    enter_idle();
}
