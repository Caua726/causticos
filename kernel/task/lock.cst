// lock.cst — SMP-safe synchronisation primitives.
//
// Ticket spinlock: FIFO-fair, busy-wait, no heap. Two 32-bit halves
// packed into one 64-bit word so the atomic `lock xadd` on the
// acquire side updates both the ticket counter and lets us read the
// serving counter in the same instruction.
//
// Layout (low → high 64 bits):
//   [0..32]  now_serving — incremented by whoever holds the lock
//                          on release
//   [32..64] next_ticket — incremented atomically on acquire; the
//                          acquirer's ticket number is the old value
//
// The acquirer spins reading `now_serving` until it matches its
// own ticket. Each release publishes the next ticket by incrementing
// `now_serving`, which another spinner reads and proceeds.
//
// Fairness: FIFO in request order. Prevents starvation under
// contention — unlike a bare `xchg` "test-and-set" spinlock where
// the fastest cache line wins.
//
// Usage:
//   let is lock.TicketLock as my_lock;   // zero-initialised is fine
//   lock.acquire(&my_lock);
//   /* critical section */
//   lock.release(&my_lock);
//
// IRQ safety: acquire_irq / release_irq save+disable then restore
// the IF bit. Use these when the lock can be taken from both thread
// and IRQ context — otherwise a thread holding the lock can be
// preempted by an IRQ that tries to re-acquire and deadlock.
//
// Preemption: a plain acquire holds preemption off on this cpu from the
// moment the ticket is drawn until the matching release. Without that, the
// timer could switch out a thread that holds the lock — or one that has
// drawn the next ticket and is about to be served — and every later ticket
// spins behind a thread that is not running. On a cpu where the spinner
// outranks it, it never runs again: that is the disk-root freeze the audit
// caught, a WM thread parked RUNNABLE with fs_lock's next ticket while the
// thread behind it spun for good. A spinlock is for a few hundred
// instructions on a running cpu; anything held across a sleep is a
// mutex (mutex.cst), never this.
//
// The irq variants need none of this: with interrupts off there is no
// timer to preempt the holder.

// ============================================================
// Types
// ============================================================

// Single 64-bit word; zero-init = unlocked state. Kept as i64 rather
// than a struct so `lock xadd` compiles to a single atomic op against
// the low half (our ticket increment) without field-offset gymnastics.
struct TicketLock {
    word as i64;
}

// ============================================================
// Atomic ops written in inline asm. Caustic doesn't expose atomic
// intrinsics; these are the minimum needed for a correct spinlock.
// ============================================================

// Atomic primitives forwarded to smp_asm.s. Output-pointer pattern
// so Caustic's spill-offset vagaries never leak into the asm.
fn fetch_add_ticket_into(p as *i64, out as *i64) as void {
    asm("call smp_fetch_add_ticket_into\n");
}

fn fetch_add_ticket(p as *i64) as i64 {
    let is i64 as v with mut = 0;
    fetch_add_ticket_into(p, &v);
    return v;
}

// Atomic add-and-return-previous. `atomic_add(p, 1)` / `atomic_add(p, -1)`
// are the refcount primitives (KObject sharing across aspaces). Output-
// pointer pattern, same as fetch_add_ticket_into, so Caustic's spill
// offsets never leak into the asm.
fn atomic_add_into(p as *i64, delta as i64, out as *i64) as void {
    asm("call smp_atomic_add_into\n");
}

fn atomic_add(p as *i64, delta as i64) as i64 {
    let is i64 as old with mut = 0;
    atomic_add_into(p, delta, &old);
    return old;
}

fn load_word(p as *i64) as i64 {
    return *p;
}

fn inc_serving(p as *i64) as void {
    asm("call smp_inc_serving\n");
}

// ============================================================
// Public API
// ============================================================

// Preempt-count tracking. Off until the boot cpu's GS base points at its
// PerCpu (smp.init_bsp_early turns it on): before that gs:[0x78] is address
// 0x78, and nothing can preempt anyway — there is one cpu and no scheduler.
let is i64 as preempt_track with mut = 0;

// Called when a release brings the count back to zero with a reschedule
// pending. Installed by sched (lock.cst sits below it and cannot import it).
let is i64 as resched_hook with mut = 0;

fn set_resched_hook(fp as i64) as void { resched_hook = fp; }
fn enable_preempt_tracking() as void { preempt_track = 1; }

fn preempt_inc() as void { asm("call smp_preempt_inc\n"); }
fn preempt_dec() as void { asm("call smp_preempt_dec\n"); }

fn gs_load_into(off as i64, out as *i64) as void {
    asm("call smp_gs_load_into\n");
}

fn gs_load(off as i64) as i64 {
    let is i64 as v with mut = 0;
    gs_load_into(off, &v);
    return v;
}

fn rflags_into(out as *i64) as void {
    asm("call smp_rflags_into\n");
}

fn interrupts_enabled() as i64 {
    let is i64 as f with mut = 0;
    rflags_into(&f);
    if ((f & 0x200) != 0) { return 1; }
    return 0;
}

// PerCpu offsets read here (see smp.PerCpu): need_resched 0x50,
// in_irq_context 0x70, preempt_count 0x78.
fn preempt_count() as i64 {
    if (preempt_track == 0) { return 0; }
    return gs_load(0x78);
}

// The deferred half of a preemption: a tick that landed while preemption was
// held off left need_resched set and returned without switching. Take it now,
// unless something still forbids it — an enclosing spinlock, interrupt
// context, or interrupts off (schedule() ends with sti on this path, which
// would re-enable them under a caller that turned them off).
fn preempt_check() as void {
    if (resched_hook == 0) { return; }
    if (gs_load(0x78) != 0) { return; }
    if (gs_load(0x50) == 0) { return; }
    if (gs_load(0x70) != 0) { return; }
    if (interrupts_enabled() == 0) { return; }
    let is fn() as void as fp = cast(fn() as void, resched_hook);
    call(fp);
}

fn acquire(l as *TicketLock) as void {
    if (preempt_track != 0) { preempt_inc(); }
    let is i64 as ticket_word = fetch_add_ticket(&l.word);
    // My ticket is the upper 32 bits of the value that was there
    // before my increment.
    let is i64 as my_ticket = (ticket_word >> 32) & 0xFFFFFFFF;
    while (1 == 1) {
        let is i64 as w = load_word(&l.word);
        if ((w & 0xFFFFFFFF) == my_ticket) { return; }
        asm(".byte 0xF3, 0x90\n");   // pause — polite spin
    }
}

// A plain acquire that runs `poll` on every turn of the spin. For a lock whose
// holder may be waiting on THIS cpu: the TLB shootdown initiator holds its lock
// while it waits for every target's acknowledgement, and a target spinning for
// the same lock must still give one.
fn acquire_polling(l as *TicketLock, poll as i64) as void {
    if (preempt_track != 0) { preempt_inc(); }
    let is i64 as ticket_word = fetch_add_ticket(&l.word);
    let is i64 as my_ticket = (ticket_word >> 32) & 0xFFFFFFFF;
    let is fn() as void as pf = cast(fn() as void, poll);
    while (1 == 1) {
        let is i64 as w = load_word(&l.word);
        if ((w & 0xFFFFFFFF) == my_ticket) { return; }
        call(pf);
        asm(".byte 0xF3, 0x90\n");   // pause
    }
}

fn mfence() as void { asm("call smp_mfence\n"); }

fn release(l as *TicketLock) as void {
    inc_serving(&l.word);
    if (preempt_track != 0) {
        preempt_dec();
        preempt_check();
    }
}

// The irq variants keep the preempt count out of it: interrupts are off for
// the whole hold, so nothing can preempt, and acquire_irq's flags cookie is
// what restores the cpu's state afterwards.
fn acquire_raw(l as *TicketLock) as void {
    let is i64 as ticket_word = fetch_add_ticket(&l.word);
    let is i64 as my_ticket = (ticket_word >> 32) & 0xFFFFFFFF;
    while (1 == 1) {
        let is i64 as w = load_word(&l.word);
        if ((w & 0xFFFFFFFF) == my_ticket) { return; }
        asm(".byte 0xF3, 0x90\n");   // pause — polite spin
    }
}

fn release_raw(l as *TicketLock) as void {
    inc_serving(&l.word);
}

// ============================================================
// IRQ-safe variants. Use these whenever the lock is reachable from
// an interrupt handler. Returns the pre-disable IF flag as a cookie
// the matching release_irq restores.
// ============================================================

fn save_cli_into(out as *i64) as void {
    asm("call smp_save_cli_into\n");
}

fn acquire_irq(l as *TicketLock) as i64 {
    let is i64 as flags with mut = 0;
    save_cli_into(&flags);
    acquire_raw(l);
    return flags;
}

// Pass `flags` through rdi by positioning it as the first argument of
// a trivial wrapper. Caustic keeps rdi = arg0 live at entry so the
// direct `call smp_restore` gets the right value.
fn restore_flags(flags as i64) as void {
    asm("call smp_restore\n");
}

fn release_irq(l as *TicketLock, flags as i64) as void {
    release_raw(l);
    restore_flags(flags);
}

// ============================================================
// Test-only: expose the current state so smoke tests can assert
// counters. Not called from hot paths.
// ============================================================

fn is_contended(l as *TicketLock) as i32 {
    let is i64 as w = load_word(&l.word);
    let is i64 as serving = w & 0xFFFFFFFF;
    let is i64 as next    = (w >> 32) & 0xFFFFFFFF;
    if (next - serving > 1) { return 1; }
    return 0;
}
