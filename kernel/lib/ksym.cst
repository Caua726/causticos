// ksym.cst — kernel symbol table (Phase 2.3).
//
// Maps human-readable names (e.g. "dummybus.dummy_bind") to runtime
// addresses. Populated at boot by each module's register() function
// and queried by the .cdvrspec parser when resolving lifecycle
// callback names like `on_bind: dummybus.dummy_bind`.
//
// Storage model (Phase 2.3): singly-linked list rooted at `ksyms`,
// each KSym statically allocated in the driver's module (BSS) and
// linked in via ksym.register(&sym). A future optimisation can move
// entries into `.ksym_table` with section() and iterate via the
// linker-provided __start_/__stop_ markers — infrastructure intentionally
// kept simple for now.
//
// The panic path does NOT use this list to name addresses: it holds a few
// driver callbacks, and "the nearest of those below the rip" named a fault in
// main.cst after ahci_irq, 360 KB away. Names for the panic path come from the
// whole-kernel table below (load_table / describe).

use "lock.cst" as lock;
use "serial.cst" as serial;
use "util.cst" as util;
use "limine.cst" as limine;
use "pmm.cst" as pmm;

// --- Symbol kinds ---
let is i64 as KIND_FUNC = 1;
let is i64 as KIND_DATA = 2;

struct KSym {
    name_ptr as *u8;    // points into rodata; owned by the declaring module
    name_len as i64;
    addr as i64;
    kind as i64;
    next as *KSym;
}

let is i64 as ksyms with mut = 0;       // head of registered symbols
let is lock.TicketLock as ksym_lk with mut;
let is i64 as ksym_count with mut = 0;

// Register a symbol. `s` must be a statically-allocated KSym (BSS or
// with section) so the pointer stays valid for the lifetime of the kernel.
// Returns 0 on success, -1 on invalid input, -2 for a name that is already
// registered. A duplicate used to be accepted and to win every later lookup —
// a second driver reusing a name silently took over the first one's spec
// callbacks — so it is refused, by name, and the first registration stands.
fn register(s as *KSym) as i32 {
    if (cast(i64, s) == 0) { return cast(i32, 0 - 1); }
    if (cast(i64, s.name_ptr) == 0) { return cast(i32, 0 - 1); }
    // The duplicate check and the push under one hold of ksym_lk, or two
    // registrations of one name racing on two cpus would both pass the check.
    lock.acquire(&ksym_lk);
    if (lookup(s.name_ptr, s.name_len) != 0) {
        lock.release(&ksym_lk);
        serial.print("ksym: duplicate symbol ", 23);
        serial.print(s.name_ptr, s.name_len);
        serial.println(" - refused, the first registration stands", 41);
        return cast(i32, 0 - 2);
    }
    s.next = cast(*KSym, ksyms);
    ksyms = cast(i64, s);
    ksym_count = ksym_count + 1;
    lock.release(&ksym_lk);
    return 0;
}

// Byte-exact compare of two raw name slices.
fn names_eq(a as *u8, a_len as i64, b as *u8, b_len as i64) as i32 {
    if (a_len != b_len) { return 0; }
    let is i64 as i with mut = 0;
    while (i < a_len) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// Lookup returns the registered address, or 0 if no match. Callers treat
// 0 as "not found" — registering a symbol with addr==0 is therefore a
// programming error.
fn lookup(name as *u8, name_len as i64) as i64 {
    let is *KSym as s with mut = cast(*KSym, ksyms);
    while (cast(i64, s) != 0) {
        if (names_eq(s.name_ptr, s.name_len, name, name_len) == 1) {
            return s.addr;
        }
        s = s.next;
    }
    return 0;
}

// Convenience: lookup by C-style null-terminated string. Bounded to
// 256 bytes so a corrupted / non-null-terminated input can't walk the
// kernel heap into a fault.
fn lookup_cstr(name as *u8) as i64 {
    let is i64 as len with mut = 0;
    while (len < 256) {
        if (name[len] == cast(u8, 0)) { len = 256; }
        else { len = len + 1; }
    }
    if (len == 256) { return 0; }   // unterminated within limit — treat as not found
    return lookup(name, len);
}

// ============================================================
// The whole-kernel table (scripts/mksym.py → /boot/kernel.sym)
// ============================================================
//
// Every function's address and name, from the linker map, loaded by Limine as
// a module beside the kernel. Read-only after load_table, and read without a
// lock — by the panic path, after every other cpu has stopped.

let is i64 as TAB_HDR = 32;
let is i64 as TAB_ENTRY = 16;
let is i64 as tab_base with mut = 0;      // HHDM address of the module; 0 = none
let is i64 as tab_size with mut = 0;
let is i64 as tab_count with mut = 0;
let is i64 as tab_text_end with mut = 0;

fn rd64(p as i64) as i64 {
    let is *i64 as q = cast(*i64, p);
    return q[0];
}

fn rd32(p as i64) as i64 {
    let is *u8 as b = cast(*u8, p);
    return cast(i64, b[0]) | (cast(i64, b[1]) << 8) | (cast(i64, b[2]) << 16) | (cast(i64, b[3]) << 24);
}

fn is_table(a as i64, size as i64) as i64 {
    if (size < TAB_HDR) { return 0; }
    let is *u8 as m = cast(*u8, a);
    let is *u8 as want = cast(*u8, "CKSYMTAB");
    let is i64 as i with mut = 0;
    while (i < 8) {
        if (m[i] != want[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// Index of the last entry at or below addr, -1 if none. Binary search.
fn entry_at_or_below(addr as i64) as i64 {
    let is i64 as lo with mut = 0;
    let is i64 as hi with mut = tab_count - 1;
    let is i64 as best with mut = 0 - 1;
    while (lo <= hi) {
        let is i64 as mid = lo + (hi - lo) / 2;
        if (rd64(tab_base + TAB_HDR + mid * TAB_ENTRY) <= addr) {
            best = mid;
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    return best;
}

fn entry_name_eq(e as i64, lit as *u8, lit_len as i64) as i64 {
    let is i64 as ep = tab_base + TAB_HDR + e * TAB_ENTRY;
    if (rd32(ep + 12) != lit_len) { return 0; }
    let is *u8 as nm = cast(*u8, tab_base + rd32(ep + 8));
    return cast(i64, names_eq(nm, lit_len, lit, lit_len));
}

// Find the table among the boot modules (by content, like ramvol: the order
// modules arrive in is the bootloader's business), check it is whole, and
// check it belongs to THIS kernel — the entry at load_table's own address must
// be named load_table. A table from another build would name every address
// wrongly, which is worse than naming none.
fn load_table() as void {
    let is i64 as n = limine.module_count();
    let is i64 as i with mut = 0;
    while (i < n) {
        let is *u8 as f = limine.module_at(i);
        let is i64 as a = pmm.to_hhdm(limine.file_address(f));
        let is i64 as size = limine.file_size(f);
        if (a != 0 && pmm.is_hhdm_mapped(a) != 0 && is_table(a, size) != 0) {
            let is i64 as count = rd64(a + 16);
            if (rd64(a + 8) != 1 || count <= 0 || TAB_HDR + count * TAB_ENTRY > size) {
                serial.println("ksym: kernel.sym is malformed - ignored", 39);
                return;
            }
            tab_base = a;
            tab_size = size;
            tab_count = count;
            tab_text_end = rd64(a + 24);
            let is i64 as me = cast(i64, fn_ptr(load_table));
            let is i64 as e = entry_at_or_below(me);
            if (e < 0 || rd64(tab_base + TAB_HDR + e * TAB_ENTRY) != me
                || entry_name_eq(e, cast(*u8, "ksym.load_table"), 15) == 0) {
                tab_base = 0;
                tab_count = 0;
                serial.println("ksym: kernel.sym is from a different build - ignored", 52);
                return;
            }
            serial.print("ksym: ", 6);
            util.print_num(count);
            serial.println(" function names from kernel.sym", 31);
            return;
        }
        i = i + 1;
    }
    serial.println("ksym: no kernel.sym module - faults will show bare addresses", 60);
}

// The function containing addr: its name (pointer and length into the table)
// and addr's offset into it. 1 if found; 0 when there is no table or addr is
// not in kernel text.
fn describe(addr as i64, name_out as *i64, len_out as *i64, off_out as *i64) as i64 {
    if (tab_base == 0 || addr >= tab_text_end) { return 0; }
    let is i64 as e = entry_at_or_below(addr);
    if (e < 0) { return 0; }
    let is i64 as ep = tab_base + TAB_HDR + e * TAB_ENTRY;
    let is i64 as no = rd32(ep + 8);
    let is i64 as nl = rd32(ep + 12);
    if (no + nl > tab_size) { return 0; }
    name_out[0] = tab_base + no;
    len_out[0] = nl;
    off_out[0] = addr - rd64(ep);
    return 1;
}

// " name+0xoff" for addr, or nothing when it cannot be named.
fn print_symbol(addr as i64) as void {
    let is i64 as np with mut = 0;
    let is i64 as nl with mut = 0;
    let is i64 as off with mut = 0;
    if (describe(addr, &np, &nl, &off) == 0) { return; }
    serial.print(" ", 1);
    serial.print(cast(*u8, np), nl);
    serial.print("+", 1);
    util.print_hex_short(off);
}

fn dump() as void {
    serial.print("ksym: ", 6);
    let is *KSym as s with mut = cast(*KSym, ksyms);
    let is i64 as n with mut = 0;
    while (cast(i64, s) != 0) { n = n + 1; s = s.next; }
    // minimal count print to confirm population; full dump deferred.
    if (n > 99) {
        serial.print("(>99 syms)", 10);
    } else {
        let is [3]u8 as buf;
        buf[0] = cast(u8, (n / 10) + 48);
        buf[1] = cast(u8, (n % 10) + 48);
        buf[2] = cast(u8, 32);
        serial.print(&buf[0], 3);
    }
    serial.println("symbols", 7);
}
