// sched.cst — Full scheduler: EEVDF, deadline (EDF+CBS), anti-abuse, preemption
// Based on causticos_sched_spec_v1
//
// Lock ordering (§17):
//   deadline_tree.lock < qos_band.lock < cpu_runqueue.lock < global_capabilities.lock
//   V1 single-CPU: all protected by IRQ disable. Locks become spinlocks for SMP.
//
// Thread allocation: kcache for structs + open-addressing hash table for
// TID→Thread* lookup. Hash table grows dynamically (doubles at 75% load).
// Thread count limited only by available memory.

use "serial.cst" as serial;
use "pmm.cst" as pmm;
use "heap.cst" as heap;
use "timer.cst" as timer;
use "util.cst" as util;
use "rbtree.cst" as rb;
use "lapic.cst" as lapic;
use "smp.cst" as smp;
use "lock.cst" as lock;
use "vmm.cst" as vmm;
use "gdt.cst" as gdt;
use "syscall.cst" as sysc;

// ============================================================
// Constants
// ============================================================

// Thread states (§15)
let is i64 as THREAD_RUNNING   = 1;
let is i64 as THREAD_RUNNABLE  = 2;
let is i64 as THREAD_SLEEPING  = 3;
let is i64 as THREAD_SUSPENDED = 4;
let is i64 as THREAD_DEAD      = 5;

// Scheduling classes (§4)
let is i64 as SCHED_CLASS_DEADLINE = 0;
let is i64 as SCHED_CLASS_QOS     = 1;
let is i64 as SCHED_CLASS_IDLE    = 2;

// QoS bands (§4.2.1)
let is i64 as QOS_INPUT        = 0;
let is i64 as QOS_RENDER       = 1;
let is i64 as QOS_ACTIVE       = 2;
let is i64 as QOS_NORMAL       = 3;
let is i64 as QOS_BATCH        = 4;
let is i64 as QOS_LAZY         = 5;
let is i64 as NUM_QOS_BANDS    = 6;

// QoS budget enforcement window (§7.2): 1 second in ns
let is i64 as QOS_WINDOW_NS    = 1000000000;

// EEVDF (§5)
let is i64 as BASE_WEIGHT      = 1024;
let is i64 as DEFAULT_SLICE_NS = 5000000;
let is i64 as SLEEPER_BONUS_NS with mut = 2500000;  // configurable (§5.4)

// Quantum (§13) — mutable, configurable
let is i64 as MIN_QUANTUM_NS   = 1000000;
let is i64 as MAX_QUANTUM_NS   = 100000000;
let is i64 as quantum_ns with mut = 5000000;

// Deadline (§6) — configurable
let is i64 as MAX_DL_UTIL_PCT with mut = 70;

// Capabilities (§8)
let is i64 as CAP_SCHED_REALTIME = 1;
let is i64 as CAP_SCHED_INPUT    = 2;
let is i64 as CAP_SCHED_RENDER   = 4;
let is i64 as CAP_SCHED_AFFINITY = 8;

// Kernel stack
let is i64 as KSTACK_SIZE      = 8192;
let is i64 as MAX_THREADS      = 64;

// FPU state size (fxsave = 512 bytes)
let is i64 as FPU_STATE_SIZE   = 512;

// ============================================================
// Thread struct — 384 bytes
// ============================================================
// 0    tid              i64
// 8    state            i64
// 16   sched_class      i64
// 24   qos_band         i64
// 32   weight           i64
// 40   slice_ns         i64
// 48   vruntime         i64
// 56   virtual_deadline i64
// 64   kstack_top       i64   (saved RSP)
// 72   kstack_base      i64
// 80   entry_fn         i64
// 88   total_runtime_ns i64
// 96   next_tid         i64   (run list / deadline list)
// 104  prev_tid         i64
// 112  lag              i64
// 120  voluntary_sw     i64
// 128  forced_sw        i64
// --- Deadline class (§6) ---
// 136  dl_runtime_ns    i64
// 144  dl_period_ns     i64
// 152  dl_deadline_ns   i64
// 160  dl_budget_left   i64
// 168  dl_period_start  i64
// 176  dl_abs_deadline  i64
// --- Anti-abuse (§7) ---
// 184  cpu_used_window  i64
// 192  window_start_ns  i64
// 200  band_violations  i64
// 208  band_below_count i64
// 216  original_qos_band i64
// 224  capabilities     i64
// --- FPU (§14.2) ---
// 232  fpu_dirty        i64
// 240  fpu_state_addr   i64   (pointer to 512-byte fxsave area, 16-aligned)
// --- Process link ---
// 248  process_ptr      i64   (ptr to owning Process)
// 256  home_cpu         i64   (cpu owning this thread's runqueue)
// 264  last_run_ns      i64   (monotonic when this thread last started running)
// 272  sleep_until_ns   i64   (timer-driven wakeup deadline; 0 = no auto-wake)
// --- User-thread link ---
// 280  aspace_pml4      i64   (user PML4 phys; kernel AS for kernel threads)
// 288  user_entry       i64   (ring-3 RIP)
// 296  user_rsp         i64   (ring-3 RSP)
// 304  aspace_ptr       i64   (*vma.Aspace; 0 for kernel threads)
// 312  reserved         72 bytes
// Total: 384

let is i64 as THREAD_SIZE = 384;
// Dynamic thread allocation via kcache
let is i64 as thread_cache with mut = 0;

// TID → Thread* hash table (open addressing, power-of-2 size)
// Each slot: [tid (i64), ptr (i64)] = 16 bytes. tid = -1 means empty.
let is i64 as tid_ht_buf with mut = 0;     // kmalloc'd buffer
let is i64 as tid_ht_cap with mut = 0;     // capacity (power of 2)
let is i64 as tid_ht_count with mut = 0;   // entries used
let is i64 as TID_HT_EMPTY = 0 - 1;       // sentinel for empty slot

let is i64 as thread_count with mut = 0;
let is i64 as next_tid with mut = 0;

// Global lock protecting next_tid + the tid hash table. Pre-per-cpu
// runqueue, the global sched_lock served this duty implicitly. Now
// every cpu has its own runqueue lock and APs run per_cpu_init
// concurrently, so the tid allocator needs its own serialiser.
// Held briefly (a kmalloc + handful of writes), nests INSIDE any
// per-cpu sched_lock. Order: sched_lock(cpu) > tid_lock > heap_lock.
let is lock.TicketLock as tid_lock with mut;

fn tid_ht_init(cap as i64) as void {
    let is i64 as size = cap * 16;
    tid_ht_buf = heap.kmalloc(size, pmm.ALLOC_ZERO);
    if (tid_ht_buf == 0) { pmm.panic("tid_ht alloc fail", 17); }
    tid_ht_cap = cap;
    tid_ht_count = 0;
    // Mark all slots empty
    let is i64 as i with mut = 0;
    while (i < cap) {
        let is *i64 as slot = cast(*i64, tid_ht_buf + i * 16);
        slot[0] = TID_HT_EMPTY;
        i = i + 1;
    }
}

fn tid_ht_grow() as void {
    let is i64 as old_buf = tid_ht_buf;
    let is i64 as old_cap = tid_ht_cap;
    let is i64 as new_cap = old_cap * 2;
    let is i64 as new_buf = heap.kmalloc(new_cap * 16, pmm.ALLOC_ZERO);
    if (new_buf == 0) { pmm.panic("tid_ht grow fail", 16); }

    // Mark new slots empty
    let is i64 as i with mut = 0;
    while (i < new_cap) {
        let is *i64 as slot = cast(*i64, new_buf + i * 16);
        slot[0] = TID_HT_EMPTY;
        i = i + 1;
    }

    // Rehash old entries
    tid_ht_buf = new_buf;
    tid_ht_cap = new_cap;
    tid_ht_count = 0;
    i = 0;
    while (i < old_cap) {
        let is *i64 as slot = cast(*i64, old_buf + i * 16);
        if (slot[0] != TID_HT_EMPTY) {
            tid_set_ptr(slot[0], slot[1]);
        }
        i = i + 1;
    }
    heap.kfree(old_buf);
}

fn tid_set_ptr(tid as i64, ptr as i64) as void {
    // Grow if > 75% full
    if (tid_ht_count * 4 >= tid_ht_cap * 3) {
        tid_ht_grow();
    }
    let is i64 as mask = tid_ht_cap - 1;
    let is i64 as idx with mut = tid & mask;
    let is i64 as done with mut = 0;
    while (done == 0) {
        let is *i64 as slot = cast(*i64, tid_ht_buf + idx * 16);
        if (slot[0] == TID_HT_EMPTY) {
            slot[0] = tid;
            slot[1] = ptr;
            tid_ht_count = tid_ht_count + 1;
            done = 1;
        } else {
            if (slot[0] == tid) {
                slot[1] = ptr;  // update existing
                done = 1;
            } else {
                idx = (idx + 1) & mask;  // linear probe
            }
        }
    }
}

fn thread_ptr(tid as i64) as i64 {
    let is i64 as mask = tid_ht_cap - 1;
    let is i64 as idx with mut = tid & mask;
    let is i64 as checked with mut = 0;
    while (checked < tid_ht_cap) {
        let is *i64 as slot = cast(*i64, tid_ht_buf + idx * 16);
        if (slot[0] == TID_HT_EMPTY) { return 0; }  // not found
        if (slot[0] == tid) { return slot[1]; }
        idx = (idx + 1) & mask;
        checked = checked + 1;
    }
    return 0;  // not found
}

// thr_get/thr_set go through thread_ptr which returns 0 when the
// tid isn't (yet) in the hash table. Without the null-guard the
// dereference turns `0 + off` into a low-address read/write and page-
// faults. The usual trigger was a LAPIC timer IRQ landing inside
// create_thread / sched.init between `next_tid = next_tid + 1` and
// the matching `tid_set_ptr`: scanners like dl_check_replenish and
// program_next_tick iterate `tid < next_tid` and hit the half-
// published slot. Returning 0 / no-op is the correct fallback — the
// slot is transiently invalid, not corrupt.
fn thr_get(tid as i64, off as i64) as i64 {
    let is i64 as base = thread_ptr(tid);
    if (base == 0) { return 0; }
    let is *i64 as p = cast(*i64, base + off);
    return p[0];
}

fn thr_set(tid as i64, off as i64, v as i64) as void {
    let is i64 as base = thread_ptr(tid);
    if (base == 0) { return; }
    let is *i64 as p = cast(*i64, base + off);
    p[0] = v;
}

fn thr_state(tid as i64) as i64         { return thr_get(tid, 8); }
fn thr_class(tid as i64) as i64         { return thr_get(tid, 16); }
fn thr_band(tid as i64) as i64          { return thr_get(tid, 24); }
fn thr_weight(tid as i64) as i64        { return thr_get(tid, 32); }
fn thr_slice(tid as i64) as i64         { return thr_get(tid, 40); }
fn thr_vruntime(tid as i64) as i64      { return thr_get(tid, 48); }
fn thr_vdeadline(tid as i64) as i64     { return thr_get(tid, 56); }
fn thr_kstack_top(tid as i64) as i64    { return thr_get(tid, 64); }
fn thr_kstack_base(tid as i64) as i64   { return thr_get(tid, 72); }
fn thr_entry(tid as i64) as i64         { return thr_get(tid, 80); }
fn thr_runtime(tid as i64) as i64       { return thr_get(tid, 88); }
fn thr_next(tid as i64) as i64          { return thr_get(tid, 96); }
fn thr_prev(tid as i64) as i64          { return thr_get(tid, 104); }
fn thr_lag(tid as i64) as i64           { return thr_get(tid, 112); }
fn thr_dl_budget(tid as i64) as i64     { return thr_get(tid, 160); }
fn thr_dl_abs_dl(tid as i64) as i64     { return thr_get(tid, 176); }
fn thr_caps(tid as i64) as i64          { return thr_get(tid, 224); }
fn thr_home_cpu(tid as i64) as i64      { return thr_get(tid, 256); }
fn thr_last_run_ns(tid as i64) as i64   { return thr_get(tid, 264); }
fn thr_sleep_until_ns(tid as i64) as i64 { return thr_get(tid, 272); }
// Address space the thread runs against. Kernel threads share
// vmm.kas_pml4_phys (set by create_thread); user threads carry the
// pml4_phys handed back by vmm.as_create. Read on every context
// switch — if it differs from the cpu's current CR3, we reload.
fn thr_aspace_pml4(tid as i64) as i64   { return thr_get(tid, 280); }
// User entry / stack — meaningful only for user threads. The kernel
// trampoline reads these on first dispatch and IRETQs to ring 3.
fn thr_user_entry(tid as i64) as i64    { return thr_get(tid, 288); }
fn thr_user_rsp(tid as i64) as i64      { return thr_get(tid, 296); }
// *vma.Aspace for this user thread (as i64). Syscall handlers need the
// Aspace pointer — not just pml4 — to call mmap/fd_* against it. Stored
// at create time, before the thread becomes runnable. 0 for kernel threads.
fn thr_aspace_ptr(tid as i64) as i64    { return thr_get(tid, 304); }

// ============================================================
// Per-band data
// ============================================================

// ============================================================
// CpuRunqueue (§9) — PER-CPU scheduling state
// One 512-byte runqueue per cpu, indexed by cpu_id. Each cpu owns
// its own dl_root / band_roots / band_counts etc, so schedule()
// only contends on its OWN cpu's sched_lock — no global lock,
// no cross-cpu cache-line ping-pong on the hot path.
// ============================================================
// Layout (512 bytes), per cpu:
// 0    cpu_id           i64
// 8    dl_root          i64   (RB tree root)
// 16   dl_count         i64
// 24   reserved         i64   (was current_tid; now in PerCpu)
// 32   reserved         i64   (was current_start_ns; now in PerCpu)
// 40   reserved         i64   (was idle_tid; now in PerCpu)
// 48   nr_running       i64   (count for THIS cpu only)
// 56   nr_switches      i64   (count for THIS cpu only)
// 64   reserved         i64   (was fpu_owner_tid; now in PerCpu)
// 72   band_roots[6]    48 bytes
// 120  band_counts[6]   48 bytes
// 168  band_min_vrt[6]  48 bytes
// 216  band_budgets[6]  192 bytes (6 * 4 * i64)
// 408  reserved         104 bytes
// Total: 512

let is i64 as RQ_SIZE = 512;
let is i64 as MAX_CPUS_RQ = 16;
let is [8192]u8 as per_cpu_rqs;            // 16 cpus * 512 bytes

// Per-cpu sched lock array — schedule on cpu X holds X's lock,
// wakeup_thread targeting cpu X also holds X's lock. Lock is
// IRQ-safe: acquire_irq disables IRQs locally then takes the
// ticket. Two cpus rescheduling in parallel never serialise on
// each other.
let is [16]lock.TicketLock as per_cpu_sched_locks with mut;

fn rq_ptr(cpu as i64) as i64 {
    return cast(i64, &per_cpu_rqs) + cpu * RQ_SIZE;
}

// Pointer to a specific cpu's sched_lock for lock.acquire_irq.
fn sched_lock_ptr(cpu as i64) as *lock.TicketLock {
    return &per_cpu_sched_locks[cpu];
}

// This-cpu shorthand: most schedule() / pick_next() / runlist_*
// callers operate on the cpu currently executing them.
fn this_cpu() as i64 {
    let is *smp.PerCpu as p = smp.current_cpu();
    return p.cpu_id;
}
fn this_rq_ptr() as i64 { return rq_ptr(this_cpu()); }

fn rq_get(cpu as i64, off as i64) as i64 {
    let is *i64 as p = cast(*i64, rq_ptr(cpu) + off);
    return p[0];
}

fn rq_set(cpu as i64, off as i64, v as i64) as void {
    let is *i64 as p = cast(*i64, rq_ptr(cpu) + off);
    p[0] = v;
}

// Named accessors — all take the target cpu_id.
fn dl_root(cpu as i64) as i64       { return rq_get(cpu, 8); }
fn dl_root_ptr(cpu as i64) as i64   { return rq_ptr(cpu) + 8; }
fn dl_count(cpu as i64) as i64      { return rq_get(cpu, 16); }
fn dl_set_count(cpu as i64, v as i64) as void { rq_set(cpu, 16, v); }

// current_tid / current_start_ns / idle_tid / fpu_owner_tid live
// in smp.PerCpu (always per-cpu, no need to mirror in the rq).
fn current_tid() as i64               { return smp.this_cpu_current_tid(); }
fn set_current_tid(v as i64) as void  { smp.this_cpu_set_current_tid(v); }
fn current_start_ns() as i64          { return smp.this_cpu_current_start_ns(); }
fn set_current_start_ns(v as i64) as void { smp.this_cpu_set_current_start_ns(v); }
fn idle_tid() as i64                  { return smp.this_cpu_idle_tid(); }
fn set_idle_tid(v as i64) as void     { smp.this_cpu_set_idle_tid(v); }
fn fpu_owner_tid() as i64             { return smp.this_cpu_fpu_owner_tid(); }
fn set_fpu_owner_tid(v as i64) as void { smp.this_cpu_set_fpu_owner_tid(v); }

fn nr_running(cpu as i64) as i64           { return rq_get(cpu, 48); }
fn set_nr_running(cpu as i64, v as i64) as void { rq_set(cpu, 48, v); }
fn nr_switches(cpu as i64) as i64          { return rq_get(cpu, 56); }
fn set_nr_switches(cpu as i64, v as i64) as void { rq_set(cpu, 56, v); }

fn band_root_ptr(cpu as i64, b as i64) as i64 { return rq_ptr(cpu) + 72 + b * 8; }
fn band_root(cpu as i64, b as i64) as i64 {
    let is *i64 as p = cast(*i64, rq_ptr(cpu) + 72);
    return p[b];
}
fn band_count(cpu as i64, b as i64) as i64 {
    let is *i64 as p = cast(*i64, rq_ptr(cpu) + 120);
    return p[b];
}
fn band_set_count(cpu as i64, b as i64, v as i64) as void {
    let is *i64 as p = cast(*i64, rq_ptr(cpu) + 120);
    p[b] = v;
}
fn band_min_vruntime(cpu as i64, b as i64) as i64 {
    let is *i64 as p = cast(*i64, rq_ptr(cpu) + 168);
    return p[b];
}
fn band_set_min_vruntime(cpu as i64, b as i64, v as i64) as void {
    let is *i64 as p = cast(*i64, rq_ptr(cpu) + 168);
    p[b] = v;
}

// Band budgets (per cpu).
fn bb_get(cpu as i64, band as i64, field as i64) as i64 {
    let is *i64 as p = cast(*i64, rq_ptr(cpu) + 216 + band * 32);
    return p[field];
}
fn bb_set(cpu as i64, band as i64, field as i64, v as i64) as void {
    let is *i64 as p = cast(*i64, rq_ptr(cpu) + 216 + band * 32);
    p[field] = v;
}

// ============================================================
// Global scheduling state (not per-CPU)
// ============================================================

let is i64 as sched_active with mut = 0;

let is i64 as switch_rsp with mut = 0;
// ctx_old_rsp_ptr / ctx_new_rsp live in smp.PerCpu now (offsets
// 0x58 / 0x60). schedule()'s switch asm reads them via gs:[..]
// so a concurrent switch on another cpu can't stomp our scratch
// between the store and the mov-rsp pair.

// Preempt count lives in smp.PerCpu now — accessed via
// smp.this_cpu_{,set_}preempt_count. Keeping it global would race
// across cpus even though the intent is per-cpu.

// Per-cpu sched locks live in `per_cpu_sched_locks` above. Each
// schedule() call takes its own cpu's lock; cross-cpu interactions
// (wakeup_thread targeting another cpu, create_thread placing a
// new thread on a remote cpu) acquire the *target* cpu's lock.
// No single global serialises the scheduler hot path now.
//
// Lock handoff during context switch: schedule on cpu X holds X's
// lock across the rsp swap, and the resuming side (either
// thread_entry_trampoline for new threads or .Lresume for
// previously-suspended threads) is responsible for dropping it.
// Both new and resumed threads always run on the cpu whose lock
// is currently held — schedule() never moves a thread cross-cpu.

fn band_weight(b as i64) as i64 {
    if (b == QOS_BATCH) { return 512; }
    if (b == QOS_LAZY)  { return 256; }
    return BASE_WEIGHT;
}

// ============================================================
// Preempt disable/enable (§11.5)
// ============================================================

fn preempt_disable() as void {
    smp.this_cpu_set_preempt_count(smp.this_cpu_preempt_count() + 1);
}

fn preempt_enable() as void {
    smp.this_cpu_set_preempt_count(smp.this_cpu_preempt_count() - 1);
    if (smp.this_cpu_preempt_count() == 0) {
        if (smp.this_cpu_in_irq_context() == 0) {
            if (smp.this_cpu_need_resched() != 0) {
                schedule();
            }
        }
    }
}

fn cond_resched() as void {
    if (smp.this_cpu_preempt_count() > 0) { return; }
    if (smp.this_cpu_in_irq_context() != 0) { return; }
    if (smp.this_cpu_need_resched() != 0) {
        schedule();
    }
}

// ============================================================
// Run list operations (QoS bands, sorted by virtual_deadline)
// ============================================================

// RB tree insert/remove for QoS bands (keyed by virtual_deadline).
// Per-cpu: caller passes cpu_id of the runqueue that owns tid.
fn runlist_insert(cpu as i64, band as i64, tid as i64) as void {
    rb.rb_insert(band_root_ptr(cpu, band), thr_vdeadline(tid), tid);
    band_set_count(cpu, band, band_count(cpu, band) + 1);
}

fn runlist_remove(cpu as i64, band as i64, tid as i64) as void {
    let is i64 as node = rb.rb_find_by_val(band_root(cpu, band), tid);
    if (node != 0) {
        rb.rb_delete(band_root_ptr(cpu, band), node);
        band_set_count(cpu, band, band_count(cpu, band) - 1);
    }
}

// ============================================================
// Deadline list (sorted by dl_abs_deadline, ascending) — §6.5
// Reuses next_tid/prev_tid fields (a thread is in ONE list at a time)
// ============================================================

// RB tree insert/remove for deadline class (keyed by dl_abs_deadline).
// Per-cpu: caller passes cpu_id of the runqueue.
fn dl_insert(cpu as i64, tid as i64) as void {
    rb.rb_insert(dl_root_ptr(cpu), thr_dl_abs_dl(tid), tid);
    dl_set_count(cpu, dl_count(cpu) + 1);
}

fn dl_remove(cpu as i64, tid as i64) as void {
    let is i64 as node = rb.rb_find_by_val(dl_root(cpu), tid);
    if (node != 0) {
        rb.rb_delete(dl_root_ptr(cpu), node);
        dl_set_count(cpu, dl_count(cpu) - 1);
    }
}

// ============================================================
// EEVDF helpers
// ============================================================

fn update_band_min_vruntime(cpu as i64, band as i64) as void {
    let is i64 as lm = rb.rb_leftmost(band_root(cpu, band));
    if (lm != 0) {
        let is i64 as tid = rb.nd_val(lm);
        let is i64 as hv = thr_vruntime(tid);
        if (hv > band_min_vruntime(cpu, band)) {
            band_set_min_vruntime(cpu, band, hv);
        }
    }
}

fn update_vruntime(cpu as i64, tid as i64, elapsed_ns as i64) as void {
    let is i64 as w = thr_weight(tid);
    let is i64 as delta = elapsed_ns * BASE_WEIGHT / w;
    let is i64 as new_vrt = thr_vruntime(tid) + delta;
    thr_set(tid, 48, new_vrt);
    thr_set(tid, 56, new_vrt + (thr_slice(tid) * BASE_WEIGHT / w));
    thr_set(tid, 88, thr_runtime(tid) + elapsed_ns);
    let is i64 as lag = band_min_vruntime(cpu, thr_band(tid)) - new_vrt;
    thr_set(tid, 112, lag);
}

// ============================================================
// Deadline class: admission test (§6.1)
// ============================================================

fn dl_total_utilization(cpu as i64) as i64 {
    // Returns utilization as percentage (walk this cpu's deadline tree).
    let is i64 as total with mut = 0;
    let is i64 as n with mut = rb.rb_leftmost(dl_root(cpu));
    while (n != 0) {
        let is i64 as tid = rb.nd_val(n);
        let is i64 as rt = thr_get(tid, 136);
        let is i64 as pd = thr_get(tid, 144);
        if (pd > 0) {
            total = total + (rt * 100 / pd);
        }
        n = rb.rb_next(n);
    }
    return total;
}

fn sched_set_deadline(tid as i64, runtime_ns as i64, period_ns as i64, deadline_ns as i64) as i64 {
    let is i64 as cpu = thr_home_cpu(tid);
    let is i64 as saved_flags = lock.acquire_irq(sched_lock_ptr(cpu));
    // Check capability
    if ((thr_caps(tid) & CAP_SCHED_REALTIME) == 0) {
        lock.release_irq(sched_lock_ptr(cpu), saved_flags);
        return 0 - 1;  // EPERM
    }
    if (runtime_ns > deadline_ns) {
        lock.release_irq(sched_lock_ptr(cpu), saved_flags);
        return 0 - 2;  // EINVAL
    }
    if (deadline_ns > period_ns) {
        lock.release_irq(sched_lock_ptr(cpu), saved_flags);
        return 0 - 2;
    }

    // Admission test against THIS cpu's existing deadline load.
    let is i64 as new_util = runtime_ns * 100 / period_ns;
    let is i64 as total = dl_total_utilization(cpu) + new_util;
    if (total > MAX_DL_UTIL_PCT) {
        lock.release_irq(sched_lock_ptr(cpu), saved_flags);
        return 0 - 3;  // EBUSY
    }

    // Remove from QoS band if currently there
    if (thr_class(tid) == SCHED_CLASS_QOS) {
        if (thr_state(tid) == THREAD_RUNNABLE) {
            runlist_remove(cpu, thr_band(tid), tid);
        }
    }

    thr_set(tid, 16, SCHED_CLASS_DEADLINE);
    thr_set(tid, 136, runtime_ns);
    thr_set(tid, 144, period_ns);
    thr_set(tid, 152, deadline_ns);
    thr_set(tid, 160, runtime_ns);                     // budget_left = full
    let is i64 as now = timer.current_time_ns();
    thr_set(tid, 168, now);                            // period_start
    thr_set(tid, 176, now + deadline_ns);              // abs_deadline

    if (thr_state(tid) == THREAD_RUNNABLE) {
        dl_insert(cpu, tid);
    }

    lock.release_irq(sched_lock_ptr(cpu), saved_flags);
    return 0;
}

// CBS budget enforcement (§6.3) — called from schedule() with the
// running cpu's lock held; uses that same cpu for dl_remove.
fn dl_account(cpu as i64, tid as i64, elapsed_ns as i64) as void {
    let is i64 as budget = thr_dl_budget(tid) - elapsed_ns;
    thr_set(tid, 160, budget);
    thr_set(tid, 88, thr_runtime(tid) + elapsed_ns);

    if (budget <= 0) {
        // Budget exhausted — suspend until next period.
        // Drop nr_running so the counter stays in step with replenish
        // (which adds +1 again).
        thr_set(tid, 8, THREAD_SUSPENDED);
        dl_remove(cpu, tid);
        set_nr_running(cpu, nr_running(cpu) - 1);
    }
}

// Period replenishment (§6.4) — runs under THIS cpu's sched_lock,
// only replenishes deadline threads whose home is this cpu.
fn dl_check_replenish(cpu as i64) as void {
    let is i64 as now = timer.current_time_ns();
    let is i64 as tid with mut = 0;
    while (tid < next_tid) {
        if (thr_home_cpu(tid) == cpu) {
            if (thr_class(tid) == SCHED_CLASS_DEADLINE) {
                if (thr_state(tid) == THREAD_SUSPENDED) {
                    let is i64 as period_start = thr_get(tid, 168);
                    let is i64 as period_ns = thr_get(tid, 144);
                    if (now >= period_start + period_ns) {
                        // New period: replenish budget
                        thr_set(tid, 168, now);                          // new period_start
                        thr_set(tid, 160, thr_get(tid, 136));            // budget = runtime
                        thr_set(tid, 176, now + thr_get(tid, 152));      // new abs_deadline
                        thr_set(tid, 8, THREAD_RUNNABLE);
                        dl_insert(cpu, tid);
                        set_nr_running(cpu, nr_running(cpu) + 1);
                        smp.this_cpu_set_need_resched(1);
                    }
                }
            }
        }
        tid = tid + 1;
    }
}

// ============================================================
// Anti-abuse: budget enforcement (§7.3)
// ============================================================

fn qos_budget_check(cpu as i64, tid as i64, elapsed_ns as i64) as void {
    let is i64 as band = thr_band(tid);
    let is i64 as max_pct = bb_get(cpu, band, 0);
    if (max_pct >= 100) { return; }  // no enforcement for this band

    // Accumulate CPU time
    thr_set(tid, 184, thr_get(tid, 184) + elapsed_ns);

    let is i64 as now = timer.current_time_ns();
    let is i64 as window_start = thr_get(tid, 192);
    let is i64 as window_ns = bb_get(cpu, band, 1);
    let is i64 as window_age = now - window_start;

    if (window_age >= window_ns) {
        let is i64 as cpu_used = thr_get(tid, 184);
        let is i64 as cpu_pct = cpu_used * 100 / window_age;

        if (cpu_pct > max_pct) {
            let is i64 as violations = thr_get(tid, 200) + 1;
            thr_set(tid, 200, violations);
            thr_set(tid, 208, 0);  // reset below_count
            let is i64 as demo_thresh = bb_get(cpu, band, 3);
            if (demo_thresh > 0) {
                if (violations >= demo_thresh) {
                    demote_thread(cpu, tid);
                }
            }
        } else {
            let is i64 as below = thr_get(tid, 208) + 1;
            thr_set(tid, 208, below);
            thr_set(tid, 200, 0);  // reset violations
            let is i64 as promo_thresh = bb_get(cpu, band, 2);
            if (promo_thresh > 0) {
                if (below >= promo_thresh) {
                    let is i64 as orig = thr_get(tid, 216);
                    if (band > orig) {
                        promote_thread(cpu, tid);
                    }
                }
            }
        }
        // Reset window
        thr_set(tid, 184, 0);
        thr_set(tid, 192, now);
    }
}

fn demote_thread(cpu as i64, tid as i64) as void {
    let is i64 as band = thr_band(tid);
    if (band >= QOS_LAZY) { return; }
    let is i64 as new_band = band + 1;
    if (thr_state(tid) == THREAD_RUNNABLE) {
        runlist_remove(cpu, band, tid);
    }
    thr_set(tid, 24, new_band);
    thr_set(tid, 32, band_weight(new_band));
    thr_set(tid, 200, 0);
    thr_set(tid, 208, 0);
    if (thr_state(tid) == THREAD_RUNNABLE) {
        runlist_insert(cpu, new_band, tid);
    }
}

fn promote_thread(cpu as i64, tid as i64) as void {
    let is i64 as band = thr_band(tid);
    let is i64 as orig = thr_get(tid, 216);
    if (band <= orig) { return; }
    let is i64 as new_band = band - 1;
    if (thr_state(tid) == THREAD_RUNNABLE) {
        runlist_remove(cpu, band, tid);
    }
    thr_set(tid, 24, new_band);
    thr_set(tid, 32, band_weight(new_band));
    thr_set(tid, 200, 0);
    thr_set(tid, 208, 0);
    if (thr_state(tid) == THREAD_RUNNABLE) {
        runlist_insert(cpu, new_band, tid);
    }
}

// ============================================================
// Capability check for band declaration (§7.1, §8)
// ============================================================

fn sched_set_qos(tid as i64, requested_band as i64) as i64 {
    let is i64 as cpu = thr_home_cpu(tid);
    let is i64 as saved_flags = lock.acquire_irq(sched_lock_ptr(cpu));
    if (requested_band == QOS_INPUT) {
        if ((thr_caps(tid) & CAP_SCHED_INPUT) == 0) {
            lock.release_irq(sched_lock_ptr(cpu), saved_flags);
            return 0 - 1;
        }
    }
    if (requested_band == QOS_RENDER) {
        if ((thr_caps(tid) & CAP_SCHED_RENDER) == 0) {
            lock.release_irq(sched_lock_ptr(cpu), saved_flags);
            return 0 - 1;
        }
    }
    thr_set(tid, 24, requested_band);
    thr_set(tid, 216, requested_band);  // original_qos_band
    thr_set(tid, 32, band_weight(requested_band));
    lock.release_irq(sched_lock_ptr(cpu), saved_flags);
    return 0;
}

// ============================================================
// FPU lazy save (§14.2)
// ============================================================

// Set TS bit in CR0 (causes #NM on FPU use)
fn cr0_set_ts() as void {
    // mov rax, cr0 = 0x0F 0x20 0xC0
    asm(".byte 0x0F, 0x20, 0xC0\n");
    asm("or rax, 8\n");           // bit 3 = TS
    // mov cr0, rax = 0x0F 0x22 0xC0
    asm(".byte 0x0F, 0x22, 0xC0\n");
}

// Clear TS bit in CR0
fn cr0_clear_ts() as void {
    // clts = 0x0F 0x06
    asm(".byte 0x0F, 0x06\n");
}

// Save FPU state (fxsave [rdi])
fn fpu_save(addr as i64) as void {
    // fxsave [rdi] = 0x0F 0xAE 0x07
    asm(".byte 0x0F, 0xAE, 0x07\n");
}

// Restore FPU state (fxrstor [rdi])
fn fpu_restore(addr as i64) as void {
    // fxrstor [rdi] = 0x0F 0xAE, 0x0F
    asm(".byte 0x0F, 0xAE, 0x0F\n");
}

// Called by #NM exception handler when a thread uses FPU for first time
fn handle_nm_fault() as void {
    cr0_clear_ts();

    let is i64 as cur = current_tid();
    if (cur < 0) { return; }

    // Save previous owner's FPU state
    if (fpu_owner_tid() >= 0) {
        if (fpu_owner_tid() != cur) {
            let is i64 as prev_fpu_addr = thr_get(fpu_owner_tid(), 240);
            if (prev_fpu_addr != 0) {
                fpu_save(prev_fpu_addr);
            }
        }
    }

    // Restore current thread's FPU state
    let is i64 as cur_fpu_addr = thr_get(cur, 240);
    if (cur_fpu_addr != 0) {
        fpu_restore(cur_fpu_addr);
    }

    set_fpu_owner_tid(cur);
    thr_set(cur, 232, 1);  // fpu_dirty = 1
}

// ============================================================
// Thread creation
// ============================================================

// Round-robin placement counter for create_thread. Bumped under the
// home cpu's sched_lock so two cpus creating threads in parallel
// still get different home cpus.
let is i64 as next_placement_cpu with mut = 0;

// Per-cpu watchdog heartbeat. schedule() stamps this with the current
// time on every entry. The watchdog thread (run from BSP) polls these
// once per second and panics with a dump if any cpu hasn't ticked in
// WATCHDOG_THRESHOLD_NS — that's strong evidence the cpu is wedged
// (deadlock, infinite loop without yield, missed IRQ). Indexed by
// cpu_id; only the first MAX_CPUS_RQ slots are meaningful.
let is [128]u8 as cpu_heartbeat_ns;     // 16 cpus * i64

fn heartbeat_get(cpu as i64) as i64 {
    let is *i64 as p = cast(*i64, &cpu_heartbeat_ns);
    return p[cpu];
}

fn heartbeat_set(cpu as i64, ns as i64) as void {
    let is *i64 as p = cast(*i64, &cpu_heartbeat_ns);
    p[cpu] = ns;
}

fn create_thread(entry as i64, band as i64) as i64 {
    // Pick this thread's home cpu via round-robin BEFORE taking
    // any lock — the placement choice is itself the input that
    // selects which lock to take. Every cpu (including BSP) gets
    // a turn so workload spreads evenly across the topology.
    let is i64 as cpus = smp.get_cpu_count();
    let is i64 as home_cpu with mut = next_placement_cpu;
    if (home_cpu >= cpus) { home_cpu = 0; }
    next_placement_cpu = home_cpu + 1;
    if (next_placement_cpu >= cpus) { next_placement_cpu = 0; }

    let is i64 as saved_flags = lock.acquire_irq(sched_lock_ptr(home_cpu));

    // Allocate tid + hash slot under tid_lock so concurrent
    // per_cpu_init / create_thread on different cpus don't reuse
    // the same tid or stomp the same hash bucket.
    let is i64 as tid_flags = lock.acquire_irq(&tid_lock);
    let is i64 as tid = next_tid;

    let is i64 as tptr with mut = 0;
    if (thread_cache != 0) {
        tptr = heap.kcache_alloc(thread_cache, cast(i32, 0));
    } else {
        tptr = heap.kmalloc(THREAD_SIZE, pmm.ALLOC_ZERO);
    }
    if (tptr == 0) { pmm.panic("thread alloc fail", 17); }
    tid_set_ptr(tid, tptr);
    next_tid = tid + 1;
    lock.release_irq(&tid_lock, tid_flags);

    let is *u8 as tp = cast(*u8, tptr);
    let is i64 as z with mut = 0;
    while (z < THREAD_SIZE) { tp[z] = 0; z = z + 1; }

    // Kernel stack
    let is i32 as stack_pfn = pmm.alloc_pages(
        pmm.ZONE_DMA32, pmm.ALLOC_ZERO | pmm.ALLOC_ALLOW_FALLBACK,
        cast(i32, 1), pmm.USAGE_KERNEL, cast(i32, 0)
    );
    if (stack_pfn == pmm.PFN_NONE) { pmm.panic("stack alloc fail", 16); }

    let is i64 as stack_base = pmm.phys_to_virt(pmm.pfn_to_phys(stack_pfn));
    let is i64 as stack_top = stack_base + KSTACK_SIZE;

    let is *i64 as sf = cast(*i64, stack_top - 56);
    asm("lea rax, [rip+_kernel_sched_cst_thread_entry_trampoline]\n");
    asm("lea rbx, [rip+_kernel_sched_cst_switch_rsp]\n");
    asm("mov QWORD PTR [rbx], rax\n");
    sf[0] = switch_rsp;
    sf[1] = 0; sf[2] = 0; sf[3] = 0; sf[4] = 0; sf[5] = 0; sf[6] = 0;

    let is i64 as fpu_addr = heap.kmalloc(FPU_STATE_SIZE, pmm.ALLOC_ZERO);

    // EEVDF starts at THIS cpu's band min_vruntime.
    let is i64 as w = band_weight(band);
    let is i64 as mvrt = band_min_vruntime(home_cpu, band);
    let is i64 as vd = mvrt + (DEFAULT_SLICE_NS * BASE_WEIGHT / w);
    let is i64 as now = timer.current_time_ns();

    thr_set(tid, 0, tid);
    thr_set(tid, 8, THREAD_RUNNABLE);
    thr_set(tid, 16, SCHED_CLASS_QOS);
    thr_set(tid, 24, band);
    thr_set(tid, 32, w);
    thr_set(tid, 40, DEFAULT_SLICE_NS);
    thr_set(tid, 48, mvrt);
    thr_set(tid, 56, vd);
    thr_set(tid, 64, stack_top - 56);
    thr_set(tid, 72, stack_base);
    thr_set(tid, 80, entry);
    thr_set(tid, 96, 0 - 1);
    thr_set(tid, 104, 0 - 1);
    thr_set(tid, 112, 0);             // lag
    thr_set(tid, 192, now);           // window_start_ns
    thr_set(tid, 216, band);          // original_qos_band
    thr_set(tid, 240, fpu_addr);      // fpu_state_addr
    thr_set(tid, 256, home_cpu);      // home_cpu — every wakeup_thread / sched
                                      //  cross-cpu touch reads this slot to
                                      //  pick the correct lock + runqueue
    thr_set(tid, 280, vmm.kas_pml4_phys);  // aspace_pml4 — kernel AS until a
                                      //  process loader replaces it

    runlist_insert(home_cpu, band, tid);
    set_nr_running(home_cpu, nr_running(home_cpu) + 1);
    thread_count = thread_count + 1;

    // Tell the home cpu it has new work so it preempts on next
    // tick — no IPI needed, the per-cpu need_resched flag is
    // visible the next time that cpu enters its scheduler.
    let is *smp.PerCpu as hpc = smp.get_per_cpu(home_cpu);
    if (cast(i64, hpc) != 0) { hpc.need_resched = 1; }

    lock.release_irq(sched_lock_ptr(home_cpu), saved_flags);
    return tid;
}

// Create a thread that will iretq into ring 3 once dispatched. Same
// shape as create_thread but populates aspace_pml4 / user_entry /
// user_rsp under the same sched_lock so the home cpu's pick_next
// can't observe the thread before its user context is in place.
//
// `kentry` is the kernel-side trampoline (typically
// userspace.user_thread_trampoline) that reads thr_user_entry /
// thr_user_rsp and runs the iretq.
fn create_user_thread(kentry as i64, band as i64, aspace_pml4 as i64,
                      user_entry as i64, user_rsp as i64, aspace_ptr as i64) as i64 {
    let is i64 as cpus = smp.get_cpu_count();
    let is i64 as home_cpu with mut = next_placement_cpu;
    if (home_cpu >= cpus) { home_cpu = 0; }
    next_placement_cpu = home_cpu + 1;
    if (next_placement_cpu >= cpus) { next_placement_cpu = 0; }

    let is i64 as saved_flags = lock.acquire_irq(sched_lock_ptr(home_cpu));

    let is i64 as tid_flags = lock.acquire_irq(&tid_lock);
    let is i64 as tid = next_tid;

    let is i64 as tptr with mut = 0;
    if (thread_cache != 0) {
        tptr = heap.kcache_alloc(thread_cache, cast(i32, 0));
    } else {
        tptr = heap.kmalloc(THREAD_SIZE, pmm.ALLOC_ZERO);
    }
    if (tptr == 0) { pmm.panic("thread alloc fail", 17); }
    tid_set_ptr(tid, tptr);
    next_tid = tid + 1;
    lock.release_irq(&tid_lock, tid_flags);

    let is *u8 as tp = cast(*u8, tptr);
    let is i64 as z with mut = 0;
    while (z < THREAD_SIZE) { tp[z] = 0; z = z + 1; }

    let is i32 as stack_pfn = pmm.alloc_pages(
        pmm.ZONE_DMA32, pmm.ALLOC_ZERO | pmm.ALLOC_ALLOW_FALLBACK,
        cast(i32, 1), pmm.USAGE_KERNEL, cast(i32, 0)
    );
    if (stack_pfn == pmm.PFN_NONE) { pmm.panic("ustack alloc fail", 17); }

    let is i64 as stack_base = pmm.phys_to_virt(pmm.pfn_to_phys(stack_pfn));
    let is i64 as stack_top = stack_base + KSTACK_SIZE;

    let is *i64 as sf = cast(*i64, stack_top - 56);
    asm("lea rax, [rip+_kernel_sched_cst_thread_entry_trampoline]\n");
    asm("lea rbx, [rip+_kernel_sched_cst_switch_rsp]\n");
    asm("mov QWORD PTR [rbx], rax\n");
    sf[0] = switch_rsp;
    sf[1] = 0; sf[2] = 0; sf[3] = 0; sf[4] = 0; sf[5] = 0; sf[6] = 0;

    let is i64 as fpu_addr = heap.kmalloc(FPU_STATE_SIZE, pmm.ALLOC_ZERO);

    let is i64 as w = band_weight(band);
    let is i64 as mvrt = band_min_vruntime(home_cpu, band);
    let is i64 as vd = mvrt + (DEFAULT_SLICE_NS * BASE_WEIGHT / w);
    let is i64 as now = timer.current_time_ns();

    thr_set(tid, 0, tid);
    thr_set(tid, 8, THREAD_RUNNABLE);
    thr_set(tid, 16, SCHED_CLASS_QOS);
    thr_set(tid, 24, band);
    thr_set(tid, 32, w);
    thr_set(tid, 40, DEFAULT_SLICE_NS);
    thr_set(tid, 48, mvrt);
    thr_set(tid, 56, vd);
    thr_set(tid, 64, stack_top - 56);
    thr_set(tid, 72, stack_base);
    thr_set(tid, 80, kentry);
    thr_set(tid, 96, 0 - 1);
    thr_set(tid, 104, 0 - 1);
    thr_set(tid, 112, 0);
    thr_set(tid, 192, now);
    thr_set(tid, 216, band);
    thr_set(tid, 240, fpu_addr);
    thr_set(tid, 256, home_cpu);
    thr_set(tid, 280, aspace_pml4);   // user aspace
    thr_set(tid, 288, user_entry);    // ring-3 RIP
    thr_set(tid, 296, user_rsp);      // ring-3 RSP
    thr_set(tid, 304, aspace_ptr);    // *vma.Aspace (for syscall handlers)

    runlist_insert(home_cpu, band, tid);
    set_nr_running(home_cpu, nr_running(home_cpu) + 1);
    thread_count = thread_count + 1;

    let is *smp.PerCpu as hpc = smp.get_per_cpu(home_cpu);
    if (cast(i64, hpc) != 0) { hpc.need_resched = 1; }

    lock.release_irq(sched_lock_ptr(home_cpu), saved_flags);
    return tid;
}

// ============================================================
// Sleep / Wakeup (§5.4)
// ============================================================

// Per-cpu count of threads currently sleeping with a wake deadline.
// Lets on_timer_tick skip the per-thread scan entirely on cpus that
// have no time-driven sleepers — most ticks. Bumped under the home
// cpu's sched_lock by sleep_for_ns; decremented by tick_wake when a
// timed sleep fires (and by wakeup_thread if a manual wakeup arrives
// while sleep_until_ns > 0).
let is [128]u8 as cpu_timed_sleepers;   // 16 cpus * i64

fn timed_sleepers_get(cpu as i64) as i64 {
    let is *i64 as p = cast(*i64, &cpu_timed_sleepers);
    return p[cpu];
}

fn timed_sleepers_set(cpu as i64, v as i64) as void {
    let is *i64 as p = cast(*i64, &cpu_timed_sleepers);
    p[cpu] = v;
}

// sleep_for_ns: park the current thread until at least `ns` from
// now. Replaces the yield-loop pattern that vfs.self_test_thread
// and fat32.mount_thread used to use — yielding within QOS_ACTIVE
// keeps re-picking the same thread (because pick_next walks bands
// in order and the yielder is the only ACTIVE thread on its cpu),
// which starves the QOS_NORMAL test threads sharing the same cpu.
// A real sleep transitions the thread to SLEEPING, drops it from
// the runqueue, and lets pick_next fall through to lower bands.
// The timer tick on the thread's home cpu wakes it once its
// deadline passes.
fn sleep_for_ns(ns as i64) as void {
    if (ns <= 0) { yield_cpu(); return; }
    let is i64 as tid = current_tid();
    if (tid < 0) { return; }
    let is i64 as cpu = thr_home_cpu(tid);
    let is i64 as saved_flags = lock.acquire_irq(sched_lock_ptr(cpu));
    if (thr_state(tid) != THREAD_RUNNING) {
        lock.release_irq(sched_lock_ptr(cpu), saved_flags);
        return;
    }
    let is i64 as wake_at = timer.current_time_ns() + ns;
    thr_set(tid, 272, wake_at);                              // sleep_until_ns
    thr_set(tid, 8, THREAD_SLEEPING);
    set_nr_running(cpu, nr_running(cpu) - 1);
    timed_sleepers_set(cpu, timed_sleepers_get(cpu) + 1);
    lock.release_irq(sched_lock_ptr(cpu), saved_flags);
    schedule();
}

// Called from on_timer_tick on each cpu. Walks threads homed on
// this cpu that are SLEEPING with a non-zero sleep_until_ns; wakes
// any whose deadline has passed. Cheap fast path: the
// timed_sleepers counter lets us skip the walk entirely when no
// thread on this cpu is in a timed sleep (the common case).
fn tick_wake(cpu as i64, now as i64) as void {
    if (timed_sleepers_get(cpu) <= 0) { return; }
    let is i64 as ntid with mut = next_tid;
    let is i64 as tid with mut = 0;
    while (tid < ntid) {
        if (thread_ptr(tid) != 0) {
            if (thr_home_cpu(tid) == cpu) {
                if (thr_state(tid) == THREAD_SLEEPING) {
                    let is i64 as wake_at = thr_sleep_until_ns(tid);
                    if (wake_at > 0) {
                        if (now >= wake_at) {
                            thr_set(tid, 272, 0);   // clear deadline
                            timed_sleepers_set(cpu, timed_sleepers_get(cpu) - 1);
                            wakeup_thread(tid);
                        }
                    }
                }
            }
        }
        tid = tid + 1;
    }
}

fn sleep_thread(tid as i64) as void {
    let is i64 as cpu = thr_home_cpu(tid);
    let is i64 as saved_flags = lock.acquire_irq(sched_lock_ptr(cpu));
    if (thr_state(tid) != THREAD_RUNNING) {
        lock.release_irq(sched_lock_ptr(cpu), saved_flags);
        return;
    }
    thr_set(tid, 8, THREAD_SLEEPING);
    set_nr_running(cpu, nr_running(cpu) - 1);
    lock.release_irq(sched_lock_ptr(cpu), saved_flags);
    schedule();
}

// Condition-variable-style sleep. Caller holds THIS cpu's sched_lock
// with IRQs disabled and a copy of the saved flags. The caller is
// always the current thread, so the home_cpu read is just this_cpu()
// — but reading it from the thread struct keeps the locking pattern
// uniform with sleep_thread/wakeup_thread.
fn sleep_locked_and_yield(saved_flags as i64) as void {
    let is i64 as tid = current_tid();
    let is i64 as cpu = thr_home_cpu(tid);
    thr_set(tid, 8, THREAD_SLEEPING);
    set_nr_running(cpu, nr_running(cpu) - 1);
    lock.release_irq(sched_lock_ptr(cpu), saved_flags);
    schedule();
}

fn wakeup_thread(tid as i64) as void {
    let is i64 as cpu = thr_home_cpu(tid);
    let is i64 as saved_flags = lock.acquire_irq(sched_lock_ptr(cpu));
    if (thr_state(tid) != THREAD_SLEEPING) {
        lock.release_irq(sched_lock_ptr(cpu), saved_flags);
        return;
    }

    // If this thread had a timed sleep pending, clear it and
    // decrement the cpu's timed-sleeper count so on_timer_tick's
    // fast path can skip the per-thread scan again.
    if (thr_sleep_until_ns(tid) > 0) {
        thr_set(tid, 272, 0);
        timed_sleepers_set(cpu, timed_sleepers_get(cpu) - 1);
    }

    let is i64 as band = thr_band(tid);
    let is i64 as w with mut = thr_weight(tid);
    let is i64 as mvrt = band_min_vruntime(cpu, band);
    // place_entity recipe — see prior commit message.
    let is i64 as new_vrt = mvrt;
    let is i64 as slice with mut = thr_slice(tid);
    if (w <= 0) { w = BASE_WEIGHT; }
    if (slice <= 0) { slice = DEFAULT_SLICE_NS; }
    let is i64 as new_vd = new_vrt + (slice * BASE_WEIGHT / w);

    thr_set(tid, 48, new_vrt);
    thr_set(tid, 112, 0);
    thr_set(tid, 56, new_vd);
    thr_set(tid, 8, THREAD_RUNNABLE);

    if (thr_class(tid) == SCHED_CLASS_DEADLINE) {
        dl_insert(cpu, tid);
    } else {
        runlist_insert(cpu, band, tid);
    }
    set_nr_running(cpu, nr_running(cpu) + 1);

    // Flag the home cpu (not all cpus) — the thread can only run
    // on its home, so resched on remote cpus is wasted work.
    let is *smp.PerCpu as hpc = smp.get_per_cpu(cpu);
    let is i64 as target_lapic_id with mut = 0 - 1;
    let is i64 as is_remote with mut = 0;
    if (cast(i64, hpc) != 0) {
        hpc.need_resched = 1;
        target_lapic_id = hpc.lapic_id;
        if (cpu != this_cpu()) { is_remote = 1; }
    }

    lock.release_irq(sched_lock_ptr(cpu), saved_flags);

    // Targeted reschedule IPI — wake the home cpu's idle/HLT (or
    // preempt whatever lower-priority thread it's running) so the
    // freshly-runnable thread starts in microseconds instead of
    // waiting for the home cpu's next 5 ms timer tick. We only
    // fire when the home is a *different* cpu; if we're already
    // on it the local need_resched flag plus the in-flight
    // schedule()/return path picks the wakeup up without an IRQ
    // round-trip. The broadcast variant that this replaces was
    // dangerous on -smp 4 pre-per-cpu-runqueue (cross-cpu lock
    // contention exposed a codegen race); a single targeted
    // delivery to a runqueue we don't own has none of that.
    if (is_remote != 0) {
        if (target_lapic_id >= 0) {
            lapic.send_resched_ipi_to(target_lapic_id);
        }
    }
}

fn suspend_thread(tid as i64) as void {
    let is i64 as cpu = thr_home_cpu(tid);
    let is i64 as saved_flags = lock.acquire_irq(sched_lock_ptr(cpu));
    if (thr_state(tid) != THREAD_RUNNING) {
        lock.release_irq(sched_lock_ptr(cpu), saved_flags);
        return;
    }
    thr_set(tid, 8, THREAD_SUSPENDED);
    set_nr_running(cpu, nr_running(cpu) - 1);
    lock.release_irq(sched_lock_ptr(cpu), saved_flags);
    schedule();
}

fn resume_thread(tid as i64) as void {
    let is i64 as cpu = thr_home_cpu(tid);
    let is i64 as saved_flags = lock.acquire_irq(sched_lock_ptr(cpu));
    if (thr_state(tid) != THREAD_SUSPENDED) {
        lock.release_irq(sched_lock_ptr(cpu), saved_flags);
        return;
    }
    thr_set(tid, 8, THREAD_RUNNABLE);
    let is i64 as band = thr_band(tid);
    if (thr_class(tid) == SCHED_CLASS_DEADLINE) { dl_insert(cpu, tid); }
    else { runlist_insert(cpu, band, tid); }
    set_nr_running(cpu, nr_running(cpu) + 1);
    lock.release_irq(sched_lock_ptr(cpu), saved_flags);
}

// ============================================================
// Thread entry trampoline
// ============================================================


fn thread_entry_trampoline() as void {
    // First code to run on a brand-new thread. schedule() handed
    // control over to us via a ret off the fake frame create_thread
    // built — THIS cpu's sched_lock is still held from that context
    // switch, drop it before enabling IRQs.
    smp.this_cpu_set_in_irq_context(0);
    let is i64 as cpu = this_cpu();
    lock.release(sched_lock_ptr(cpu));
    asm(".byte 0xFB\n");  // sti
    smp.call_ptr(thr_entry(current_tid()));

    // Thread exited. Mark DEAD + drop from this cpu's nr_running
    // under this cpu's lock, then schedule(); we never come back.
    asm(".byte 0xFA\n");  // cli
    let is i64 as exit_cpu = this_cpu();
    lock.acquire(sched_lock_ptr(exit_cpu));
    thr_set(current_tid(), 8, THREAD_DEAD);
    set_nr_running(exit_cpu, nr_running(exit_cpu) - 1);
    lock.release(sched_lock_ptr(exit_cpu));
    asm(".byte 0xFB\n");  // sti
    schedule();
    while (1 == 1) { asm(".byte 0xF4\n"); }
}

// ============================================================
// pick_next (§10)
// ============================================================

fn pick_next_deadline(cpu as i64) as i64 {
    let is i64 as n with mut = rb.rb_leftmost(dl_root(cpu));
    while (n != 0) {
        let is i64 as tid = rb.nd_val(n);
        if (thr_dl_budget(tid) > 0) { return tid; }
        n = rb.rb_next(n);
    }
    return 0 - 1;
}

fn pick_next_in_band(cpu as i64, band as i64) as i64 {
    let is i64 as n with mut = rb.rb_leftmost(band_root(cpu, band));
    while (n != 0) {
        let is i64 as tid = rb.nd_val(n);
        if (thr_lag(tid) >= 0) { return tid; }
        n = rb.rb_next(n);
    }

    let is i64 as lm = rb.rb_leftmost(band_root(cpu, band));
    if (lm != 0) {
        let is i64 as tid = rb.nd_val(lm);
        band_set_min_vruntime(cpu, band, thr_vruntime(tid));
        thr_set(tid, 112, 0);
        return tid;
    }

    return 0 - 1;
}

fn pick_next(cpu as i64) as i64 {
    if (dl_count(cpu) > 0) {
        let is i64 as dl = pick_next_deadline(cpu);
        if (dl >= 0) { return dl; }
    }
    let is i64 as b with mut = 0;
    while (b < NUM_QOS_BANDS) {
        if (band_count(cpu, b) > 0) {
            let is i64 as tid = pick_next_in_band(cpu, b);
            if (tid >= 0) { return tid; }
        }
        b = b + 1;
    }
    return idle_tid();
}

// ============================================================
// account_runtime (§10)
// ============================================================

fn account_runtime(cpu as i64, tid as i64, elapsed_ns as i64) as void {
    if (thr_class(tid) == SCHED_CLASS_DEADLINE) {
        dl_account(cpu, tid, elapsed_ns);
    }
    if (thr_class(tid) == SCHED_CLASS_QOS) {
        update_vruntime(cpu, tid, elapsed_ns);
        qos_budget_check(cpu, tid, elapsed_ns);
        update_band_min_vruntime(cpu, thr_band(tid));
    }
}

// ============================================================
// schedule (§10)
// ============================================================

fn schedule() as void {
    if (sched_active == 0) { return; }

    let is i64 as from_irq = smp.this_cpu_in_irq_context();

    asm(".byte 0xFA\n");  // cli
    let is i64 as cpu = this_cpu();
    lock.acquire(sched_lock_ptr(cpu));

    let is i64 as now = timer.current_time_ns();
    heartbeat_set(cpu, now);
    let is i64 as prev = current_tid();

    // Account and re-insert prev on its home cpu (= cpu, since the
    // running thread always belongs to this cpu's runqueue).
    if (prev >= 0) {
        if (thr_state(prev) == THREAD_RUNNING) {
            let is i64 as elapsed = now - current_start_ns();
            if (elapsed > 0) {
                account_runtime(cpu, prev, elapsed);
            }
            if (thr_state(prev) == THREAD_RUNNING) {
                thr_set(prev, 8, THREAD_RUNNABLE);
                if (thr_class(prev) == SCHED_CLASS_DEADLINE) {
                    dl_insert(cpu, prev);
                }
                if (thr_class(prev) == SCHED_CLASS_QOS) {
                    runlist_insert(cpu, thr_band(prev), prev);
                }
            }
        }
    }

    dl_check_replenish(cpu);

    let is i64 as next with mut = pick_next(cpu);
    if (next < 0) { next = idle_tid(); }

    if (thr_class(next) == SCHED_CLASS_DEADLINE) { dl_remove(cpu, next); }
    if (thr_class(next) == SCHED_CLASS_QOS) { runlist_remove(cpu, thr_band(next), next); }

    thr_set(next, 8, THREAD_RUNNING);
    set_current_tid(next);
    let is i64 as t_now = timer.current_time_ns();
    set_current_start_ns(t_now);
    thr_set(next, 264, t_now);   // last_run_ns
    set_nr_switches(cpu, nr_switches(cpu) + 1);
    smp.this_cpu_set_need_resched(0);

    // Context switch. The asm keeps sched_lock held across the
    // rsp swap so the outgoing ctx_old/new_rsp globals can't be
    // stomped by another cpu between the store and load — the
    // resuming side (either .Lresume below for a previously-
    // suspended thread or the top of thread_entry_trampoline for
    // a brand-new one) is responsible for dropping the lock.
    if (prev != next) {
        if (prev >= 0) {
            if (thr_state(prev) == THREAD_RUNNABLE) {
                thr_set(prev, 128, thr_get(prev, 128) + 1);
            } else {
                thr_set(prev, 120, thr_get(prev, 120) + 1);
            }

            // FPU: set TS so next thread triggers #NM on first FPU use
            cr0_set_ts();

            // Update TSS.RSP0 + per-cpu syscall_kstack = kstack of
            // the incoming thread. TSS.RSP0 covers IDT-style ring-3
            // → ring-0 transitions; the per-cpu mirror is what the
            // SYSCALL entry stub picks up via gs:[0x90].
            // RSP0 / syscall-kstack must be the FIXED top of next's
            // kernel stack (kstack_base + KSTACK_SIZE), NOT thr_kstack_top
            // (offset 64), which the context switch overwrites with the
            // *saved* rsp. Using the saved rsp let each ring3→ring0 entry
            // start lower than the last (the effective top crept down ~one
            // IRQ+schedule frame per preemption), so after enough churn a
            // stack-heavy syscall handler (read/write carry a 4 KiB buffer)
            // overflowed the kstack into the adjacent page — a flaky
            // #GP/#PF/register-corruption that got worse with thread churn.
            let is i64 as next_ktop = thr_kstack_base(next) + KSTACK_SIZE;
            gdt.tss_set_rsp0(cpu, next_ktop);
            smp.set_per_cpu_kstack(cpu, next_ktop);

            // CR3 swap if the incoming thread runs against a
            // different aspace. as_create copies the kernel half
            // of the PML4 from kas_pml4, so the kernel's mapping
            // (including this code, kstacks, MMIO) is identical
            // across aspaces — the swap only changes what the user
            // half resolves to. Do it inside the lock-held section,
            // before the asm rsp swap, so the new stack is already
            // on a CR3 that maps it.
            let is i64 as next_pml4 = thr_aspace_pml4(next);
            if (next_pml4 != 0) {
                vmm.cr3_load_if_different(next_pml4);
            }

            // Stash the switch scratch in this cpu's PerCpu slot
            // instead of module globals. sched_lock serialises
            // concurrent switches so globals would "work", but
            // once a cpu releases the lock (in .Lresume below)
            // another cpu can immediately start its own switch —
            // if it races into writing the globals while the first
            // cpu is still about to read them in the asm, ctx_*
            // globals stomp. Per-cpu slots close that window
            // without depending on lock coverage of the asm.
            smp.this_cpu_set_ctx_old_rsp_ptr(thread_ptr(prev) + 64);
            smp.this_cpu_set_ctx_new_rsp(thr_kstack_top(next));

            asm("push r15\n");
            asm("push r14\n");
            asm("push r13\n");
            asm("push r12\n");
            asm("push rbx\n");
            asm("push rbp\n");
            asm("lea rax, [rip+.Lresume]\n");
            asm("push rax\n");
            // mov rax, QWORD PTR gs:[0x58] → ctx_old_rsp_ptr
            asm(".byte 0x65, 0x48, 0x8B, 0x04, 0x25, 0x58, 0x00, 0x00, 0x00\n");
            asm("mov QWORD PTR [rax], rsp\n");
            // mov rsp, QWORD PTR gs:[0x60] → ctx_new_rsp
            asm(".byte 0x65, 0x48, 0x8B, 0x24, 0x25, 0x60, 0x00, 0x00, 0x00\n");
            asm("ret\n");
            asm(".Lresume:\n");
            asm("pop rbp\n");
            asm("pop rbx\n");
            asm("pop r12\n");
            asm("pop r13\n");
            asm("pop r14\n");
            asm("pop r15\n");
        }
    }

    // Program LAPIC for next event under the cpu's lock — both
    // the deadline tree and the suspended-deadline scan are
    // per-cpu state.
    program_next_tick(cpu);

    lock.release(sched_lock_ptr(cpu));

    // sti only on the thread-call path. If schedule() was called
    // from an IRQ stub, the stub's iretq will restore IF from the
    // saved frame; an sti here would enable IRQs while the stub is
    // still mid-pop of 15 GPRs, and a recursive IRQ entry would
    // stomp the in-flight register restore (observed as crashes at
    // RIP=0x10/0xe/0x1 — the tail end of return-address pop
    // sequences). Thread-call path (idle_fn, yield_cpu, trampoline
    // tail) came in with IF=1 and expects IF=1 on return; they have
    // no iretq to fix IF for them.
    if (from_irq == 0) {
        asm(".byte 0xFB\n");  // sti
    }
}

// ============================================================
// Timer tick (§11.3)
// ============================================================

fn on_timer_tick() as void {
    if (sched_active == 0) { return; }

    // Runs from the LAPIC timer IRQ stub without sched_lock.
    // Everything this function reads — current_tid() / thr_class /
    // nr_running() / elapsed — is either per-cpu state owned by
    // this cpu or a word-sized shared counter that's fine to read
    // racily (worst case: one tick of drift before schedule()
    // picks the correct next thread under the lock anyway). What
    // we deliberately do NOT do here: touch the deadline RB tree.
    // dl_check_replenish mutates the tree and MUST run under
    // sched_lock; schedule() calls it at the top once we commit
    // to rescheduling, so scheduling the reschedule here is
    // enough.

    let is i64 as now = timer.current_time_ns();
    let is i64 as elapsed = now - current_start_ns();
    let is i64 as cpu = this_cpu();

    // Heartbeat for the watchdog — every cpu's timer tick stamps
    // its own slot. BSP additionally polls for stalled cpus below.
    heartbeat_set(cpu, now);

    // Wake any timed-sleep threads on this cpu whose deadline
    // has passed (no-op when no timed sleeper is registered).
    tick_wake(cpu, now);

    if (cpu == smp.get_bsp_cpu_id()) {
        watchdog_check();
    }

    if (current_tid() >= 0) {
        if (thr_class(current_tid()) == SCHED_CLASS_IDLE) {
            if (nr_running(cpu) > 0) { smp.this_cpu_set_need_resched(1); }
            return;
        }
    }

    if (elapsed >= quantum_ns) {
        smp.this_cpu_set_need_resched(1);
    }
}

// ============================================================
// Program next LAPIC tick (§12.2)
// ============================================================

fn program_next_tick(cpu as i64) as void {
    if (lapic.calibrated == 0) { return; }

    let is i64 as now = timer.current_time_ns();
    let is i64 as next_event with mut = now + quantum_ns;

    if (dl_count(cpu) > 0) {
        let is i64 as lm = rb.rb_leftmost(dl_root(cpu));
        if (lm != 0) {
            let is i64 as dl = rb.nd_key(lm);
            if (dl < next_event) { next_event = dl; }
        }
    }

    // Walk this cpu's deadline-suspended threads only.
    let is i64 as tid with mut = 0;
    while (tid < next_tid) {
        if (thr_home_cpu(tid) == cpu) {
            if (thr_class(tid) == SCHED_CLASS_DEADLINE) {
                if (thr_state(tid) == THREAD_SUSPENDED) {
                    let is i64 as replenish_at = thr_get(tid, 168) + thr_get(tid, 144);
                    if (replenish_at < next_event) { next_event = replenish_at; }
                }
            }
        }
        tid = tid + 1;
    }

    let is i64 as delta with mut = next_event - now;
    if (delta < MIN_QUANTUM_NS) { delta = MIN_QUANTUM_NS; }
    lapic.program_tick_ns(delta);
}

fn yield_cpu() as void { schedule(); }

// Mark the currently-running thread DEAD, drop it from the cpu's
// nr_running, and call schedule(). Never returns — the next thread
// the cpu picks runs on this cpu's stack pair from the context
// switch.
//
// Called from exception_handler when a user fault hits, and (later)
// from the exit syscall. The IRQ stub is on the IST1 stack, not the
// dying thread's kstack; schedule()'s rsp swap saves rsp into the
// dying thread's slot anyway, but since the thread is DEAD nobody
// will ever resume it, so the bogus saved rsp is harmless.
fn exit_current_thread() as void {
    asm(".byte 0xFA\n");                        // cli
    let is i64 as cpu = this_cpu();
    lock.acquire(sched_lock_ptr(cpu));
    let is i64 as tid = current_tid();
    if (tid >= 0) {
        thr_set(tid, 8, THREAD_DEAD);
        set_nr_running(cpu, nr_running(cpu) - 1);
    }
    lock.release(sched_lock_ptr(cpu));
    asm(".byte 0xFB\n");                        // sti
    schedule();
    while (1 == 1) { asm(".byte 0xF4\n"); }
}

// ============================================================
// Idle
// ============================================================

// Watchdog: each cpu's timer tick stamps its heartbeat. The BSP's
// timer additionally polls every cpu's heartbeat — if one hasn't
// ticked in WATCHDOG_THRESHOLD_NS, dump diagnostic state and halt.
// Polling from inside the timer IRQ is safe because we're already
// in IRQ context and the only I/O we do is serial.print which has
// its own ticket lock.
let is i64 as WATCHDOG_THRESHOLD_NS  = 5000000000;   // 5 s — cpu stalled
let is i64 as STARVATION_THRESHOLD_NS = 800000000;   // 800 ms — RUNNABLE not picked
let is i64 as WATCHDOG_WARM_NS       = 3000000000;   // 3 s grace at boot
let is i64 as watchdog_armed_at_ns with mut = 0;
let is i64 as watchdog_fired with mut = 0;

fn watchdog_check() as void {
    if (watchdog_fired != 0) { return; }
    let is i64 as now = timer.current_time_ns();
    if (watchdog_armed_at_ns == 0) {
        watchdog_armed_at_ns = now + WATCHDOG_WARM_NS;
        return;
    }
    if (now < watchdog_armed_at_ns) { return; }

    // Stage 1: cpu-level — heartbeat too old.
    let is i64 as cpus = smp.get_cpu_count();
    let is i64 as ci with mut = 0;
    while (ci < cpus) {
        let is i64 as last = heartbeat_get(ci);
        if (last > 0) {
            if (now - last > WATCHDOG_THRESHOLD_NS) {
                watchdog_fired = 1;
                watchdog_dump_and_halt(ci, now - last);
                return;
            }
        }
        ci = ci + 1;
    }

    // Stage 2 (thread-level RUNNABLE-not-picked walk) was useful to
    // catch the nr_running counter leak and the vfs_test-vs-B band
    // starvation interaction, but walking next_tid threads on every
    // 5ms tick added per-thread thr_get pressure that ate into the
    // -smp 2 verify timing budget. Disabled until / unless we move
    // last_run_ns into a per-cpu cache that doesn't need a hash
    // lookup per scan.
}

fn starvation_dump_and_halt(starved_tid as i64, age_ns as i64) as void {
    serial.println("", 0);
    serial.println("=== STARVATION: thread RUNNABLE but not picked ===", 49);

    serial.print("starved tid=", 12);
    util.print_num(starved_tid);
    serial.print(" age_ms=", 8);
    util.print_num(age_ns / 1000000);
    serial.print(" home_cpu=", 10);
    util.print_num(thr_home_cpu(starved_tid));
    serial.print(" band=", 6);
    util.print_num(thr_band(starved_tid));
    serial.print(" class=", 7);
    util.print_num(thr_class(starved_tid));
    serial.println("", 0);

    let is i64 as cpus = smp.get_cpu_count();
    let is i64 as ci with mut = 0;
    while (ci < cpus) {
        let is *smp.PerCpu as pc = smp.get_per_cpu(ci);
        if (cast(i64, pc) != 0) {
            serial.print("cpu", 3);
            util.print_num(ci);
            serial.print(": current_tid=", 14);
            util.print_num(pc.current_tid);
            serial.print(" need_resched=", 14);
            util.print_num(pc.need_resched);
            serial.print(" nr_running=", 12);
            util.print_num(nr_running(ci));
            serial.println("", 0);

            let is i64 as bi with mut = 0;
            while (bi < NUM_QOS_BANDS) {
                let is i64 as bc = band_count(ci, bi);
                if (bc > 0) {
                    serial.print("  band[", 7);
                    util.print_num(bi);
                    serial.print("]=", 2);
                    util.print_num(bc);
                    serial.println("", 0);
                }
                bi = bi + 1;
            }
        }
        ci = ci + 1;
    }

    let is i64 as now = timer.current_time_ns();
    let is i64 as ntid with mut = next_tid;
    serial.print("threads (next_tid=", 18);
    util.print_num(ntid);
    serial.println("):", 2);
    let is i64 as tid with mut = 0;
    while (tid < ntid) {
        if (thread_ptr(tid) != 0) {
            serial.print("  tid=", 6);
            util.print_num(tid);
            serial.print(" state=", 7);
            util.print_num(thr_state(tid));
            serial.print(" class=", 7);
            util.print_num(thr_class(tid));
            serial.print(" band=", 6);
            util.print_num(thr_band(tid));
            serial.print(" home=", 6);
            util.print_num(thr_home_cpu(tid));
            let is i64 as lr = thr_last_run_ns(tid);
            if (lr > 0) {
                serial.print(" age_ms=", 8);
                util.print_num((now - lr) / 1000000);
            } else {
                serial.print(" age_ms=never", 13);
            }
            serial.println("", 0);
        }
        tid = tid + 1;
    }

    serial.println("=== STARVATION halt ===", 23);
    asm("cli\n");
    while (1 == 1) { asm(".byte 0xF4\n"); }
}

fn watchdog_dump_and_halt(stalled_cpu as i64, age_ns as i64) as void {
    serial.println("", 0);
    serial.println("=== WATCHDOG: cpu stalled ===", 29);

    serial.print("stalled cpu=", 12);
    util.print_num(stalled_cpu);
    serial.print(" age_ms=", 8);
    util.print_num(age_ns / 1000000);
    serial.println("", 0);

    let is i64 as cpus = smp.get_cpu_count();
    let is i64 as ci with mut = 0;
    while (ci < cpus) {
        let is *smp.PerCpu as pc = smp.get_per_cpu(ci);
        if (cast(i64, pc) != 0) {
            serial.print("cpu", 3);
            util.print_num(ci);
            serial.print(": current_tid=", 14);
            util.print_num(pc.current_tid);
            serial.print(" need_resched=", 14);
            util.print_num(pc.need_resched);
            serial.print(" in_irq=", 8);
            util.print_num(pc.in_irq_context);
            serial.print(" nr_running=", 12);
            util.print_num(nr_running(ci));
            serial.print(" heartbeat_age_ms=", 18);
            let is i64 as hb = heartbeat_get(ci);
            if (hb > 0) {
                util.print_num((timer.current_time_ns() - hb) / 1000000);
            } else {
                serial.print("never", 5);
            }
            serial.println("", 0);

            // Per-cpu band populations
            let is i64 as bi with mut = 0;
            while (bi < NUM_QOS_BANDS) {
                let is i64 as bc = band_count(ci, bi);
                if (bc > 0) {
                    serial.print("  band[", 7);
                    util.print_num(bi);
                    serial.print("]=", 2);
                    util.print_num(bc);
                    serial.println("", 0);
                }
                bi = bi + 1;
            }
        }
        ci = ci + 1;
    }

    // Walk threads and print state of each. Use a snapshot of next_tid
    // taken under tid_lock so the table read is consistent.
    let is i64 as tflags = lock.acquire_irq(&tid_lock);
    let is i64 as ntid = next_tid;
    lock.release_irq(&tid_lock, tflags);
    serial.print("threads (next_tid=", 18);
    util.print_num(ntid);
    serial.println("):", 2);
    let is i64 as tid with mut = 0;
    while (tid < ntid) {
        if (thread_ptr(tid) != 0) {
            serial.print("  tid=", 6);
            util.print_num(tid);
            serial.print(" state=", 7);
            util.print_num(thr_state(tid));
            serial.print(" class=", 7);
            util.print_num(thr_class(tid));
            serial.print(" band=", 6);
            util.print_num(thr_band(tid));
            serial.print(" home=", 6);
            util.print_num(thr_home_cpu(tid));
            serial.println("", 0);
        }
        tid = tid + 1;
    }

    serial.println("=== WATCHDOG halt ===", 21);
    asm("cli\n");
    while (1 == 1) { asm(".byte 0xF4\n"); }
}

fn idle_fn() as void {
    // APs enter with IF=0 (ap_entry deliberately does not sti before
    // calling ap_start so per_cpu_init publishes current_tid without
    // a racing timer tick). Arm IRQs here now that the cpu is fully
    // initialised, then loop sti-hlt. The BSP enters with IF=1
    // already; the sti here is a harmless no-op for it.
    asm(".byte 0xFB\n");   // sti
    while (1 == 1) {
        if (smp.this_cpu_need_resched() != 0) { schedule(); }
        asm(".byte 0xF4\n");   // hlt
    }
}

// ============================================================
// Init
// ============================================================

fn init() as void {
    serial.println("sched: init", 11);

    // Zero ALL per-cpu runqueues at once (16 cpus * 512 = 8192).
    let is *u8 as rqz = cast(*u8, &per_cpu_rqs);
    let is i64 as zi with mut = 0;
    while (zi < 8192) { rqz[zi] = 0; zi = zi + 1; }

    tid_ht_init(64);

    thread_cache = heap.kcache_create(THREAD_SIZE, 64, cast(i32, 0));
    if (thread_cache == 0) { pmm.panic("sched: thread_cache create fail", 31); }

    // Init per-cpu band data + budgets for every possible cpu.
    let is i64 as ci with mut = 0;
    while (ci < MAX_CPUS_RQ) {
        let is i64 as b with mut = 0;
        while (b < NUM_QOS_BANDS) {
            band_set_count(ci, b, 0);
            band_set_min_vruntime(ci, b, 0);
            b = b + 1;
        }
        bb_set(ci, 0, 0, 20);  bb_set(ci, 0, 1, QOS_WINDOW_NS); bb_set(ci, 0, 2, 5); bb_set(ci, 0, 3, 3);
        bb_set(ci, 1, 0, 70);  bb_set(ci, 1, 1, QOS_WINDOW_NS); bb_set(ci, 1, 2, 5); bb_set(ci, 1, 3, 3);
        bb_set(ci, 2, 0, 100); bb_set(ci, 2, 1, QOS_WINDOW_NS); bb_set(ci, 2, 2, 0); bb_set(ci, 2, 3, 0);
        bb_set(ci, 3, 0, 100); bb_set(ci, 3, 1, QOS_WINDOW_NS); bb_set(ci, 3, 2, 0); bb_set(ci, 3, 3, 0);
        bb_set(ci, 4, 0, 100); bb_set(ci, 4, 1, QOS_WINDOW_NS); bb_set(ci, 4, 2, 0); bb_set(ci, 4, 3, 0);
        bb_set(ci, 5, 0, 100); bb_set(ci, 5, 1, QOS_WINDOW_NS); bb_set(ci, 5, 2, 0); bb_set(ci, 5, 3, 0);
        ci = ci + 1;
    }

    // BSP creates its own idle here; APs do it from ap_start.
    per_cpu_init();

    serial.println("sched: ready", 12);
}

// Per-cpu scheduler bring-up. Creates this cpu's idle thread,
// pins it to this_cpu()'s runqueue, and publishes it as current +
// idle. Each cpu calls this exactly once.
fn per_cpu_init() as void {
    let is i64 as cpu = this_cpu();
    let is i64 as saved_flags = lock.acquire_irq(sched_lock_ptr(cpu));

    // tid + hash under tid_lock — multiple APs run per_cpu_init
    // concurrently and would otherwise race on next_tid / tid_ht.
    let is i64 as tid_flags = lock.acquire_irq(&tid_lock);
    let is i64 as itid = next_tid;
    let is i64 as iptr = heap.kcache_alloc(thread_cache, cast(i32, 0));
    if (iptr == 0) { pmm.panic("idle alloc fail", 15); }
    tid_set_ptr(itid, iptr);
    next_tid = itid + 1;
    lock.release_irq(&tid_lock, tid_flags);

    let is *u8 as tp = cast(*u8, iptr);
    let is i64 as izi with mut = 0;
    while (izi < THREAD_SIZE) { tp[izi] = 0; izi = izi + 1; }

    thr_set(itid, 0, itid);
    thr_set(itid, 8, THREAD_RUNNING);
    thr_set(itid, 16, SCHED_CLASS_IDLE);
    thr_set(itid, 32, BASE_WEIGHT);
    thr_set(itid, 40, DEFAULT_SLICE_NS);
    thr_set(itid, 256, cpu);   // home_cpu = this cpu
    thr_set(itid, 280, vmm.kas_pml4_phys);  // idle runs in kernel AS

    set_idle_tid(itid);
    set_current_tid(itid);
    set_current_start_ns(timer.current_time_ns());

    lock.release_irq(sched_lock_ptr(cpu), saved_flags);
}

fn start() as void {
    sched_active = 1;
    serial.println("sched: active", 13);
    idle_fn();
}

// Read sched_active from outside this module. APs poll this before
// entering ap_start so they don't start dispatching on a runqueue
// whose data structures (tid_ht, thread_cache, band trees) aren't
// fully set up yet. A plain load is fine — the BSP sets the flag
// long after all init writes are globally visible.
fn is_active() as i64 {
    return sched_active;
}

// External handles on sched_lock for subsystems that need
// atomic check-then-sleep against an IRQ-driven wakeup (io,
// futures, etc). Use pattern:
//
//   flags = sched.take_lock();
//   while (predicate != true) {
//     sched.sleep_locked_and_yield(flags);
//     flags = sched.take_lock();
//   }
//   sched.drop_lock(flags);
//
// `sleep_locked_and_yield` hands the lock off through
// schedule(); on resume the caller re-acquires with
// take_lock() to re-check the predicate without a race.
// take_lock acquires THIS cpu's sched_lock — io.wait_complete and
// futures wait against the cpu they are currently running on.
// sleep_locked_and_yield reads the thread's home_cpu (= this cpu)
// to drop the matching lock.
fn take_lock() as i64 {
    return lock.acquire_irq(sched_lock_ptr(this_cpu()));
}

fn drop_lock(saved_flags as i64) as void {
    lock.release_irq(sched_lock_ptr(this_cpu()), saved_flags);
}

// AP entry point into the scheduler. APs call this after they've
// loaded GDT/IDT, switched to kas_pml4_phys, enabled their LAPIC and
// programmed their local timer. Never returns.
fn ap_start() as void {
    per_cpu_init();
    sysc.init_per_cpu();
    idle_fn();
}
