// abi.cst — causticos kernel/user ABI v0.
//
// Flat-numbered syscalls. rax = i64 verb id, args in rdi/rsi/rdx/r10/r8/r9
// (System V order, r10 substitutes for rcx because SYSCALL clobbers rcx
// with saved user RIP). Return value in rax — negative is a causticos
// errno, non-negative is a per-verb success value.
//
// This is v0 and PROVISIONAL — not frozen. Numbers, errnos, and struct
// layouts may still change while userspace is essentially empty (one
// hello+exit ELF). The cost of changing the ABI grows with the number of
// real programs; today it is ~zero. The freeze point is self-host: once
// caustic-mk compiles causticos while running on causticos, the surface
// it depended on becomes v1 and an incompatible change bumps ABI_MAJOR.
// Until then, append-only is a courtesy, not a contract.
//
// Flat-numbered on purpose. The workload that exists today doesn't need
// namespace splits, type tags, BATCH dispatch, or capability tokens.
// Adding any of those before a real program asks for them is paying
// upfront for hypothetical wins. The capability chain (cap_t, channels,
// spawn, object types) is v1 work, gated on the self-host need — it does
// not exist here yet, by design.

// ============================================================
// Errnos — i64 negatives. Small set on purpose; userspace libc maps to
// POSIX if it wants. Kernel never pretends to be POSIX.
// ============================================================

let is i64 as E_OK     = 0;
let is i64 as E_INVAL  = 0 - 1;
let is i64 as E_NOSYS  = 0 - 2;
let is i64 as E_FAULT  = 0 - 3;
let is i64 as E_BADF   = 0 - 4;
let is i64 as E_NOMEM  = 0 - 5;
let is i64 as E_RANGE  = 0 - 6;
let is i64 as E_PERM   = 0 - 7;
let is i64 as E_AGAIN  = 0 - 8;
let is i64 as E_NOENT  = 0 - 9;
let is i64 as E_EXIST  = 0 - 10;
let is i64 as E_ISDIR  = 0 - 11;
let is i64 as E_NOTDIR = 0 - 12;
let is i64 as E_MFILE  = 0 - 13;
let is i64 as E_NOSPC  = 0 - 14;
let is i64 as E_IO     = 0 - 15;
let is i64 as E_PIPE   = 0 - 16;   // write to a channel whose far end closed

// ============================================================
// Syscall numbers (v0, provisional — contiguous 0..8).
// ============================================================

let is i64 as SYS_KERN_INFO       = 0;
let is i64 as SYS_TIME_NOW_NS     = 1;
let is i64 as SYS_TIME_SLEEP_NS   = 2;
let is i64 as SYS_PROC_EXIT       = 3;
let is i64 as SYS_PROC_GETPID     = 4;
let is i64 as SYS_PROC_YIELD      = 5;
let is i64 as SYS_IO_WRITE_SERIAL = 6;
// --- appended: userspace memory (camada 0) ---
let is i64 as SYS_MMAP            = 7;   // (hint, len, prot) → vaddr | errno
let is i64 as SYS_MUNMAP          = 8;   // (addr, len)       → 0     | errno
// --- appended: int-fd file I/O (camada 0) ---
let is i64 as SYS_OPEN            = 9;   // (path, len, flags) → fd    | errno
let is i64 as SYS_READ           = 10;   // (fd, buf, n)       → bytes | errno
let is i64 as SYS_WRITE          = 11;   // (fd, buf, n)       → bytes | errno
let is i64 as SYS_CLOSE          = 12;   // (fd)               → 0     | errno
let is i64 as SYS_LSEEK          = 13;   // (fd, off, whence)  → off   | errno
// --- appended: processes (Process != Thread; spawn, not fork) ---
// SYS_SPAWN takes ONE pointer (rdi) to a SpawnParams. The prior 6 positional
// args filled all six SysV registers, so the 7th (budget, Phase G) couldn't be
// a register — the struct also makes future per-spawn attributes additive.
// argv is DATA the child interprets, never resolved by the kernel; authority
// travels only as fds (fdacts). argc=0 → child argv defaults to ["child"].
let is i64 as SYS_SPAWN          = 14;   // (*SpawnParams) → pid | errno
let is i64 as SYS_WAIT           = 15;   // (pid, status_ptr)  → exit_code | errno

// 7 x i64 = 56 bytes, all-i64 (no mixed-width miscompile). Copied from the
// caller in one copy_from_user.
struct SpawnParams {
    img_uptr    as i64;      // user VA of the CSE image
    img_len     as i64;      // 0 < img_len <= SPAWN_IMG_MAX
    fdacts_uptr as i64;      // array of {child_fd, src_fd} i64 pairs (0 if none)
    n_acts      as i64;      // <= 16
    argv_uptr   as i64;      // array of {str_ptr, str_len} i64 pairs (0 if none)
    argc        as i64;      // <= 32; 0 -> child argv defaults to ["child"]
    budget      as i64;      // 0 = unlimited (physical only); >0 = committed_bytes ceiling
}

// Max bytes for a spawn/boot image. NOT a policy quota (memory has none — see
// the memory model: commit is bounded only by physical RAM). It's a STRUCTURAL
// bound: the image is staged in ONE contiguous kernel buffer (heap.kmalloc →
// pmm.alloc_pages, a single buddy block), and the buddy allocator's largest
// block is 2^MAX_BLOCK_ORDER pages = 1024 * 4096 = 4 MiB. A self-hosting
// compiler image (~1.1 MiB pure) fits with headroom. To go past 4 MiB the
// staging must move to a kvmap-backed (non-contiguous → contiguous-virtual)
// buffer; until then this is the honest ceiling, kept in one place.
let is i64 as SPAWN_IMG_MAX = 4194304;   // 4 MiB = 1024 pages (buddy MAX_BLOCK_ORDER)

// VFS metadata — thin forwards to the vfs.* ops, whose implementation is
// already complete (vfs.test exercises all of them). Userspace had file
// read/write but no way to list/remove/rename until these.
let is i64 as SYS_UNLINK         = 16;   // (path, len)          → 0 | errno
let is i64 as SYS_MKDIR          = 17;   // (path, len)          → 0 | errno
let is i64 as SYS_RMDIR          = 18;   // (path, len)          → 0 | errno
let is i64 as SYS_RENAME         = 19;   // (src,slen,dst,dlen)  → 0 | errno
let is i64 as SYS_STAT           = 20;   // (path, len, out)     → 0 | errno
let is i64 as SYS_READDIR        = 21;   // (fd, out)            → 0 entry | E_NOENT end | errno
// --- appended: display (the surface is a key — see docs/architecture.md §6–7) ---
let is i64 as SYS_DEV_OPEN       = 22;   // (class, index, flags) → fd | errno
let is i64 as SYS_PRESENT        = 23;   // (fd, x, y, w, h)      → 0  | errno
// --- appended: IPC (the channel is the founding primitive — §5) ---
let is i64 as SYS_CHANNEL_CREATE = 24;   // (out_ptr) → 0; writes [fd_a, fd_b] | errno
// --- appended: display geometry — the read-counterpart of PRESENT (present writes a
//     damage rect; this reads the surface's shape so the holder can index pixels) ---
let is i64 as SYS_SURFACE_INFO   = 25;   // (fd, out) → 0; writes SurfaceInfo {width,height,pitch,bpp_bytes,format} (5×i64=40B) | errno
// --- appended: device enumeration — the count-counterpart of dev_open. A
//     userspace device manager asks "how many of this class?" then dev_opens
//     each index (the index is real; out-of-range is E_NOENT, not an alias). ---
let is i64 as SYS_DEV_COUNT      = 26;   // (class) → count (>= 0)
// --- appended: strict reserve/commit (Phase E). SYS_MMAP without MMAP_RESERVE
//     stays reserve+commit-eager (legacy); with it, reserve-only. commit/
//     decommit back/drop frames over a reserved range; SYS_MUNMAP = release. ---
let is i64 as SYS_COMMIT          = 27;  // (addr, len, prot)  → 0 | errno
let is i64 as SYS_DECOMMIT        = 28;  // (addr, len)        → 0 | errno
// --- appended: segments (KOBJ_SEGMENT) — shareable RAM behind an fd. attach =
//     SYS_MMAP|MMAP_FD on the fd (reuses ko_mmap); detach = close/SYS_MUNMAP. ---
let is i64 as SYS_SEG_CREATE      = 29;  // (npages, flags)    → fd | errno
let is i64 as SYS_SEG_CLONE       = 30;  // (fd)               → fd | errno
let is i64 as SYS_SEG_COPY        = 31;  // (fd, off, ubuf, len, dir) → 0 | errno; dir 0=read seg→ubuf, 1=write ubuf→seg
// --- appended: out-of-band fd (KObject reference) passing over a channel ---
let is i64 as SYS_FD_SEND         = 32;  // (chan_fd, fd)      → 0  | E_AGAIN (slot busy) | errno
let is i64 as SYS_FD_RECV         = 33;  // (chan_fd)          → fd | E_AGAIN (nothing) | errno
// --- appended: wait-many readiness — the userspace multiplexer. Channel and
//     device reads block; a single-threaded event loop (a WM listening to
//     keyboard + mouse + N client channels, a terminal to its WM channel +
//     a child's stdout) needs ONE place to wait on all of them. entries =
//     array of n records, 3×i64 each {fd, want, got}: want = POLL_* bits the
//     caller cares about; the kernel writes got = observed readiness masked
//     to (want | POLL_CLOSED | POLL_ERROR). Returns how many entries have
//     got != 0 (0 = the deadline passed), or an errno. timeout_ns: 0 = one
//     non-blocking sweep, < 0 = wait forever, > 0 = HPET-ns deadline. A bad
//     fd inside the array marks THAT entry POLL_ERROR and counts it ready —
//     one dead fd never wedges the loop. ---
let is i64 as SYS_POLL            = 34;  // (entries_uptr, n, timeout_ns) → n_ready | errno
// --- appended: forced termination. Only the PARENT may kill (the spawn
//     key is the kill authority — no ambient pid namespace). The target's
//     thread is marked; the scheduler parks it at its next preemption (the
//     1ms tick bounds a pure-user spin) or wherever it already sleeps, and
//     never resumes it. The killer then zombifies with exit code 137,
//     drains the fd table (peers see EOF/CLOSED immediately) and hands the
//     corpse to the deferred reaper. wait() collects as usual. The graceful
//     tier stays a userspace convention (CLOSE_REQ over a channel). ---
let is i64 as SYS_PROC_KILL       = 35;  // (pid) → 0 | E_NOENT (not a child) | E_AGAIN
// --- appended: introspection — the read-only counterparts of spawn/mmap.
//     A userspace monitor (ps/top/free/df) reads these; they snapshot kernel
//     state, never change it. PROC_LIST walks the process tree from init. ---
let is i64 as SYS_PROC_LIST       = 36;  // (entries_uptr, max) → total_count | errno
let is i64 as SYS_MEM_INFO        = 37;  // (out_uptr)          → 0 | errno
let is i64 as SYS_STATFS          = 38;  // (out_uptr)          → 0 | errno
let is i64 as SYS_CPU_STAT        = 39;  // (out_uptr) → ncpu; writes [ncpu, busy0, busy1, ...] (1 per cpu, sampled)
let is i64 as SYS_TIME_WALL       = 40;  // (out_uptr) → 0; raw RTC fields [year,month,day,hour,min,sec] (calendar/format is userspace policy)
let is i64 as SYS_POWEROFF        = 41;  // () → does not return; ACPI S5 soft-off
let is i64 as SYS_REBOOT          = 42;  // () → does not return; machine reset
let is i64 as SYS_POWER_PENDING   = 43;  // () → 1 if the power button was pressed (WM polls this)

// SYS_PROC_LIST fills an array of ProcInfo (PROC_INFO_WORDS i64 = 64 B each),
// up to `max` entries, and returns the TOTAL live process count — so the
// caller can tell the snapshot was truncated (total > max). Each ProcInfo:
//   [0] pid  [1] ppid (0 = none)  [2] state (process.PROC_*)
//   [3] exit_code (valid once ZOMBIE)  [4] thread_count  [5] committed_bytes
//   [6..7] name — argv[0] (display label, not authority), 16 bytes incl. NUL
let is i64 as PROC_INFO_WORDS = 8;
let is i64 as PROC_LIST_MAX   = 64;     // kbuf bound on the kstack

// SYS_MEM_INFO fills MemInfo (4 i64): [total_pages, free_pages, page_size,
// committed_bytes_total]. The first three are physical truth from the PMM;
// committed_bytes_total sums every aspace's committed anon RAM.
// SYS_STATFS fills StatfsInfo (3 i64): [total_bytes, free_bytes, block_size]
// for the mounted filesystem.

// SYS_COUNT = highest valid id + 1. This is the number reported to
// userspace as the probe ceiling (KernInfo.syscalls_max): "syscall N
// exists iff N < SYS_COUNT". Bump it when appending a real syscall.
let is i64 as SYS_COUNT = 44;

// SYS_POLL readiness bits. READABLE/WRITABLE mean "the op would make
// progress NOW": data or a pending EOF for read, space or a pending E_PIPE
// for write. CLOSED (peer endpoint gone) rides along even when not asked
// for, so a holder can tell hangup from data. POLL_ERROR marks an entry
// whose fd is bad or whose object refused to poll. On a CHANNEL, WRITABLE
// guarantees at least POLL_WRITE_UNIT bytes go through without blocking or
// splitting — the minimum progress unit a protocol message can rely on.
// Devices whose write op is null (keyboard, mouse) never report WRITABLE.
let is i64 as POLL_READABLE    = 1;
let is i64 as POLL_WRITABLE    = 2;
let is i64 as POLL_CLOSED      = 4;
let is i64 as POLL_ERROR       = 8;
let is i64 as POLL_MAX_ENTRIES = 64;     // == the fd-table cap
let is i64 as POLL_WRITE_UNIT  = 64;

// dev_open device classes.
let is i64 as DEV_FB       = 0;      // the framebuffer → a surface
let is i64 as DEV_KEYBOARD = 1;      // the keyboard → a raw-event device
// The mouse → a raw-event device. Reads drain fixed 4-byte records, whole
// records only: [dx i8, dy i8, buttons u8, wheel i8]. dx/dy are signed raw
// PS/2 deltas (dy positive = UP; screen-space inversion is userspace
// policy), buttons is a state mask (bit0 L, bit1 R, bit2 M), wheel is
// signed detents (0 on wheel-less mice). Deltas beyond +-127 arrive split
// across consecutive records.
let is i64 as DEV_MOUSE    = 2;
// The tablet → an ABSOLUTE-position raw-event device (virtio-input).
// Reads drain fixed 8-byte records, whole records only:
// [x u16 LE, y u16 LE, buttons u8, wheel i8, 0, 0]. x/y are absolute,
// normalized to 0..32767 (0,0 = top-left); scaling onto the framebuffer is
// userspace policy. buttons mask: bit0 L, bit1 R, bit2 M. One record per
// device SYN batch — position is state, not deltas, which is what lets a
// hypervisor's pointer track the host cursor with no grab.
let is i64 as DEV_TABLET   = 3;

// SYS_SURFACE_INFO pixel format (5th word of its out struct). v0 is always
// XRGB8888 (32bpp packed LE: 0x00RRGGBB) — the surface mirrors the Limine
// framebuffer; real per-channel masks land when the fb exposes them.
let is i64 as SURFACE_FMT_XRGB8888 = 0;

// SYS_MMAP fd-backed flag (OR'd into the prot arg): when set, the 4th arg
// is an fd whose object provides the pages (a surface's backbuffer); the
// mapping is not anonymous. Old 3-arg callers don't set it → anonymous,
// unchanged — keeps the 4th register's garbage from being read as an fd.
let is i64 as MMAP_FD = 0x10;

// SYS_MMAP reserve-only flag (OR'd into the prot arg): claim the VA window but
// back NO pages (Phase E strict reserve). Touching the range then faults fatal
// until SYS_COMMIT backs it. Without this flag SYS_MMAP stays reserve+commit-
// eager (legacy), so old callers are unchanged.
let is i64 as MMAP_RESERVE = 0x20;

// SYS_MMAP prot bits (3rd arg). Anonymous-only in v0: no fd/offset, no
// file backing. Match CSE segment perms — R=1, W=2, X=4. Read is implied
// (the page is mapped present); WRITE adds PTE_WRITE; absence of EXEC sets
// PTE_NX. The kernel always sets PTE_USER.
let is i64 as MMAP_PROT_READ  = 1;
let is i64 as MMAP_PROT_WRITE = 2;
let is i64 as MMAP_PROT_EXEC  = 4;

// SYS_OPEN flags (3rd arg). Same bit values the VFS uses, so the handler
// forwards them unchanged. Access mode lives in the low two bits.
let is i64 as O_RDONLY = 0x0000;
let is i64 as O_WRONLY = 0x0001;
let is i64 as O_RDWR   = 0x0002;
let is i64 as O_CREAT  = 0x0040;
let is i64 as O_EXCL   = 0x0080;
let is i64 as O_TRUNC  = 0x0200;
let is i64 as O_APPEND = 0x0400;

// SYS_LSEEK whence.
let is i64 as SEEK_SET = 0;
let is i64 as SEEK_CUR = 1;
let is i64 as SEEK_END = 2;

// SYS_MAX = physical capacity of the dispatch table (syscall.cst). Kept
// larger than SYS_COUNT so appending a syscall doesn't resize the array;
// slots [SYS_COUNT, SYS_MAX) stay zeroed and dispatch to E_NOSYS. Do NOT
// report this to userspace — that would claim syscalls that don't exist.
let is i64 as SYS_MAX = 64;

// ============================================================
// KERN_INFO output struct.
//
// Cheap, static version/feature probe: userspace calls SYS_KERN_INFO
// once at startup; the kernel fills the buffer. Avoids the Linux
// try-and-ENOSYS pattern at zero per-call cost.
//
// Append-only: new fields are added at the end and ABI_MINOR bumps; the
// struct only grows, so an old binary reading the first info_size bytes
// stays valid. info_size (not a separate version word) tells the reader
// how many bytes are present — there is deliberately no info_version,
// since the struct layout version IS the ABI version.
//
// This struct holds ONLY static facts. Dynamic state (the clock) lives
// in SYS_TIME_NOW_NS, never here — a field that changes per call would
// silently go stale the moment userspace caches the probe result.
// ============================================================

let is i64 as KERN_INFO_SIZE = 48;

let is i64 as ABI_MAJOR = 0;
let is i64 as ABI_MINOR = 1;

struct KernInfo {
    info_size as i64;          // 0:  bytes the kernel wrote (KERN_INFO_SIZE)
    abi_major as i64;          // 8:  bumps on incompatible ABI changes
    abi_minor as i64;          // 16: bumps on additive changes
    syscalls_max as i64;       // 24: probe ceiling (SYS_COUNT)
    page_size as i64;          // 32: 4096
    flags as i64;              // 40: feature bits (none in v0; reserved 0)
}
