// channel.cst — the channel object (KOBJ_CHANNEL): the founding IPC
// primitive. Two endpoints, each an fd; a byte stream in each direction.
// Console, pipes, shell↔terminal all ride on this (docs/architecture.md §5).
//
// Data only, byte stream — no message framing, no handle-passing in the
// kernel (that's userspace policy / a future op). read/write are the honest
// ops (a channel genuinely IS a byte sequence, like a file); mmap/present/
// lseek/readdir are null. read/write dispatch through ko_read/ko_write, so
// SYS_READ/SYS_WRITE drive a channel fd for free.
//
// v0 blocking is by polling (sleep_for_ns, like proc_wait): simple and free
// of the lost-wakeup race that a wait/wake scheme needs care to avoid; the
// ~1 ms latency is imperceptible for a console. A wakeup_thread fast-path is
// a later refinement.

use "kobject.cst" as kobject;
use "heap.cst" as heap;
use "pmm.cst" as pmm;
use "lock.cst" as lock;
use "abi.cst" as abi;
use "sched.cst" as sched;
use "serial.cst" as serial;
use "util.cst" as util;

// Bytes per direction (power of 2). 8 KiB, not 1 KiB: a channel is the
// transport under every daemon protocol in the system, and 1 KiB was already
// throttling the shell. netd hands HTTP response bodies through one of these,
// where a 1 KiB pipe costs a round trip per kilobyte. A Channel is kmalloc'ed,
// so the whole cost is ~16 KiB per channel instead of ~2 KiB.
//
// The struct's array declarations below must be edited in lockstep — Caustic
// takes a literal length there, so the constant cannot size them.
let is i64 as BUF_CAP  = 8192;
let is i64 as BUF_MASK = 8191;
let is i64 as POLL_NS  = 1000000;     // 1 ms blocking poll

// Tudo i64 (mixed-width rule); the two byte buffers go last.
struct Channel {
    refcount as i64;        // live endpoints (2 at create)
    a2b_head as i64;
    a2b_tail as i64;
    a2b_count as i64;
    b2a_head as i64;
    b2a_tail as i64;
    b2a_count as i64;
    a_closed as i64;
    b_closed as i64;
    to_a_pending as i64;    // a KObject sent by B, awaiting A's recv (0 = none)
    to_b_pending as i64;    // a KObject sent by A, awaiting B's recv (0 = none)
    lk as lock.TicketLock;
    a2b_buf as [8192]u8;    // A → B   (== BUF_CAP)
    b2a_buf as [8192]u8;    // B → A   (== BUF_CAP)
}

struct ChannelEndpoint {
    channel as i64;         // *Channel
    side as i64;            // 0 = A, 1 = B
}

let is kobject.KObjectOps as CHANNEL_OPS with mut;

fn init() as void {
    CHANNEL_OPS.read  = fn_ptr(chan_read);
    CHANNEL_OPS.write = fn_ptr(chan_write);
    CHANNEL_OPS.close = fn_ptr(chan_close);
    CHANNEL_OPS.poll  = fn_ptr(chan_poll);
    // mmap/present/lseek/readdir stay null — a channel is a byte stream.
}

// ============================================================
// Ring buffer helpers — caller holds the channel lock.
// ============================================================

fn ring_pop(bufbase as i64, head as *i64, count as *i64, dst as i64, n as i64) as i64 {
    let is i64 as avail = *count;
    let is i64 as take with mut = n;
    if (take > avail) { take = avail; }
    let is i64 as h with mut = *head;
    let is i64 as i with mut = 0;
    while (i < take) {
        let is *u8 as s = cast(*u8, bufbase + h);
        let is *u8 as d = cast(*u8, dst + i);
        d[0] = s[0];
        h = (h + 1) & BUF_MASK;
        i = i + 1;
    }
    *head = h;
    *count = avail - take;
    return take;
}

fn ring_push(bufbase as i64, tail as *i64, count as *i64, src as i64, n as i64) as i64 {
    let is i64 as space = BUF_CAP - *count;
    let is i64 as put with mut = n;
    if (put > space) { put = space; }
    let is i64 as t with mut = *tail;
    let is i64 as i with mut = 0;
    while (i < put) {
        let is *u8 as s = cast(*u8, src + i);
        let is *u8 as d = cast(*u8, bufbase + t);
        d[0] = s[0];
        t = (t + 1) & BUF_MASK;
        i = i + 1;
    }
    *tail = t;
    *count = *count + put;
    return put;
}

// ============================================================
// Ops. `buf` is a kernel address (the syscall layer staged the copy).
// ============================================================

// Read from the endpoint's INPUT direction (A reads b2a, B reads a2b).
// Blocks until data arrives; returns 0 (EOF) once empty and the writer
// side has closed.
fn chan_read(priv as i64, buf as i64, n as i64) as i64 {
    if (priv == 0) { return abi.E_BADF; }
    if (n <= 0) { return 0; }
    let is *ChannelEndpoint as ep = cast(*ChannelEndpoint, priv);
    let is *Channel as ch = cast(*Channel, ep.channel);
    let is i64 as side = ep.side;
    let is i64 as done with mut = 0;
    let is i64 as result with mut = 0;
    while (done == 0) {
        let is i64 as fl = lock.acquire_irq(&ch.lk);
        let is i64 as got with mut = 0;
        if (side == 0) {
            got = ring_pop(cast(i64, &ch.b2a_buf[0]), &ch.b2a_head, &ch.b2a_count, buf, n);
        } else {
            got = ring_pop(cast(i64, &ch.a2b_buf[0]), &ch.a2b_head, &ch.a2b_count, buf, n);
        }
        let is i64 as other_closed with mut = 0;
        if (side == 0) { other_closed = ch.b_closed; } else { other_closed = ch.a_closed; }
        lock.release_irq(&ch.lk, fl);
        if (got > 0) {
            result = got;
            done = 1;
            sched.poll_wake();        // space freed: a writer may be parked
        }
        else if (other_closed != 0) { result = 0;   done = 1; }   // EOF
        else                      { sched.sleep_for_ns(POLL_NS); }
    }
    return result;
}

// Write to the endpoint's OUTPUT direction (A writes a2b, B writes b2a).
// Blocks until at least one byte fits; E_PIPE once the reader side closed.
fn chan_write(priv as i64, buf as i64, n as i64) as i64 {
    if (priv == 0) { return abi.E_BADF; }
    if (n <= 0) { return 0; }
    let is *ChannelEndpoint as ep = cast(*ChannelEndpoint, priv);
    let is *Channel as ch = cast(*Channel, ep.channel);
    let is i64 as side = ep.side;
    let is i64 as done with mut = 0;
    let is i64 as result with mut = 0;
    while (done == 0) {
        let is i64 as fl = lock.acquire_irq(&ch.lk);
        let is i64 as other_closed with mut = 0;
        if (side == 0) { other_closed = ch.b_closed; } else { other_closed = ch.a_closed; }
        let is i64 as put with mut = 0;
        if (other_closed == 0) {
            if (side == 0) {
                put = ring_push(cast(i64, &ch.a2b_buf[0]), &ch.a2b_tail, &ch.a2b_count, buf, n);
            } else {
                put = ring_push(cast(i64, &ch.b2a_buf[0]), &ch.b2a_tail, &ch.b2a_count, buf, n);
            }
        }
        lock.release_irq(&ch.lk, fl);
        if (other_closed != 0) { result = abi.E_PIPE; done = 1; }
        else if (put > 0) {
            result = put;
            done = 1;
            sched.poll_wake();        // a reader may have been parked on this
        }
        else                   { sched.sleep_for_ns(POLL_NS); }   // full
    }
    return result;
}

// Readiness for SYS_POLL. READABLE: my input ring has bytes, or the peer
// closed (a read returns EOF without blocking — buffered bytes still drain
// first since the count also reports READABLE). WRITABLE: the output ring
// has at least POLL_WRITE_UNIT bytes free — so a write of one protocol-sized
// message completes whole, never splits, never blocks on a stuck peer — or
// the peer closed (a write returns E_PIPE without blocking; "progress" too).
// CLOSED rides along so the holder can tell hangup from data.
fn chan_poll(priv as i64) as i64 {
    if (priv == 0) { return abi.E_BADF; }
    let is *ChannelEndpoint as ep = cast(*ChannelEndpoint, priv);
    let is *Channel as ch = cast(*Channel, ep.channel);
    let is i64 as fl = lock.acquire_irq(&ch.lk);
    let is i64 as in_count with mut = 0;
    let is i64 as out_count with mut = 0;
    let is i64 as other_closed with mut = 0;
    if (ep.side == 0) {
        in_count = ch.b2a_count;
        out_count = ch.a2b_count;
        other_closed = ch.b_closed;
    } else {
        in_count = ch.a2b_count;
        out_count = ch.b2a_count;
        other_closed = ch.a_closed;
    }
    lock.release_irq(&ch.lk, fl);
    let is i64 as st with mut = 0;
    if (in_count > 0) { st = st | abi.POLL_READABLE; }
    if (other_closed != 0) {
        st = st | abi.POLL_READABLE | abi.POLL_WRITABLE | abi.POLL_CLOSED;
    } else if (BUF_CAP - out_count >= abi.POLL_WRITE_UNIT) {
        st = st | abi.POLL_WRITABLE;
    }
    return st;
}

// Is this KObject one of ours? Vtable identity is the type — otype is
// KOBJ_CHANNEL for both ends and says nothing about which module built it,
// and a syscall that reads `priv` on the strength of a shared otype is one
// mismatched fd away from interpreting somebody else's pointer. Same
// discriminator netdev and audio use.
fn endpoint_of(ko as i64) as i64 {
    let is *kobject.KObject as k = cast(*kobject.KObject, ko);
    if (k.otype != kobject.KOBJ_CHANNEL) { return 0; }
    if (cast(i64, k.ops) != cast(i64, &CHANNEL_OPS)) { return 0; }
    return k.priv;
}

// How much this endpoint can move right now. See abi.CHAN_INFO_WORDS for what
// each word means and abi's SYS_CHAN_INFO note for why a server cannot
// multiplex without it.
fn chan_info(priv as i64, out as *i64) as i64 {
    if (priv == 0) { return abi.E_BADF; }
    let is *ChannelEndpoint as ep = cast(*ChannelEndpoint, priv);
    let is *Channel as ch = cast(*Channel, ep.channel);
    let is i64 as fl = lock.acquire_irq(&ch.lk);
    let is i64 as in_count with mut = 0;
    let is i64 as out_count with mut = 0;
    let is i64 as other_closed with mut = 0;
    if (ep.side == 0) {
        in_count = ch.b2a_count;
        out_count = ch.a2b_count;
        other_closed = ch.b_closed;
    } else {
        in_count = ch.a2b_count;
        out_count = ch.b2a_count;
        other_closed = ch.a_closed;
    }
    lock.release_irq(&ch.lk, fl);
    out[0] = BUF_CAP;
    out[1] = in_count;
    out[2] = BUF_CAP - out_count;
    out[3] = other_closed;
    return abi.E_OK;
}

// Close one endpoint. Marks its side closed (so the peer sees EOF/E_PIPE),
// drops the channel's endpoint refcount, frees the Channel when the last
// endpoint goes, and frees the endpoint struct.
// chan_send_ko / chan_recv_ko — out-of-band KObject (fd) passing over a channel,
// the SCM_RIGHTS analogue. send from side X parks one ALREADY-REF'd KObject in
// the slot the OTHER side reads; recv takes it. One slot per direction (v0): a
// second send before the peer recvs is E_AGAIN. The kernel only moves a
// reference the sender holds — authority transfer, not fabrication.
fn chan_send_ko(priv as i64, ko as i64) as i64 {
    if (priv == 0) { return abi.E_BADF; }
    let is *ChannelEndpoint as ep = cast(*ChannelEndpoint, priv);
    let is *Channel as ch = cast(*Channel, ep.channel);
    let is i64 as fl = lock.acquire_irq(&ch.lk);
    let is i64 as rc with mut = abi.E_OK;
    if (ep.side == 0) {
        if (ch.to_b_pending != 0) { rc = abi.E_AGAIN; } else { ch.to_b_pending = ko; }
    } else {
        if (ch.to_a_pending != 0) { rc = abi.E_AGAIN; } else { ch.to_a_pending = ko; }
    }
    lock.release_irq(&ch.lk, fl);
    return rc;
}

// Returns the pending *KObject for this side (ref already held), or 0 if none.
fn chan_recv_ko(priv as i64) as i64 {
    if (priv == 0) { return 0; }
    let is *ChannelEndpoint as ep = cast(*ChannelEndpoint, priv);
    let is *Channel as ch = cast(*Channel, ep.channel);
    let is i64 as fl = lock.acquire_irq(&ch.lk);
    let is i64 as ko with mut = 0;
    if (ep.side == 0) { ko = ch.to_a_pending; ch.to_a_pending = 0; }
    else             { ko = ch.to_b_pending; ch.to_b_pending = 0; }
    lock.release_irq(&ch.lk, fl);
    return ko;
}

fn chan_close(priv as i64) as i64 {
    if (priv == 0) { return abi.E_BADF; }
    let is *ChannelEndpoint as ep = cast(*ChannelEndpoint, priv);
    let is *Channel as ch = cast(*Channel, ep.channel);
    let is i64 as fl = lock.acquire_irq(&ch.lk);
    if (ep.side == 0) { ch.a_closed = 1; } else { ch.b_closed = 1; }
    // A close is a readiness change too: the peer's poll must report CLOSED
    // now, not in fifty milliseconds.
    sched.poll_wake();
    lock.release_irq(&ch.lk, fl);
    let is i64 as old = lock.atomic_add(&ch.refcount, cast(i64, 0 - 1));
    if (old == 1) {
        // Last endpoint: drop any never-received in-flight references so they
        // don't leak (the peer that would have recv'd them is gone).
        if (ch.to_a_pending != 0) { kobject.ko_unref(ch.to_a_pending); }
        if (ch.to_b_pending != 0) { kobject.ko_unref(ch.to_b_pending); }
        heap.kfree(cast(i64, ch));
    }
    heap.kfree(priv);
    return abi.E_OK;
}

// ============================================================
// Mint a connected pair. Returns the two endpoint *KObjects via out
// params (Caustic has no multi-return). 0 on success, -1 on OOM.
// ============================================================

fn channel_create(out_ko_a as *i64, out_ko_b as *i64) as i32 {
    let is i64 as ch_addr = heap.kmalloc(sizeof(Channel), pmm.ALLOC_ZERO);
    if (ch_addr == 0) { return cast(i32, 0 - 1); }
    let is *Channel as ch = cast(*Channel, ch_addr);
    ch.refcount = 2;     // buffers + cursors + closed flags + lk zeroed by ALLOC_ZERO

    let is i64 as ep_a = heap.kmalloc(sizeof(ChannelEndpoint), pmm.ALLOC_ZERO);
    if (ep_a == 0) { heap.kfree(ch_addr); return cast(i32, 0 - 1); }
    let is *ChannelEndpoint as epa = cast(*ChannelEndpoint, ep_a);
    epa.channel = ch_addr;
    epa.side = 0;

    let is i64 as ep_b = heap.kmalloc(sizeof(ChannelEndpoint), pmm.ALLOC_ZERO);
    if (ep_b == 0) { heap.kfree(ep_a); heap.kfree(ch_addr); return cast(i32, 0 - 1); }
    let is *ChannelEndpoint as epb = cast(*ChannelEndpoint, ep_b);
    epb.channel = ch_addr;
    epb.side = 1;

    let is i64 as ko_a = kobject.ko_alloc(kobject.KOBJ_CHANNEL, &CHANNEL_OPS, ep_a);
    if (ko_a == 0) { heap.kfree(ep_b); heap.kfree(ep_a); heap.kfree(ch_addr); return cast(i32, 0 - 1); }
    let is i64 as ko_b = kobject.ko_alloc(kobject.KOBJ_CHANNEL, &CHANNEL_OPS, ep_b);
    // Error path uses raw kfree (not ko_unref): nothing is wired/shared yet,
    // so no close op should run.
    if (ko_b == 0) { heap.kfree(ko_a); heap.kfree(ep_b); heap.kfree(ep_a); heap.kfree(ch_addr); return cast(i32, 0 - 1); }

    *out_ko_a = ko_a;
    *out_ko_b = ko_b;
    return 0;
}

// ============================================================
// Kernel-side smoke: mint a pair, write on A, read it back on B.
// ============================================================

fn smoke() as void {
    serial.println("channel_smoke: start", 20);
    let is i64 as ko_a with mut = 0;
    let is i64 as ko_b with mut = 0;
    if (channel_create(&ko_a, &ko_b) != 0) {
        serial.println("channel_smoke: create FAIL", 26);
        return;
    }
    let is *kobject.KObject as ka = cast(*kobject.KObject, ko_a);
    let is *kobject.KObject as kb = cast(*kobject.KObject, ko_b);

    let is [4]u8 as msg;
    msg[0] = cast(u8, 0x43); msg[1] = cast(u8, 0x48);     // 'C','H'
    msg[2] = cast(u8, 0x41); msg[3] = cast(u8, 0x4E);     // 'A','N'
    let is i64 as wrote = chan_write(ka.priv, cast(i64, &msg[0]), 4);

    let is [4]u8 as got;
    got[0] = cast(u8, 0); got[1] = cast(u8, 0); got[2] = cast(u8, 0); got[3] = cast(u8, 0);
    let is i64 as red = chan_read(kb.priv, cast(i64, &got[0]), 4);

    let is i64 as ok with mut = 1;
    if (wrote != 4) { ok = 0; }
    if (red != 4)   { ok = 0; }
    let is i64 as i with mut = 0;
    while (i < 4) {
        if (got[i] != msg[i]) { ok = 0; }
        i = i + 1;
    }

    kobject.ko_unref(ko_a);
    kobject.ko_unref(ko_b);

    if (ok == 1) { serial.println("channel_smoke: PASS", 19); }
    else {
        serial.print("channel_smoke: FAIL wrote=", 26);
        util.print_num(wrote);
        serial.print(" red=", 5);
        util.print_num(red);
        serial.println("", 0);
    }
}

// fd_pass_smoke — out-of-band KObject passing over a channel. Use a SECOND
// channel's endpoint as the object to pass (any KObject works), so this needs
// no segment dependency: send endpoint b2 over channel-1 from side A, recv it on
// side B, and confirm the SAME KObject is delivered, a second recv is empty, and
// the refcounts unwind with no leak. Mirrors what sys_fd_send/recv do.
fn fd_pass_smoke() as void {
    serial.println("chan_fdpass_smoke: start", 24);
    let is i32 as ok with mut = cast(i32, 1);

    let is i64 as a1 with mut = 0;
    let is i64 as b1 with mut = 0;
    let is i64 as a2 with mut = 0;
    let is i64 as b2 with mut = 0;
    if (channel_create(&a1, &b1) != cast(i32, 0)) { pmm.panic("fdpass: chan1 FAIL", 18); }
    if (channel_create(&a2, &b2) != cast(i32, 0)) { pmm.panic("fdpass: chan2 FAIL", 18); }

    // Send b2 over channel-1 from side A (a1); the kernel would ko_ref first.
    kobject.ko_ref(b2);
    if (chan_send_ko(kobject.ko_priv(a1), b2) != abi.E_OK) { ok = cast(i32, 0); }
    // A second send before recv is E_AGAIN (one slot per direction).
    if (chan_send_ko(kobject.ko_priv(a1), b2) != abi.E_AGAIN) { ok = cast(i32, 0); }

    // Recv on side B (b1) -> the same KObject.
    let is i64 as got = chan_recv_ko(kobject.ko_priv(b1));
    if (got != b2) { ok = cast(i32, 0); }
    if (chan_recv_ko(kobject.ko_priv(b1)) != 0) { ok = cast(i32, 0); }   // nothing more
    kobject.ko_unref(got);                                               // recv side drops its ref

    kobject.ko_unref(a1);
    kobject.ko_unref(b1);
    kobject.ko_unref(a2);
    kobject.ko_unref(b2);

    if (ok == cast(i32, 1)) { serial.println("chan_fdpass_smoke: PASS", 23); }
    else { pmm.panic("chan_fdpass_smoke FAIL", 22); }
}
