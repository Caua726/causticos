// userspace.cst — ring-3 entry primitives + first-user-thread smoke.
//
// What this gives us, building on the gdt + per-thread aspace work:
//
//   - enter_user(rip, rsp): the asm sequence that flips the CPU into
//     ring 3 via IRETQ. Pushes the (SS, RSP, RFLAGS, CS, RIP) frame
//     in the order IRETQ pops them, then iretq.
//   - user_thread_trampoline(): kernel-side stub installed as a
//     thread's entry. On first dispatch it reads the thread's
//     user_entry / user_rsp slots and calls enter_user.
//   - spawn_user_smoke(): builds a fresh aspace, maps a couple of
//     user pages with a tiny shellcode that increments a counter,
//     creates a user thread pointing at it, then polls the counter
//     to confirm the thread is making forward progress in ring 3.
//
// Future syscall + page-fault work will plug into the same path
// (the trampoline / iretq frame). Nothing here depends on the
// design-decision-loaded layers (syscall shape, IPC, etc.).

use "serial.cst" as serial;
use "util.cst" as util;
use "pmm.cst" as pmm;
use "vmm.cst" as vmm;
use "vma.cst" as vma;
use "sched.cst" as sched;
use "timer.cst" as timer;
use "vfs.cst" as vfs;
use "elf.cst" as elf;
use "cse.cst" as cse;
use "abi.cst" as abi;
use "process.cst" as proc;
use "fb.cst" as fb;
use "channel.cst" as channel;
use "kobject.cst" as kobject;

// User VAs the smoke uses. Anywhere in the lower half is fine; we
// pick spaced-out 4 KiB pages so a copy/paste typo doesn't silently
// land on the same page as something else.
let is i64 as USER_TEXT_VA    = 0x0000000000400000;
let is i64 as USER_DATA_VA    = 0x0000000000401000;
let is i64 as USER_STACK_VA   = 0x0000000000600000;

// Page-table flag aliases. PTE_PRESENT / PTE_WRITE / PTE_USER / PTE_NX
// all live in vmm; we just keep this file readable by giving the
// most-used combinations short names.

// ----------------------------------------------------------------
// Ring-3 entry asm.
//
// Caustic prologue clobbers rdi/rsi before any inline asm runs (it
// stashes args to spill slots), so the iretq frame can't be built
// directly from registers — we shuttle through module globals.
// Concurrent enter_user calls would race on these slots, but ring-3
// entry is rare (once per user-thread spawn) and serialised by the
// thread doing it. If a future workload spawns user threads on
// multiple cpus simultaneously this needs to move to per-cpu
// storage.
//
// IRETQ pops in order (low → high on stack):
//   RIP, CS, RFLAGS, RSP, SS
//
// We push them in the reverse order. RFLAGS = 0x202 sets IF=1 (so
// the LAPIC timer can preempt the user thread) and the always-set
// reserved bit 1.
//
// DS/ES/FS get reloaded to USER_DS_SEL (0x23) so any user code that
// reads a segment register sees a ring-3 selector. GS is left alone:
// loading it in 64-bit mode would clobber GSBASE (per-cpu pointer)
// and anyway iretq doesn't pop GS.
// ----------------------------------------------------------------
let is i64 as enter_user_rip with mut = 0;
let is i64 as enter_user_rsp with mut = 0;

fn enter_user(rip as i64, rsp as i64) as void {
    enter_user_rip = rip;
    enter_user_rsp = rsp;

    // Build the iretq frame. Pull rip/rsp from the shuttle globals
    // since rdi/rsi are unreliable here. iretq with a CS DPL change
    // also reloads SS for us, so we don't need to mov ss/ds/es/fs
    // ourselves; the SS reload by iretq tags DS/ES/FS as null
    // implicitly in 64-bit mode (segment regs are mostly ignored).
    asm("mov rax, 0x23\n");      // SS  = USER_DS_SEL
    asm("push rax\n");
    asm("lea rax, [rip+_kernel_userspace_cst_enter_user_rsp]\n");
    asm("mov rax, QWORD PTR [rax]\n");
    asm("push rax\n");           // RSP (user)
    asm("mov rax, 0x202\n");     // RFLAGS = IF | reserved
    asm("push rax\n");
    asm("mov rax, 0x2B\n");      // CS  = USER_CS64_SEL
    asm("push rax\n");
    asm("lea rax, [rip+_kernel_userspace_cst_enter_user_rip]\n");
    asm("mov rax, QWORD PTR [rax]\n");
    asm("push rax\n");           // RIP (user)
    asm(".byte 0x48, 0xCF\n");   // iretq (caustic-as drops the mnemonic)
}

// First instructions of every ring-3 thread. Runs in ring 0 with
// the thread's aspace_pml4 already loaded by the context switch,
// then iretq's into ring 3 with the entry/rsp the spawner stashed.
fn user_thread_trampoline() as void {
    let is i64 as tid = sched.current_tid();
    let is i64 as rip = sched.thr_user_entry(tid);
    let is i64 as rsp = sched.thr_user_rsp(tid);
    if (rip == 0) {
        serial.println("userspace: trampoline tid has no user_entry", 44);
        return;
    }
    enter_user(rip, rsp);
}

// ----------------------------------------------------------------
// Smoke shellcode.
//
//   movabs rax, USER_DATA_VA   ; 48 B8 <imm64>
//   inc qword ptr [rax]        ; 48 FF 00
//   jmp -5                     ; EB FB
//
// Bounded loop (5M increments) then SYS_PROC_EXIT(0): the thread runs
// in ring 3, is preempted by the timer across the loop (the smoke sees
// the counter advancing), then exits cleanly — no immortal/leaked
// thread. This is also the workload that first exposed the kstack-top
// scheduler bug (TSS.RSP0 / syscall-kstack must be the fixed stack top,
// not the saved rsp); see schedule() in sched.cst.
// ----------------------------------------------------------------
fn write_smoke_shellcode(dst as *u8) as i64 {
    let is i64 as c with mut = 0;
    // movabs rax, USER_DATA_VA
    dst[c + 0] = cast(u8, 0x48); dst[c + 1] = cast(u8, 0xB8); c = c + 2;
    let is i64 as v with mut = USER_DATA_VA;
    let is i64 as i with mut = 0;
    while (i < 8) { dst[c + i] = cast(u8, v & 0xFF); v = v >> 8; i = i + 1; }
    c = c + 8;
    // mov rcx, 5000000
    dst[c + 0] = cast(u8, 0x48); dst[c + 1] = cast(u8, 0xC7); dst[c + 2] = cast(u8, 0xC1);
    dst[c + 3] = cast(u8, 0x40); dst[c + 4] = cast(u8, 0x4B);
    dst[c + 5] = cast(u8, 0x4C); dst[c + 6] = cast(u8, 0x00);
    c = c + 7;
    // .loop: inc qword [rax]
    dst[c + 0] = cast(u8, 0x48); dst[c + 1] = cast(u8, 0xFF); dst[c + 2] = cast(u8, 0x00);
    c = c + 3;
    // dec rcx
    dst[c + 0] = cast(u8, 0x48); dst[c + 1] = cast(u8, 0xFF); dst[c + 2] = cast(u8, 0xC9);
    c = c + 3;
    // jnz .loop  (rel8 = -8)
    dst[c + 0] = cast(u8, 0x75); dst[c + 1] = cast(u8, 0xF8); c = c + 2;
    // mov rax, 3  (SYS_PROC_EXIT)
    dst[c + 0] = cast(u8, 0x48); dst[c + 1] = cast(u8, 0xC7); dst[c + 2] = cast(u8, 0xC0);
    dst[c + 3] = cast(u8, 3); dst[c + 4] = cast(u8, 0);
    dst[c + 5] = cast(u8, 0); dst[c + 6] = cast(u8, 0);
    c = c + 7;
    // xor edi, edi  (exit code 0)
    dst[c + 0] = cast(u8, 0x31); dst[c + 1] = cast(u8, 0xFF); c = c + 2;
    // syscall
    dst[c + 0] = cast(u8, 0x0F); dst[c + 1] = cast(u8, 0x05); c = c + 2;
    return c;
}

// (Old syscall_smoke shellcode lived here, hard-coding rax=0 for
// the now-retired sys_test. Removed since spawn_user_elf_smoke
// exercises the real causticos ABI end-to-end.)

// mmap a fixed-VA, anonymous, eager-backed region in the aspace and
// hand back the kernel-virtual address of the first backing page so
// the caller can populate the region from kernel space. Returns 0
// on any failure (invalid prot, OOM, range overlap).
fn mmap_user_fixed(a as *vma.Aspace, va as i64, n as i64,
                   prot as i64, label as *u8, label_len as i32) as i64 {
    let is i64 as got = vma.mmap_anon(a, va, n * pmm.PAGE_SIZE,
                                       prot, vma.VMA_FIXED);
    if (got != va) {
        serial.print("userspace: mmap_anon fail ", 26);
        serial.println(label, label_len);
        return 0;
    }
    let is i64 as phys = vmm.virt_to_phys_walk(a.pml4_phys, va);
    if (phys == 0) {
        serial.print("userspace: phys lookup fail ", 28);
        serial.println(label, label_len);
        return 0;
    }
    return pmm.phys_to_virt(phys);
}

// Walk the user pml4 by hand to read the current counter value. We
// can't dereference USER_DATA_VA directly because the kernel runs
// against kas_pml4 here, not the smoke aspace. Instead, ask vmm for
// the physical address backing USER_DATA_VA and read it via HHDM.
fn read_user_counter(a as *vma.Aspace) as i64 {
    let is i64 as phys = vmm.virt_to_phys_walk(a.pml4_phys, USER_DATA_VA);
    if (phys == 0) { return cast(i64, 0 - 1); }
    let is *i64 as p = cast(*i64, pmm.phys_to_virt(phys));
    return p[0];
}

// ============================================================
// copy_from_user / copy_to_user
//
// The kernel side of "safe access to user memory". Caller passes
// the user thread's aspace pml4_phys and a user virtual address;
// we validate every covered page against the pml4 (PRESENT + USER,
// plus WRITE for copy_to_user) before touching it. Validation +
// copy are split because pte_lookup walks 4 cache lines per page
// — doing the walk first means the actual copy can run inline
// without per-byte branching.
//
// Returns 0 on full copy, -1 on any range / mapping / overflow
// problem. The kernel side of the copy assumes CR3 already points
// at `pml4_phys` (i.e. the caller is running on the user thread's
// kernel stack with the user aspace mapped). syscall handlers, the
// upcoming on-fault path, and the exit-cleanup path all satisfy
// this; cross-aspace copies go through walk + HHDM instead.
// ============================================================

let is i64 as USER_VA_MAX = 0x00007FFFFFFFFFFF;

fn user_range_ok(pml4 as i64, va as i64, n as i64, need_write as i32) as i32 {
    if (n < 0) { return 0; }
    if (n == 0) { return 1; }
    if (va < 0) { return 0; }
    let is i64 as end = va + n;
    if (end < va) { return 0; }                 // overflow
    if (end > USER_VA_MAX) { return 0; }

    let is i64 as page_mask = cast(i64, 0 - 1) - 0xFFF;
    let is i64 as p with mut = va & page_mask;
    let is i64 as last = (end - 1) & page_mask;
    while (p <= last) {
        let is i64 as pte = vmm.pte_lookup(pml4, p);
        if (pte == 0) { return 0; }
        if ((pte & vmm.PTE_USER) == 0) { return 0; }
        if (need_write == 1 && (pte & vmm.PTE_WRITE) == 0) { return 0; }
        p = p + pmm.PAGE_SIZE;
    }
    return 1;
}

fn copy_from_user(pml4 as i64, dst as *u8, user_va as i64, n as i64) as i32 {
    if (user_range_ok(pml4, user_va, n, cast(i32, 0)) == 0) {
        return cast(i32, 0 - 1);
    }
    let is *u8 as src = cast(*u8, user_va);
    let is i64 as i with mut = 0;
    while (i < n) {
        dst[i] = src[i];
        i = i + 1;
    }
    return 0;
}

fn copy_to_user(pml4 as i64, user_va as i64, src as *u8, n as i64) as i32 {
    if (user_range_ok(pml4, user_va, n, cast(i32, 1)) == 0) {
        return cast(i32, 0 - 1);
    }
    let is *u8 as dst = cast(*u8, user_va);
    let is i64 as i with mut = 0;
    while (i < n) {
        dst[i] = src[i];
        i = i + 1;
    }
    return 0;
}

// ----------------------------------------------------------------
// Smoke entry. Builds an aspace, maps text/data/stack, drops a
// ring-3 thread on top of it, polls the counter, declares pass/fail.
// ----------------------------------------------------------------
fn spawn_user_smoke() as void {
    serial.println("userspace.smoke: start", 22);

    let is *vma.Aspace as a = vma.aspace_create();
    if (cast(i64, a) == 0) {
        serial.println("userspace.smoke: aspace_create FAIL", 35);
        return;
    }

    // Text page: present, ring 3, executable (NX cleared).
    let is i64 as text_kv = mmap_user_fixed(a, USER_TEXT_VA, 1,
                                             vma.PROT_USER | vma.PROT_WRITE,
                                             cast(*u8, "text"), 4);
    if (text_kv == 0) { return; }
    write_smoke_shellcode(cast(*u8, text_kv));

    // Data page: writable, NX.
    let is i64 as data_kv = mmap_user_fixed(a, USER_DATA_VA, 1,
                                             vma.PROT_USER | vma.PROT_WRITE | vma.PROT_NX,
                                             cast(*u8, "data"), 4);
    if (data_kv == 0) { return; }
    let is *i64 as cnt = cast(*i64, data_kv);
    cnt[0] = 0;

    // Stack page: writable, NX.
    let is i64 as stack_kv = mmap_user_fixed(a, USER_STACK_VA, 1,
                                              vma.PROT_USER | vma.PROT_WRITE | vma.PROT_NX,
                                              cast(*u8, "stack"), 5);
    if (stack_kv == 0) { return; }
    let is i64 as user_rsp = USER_STACK_VA + pmm.PAGE_SIZE - 16;

    let is i64 as tid = sched.create_user_thread(
        cast(i64, fn_ptr(user_thread_trampoline)),
        sched.QOS_NORMAL,
        a.pml4_phys, USER_TEXT_VA, user_rsp, cast(i64, a)
    );

    serial.print("userspace.smoke: spawned tid=", 29);
    util.print_num(tid);
    serial.print(" pml4=", 6);
    util.print_hex(a.pml4_phys);
    serial.println("", 0);

    let is i64 as deadline = timer.current_time_ns() + 1000000000;
    let is i64 as last with mut = 0;
    while (timer.current_time_ns() < deadline) {
        let is i64 as cur = read_user_counter(a);
        if (cur > 0) {
            serial.print("userspace.smoke: counter=", 25);
            util.print_num(cur);
            serial.println(" PASS", 5);
            return;
        }
        last = cur;
        sched.sleep_for_ns(50000000);
    }
    serial.print("userspace.smoke: counter stalled at ", 36);
    util.print_num(last);
    serial.println(" FAIL", 5);
}

// Second smoke: a user thread whose first instruction is ud2 (the
// canonical "undefined opcode" trap). The kernel must observe a
// user-mode #UD, kill the thread, and keep running. If the kernel
// were still treating user faults as panics this whole test would
// halt the system instead.
fn spawn_user_fault_smoke() as void {
    serial.println("userspace.fault_smoke: start", 28);
    let is *vma.Aspace as a = vma.aspace_create();
    if (cast(i64, a) == 0) {
        serial.println("userspace.fault_smoke: aspace_create FAIL", 41);
        return;
    }
    let is i64 as text_kv = mmap_user_fixed(a, USER_TEXT_VA, 1,
                                             vma.PROT_USER | vma.PROT_WRITE,
                                             cast(*u8, "btext"), 5);
    if (text_kv == 0) { return; }
    let is *u8 as code = cast(*u8, text_kv);
    code[0] = cast(u8, 0x0F);                  // ud2 — invalid opcode
    code[1] = cast(u8, 0x0B);

    let is i64 as stack_kv = mmap_user_fixed(a, USER_STACK_VA, 1,
                                              vma.PROT_USER | vma.PROT_WRITE | vma.PROT_NX,
                                              cast(*u8, "bstack"), 6);
    if (stack_kv == 0) { return; }
    let is i64 as user_rsp = USER_STACK_VA + pmm.PAGE_SIZE - 16;

    let is i64 as tid = sched.create_user_thread(
        cast(i64, fn_ptr(user_thread_trampoline)),
        sched.QOS_NORMAL,
        a.pml4_phys, USER_TEXT_VA, user_rsp, cast(i64, a)
    );
    serial.print("userspace.fault_smoke: spawned tid=", 35);
    util.print_num(tid);
    serial.println("", 0);

    // Give the scheduler a couple of quanta to dispatch + reap.
    sched.sleep_for_ns(200000000);

    serial.println("userspace.fault_smoke: kernel still alive PASS", 46);
}

// (spawn_user_syscall_smoke retired — spawn_user_elf_smoke exercises
//  the same SYSCALL/SYSRETQ path through the real ABI now that
//  TIME_NOW_NS / IO_WRITE / PROC_EXIT are wired up.)

// ============================================================
// Embedded test ELF — static x86_64 ET_EXEC exercising ALL of the v0
// causticos ABI (flat numbered, see abi.cst). Every syscall is driven
// through the real ring3 -> SYSCALL -> dispatch -> SYSRETQ path.
//
//   .text (entry @ 0x400078):
//     movabs r10, 0x401000        ; r10 = BSS result base
//
//     mov rax, 1                  ; SYS_TIME_NOW_NS
//     syscall
//     mov [r10], rax              ; BSS+0  = timestamp
//
//     mov rax, 4                  ; SYS_PROC_GETPID
//     syscall
//     mov [r10+8], rax            ; BSS+8  = pid
//
//     mov rax, 0                  ; SYS_KERN_INFO(buf, size)
//     mov rdi, 0x401100           ; buf  (BSS+0x100)
//     mov rsi, 48                 ; size = KERN_INFO_SIZE
//     syscall
//
//     mov rax, 5                  ; SYS_PROC_YIELD
//     syscall
//
//     mov rax, 2                  ; SYS_TIME_SLEEP_NS
//     mov rdi, 1000000            ; 1 ms
//     syscall
//
//     mov rax, 6                  ; SYS_IO_WRITE_SERIAL
//     lea rdi, [rip + .str]       ; buf
//     mov rsi, 6                  ; len
//     syscall
//
//     mov rax, 3                  ; SYS_PROC_EXIT
//     mov rdi, 7                  ; exit code
//     syscall                     ; never returns
//   .str: db 'h','e','l','l','o','\n'
//
// Entry sits at 0x400078; PT_LOAD maps the file 1:1 from offset 0
// (so the ELF header lives in user-readable memory at 0x400000,
// harmless and standard). BSS layout (zero-filled past p_filesz):
//   BSS+0x000  i64  TIME_NOW_NS result
//   BSS+0x008  i64  GETPID result
//   BSS+0x100  48B  KERN_INFO struct (same page, read by the smoke)
// ============================================================

let is i64 as TEST_ELF_BSS_VA = 0x401000;
let is i64 as TEST_ELF_KINFO_VA = 0x401100;
let is i64 as TEST_ELF_LEN = 248;

let is [256]u8 as test_elf;

fn write_le_u64(p as *u8, off as i64, v as i64) as void {
    let is i64 as x with mut = v;
    let is i64 as i with mut = 0;
    while (i < 8) {
        p[off + i] = cast(u8, x & 0xFF);
        x = x >> 8;
        i = i + 1;
    }
}

fn build_test_elf() as void {
    let is *u8 as e = cast(*u8, &test_elf[0]);
    let is i64 as i with mut = 0;
    while (i < TEST_ELF_LEN) { e[i] = cast(u8, 0); i = i + 1; }

    // ELF magic + ident
    e[0] = cast(u8, 0x7F);
    e[1] = cast(u8, 0x45);     // 'E'
    e[2] = cast(u8, 0x4C);     // 'L'
    e[3] = cast(u8, 0x46);     // 'F'
    e[4] = cast(u8, 2);         // ELFCLASS64
    e[5] = cast(u8, 1);         // ELFDATA2LSB
    e[6] = cast(u8, 1);         // EV_CURRENT

    e[16] = cast(u8, 2);                            // e_type = ET_EXEC
    e[18] = cast(u8, 0x3E);                         // e_machine = EM_X86_64
    e[20] = cast(u8, 1);                            // e_version = 1
    write_le_u64(e, 24, 0x400078);                  // e_entry
    write_le_u64(e, 32, 64);                        // e_phoff
    e[52] = cast(u8, 0x40);                         // e_ehsize = 64
    e[54] = cast(u8, 0x38);                         // e_phentsize = 56
    e[56] = cast(u8, 1);                            // e_phnum = 1

    // PT_LOAD at offset 64
    let is i64 as ph with mut = 64;
    e[ph + 0] = cast(u8, 1);                        // p_type = PT_LOAD
    e[ph + 4] = cast(u8, 7);                        // p_flags = R|W|X (test image)
    write_le_u64(e, ph + 8, 0);                     // p_offset = 0
    write_le_u64(e, ph + 16, 0x400000);             // p_vaddr
    write_le_u64(e, ph + 24, 0x400000);             // p_paddr
    write_le_u64(e, ph + 32, TEST_ELF_LEN);         // p_filesz
    write_le_u64(e, ph + 40, 0x2000);               // p_memsz (text + 4 KiB BSS)
    write_le_u64(e, ph + 48, 0x1000);               // p_align

    // ============= Code starts at offset 0x78 =============
    let is i64 as c with mut = 0x78;

    // movabs r15, TEST_ELF_BSS_VA   — r15 holds the BSS result base for
    // the whole program. It MUST be a callee-saved register: a causticos
    // syscall only preserves rbx/rbp/r12..r15/rsp (and restores rcx/r11
    // = user rip/flags). Arg registers (rdi/rsi/rdx/r10/r8/r9) and rax
    // are clobbered, exactly like a C call. Using r10 here would be
    // trashed by the first syscall and the result store would fault.
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0xBF);
    write_le_u64(e, c + 2, TEST_ELF_BSS_VA);
    c = c + 10;

    // ----- SYS_TIME_NOW_NS (1) -----
    // mov rax, 1
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,1); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    // syscall
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05);
    c = c + 2;
    // mov [r15], rax            ; BSS+0
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x07);
    c = c + 3;

    // ----- SYS_PROC_GETPID (4) -----
    // mov rax, 4
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,4); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    // syscall
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05);
    c = c + 2;
    // mov [r15+8], rax          ; BSS+8
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x08);
    c = c + 4;

    // ----- SYS_KERN_INFO (0) — args (buf, size) -----
    // mov rax, 0
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,0); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    // mov rdi, TEST_ELF_KINFO_VA   (imm32, fits: 0x401100 < 2^31)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC7);
    e[c+3]=cast(u8, TEST_ELF_KINFO_VA & 0xFF);
    e[c+4]=cast(u8, (TEST_ELF_KINFO_VA >> 8) & 0xFF);
    e[c+5]=cast(u8, (TEST_ELF_KINFO_VA >> 16) & 0xFF);
    e[c+6]=cast(u8, (TEST_ELF_KINFO_VA >> 24) & 0xFF);
    c = c + 7;
    // mov rsi, KERN_INFO_SIZE (48)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC6);
    e[c+3]=cast(u8, abi.KERN_INFO_SIZE & 0xFF); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    // syscall
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05);
    c = c + 2;

    // ----- SYS_PROC_YIELD (5) -----
    // mov rax, 5
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,5); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    // syscall
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05);
    c = c + 2;

    // ----- SYS_TIME_SLEEP_NS (2) — arg (ns) -----
    // mov rax, 2
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,2); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    // mov rdi, 1000000   (1 ms)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC7);
    e[c+3]=cast(u8,0x40); e[c+4]=cast(u8,0x42); e[c+5]=cast(u8,0x0F); e[c+6]=cast(u8,0);
    c = c + 7;
    // syscall
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05);
    c = c + 2;

    // ----- SYS_IO_WRITE_SERIAL (6) — args (buf, len) -----
    // mov rax, 6
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,6); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    // lea rdi, [rip + disp32]   — disp patched after .str known
    let is i64 as lea_at = c;
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0x8D); e[c+2]=cast(u8,0x3D);   // 0x3D = lea rdi, [rip+...]
    c = c + 7;
    // mov rsi, 6
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC6);
    e[c+3]=cast(u8,6); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    // syscall
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05);
    c = c + 2;

    // ----- SYS_PROC_EXIT (3) — arg (code) -----
    // mov rax, 3
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,3); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    // mov rdi, 7
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC7);
    e[c+3]=cast(u8,7); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    // syscall
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05);
    c = c + 2;

    // ----- .str -----
    let is i64 as str_at = c;
    e[c+0]=cast(u8,104);   // 'h'
    e[c+1]=cast(u8,101);   // 'e'
    e[c+2]=cast(u8,108);   // 'l'
    e[c+3]=cast(u8,108);   // 'l'
    e[c+4]=cast(u8,111);   // 'o'
    e[c+5]=cast(u8,10);    // '\n'
    c = c + 6;

    // Patch the lea disp32. The instruction is 7 bytes, so the
    // RIP value used in [rip+disp32] is lea_at + 7. The disp is
    // signed; .str is downstream of the lea, so positive.
    let is i64 as disp = str_at - (lea_at + 7);
    e[lea_at + 3] = cast(u8, disp & 0xFF);
    e[lea_at + 4] = cast(u8, (disp >> 8)  & 0xFF);
    e[lea_at + 5] = cast(u8, (disp >> 16) & 0xFF);
    e[lea_at + 6] = cast(u8, (disp >> 24) & 0xFF);

    // Sanity: c must equal TEST_ELF_LEN now (the loader copies
    // p_filesz = TEST_ELF_LEN bytes). If they drift, the tail of the
    // program or .str gets truncated. Logged, not fatal.
    if (c != TEST_ELF_LEN) {
        serial.print("userspace.elf_smoke: WARN built len=", 37);
        util.print_num(c);
        serial.print(" != TEST_ELF_LEN=", 17);
        util.print_num(TEST_ELF_LEN);
        serial.println("", 0);
    }
}

fn spawn_user_elf_smoke() as void {
    serial.println("userspace.elf_smoke: start", 26);

    build_test_elf();

    let is *vma.Aspace as a = vma.aspace_create();
    if (cast(i64, a) == 0) {
        serial.println("userspace.elf_smoke: aspace FAIL", 32);
        return;
    }

    let is i64 as entry with mut = 0;
    let is i64 as user_rsp with mut = 0;
    let is i32 as rc = elf.load_elf(a, cast(*u8, &test_elf[0]), TEST_ELF_LEN,
                                     cast(*u8, "test"), 4,
                                     &entry, &user_rsp);
    if (rc != 0) {
        serial.print("userspace.elf_smoke: load_elf rc=", 33);
        util.print_num(cast(i64, rc));
        serial.println(" FAIL", 5);
        return;
    }

    serial.print("userspace.elf_smoke: entry=", 27);
    util.print_hex(entry);
    serial.print(" rsp=", 5);
    util.print_hex(user_rsp);
    serial.println("", 0);

    let is i64 as tid = sched.create_user_thread(
        cast(i64, fn_ptr(user_thread_trampoline)),
        sched.QOS_NORMAL,
        a.pml4_phys, entry, user_rsp, cast(i64, a)
    );
    serial.print("userspace.elf_smoke: spawned tid=", 33);
    util.print_num(tid);
    serial.println("", 0);

    // Poll the BSS. The program writes its TIME_NOW_NS result at BSS+0
    // and its GETPID at BSS+8; KERN_INFO fills a 48-byte struct at
    // BSS+0x100 (same page). PROC_EXIT is the LAST syscall, so once the
    // thread is THREAD_DEAD every prior store is committed — that's when
    // we read getpid + kern_info. exit_ok also transitively proves YIELD
    // and SLEEP returned (control flowed past them to EXIT).
    //
    // KERN_INFO struct is read as i64 slots off the page base:
    //   p[32]=info_size p[33]=abi_major p[34]=abi_minor
    //   p[35]=syscalls_max p[36]=page_size p[37]=flags
    let is i64 as deadline = timer.current_time_ns() + 1500000000;
    let is i32 as time_ok with mut = 0;
    let is i32 as exit_ok with mut = 0;
    let is i32 as getpid_ok with mut = 0;
    let is i32 as kinfo_ok with mut = 0;
    while (timer.current_time_ns() < deadline) {
        let is i64 as phys = vmm.virt_to_phys_walk(a.pml4_phys, TEST_ELF_BSS_VA);
        if (phys != 0) {
            let is *i64 as p = cast(*i64, pmm.phys_to_virt(phys));
            if (time_ok == 0 && p[0] != 0) {
                serial.print("userspace.elf_smoke: time_now=", 30);
                util.print_num(p[0]);
                serial.println("", 0);
                time_ok = 1;
            }
            if (exit_ok == 0 && sched.thr_gone(tid) == cast(i32, 1)) {
                exit_ok = 1;
                // pid stored at BSS+8 must match the tid we spawned.
                if (p[1] == tid) { getpid_ok = 1; }
                serial.print("userspace.elf_smoke: getpid=", 28);
                util.print_num(p[1]);
                serial.print(" (tid=", 6);
                util.print_num(tid);
                serial.println(")", 1);
                // kern_info struct fields must be the static values.
                if (p[32] == abi.KERN_INFO_SIZE && p[33] == abi.ABI_MAJOR
                    && p[34] == abi.ABI_MINOR && p[35] == abi.SYS_COUNT
                    && p[36] == 4096 && p[37] == 0) {
                    kinfo_ok = 1;
                }
                serial.print("userspace.elf_smoke: kinfo size=", 32);
                util.print_num(p[32]);
                serial.print(" major=", 7);
                util.print_num(p[33]);
                serial.print(" minor=", 7);
                util.print_num(p[34]);
                serial.print(" syscalls_max=", 14);
                util.print_num(p[35]);
                serial.print(" page=", 6);
                util.print_num(p[36]);
                serial.println("", 0);
            }
        }
        if (time_ok == 1 && exit_ok == 1 && getpid_ok == 1 && kinfo_ok == 1) {
            serial.println("userspace.elf_smoke: PASS", 25);
            return;
        }
        sched.sleep_for_ns(20000000);
    }
    serial.print("userspace.elf_smoke: time_ok=", 29);
    util.print_num(cast(i64, time_ok));
    serial.print(" exit_ok=", 9);
    util.print_num(cast(i64, exit_ok));
    serial.print(" getpid_ok=", 11);
    util.print_num(cast(i64, getpid_ok));
    serial.print(" kinfo_ok=", 10);
    util.print_num(cast(i64, kinfo_ok));
    serial.println(" FAIL", 5);
}

// ============================================================
// Embedded test CSE v2 — causticos-native executable format (see
// cse.cst / docs/CSE_FORMAT.md). Same 7-syscall program as the test ELF, in
// the v2 CST_ container: 32B header + segment table + segment bytes.
// Two segments: .text (R-X) @0x401000 and a R-W bss page @0x402000 for
// the syscall results. Proves the v2 loader end-to-end against the real
// causticos ABI, deterministically (the synthetic image never changes).
//
// The BSS base is held in r15 (callee-saved; arg regs are clobbered by
// syscalls). Memory refs are r15-relative.
//   bss+0x000  TIME_NOW_NS result    bss+0x008  GETPID result
//   bss+0x010  SYS_MMAP returned VA  bss+0x018  sentinel read back
//   bss+0x020  SYS_MUNMAP result     bss+0x028  SYS_OPEN fd
//   bss+0x030  SYS_READ bytes        bss+0x038  SYS_CLOSE result
//   bss+0x040  wtest fd              bss+0x048  SYS_WRITE bytes
//   bss+0x050  SYS_LSEEK offset      bss+0x058  wtest re-read bytes
//   bss+0x060  wtest close result
//   bss+0x100  KERN_INFO struct (48B) bss+0x200  /hello.txt read buffer
//   bss+0x240  wtest re-read buffer (7B)
// ============================================================

let is i64 as CSE_TEST_ENTRY  = 0x401000;     // seg0 (.text) vaddr
let is i64 as CSE_TEST_BSS_VA = 0x402000;     // seg1 (R-W) vaddr
let is i64 as CSE_TEXT_FOFF   = 0x50;         // header(0x20) + 2 segs(2*0x18)
let is i64 as test_cse_len with mut = 0;      // total image size, set by build

let is [768]u8 as test_cse;

fn write_le_u32(p as *u8, off as i64, v as i64) as void {
    p[off + 0] = cast(u8, v & 0xFF);
    p[off + 1] = cast(u8, (v >> 8)  & 0xFF);
    p[off + 2] = cast(u8, (v >> 16) & 0xFF);
    p[off + 3] = cast(u8, (v >> 24) & 0xFF);
}

fn build_test_cse() as void {
    let is *u8 as e = cast(*u8, &test_cse[0]);
    let is i64 as z with mut = 0;
    while (z < 768) { e[z] = cast(u8, 0); z = z + 1; }

    // ---- header (32 bytes) ----
    e[0]=cast(u8,0x43); e[1]=cast(u8,0x53); e[2]=cast(u8,0x54); e[3]=cast(u8,0x5F); // "CST_"
    e[4]=cast(u8,2); e[5]=cast(u8,0);                  // version u16 = 2
    e[6]=cast(u8,1);                                   // arch = 1 (x86_64)
    e[7]=cast(u8,0);                                   // flags
    write_le_u64(e, 0x08, CSE_TEST_ENTRY);             // entry_point
    write_le_u64(e, 0x10, 0x400000);                   // base_addr (informative)
    write_le_u32(e, 0x18, 2);                          // seg_count
    write_le_u32(e, 0x1C, 0);                          // app_version_off (none)

    // ---- seg0 @0x20: .text, R-X (perms=5) ----
    write_le_u64(e, 0x20, CSE_TEST_ENTRY);             // vaddr
    write_le_u32(e, 0x28, CSE_TEXT_FOFF);              // file_off
    // file_size/mem_size @0x2C/0x30 patched once .text length is known
    write_le_u32(e, 0x34, 5);                          // perms = R|X

    // ---- seg1 @0x38: R-W bss page (perms=3) ----
    write_le_u64(e, 0x38, CSE_TEST_BSS_VA);            // vaddr
    write_le_u32(e, 0x40, 0);                          // file_off (pure bss)
    write_le_u32(e, 0x44, 0);                          // file_size
    write_le_u32(e, 0x48, 0x1000);                     // mem_size (one page)
    write_le_u32(e, 0x4C, 3);                          // perms = R|W

    // ---- .text at file offset CSE_TEXT_FOFF ----
    let is i64 as c with mut = CSE_TEXT_FOFF;

    // movabs r15, CSE_TEST_BSS_VA   (seg1 vaddr; fixed, no patch needed)
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0xBF);
    write_le_u64(e, c + 2, CSE_TEST_BSS_VA);
    c = c + 10;

    // --- SYS_MMAP(0, 0x1000, R|W) → write+read a sentinel → SYS_MUNMAP.
    //     Exercises the camada-0 memory syscalls end-to-end in ring 3. ---
    //   mov rax,7  (SYS_MMAP)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,7); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    //   xor edi,edi   (hint = 0 → kernel picks the VA)
    e[c+0]=cast(u8,0x31); e[c+1]=cast(u8,0xFF); c = c + 2;
    //   mov rsi,0x1000   (len = one page)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC6);
    e[c+3]=cast(u8,0x00); e[c+4]=cast(u8,0x10); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    //   mov rdx,3   (prot = R|W)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC2);
    e[c+3]=cast(u8,3); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    //   syscall
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;
    //   mov [r15+0x10],rax   (save returned VA)
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x10);
    c = c + 4;
    //   mov dword [rax],0xCAFEBABE   (write sentinel into the new page)
    e[c+0]=cast(u8,0xC7); e[c+1]=cast(u8,0x00);
    e[c+2]=cast(u8,0xBE); e[c+3]=cast(u8,0xBA); e[c+4]=cast(u8,0xFE); e[c+5]=cast(u8,0xCA);
    c = c + 6;
    //   mov ecx,[rax]   (read it back, zero-extended into rcx)
    e[c+0]=cast(u8,0x8B); e[c+1]=cast(u8,0x08); c = c + 2;
    //   mov [r15+0x18],rcx
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x4F); e[c+3]=cast(u8,0x18);
    c = c + 4;
    //   mov rax,8  (SYS_MUNMAP)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,8); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    //   mov rdi,[r15+0x10]   (the saved VA)
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x8B); e[c+2]=cast(u8,0x7F); e[c+3]=cast(u8,0x10);
    c = c + 4;
    //   mov rsi,0x1000
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC6);
    e[c+3]=cast(u8,0x00); e[c+4]=cast(u8,0x10); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    //   syscall
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;
    //   mov [r15+0x20],rax   (munmap result; 0 = ok)
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x20);
    c = c + 4;

    // --- SYS_OPEN("/hello.txt", O_RDONLY) → SYS_READ → SYS_CLOSE.
    //     Reads the FAT32 fixture through the int-fd file syscalls. The
    //     path is embedded inline (jmp over it) so its user VA is known. ---
    //   jmp +10  (skip the path bytes)
    e[c+0]=cast(u8,0xEB); e[c+1]=cast(u8,10); c = c + 2;
    let is i64 as path_foff = c;
    //   "/hello.txt"
    e[c+0]=cast(u8,47);  e[c+1]=cast(u8,104); e[c+2]=cast(u8,101); e[c+3]=cast(u8,108);
    e[c+4]=cast(u8,108); e[c+5]=cast(u8,111); e[c+6]=cast(u8,46);  e[c+7]=cast(u8,116);
    e[c+8]=cast(u8,120); e[c+9]=cast(u8,116);
    c = c + 10;
    let is i64 as path_va = CSE_TEST_ENTRY + (path_foff - CSE_TEXT_FOFF);

    //   mov rax,9  (SYS_OPEN)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,9); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    //   movabs rdi, path_va
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xBF); write_le_u64(e, c + 2, path_va); c = c + 10;
    //   mov rsi,10  (path_len)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC6);
    e[c+3]=cast(u8,10); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    //   xor edx,edx  (O_RDONLY)
    e[c+0]=cast(u8,0x31); e[c+1]=cast(u8,0xD2); c = c + 2;
    //   syscall
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;
    //   mov [r15+0x28],rax  (fd)
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x28);
    c = c + 4;

    //   mov rax,10  (SYS_READ)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,10); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    //   mov rdi,[r15+0x28]  (fd)
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x8B); e[c+2]=cast(u8,0x7F); e[c+3]=cast(u8,0x28);
    c = c + 4;
    //   movabs rsi, bss+0x200  (read buffer)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xBE);
    write_le_u64(e, c + 2, CSE_TEST_BSS_VA + 0x200); c = c + 10;
    //   mov rdx,64  (count)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC2);
    e[c+3]=cast(u8,64); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    //   syscall
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;
    //   mov [r15+0x30],rax  (bytes read)
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x30);
    c = c + 4;

    //   mov rax,12  (SYS_CLOSE)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,12); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    //   mov rdi,[r15+0x28]  (fd)
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x8B); e[c+2]=cast(u8,0x7F); e[c+3]=cast(u8,0x28);
    c = c + 4;
    //   syscall
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;
    //   mov [r15+0x38],rax  (close result)
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x38);
    c = c + 4;

    // --- write/lseek round-trip: open(O_CREAT|O_RDWR|O_TRUNC) a new file,
    //     write "CAUSTIC", lseek back to 0, read it, close. Exercises
    //     SYS_WRITE + SYS_LSEEK (and O_CREAT) through the ring-3 path. ---
    //   jmp +17  (skip the two inline strings)
    e[c+0]=cast(u8,0xEB); e[c+1]=cast(u8,17); c = c + 2;
    let is i64 as wpath_foff = c;
    //   "/wtest.txt"  (10)
    e[c+0]=cast(u8,47);  e[c+1]=cast(u8,119); e[c+2]=cast(u8,116); e[c+3]=cast(u8,101);
    e[c+4]=cast(u8,115); e[c+5]=cast(u8,116); e[c+6]=cast(u8,46);  e[c+7]=cast(u8,116);
    e[c+8]=cast(u8,120); e[c+9]=cast(u8,116);
    c = c + 10;
    let is i64 as wdata_foff = c;
    //   "CAUSTIC"  (7)
    e[c+0]=cast(u8,67); e[c+1]=cast(u8,65); e[c+2]=cast(u8,85); e[c+3]=cast(u8,83);
    e[c+4]=cast(u8,84); e[c+5]=cast(u8,73); e[c+6]=cast(u8,67);
    c = c + 7;
    let is i64 as wpath_va = CSE_TEST_ENTRY + (wpath_foff - CSE_TEXT_FOFF);
    let is i64 as wdata_va = CSE_TEST_ENTRY + (wdata_foff - CSE_TEXT_FOFF);

    //   mov rax,9  (SYS_OPEN), movabs rdi,wpath_va, mov rsi,10, mov rdx,0x242
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,9); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xBF); write_le_u64(e, c + 2, wpath_va); c = c + 10;
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC6);
    e[c+3]=cast(u8,10); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    //   O_CREAT|O_RDWR|O_TRUNC = 0x242
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC2);
    e[c+3]=cast(u8,0x42); e[c+4]=cast(u8,0x02); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;
    //   mov [r15+0x40],rax  (wfd)
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x40);
    c = c + 4;

    //   mov rax,11  (SYS_WRITE), rdi=wfd, movabs rsi,wdata_va, rdx=7
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,11); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x8B); e[c+2]=cast(u8,0x7F); e[c+3]=cast(u8,0x40);
    c = c + 4;
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xBE); write_le_u64(e, c + 2, wdata_va); c = c + 10;
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC2);
    e[c+3]=cast(u8,7); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;
    //   mov [r15+0x48],rax  (bytes written)
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x48);
    c = c + 4;

    //   mov rax,13  (SYS_LSEEK), rdi=wfd, xor esi,esi (off 0), xor edx,edx (SEEK_SET)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,13); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x8B); e[c+2]=cast(u8,0x7F); e[c+3]=cast(u8,0x40);
    c = c + 4;
    e[c+0]=cast(u8,0x31); e[c+1]=cast(u8,0xF6); c = c + 2;
    e[c+0]=cast(u8,0x31); e[c+1]=cast(u8,0xD2); c = c + 2;
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;
    //   mov [r15+0x50],rax  (new offset; 0)
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x50);
    c = c + 4;

    //   mov rax,10  (SYS_READ), rdi=wfd, movabs rsi,bss+0x240, rdx=7
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,10); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x8B); e[c+2]=cast(u8,0x7F); e[c+3]=cast(u8,0x40);
    c = c + 4;
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xBE);
    write_le_u64(e, c + 2, CSE_TEST_BSS_VA + 0x240); c = c + 10;
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC2);
    e[c+3]=cast(u8,7); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;
    //   mov [r15+0x58],rax  (bytes read back)
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x58);
    c = c + 4;

    //   mov rax,12  (SYS_CLOSE), rdi=wfd
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,12); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x8B); e[c+2]=cast(u8,0x7F); e[c+3]=cast(u8,0x40);
    c = c + 4;
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;
    //   mov [r15+0x60],rax  (close result)
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x60);
    c = c + 4;

    // SYS_TIME_NOW_NS (1) — REGRESSION GUARD: driven through a call/ret
    // so the test exercises the user stack surviving a syscall. This is
    // the exact path the naked syscall-entry fix protects (a register-
    // only test would not catch a regression). If the entry ever shifts
    // the user rsp again, the `ret` in the subroutine faults and
    // cse_smoke reports time_ok=0 / FAIL.
    //   jmp .past   (skip the 13-byte subroutine)
    e[c+0]=cast(u8,0xEB); e[c+1]=cast(u8,13); c = c + 2;
    let is i64 as time_sub = c;            // .time_sub:
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);   // mov rax,1
    e[c+3]=cast(u8,1); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;              // syscall
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x07); c = c + 3;  // mov [r15],rax
    e[c+0]=cast(u8,0xC3); c = c + 1;                                    // ret
    // .past:  call .time_sub
    let is i64 as call_at = c;
    let is i64 as crel = time_sub - (call_at + 5);
    e[c+0]=cast(u8,0xE8);
    e[c+1]=cast(u8, crel & 0xFF);
    e[c+2]=cast(u8, (crel >> 8)  & 0xFF);
    e[c+3]=cast(u8, (crel >> 16) & 0xFF);
    e[c+4]=cast(u8, (crel >> 24) & 0xFF);
    c = c + 5;

    // SYS_PROC_GETPID (4): mov rax,4; syscall; mov [r15+8], rax
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,4); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x08); c = c + 4;

    // SYS_KERN_INFO (0): mov rax,0; lea rdi,[r15+0x100]; mov rsi,48; syscall
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,0); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    // lea rdi, [r15 + 0x100]   = 49 8D BF 00 01 00 00
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x8D); e[c+2]=cast(u8,0xBF);
    e[c+3]=cast(u8,0x00); e[c+4]=cast(u8,0x01); e[c+5]=cast(u8,0x00); e[c+6]=cast(u8,0x00);
    c = c + 7;
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC6);
    e[c+3]=cast(u8, abi.KERN_INFO_SIZE & 0xFF); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;

    // SYS_PROC_YIELD (5): mov rax,5; syscall
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,5); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;

    // SYS_TIME_SLEEP_NS (2): mov rax,2; mov rdi,1000000; syscall
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,2); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC7);
    e[c+3]=cast(u8,0x40); e[c+4]=cast(u8,0x42); e[c+5]=cast(u8,0x0F); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;

    // SYS_IO_WRITE_SERIAL (6): mov rax,6; lea rdi,[rip+.str]; mov rsi,6; syscall
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,6); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    let is i64 as lea_at = c;
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0x8D); e[c+2]=cast(u8,0x3D);
    c = c + 7;
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC6);
    e[c+3]=cast(u8,6); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;

    // SYS_PROC_EXIT (3): mov rax,3; mov rdi,7; syscall
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,3); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC7);
    e[c+3]=cast(u8,7); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;

    // .str
    let is i64 as str_at = c;
    e[c+0]=cast(u8,104); e[c+1]=cast(u8,101); e[c+2]=cast(u8,108);
    e[c+3]=cast(u8,108); e[c+4]=cast(u8,111); e[c+5]=cast(u8,10);
    c = c + 6;

    // Patch the lea disp32 (rip-relative; same math as the ELF builder —
    // disp is in vaddr space but reduces to a file-offset difference).
    let is i64 as disp = str_at - (lea_at + 7);
    e[lea_at + 3] = cast(u8, disp & 0xFF);
    e[lea_at + 4] = cast(u8, (disp >> 8)  & 0xFF);
    e[lea_at + 5] = cast(u8, (disp >> 16) & 0xFF);
    e[lea_at + 6] = cast(u8, (disp >> 24) & 0xFF);

    // Finalize: .text length goes into seg0's file_size + mem_size, and
    // the total image size is where the bytes ended.
    let is i64 as text_size = c - CSE_TEXT_FOFF;
    write_le_u32(e, 0x2C, text_size);     // seg0 file_size
    write_le_u32(e, 0x30, text_size);     // seg0 mem_size
    test_cse_len = c;
}

// ============================================================
// Embedded fb test CSE — proves the surface path end to end from ring 3:
// dev_open(DEV_FB) → mmap(fd) → draw cyan → present, all via syscalls. The
// kernel verifies by reading the scanout (no BSS read-back). r15 = BSS base
// holds fd / mmap VA / present rc.
//   bss+0x000 dev_open fd   bss+0x008 mmap VA   bss+0x010 present rc
// ============================================================

let is i64 as CSE_FB_ENTRY  = 0x401000;
let is i64 as CSE_FB_BSS_VA = 0x402000;
let is i64 as CSE_FB_FOFF   = 0x50;
let is i64 as fb_cse_len with mut = 0;
let is [512]u8 as fb_cse;

fn build_fb_cse() as void {
    let is *u8 as e = cast(*u8, &fb_cse[0]);
    let is i64 as z with mut = 0;
    while (z < 512) { e[z] = cast(u8, 0); z = z + 1; }

    // ---- header (32 bytes) ----
    e[0]=cast(u8,0x43); e[1]=cast(u8,0x53); e[2]=cast(u8,0x54); e[3]=cast(u8,0x5F); // "CST_"
    e[4]=cast(u8,2); e[5]=cast(u8,0);                  // version u16 = 2
    e[6]=cast(u8,1);                                   // arch = 1 (x86_64)
    e[7]=cast(u8,0);                                   // flags
    write_le_u64(e, 0x08, CSE_FB_ENTRY);               // entry
    write_le_u64(e, 0x10, 0x400000);                   // base (informative)
    write_le_u32(e, 0x18, 2);                          // seg_count
    write_le_u32(e, 0x1C, 0);

    // ---- seg0 @0x20: .text R-X (perms=5) ----
    write_le_u64(e, 0x20, CSE_FB_ENTRY);               // vaddr
    write_le_u32(e, 0x28, CSE_FB_FOFF);                // file_off
    write_le_u32(e, 0x34, 5);                          // perms R|X
    // ---- seg1 @0x38: R-W bss page (perms=3) ----
    write_le_u64(e, 0x38, CSE_FB_BSS_VA);
    write_le_u32(e, 0x40, 0);
    write_le_u32(e, 0x44, 0);
    write_le_u32(e, 0x48, 0x1000);
    write_le_u32(e, 0x4C, 3);

    let is i64 as c with mut = CSE_FB_FOFF;

    // movabs r15, CSE_FB_BSS_VA  (callee-saved scratch for the results)
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0xBF);
    write_le_u64(e, c + 2, CSE_FB_BSS_VA);
    c = c + 10;

    // --- dev_open(DEV_FB=0, 0, 0) → fd ---
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);   // mov rax,22
    e[c+3]=cast(u8,22); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x31); e[c+1]=cast(u8,0xFF); c = c + 2;              // xor edi,edi
    e[c+0]=cast(u8,0x31); e[c+1]=cast(u8,0xF6); c = c + 2;              // xor esi,esi
    e[c+0]=cast(u8,0x31); e[c+1]=cast(u8,0xD2); c = c + 2;              // xor edx,edx
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;              // syscall
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x00); // mov [r15+0],rax
    c = c + 4;

    // --- mmap(0, 0x1000, WRITE|MMAP_FD, fd) → VA ---
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);   // mov rax,7
    e[c+3]=cast(u8,7); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x31); e[c+1]=cast(u8,0xFF); c = c + 2;              // xor edi,edi (hint=0)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC6);   // mov rsi,0x1000
    e[c+3]=cast(u8,0x00); e[c+4]=cast(u8,0x10); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC2);   // mov rdx,0x12 (WRITE|MMAP_FD)
    e[c+3]=cast(u8,0x12); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x4D); e[c+1]=cast(u8,0x8B); e[c+2]=cast(u8,0x57); e[c+3]=cast(u8,0x00); // mov r10,[r15+0] (fd)
    c = c + 4;
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;              // syscall
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x08); // mov [r15+8],rax (VA)
    c = c + 4;

    // --- fill 256 px with cyan 0x0000FFFF (rax still = VA) ---
    e[c+0]=cast(u8,0xB9); e[c+1]=cast(u8,0x00); e[c+2]=cast(u8,0x01);   // mov ecx,256
    e[c+3]=cast(u8,0x00); e[c+4]=cast(u8,0x00); c = c + 5;
    e[c+0]=cast(u8,0xBA); e[c+1]=cast(u8,0xFF); e[c+2]=cast(u8,0xFF);   // mov edx,0x0000FFFF
    e[c+3]=cast(u8,0x00); e[c+4]=cast(u8,0x00); c = c + 5;
    // loop: mov [rax],edx ; add rax,4 ; dec ecx ; jnz loop
    e[c+0]=cast(u8,0x89); e[c+1]=cast(u8,0x10); c = c + 2;
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0x83); e[c+2]=cast(u8,0xC0); e[c+3]=cast(u8,0x04); c = c + 4;
    e[c+0]=cast(u8,0xFF); e[c+1]=cast(u8,0xC9); c = c + 2;
    e[c+0]=cast(u8,0x75); e[c+1]=cast(u8,0xF6); c = c + 2;              // jnz -10

    // --- present(fd, 0, 0, 256, 1) ---
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);   // mov rax,23
    e[c+3]=cast(u8,23); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x8B); e[c+2]=cast(u8,0x7F); e[c+3]=cast(u8,0x00); // mov rdi,[r15+0] (fd)
    c = c + 4;
    e[c+0]=cast(u8,0x31); e[c+1]=cast(u8,0xF6); c = c + 2;              // xor esi,esi (x=0)
    e[c+0]=cast(u8,0x31); e[c+1]=cast(u8,0xD2); c = c + 2;              // xor edx,edx (y=0)
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC2);   // mov r10,256 (w)
    e[c+3]=cast(u8,0x00); e[c+4]=cast(u8,0x01); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);   // mov r8,1 (h)
    e[c+3]=cast(u8,0x01); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;              // syscall
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0x47); e[c+3]=cast(u8,0x10); // mov [r15+16],rax
    c = c + 4;

    // --- exit(0) ---
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);   // mov rax,3
    e[c+3]=cast(u8,3); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    e[c+0]=cast(u8,0x31); e[c+1]=cast(u8,0xFF); c = c + 2;              // xor edi,edi
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;              // syscall

    let is i64 as text_size = c - CSE_FB_FOFF;
    write_le_u32(e, 0x2C, text_size);     // seg0 file_size
    write_le_u32(e, 0x30, text_size);     // seg0 mem_size
    fb_cse_len = c;
}

// Spawn the fb test program and confirm its cyan reached the scanout —
// the full ring-3 → surface → screen path.
fn spawn_user_fb_smoke() as void {
    serial.println("userspace.fb_smoke: start", 25);
    build_fb_cse();

    let is *vma.Aspace as a = vma.aspace_create();
    if (cast(i64, a) == 0) {
        serial.println("userspace.fb_smoke: aspace FAIL", 31);
        return;
    }
    let is i64 as entry with mut = 0;
    let is i64 as user_rsp with mut = 0;
    let is i32 as rc = cse.load_cse(a, cast(*u8, &fb_cse[0]), fb_cse_len,
                                     cast(*u8, "fb"), 2, &entry, &user_rsp);
    if (rc != 0) {
        serial.print("userspace.fb_smoke: load_cse rc=", 32);
        util.print_num(cast(i64, rc));
        serial.println(" FAIL", 5);
        return;
    }

    // Clear row 0 (cols 0..255) on the scanout so we detect the app's write,
    // not the boot surface_smoke's leftover magenta.
    let is i64 as sv = fb.scanout_virt();
    let is i64 as bpb = fb.bpp_bytes();
    let is i64 as i with mut = 0;
    while (i < 256) {
        let is *i32 as p = cast(*i32, sv + i * bpb);
        p[0] = cast(i32, 0);
        i = i + 1;
    }

    let is i64 as tid = sched.create_user_thread(
        cast(i64, fn_ptr(user_thread_trampoline)),
        sched.QOS_NORMAL,
        a.pml4_phys, entry, user_rsp, cast(i64, a)
    );
    serial.print("userspace.fb_smoke: spawned tid=", 32);
    util.print_num(tid);
    serial.println("", 0);

    // Poll the scanout until the app's cyan lands (or time out).
    let is i64 as deadline = timer.current_time_ns() + 1500000000;
    let is i32 as ok with mut = 0;
    let is i32 as timedout with mut = 0;
    while (ok == 0 && timedout == 0) {
        let is *i32 as q0 = cast(*i32, sv);
        let is *i32 as q1 = cast(*i32, sv + 128 * bpb);
        if ((cast(i64, q0[0]) & 0xFFFFFF) == 0x0000FFFF) {
            if ((cast(i64, q1[0]) & 0xFFFFFF) == 0x0000FFFF) { ok = 1; }
        }
        if (ok == 0) {
            if (timer.current_time_ns() >= deadline) { timedout = 1; }
            else { sched.sleep_for_ns(20000000); }
        }
    }
    if (ok == 1) {
        serial.println("userspace.fb_smoke: PASS", 24);
    } else {
        serial.println("userspace.fb_smoke: no cyan on scanout FAIL", 43);
    }
}

// ============================================================
// Embedded "channel child" CSE — proves the IPC handoff from ring 3:
// read(fd 0, &b, 1) then exit(b). fd 0 is a channel endpoint handed to it
// at spawn (the fdacts mechanism). The kernel writes a byte on the other
// end; the child echoes it as its exit code.
// ============================================================

let is i64 as CSE_CC_ENTRY  = 0x401000;
let is i64 as CSE_CC_BSS_VA = 0x402000;
let is i64 as CSE_CC_FOFF   = 0x50;
let is i64 as child_cc_len with mut = 0;
let is [256]u8 as child_cc;

fn build_child_chan_cse() as void {
    let is *u8 as e = cast(*u8, &child_cc[0]);
    let is i64 as z with mut = 0;
    while (z < 256) { e[z] = cast(u8, 0); z = z + 1; }

    e[0]=cast(u8,0x43); e[1]=cast(u8,0x53); e[2]=cast(u8,0x54); e[3]=cast(u8,0x5F); // "CST_"
    e[4]=cast(u8,2); e[5]=cast(u8,0); e[6]=cast(u8,1); e[7]=cast(u8,0);
    write_le_u64(e, 0x08, CSE_CC_ENTRY);
    write_le_u64(e, 0x10, 0x400000);
    write_le_u32(e, 0x18, 2);
    write_le_u32(e, 0x1C, 0);
    write_le_u64(e, 0x20, CSE_CC_ENTRY);
    write_le_u32(e, 0x28, CSE_CC_FOFF);
    write_le_u32(e, 0x34, 5);
    write_le_u64(e, 0x38, CSE_CC_BSS_VA);
    write_le_u32(e, 0x40, 0);
    write_le_u32(e, 0x44, 0);
    write_le_u32(e, 0x48, 0x1000);
    write_le_u32(e, 0x4C, 3);

    let is i64 as c with mut = CSE_CC_FOFF;
    // movabs r15, BSS
    e[c+0]=cast(u8,0x49); e[c+1]=cast(u8,0xBF); write_le_u64(e, c+2, CSE_CC_BSS_VA); c = c + 10;
    // read(0, r15, 1): mov rax,10; xor edi,edi; mov rsi,r15; mov rdx,1; syscall
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,10); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;
    e[c+0]=cast(u8,0x31); e[c+1]=cast(u8,0xFF); c = c + 2;                        // xor edi,edi
    e[c+0]=cast(u8,0x4C); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0xFE); c = c + 3;  // mov rsi,r15
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC2);
    e[c+3]=cast(u8,1); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;                        // syscall
    // movzx edi, byte [r15]
    e[c+0]=cast(u8,0x41); e[c+1]=cast(u8,0x0F); e[c+2]=cast(u8,0xB6); e[c+3]=cast(u8,0x3F); c = c + 4;
    // exit(edi): mov rax,3; syscall
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,3); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;                        // syscall

    let is i64 as text_size = c - CSE_CC_FOFF;
    write_le_u32(e, 0x2C, text_size);
    write_le_u32(e, 0x30, text_size);
    child_cc_len = c;
}

// Proves channel + handoff + ring-3 channel read end to end: mint a pair,
// spawn the child with endpoint B as its fd 0 (the fdacts mechanism — same
// ko_ref + fd_install the SYS_SPAWN handler does), write a byte on endpoint
// A, and confirm the child exits with that byte.
fn spawn_channel_smoke() as void {
    serial.println("userspace.chan_smoke: start", 27);
    build_child_chan_cse();

    let is i64 as ko_a with mut = 0;
    let is i64 as ko_b with mut = 0;
    if (channel.channel_create(&ko_a, &ko_b) != 0) {
        serial.println("userspace.chan_smoke: create FAIL", 33);
        return;
    }

    let is i64 as child = proc_spawn(proc.init_proc, cast(*u8, &child_cc[0]), child_cc_len);
    if (child == 0) {
        kobject.ko_unref(ko_a); kobject.ko_unref(ko_b);
        serial.println("userspace.chan_smoke: spawn FAIL", 32);
        return;
    }

    // Handoff: install endpoint B as the child's fd 0.
    let is i64 as child_asp = proc.proc_aspace(child);
    kobject.ko_ref(ko_b);
    vma.fd_install(cast(*vma.Aspace, child_asp), 0, ko_b);
    proc_start(child);

    // Write the sentinel on endpoint A; the child's blocking read wakes.
    let is *kobject.KObject as ka = cast(*kobject.KObject, ko_a);
    let is [1]u8 as msg;
    msg[0] = cast(u8, 7);
    channel.chan_write(ka.priv, cast(i64, &msg[0]), 1);

    let is i64 as code = proc_wait(proc.init_proc, proc.proc_pid(child));

    kobject.ko_unref(ko_a);     // my endpoint A
    kobject.ko_unref(ko_b);     // my original ref to endpoint B (child's was freed at teardown)

    if (code == 7) {
        serial.println("userspace.chan_smoke: PASS", 26);
    } else {
        serial.print("userspace.chan_smoke: exit=", 27);
        util.print_num(code);
        serial.println(" FAIL", 5);
    }
}

fn spawn_user_cse_smoke() as void {
    serial.println("userspace.cse_smoke: start", 26);

    build_test_cse();

    let is *vma.Aspace as a = vma.aspace_create();
    if (cast(i64, a) == 0) {
        serial.println("userspace.cse_smoke: aspace FAIL", 32);
        return;
    }

    let is i64 as entry with mut = 0;
    let is i64 as user_rsp with mut = 0;
    let is i32 as rc = cse.load_cse(a, cast(*u8, &test_cse[0]), test_cse_len,
                                     cast(*u8, "test"), 4,
                                     &entry, &user_rsp);
    if (rc != 0) {
        serial.print("userspace.cse_smoke: load_cse rc=", 33);
        util.print_num(cast(i64, rc));
        serial.println(" FAIL", 5);
        return;
    }

    serial.print("userspace.cse_smoke: entry=", 27);
    util.print_hex(entry);
    serial.print(" rsp=", 5);
    util.print_hex(user_rsp);
    serial.println("", 0);

    let is i64 as tid = sched.create_user_thread(
        cast(i64, fn_ptr(user_thread_trampoline)),
        sched.QOS_NORMAL,
        a.pml4_phys, entry, user_rsp, cast(i64, a)
    );
    serial.print("userspace.cse_smoke: spawned tid=", 33);
    util.print_num(tid);
    serial.println("", 0);

    // Same validation as the ELF smoke, reading the CSE bss page, plus
    // the mmap/munmap round-trip (VA at p[2], sentinel at p[3], munmap rc
    // at p[4]).
    let is i64 as deadline = timer.current_time_ns() + 1500000000;
    let is i32 as time_ok with mut = 0;
    let is i32 as exit_ok with mut = 0;
    let is i32 as getpid_ok with mut = 0;
    let is i32 as kinfo_ok with mut = 0;
    let is i32 as mmap_ok with mut = 0;
    let is i32 as file_ok with mut = 0;
    let is i32 as wfile_ok with mut = 0;
    while (timer.current_time_ns() < deadline) {
        let is i64 as phys = vmm.virt_to_phys_walk(a.pml4_phys, CSE_TEST_BSS_VA);
        if (phys != 0) {
            let is *i64 as p = cast(*i64, pmm.phys_to_virt(phys));
            if (time_ok == 0 && p[0] != 0) {
                serial.print("userspace.cse_smoke: time_now=", 30);
                util.print_num(p[0]);
                serial.println("", 0);
                time_ok = 1;
            }
            if (exit_ok == 0 && sched.thr_gone(tid) == cast(i32, 1)) {
                exit_ok = 1;
                if (p[1] == tid) { getpid_ok = 1; }
                if (p[2] >= 4096 && p[3] == cast(i64, 0xCAFEBABE) && p[4] == 0) {
                    mmap_ok = 1;
                }
                serial.print("userspace.cse_smoke: mmap_va=", 29);
                util.print_hex(p[2]);
                serial.print(" readback=", 10);
                util.print_hex(p[3]);
                serial.print(" munmap=", 8);
                util.print_num(p[4]);
                serial.println("", 0);
                // file I/O: fd>=0, read returned the fixture, close ok, and
                // the bytes read back match "Hello from causticos FAT32!".
                let is *u8 as pb = cast(*u8, p);
                let is *u8 as want = cast(*u8, "Hello from causticos FAT32!");
                let is i32 as fmatch with mut = 1;
                let is i64 as fi with mut = 0;
                while (fi < 27) {
                    if (pb[0x200 + fi] != want[fi]) { fmatch = 0; }
                    fi = fi + 1;
                }
                if (p[6] >= 27 && p[5] >= 0 && p[7] == 0 && fmatch == 1) {
                    file_ok = 1;
                }
                serial.print("userspace.cse_smoke: open fd=", 29);
                util.print_num(p[5]);
                serial.print(" read=", 6);
                util.print_num(p[6]);
                serial.print(" close=", 7);
                util.print_num(p[7]);
                serial.print(" match=", 7);
                util.print_num(cast(i64, fmatch));
                serial.println("", 0);
                // write/lseek: created file, wrote 7B, seeked to 0, re-read
                // them back as "CAUSTIC".
                let is *u8 as want2 = cast(*u8, "CAUSTIC");
                let is i32 as wmatch with mut = 1;
                let is i64 as wi with mut = 0;
                while (wi < 7) {
                    if (pb[0x240 + wi] != want2[wi]) { wmatch = 0; }
                    wi = wi + 1;
                }
                if (p[8] >= 0 && p[9] == 7 && p[10] == 0 && p[11] == 7
                    && p[12] == 0 && wmatch == 1) {
                    wfile_ok = 1;
                }
                serial.print("userspace.cse_smoke: write=", 27);
                util.print_num(p[9]);
                serial.print(" lseek=", 7);
                util.print_num(p[10]);
                serial.print(" reread=", 8);
                util.print_num(p[11]);
                serial.print(" wmatch=", 8);
                util.print_num(cast(i64, wmatch));
                serial.println("", 0);
                serial.print("userspace.cse_smoke: getpid=", 28);
                util.print_num(p[1]);
                serial.print(" (tid=", 6);
                util.print_num(tid);
                serial.println(")", 1);
                if (p[32] == abi.KERN_INFO_SIZE && p[33] == abi.ABI_MAJOR
                    && p[34] == abi.ABI_MINOR && p[35] == abi.SYS_COUNT
                    && p[36] == 4096 && p[37] == 0) {
                    kinfo_ok = 1;
                }
                serial.print("userspace.cse_smoke: kinfo size=", 32);
                util.print_num(p[32]);
                serial.print(" syscalls_max=", 14);
                util.print_num(p[35]);
                serial.println("", 0);
            }
        }
        if (time_ok == 1 && exit_ok == 1 && getpid_ok == 1 && kinfo_ok == 1
            && mmap_ok == 1 && file_ok == 1 && wfile_ok == 1) {
            serial.println("userspace.cse_smoke: PASS", 25);
            return;
        }
        sched.sleep_for_ns(20000000);
    }
    serial.print("userspace.cse_smoke: time_ok=", 29);
    util.print_num(cast(i64, time_ok));
    serial.print(" exit_ok=", 9);
    util.print_num(cast(i64, exit_ok));
    serial.print(" getpid_ok=", 11);
    util.print_num(cast(i64, getpid_ok));
    serial.print(" kinfo_ok=", 10);
    util.print_num(cast(i64, kinfo_ok));
    serial.print(" mmap_ok=", 9);
    util.print_num(cast(i64, mmap_ok));
    serial.print(" file_ok=", 9);
    util.print_num(cast(i64, file_ok));
    serial.print(" wfile_ok=", 10);
    util.print_num(cast(i64, wfile_ok));
    serial.println(" FAIL", 5);
}

// Minimal exit-only child image: a CSE whose entire .text is
// `mov rax,SYS_PROC_EXIT; mov rdi,code; syscall`. No file I/O, no BSS —
// the churn/leak test spawns this hundreds of times, so it must be cheap
// and deterministic (the heavy test_cse with FAT32 ops occasionally blew
// the wait deadline under smp 4 + TCG). One R-X segment.
let is i64 as CSE_MIN_ENTRY = 0x401000;
let is i64 as CSE_MIN_FOFF  = 0x38;     // header(0x20) + 1 seg(0x18)
let is [128]u8 as min_cse;
let is i64 as min_cse_len with mut = 0;

fn build_min_cse(code as i64) as void {
    let is *u8 as e = cast(*u8, &min_cse[0]);
    let is i64 as z with mut = 0;
    while (z < 128) { e[z] = cast(u8, 0); z = z + 1; }
    // header (32 bytes)
    e[0]=cast(u8,0x43); e[1]=cast(u8,0x53); e[2]=cast(u8,0x54); e[3]=cast(u8,0x5F); // "CST_"
    e[4]=cast(u8,2); e[5]=cast(u8,0);                  // version u16 = 2
    e[6]=cast(u8,1);                                   // arch = 1 (x86_64)
    e[7]=cast(u8,0);                                   // flags
    write_le_u64(e, 0x08, CSE_MIN_ENTRY);              // entry_point
    write_le_u64(e, 0x10, 0x400000);                   // base (informative)
    write_le_u32(e, 0x18, 1);                          // seg_count = 1
    write_le_u32(e, 0x1C, 0);                          // app_version_off
    // seg0 @0x20: .text, R-X
    write_le_u64(e, 0x20, CSE_MIN_ENTRY);              // vaddr
    write_le_u32(e, 0x28, CSE_MIN_FOFF);               // file_off
    write_le_u32(e, 0x2C, 16);                         // file_size (shellcode)
    write_le_u32(e, 0x30, 0x1000);                     // mem_size (one page)
    write_le_u32(e, 0x34, 5);                          // perms = R|X
    // shellcode @ CSE_MIN_FOFF
    let is i64 as c with mut = CSE_MIN_FOFF;
    //   mov rax,3  (SYS_PROC_EXIT)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,3); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0);
    c = c + 7;
    //   mov rdi, code  (imm32, sign-extended)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC7);
    write_le_u32(e, c + 3, code); c = c + 7;
    //   syscall
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;
    min_cse_len = c;
}

// A parent CSE that exercises the SYS_SPAWN/SYS_WAIT syscalls from ring 3:
// it embeds a child image (min_cse, exit 42) in its own R-X text, then
//   spawn(child_va, child_len) -> wait(pid) -> exit(child_code)
// so the parent's own exit code == the child's, proving the full ring-3
// spawn+wait roundtrip (nested: kernel spawns parent, parent spawns child).
let is i64 as SPAWN_ENTRY = 0x401000;
let is i64 as SPAWN_FOFF  = 0x38;       // header(0x20) + 1 seg(0x18)
let is [512]u8 as spawn_cse;
let is i64 as spawn_cse_len with mut = 0;

fn build_spawn_parent_cse() as void {
    build_min_cse(42);                  // the child: exits 42
    let is *u8 as m = cast(*u8, &min_cse[0]);
    let is i64 as clen = min_cse_len;

    let is *u8 as e = cast(*u8, &spawn_cse[0]);
    let is i64 as z with mut = 0;
    while (z < 512) { e[z] = cast(u8, 0); z = z + 1; }
    // header
    e[0]=cast(u8,0x43); e[1]=cast(u8,0x53); e[2]=cast(u8,0x54); e[3]=cast(u8,0x5F); // "CST_"
    e[4]=cast(u8,2); e[6]=cast(u8,1);
    write_le_u64(e, 0x08, SPAWN_ENTRY);
    write_le_u64(e, 0x10, 0x400000);
    write_le_u32(e, 0x18, 1);                          // seg_count = 1
    write_le_u32(e, 0x20, 0);                          // (vaddr lo patched below)
    write_le_u64(e, 0x20, SPAWN_ENTRY);                // seg0 vaddr
    write_le_u32(e, 0x28, SPAWN_FOFF);                 // file_off
    write_le_u32(e, 0x30, 0x2000);                     // mem_size (2 pages)
    write_le_u32(e, 0x34, 5);                          // R-X

    let is i64 as c with mut = SPAWN_FOFF;
    //   jmp +clen  (skip the embedded child image)
    e[c+0]=cast(u8,0xEB); e[c+1]=cast(u8, clen); c = c + 2;
    let is i64 as child_foff = c;
    let is i64 as ci with mut = 0;
    while (ci < clen) { e[c+ci] = m[ci]; ci = ci + 1; }
    c = c + clen;
    let is i64 as child_va = SPAWN_ENTRY + (child_foff - SPAWN_FOFF);

    //   movabs rdi, child_va
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xBF); write_le_u64(e, c+2, child_va); c = c + 10;
    //   mov rsi, clen
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC6);
    write_le_u32(e, c+3, clen); c = c + 7;
    //   mov rax, 14 (SYS_SPAWN)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,14); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;
    //   syscall  → rax = pid
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;
    //   mov rdi, rax  (pid)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0xC7); c = c + 3;
    //   xor esi, esi  (status ptr = 0)
    e[c+0]=cast(u8,0x31); e[c+1]=cast(u8,0xF6); c = c + 2;
    //   mov rax, 15 (SYS_WAIT)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,15); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;
    //   syscall  → rax = child exit code
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;
    //   mov rdi, rax  (exit code)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0x89); e[c+2]=cast(u8,0xC7); c = c + 3;
    //   mov rax, 3 (SYS_PROC_EXIT)
    e[c+0]=cast(u8,0x48); e[c+1]=cast(u8,0xC7); e[c+2]=cast(u8,0xC0);
    e[c+3]=cast(u8,3); e[c+4]=cast(u8,0); e[c+5]=cast(u8,0); e[c+6]=cast(u8,0); c = c + 7;
    //   syscall
    e[c+0]=cast(u8,0x0F); e[c+1]=cast(u8,0x05); c = c + 2;

    write_le_u32(e, 0x2C, c - SPAWN_FOFF);             // file_size
    spawn_cse_len = c;
}

// ----------------------------------------------------------------
// Process spawn orchestration (Process != Thread).
//
// proc_spawn implements the create-suspended primitive: fresh aspace,
// load image, create the Process object, then a SUSPENDED main thread
// bound to it. The child's fd table starts EMPTY — authority is never
// ambient; the caller installs handles explicitly (fd handoff) before
// proc_start makes the thread runnable. No fork: the parent never runs
// code in the child; it configures the child from the outside and starts
// it. Image loading + thread creation live here (not in process.cst) so
// that module stays free of sched/vma/loader imports.
// ----------------------------------------------------------------
fn proc_spawn(parent as i64, img as *u8, img_len as i64) as i64 {
    let is *vma.Aspace as a = vma.aspace_create();
    if (cast(i64, a) == 0) { return 0; }

    let is i64 as entry with mut = 0;
    let is i64 as user_rsp with mut = 0;
    let is i32 as rc = cse.load_cse(a, img, img_len, cast(*u8, "child"), 5,
                                     &entry, &user_rsp);
    if (rc != 0) {
        vma.aspace_destroy(a);
        return 0;
    }

    let is i64 as p = proc.process_create(parent, cast(i64, a), 0);
    if (p == 0) {
        vma.aspace_destroy(a);
        return 0;
    }

    let is i64 as tid = sched.create_user_thread_ex(
        cast(i64, fn_ptr(user_thread_trampoline)),
        sched.QOS_NORMAL,
        a.pml4_phys, entry, user_rsp, cast(i64, a),
        p, 1                                   // process_ptr, suspended
    );
    proc.attach_main_thread(p, tid);
    return p;
}

// Start a spawned (suspended) process: make its main thread runnable.
fn proc_start(p as i64) as void {
    sched.make_runnable(proc.proc_first_tid(p));
}

// Process smoke — Process != Thread end to end: spawn a child PROCESS
// from the embedded CSE (which exits with code 7), start it, wait for it
// to become a zombie, collect the exit code. Validates that the thread is
// linked to its Process, the exit code propagates through the zombie, and
// the deferred reaper reclaims the thread (no leak under churn).

// Wait for a child PROCESS (pid>0; pid<=0 = any) to exit, then REAP it
// race-free. A zombie is published at exit, but its thread may still be
// finishing its last schedule() on its own kstack/CR3 — so we block until
// the deferred reaper has freed the thread (thr_exists == 0). Only then is
// it off-cpu and the aspace safe to tear down. Frees the aspace + Process
// struct and detaches from the parent. Returns the exit code, or E_AGAIN.
fn proc_wait(parent as i64, pid as i64) as i64 {
    let is i64 as deadline = timer.current_time_ns() + 5000000000;
    while (timer.current_time_ns() < deadline) {
        let is i64 as child = proc.find_zombie_child(parent, pid);
        if (child != 0) {
            let is i64 as ctid = proc.proc_first_tid(child);
            if (sched.thr_exists(ctid) == cast(i32, 0)) {
                let is i64 as code = proc.proc_exit_code(child);
                let is i64 as casp = proc.proc_aspace(child);
                if (casp != 0) { vma.aspace_destroy(cast(*vma.Aspace, casp)); }
                proc.process_free(parent, child);
                return code;
            }
        }
        sched.sleep_for_ns(10000000);
    }
    return abi.E_AGAIN;
}

fn spawn_user_proc_smoke() as void {
    serial.println("userspace.proc_smoke: start", 27);

    // (1) spawn → start → wait → reap. Verify pid != tid, thread→Process
    //     link, exit code (7), and that the reaper freed the thread. Uses a
    //     cheap exit-only child (no FAT32 I/O) so the wait deadline is
    //     deterministic under smp 4 + TCG — the heavy file-I/O path is
    //     already covered by cse_smoke.
    build_min_cse(7);
    let is i64 as p = proc_spawn(proc.init_proc, cast(*u8, &min_cse[0]), min_cse_len);
    if (p == 0) {
        serial.println("userspace.proc_smoke: spawn FAIL", 32);
        return;
    }
    let is i64 as pid = proc.proc_pid(p);
    let is i64 as tid = proc.proc_first_tid(p);
    let is i32 as link_ok with mut = 0;
    if (sched.thr_process_ptr(tid) == p) { link_ok = 1; }
    proc_start(p);

    let is i64 as code = proc_wait(proc.init_proc, pid);
    let is i32 as reaped with mut = 0;
    if (sched.thr_exists(tid) == cast(i32, 0)) { reaped = 1; }
    serial.print("userspace.proc_smoke: pid=", 26);
    util.print_num(pid);
    serial.print(" exit_code=", 11);
    util.print_num(code);
    serial.print(" link_ok=", 9);
    util.print_num(cast(i64, link_ok));
    serial.print(" reaped=", 8);
    util.print_num(cast(i64, reaped));
    serial.println("", 0);

    // (2) churn: spawn+wait 8×. The live thread count must return to its
    //     starting value (each spawn +1, each reap -1) — proves the
    //     deferred reaper reclaims kstack/FPU/struct with no leak.
    build_min_cse(0);                          // cheap exit-only child
    let is i64 as tc0 = sched.get_thread_count();
    let is i64 as n with mut = 0;
    let is i32 as churn_ok with mut = 1;
    while (n < 8) {
        let is i64 as q = proc_spawn(proc.init_proc, cast(*u8, &min_cse[0]), min_cse_len);
        if (q == 0) { churn_ok = 0; n = 8; }
        else {
            proc_start(q);
            let is i64 as qc = proc_wait(proc.init_proc, proc.proc_pid(q));
            if (qc != 0) { churn_ok = 0; }
            n = n + 1;
        }
    }
    let is i64 as tc1 = sched.get_thread_count();
    serial.print("userspace.proc_smoke: churn tc0=", 32);
    util.print_num(tc0);
    serial.print(" tc1=", 5);
    util.print_num(tc1);
    serial.println("", 0);

    let is i32 as count_ok with mut = 0;
    if (tc1 <= tc0 + 1) { count_ok = 1; }   // +1 slop for a not-yet-reaped tail
    if (code == 7 && link_ok == 1 && reaped == 1 && churn_ok == 1 && count_ok == 1) {
        serial.println("userspace.proc_smoke: PASS", 26);
    } else {
        serial.println("userspace.proc_smoke: FAIL", 26);
    }
}

// Syscall smoke — SYS_SPAWN + SYS_WAIT from ring 3. The kernel spawns a
// parent process; the parent (in ring 3) spawns its embedded child via
// SYS_SPAWN, waits for it via SYS_WAIT, and exits with the child's code
// (42). The kernel then waits on the parent and checks 42 came back up
// through both levels — proving the userspace process ABI end to end.
fn spawn_user_syscall_smoke() as void {
    serial.println("userspace.spawn_smoke: start", 28);
    build_spawn_parent_cse();
    let is i64 as p = proc_spawn(proc.init_proc, cast(*u8, &spawn_cse[0]), spawn_cse_len);
    if (p == 0) {
        serial.println("userspace.spawn_smoke: spawn FAIL", 33);
        return;
    }
    let is i64 as pid = proc.proc_pid(p);
    proc_start(p);
    let is i64 as code = proc_wait(proc.init_proc, pid);
    serial.print("userspace.spawn_smoke: pid=", 27);
    util.print_num(pid);
    serial.print(" code=", 6);
    util.print_num(code);
    serial.println("", 0);
    if (code == 42) {
        serial.println("userspace.spawn_smoke: PASS", 27);
    } else {
        serial.println("userspace.spawn_smoke: FAIL", 27);
    }
}

// FD table smoke — kernel-side test of the per-aspace fd table.
// Opens /hello.txt twice, validates fd allocation / lookup / close /
// install semantics. Doesn't go through the (yet-unwritten) syscall
// surface, but proves the foundation is correct ahead of it.
fn fd_table_smoke() as void {
    serial.println("userspace.fd_smoke: start", 25);
    let is *vma.Aspace as a = vma.aspace_create();
    if (cast(i64, a) == 0) {
        serial.println("userspace.fd_smoke: aspace FAIL", 31);
        return;
    }

    let is *vfs.VfsFile as f1 = vfs.open(cast(*u8, "/hello.txt"), 10, cast(i32, 0));
    if (cast(i64, f1) == 0) {
        serial.println("userspace.fd_smoke: open #1 FAIL", 32);
        return;
    }
    let is i64 as fd1 = vma.fd_alloc(a, cast(i64, f1));
    if (fd1 != 0) {
        serial.print("userspace.fd_smoke: expected fd=0 got ", 38);
        util.print_num(fd1);
        serial.println(" FAIL", 5);
        return;
    }
    if (vma.fd_get(a, fd1) != cast(i64, f1)) {
        serial.println("userspace.fd_smoke: fd_get mismatch FAIL", 40);
        return;
    }

    let is *vfs.VfsFile as f2 = vfs.open(cast(*u8, "/hello.txt"), 10, cast(i32, 0));
    let is i64 as fd2 = vma.fd_alloc(a, cast(i64, f2));
    if (fd2 != 1) {
        serial.println("userspace.fd_smoke: expected fd=1 FAIL", 38);
        return;
    }

    if (vma.fd_install(a, fd2, cast(i64, f2)) == 0) {
        serial.println("userspace.fd_smoke: fd_install of busy slot succeeded FAIL", 58);
        return;
    }

    if (vma.fd_close(a, fd1) != 0) {
        serial.println("userspace.fd_smoke: fd_close FAIL", 33);
        return;
    }
    if (vma.fd_get(a, fd1) != 0) {
        serial.println("userspace.fd_smoke: closed slot still occupied FAIL", 51);
        return;
    }

    let is i64 as fd3 = vma.fd_alloc(a, cast(i64, f1));
    if (fd3 != 0) {
        serial.println("userspace.fd_smoke: realloc didn't reuse FAIL", 45);
        return;
    }

    serial.println("userspace.fd_smoke: PASS", 24);
}

// Close-on-exit smoke — proves aspace teardown drains the fd table.
// Opens a file, wraps it in a KObject, installs it as an fd, then tears
// the aspace down WITHOUT closing the fd. aspace_destroy must ko_unref it
// for us, returning the VfsFile to the pool (fp.in_use → 0). Without the
// drain this leaks; with it, a process that exits with open fds is clean.
fn close_on_exit_smoke() as void {
    serial.println("userspace.coe_smoke: start", 26);
    let is *vma.Aspace as a = vma.aspace_create();
    if (cast(i64, a) == 0) {
        serial.println("userspace.coe_smoke: aspace FAIL", 32);
        return;
    }
    let is *vfs.VfsFile as fp = vfs.open(cast(*u8, "/hello.txt"), 10, cast(i32, 0));
    if (cast(i64, fp) == 0) {
        serial.println("userspace.coe_smoke: open FAIL", 30);
        return;
    }
    let is i64 as ko = vfs.make_file_kobject(fp);
    if (ko == 0) {
        serial.println("userspace.coe_smoke: wrap FAIL", 30);
        return;
    }
    let is i64 as fd = vma.fd_alloc(a, ko);
    if (fd < 0) {
        serial.println("userspace.coe_smoke: fd_alloc FAIL", 34);
        return;
    }
    if (fp.in_use == 0) {
        serial.println("userspace.coe_smoke: not in_use before FAIL", 43);
        return;
    }
    // Tear down without closing the fd — the drain must do it.
    vma.aspace_destroy(a);
    if (fp.in_use != 0) {
        serial.println("userspace.coe_smoke: LEAK on exit FAIL", 38);
        return;
    }
    serial.println("userspace.coe_smoke: PASS", 25);
}

// Thread entry called from main.cst. Sleeps a moment so the rest
// of phase-2 bind / mount finishes printing before our log lands,
// then runs the smokes once each.
fn smoke_thread() as void {
    sched.sleep_for_ns(200000000);     // 200 ms
    spawn_user_smoke();
    spawn_user_fault_smoke();
    fd_table_smoke();
    close_on_exit_smoke();
    spawn_user_elf_smoke();
    spawn_user_cse_smoke();
    spawn_user_fb_smoke();
    spawn_channel_smoke();
    spawn_user_proc_smoke();
    spawn_user_syscall_smoke();
}

