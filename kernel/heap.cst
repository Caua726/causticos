// heap.cst — Kernel heap (Phase B): the language's own allocators.
//   kmalloc(<=4096) -> bins ; kmalloc(>4096) -> pmm + large_extents ;
//   kpool_* -> typed pools (Thread/Process/FPU/KObject/Vma/Binding).
// All metadata in static BSS; slab/chunk regions come from the PMM.

use "serial.cst" as serial;
use "pmm.cst" as pmm;
use "lock.cst" as lock;

// ============================================================
// Constants
// ============================================================

let is i64 as KMALLOC_MAX_SIZE  = 4096;   // bins serves <=this; larger -> large_extents

// Global heap lock. Protects the bins/kpool slab freelists + bitmaps, the
// large_extents table, and the kpool registry. Two cpus allocating from the
// same bin/pool race on the freelist pop and corrupt the chain — observed as
// #PF inside alloc_pages / allocator internals on smp>=2. Acquired IRQ-safe
// so allocations can happen from IRQ context (e.g. io.new_request from a
// completion path). Nests INSIDE sched_lock and OUTSIDE pmm_lock.
let is lock.TicketLock as heap_lock with mut;

// ============================================================
// Bins allocator structs (vendored from Caustic/std/mem/bins.cst)
// ============================================================
// Backs the generic kmalloc(<=4096) path (Phase B sub-phase 1). The
// std bins' core.mmap_anon seam is rerouted to pmm.alloc_pages (see
// heap_pages_alloc/free). All fields are 8 bytes wide (pointers + i64)
// to stay clear of the mixed-width struct-field miscompile.

let is i64 as HEADER_SIZE = 8;   // self-identifying 8-byte block header

struct Slab {
    region as *u8;
    bitmap as *u8;
    freelist as *u8;
    region_size as i64;
    total_slots as i64;
    used_slots as i64;
    next as *u8;
}

struct Bin {
    slot_size as i64;
    alloc_size as i64;
    slab_head as *u8;
    page_size as i64;
}

struct Bins {
    bin_data as *u8;
    bin_count as i64;
    page_size as i64;
    lookup as *u8;
    lookup_entries as i64;
}

// Typed pool (vendored from Caustic/std/mem/pool.cst, adapted to grow by
// pmm chunks instead of one demand-paged region). A KPool is essentially a
// single-class bins with NO per-object header (the pool is typed, so free
// finds the chunk by address range and the slot index by offset). Reuses
// the Slab struct + bslab_create for its chunks. All fields 8 bytes.
struct KPool {
    slot_size as i64;     // obj_size aligned up to 16 (covers fxsave's 16B need)
    chunk_head as *u8;    // *Slab list (chunks grown lazily from pmm)
    used_slots as i64;
    debug as i64;         // 1 = bitmap double-free detection
    chunk_bytes as i64;   // region size per chunk
}


// ============================================================
// Bins allocator state (BSS — Phase B sub-phase 1)
// ============================================================
// 14 Bin structs * sizeof(Bin)=32 = 448 bytes
let is [448]u8 as kbins_bin_data;
// lookup table: lookup_entries=(4096>>3)+2=514 entries * 2 bytes = 1028
let is [1028]u8 as kbins_lookup;
// Bins control block (struct-typed BSS global; wired in bins_init —
// Caustic globals cannot be initialized with cast(*u8,0), so BSS + runtime).
let is Bins as kbins with mut;

// Large-allocation extents (>4096): ordered table of {i64 vaddr, i64 order}.
// 256 entries * 16 bytes = 4096. Overflow -> loud panic (see large_insert).
let is [4096]u8 as large_table_raw;
let is i64 as large_count with mut = 0;
let is i64 as LARGE_CAP = 256;

// Typed-pool registry (BSS bounded). 16 KPool structs * sizeof(KPool)=40 = 640.
let is [640]u8 as kpool_registry_raw;
let is i64 as kpool_count with mut = 0;
let is i64 as KPOOL_MAX = 16;


// ============================================================
// IRQ save/restore
// ============================================================

// Take the global heap_lock and stash the caller's RFLAGS in a
// per-cpu slot (smp.PerCpu.heap_saved_flags at offset 0x80).
// Replaces a pre-SMP pair that cli'd and wrote flags into a
// module global — two cpus racing there would trash each other's
// saved state and mis-restore IF on exit. The per-cpu slot plus
// the ticket lock gives us cross-cpu mutual exclusion AND a
// correct IF restore for each cpu independently. The gs:[0x80]
// access is emitted as raw bytes because we can't `use "smp.cst"`
// from here (would close a module cycle via smp's graph) and
// caustic-as drops the gs: segment prefix.
fn hirq_save() as void {
    let is i64 as flags = lock.acquire_irq(&heap_lock);
    // mov QWORD PTR gs:[0x80], rdi  — Caustic places arg in rdi at
    // this call position but `flags` is a local, not an arg — need
    // to shuttle it via a Caustic-friendly helper.
    heap_stash_flags(flags);
}

fn heap_stash_flags(f as i64) as void {
    // Caustic places f in rdi. Move to gs:[0x80].
    asm("mov rax, rdi\n");
    asm(".byte 0x65, 0x48, 0x89, 0x04, 0x25, 0x80, 0x00, 0x00, 0x00\n");  // mov QWORD PTR gs:[0x80], rax
}

fn heap_load_flags() as i64 {
    // Read gs:[0x80] via raw-bytes mov, stash in shuttle, return.
    asm(".byte 0x65, 0x48, 0x8B, 0x04, 0x25, 0x80, 0x00, 0x00, 0x00\n");  // mov rax, QWORD PTR gs:[0x80]
    asm("lea rbx, [rip+_kernel_heap_cst_heap_load_shuttle]\n");
    asm("mov QWORD PTR [rbx], rax\n");
    return heap_load_shuttle;
}

let is i64 as heap_load_shuttle with mut = 0;

fn hirq_restore() as void {
    let is i64 as flags = heap_load_flags();
    lock.release_irq(&heap_lock, flags);
}


// ============================================================
// Helpers
// ============================================================

fn align_up64(v as i64, a as i64) as i64 {
    return (v + a - 1) & (0 - a);
}

fn virt_to_phys(vaddr as i64) as i64 {
    return vaddr - pmm.hhdm;
}

fn virt_to_pfn(vaddr as i64) as i32 {
    return cast(i32, virt_to_phys(vaddr) >> pmm.PAGE_SHIFT);
}

// ============================================================
// ceil_log2
// ============================================================

fn ceil_log2(v as i64) as i32 {
    if (v <= 1) { return cast(i32, 0); }
    let is i32 as n with mut = 0;
    let is i64 as x with mut = v - 1;
    while (x > 0) {
        n = n + cast(i32, 1);
        x = x >> 1;
    }
    return n;
}

// ============================================================
// Bins allocator — vendored from Caustic/std/mem/bins.cst
// (Phase B sub-phase 1). core.mmap_anon -> pmm (heap_pages_*);
// core.bit_* vendored below; core.write_str errors -> pmm.panic;
// the std lazy auto-init is dropped (kbins is wired in bins_init).
// ============================================================

// --- Bitmap helpers (from core.cst:120-137) ---
fn bit_test(bitmap as *u8, idx as i64) as i32 {
    let is i64 as bi = idx >> 3;
    let is i64 as bit = idx & 7;
    if (((cast(i64, bitmap[bi]) >> bit) & 1) == 1) { return cast(i32, 1); }
    return cast(i32, 0);
}

fn bit_set(bitmap as *u8, idx as i64) as void {
    let is i64 as bi = idx >> 3;
    let is i64 as bit = idx & 7;
    bitmap[bi] = cast(u8, cast(i64, bitmap[bi]) | (1 << bit));
}

fn bit_clear(bitmap as *u8, idx as i64) as void {
    let is i64 as bi = idx >> 3;
    let is i64 as bit = idx & 7;
    bitmap[bi] = cast(u8, cast(i64, bitmap[bi]) & (255 ^ (1 << bit)));
}

// --- The mmap_anon -> pmm seam ---
// Returns an HHDM virtual address (i64), or 0 on failure. The pages come
// zeroed from the PMM (ALLOC_ZERO) and are tagged USAGE_KERNEL_HEAP.
fn heap_pages_alloc(n as i64) as i64 {
    let is i64 as pages = align_up64(n, pmm.PAGE_SIZE) / pmm.PAGE_SIZE;
    let is i32 as order = ceil_log2(pages);
    let is i32 as pfn = pmm.alloc_pages(pmm.ALLOC_ZERO, order, pmm.USAGE_KERNEL_HEAP, cast(i32, 0));
    if (pfn == pmm.PFN_NONE) { return 0; }
    return pmm.phys_to_virt(pmm.pfn_to_phys(pfn));
}

fn heap_pages_free(vaddr as i64) as void {
    pmm.free_pages(virt_to_pfn(vaddr));   // order is read back from frame_meta
}

// --- Slab backing (adapted from bins._slab_create:52) ---
fn bslab_create(alloc_size as i64, page_size as i64, bin_idx as i64) as *Slab {
    if (alloc_size > page_size) { return cast(*Slab, 0); }

    let is i64 as total_slots = page_size / alloc_size;
    if (total_slots == 0) { return cast(*Slab, 0); }

    let is i64 as bitmap_bytes = (total_slots + 7) >> 3;
    let is i64 as meta_size = sizeof(Slab) + bitmap_bytes;

    let is i64 as meta = heap_pages_alloc(meta_size);
    if (meta == 0) { return cast(*Slab, 0); }

    let is i64 as region = heap_pages_alloc(page_size);
    if (region == 0) {
        heap_pages_free(meta);
        return cast(*Slab, 0);
    }

    let is *Slab as slab = cast(*Slab, meta);
    slab.region = cast(*u8, region);
    slab.bitmap = cast(*u8, meta + sizeof(Slab));
    slab.region_size = page_size;
    slab.total_slots = total_slots;
    slab.used_slots = 0;
    slab.next = cast(*u8, 0);

    // Init bitmap: all 1s (all free); trim the unused tail bits.
    let is i64 as i with mut = 0;
    while (i < bitmap_bytes) {
        slab.bitmap[i] = 255;
        i = i + 1;
    }
    let is i64 as extra = bitmap_bytes * 8 - total_slots;
    if (extra > 0) {
        let is i64 as last = bitmap_bytes - 1;
        slab.bitmap[last] = cast(u8, (1 << (8 - extra)) - 1);
    }

    // Build freelist (next-pointer in the first 8 bytes of each free slot).
    i = 0;
    while (i < total_slots - 1) {
        let is *i64 as np = cast(*i64, region + i * alloc_size);
        *np = region + (i + 1) * alloc_size;
        i = i + 1;
    }
    let is *i64 as last_np = cast(*i64, region + (total_slots - 1) * alloc_size);
    *last_np = 0;

    slab.freelist = cast(*u8, region);
    return slab;
}

// --- Bin helpers (from bins.cst:114,118,144,384) ---
fn bin_at(b as *Bins, idx as i64) as *Bin {
    return cast(*Bin, cast(i64, b.bin_data) + idx * sizeof(Bin));
}

fn build_lookup(b as *Bins) as void {
    let is i64 as entries = b.lookup_entries;
    let is i64 as i with mut = 0;
    while (i < entries * 2) {
        b.lookup[i] = 255;
        i = i + 1;
    }
    i = 0;
    while (i < entries) {
        let is i64 as size with mut = i * 8;
        if (size == 0) { size = 1; }
        let is i64 as j with mut = 0;
        while (j < b.bin_count) {
            let is *Bin as bin = bin_at(b, j);
            if (bin.slot_size >= size) {
                let is *u8 as lp = cast(*u8, cast(i64, b.lookup) + i * 2);
                lp[0] = cast(u8, j & 255);
                lp[1] = cast(u8, (j >> 8) & 255);
                break;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

fn lookup_bin(b as *Bins, size as i64) as i64 {
    let is i64 as idx with mut = size >> 3;
    if ((size & 7) != 0) { idx = idx + 1; }
    if (idx >= b.lookup_entries) { return 0 - 1; }
    let is *u8 as lp = cast(*u8, cast(i64, b.lookup) + idx * 2);
    let is i64 as bin_idx = cast(i64, lp[0]) + cast(i64, lp[1]) * 256;
    if (bin_idx >= 255) { return 0 - 1; }
    return bin_idx;
}

fn bins_which(b as *Bins, size as i64) as i64 {
    if (size <= 0) { return 0; }
    let is i64 as idx = lookup_bin(b, size);
    if (idx < 0) { return 0; }
    return bin_at(b, idx).slot_size;
}

// --- Alloc: O(1) lookup + O(1) freelist pop (from bins.cst:262) ---
fn bins_alloc(b as *Bins, size as i64) as *u8 {
    if (size <= 0) { return cast(*u8, 0); }

    let is i64 as idx = lookup_bin(b, size);
    if (idx < 0) {
        pmm.panic("bins: bad size class", 20);   // unreachable: >4096 -> large
    }

    let is *Bin as bin = bin_at(b, idx);

    // Search existing slabs for a free slot.
    let is *Slab as slab with mut = cast(*Slab, bin.slab_head);
    while (cast(i64, slab) != 0) {
        if (cast(i64, slab.freelist) != 0) {
            let is *u8 as slot = slab.freelist;
            let is *i64 as np = cast(*i64, slot);
            slab.freelist = cast(*u8, *np);
            let is i64 as si = (cast(i64, slot) - cast(i64, slab.region)) / bin.alloc_size;
            let is *u8 as hdr = cast(*u8, slot);
            hdr[0] = cast(u8, idx);
            hdr[1] = cast(u8, si & 255);
            hdr[2] = cast(u8, (si >> 8) & 255);
            hdr[3] = cast(u8, (si >> 16) & 255);
            bit_clear(slab.bitmap, si);
            slab.used_slots = slab.used_slots + 1;
            return cast(*u8, cast(i64, slot) + HEADER_SIZE);
        }
        slab = cast(*Slab, slab.next);
    }

    // No free slot — grow: create a new slab.
    let is *Slab as new_slab = bslab_create(bin.alloc_size, bin.page_size, idx);
    if (cast(i64, new_slab) == 0) { return cast(*u8, 0); }

    new_slab.next = bin.slab_head;
    bin.slab_head = cast(*u8, new_slab);

    let is *u8 as slot = new_slab.freelist;
    let is *i64 as np = cast(*i64, slot);
    new_slab.freelist = cast(*u8, *np);
    let is *u8 as hdr = cast(*u8, slot);
    hdr[0] = cast(u8, idx);
    hdr[1] = 0;
    hdr[2] = 0;
    hdr[3] = 0;
    bit_clear(new_slab.bitmap, 0);
    new_slab.used_slots = 1;
    return cast(*u8, cast(i64, slot) + HEADER_SIZE);
}

// --- Free: O(1) header read + bitmap test + freelist push (bins.cst:329) ---
// Fail-loud (kernel posture): the std silently returns on a bad/double
// free; here we panic, matching the old slab path's verify_* panics.
fn bins_free(b as *Bins, ptr as *u8) as void {
    if (cast(i64, ptr) == 0) { return; }

    let is *u8 as slot = cast(*u8, cast(i64, ptr) - HEADER_SIZE);
    let is *u8 as hdr = cast(*u8, slot);
    let is i64 as idx = cast(i64, hdr[0]);
    let is i64 as si = cast(i64, hdr[1]) + cast(i64, hdr[2]) * 256 + cast(i64, hdr[3]) * 65536;

    if (idx >= b.bin_count) {
        pmm.panic("kfree: bad bins header", 22);
    }

    let is *Bin as bin = bin_at(b, idx);

    let is *Slab as slab with mut = cast(*Slab, bin.slab_head);
    while (cast(i64, slab) != 0) {
        let is i64 as start = cast(i64, slab.region);
        let is i64 as end = start + slab.region_size;
        if (cast(i64, slot) >= start && cast(i64, slot) < end) {
            if (bit_test(slab.bitmap, si) == cast(i32, 1)) {
                pmm.panic("kfree: double free", 18);
            }
            bit_set(slab.bitmap, si);
            slab.used_slots = slab.used_slots - 1;
            let is *i64 as np = cast(*i64, slot);
            *np = cast(i64, slab.freelist);
            slab.freelist = slot;
            return;
        }
        slab = cast(*Slab, slab.next);
    }
    pmm.panic("kfree: ptr not in any slab", 26);
}

// ============================================================
// Large-allocation extents (>4096) — ordered {vaddr, order} table
// ============================================================

fn large_vaddr_at(i as i64) as i64 {
    let is *i64 as p = cast(*i64, cast(i64, &large_table_raw) + i * 16);
    return p[0];
}

fn large_order_at(i as i64) as i64 {
    let is *i64 as p = cast(*i64, cast(i64, &large_table_raw) + i * 16 + 8);
    return p[0];
}

fn large_set(i as i64, vaddr as i64, order as i64) as void {
    let is *i64 as pv = cast(*i64, cast(i64, &large_table_raw) + i * 16);
    pv[0] = vaddr;
    let is *i64 as po = cast(*i64, cast(i64, &large_table_raw) + i * 16 + 8);
    po[0] = order;
}

// Binary search by vaddr; returns the entry index or -1.
fn large_find(vaddr as i64) as i64 {
    let is i64 as lo with mut = 0;
    let is i64 as hi with mut = large_count - 1;
    while (lo <= hi) {
        let is i64 as mid = (lo + hi) / 2;
        let is i64 as m = large_vaddr_at(mid);
        if (m == vaddr) { return mid; }
        if (m < vaddr) { lo = mid + 1; } else { hi = mid - 1; }
    }
    return 0 - 1;
}

// Insert keeping the table sorted ascending by vaddr.
fn large_insert(vaddr as i64, order as i64) as void {
    if (large_count >= LARGE_CAP) {
        pmm.panic("large_extents table exhausted", 29);
    }
    let is i64 as i with mut = large_count;
    while (i > 0) {
        let is i64 as prev = large_vaddr_at(i - 1);
        if (prev <= vaddr) { break; }
        large_set(i, prev, large_order_at(i - 1));
        i = i - 1;
    }
    large_set(i, vaddr, order);
    large_count = large_count + 1;
}

// Remove the entry at idx (shift the tail down by one).
fn large_remove_at(idx as i64) as void {
    let is i64 as i with mut = idx;
    while (i < large_count - 1) {
        large_set(i, large_vaddr_at(i + 1), large_order_at(i + 1));
        i = i + 1;
    }
    large_count = large_count - 1;
}

fn large_extents_init() as void {
    large_count = 0;
}

// ============================================================
// Bins init — wire the static kbins control block (14 kernel classes)
// ============================================================
fn bins_init() as void {
    // bins trusts sizeof(Bin)/sizeof(Slab) for its strides — guard it.
    if (sizeof(Bin) != 32)  { pmm.panic("bins: sizeof(Bin) != 32", 23); }
    if (sizeof(Slab) != 56) { pmm.panic("bins: sizeof(Slab) != 56", 24); }

    kbins.bin_data = cast(*u8, &kbins_bin_data);
    kbins.bin_count = 14;
    kbins.page_size = 65536;
    kbins.lookup = cast(*u8, &kbins_lookup);
    kbins.lookup_entries = 514;

    let is [14]i64 as sizes;
    sizes[0] = 16;    sizes[1] = 32;    sizes[2] = 64;    sizes[3] = 96;
    sizes[4] = 128;   sizes[5] = 192;   sizes[6] = 256;   sizes[7] = 384;
    sizes[8] = 512;   sizes[9] = 768;   sizes[10] = 1024; sizes[11] = 1536;
    sizes[12] = 2048; sizes[13] = 4096;

    let is i64 as i with mut = 0;
    while (i < 14) {
        let is *Bin as bin = bin_at(&kbins, i);
        bin.slot_size = sizes[i];
        bin.alloc_size = sizes[i] + HEADER_SIZE;
        bin.slab_head = cast(*u8, 0);
        bin.page_size = 65536;
        i = i + 1;
    }
    build_lookup(&kbins);
}

// ============================================================
// Typed pool (kpool) — fixed-size slots, O(1), grows by pmm chunks
// ============================================================
// A pool is a chain of Slab chunks (reused from bins). Slots carry NO
// header (the pool is typed): user pointer == slot. free locates the chunk
// by address range and the slot index by offset. Chunk metadata + region
// come from the PMM (bslab_create); the KPool control block lives in the
// BSS registry. heap_lock serializes all mutation.

// Caller holds heap_lock. Grabs a registry slot and inits the control block.
fn kpool_create_locked(obj_size as i64, debug as i64) as i64 {
    if (kpool_count >= KPOOL_MAX) {
        pmm.panic("kpool registry exhausted", 24);
    }
    let is i64 as p = cast(i64, &kpool_registry_raw) + kpool_count * sizeof(KPool);
    kpool_count = kpool_count + 1;
    let is *KPool as kp = cast(*KPool, p);
    // Align the slot up to 16 bytes: covers fxsave's 16-byte requirement and
    // keeps every slot 16-aligned (chunk region is page-aligned from the PMM).
    let is i64 as ss with mut = (obj_size + 15) & (0 - 16);
    if (ss < 16) { ss = 16; }
    kp.slot_size = ss;
    kp.chunk_head = cast(*u8, 0);
    kp.used_slots = 0;
    kp.debug = debug;
    kp.chunk_bytes = 65536;
    return p;
}

// Caller holds heap_lock. Allocates one slot (grows by a chunk if needed).
fn kpool_alloc_locked(kp as *KPool) as i64 {
    let is *Slab as slab with mut = cast(*Slab, kp.chunk_head);
    while (cast(i64, slab) != 0) {
        if (cast(i64, slab.freelist) != 0) {
            let is *u8 as slot = slab.freelist;
            let is *i64 as np = cast(*i64, slot);
            slab.freelist = cast(*u8, *np);
            if (kp.debug == 1) {
                let is i64 as si = (cast(i64, slot) - cast(i64, slab.region)) / kp.slot_size;
                bit_clear(slab.bitmap, si);
            }
            slab.used_slots = slab.used_slots + 1;
            kp.used_slots = kp.used_slots + 1;
            return cast(i64, slot);   // no header: user pointer == slot
        }
        slab = cast(*Slab, slab.next);
    }
    // Grow: new chunk (alloc_size == slot_size, no header).
    let is *Slab as nc = bslab_create(kp.slot_size, kp.chunk_bytes, 0);
    if (cast(i64, nc) == 0) { return 0; }
    nc.next = kp.chunk_head;
    kp.chunk_head = cast(*u8, nc);
    let is *u8 as slot = nc.freelist;
    let is *i64 as np = cast(*i64, slot);
    nc.freelist = cast(*u8, *np);
    if (kp.debug == 1) { bit_clear(nc.bitmap, 0); }
    nc.used_slots = 1;
    kp.used_slots = kp.used_slots + 1;
    return cast(i64, slot);
}

// Public: explicit creation (plan API). Returns a KPool handle (i64).
fn kpool_create(obj_size as i64, debug as i64) as i64 {
    hirq_save();
    let is i64 as r = kpool_create_locked(obj_size, debug);
    hirq_restore();
    return r;
}

// Public: allocate from an existing pool handle.
fn kpool_alloc(pool as i64) as i64 {
    if (pool == 0) { return 0; }
    hirq_save();
    let is i64 as r = kpool_alloc_locked(cast(*KPool, pool));
    hirq_restore();
    return r;
}

// Public convenience: lazily create the pool (if *handle_ptr == 0) and
// allocate, all under one heap_lock acquisition — SMP-safe, no init-order
// dependency. handle_ptr is the address of a module-global i64 holding the
// pool handle. Returns the slot, or 0 on OOM.
fn kpool_alloc_ensure(handle_ptr as i64, obj_size as i64, debug as i64) as i64 {
    hirq_save();
    let is *i64 as hp = cast(*i64, handle_ptr);
    if (hp[0] == 0) {
        hp[0] = kpool_create_locked(obj_size, debug);
    }
    let is i64 as r = kpool_alloc_locked(cast(*KPool, hp[0]));
    hirq_restore();
    return r;
}

// Public: free a slot back to its pool. Fail-loud on bad ptr / double free.
fn kpool_free(pool as i64, ptr as i64) as void {
    if (ptr == 0) { return; }
    if (pool == 0) { pmm.panic("kpool_free: null pool", 21); }
    let is *KPool as kp = cast(*KPool, pool);
    hirq_save();
    let is *Slab as slab with mut = cast(*Slab, kp.chunk_head);
    while (cast(i64, slab) != 0) {
        let is i64 as start = cast(i64, slab.region);
        let is i64 as end = start + slab.region_size;
        if (ptr >= start && ptr < end) {
            let is i64 as si = (ptr - start) / kp.slot_size;
            if (kp.debug == 1) {
                if (bit_test(slab.bitmap, si) == cast(i32, 1)) {
                    pmm.panic("kpool_free: double free", 23);
                }
                bit_set(slab.bitmap, si);
            }
            let is *i64 as np = cast(*i64, ptr);
            *np = cast(i64, slab.freelist);
            slab.freelist = cast(*u8, ptr);
            slab.used_slots = slab.used_slots - 1;
            kp.used_slots = kp.used_slots - 1;
            hirq_restore();
            return;
        }
        slab = cast(*Slab, slab.next);
    }
    hirq_restore();
    pmm.panic("kpool_free: ptr not in any chunk", 32);
}

// ============================================================
// kmalloc / kfree
// ============================================================

fn kmalloc(size as i64, flags as i32) as i64 {
    if (size == 0) { return 0; }

    if (size > KMALLOC_MAX_SIZE) {
        // Large: page allocation + record in the large_extents table.
        // pmm.alloc_pages has its own lock and honors ALLOC_ZERO natively
        // (flags passthrough), so the page comes zeroed when requested.
        let is i64 as pages_needed = pmm.align_up(size, pmm.PAGE_SIZE) / pmm.PAGE_SIZE;
        let is i32 as order = ceil_log2(pages_needed);
        let is i32 as pfn = pmm.alloc_pages(flags, order, pmm.USAGE_KERNEL, cast(i32, 0));
        if (pfn == pmm.PFN_NONE) { return 0; }
        let is i64 as ptr = pmm.phys_to_virt(pmm.pfn_to_phys(pfn));
        hirq_save();
        large_insert(ptr, cast(i64, order));
        hirq_restore();
        return ptr;
    }

    // Small: bins. heap_lock serializes kbins/slab freelist mutation;
    // bins_alloc may call pmm.alloc_pages on a new-slab miss (heap nests
    // OUTSIDE pmm, so holding heap_lock across it is the correct order).
    hirq_save();
    let is i64 as ptr = cast(i64, bins_alloc(&kbins, size));
    hirq_restore();
    if (ptr == 0) { return 0; }

    // ALLOC_ZERO contract: bins does NOT re-zero reused slots, so zero the
    // slot here (outside the lock). Zero the class slot_size — exactly fills
    // the slot body and matches what callers expect from a zeroed allocation.
    if ((flags & cast(i32, pmm.ALLOC_ZERO)) != cast(i32, 0)) {
        let is i64 as zlen = bins_which(&kbins, size);
        let is *u8 as p = cast(*u8, ptr);
        let is i64 as i with mut = 0;
        while (i < zlen) { p[i] = 0; i = i + 1; }
    }
    return ptr;
}

fn kfree(ptr as i64) as void {
    if (ptr == 0) { return; }

    // No pmm.page_usage read: large allocations are page-aligned, so a
    // non-page-aligned ptr is definitely a bins block. A page-aligned ptr
    // MIGHT be large OR a bins slot that happens to be page-aligned — the
    // large_extents membership test is authoritative; a miss falls through
    // to bins_free.
    let is i32 as do_free_pfn with mut = cast(i32, 0);
    let is i32 as pfn with mut = cast(i32, 0);

    hirq_save();
    let is i64 as lidx with mut = 0 - 1;
    if ((ptr & 0xFFF) == 0) {
        lidx = large_find(ptr);
    }
    if (lidx >= 0) {
        large_remove_at(lidx);
        pfn = virt_to_pfn(ptr);
        do_free_pfn = cast(i32, 1);
    } else {
        bins_free(&kbins, cast(*u8, ptr));
    }
    hirq_restore();

    // Deferred outside heap_lock (pmm has its own lock).
    if (do_free_pfn != cast(i32, 0)) {
        pmm.free_pages(pfn);
    }
}

// ============================================================
// Init
// ============================================================

fn init() as void {
    serial.println("heap: init", 10);

    // The heap is its own allocators (Phase B): bins for generic
    // kmalloc(<=4096), large_extents for >4096, and typed kpools (created
    // lazily by their subsystems). The PMM is up (main.cst:120 precedes :122),
    // so the first slab/chunk region comes straight from it — no recursion.
    bins_init();
    serial.println("  bins ok", 9);
    large_extents_init();
    serial.println("  large_extents ok", 18);

    serial.println("heap: ready", 11);
}

// ============================================================
// heap_smoke — exercises bins (every class + reuse), large, and kpool
// (reuse without growth + the double-free bitmap gate). Fail-loud: any
// broken invariant panics. Run once at boot, single-threaded.
// ============================================================
fn heap_smoke() as void {
    serial.println("heap_smoke: start", 17);
    let is i32 as ok with mut = cast(i32, 1);

    // 1) bins: alloc one of every size class, touch first + last usable byte,
    //    then free all (exercises every bin + lazy slab creation).
    let is [14]i64 as csz;
    csz[0] = 16;    csz[1] = 32;    csz[2] = 64;    csz[3] = 96;
    csz[4] = 128;   csz[5] = 192;   csz[6] = 256;   csz[7] = 384;
    csz[8] = 512;   csz[9] = 768;   csz[10] = 1024; csz[11] = 1536;
    csz[12] = 2048; csz[13] = 4096;
    let is [14]i64 as pp;
    let is i64 as i with mut = 0;
    while (i < 14) {
        let is i64 as a = kmalloc(csz[i], cast(i32, 0));
        if (a == 0) { ok = cast(i32, 0); }
        else {
            let is *u8 as b = cast(*u8, a);
            b[0] = cast(u8, 65);
            b[csz[i] - 1] = cast(u8, 90);   // last usable byte — stays inside the slot
        }
        pp[i] = a;
        i = i + 1;
    }
    i = 0;
    while (i < 14) { kfree(pp[i]); i = i + 1; }

    // 2) bins LIFO reuse: alloc / free / alloc same class -> same pointer.
    let is i64 as r1 = kmalloc(64, cast(i32, 0));
    kfree(r1);
    let is i64 as r2 = kmalloc(64, cast(i32, 0));
    if (r1 != r2) { ok = cast(i32, 0); }
    kfree(r2);

    // 3) large (>4096): served by pmm + large_extents, must be page-aligned.
    let is i64 as lrg = kmalloc(8192, cast(i32, pmm.ALLOC_ZERO));
    if (lrg == 0) { ok = cast(i32, 0); }
    if ((lrg & 0xFFF) != 0) { ok = cast(i32, 0); }
    kfree(lrg);

    // 4) kpool: reuse without growth + the double-free bitmap gate.
    let is i64 as tp with mut = 0;
    let is i64 as k1 = kpool_alloc_ensure(cast(i64, &tp), 64, 1);
    let is i64 as k2 = kpool_alloc_ensure(cast(i64, &tp), 64, 1);
    kpool_free(tp, k1);
    let is i64 as k3 = kpool_alloc(tp);          // reuses k1's slot (LIFO)
    if (k3 != k1) { ok = cast(i32, 0); }

    // The per-slot bitmap is the gate that catches a double free (a 2nd free
    // hits bit_test==1 -> pmm.panic). Assert the alloc/free state transition
    // directly rather than firing the (fatal-by-design) panic.
    let is *KPool as kpp = cast(*KPool, tp);
    let is *Slab as ch = cast(*Slab, kpp.chunk_head);
    if (k3 < cast(i64, ch.region)) { ok = cast(i32, 0); }
    let is i64 as si = (k3 - cast(i64, ch.region)) / kpp.slot_size;
    if (bit_test(ch.bitmap, si) != cast(i32, 0)) { ok = cast(i32, 0); }   // allocated -> bit clear
    kpool_free(tp, k3);
    if (bit_test(ch.bitmap, si) != cast(i32, 1)) { ok = cast(i32, 0); }   // freed -> bit set (gate armed)
    kpool_free(tp, k2);
    if (kpp.used_slots != 0) { ok = cast(i32, 0); }                       // every slot returned

    if (ok == cast(i32, 1)) { serial.println("heap_smoke: PASS", 16); }
    else { pmm.panic("heap_smoke FAILED", 17); }
}
