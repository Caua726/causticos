// main.cst — causticos kernel entry point

use "limine.cst" as limine;
use "fb.cst" as fb;
use "surface.cst" as surface;
use "channel.cst" as channel;
use "eventfd.cst" as eventfd;
use "segment.cst" as segment;
use "serial.cst" as serial;
use "gdt.cst" as gdt;
use "idt.cst" as idt;
use "font8x8.cst" as font;
use "pmm.cst" as pmm;
use "heap.cst" as heap;
use "vmm.cst" as vmm;
use "timer.cst" as timer;
use "sched.cst" as sched;
use "util.cst" as util;
use "lapic.cst" as lapic;
use "process.cst" as proc;
use "driver.cst" as driver;
use "spec.cst" as spec;
use "ksym.cst" as ksym;
use "specparse.cst" as specparse;
use "dummybus.cst" as dummybus;
use "pci.cst" as pci;
use "random.cst" as random;
use "virtio.cst" as virtio;
use "netdev.cst" as netdev;
use "e1000.cst" as e1000;
use "ioapic.cst" as ioapic;
use "platform_bus.cst" as platform_bus;
use "membus.cst" as membus;
use "kbd.cst" as kbd;
use "mouse.cst" as mouse;
use "vtablet.cst" as vtablet;
use "vnet.cst" as vnet;
use "ahci.cst" as ahci;
use "fat32.cst" as fat32;
use "vfs.cst" as vfs;
use "acpi.cst" as acpi;
use "hpet.cst" as hpet;
use "smp.cst" as smp;
use "userspace.cst" as userspace;
use "syscall.cst" as sysc;
use "syshandlers.cst" as syshandlers;

// Boot screen colors (32bpp XRGB)
let is i64 as COLOR_BG    = 0x001a1a2e;
let is i64 as COLOR_WHITE = 0x00FFFFFF;

fn halt() as void {
    serial.println("kernel halted", 13);
    asm("cli\n");
    while (1 == 1) {
        asm(".byte 0xF4\n");
    }
}

// Test: preemptive scheduling — threads busy-loop, timer preempts them
fn test_preempt_a() as void {
    let is i64 as count with mut = 0;
    let is i64 as last_print with mut = 0;
    while (count < 5000000) {
        count = count + 1;
        if (count - last_print >= 1000000) {
            serial.print("A:", 2);
            util.print_num(count);
            serial.println("", 0);
            last_print = count;
        }
    }
    serial.println("A done", 6);
}

fn test_preempt_b() as void {
    let is i64 as count with mut = 0;
    let is i64 as last_print with mut = 0;
    while (count < 5000000) {
        count = count + 1;
        if (count - last_print >= 1000000) {
            serial.print("B:", 2);
            util.print_num(count);
            serial.println("", 0);
            last_print = count;
        }
    }
    serial.println("B done", 6);
}

let is i64 as fn_addr_a with mut = 0;
let is i64 as fn_addr_b with mut = 0;
let is i64 as fn_addr_driver_init with mut = 0;
let is i64 as fn_addr_fat32_mount with mut = 0;
let is i64 as fn_addr_vfs_test with mut = 0;
let is i64 as fn_addr_userspace_smoke with mut = 0;
let is i64 as fn_addr_init_thread with mut = 0;

// Boot flavour. 0 = clean boot: hardware → mount → launch /init.cse (production,
// run.sh, the self-host bootstrap). 1 = smoke boot: run the kernel/userspace
// smokes + VFS self-test instead of launching /init (regression, verify.sh).
// The two never interleave — a single explicit switch, no disk sentinel.
let is i64 as RUN_SMOKE_INIT with imut = 0;

fn _kernel_start() as void {
    if (limine.fb_req_response == 0) {
        serial.init();
        serial.println("FATAL: no framebuffer response from limine", 42);
        halt();
    }
    let is *limine.LimineFbResponse as resp = cast(*limine.LimineFbResponse, limine.fb_req_response);
    if (resp.fb_count == 0) {
        serial.init();
        serial.println("FATAL: limine reported 0 framebuffers", 37);
        halt();
    }
    let is *i64 as fbarr = cast(*i64, resp.framebuffers);
    let is *limine.LimineFramebuffer as framebuffer = cast(*limine.LimineFramebuffer, fbarr[0]);

    serial.init();
    serial.println("causticos v0.0.2", 16);
    gdt.init();
    // Install BSP's GS base immediately after GDT so the IDT stubs
    // that probe per-cpu need_resched via gs:[0x50] have a valid
    // PerCpu slot to read from the moment sti happens inside
    // idt.init. smp.init later overwrites the same slot with full
    // discovery data — these are just sentinels to keep early IRQs
    // from faulting on an uninstalled GS base.
    smp.init_bsp_early();
    // Serial buffers a line per cpu and needs to know which cpu is speaking.
    // Injected rather than imported: smp.cst logs through serial, so a `use`
    // the other way would be a cycle. Wired here, the first moment asking is
    // safe — before this, only the BSP is running and everything is cpu 0.
    serial.set_cpu_id_fn(cast(i64, fn_ptr(smp.current_cpu_id)));
    timer.init();
    idt.init();
    font.init();
    serial.println("boot ok", 7);

    pmm.init();
    pmm.buddy_selftest();   // validate frame_meta + intrusive free-list before heap rides on the PMM
    pmm.pzero_smoke();      // pre-zeroed frame pool: refill → serve-from-pool → drain → free_total round-trip
    heap.init();
    heap.heap_smoke();      // exercise bins (every class + reuse), large, kpool + double-free gate
    vmm.init();

    // ACPI before anything time-sensitive: MADT supplies the IOAPIC
    // address + ISA IRQ overrides, HPET gives us the high-resolution
    // counter LAPIC calibrates against, MCFG hands out PCIe ECAM
    // regions for modern config access.
    acpi.parse();
    hpet.init();

    // Entropy before anything that needs an unguessable number. Probes CPUID
    // for RDSEED/RDRAND and says loudly when the machine has neither, since
    // that is a real limitation TLS will have to refuse on later.
    random.init();
    random.smoke();

    // LAPIC timer: calibrate against HPET (falls back to PIT if HPET
    // missing), then take over scheduler ticking.
    lapic.init();
    timer.using_lapic = 1;

    fb.init(framebuffer);
    // boot screen: black with a big centred "causticos" — drop shadow for
    // depth, bright cyan face (the Caustic accent). The WM repaints on start.
    fb.clear(cast(i32, 0x00000000));
    let is i64 as sc = 6;
    let is i64 as sw = 9 * 8 * sc;                          // "causticos" = 9 chars
    let is i64 as tx = (fb.width() - sw) / 2;
    let is i64 as ty = (fb.height() - 8 * sc) / 2;
    fb.print_scaled(cast(*u8, "causticos"), 9, tx + 4, ty + 5, cast(i32, 0x00123040), sc);  // shadow
    fb.print_scaled(cast(*u8, "causticos"), 9, tx, ty, cast(i32, 0x0073d0ff), sc);          // cyan face
    surface.init();        // wire the KOBJ_SURFACE vtable before dev_open
    surface.smoke();       // kernel-side: acquire → draw → present → verify scanout
    channel.init();        // wire the KOBJ_CHANNEL vtable before channel_create
    channel.smoke();       // kernel-side: mint pair → write A → read B → verify
    channel.fd_pass_smoke();  // kernel-side: pass a KObject reference across a channel
    segment.init();        // wire the KOBJ_SEGMENT vtable before SYS_SEG_CREATE
    segment.smoke();       // kernel-side: create → attach 2 aspaces → share → teardown
    eventfd.init();        // wire the KOBJ_EVENT vtable before SYS_EVENT_SUBSCRIBE
    eventfd.smoke();       // kernel-side: create → post → read back → verify → close

    proc.init();
    // Wire the child-exit hook: process.zombify -> eventfd.event_post. Done
    // here (composition) so process.cst needs no eventfd import.
    proc.event_post_fn = cast(i64, fn_ptr(eventfd.event_post));

    // Driver framework — Phase 1: init, register bus types/drivers, enumerate.
    // Must complete before sched.init because probing (Phase 2) needs the
    // scheduler online.
    driver.init();
    ioapic.init();
    pci.register();
    virtio.chain_smoke();  // descriptor free list, on a synthetic queue
    netdev.net_init();     // wire the KOBJ_DEVICE vtable before dev_open(DEV_NET)
    netdev.register_ksyms();
    e1000.register();
    dummybus.register();
    platform_bus.register();
    kbd.kbd_init();        // wire the KOBJ_DEVICE vtable before dev_open(DEV_KEYBOARD)
    kbd.register();
    mouse.mouse_init();    // wire the KOBJ_DEVICE vtable before dev_open(DEV_MOUSE)
    mouse.register();
    vtablet.vtablet_init();
    vtablet.register();
    vnet.register();
    ahci.register();
    membus.register();     // RAM regions as hardware-tree nodes (L0)
    driver.driver_enumerate_all();
    membus.smoke();        // DFS the tree, log the RAM regions
    ksym.dump();

    // Exercise ksym lookup as smoke test for Phase 2.3.
    let is i64 as bind_addr = ksym.lookup(cast(*u8, "dummybus.dummy_bind"), 19);
    if (bind_addr != 0) {
        serial.print("ksym: dummybus.dummy_bind=", 26);
        util.print_hex(bind_addr);
        serial.println("", 0);
    } else {
        serial.println("ksym: lookup FAILED", 19);
    }

    // Phase 2.4: parse embedded .cdvrspec blobs and register each one.
    specparse.init();

    // VFS + FAT32 vtable initialisation. The mount itself happens on
    // the fat32 worker thread once the block device registers.
    vfs.init();
    fat32.vfs_ops_init();

    // SMP: bring up the application processors. BSP stays the one
    // running the scheduler today; APs land in the ap_entry() HLT
    // idle loop ready for per-CPU scheduler retrofit in the next
    // phase. Uniprocessor runs still work — smp.init() gracefully
    // configures just the BSP slot if Limine reports one CPU.
    smp.init();
    sysc.init();
    // Wire the syscall handlers into the dispatch table. main owns this
    // composition step so syscall.cst need not import syshandlers.cst
    // (that would close a syscall->syshandlers->sched->syscall import
    // cycle the compiler can't handle). Hand syshandlers the dispatch_set
    // callback, then let it register every implemented number.
    syshandlers.install_fn_addr = sysc.dispatch_set_ptr();
    syshandlers.install_all();

    sched.init();

    asm("lea rax, [rip+test_preempt_a]\n");
    asm("lea rbx, [rip+fn_addr_a]\n");
    asm("mov QWORD PTR [rbx], rax\n");
    asm("lea rax, [rip+test_preempt_b]\n");
    asm("lea rbx, [rip+fn_addr_b]\n");
    asm("mov QWORD PTR [rbx], rax\n");

    // Driver framework — Phase 2 runs inside this thread once the scheduler
    // dispatches it. fn_ptr avoids hard-coding the cross-module mangled name.
    fn_addr_driver_init = cast(i64, fn_ptr(spec.phase2_thread));
    fn_addr_fat32_mount = cast(i64, fn_ptr(fat32.mount_thread));
    fn_addr_vfs_test    = cast(i64, fn_ptr(vfs.self_test_thread));
    fn_addr_userspace_smoke = cast(i64, fn_ptr(userspace.smoke_init));
    fn_addr_init_thread = cast(i64, fn_ptr(userspace.init_thread));
    // I/O + framework threads are sleep/wakeup-driven — they sit in
    // the runqueue for microseconds per AHCI or mount step, then
    // block on sched.sleep until the completer wakes them. Put them
    // in QOS_ACTIVE so pick_next prefers them over the CPU-bound
    // preempt test threads; otherwise A/B would dominate both cpus
    // under -smp 2/4 and the mount latency chains out past the
    // internal 30s vfs/fat32 timers. A/B go into QOS_NORMAL where
    // they only run when no I/O thread is runnable.
    sched.create_thread(fn_addr_driver_init, sched.QOS_ACTIVE);
    sched.create_thread(fn_addr_fat32_mount, sched.QOS_ACTIVE);
    // The network smoke waits for phase 2 to bind the NICs, then exercises the
    // DEV_NET contract through the same KObject a program gets. It replaces
    // the per-driver ARP smokes that used to run inside on_bind and cost up to
    // two seconds of boot each.
    sched.create_thread(cast(i64, fn_ptr(netdev.smoke_thread)), sched.QOS_ACTIVE);
    if (RUN_SMOKE_INIT == 1) {
        // Smoke boot (verify.sh): VFS self-test + the userspace smoke gauntlet.
        // No /init — the smokes are the workload, and the A/B preempt spinners
        // ride along so context-switching is exercised under load.
        sched.create_thread(fn_addr_vfs_test,    sched.QOS_ACTIVE);
        sched.create_thread(fn_addr_userspace_smoke, sched.QOS_ACTIVE);
        sched.create_thread(fn_addr_a, sched.QOS_NORMAL);
        sched.create_thread(fn_addr_b, sched.QOS_NORMAL);
    } else {
        // Clean boot (production / bootstrap): straight to /init.cse, nothing
        // competing for CPU with the launched program.
        sched.create_thread(fn_addr_init_thread, sched.QOS_ACTIVE);
    }

    serial.println("starting scheduler", 18);
    sched.start();
}
