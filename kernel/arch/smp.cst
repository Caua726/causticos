// smp.cst — Application Processor bring-up and per-CPU state.
//
// Relies on Limine's SMP response to skip the 16→32→64-bit
// trampoline dance: the bootloader has already brought each AP into
// 64-bit long mode with our page tables active, then parked them in
// a spin loop waiting for a function pointer. We publish our
// ap_entry() address into each CPU's goto_address slot and they
// jump to it, running exactly the same kernel binary as the BSP.
//
// What each AP does on arrival:
//   1. Point IA32_GS_BASE at its PerCpu slot
//   2. Enable the local APIC so it can receive IPIs + its timer
//   3. Flip is_online = 1 so the BSP's rendezvous can release
//   4. Park in HLT with IRQs on; next phase swaps this for a real
//      per-CPU scheduler idle loop
//
// All per-CPU data lives in a bss-resident [16]PerCpu array — no
// heap, so bring-up survives even if the kernel heap is pressured.
// Stacks are allocated through the page allocator (one 16 KiB slab
// per AP) because those are large and touched rarely at boot.

use "serial.cst"   as serial;
use "util.cst"     as util;
use "limine.cst"   as limine;
use "lapic.cst"    as lapic;
use "pmm.cst"      as pmm;
use "vmm.cst"      as vmm;
use "timer.cst"    as timer;
use "lock.cst"     as lock;
use "gdt.cst"      as gdt;
// IDT helpers are reached by symbol rather than `use` because
// idt.cst imports sched.cst which imports smp.cst — a `use` here
// would close that cycle. gdt.cst itself depends only on serial so
// we can import it normally and call install_tss_descriptor /
// load_tss directly.

// ============================================================
// Per-CPU layout
// ============================================================

let is i64 as MAX_CPUS = 16;
let is i64 as AP_STACK_SIZE = 0x4000;   // 16 KiB

struct PerCpu {
    self_ptr as i64;          // offset 0: points back at this PerCpu — enables
                              //           `mov rax, gs:[0]` to get the cpu base
    cpu_id as i64;            // 0..cpu_count-1 (0 = BSP by convention)
    lapic_id as i64;
    idle_stack_top as i64;    // high address; AP's RSP lands here after entry
    is_online as i64;         // all-i64 fields — caustic miscompiles mixed widths
    boot_done as i64;         // 1 after AP finished its first-time init

    // Per-CPU scheduler state. The shared runqueue (dl tree, band trees)
    // is covered by sched.sched_lock; these fields are the bits of
    // "what's running right now on THIS cpu" that must be per-CPU.
    current_tid as i64;       // tid executing on this cpu, -1 before first schedule()
    current_start_ns as i64;  // monotonic ns this cpu started running current_tid
    idle_tid as i64;          // this cpu's own idle thread (every cpu has one)
    fpu_owner_tid as i64;     // last thread to touch FPU on this cpu (FPU regs are per-cpu)
    need_resched as i64;      // set by this cpu's timer IRQ, observed by idle / schedule

    // Context-switch scratch. schedule() writes these before the asm
    // mov-rsp pair; they live in PerCpu so two cpus running schedule()
    // concurrently can't stomp each other's switch mid-flight.
    ctx_old_rsp_ptr as i64;   // where to stash outgoing rsp
    ctx_new_rsp as i64;       // incoming thread's saved rsp

    // Trampoline scratch. A brand-new thread's first call goes
    // through sched.thread_entry_trampoline which has to load the
    // thread's entry point into a register before `call rax`. A
    // module-level global here would race between cpus both
    // launching new threads concurrently (each overwrites the
    // other's read) — keep it per-cpu.
    trampoline_entry as i64;

    // `in_irq_context` has to be per-cpu: cpu A entering an IRQ
    // shouldn't have its flag cleared by cpu B exiting one. The
    // IDT stubs poke this slot via gs:[0x70] (raw bytes below —
    // caustic-as drops the gs prefix so the instruction goes in
    // as .byte). sched.cond_resched / preempt_enable read it via
    // smp.this_cpu_in_irq_context().
    in_irq_context as i64;

    // Same for preempt_count — disable/enable is a read-modify-
    // write, and a global would race between cpus even though
    // the intent is strictly per-cpu.
    preempt_count as i64;

    // Per-cpu heap-lock flag stash. heap.hirq_save pairs (take
    // heap_lock, save flags) with hirq_restore (release lock,
    // restore flags); pre-SMP the flags lived in a module global
    // that two cpus would stomp. A single i64 slot per cpu is
    // enough because heap's own control flow never nests two
    // hirq_save pairs at once on the same cpu.
    heap_saved_flags as i64;

    // SYSCALL/SYSRET shuttle (offsets 0x88, 0x90). syscall_entry
    // stashes user rsp here and pulls the kernel kstack out by
    // gs:[off] — keeping both per-cpu means the entry stub never
    // has to chase tid → thread → kstack while still in
    // user-mode-controlled register state.
    syscall_user_rsp as i64;
    syscall_kstack as i64;
}

let is [16]PerCpu as per_cpus with mut;
let is i64 as cpu_count with mut = 0;
let is i64 as bsp_cpu_id with mut = 0;
let is i64 as bsp_lapic_id with mut = 0;

// Serialises AP entry logging so the per-CPU "online" lines don't
// interleave in the serial output. Not strictly required for
// correctness, but it's the first real thing we lock so it doubles as
// a smoke test of the ticket lock.
let is lock.TicketLock as log_lock with mut;

// ============================================================
// MSR helpers — IA32_GS_BASE lets us install a per-CPU pointer that
// is readable via `mov rax, gs:[off]` instructions. swapgs shuttles
// between the kernel (GS_BASE) and user (KERNEL_GS_BASE) slots; for
// a kernel-only system we pin GS to the kernel value permanently
// using plain wrmsr, no swapgs needed.
// ============================================================

let is i64 as IA32_GS_BASE         = 0xC0000101;
let is i64 as IA32_KERNEL_GS_BASE  = 0xC0000102;

// Thin Caustic wrappers around smp_asm.s. For functions that return
// values we route through an out-pointer argument so the asm helper
// writes where the C caller wants — this avoids having to chase
// Caustic's compiler-chosen spill offsets for local variables. Args
// live in rdi/rsi at entry and the .s file relies on that.

fn wrmsr(msr as i64, value as i64) as void {
    asm("call smp_wrmsr\n");
}

fn load_cr3(pml4_phys as i64) as void {
    asm("call smp_load_cr3\n");
}

fn rdmsr_into(msr as i64, out as *i64) as void {
    asm("call smp_rdmsr_into\n");
}

fn rdmsr(msr as i64) as i64 {
    let is i64 as v with mut = 0;
    rdmsr_into(msr, &v);
    return v;
}

fn read_gs_self_into(out as *i64) as void {
    asm("call smp_read_gs_self_into\n");
}

fn current_cpu() as *PerCpu {
    let is i64 as v with mut = 0;
    read_gs_self_into(&v);
    return cast(*PerCpu, v);
}

fn current_cpu_id() as i64 {
    let is *PerCpu as p = current_cpu();
    if (cast(i64, p) == 0) { return 0; }
    return p.cpu_id;
}

// Per-CPU scheduler-state accessors. These are thin enough that the
// scheduler calls them by name — keeps the hot paths readable and
// isolates the PerCpu struct layout from sched.cst. All reads/writes
// happen on whichever cpu is currently executing, so there is no
// cross-cpu cache coherence concern here (each cpu owns its own slot).

fn this_cpu_current_tid() as i64 {
    let is *PerCpu as p = current_cpu();
    return p.current_tid;
}

fn this_cpu_set_current_tid(v as i64) as void {
    let is *PerCpu as p = current_cpu();
    p.current_tid = v;
}

fn this_cpu_current_start_ns() as i64 {
    let is *PerCpu as p = current_cpu();
    return p.current_start_ns;
}

fn this_cpu_set_current_start_ns(v as i64) as void {
    let is *PerCpu as p = current_cpu();
    p.current_start_ns = v;
}

fn this_cpu_idle_tid() as i64 {
    let is *PerCpu as p = current_cpu();
    return p.idle_tid;
}

fn this_cpu_set_idle_tid(v as i64) as void {
    let is *PerCpu as p = current_cpu();
    p.idle_tid = v;
}

// Read-only snapshot for SYS_CPU_STAT: how many CPUs, and whether CPU `i` is
// currently running a real thread (not its idle thread). A sampled view — the
// monitor averages it over time for a smooth %.
fn num_cpus() as i64 { return cpu_count; }
fn cpu_busy(i as i64) as i64 {
    if (i < 0 || i >= cpu_count) { return 0; }
    let is *PerCpu as p = get_per_cpu(i);
    if (p.is_online == 0) { return 0; }
    if (p.current_tid == p.idle_tid) { return 0; }
    if (p.current_tid == (0 - 1)) { return 0; }
    return 1;
}

fn this_cpu_fpu_owner_tid() as i64 {
    let is *PerCpu as p = current_cpu();
    return p.fpu_owner_tid;
}

fn this_cpu_set_fpu_owner_tid(v as i64) as void {
    let is *PerCpu as p = current_cpu();
    p.fpu_owner_tid = v;
}

fn this_cpu_need_resched() as i64 {
    let is *PerCpu as p = current_cpu();
    return p.need_resched;
}

fn this_cpu_set_need_resched(v as i64) as void {
    let is *PerCpu as p = current_cpu();
    p.need_resched = v;
}

// ctx_* are the scratch used during a context switch. `schedule()`
// stores the outgoing-rsp pointer and incoming-rsp value here and the
// asm sequence reads them by RIP-relative through a fixed symbol —
// keeping them in PerCpu means concurrent schedule() calls on two cpus
// don't trample each other's mid-switch state.

fn this_cpu_set_ctx_old_rsp_ptr(v as i64) as void {
    let is *PerCpu as p = current_cpu();
    p.ctx_old_rsp_ptr = v;
}

fn this_cpu_set_ctx_new_rsp(v as i64) as void {
    let is *PerCpu as p = current_cpu();
    p.ctx_new_rsp = v;
}

fn this_cpu_trampoline_entry() as i64 {
    let is *PerCpu as p = current_cpu();
    return p.trampoline_entry;
}

fn this_cpu_set_trampoline_entry(v as i64) as void {
    let is *PerCpu as p = current_cpu();
    p.trampoline_entry = v;
}

// Jump to `target` via a register-only indirection. Implemented in
// smp_asm.s because the sched trampoline can't use a module-level
// shuttle or a PerCpu slot as a function-pointer hand-off — both
// break when a thread is preempted after the set and resumed on a
// different cpu's PerCpu slot or after another thread overwrote the
// global. Caustic places the arg in rdi as per SysV; smp_call_ptr
// copies it to rax and calls. Rdi/rax are caller-saved but the IRQ
// stub push/pops them so preempt-through-this is safe.
fn call_ptr(target as i64) as void {
    asm("call smp_call_ptr\n");
}

fn this_cpu_in_irq_context() as i64 {
    let is *PerCpu as p = current_cpu();
    return p.in_irq_context;
}

fn this_cpu_set_in_irq_context(v as i64) as void {
    let is *PerCpu as p = current_cpu();
    p.in_irq_context = v;
}

fn this_cpu_preempt_count() as i64 {
    let is *PerCpu as p = current_cpu();
    return p.preempt_count;
}

fn this_cpu_set_preempt_count(v as i64) as void {
    let is *PerCpu as p = current_cpu();
    p.preempt_count = v;
}

fn this_cpu_heap_saved_flags() as i64 {
    let is *PerCpu as p = current_cpu();
    return p.heap_saved_flags;
}

fn this_cpu_set_heap_saved_flags(v as i64) as void {
    let is *PerCpu as p = current_cpu();
    p.heap_saved_flags = v;
}

fn set_per_cpu_kstack(cpu as i64, v as i64) as void {
    let is *PerCpu as p = get_per_cpu(cpu);
    if (cast(i64, p) == 0) { return; }
    p.syscall_kstack = v;
}


// ============================================================
// Stack allocation — one 16 KiB per-AP idle stack, carved from the
// page allocator at init time. Returns the top (high address) so the
// caller can write it into PerCpu.idle_stack_top and the AP can load
// it into RSP.
// ============================================================

fn alloc_idle_stack() as i64 {
    // AP_STACK_SIZE = 16384 = 4 pages, order = 2 (2^2 = 4).
    let is i32 as pfn = pmm.alloc_pages(
        pmm.ALLOC_ZERO,
        cast(i32, 2),
        pmm.USAGE_KERNEL,
        cast(i32, 0));
    if (pfn == pmm.PFN_NONE) { return 0; }
    let is i64 as phys = pmm.pfn_to_phys(pfn);
    let is i64 as base = phys + pmm.hhdm;
    // Stack grows down; top = base + size - 16 (leave 16-byte
    // alignment slack for ABI compliance on entry).
    return base + AP_STACK_SIZE - 16;
}

// IST1 stack — same size + alignment policy as the idle stack.
// Allocated once per cpu at boot, never freed. Used by IDT gates
// programmed with IST=1 (every exception vector after this lands).
// On entry, the cpu hardware switches RSP to the value stored in
// TSS.IST1 of the currently-loaded TSS. That gives exception
// handlers a clean stack so a primary fault can't cascade into a
// secondary fault that overwrites the original iretq frame —
// previously the cascade was masking the actual primary RIP under
// -smp 4.
fn alloc_ist_stack() as i64 {
    let is i32 as pfn = pmm.alloc_pages(
        pmm.ALLOC_ZERO,
        cast(i32, 2),                 // 4 pages = 16 KiB
        pmm.USAGE_KERNEL,
        cast(i32, 0));
    if (pfn == pmm.PFN_NONE) { return 0; }
    let is i64 as base = pmm.pfn_to_phys(pfn) + pmm.hhdm;
    return base + AP_STACK_SIZE - 16;
}

// Set up this cpu's TSS + IST1 stack and install the matching GDT
// descriptor. Caller does ltr afterwards.
fn setup_tss_for(cpu as i64) as void {
    let is i64 as ist1 = alloc_ist_stack();
    if (ist1 == 0) {
        // No memory for the IST stack — kernel can't start safely.
        // panic via pmm so we get a clear message instead of a
        // mysterious #DF later.
        pmm.panic("smp: ist1 alloc failed", 22);
    }
    gdt.ist1_top_set(cpu, ist1);
    gdt.tss_set_ist1(cpu, ist1);
    gdt.tss_set_iomap_base(cpu, gdt.TSS_SIZE);   // no I/O map
    gdt.install_tss_descriptor(cpu);
}

// ============================================================
// BSP init — called from _kernel_start after sched.init. Populates
// per_cpus[0] for the BSP and fires off each AP by writing our
// ap_entry function pointer into its Limine goto_address slot.
// ============================================================

fn install_gs_base(p as *PerCpu) as void {
    wrmsr(IA32_GS_BASE, cast(i64, p));
    // KERNEL_GS_BASE left untouched — writing it would only matter
    // once we implement syscall/sysret which swaps the two. Setting
    // it now triggered flaky behaviour on QEMU -smp 2 where a later
    // swapgs would have loaded garbage because we aren't paired
    // with a user-mode entry yet.
}

// Minimal BSP-side GS base install. Called very early, right after
// gdt.init, so IDT stubs can safely read per-cpu state through
// gs:[..] the moment sti fires. With GS.BASE left at 0, the first
// unrelated IRQ would have `mov rax, gs:[0x50]` load from physical
// address 0x50 — a guaranteed #PF. Populating per_cpus[0] with
// sentinel defaults keeps this_cpu_need_resched (and the idle_tid /
// fpu_owner_tid probes schedule() does later) well-defined until
// init() runs for real.
fn init_bsp_early() as void {
    per_cpus[0].self_ptr         = cast(i64, &per_cpus[0]);
    per_cpus[0].cpu_id           = 0;
    per_cpus[0].lapic_id         = 0;
    per_cpus[0].is_online        = 1;
    per_cpus[0].current_tid      = 0 - 1;
    per_cpus[0].current_start_ns = 0;
    per_cpus[0].idle_tid         = 0 - 1;
    per_cpus[0].fpu_owner_tid    = 0 - 1;
    per_cpus[0].need_resched     = 0;
    per_cpus[0].ctx_old_rsp_ptr  = 0;
    per_cpus[0].ctx_new_rsp      = 0;
    per_cpus[0].trampoline_entry = 0;
    per_cpus[0].in_irq_context   = 0;
    per_cpus[0].preempt_count    = 0;
    per_cpus[0].heap_saved_flags = 0;
    install_gs_base(&per_cpus[0]);
}

fn init() as void {
    let is *u8 as resp = limine.get_smp_response();
    if (cast(i64, resp) == 0) {
        serial.println("smp: no Limine SMP response — uniprocessor", 42);
        // BSP slot was already populated by init_bsp_early. Just
        // confirm we're the one-and-only.
        cpu_count = 1;
        return;
    }

    let is i64 as n with mut = limine.smp_resp_cpu_count(resp);
    if (n > MAX_CPUS) { n = MAX_CPUS; }
    cpu_count = n;
    bsp_lapic_id = limine.smp_resp_bsp_lapic(resp);

    lock.acquire(&log_lock);
    serial.print("smp: ", 5);      util.print_num(n);
    serial.print(" cpus (bsp lapic_id=", 20);
    util.print_num(bsp_lapic_id);
    serial.println(")", 1);
    lock.release(&log_lock);

    // Initialise every PerCpu slot up front so current_cpu() is
    // always pointing at a valid struct even on races.
    let is i64 as cpus_arr = limine.smp_resp_cpus(resp);
    let is *i64 as cpu_ptrs = cast(*i64, cpus_arr);
    let is i64 as i with mut = 0;
    while (i < n) {
        let is *u8 as info = cast(*u8, cpu_ptrs[i]);
        per_cpus[i].self_ptr         = cast(i64, &per_cpus[i]);
        per_cpus[i].cpu_id           = i;
        per_cpus[i].lapic_id         = limine.smp_info_lapic_id(info);
        per_cpus[i].idle_stack_top   = 0;
        per_cpus[i].is_online        = 0;
        per_cpus[i].boot_done        = 0;
        per_cpus[i].current_tid      = 0 - 1;
        per_cpus[i].current_start_ns = 0;
        per_cpus[i].idle_tid         = 0 - 1;
        per_cpus[i].fpu_owner_tid    = 0 - 1;
        per_cpus[i].need_resched     = 0;
        per_cpus[i].ctx_old_rsp_ptr  = 0;
        per_cpus[i].ctx_new_rsp      = 0;
        per_cpus[i].trampoline_entry = 0;
        per_cpus[i].in_irq_context   = 0;
        per_cpus[i].preempt_count    = 0;
        per_cpus[i].heap_saved_flags = 0;
        if (per_cpus[i].lapic_id == bsp_lapic_id) {
            bsp_cpu_id = i;
        }
        i = i + 1;
    }

    per_cpus[bsp_cpu_id].is_online = 1;
    per_cpus[bsp_cpu_id].boot_done = 1;
    install_gs_base(&per_cpus[bsp_cpu_id]);

    // Allocate this cpu's IST1 stack and install its TSS descriptor
    // before any IDT gate with IST=1 can fire. The BSP runs without
    // a TSS up to this point because the early IDT (idt.init) used
    // IST=0 — exceptions before now would land on the boot stack.
    // From here on every cpu has a dedicated exception stack.
    setup_tss_for(bsp_cpu_id);
    gdt.load_tss(bsp_cpu_id);

    // Kick every AP except ourselves. Writing the goto_address slot
    // makes Limine's trampoline loop exit and the AP jump to
    // ap_entry with RDI = its *LimineSmpInfo and our pre-allocated
    // stack in extra_argument.
    // Kicks must be serialised with AP startup — between writing
    // extra_argument and goto_address the AP could latch the goto
    // write and start executing before extra_argument is visible.
    // mfence after the extra_argument store gives the AP a
    // consistent view. lock.acquire on log_lock is unrelated
    // synchronisation — it ensures AP's "online" print doesn't race
    // with BSP's log output during bring-up.
    // AP stacks are Limine-provided at boot time. Once scheduler
    // SMP retrofit lands and APs actually run kernel code, they'll
    // migrate to their own per-CPU stacks (PerCpu.idle_stack_top is
    // reserved for that). For the HLT idle loop here Limine's is
    // enough.
    i = 0;
    while (i < n) {
        if (i != bsp_cpu_id) {
            let is *u8 as info = cast(*u8, cpu_ptrs[i]);
            limine.smp_info_set_extra(info, cast(i64, &per_cpus[i]));
            // mfence so the per_cpus + extra_argument stores are
            // globally visible before the AP's read of goto_address
            // releases it from Limine's spin loop.
            asm(".byte 0x0F, 0xAE, 0xF0\n");
            limine.smp_info_set_goto(info, cast(i64, fn_ptr(ap_entry)));
        }
        i = i + 1;
    }

    // Rendezvous: wait up to 2 s for every AP to flip is_online.
    let is i64 as deadline = timer.current_time_ns() + cast(i64, 2000000000);
    let is i32 as all_ok with mut = 0;
    while (all_ok == 0 && timer.current_time_ns() < deadline) {
        all_ok = 1;
        let is i64 as j with mut = 0;
        while (j < n) {
            if (per_cpus[j].is_online == 0) { all_ok = 0; j = n; }
            else                            { j = j + 1; }
        }
        asm(".byte 0xF3, 0x90\n");
    }

    let is i64 as online with mut = 0;
    let is i64 as k with mut = 0;
    while (k < n) {
        if (per_cpus[k].is_online == 1) { online = online + 1; }
        k = k + 1;
    }
    lock.acquire(&log_lock);
    serial.print("smp: ", 5); util.print_num(online);
    serial.print("/", 1);     util.print_num(n);
    serial.println(" cpus online", 12);
    lock.release(&log_lock);

    // Every cpu has now ltr'd its own TSS with a valid IST1
    // pointer. Re-tag the exception IDT gates to IST=1 so any
    // future #PF / #GP / #UD lands on a clean exception stack
    // instead of cascading on a corrupt thread kstack. Done last
    // so an early-boot fault still works against IST=0 / current
    // rsp before this commits.
    asm("call _kernel_arch_idt_cst_enable_ist_for_exceptions\n");
}

// ============================================================
// AP entry — first thing each AP runs after Limine releases it.
// ============================================================

fn ap_entry(info as *u8) as void {
    let is *PerCpu as me = cast(*PerCpu, limine.smp_info_get_extra(info));
    if (cast(i64, me) == 0) {
        while (1 == 1) { asm(".byte 0xF4\n"); }
    }

    // Step 1: move onto the kernel address space. Limine gave us a
    // pml4 that covers its trampoline + the kernel ELF, but not our
    // LAPIC MMIO mapping or any vmm_map_page allocations that happen
    // after vmm.init — the BSP does those against kas_pml4_phys, and
    // an AP running on Limine's pml4 would miss them.
    load_cr3(vmm.kas_pml4_phys);

    // PAT is a per-cpu MSR: program this AP's write-combining entry so the
    // WC framebuffer mapping behaves the same on every cpu (otherwise WC
    // would only hold on the BSP).
    vmm.pat_init();

    // Step 2: load our GDT. Intel's segment-selector caches are
    // per-cpu, so even though the descriptor table is shared, each
    // cpu has to lgdt it once to populate its own hidden state.
    // `mov gs, ax` inside ap_load clobbers GS.BASE to 0 — GS base is
    // re-armed immediately below.
    asm("call _kernel_arch_gdt_cst_ap_load\n");

    // Step 3: install per-cpu GS base AFTER gdt.ap_load so the mov
    // gs, ax in the segment reload doesn't overwrite what we just
    // wrote. Every this_cpu_* accessor and the gs:[0x50] need_resched
    // probe in IDT stubs rely on this being correct.
    install_gs_base(me);

    // Step 4: IDT. Same story as the GDT — gates are shared, IDTR
    // is per-cpu.
    asm("call _kernel_arch_idt_cst_ap_load\n");

    // Step 4b: TSS + IST1. The BSP set up its slot in init();
    // every AP allocates its own IST stack and installs its own
    // descriptor before ltr. Must happen BEFORE lapic.ap_init() so
    // any LAPIC error / spurious interrupt that fires during APIC
    // setup lands on the IST1 stack rather than overflowing the
    // tiny Limine bring-up stack we're still standing on.
    setup_tss_for(me.cpu_id);
    gdt.load_tss(me.cpu_id);

    // Step 5: local APIC — enable, pick the scheduler's timer
    // vector, program the first tick. From here on, this cpu gets
    // its own preemption IRQs on LAPIC vector 0x40.
    lapic.ap_init();

    lock.acquire(&log_lock);
    serial.print("smp: AP[", 8);      util.print_num(me.cpu_id);
    serial.print("] lapic_id=", 11);  util.print_num(me.lapic_id);
    serial.println(" online", 7);
    lock.release(&log_lock);

    me.is_online = 1;
    me.boot_done = 1;

    // Wait for the BSP to finish sched.init + create the initial
    // workload and flip sched_active=1 before we attempt to pick
    // the next thread on this AP — otherwise we'd race against a
    // half-built tid_ht / thread_cache / band trees.
    while (ap_wait_sched_active() == 0) {
        asm(".byte 0xF3, 0x90\n");   // pause
    }

    // Enter ap_start with IRQs still masked. sched.ap_start calls
    // per_cpu_init which creates this cpu's idle thread, publishes
    // it as current_tid, AND THEN drops into idle_fn which arms
    // sti+hlt itself. If we sti'd here before per_cpu_init ran,
    // a LAPIC timer tick landing in that window would call
    // schedule() on a cpu whose current_tid is still the -1
    // sentinel — schedule would "set_current_tid(next)" without
    // context-switching (because prev<0), orphaning `next` as
    // nominally-running on this cpu while the cpu actually
    // continues executing on Limine's stack. Observed as
    // intermittent #PF rip=0x282 / #GP rip=<garbage> a few ms
    // later when something else tries to use the corrupted state.
    asm("call _kernel_task_sched_cst_ap_start\n");

    // Unreachable; ap_start loops inside idle_fn. Keep a hlt so a
    // theoretical fallthrough doesn't spin the cpu 100%.
    while (1 == 1) {
        asm(".byte 0xF4\n");   // hlt
    }
}

// Thin shim around sched.is_active — called from the busy-wait above
// because we can't `use "sched.cst"` from here (sched already uses
// us). Shuttle pattern: call the external symbol, stash rax into a
// module-level scalar, read it back through a normal Caustic return.
let is i64 as ap_wait_shuttle with mut = 0;

fn ap_wait_sched_active() as i64 {
    asm("call _kernel_task_sched_cst_is_active\n");
    asm("lea rbx, [rip+_kernel_arch_smp_cst_ap_wait_shuttle]\n");
    asm("mov QWORD PTR [rbx], rax\n");
    return ap_wait_shuttle;
}

// ============================================================
// Accessors for callers who want to branch on topology.
// ============================================================

fn get_cpu_count() as i64 { return cpu_count; }
fn get_bsp_cpu_id() as i64 { return bsp_cpu_id; }

fn get_per_cpu(i as i64) as *PerCpu {
    if (i < 0 || i >= cpu_count) { return cast(*PerCpu, 0); }
    return &per_cpus[i];
}
