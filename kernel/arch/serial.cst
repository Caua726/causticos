// serial.cst — COM1 serial output for debug logging.
//
// Output is buffered per cpu and emitted one whole line at a time. That is
// not a performance choice; it is what makes the log readable and greppable
// under SMP.
//
// The lock below has always existed and has always been too small. It covers
// one CALL, but a line of output is several: print("fat32: mounted ") then
// print_num(n) then println(""). Between them another cpu takes the lock and
// writes its own line, and the two come out shredded together:
//
//     spec: irq line=fat32: mounted 1C1A sharing vector=U4S9T
//
// That was a real boot, working perfectly. Only the log was a lie. It also
// made every test marker a lottery — verify.sh would report "no-vfs" for a
// healthy boot whose "vfs: mounted /" happened to be interleaved — and the
// odds got worse with every thread added that talks.
//
// So each cpu accumulates into its own buffer and the UART only ever sees
// complete lines, written under the lock in one go. Callers change nothing.

use "port.cst" as port;
use "lock.cst" as lock;

let is i64 as COM1 = 0x3F8;

// ASCII control characters
let is i64 as CR = 13;
let is i64 as LF = 10;

// Serial output lock. Under SMP two cpus racing through putc each burn-wait
// on the UART LSR bit then both `outb` their byte, and the second write often
// lands before the first has latched. The lock now guards a whole line rather
// than a single byte.
let is lock.TicketLock as serial_lock with mut;

// Set by the panic path (pmm.panic_begin) once every other cpu has been told
// to stop. From then on output goes straight out without the lock: the cpu
// holding it may be one of the stopped ones, or the panicking cpu itself (a
// fault inside the logger), and waiting for it would turn a panic into a
// silent hang. Nothing else runs by then, so nothing else can interleave.
let is i64 as panic_mode with mut = 0;

fn enter_panic_mode() as void { panic_mode = 1; }

// The lock, or nothing at all in panic mode. LOCK_SKIPPED is no RFLAGS value
// (its reserved bits are zero), so it cannot collide with a real saved state.
let is i64 as LOCK_SKIPPED = 0 - 1;

fn out_lock() as i64 {
    if (panic_mode != 0) {
        asm("cli\n");
        return LOCK_SKIPPED;
    }
    return lock.acquire_irq(&serial_lock);
}

fn out_unlock(flags as i64) as void {
    if (flags == LOCK_SKIPPED) { return; }
    lock.release_irq(&serial_lock, flags);
}

// Per-cpu line buffers. A line longer than LINE_CAP flushes early and may
// interleave — 240 bytes is far past anything the kernel prints, and the
// degraded case is exactly today's behaviour, so overflow costs nothing that
// was not already being paid.
let is i64 as LINE_CAP = 240;
let is i64 as MAX_LINE_CPUS = 16;      // == smp.MAX_CPUS
let is [16]i64 as line_len with mut;
let is [3840]u8 as line_buf with mut;   // MAX_LINE_CPUS * LINE_CAP

// The last HIST_LINES complete lines, whoever printed them. The panic screen
// shows them: a machine that dies with its log only on a serial port nobody
// has attached tells its user nothing at all. Kept as text without the CRLF.
let is i64 as HIST_LINES = 20;
let is i64 as HIST_CAP = 120;
let is [2400]u8 as hist_buf with mut;    // HIST_LINES * HIST_CAP
let is [20]i64 as hist_len with mut;
let is i64 as hist_next with mut = 0;    // slot the next line goes into
let is i64 as hist_count with mut = 0;

// Caller holds serial_lock.
fn hist_record(c as i64) as void {
    let is i64 as n with mut = line_len[c];
    let is i64 as base = c * LINE_CAP;
    while (n > 0 && (line_buf[base + n - 1] == cast(u8, CR) || line_buf[base + n - 1] == cast(u8, LF))) {
        n = n - 1;
    }
    if (n > HIST_CAP) { n = HIST_CAP; }
    let is i64 as slot = hist_next;
    let is i64 as i with mut = 0;
    while (i < n) {
        hist_buf[slot * HIST_CAP + i] = line_buf[base + i];
        i = i + 1;
    }
    hist_len[slot] = n;
    hist_next = (slot + 1) % HIST_LINES;
    if (hist_count < HIST_LINES) { hist_count = hist_count + 1; }
}

// Line k of the history, oldest first (k < history_count()). Copies at most
// HIST_CAP bytes into out and returns the length. No lock: it is read by the
// panic path after every other cpu has been stopped.
fn history_count() as i64 { return hist_count; }
fn history_line(k as i64, out as *u8) as i64 {
    if (k < 0 || k >= hist_count) { return 0; }
    let is i64 as slot = (hist_next - hist_count + k + HIST_LINES) % HIST_LINES;
    let is i64 as n = hist_len[slot];
    let is i64 as i with mut = 0;
    while (i < n) { out[i] = hist_buf[slot * HIST_CAP + i]; i = i + 1; }
    return n;
}

// Which cpu is speaking. Injected rather than imported: smp.cst logs through
// this module, so a `use` here would be a cycle, and serial.init() runs before
// the per-cpu areas exist anyway. Until main.cst wires it up, everything is
// cpu 0 — which is true, because only the BSP is running by then.
let is i64 as cpu_id_fn with mut = 0;

fn set_cpu_id_fn(f as i64) as void {
    cpu_id_fn = f;
    return;
}

fn which_cpu() as i64 {
    if (cpu_id_fn == 0) { return 0; }
    let is i64 as c = call(cast(fn() as i64, cpu_id_fn));
    if (c < 0 || c >= MAX_LINE_CPUS) { return 0; }
    return c;
}

fn init() as void {
    port.outb(COM1 + 1, 0);    // disable interrupts
    port.outb(COM1 + 3, 0x80); // enable DLAB (set baud divisor)
    port.outb(COM1 + 0, 1);    // divisor 1 = 115200 baud
    port.outb(COM1 + 1, 0);    // divisor hi byte
    port.outb(COM1 + 3, 0x03); // 8 bits, no parity, one stop bit
    port.outb(COM1 + 2, 0xC7); // enable FIFO, clear, 14-byte threshold
    port.outb(COM1 + 4, 0x0B); // MCR: DTR + RTS + OUT2
    let is i64 as i with mut = 0;
    while (i < MAX_LINE_CPUS) { line_len[i] = 0; i = i + 1; }
}

// Raw byte emitter — no lock, no buffer. The caller owns serial_lock.
fn putc_raw(ch as i64) as void {
    let is i64 as tx_ready with mut = 0;
    while (tx_ready == 0) {
        tx_ready = port.inb(COM1 + 5) & 0x20;
    }
    port.outb(COM1, ch);
}

// Push one cpu's buffer to the UART. Caller holds serial_lock.
fn flush_locked(c as i64) as void {
    let is i64 as n = line_len[c];
    let is i64 as base = c * LINE_CAP;
    let is i64 as i with mut = 0;
    while (i < n) {
        putc_raw(cast(i64, line_buf[base + i]));
        i = i + 1;
    }
    line_len[c] = 0;
    return;
}

// Append one byte, flushing on newline or when the buffer is full. Runs with
// interrupts off: an IRQ handler that logs would otherwise land in the middle
// of the line this cpu is building.
fn emit(ch as i64) as void {
    let is i64 as flags = out_lock();
    let is i64 as c = which_cpu();
    if (ch == LF) {
        // Normalise to CRLF at the boundary, so callers keep writing '\n'.
        if (line_len[c] < LINE_CAP) {
            line_buf[c * LINE_CAP + line_len[c]] = cast(u8, CR);
            line_len[c] = line_len[c] + 1;
        }
        if (line_len[c] < LINE_CAP) {
            line_buf[c * LINE_CAP + line_len[c]] = cast(u8, LF);
            line_len[c] = line_len[c] + 1;
        }
        hist_record(c);
        flush_locked(c);
    } else if (ch != CR) {
        line_buf[c * LINE_CAP + line_len[c]] = cast(u8, ch);
        line_len[c] = line_len[c] + 1;
        if (line_len[c] >= LINE_CAP) { flush_locked(c); }
    }
    out_unlock(flags);
    return;
}

fn putc(ch as i64) as void {
    emit(ch);
}

fn print(str as *u8, len as i64) as void {
    let is i64 as i with mut = 0;
    while (i < len) {
        emit(cast(i64, str[i]));
        i = i + 1;
    }
}

fn println(str as *u8, len as i64) as void {
    let is i64 as i with mut = 0;
    while (i < len) {
        emit(cast(i64, str[i]));
        i = i + 1;
    }
    emit(LF);
}

// Push whatever this cpu has half-written. A panic must call this: the most
// important line the kernel ever prints is the one it dies on, and it would
// otherwise sit in a buffer nobody flushes.
fn flush() as void {
    let is i64 as flags = out_lock();
    flush_locked(which_cpu());
    out_unlock(flags);
    return;
}

// Panic path: dump every cpu's partial line, not just this one. Whatever the
// other cpus were saying when the world stopped is evidence.
fn flush_all() as void {
    let is i64 as flags = out_lock();
    let is i64 as i with mut = 0;
    while (i < MAX_LINE_CPUS) {
        if (line_len[i] > 0) {
            flush_locked(i);
            putc_raw(CR);
            putc_raw(LF);
        }
        i = i + 1;
    }
    out_unlock(flags);
    return;
}
