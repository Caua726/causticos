// serial.cst — COM1 serial output for debug logging

use "port.cst" as port;
use "lock.cst" as lock;

let is i64 as COM1 = 0x3F8;

// ASCII control characters
let is i64 as CR = 13;
let is i64 as LF = 10;

// Serial output lock. Under SMP, two cpus racing through putc each
// burn-wait on the UART LSR bit then both `outb` their byte — the
// second write often lands before the first byte has latched, so
// lines get interleaved byte-wise. Beyond garbled logs, a partially-
// buffered fault message makes remote debugging impossible. The lock
// serialises the whole line in print/println so one cpu owns the
// UART end-to-end. putc (single-byte) grabs the same lock so ad-hoc
// callers can't bypass.
let is lock.TicketLock as serial_lock with mut;

fn init() as void {
    port.outb(COM1 + 1, 0);    // disable interrupts
    port.outb(COM1 + 3, 0x80); // enable DLAB (set baud divisor)
    port.outb(COM1 + 0, 1);    // divisor 1 = 115200 baud
    port.outb(COM1 + 1, 0);    // divisor hi byte
    port.outb(COM1 + 3, 0x03); // 8 bits, no parity, one stop bit
    port.outb(COM1 + 2, 0xC7); // enable FIFO, clear, 14-byte threshold
    port.outb(COM1 + 4, 0x0B); // MCR: DTR + RTS + OUT2
}

// Raw byte emitter — no lock. Callers that own serial_lock use this
// directly; putc/print/println wrap the locked path.
fn putc_raw(ch as i64) as void {
    let is i64 as tx_ready with mut = 0;
    while (tx_ready == 0) {
        tx_ready = port.inb(COM1 + 5) & 0x20;
    }
    port.outb(COM1, ch);
}

// ── Composing one message out of several calls ──────────────────────
//
// The lock above makes each CALL atomic, not each MESSAGE — and most messages
// worth reading are several calls:
//
//     serial.print("root: ", 6);
//     while (...) { serial.putc(name[i]); }      // one lock per character
//     serial.println(" (live, volatile)", 17);
//
// Under SMP another cpu takes the lock between those calls and its bytes land
// in the middle, so "root: ram0" reaches the log as "0r0a0m000". That is not
// only a cosmetic problem: it makes a boot log unreliable exactly when there is
// more than one cpu to debug.
//
// begin() takes the lock and hands back the interrupt flags; everything printed
// between begin() and end() must use the _raw emitters, which do not re-take it
// (TicketLock is not recursive — calling print() inside would deadlock the cpu
// against itself).
//
//     let is i64 as f = serial.begin();
//     serial.print_raw("root: ", 6);
//     ...
//     serial.endln(f);
fn begin() as i64 {
    return lock.acquire_irq(&serial_lock);
}

fn end(flags as i64) as void {
    lock.release_irq(&serial_lock, flags);
}

// Close the message with a newline, which is what a caller almost always wants.
fn endln(flags as i64) as void {
    putc_raw(CR);
    putc_raw(LF);
    lock.release_irq(&serial_lock, flags);
}

// Unlocked emitters, for use between begin() and end().
fn print_raw(str as *u8, len as i64) as void {
    let is i64 as i with mut = 0;
    while (i < len) {
        putc_raw(cast(i64, str[i]));
        i = i + 1;
    }
}

// A zero-terminated string, bounded so a corrupt pointer cannot print forever.
fn print_cstr_raw(str as *u8, max as i64) as void {
    if (cast(i64, str) == 0) { return; }
    let is i64 as i with mut = 0;
    while (i < max && str[i] != cast(u8, 0)) {
        putc_raw(cast(i64, str[i]));
        i = i + 1;
    }
}

// Unsigned decimal, unlocked. util.print_num would re-take the lock.
fn print_num_raw(n as i64) as void {
    if (n == 0) { putc_raw(48); return; }
    let is i64 as v with mut = n;
    if (v < 0) { putc_raw(45); v = 0 - v; }
    let is [24]u8 as buf with mut;
    let is i64 as len with mut = 0;
    while (v > 0) {
        buf[len] = cast(u8, 48 + (v % 10));
        v = v / 10;
        len = len + 1;
    }
    while (len > 0) {
        len = len - 1;
        putc_raw(cast(i64, buf[len]));
    }
}

fn putc(ch as i64) as void {
    let is i64 as flags = lock.acquire_irq(&serial_lock);
    putc_raw(ch);
    lock.release_irq(&serial_lock, flags);
}

fn print(str as *u8, len as i64) as void {
    let is i64 as flags = lock.acquire_irq(&serial_lock);
    let is i64 as i with mut = 0;
    while (i < len) {
        putc_raw(cast(i64, str[i]));
        i = i + 1;
    }
    lock.release_irq(&serial_lock, flags);
}

fn println(str as *u8, len as i64) as void {
    let is i64 as flags = lock.acquire_irq(&serial_lock);
    let is i64 as i with mut = 0;
    while (i < len) {
        putc_raw(cast(i64, str[i]));
        i = i + 1;
    }
    putc_raw(CR);
    putc_raw(LF);
    lock.release_irq(&serial_lock, flags);
}
