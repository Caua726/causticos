// idt.cst — Interrupt Descriptor Table

use "serial.cst" as serial;
use "port.cst" as port;
use "timer.cst" as timer;
use "sched.cst" as sched;
use "lapic.cst" as lapic;
use "vmm.cst" as vmm;
use "vma.cst" as vma;

// ============================================================
// IDT entries — 256 entries, each 16 bytes = 4096 bytes
// ============================================================

let is [4096]u8 as idt_data;

// IDTR: 2 bytes limit + 8 bytes base
let is i64 as idtr_lo with mut = 0;
let is i64 as idtr_hi with mut = 0;

// ISR stub addresses — filled by install_stubs()
// Layout (indices):
//   0-18    exceptions 0-18
//   19-34   PIC IRQs 0-15 (vectors 32-47)
//   35      LAPIC timer  (vector 64)
//   36      driver IRQ   (vector 48)
let is [64]i64 as isr_addrs;

// IRQ debug counter
let is i64 as irq_count with mut = 0;

// ============================================================
// Set an IDT entry
// ============================================================

fn set_gate(vector as i64, handler as i64, selector as i64, ist as i64, type_attr as i64) as void {
    let is i64 as off = vector * 16;
    let is *u8 as entry = cast(*u8, cast(i64, &idt_data) + off);

    entry[0] = cast(u8, handler & 0xFF);
    entry[1] = cast(u8, (handler >> 8) & 0xFF);
    entry[2] = cast(u8, selector & 0xFF);
    entry[3] = cast(u8, (selector >> 8) & 0xFF);
    entry[4] = cast(u8, ist & 0x07);
    entry[5] = cast(u8, type_attr);
    entry[6] = cast(u8, (handler >> 16) & 0xFF);
    entry[7] = cast(u8, (handler >> 24) & 0xFF);
    entry[8] = cast(u8, (handler >> 32) & 0xFF);
    entry[9] = cast(u8, (handler >> 40) & 0xFF);
    entry[10] = cast(u8, (handler >> 48) & 0xFF);
    entry[11] = cast(u8, (handler >> 56) & 0xFF);
    entry[12] = 0;
    entry[13] = 0;
    entry[14] = 0;
    entry[15] = 0;
}

// Re-tag the IST field of every exception gate to IST=1. Called by
// smp.init() after all cpus have ltr'd their TSS — until then we
// leave IST=0 (use current rsp) so an exception during early
// pmm/heap/vmm bring-up doesn't fault on a missing TSS slot. After
// this runs, any exception (vectors 0..18) hardware-switches RSP to
// TSS.IST1 of the firing cpu, which gives the handler a clean stack
// no matter how badly the faulting thread's kstack was scribbled
// over. Closes the cascading-fault path that was masking the
// primary corruption signature on -smp 4.
fn enable_ist_for_exceptions() as void {
    let is i64 as v with mut = 0;
    while (v <= 18) {
        let is *u8 as entry = cast(*u8, cast(i64, &idt_data) + v * 16);
        entry[4] = cast(u8, 1);   // IST=1
        v = v + 1;
    }
}

// ============================================================
// PIC
// ============================================================

fn remap_pic() as void {
    port.outb(0x20, 0x11);
    port.outb(0xA0, 0x11);
    port.outb(0x21, 32);
    port.outb(0xA1, 40);
    port.outb(0x21, 4);
    port.outb(0xA1, 2);
    port.outb(0x21, 0x01);
    port.outb(0xA1, 0x01);
    port.outb(0x21, 0xFF);
    port.outb(0xA1, 0xFF);
}

fn pic_eoi(irq as i64) as void {
    if (irq >= 8) {
        port.outb(0xA0, 0x20);
    }
    port.outb(0x20, 0x20);
}

fn pic_unmask(irq as i64) as void {
    if (irq < 8) {
        let is i64 as mask = port.inb(0x21);
        let is i64 as bit = 1 << irq;
        let is i64 as inv = bit ^ 0xFF;
        port.outb(0x21, mask & inv);
    } else {
        let is i64 as mask = port.inb(0xA1);
        let is i64 as bit = 1 << (irq - 8);
        let is i64 as inv = bit ^ 0xFF;
        port.outb(0xA1, mask & inv);
    }
}

// ============================================================
// Handlers (called from asm with proper ABI)
// ============================================================

fn exception_handler(vector as i64, error_code as i64, rip as i64,
                     fault_rsp as i64, cs as i64, rflags as i64) as void {
    // #NM (7) = Device Not Available — lazy FPU restore, not a real fault
    if (vector == 7) {
        sched.handle_nm_fault();
        return;
    }

    // #PF (14): route through the L4 policy seam BEFORE the generic kill/panic.
    // CR2 (the faulting linear address) holds its value until the next #PF, so
    // capture it as the FIRST op of this branch — before any call that could
    // itself fault and overwrite it. Today policy #0 (strict) returns fatal for
    // every fault (eager mmap has no fill path), so this falls through to the
    // existing kill/panic unchanged — only now cr2 is in the log. Phase E makes
    // mem_handle_fault return 0 for a serviced fault (iretq re-runs the insn).
    let is i64 as fault_cr2 with mut = 0;
    if (vector == 14) {
        fault_cr2 = vmm.read_cr2();
        let is i32 as rc = vma.mem_handle_fault(fault_cr2, error_code, rip, fault_rsp, cs);
        if (rc == cast(i32, 0)) { return; }
    }

    let is i32 as from_user with mut = 0;
    if ((cs & 3) == 3) { from_user = 1; }

    if (from_user == 1) {
        // User-mode fault. Log under a non-"EXCEPTION" prefix so
        // verify.sh's panic-detector doesn't flag it as a kernel
        // failure — the fault is per-thread and the kernel keeps
        // running. Future signals work plugs in here; for now we
        // kill the thread and reschedule.
        serial.println("", 0);
        serial.print("user-fault: vec=", 16);
        print_num(vector);
        serial.print(" err=", 5);
        print_num(error_code);
        serial.print(" rip=", 5);
        print_hex(rip);
        serial.print(" cs=", 4);
        print_hex(cs);
        if (vector == 14) {
            serial.print(" cr2=", 5);
            print_hex(fault_cr2);
        }
        serial.println(" — killing thread", 17);
        sched.exit_current_thread();
        // exit_current_thread never returns — it schedules another
        // thread on this cpu. We don't fall through.
        while (1 == 1) { asm(".byte 0xF4\n"); }
    }

    serial.println("", 0);
    serial.print("EXCEPTION #", 11);
    print_num(vector);
    serial.print(" err=", 5);
    print_num(error_code);
    serial.print(" rip=", 5);
    print_hex(rip);
    serial.print(" rsp=", 5);
    print_hex(fault_rsp);
    serial.print(" cs=", 4);
    print_hex(cs);
    if (vector == 14) {
        serial.print(" cr2=", 5);
        print_hex(fault_cr2);
    }
    serial.println(" (kernel)", 9);

    // Kernel-mode fault. Dump a few words from the kstack so the
    // caller chain is recoverable from the serial log when post-
    // mortem debugging.
    if (fault_rsp >= 0xFFFF800000000000) {
        let is *i64 as sp = cast(*i64, fault_rsp);
        let is i64 as i with mut = 0;
        while (i < 8) {
            serial.print("  [rsp+", 7);
            print_num(i * 8);
            serial.print("]=", 2);
            print_hex(sp[i]);
            serial.println("", 0);
            i = i + 1;
        }
    }

    asm("cli\n");
    while (1 == 1) {
        asm(".byte 0xF4\n");
    }
}

fn irq_handler(irq as i64) as void {
    if (irq == 0) {
        // PIT tick — used for early boot + LAPIC calibration
        timer.on_tick();
        if (lapic.calibrated == 0) {
            lapic.pit_calibration_irq();
        }
        if (timer.using_lapic == 0) {
            sched.on_timer_tick();
        }
    }
    pic_eoi(irq);
}

// Reschedule IPI handler — called from vector 0x41 (65). The sender
// set our PerCpu.need_resched = 1 before sending the IPI, so all we
// need to do here is ack the LAPIC; the IDT stub's shared tail
// checks gs:[0x50] and calls schedule(). Reusing the LAPIC-timer
// stub trampoline means we don't have to duplicate the 15-GPR
// save/restore — just point the IDT gate at the same stub.
fn resched_ipi_handler() as void {
    lapic.eoi();
}

// TLB-shootdown IPI handler — called from vector 0x42 (66). The stub already
// reloaded CR3 (flushing this cpu's non-global TLB) in pure asm BEFORE calling
// us, so we only ack (the initiator counts acks) and EOI. The flush is inline
// in the stub on purpose: vmm.flush_tlb_full routes through read_cr3's shared
// global shuttle, which two cpus flushing at once would corrupt — a register-
// only `mov rax,cr3; mov cr3,rax` has no shared state.
fn tlb_shootdown_handler() as void {
    sched.tlb_shootdown_ack();
    lapic.eoi();
}

// LAPIC timer handler — called from vector 0x40 (64)
fn lapic_timer_handler() as void {
    timer.on_lapic_tick();
    sched.on_timer_tick();
    // Re-arm the LAPIC timer with a plain quantum-length tick. We
    // deliberately do NOT call sched.program_next_tick() here:
    // that function reads the deadline RB tree and scans thread
    // state, which is unsafe without sched_lock (another cpu may
    // be mid-insert). A fixed quantum is always safe — just a MSR
    // write, no shared reads. If schedule() subsequently runs it
    // will reprogram with the deadline-aware delta under the
    // lock. Worst case: one redundant tick a few ms earlier than
    // optimal, immediately corrected by schedule().
    lapic.program_tick_ns(sched.quantum_ns);
    lapic.eoi();
}

// ============================================================
// Number printing
// ============================================================

fn print_num(n as i64) as void {
    if (n == 0) {
        serial.putc(48);
        return;
    }
    let is [20]u8 as buf;
    let is i64 as val with mut = n;
    let is i64 as pos with mut = 19;
    while (val > 0) {
        buf[pos] = cast(u8, (val % 10) + 48);
        val = val / 10;
        pos = pos - 1;
    }
    let is i64 as start with mut = pos + 1;
    while (start < 20) {
        serial.putc(cast(i64, buf[start]));
        start = start + 1;
    }
}

fn print_hex(n as i64) as void {
    serial.putc(48);
    serial.putc(120);
    let is [16]u8 as buf;
    let is i64 as val with mut = n;
    let is i64 as i with mut = 15;
    while (i >= 0) {
        let is i64 as digit = val & 0xF;
        if (digit < 10) {
            buf[i] = cast(u8, digit + 48);
        } else {
            buf[i] = cast(u8, digit + 87);
        }
        val = val >> 4;
        i = i - 1;
    }
    i = 0;
    while (i < 16) {
        serial.putc(cast(i64, buf[i]));
        i = i + 1;
    }
}

// ============================================================
// Install ISR/IRQ stub addresses into the isr_addrs table.
// Each stub is emitted as raw asm with a label.
// We use lea to capture each label's address.
// ============================================================

fn install_stubs() as void {
    // Jump past all stubs
    asm("jmp .Lstubs_end\n");

    // --- Exception common handler ---
    asm(".Lisr_common:\n");
    asm("push r15\n"); asm("push r14\n"); asm("push r13\n"); asm("push r12\n");
    asm("push r11\n"); asm("push r10\n"); asm("push r9\n");  asm("push r8\n");
    asm("push rbp\n"); asm("push rdi\n"); asm("push rsi\n"); asm("push rdx\n");
    asm("push rcx\n"); asm("push rbx\n"); asm("push rax\n");
    // 15 GPRs = 120 bytes pushed
    // [rsp+120]=vector [128]=errcode [136]=RIP [144]=CS [152]=RFLAGS [160]=RSP [168]=SS
    asm("mov rdi, QWORD PTR [rsp+120]\n");
    asm("mov rsi, QWORD PTR [rsp+128]\n");
    asm("mov rdx, QWORD PTR [rsp+136]\n");
    asm("mov rcx, QWORD PTR [rsp+160]\n");
    asm("mov r8,  QWORD PTR [rsp+144]\n");      // CS — handler uses (cs & 3) to detect user mode
    asm("mov r9,  QWORD PTR [rsp+152]\n");      // RFLAGS (currently unused; reserved for fault-fixup)
    asm("mov rbp, rsp\n");
    asm("and rsp, -16\n");
    asm("call _kernel_arch_idt_cst_exception_handler\n");
    asm("mov rsp, rbp\n");
    // SYSRET leaves the user SS selector at RPL 0 (0x20) — STAR forces
    // CS.RPL=3 but NOT SS.RPL. A later interrupt from ring 3 pushes that
    // SS=0x20, and iretq back to CPL 3 then fails the SS.RPL==CPL check on
    // strict cores (KVM/real hw → #GP err=0x20; TCG tolerates it). Force the
    // saved SS to RPL 3 when this frame returns to user. rax is scratch here:
    // the `pop rax` immediately below overwrites it with the real user rax.
    // Offsets: 15 GPRs(120) + vector(8) + errcode(8) below the hw frame.
    asm("mov rax, QWORD PTR [rsp+144]\n");   // CS
    asm("and rax, 3\n");
    asm("cmp rax, 3\n");
    asm("jne .Lisr_ss_ok\n");
    asm("mov rax, QWORD PTR [rsp+168]\n");    // SS
    asm("or rax, 3\n");
    asm("mov QWORD PTR [rsp+168], rax\n");
    asm(".Lisr_ss_ok:\n");
    asm("pop rax\n"); asm("pop rbx\n"); asm("pop rcx\n"); asm("pop rdx\n");
    asm("pop rsi\n"); asm("pop rdi\n"); asm("pop rbp\n");
    asm("pop r8\n");  asm("pop r9\n");  asm("pop r10\n"); asm("pop r11\n");
    asm("pop r12\n"); asm("pop r13\n"); asm("pop r14\n"); asm("pop r15\n");
    asm("add rsp, 16\n");
    asm(".byte 0x48, 0xCF\n");     // iretq

    // --- IRQ common handler ---
    asm(".Lirq_common:\n");
    asm("push r15\n"); asm("push r14\n"); asm("push r13\n"); asm("push r12\n");
    asm("push r11\n"); asm("push r10\n"); asm("push r9\n");  asm("push r8\n");
    asm("push rbp\n"); asm("push rdi\n"); asm("push rsi\n"); asm("push rdx\n");
    asm("push rcx\n"); asm("push rbx\n"); asm("push rax\n");
    // Set in_irq_context = 1
    asm(".byte 0x65, 0x48, 0xC7, 0x04, 0x25, 0x70, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00\n");    // mov QWORD PTR gs:[0x70], 1 (smp.PerCpu.in_irq_context)
    // 15 GPRs = 120 bytes; [rsp+120]=IRQ number
    asm("mov rdi, QWORD PTR [rsp+120]\n");
    asm("mov rbp, rsp\n");
    asm("and rsp, -16\n");
    asm("call _kernel_arch_idt_cst_irq_handler\n");
    asm("mov rsp, rbp\n");
    // Clear in_irq_context = 0
    asm(".byte 0x65, 0x48, 0xC7, 0x04, 0x25, 0x70, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00\n");    // mov QWORD PTR gs:[0x70], 0 (smp.PerCpu.in_irq_context)
    // Check need_resched before returning from IRQ (§11.1)
    asm(".byte 0x65, 0x48, 0x8B, 0x04, 0x25, 0x50, 0x00, 0x00, 0x00\n");    // mov rax, QWORD PTR gs:[0x50] (smp.PerCpu.need_resched)
    asm("test rax, rax\n");
    asm("jz .Lirq_no_resched\n");
    // Call schedule() — context switch may happen here
    // When this thread is resumed, schedule returns, we pop regs and iretq
    asm("mov rbp, rsp\n");
    asm("and rsp, -16\n");
    asm("call _kernel_task_sched_cst_schedule\n");
    asm("mov rsp, rbp\n");
    asm(".Lirq_no_resched:\n");
    // Force user SS to RPL 3 (see the .Lisr_common note). 15 GPRs(120) +
    // vector(8) below the hw frame → CS=[rsp+136], SS=[rsp+160].
    asm("mov rax, QWORD PTR [rsp+136]\n");   // CS
    asm("and rax, 3\n");
    asm("cmp rax, 3\n");
    asm("jne .Lirq_ss_ok\n");
    asm("mov rax, QWORD PTR [rsp+160]\n");    // SS
    asm("or rax, 3\n");
    asm("mov QWORD PTR [rsp+160], rax\n");
    asm(".Lirq_ss_ok:\n");
    asm("pop rax\n"); asm("pop rbx\n"); asm("pop rcx\n"); asm("pop rdx\n");
    asm("pop rsi\n"); asm("pop rdi\n"); asm("pop rbp\n");
    asm("pop r8\n");  asm("pop r9\n");  asm("pop r10\n"); asm("pop r11\n");
    asm("pop r12\n"); asm("pop r13\n"); asm("pop r14\n"); asm("pop r15\n");
    asm("add rsp, 8\n");
    asm(".byte 0x48, 0xCF\n");    // iretq

    // --- Exception stubs (push imm8 = 0x6A,N — caustic-as drops push imm) ---
    asm(".Lisr0:\n");  asm(".byte 0x6A,0\n"); asm(".byte 0x6A,0\n");  asm("jmp .Lisr_common\n");
    asm(".Lisr1:\n");  asm(".byte 0x6A,0\n"); asm(".byte 0x6A,1\n");  asm("jmp .Lisr_common\n");
    asm(".Lisr2:\n");  asm(".byte 0x6A,0\n"); asm(".byte 0x6A,2\n");  asm("jmp .Lisr_common\n");
    asm(".Lisr3:\n");  asm(".byte 0x6A,0\n"); asm(".byte 0x6A,3\n");  asm("jmp .Lisr_common\n");
    asm(".Lisr4:\n");  asm(".byte 0x6A,0\n"); asm(".byte 0x6A,4\n");  asm("jmp .Lisr_common\n");
    asm(".Lisr5:\n");  asm(".byte 0x6A,0\n"); asm(".byte 0x6A,5\n");  asm("jmp .Lisr_common\n");
    asm(".Lisr6:\n");  asm(".byte 0x6A,0\n"); asm(".byte 0x6A,6\n");  asm("jmp .Lisr_common\n");
    asm(".Lisr7:\n");  asm(".byte 0x6A,0\n"); asm(".byte 0x6A,7\n");  asm("jmp .Lisr_common\n");
    asm(".Lisr8:\n");  asm(".byte 0x6A,8\n");  asm("jmp .Lisr_common\n");
    asm(".Lisr9:\n");  asm(".byte 0x6A,0\n"); asm(".byte 0x6A,9\n");  asm("jmp .Lisr_common\n");
    asm(".Lisr10:\n"); asm(".byte 0x6A,10\n"); asm("jmp .Lisr_common\n");
    asm(".Lisr11:\n"); asm(".byte 0x6A,11\n"); asm("jmp .Lisr_common\n");
    asm(".Lisr12:\n"); asm(".byte 0x6A,12\n"); asm("jmp .Lisr_common\n");
    asm(".Lisr13:\n"); asm(".byte 0x6A,13\n"); asm("jmp .Lisr_common\n");
    asm(".Lisr14:\n"); asm(".byte 0x6A,14\n"); asm("jmp .Lisr_common\n");
    asm(".Lisr15:\n"); asm(".byte 0x6A,0\n"); asm(".byte 0x6A,15\n"); asm("jmp .Lisr_common\n");
    asm(".Lisr16:\n"); asm(".byte 0x6A,0\n"); asm(".byte 0x6A,16\n"); asm("jmp .Lisr_common\n");
    asm(".Lisr17:\n"); asm(".byte 0x6A,17\n"); asm("jmp .Lisr_common\n");
    asm(".Lisr18:\n"); asm(".byte 0x6A,0\n"); asm(".byte 0x6A,18\n"); asm("jmp .Lisr_common\n");

    // --- IRQ stubs ---
    asm(".Lirq0:\n");  asm(".byte 0x6A,0\n");  asm("jmp .Lirq_common\n");
    asm(".Lirq1:\n");  asm(".byte 0x6A,1\n");  asm("jmp .Lirq_common\n");
    asm(".Lirq2:\n");  asm(".byte 0x6A,2\n");  asm("jmp .Lirq_common\n");
    asm(".Lirq3:\n");  asm(".byte 0x6A,3\n");  asm("jmp .Lirq_common\n");
    asm(".Lirq4:\n");  asm(".byte 0x6A,4\n");  asm("jmp .Lirq_common\n");
    asm(".Lirq5:\n");  asm(".byte 0x6A,5\n");  asm("jmp .Lirq_common\n");
    asm(".Lirq6:\n");  asm(".byte 0x6A,6\n");  asm("jmp .Lirq_common\n");
    asm(".Lirq7:\n");  asm(".byte 0x6A,7\n");  asm("jmp .Lirq_common\n");
    asm(".Lirq8:\n");  asm(".byte 0x6A,8\n");  asm("jmp .Lirq_common\n");
    asm(".Lirq9:\n");  asm(".byte 0x6A,9\n");  asm("jmp .Lirq_common\n");
    asm(".Lirq10:\n"); asm(".byte 0x6A,10\n"); asm("jmp .Lirq_common\n");
    asm(".Lirq11:\n"); asm(".byte 0x6A,11\n"); asm("jmp .Lirq_common\n");
    asm(".Lirq12:\n"); asm(".byte 0x6A,12\n"); asm("jmp .Lirq_common\n");
    asm(".Lirq13:\n"); asm(".byte 0x6A,13\n"); asm("jmp .Lirq_common\n");
    asm(".Lirq14:\n"); asm(".byte 0x6A,14\n"); asm("jmp .Lirq_common\n");
    asm(".Lirq15:\n"); asm(".byte 0x6A,15\n"); asm("jmp .Lirq_common\n");

    // --- LAPIC timer stub (vector 0x40 = 64) ---
    asm(".Llapic_timer:\n");
    asm("push r15\n"); asm("push r14\n"); asm("push r13\n"); asm("push r12\n");
    asm("push r11\n"); asm("push r10\n"); asm("push r9\n");  asm("push r8\n");
    asm("push rbp\n"); asm("push rdi\n"); asm("push rsi\n"); asm("push rdx\n");
    asm("push rcx\n"); asm("push rbx\n"); asm("push rax\n");
    asm(".byte 0x65, 0x48, 0xC7, 0x04, 0x25, 0x70, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00\n");    // mov QWORD PTR gs:[0x70], 1 (smp.PerCpu.in_irq_context)
    asm("mov rbp, rsp\n");
    asm("and rsp, -16\n");
    asm("call _kernel_arch_idt_cst_lapic_timer_handler\n");
    asm("mov rsp, rbp\n");
    // Check need_resched
    asm(".byte 0x65, 0x48, 0x8B, 0x04, 0x25, 0x50, 0x00, 0x00, 0x00\n");    // mov rax, QWORD PTR gs:[0x50] (smp.PerCpu.need_resched)
    asm("test rax, rax\n");
    asm("jz .Llapic_no_resched\n");
    asm("mov rbp, rsp\n");
    asm("and rsp, -16\n");
    asm("call _kernel_task_sched_cst_schedule\n");
    asm("mov rsp, rbp\n");
    asm(".Llapic_no_resched:\n");
    asm(".byte 0x65, 0x48, 0xC7, 0x04, 0x25, 0x70, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00\n");    // mov QWORD PTR gs:[0x70], 0 (smp.PerCpu.in_irq_context)
    // Force user SS to RPL 3 (see the .Lisr_common note). 15 GPRs(120), no
    // vector/errcode below the hw frame → CS=[rsp+128], SS=[rsp+152].
    asm("mov rax, QWORD PTR [rsp+128]\n");   // CS
    asm("and rax, 3\n");
    asm("cmp rax, 3\n");
    asm("jne .Llapic_ss_ok\n");
    asm("mov rax, QWORD PTR [rsp+152]\n");    // SS
    asm("or rax, 3\n");
    asm("mov QWORD PTR [rsp+152], rax\n");
    asm(".Llapic_ss_ok:\n");
    asm("pop rax\n"); asm("pop rbx\n"); asm("pop rcx\n"); asm("pop rdx\n");
    asm("pop rsi\n"); asm("pop rdi\n"); asm("pop rbp\n");
    asm("pop r8\n");  asm("pop r9\n");  asm("pop r10\n"); asm("pop r11\n");
    asm("pop r12\n"); asm("pop r13\n"); asm("pop r14\n"); asm("pop r15\n");
    asm(".byte 0x48, 0xCF\n");    // iretq

    // --- Reschedule IPI stub (vector 0x41 = 65). Wakes the target
    //     cpu out of an idle HLT or a lower-priority thread so it
    //     picks up a newly-RUNNABLE thread queued by the sender.
    //     Same structural pattern as the LAPIC timer stub: save all
    //     GPRs, flag IRQ context, ack the LAPIC, check need_resched
    //     (which the sender already wrote on this cpu's PerCpu),
    //     call schedule() if set, clear IRQ context, pop, iretq.
    asm(".Lresched_ipi:\n");
    asm("push r15\n"); asm("push r14\n"); asm("push r13\n"); asm("push r12\n");
    asm("push r11\n"); asm("push r10\n"); asm("push r9\n");  asm("push r8\n");
    asm("push rbp\n"); asm("push rdi\n"); asm("push rsi\n"); asm("push rdx\n");
    asm("push rcx\n"); asm("push rbx\n"); asm("push rax\n");
    asm(".byte 0x65, 0x48, 0xC7, 0x04, 0x25, 0x70, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00\n");    // mov QWORD PTR gs:[0x70], 1
    asm("mov rbp, rsp\n");
    asm("and rsp, -16\n");
    asm("call _kernel_arch_idt_cst_resched_ipi_handler\n");
    asm("mov rsp, rbp\n");
    asm(".byte 0x65, 0x48, 0x8B, 0x04, 0x25, 0x50, 0x00, 0x00, 0x00\n");    // mov rax, QWORD PTR gs:[0x50]
    asm("test rax, rax\n");
    asm("jz .Lresched_no_sched\n");
    asm("mov rbp, rsp\n");
    asm("and rsp, -16\n");
    asm("call _kernel_task_sched_cst_schedule\n");
    asm("mov rsp, rbp\n");
    asm(".Lresched_no_sched:\n");
    asm(".byte 0x65, 0x48, 0xC7, 0x04, 0x25, 0x70, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00\n");    // mov QWORD PTR gs:[0x70], 0
    // Force user SS to RPL 3 (see the .Lisr_common note). CS=[rsp+128], SS=[rsp+152].
    asm("mov rax, QWORD PTR [rsp+128]\n");   // CS
    asm("and rax, 3\n");
    asm("cmp rax, 3\n");
    asm("jne .Lresched_ss_ok\n");
    asm("mov rax, QWORD PTR [rsp+152]\n");    // SS
    asm("or rax, 3\n");
    asm("mov QWORD PTR [rsp+152], rax\n");
    asm(".Lresched_ss_ok:\n");
    asm("pop rax\n"); asm("pop rbx\n"); asm("pop rcx\n"); asm("pop rdx\n");
    asm("pop rsi\n"); asm("pop rdi\n"); asm("pop rbp\n");
    asm("pop r8\n");  asm("pop r9\n");  asm("pop r10\n"); asm("pop r11\n");
    asm("pop r12\n"); asm("pop r13\n"); asm("pop r14\n"); asm("pop r15\n");
    asm(".byte 0x48, 0xCF\n");    // iretq

    // --- TLB-shootdown IPI stub (vector 0x42 = 66). Reload CR3 in registers
    //     (flushes this cpu's non-global TLB) BEFORE the handler — register-
    //     only, so no shared cr3 shuttle is touched — then ack + EOI. Same GPR
    //     save/restore frame as the resched stub.
    asm(".Ltlb_shootdown:\n");
    asm("push r15\n"); asm("push r14\n"); asm("push r13\n"); asm("push r12\n");
    asm("push r11\n"); asm("push r10\n"); asm("push r9\n");  asm("push r8\n");
    asm("push rbp\n"); asm("push rdi\n"); asm("push rsi\n"); asm("push rdx\n");
    asm("push rcx\n"); asm("push rbx\n"); asm("push rax\n");
    asm(".byte 0x65, 0x48, 0xC7, 0x04, 0x25, 0x70, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00\n");    // mov QWORD PTR gs:[0x70], 1
    asm(".byte 0x0F, 0x20, 0xD8\n");    // mov rax, cr3
    asm(".byte 0x0F, 0x22, 0xD8\n");    // mov cr3, rax  (reload → flush non-global TLB)
    asm("mov rbp, rsp\n");
    asm("and rsp, -16\n");
    asm("call _kernel_arch_idt_cst_tlb_shootdown_handler\n");
    asm("mov rsp, rbp\n");
    asm(".byte 0x65, 0x48, 0xC7, 0x04, 0x25, 0x70, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00\n");    // mov QWORD PTR gs:[0x70], 0
    // Force user SS to RPL 3 (see the .Lisr_common note). CS=[rsp+128], SS=[rsp+152].
    asm("mov rax, QWORD PTR [rsp+128]\n");   // CS
    asm("and rax, 3\n");
    asm("cmp rax, 3\n");
    asm("jne .Ltlb_ss_ok\n");
    asm("mov rax, QWORD PTR [rsp+152]\n");    // SS
    asm("or rax, 3\n");
    asm("mov QWORD PTR [rsp+152], rax\n");
    asm(".Ltlb_ss_ok:\n");
    asm("pop rax\n"); asm("pop rbx\n"); asm("pop rcx\n"); asm("pop rdx\n");
    asm("pop rsi\n"); asm("pop rdi\n"); asm("pop rbp\n");
    asm("pop r8\n");  asm("pop r9\n");  asm("pop r10\n"); asm("pop r11\n");
    asm("pop r12\n"); asm("pop r13\n"); asm("pop r14\n"); asm("pop r15\n");
    asm(".byte 0x48, 0xCF\n");    // iretq

    // --- Driver IRQ stubs (vectors 48..63). Each stub is a tiny
    //     per-vector prologue: save the caller's rdi, load the vector
    //     number into rdi, and jump to the shared dispatch body.
    //     Saving all the other GPRs, EOI, resched, and iretq live in
    //     .Ldrvirq_common so growing the range is additive (one more
    //     3-line stub + one more set_gate call in init), not a
    //     duplicated 40-line block.
    asm(".Ldrvirq48:\n"); asm("push rdi\n"); asm("mov rdi, 48\n"); asm("jmp .Ldrvirq_common\n");
    asm(".Ldrvirq49:\n"); asm("push rdi\n"); asm("mov rdi, 49\n"); asm("jmp .Ldrvirq_common\n");
    asm(".Ldrvirq50:\n"); asm("push rdi\n"); asm("mov rdi, 50\n"); asm("jmp .Ldrvirq_common\n");
    asm(".Ldrvirq51:\n"); asm("push rdi\n"); asm("mov rdi, 51\n"); asm("jmp .Ldrvirq_common\n");
    asm(".Ldrvirq52:\n"); asm("push rdi\n"); asm("mov rdi, 52\n"); asm("jmp .Ldrvirq_common\n");
    asm(".Ldrvirq53:\n"); asm("push rdi\n"); asm("mov rdi, 53\n"); asm("jmp .Ldrvirq_common\n");
    asm(".Ldrvirq54:\n"); asm("push rdi\n"); asm("mov rdi, 54\n"); asm("jmp .Ldrvirq_common\n");
    asm(".Ldrvirq55:\n"); asm("push rdi\n"); asm("mov rdi, 55\n"); asm("jmp .Ldrvirq_common\n");
    asm(".Ldrvirq56:\n"); asm("push rdi\n"); asm("mov rdi, 56\n"); asm("jmp .Ldrvirq_common\n");
    asm(".Ldrvirq57:\n"); asm("push rdi\n"); asm("mov rdi, 57\n"); asm("jmp .Ldrvirq_common\n");
    asm(".Ldrvirq58:\n"); asm("push rdi\n"); asm("mov rdi, 58\n"); asm("jmp .Ldrvirq_common\n");
    asm(".Ldrvirq59:\n"); asm("push rdi\n"); asm("mov rdi, 59\n"); asm("jmp .Ldrvirq_common\n");
    asm(".Ldrvirq60:\n"); asm("push rdi\n"); asm("mov rdi, 60\n"); asm("jmp .Ldrvirq_common\n");
    asm(".Ldrvirq61:\n"); asm("push rdi\n"); asm("mov rdi, 61\n"); asm("jmp .Ldrvirq_common\n");
    asm(".Ldrvirq62:\n"); asm("push rdi\n"); asm("mov rdi, 62\n"); asm("jmp .Ldrvirq_common\n");
    asm(".Ldrvirq63:\n"); asm("push rdi\n"); asm("mov rdi, 63\n"); asm("jmp .Ldrvirq_common\n");

    // --- Shared dispatch body. On entry the per-vector prologue has
    //     pushed the caller's rdi and loaded rdi with the vector
    //     number. We save the remaining 14 GPRs below the saved rdi,
    //     set the in_irq_context flag, call driver_irq_dispatch(rdi),
    //     handle resched, clear the flag, restore all 15 GPRs, and
    //     iretq. Dispatch does LAPIC EOI itself.
    asm(".Ldrvirq_common:\n");
    asm("push r15\n"); asm("push r14\n"); asm("push r13\n"); asm("push r12\n");
    asm("push r11\n"); asm("push r10\n"); asm("push r9\n");  asm("push r8\n");
    asm("push rbp\n"); asm("push rsi\n"); asm("push rdx\n");
    asm("push rcx\n"); asm("push rbx\n"); asm("push rax\n");
    asm(".byte 0x65, 0x48, 0xC7, 0x04, 0x25, 0x70, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00\n");    // mov QWORD PTR gs:[0x70], 1 (smp.PerCpu.in_irq_context)
    asm("mov rbp, rsp\n");
    asm("and rsp, -16\n");
    asm("call _kernel_drivers_driver_cst_driver_irq_dispatch\n");
    asm("mov rsp, rbp\n");
    asm(".byte 0x65, 0x48, 0x8B, 0x04, 0x25, 0x50, 0x00, 0x00, 0x00\n");    // mov rax, QWORD PTR gs:[0x50] (smp.PerCpu.need_resched)
    asm("test rax, rax\n");
    asm("jz .Ldrvirq_common_no_resched\n");
    asm("mov rbp, rsp\n");
    asm("and rsp, -16\n");
    asm("call _kernel_task_sched_cst_schedule\n");
    asm("mov rsp, rbp\n");
    asm(".Ldrvirq_common_no_resched:\n");
    asm(".byte 0x65, 0x48, 0xC7, 0x04, 0x25, 0x70, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00\n");    // mov QWORD PTR gs:[0x70], 0 (smp.PerCpu.in_irq_context)
    // Force user SS to RPL 3 (see the .Lisr_common note). 14 GPRs(112) +
    // prologue-saved rdi(8) below the hw frame → CS=[rsp+128], SS=[rsp+152].
    asm("mov rax, QWORD PTR [rsp+128]\n");   // CS
    asm("and rax, 3\n");
    asm("cmp rax, 3\n");
    asm("jne .Ldrvirq_ss_ok\n");
    asm("mov rax, QWORD PTR [rsp+152]\n");    // SS
    asm("or rax, 3\n");
    asm("mov QWORD PTR [rsp+152], rax\n");
    asm(".Ldrvirq_ss_ok:\n");
    asm("pop rax\n"); asm("pop rbx\n"); asm("pop rcx\n"); asm("pop rdx\n");
    asm("pop rsi\n"); asm("pop rbp\n");
    asm("pop r8\n");  asm("pop r9\n");  asm("pop r10\n"); asm("pop r11\n");
    asm("pop r12\n"); asm("pop r13\n"); asm("pop r14\n"); asm("pop r15\n");
    asm("pop rdi\n");              // restore caller's rdi from prologue
    asm(".byte 0x48, 0xCF\n");    // iretq

    asm(".Lstubs_end:\n");

    // Store all stub addresses using pure asm — rbx is clobbered but we
    // use the global symbol directly
    asm("lea rbx, [rip+_kernel_arch_idt_cst_isr_addrs]\n");

    asm("lea rax, [rip+.Lisr0]\n");  asm("mov QWORD PTR [rbx+0], rax\n");
    asm("lea rax, [rip+.Lisr1]\n");  asm("mov QWORD PTR [rbx+8], rax\n");
    asm("lea rax, [rip+.Lisr2]\n");  asm("mov QWORD PTR [rbx+16], rax\n");
    asm("lea rax, [rip+.Lisr3]\n");  asm("mov QWORD PTR [rbx+24], rax\n");
    asm("lea rax, [rip+.Lisr4]\n");  asm("mov QWORD PTR [rbx+32], rax\n");
    asm("lea rax, [rip+.Lisr5]\n");  asm("mov QWORD PTR [rbx+40], rax\n");
    asm("lea rax, [rip+.Lisr6]\n");  asm("mov QWORD PTR [rbx+48], rax\n");
    asm("lea rax, [rip+.Lisr7]\n");  asm("mov QWORD PTR [rbx+56], rax\n");
    asm("lea rax, [rip+.Lisr8]\n");  asm("mov QWORD PTR [rbx+64], rax\n");
    asm("lea rax, [rip+.Lisr9]\n");  asm("mov QWORD PTR [rbx+72], rax\n");
    asm("lea rax, [rip+.Lisr10]\n"); asm("mov QWORD PTR [rbx+80], rax\n");
    asm("lea rax, [rip+.Lisr11]\n"); asm("mov QWORD PTR [rbx+88], rax\n");
    asm("lea rax, [rip+.Lisr12]\n"); asm("mov QWORD PTR [rbx+96], rax\n");
    asm("lea rax, [rip+.Lisr13]\n"); asm("mov QWORD PTR [rbx+104], rax\n");
    asm("lea rax, [rip+.Lisr14]\n"); asm("mov QWORD PTR [rbx+112], rax\n");
    asm("lea rax, [rip+.Lisr15]\n"); asm("mov QWORD PTR [rbx+120], rax\n");
    asm("lea rax, [rip+.Lisr16]\n"); asm("mov QWORD PTR [rbx+128], rax\n");
    asm("lea rax, [rip+.Lisr17]\n"); asm("mov QWORD PTR [rbx+136], rax\n");
    asm("lea rax, [rip+.Lisr18]\n"); asm("mov QWORD PTR [rbx+144], rax\n");

    asm("lea rax, [rip+.Lirq0]\n");  asm("mov QWORD PTR [rbx+152], rax\n");
    asm("lea rax, [rip+.Lirq1]\n");  asm("mov QWORD PTR [rbx+160], rax\n");
    asm("lea rax, [rip+.Lirq2]\n");  asm("mov QWORD PTR [rbx+168], rax\n");
    asm("lea rax, [rip+.Lirq3]\n");  asm("mov QWORD PTR [rbx+176], rax\n");
    asm("lea rax, [rip+.Lirq4]\n");  asm("mov QWORD PTR [rbx+184], rax\n");
    asm("lea rax, [rip+.Lirq5]\n");  asm("mov QWORD PTR [rbx+192], rax\n");
    asm("lea rax, [rip+.Lirq6]\n");  asm("mov QWORD PTR [rbx+200], rax\n");
    asm("lea rax, [rip+.Lirq7]\n");  asm("mov QWORD PTR [rbx+208], rax\n");
    asm("lea rax, [rip+.Lirq8]\n");  asm("mov QWORD PTR [rbx+216], rax\n");
    asm("lea rax, [rip+.Lirq9]\n");  asm("mov QWORD PTR [rbx+224], rax\n");
    asm("lea rax, [rip+.Lirq10]\n"); asm("mov QWORD PTR [rbx+232], rax\n");
    asm("lea rax, [rip+.Lirq11]\n"); asm("mov QWORD PTR [rbx+240], rax\n");
    asm("lea rax, [rip+.Lirq12]\n"); asm("mov QWORD PTR [rbx+248], rax\n");
    asm("lea rax, [rip+.Lirq13]\n"); asm("mov QWORD PTR [rbx+256], rax\n");
    asm("lea rax, [rip+.Lirq14]\n"); asm("mov QWORD PTR [rbx+264], rax\n");
    asm("lea rax, [rip+.Lirq15]\n"); asm("mov QWORD PTR [rbx+272], rax\n");
    // LAPIC timer stub at index 35 (offset 280)
    asm("lea rax, [rip+.Llapic_timer]\n"); asm("mov QWORD PTR [rbx+280], rax\n");
    // Driver IRQ stubs for vectors 48..63 at indices 36..51 (offsets
    // 288 + k*8). Stored in asr_addrs so init() can set_gate each.
    asm("lea rax, [rip+.Ldrvirq48]\n"); asm("mov QWORD PTR [rbx+288], rax\n");
    asm("lea rax, [rip+.Ldrvirq49]\n"); asm("mov QWORD PTR [rbx+296], rax\n");
    asm("lea rax, [rip+.Ldrvirq50]\n"); asm("mov QWORD PTR [rbx+304], rax\n");
    asm("lea rax, [rip+.Ldrvirq51]\n"); asm("mov QWORD PTR [rbx+312], rax\n");
    asm("lea rax, [rip+.Ldrvirq52]\n"); asm("mov QWORD PTR [rbx+320], rax\n");
    asm("lea rax, [rip+.Ldrvirq53]\n"); asm("mov QWORD PTR [rbx+328], rax\n");
    asm("lea rax, [rip+.Ldrvirq54]\n"); asm("mov QWORD PTR [rbx+336], rax\n");
    asm("lea rax, [rip+.Ldrvirq55]\n"); asm("mov QWORD PTR [rbx+344], rax\n");
    asm("lea rax, [rip+.Ldrvirq56]\n"); asm("mov QWORD PTR [rbx+352], rax\n");
    asm("lea rax, [rip+.Ldrvirq57]\n"); asm("mov QWORD PTR [rbx+360], rax\n");
    asm("lea rax, [rip+.Ldrvirq58]\n"); asm("mov QWORD PTR [rbx+368], rax\n");
    asm("lea rax, [rip+.Ldrvirq59]\n"); asm("mov QWORD PTR [rbx+376], rax\n");
    asm("lea rax, [rip+.Ldrvirq60]\n"); asm("mov QWORD PTR [rbx+384], rax\n");
    asm("lea rax, [rip+.Ldrvirq61]\n"); asm("mov QWORD PTR [rbx+392], rax\n");
    asm("lea rax, [rip+.Ldrvirq62]\n"); asm("mov QWORD PTR [rbx+400], rax\n");
    asm("lea rax, [rip+.Ldrvirq63]\n"); asm("mov QWORD PTR [rbx+408], rax\n");
    // Reschedule IPI stub at index 52 (offset 416) — vector 0x41.
    asm("lea rax, [rip+.Lresched_ipi]\n"); asm("mov QWORD PTR [rbx+416], rax\n");
    // TLB-shootdown IPI stub at index 53 (offset 424) — vector 0x42.
    asm("lea rax, [rip+.Ltlb_shootdown]\n"); asm("mov QWORD PTR [rbx+424], rax\n");
}

// ============================================================
// Init
// ============================================================

fn init() as void {
    remap_pic();
    install_stubs();

    let is *i64 as addrs = cast(*i64, &isr_addrs);

    // Exceptions 0-18
    let is i64 as ei with mut = 0;
    while (ei < 19) {
        set_gate(ei, addrs[ei], 0x08, 0, 0x8E);
        ei = ei + 1;
    }

    // IRQs 0-15 -> vectors 32-47
    let is i64 as ii with mut = 0;
    while (ii < 16) {
        set_gate(32 + ii, addrs[19 + ii], 0x08, 0, 0x8E);
        ii = ii + 1;
    }

    // LAPIC timer -> vector 64 (0x40)
    set_gate(64, addrs[35], 0x08, 0, 0x8E);

    // Reschedule IPI -> vector 65 (0x41)
    set_gate(65, addrs[52], 0x08, 0, 0x8E);

    // TLB-shootdown IPI -> vector 66 (0x42)
    set_gate(66, addrs[53], 0x08, 0, 0x8E);

    // Driver IRQ vectors 48..63 — 16 slots for IOAPIC-routed device
    // interrupts (PS/2 kbd, AHCI, future NVMe/USB/etc). ioapic.cst
    // hands these out via alloc_vector; vectors 48 is reserved at
    // init for the smoke-test int 0x30 and 64 for the LAPIC timer.
    let is i64 as di with mut = 0;
    while (di < 16) {
        set_gate(48 + di, addrs[36 + di], 0x08, 0, 0x8E);
        di = di + 1;
    }

    // Load IDTR
    let is i64 as idt_base = cast(i64, &idt_data);
    let is i64 as limit = 4095;
    idtr_lo = limit + ((idt_base & 0xFFFFFFFFFFFF) << 16);
    idtr_hi = (idt_base >> 48) & 0xFFFF;

    ap_load();

    pic_unmask(0);    // timer (IRQ 0) — still delivered via legacy PIC
    // Keyboard (IRQ 1) is routed through the IOAPIC, not the legacy PIC.
    // The PIC entry for IRQ 1 stays masked (mask defaulted in remap_pic).
    asm(".byte 0xFB\n");  // sti

    serial.println("idt: ok", 7);
}

// Per-cpu IDT install. BSP does this from init() after building the
// IDTR and installing every gate. APs call it once at entry — the
// descriptor table is shared read-only so pointing each cpu at the
// same IDTR base gives every cpu the same exception / IRQ gates.
// Leaves interrupts masked; caller sti's when ready.
fn ap_load() as void {
    asm("lea rax, [rip+_kernel_arch_idt_cst_idtr_lo]\n");
    asm(".byte 0x0F, 0x01, 0x18\n");  // lidt [rax]
}
