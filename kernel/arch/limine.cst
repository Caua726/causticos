// limine.cst — Limine boot protocol structs and requests

// ============================================================
// Base revision
// ============================================================

// Limine checks these magic numbers to confirm protocol version.
// If supported, Limine sets base_rev_2 to 0.
let is i64 as base_rev_0 with mut = 0xf9562b2d5c95a6c8;
let is i64 as base_rev_1 with mut = 0x6a7b384944536bdc;
let is i64 as base_rev_2 with mut = 3;

// ============================================================
// Framebuffer
// ============================================================

// Only the first 4 fields — all i64-sized so no packed-vs-C alignment issues.
// We don't need bpp/mask fields for 32bpp framebuffer writing.
struct LimineFramebuffer {
    address as *u8;
    width as i64;
    height as i64;
    pitch as i64;
}

struct LimineFbResponse {
    revision as i64;
    fb_count as i64;
    framebuffers as *i64;
}

struct LimineFbRequest {
    id0 as i64;
    id1 as i64;
    id2 as i64;
    id3 as i64;
    revision as i64;
    response as *LimineFbResponse;
}

// Framebuffer request — laid out as contiguous i64s so Limine can find the magic.
// Common magic: 0xc7b1dd30df4c8b88, 0x0a82e883a194f07b
// Framebuffer ID: 0x9d5827dcd881dd75, 0xa3148604f6fab11b
let is i64 as fb_req_id0 with mut = 0xc7b1dd30df4c8b88;
let is i64 as fb_req_id1 with mut = 0x0a82e883a194f07b;
let is i64 as fb_req_id2 with mut = 0x9d5827dcd881dd75;
let is i64 as fb_req_id3 with mut = 0xa3148604f6fab11b;
let is i64 as fb_req_revision with mut = 0;
let is i64 as fb_req_response with mut = 0;

// ============================================================
// HHDM (Higher Half Direct Map)
// ============================================================

struct LimineHhdmResponse {
    revision as i64;
    offset as i64;
}

// Common: 0xc7b1dd30df4c8b88, 0x0a82e883a194f07b
// HHDM:   0x48dcf1cb8ad2b852, 0x63984e959a98244b
let is i64 as hhdm_req_id0 with mut = 0xc7b1dd30df4c8b88;
let is i64 as hhdm_req_id1 with mut = 0x0a82e883a194f07b;
let is i64 as hhdm_req_id2 with mut = 0x48dcf1cb8ad2b852;
let is i64 as hhdm_req_id3 with mut = 0x63984e959a98244b;
let is i64 as hhdm_req_revision with mut = 0;
let is i64 as hhdm_req_response with mut = 0;

// ============================================================
// Memory map
// ============================================================

// Entry types
let is i64 as MMAP_USABLE              = 0;
let is i64 as MMAP_RESERVED            = 1;
let is i64 as MMAP_ACPI_RECLAIMABLE    = 2;
let is i64 as MMAP_ACPI_NVS            = 3;
let is i64 as MMAP_BAD_MEMORY          = 4;
let is i64 as MMAP_BOOTLOADER_RECLAIM  = 5;
let is i64 as MMAP_KERNEL_AND_MODULES  = 6;
let is i64 as MMAP_FRAMEBUFFER         = 7;

struct LimineMmapEntry {
    base as i64;
    length as i64;
    entry_type as i64;
}

struct LimineMmapResponse {
    revision as i64;
    entry_count as i64;
    entries as i64;       // pointer to array of *LimineMmapEntry
}

// Memory map request — common magic + mmap ID
// Common: 0xc7b1dd30df4c8b88, 0x0a82e883a194f07b
// Mmap:   0x67cf3d9d378a806f, 0xe304acdfc50c3c62
let is i64 as mmap_req_id0 with mut = 0xc7b1dd30df4c8b88;
let is i64 as mmap_req_id1 with mut = 0x0a82e883a194f07b;
let is i64 as mmap_req_id2 with mut = 0x67cf3d9d378a806f;
let is i64 as mmap_req_id3 with mut = 0xe304acdfc50c3c62;
let is i64 as mmap_req_revision with mut = 0;
let is i64 as mmap_req_response with mut = 0;

// ============================================================
// RSDP (ACPI Root System Description Pointer)
// ============================================================

struct LimineRsdpResponse {
    revision as i64;
    address as i64;    // physical address of the RSDP structure
}

// Common: 0xc7b1dd30df4c8b88, 0x0a82e883a194f07b
// RSDP:   0xc5e77b6b397e7b43, 0x27637845accdcf3c
let is i64 as rsdp_req_id0 with mut = 0xc7b1dd30df4c8b88;
let is i64 as rsdp_req_id1 with mut = 0x0a82e883a194f07b;
let is i64 as rsdp_req_id2 with mut = 0xc5e77b6b397e7b43;
let is i64 as rsdp_req_id3 with mut = 0x27637845accdcf3c;
let is i64 as rsdp_req_revision with mut = 0;
let is i64 as rsdp_req_response with mut = 0;

// ============================================================
// SMP — Application Processor bring-up. Limine brings every AP up
// to 64-bit long mode with paging on, then parks it in a spin loop
// waiting for us to write a function pointer into its goto_address
// slot. As soon as we write it, that AP jumps to our code (running
// in RDI = *LimineSmpInfo). Massively simpler than writing our own
// 16→32→64 trampoline, and production-standard.
// ============================================================

// Limine uses a packed C layout with real u32 fields. Caustic's
// mixed-width struct layout has known miscompiles, so we don't
// describe those fields as members — helpers below read by explicit
// byte offset off a *u8 view, which matches the spec exactly.
//
// LimineSmpInfo on-wire (32 bytes):
//   [0..4]    processor_id   (u32)
//   [4..8]    lapic_id       (u32)
//   [8..16]   reserved
//   [16..24]  goto_address   (u64, writable)
//   [24..32]  extra_argument (u64, writable)
//
// LimineSmpResponse on-wire:
//   [0..8]    revision
//   [8..12]   flags
//   [12..16]  bsp_lapic_id
//   [16..24]  cpu_count
//   [24..32]  cpus  (pointer to array of *LimineSmpInfo)

let is i64 as SMP_INFO_GOTO_OFF     = 16;
let is i64 as SMP_INFO_EXTRA_OFF    = 24;
let is i64 as SMP_INFO_LAPIC_ID_OFF = 4;
let is i64 as SMP_INFO_PROC_ID_OFF  = 0;

let is i64 as SMP_RESP_FLAGS_OFF       = 8;
let is i64 as SMP_RESP_BSP_LAPIC_OFF   = 12;
let is i64 as SMP_RESP_CPU_COUNT_OFF   = 16;
let is i64 as SMP_RESP_CPUS_OFF        = 24;

fn smp_info_lapic_id(info as *u8) as i64 {
    let is *u32 as p = cast(*u32, cast(i64, info) + SMP_INFO_LAPIC_ID_OFF);
    return cast(i64, *p) & 0xFFFFFFFF;
}

fn smp_info_proc_id(info as *u8) as i64 {
    let is *u32 as p = cast(*u32, cast(i64, info) + SMP_INFO_PROC_ID_OFF);
    return cast(i64, *p) & 0xFFFFFFFF;
}

fn smp_info_set_extra(info as *u8, val as i64) as void {
    let is *i64 as p = cast(*i64, cast(i64, info) + SMP_INFO_EXTRA_OFF);
    *p = val;
}

fn smp_info_get_extra(info as *u8) as i64 {
    let is *i64 as p = cast(*i64, cast(i64, info) + SMP_INFO_EXTRA_OFF);
    return *p;
}

fn smp_info_set_goto(info as *u8, addr as i64) as void {
    let is *i64 as p = cast(*i64, cast(i64, info) + SMP_INFO_GOTO_OFF);
    *p = addr;
}

fn smp_resp_bsp_lapic(resp as *u8) as i64 {
    let is *u32 as p = cast(*u32, cast(i64, resp) + SMP_RESP_BSP_LAPIC_OFF);
    return cast(i64, *p) & 0xFFFFFFFF;
}

fn smp_resp_cpu_count(resp as *u8) as i64 {
    let is *i64 as p = cast(*i64, cast(i64, resp) + SMP_RESP_CPU_COUNT_OFF);
    return *p;
}

fn smp_resp_cpus(resp as *u8) as i64 {
    let is *i64 as p = cast(*i64, cast(i64, resp) + SMP_RESP_CPUS_OFF);
    return *p;
}

// Common: 0xc7b1dd30df4c8b88, 0x0a82e883a194f07b
// SMP:    0x95a67b819a1b857e, 0xa0b61b723b6a73e0
let is i64 as smp_req_id0 with mut = 0xc7b1dd30df4c8b88;
let is i64 as smp_req_id1 with mut = 0x0a82e883a194f07b;
let is i64 as smp_req_id2 with mut = 0x95a67b819a1b857e;
let is i64 as smp_req_id3 with mut = 0xa0b61b723b6a73e0;
let is i64 as smp_req_revision with mut = 0;
let is i64 as smp_req_response with mut = 0;
let is i64 as smp_req_flags with mut = 0;    // 0 = xAPIC, 1 = request x2APIC

// ============================================================
// Modules — files the bootloader loads into memory beside the kernel.
// causticos ships exactly one: the live root volume (a CSVI sparse
// container), declared in the generated limine.conf as
//   module_path: boot():/boot/rootfs.csvi
// That module is why the ISO boots the whole system with no disk.
//
// Common: 0xc7b1dd30df4c8b88, 0x0a82e883a194f07b
// Module: 0x3e7e279702be32af, 0xca1c4f3bd1280cee
//   Verified against Limine 12.5.1's own /usr/share/limine/BOOTX64.EFI:
//   the loader compares these two as movabs immediates at file offset
//   0x31a72, the identical code shape it uses for the framebuffer ID at
//   0x31330 — which matches fb_req_id2/id3 above, a request known to work.
// ============================================================

let is i64 as mod_req_id0 with mut = 0xc7b1dd30df4c8b88;
let is i64 as mod_req_id1 with mut = 0x0a82e883a194f07b;
let is i64 as mod_req_id2 with mut = 0x3e7e279702be32af;
let is i64 as mod_req_id3 with mut = 0xca1c4f3bd1280cee;
let is i64 as mod_req_revision with mut = 0;
let is i64 as mod_req_response with mut = 0;

// All three fields are 8 bytes wide, so a plain struct is safe here — same
// shape as LimineMmapResponse.
struct LimineModuleResponse {
    revision     as i64;
    module_count as i64;
    modules      as i64;    // pointer to an array of *limine_file
}

// limine_file is a MIXED-WIDTH on-wire struct: u32 media_type/tftp/partition
// fields from +40 and three 16-byte UUIDs after them. Caustic's mixed-width
// struct layout has known miscompiles, so — exactly as with LimineSmpInfo
// above — the fields we need are read by explicit byte offset off a *u8 view.
//
// limine_file on-wire, first five fields (all 8 bytes):
//   [0..8]    revision
//   [8..16]   address   (void*)
//   [16..24]  size
//   [24..32]  path      (char*)
//   [32..40]  string    (char*, `module_string:` in limine.conf)
let is i64 as LFILE_REVISION_OFF = 0;
let is i64 as LFILE_ADDRESS_OFF  = 8;
let is i64 as LFILE_SIZE_OFF     = 16;
let is i64 as LFILE_PATH_OFF     = 24;
let is i64 as LFILE_STRING_OFF   = 32;

fn file_address(f as *u8) as i64 {
    if (cast(i64, f) == 0) { return 0; }
    let is *i64 as p = cast(*i64, cast(i64, f) + LFILE_ADDRESS_OFF);
    return *p;
}

fn file_size(f as *u8) as i64 {
    if (cast(i64, f) == 0) { return 0; }
    let is *i64 as p = cast(*i64, cast(i64, f) + LFILE_SIZE_OFF);
    return *p;
}

fn file_path(f as *u8) as *u8 {
    if (cast(i64, f) == 0) { return cast(*u8, 0); }
    let is *i64 as p = cast(*i64, cast(i64, f) + LFILE_PATH_OFF);
    return cast(*u8, *p);
}

fn module_count() as i64 {
    if (mod_req_response == 0) { return 0; }
    let is *LimineModuleResponse as r = cast(*LimineModuleResponse, mod_req_response);
    return r.module_count;
}

// The i-th module, or null when out of range.
fn module_at(i as i64) as *u8 {
    if (mod_req_response == 0) { return cast(*u8, 0); }
    let is *LimineModuleResponse as r = cast(*LimineModuleResponse, mod_req_response);
    if (i < 0 || i >= r.module_count) { return cast(*u8, 0); }
    let is *i64 as arr = cast(*i64, r.modules);
    return cast(*u8, arr[i]);
}

// ============================================================
// Executable command line — the `cmdline:` key in limine.conf.
//
// This is how a boot selects behaviour at RUNTIME rather than at compile
// time: `smoke` runs the regression suite, `root=` picks which volume the
// filesystem layer mounts as "/". The alternative — a `let` in main.cst —
// means the tested kernel is a different binary from the shipped one.
//
// Note this does NOT come from QEMU's -append: that only reaches a kernel
// loaded with -kernel, and ours is loaded by Limine off the ISO.
//
// Common:  0xc7b1dd30df4c8b88, 0x0a82e883a194f07b
// Cmdline: 0x4b161536e598651e, 0xb390ad4a2f1f303a  (verified at BOOTX64.EFI
//          offset 0x30ac7, same movabs-pair shape as the controls above)
// ============================================================

let is i64 as cmdline_req_id0 with mut = 0xc7b1dd30df4c8b88;
let is i64 as cmdline_req_id1 with mut = 0x0a82e883a194f07b;
let is i64 as cmdline_req_id2 with mut = 0x4b161536e598651e;
let is i64 as cmdline_req_id3 with mut = 0xb390ad4a2f1f303a;
let is i64 as cmdline_req_revision with mut = 0;
let is i64 as cmdline_req_response with mut = 0;

struct LimineCmdlineResponse {
    revision as i64;
    cmdline  as i64;    // char*, null when the config declared none
}

fn get_cmdline() as *u8 {
    if (cmdline_req_response == 0) { return cast(*u8, 0); }
    let is *LimineCmdlineResponse as r = cast(*LimineCmdlineResponse, cmdline_req_response);
    return cast(*u8, r.cmdline);
}

// ============================================================
// Helpers
// ============================================================

fn get_smp_response() as *u8 {
    if (smp_req_response == 0) { return cast(*u8, 0); }
    return cast(*u8, smp_req_response);
}

fn get_rsdp() as i64 {
    if (rsdp_req_response == 0) { return 0; }
    let is *LimineRsdpResponse as r = cast(*LimineRsdpResponse, rsdp_req_response);
    return r.address;
}

fn get_framebuffer() as *LimineFramebuffer {
    if (fb_req_response == 0) {
        return cast(*LimineFramebuffer, 0);
    }
    let is *LimineFbResponse as resp = cast(*LimineFbResponse, fb_req_response);
    if (resp.fb_count == 0) {
        return cast(*LimineFramebuffer, 0);
    }
    // framebuffers is a pointer to an array of pointers
    let is *i64 as arr = cast(*i64, resp.framebuffers);
    return cast(*LimineFramebuffer, arr[0]);
}

// bpp lives at byte offset 32 (a real u16) in the on-wire framebuffer
// struct, past the 4 i64s the struct above describes. Read it by explicit
// byte offset (same technique as the SMP-info helpers) so Caustic's
// mixed-width struct miscompile never enters the picture.
let is i64 as FB_BPP_OFF = 32;

fn fb_bpp(fb as *LimineFramebuffer) as i64 {
    if (cast(i64, fb) == 0) { return 0; }
    let is *u16 as p = cast(*u16, cast(i64, fb) + FB_BPP_OFF);
    return cast(i64, *p) & 0xFFFF;
}
