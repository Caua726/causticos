# e1000.cdvrspec — Intel 82540EM gigabit ethernet controller
driver "e1000" {
    match {
        bus: pci
        vendor: 0x8086
        device: 0x100E
    }
    capabilities {
        # mmio: <bar_index>, <size_bytes>
        mmio: 0, 0x20000
        # legacy PCI INTx routed via IOAPIC; framework reads PCI 0x3C.
        irq: auto
    }
    lifecycle {
        on_bind: pcitest.e1000_bind
        on_irq:  pcitest.e1000_irq
    }
    implements {
        NetworkController {
            send: pcitest.e1000_send
            recv: pcitest.e1000_recv
            mac:  pcitest.e1000_mac
        }
    }
}
