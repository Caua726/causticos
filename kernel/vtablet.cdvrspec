# virtio-input tablet — the absolute pointing device (modern virtio over
# PCI: vendor 0x1AF4, device 0x1040+18). Legacy INTx routed via IOAPIC;
# the transport windows come from the PCI vendor capabilities, not a fixed
# BAR, so no mmio capability is declared here — the driver maps them itself.

driver "vtablet" {
    match {
        bus: pci
        vendor: 0x1AF4
        device: 0x1052
    }
    capabilities {
        irq: auto
    }
    device {
        class: tablet
        acquire: vtablet.tab_acquire
    }
    lifecycle {
        on_bind: vtablet.vtablet_bind
        on_irq: vtablet.handler
    }
}
