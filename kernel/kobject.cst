// kobject.cst — the polymorphic kernel object behind every fd.
//
// "Tudo é uma chave": an fd is a small per-process integer that names a
// KObject the process holds. The fd table (vma.cst) already stores an
// opaque i64 per slot — this module gives that i64 a shape. A KObject is
// a thin header { type, refcount, ops, priv }: `priv` is the concrete
// thing (a *VfsFile, a *Surface, a channel endpoint, a device), and
// `ops` is a struct-of-fn-pointers vtable — the same canonical pattern
// the project already uses for FileSystemOps / Bus.
//
// This module is deliberately GENERIC: it knows nothing about files,
// surfaces, channels, or devices. Each subsystem owns its own vtable and
// mints its KObjects (vfs.make_file_kobject, surface.acquire, ...). That
// keeps the dependency edge one-way (kobject ← vfs/surface/channel) and
// acyclic.
//
// Honest ops, no ioctl. Each op a type does not support is a null slot
// in its vtable; the dispatch helper returns E_BADF rather than pretending
// every object is a byte stream. A file and a channel both fill read/write
// because both genuinely ARE byte sequences; a surface fills mmap/present
// instead. See docs/architecture.md §1, §3.

use "abi.cst" as abi;
use "heap.cst" as heap;
use "pmm.cst" as pmm;

// ============================================================
// Object kinds.
// ============================================================

let is i64 as KOBJ_FILE    = 1;
let is i64 as KOBJ_CHANNEL = 2;
let is i64 as KOBJ_SURFACE = 3;
let is i64 as KOBJ_DEVICE  = 4;

// ============================================================
// The vtable. Uniform i64 signatures: the first arg is always `priv`
// (the concrete object, cast back inside the op). A null field means
// the kind doesn't implement that op. Every op returns bytes / a value
// (>= 0) or a causticos errno (< 0) — kinds map their internal error
// dialect to the abi.E_* set at the boundary so the dispatcher stays
// uniform.
// ============================================================

struct KObjectOps {
    read    as fn(i64, i64, i64) as i64;            // (priv, buf, n)        -> bytes | -errno
    write   as fn(i64, i64, i64) as i64;            // (priv, buf, n)        -> bytes | -errno
    close   as fn(i64) as i64;                      // (priv)                -> 0     | -errno
    lseek   as fn(i64, i64, i64) as i64;            // (priv, off, whence)   -> off   | -errno
    readdir as fn(i64, i64) as i64;                 // (priv, *VfsDirEntry)  -> 0     | -errno
    mmap    as fn(i64, i64, i64, i64) as i64;       // (priv, aspace, hint, prot) -> vaddr | -errno
    present as fn(i64, i64, i64, i64, i64) as i64;  // (priv, x, y, w, h)    -> 0     | -errno
}

// All scalars i64 (Caustic miscompiles mixed-width adjacent fields; see
// the note on vfs.VfsFile). ops/priv are 64-bit pointers, kept here as a
// typed *KObjectOps and an opaque i64.
struct KObject {
    otype    as i64;
    refcount as i64;
    ops      as *KObjectOps;
    priv     as i64;
}

// ============================================================
// Lifetime
// ============================================================

// Mint a KObject with refcount 1. `ops` is a stable pointer (a subsystem
// global vtable); `priv` is the concrete object as an i64. Returns the
// *KObject as i64 (0 on OOM).
fn ko_alloc(otype as i64, ops as *KObjectOps, priv as i64) as i64 {
    let is i64 as addr = heap.kmalloc(sizeof(KObject), pmm.ALLOC_ZERO);
    if (addr == 0) { return 0; }
    let is *KObject as k = cast(*KObject, addr);
    k.otype = otype;
    k.refcount = 1;
    k.ops = ops;
    k.priv = priv;
    return addr;
}

// Add a reference (a second fd now holds this object — used by fd handoff
// at spawn, Fatia 2).
fn ko_ref(ko as i64) as void {
    if (ko == 0) { return; }
    let is *KObject as k = cast(*KObject, ko);
    k.refcount = k.refcount + 1;
}

// Drop one reference. At zero, run the close op (let the concrete object
// release its resources) and free the header. Returns the close op's
// result (E_OK if no close op or refs remain).
fn ko_unref(ko as i64) as i64 {
    if (ko == 0) { return abi.E_BADF; }
    let is *KObject as k = cast(*KObject, ko);
    // Defensive: an already-released object (refcount <= 0) must not be
    // decremented further or freed twice. A correct caller never hits
    // this; the guard turns a double-unref bug into a no-op instead of a
    // use-after-free. (Thread-safe atomic refcounting lands in Fatia 2,
    // when fdacts lets two fd tables share one KObject; today each KObject
    // is held by exactly one fd.)
    if (k.refcount <= 0) { return abi.E_INVAL; }
    k.refcount = k.refcount - 1;
    if (k.refcount > 0) { return abi.E_OK; }
    let is i64 as rc with mut = abi.E_OK;
    if (cast(i64, k.ops) != 0) {
        if (cast(i64, k.ops.close) != 0) {
            rc = call(k.ops.close, k.priv);
        }
    }
    heap.kfree(ko);
    return rc;
}

fn ko_type(ko as i64) as i64 {
    if (ko == 0) { return 0; }
    let is *KObject as k = cast(*KObject, ko);
    return k.otype;
}

// ============================================================
// Op dispatch. Each helper resolves the vtable, refuses (E_BADF) if the
// op is null, otherwise forwards. `buf` / out-pointers are kernel
// addresses passed as i64 — the syscall layer does the user copy.
// ============================================================

fn ko_read(ko as i64, buf as i64, n as i64) as i64 {
    if (ko == 0) { return abi.E_BADF; }
    let is *KObject as k = cast(*KObject, ko);
    if (cast(i64, k.ops) == 0) { return abi.E_BADF; }
    if (cast(i64, k.ops.read) == 0) { return abi.E_BADF; }
    return call(k.ops.read, k.priv, buf, n);
}

fn ko_write(ko as i64, buf as i64, n as i64) as i64 {
    if (ko == 0) { return abi.E_BADF; }
    let is *KObject as k = cast(*KObject, ko);
    if (cast(i64, k.ops) == 0) { return abi.E_BADF; }
    if (cast(i64, k.ops.write) == 0) { return abi.E_BADF; }
    return call(k.ops.write, k.priv, buf, n);
}

fn ko_lseek(ko as i64, off as i64, whence as i64) as i64 {
    if (ko == 0) { return abi.E_BADF; }
    let is *KObject as k = cast(*KObject, ko);
    if (cast(i64, k.ops) == 0) { return abi.E_BADF; }
    if (cast(i64, k.ops.lseek) == 0) { return abi.E_INVAL; }
    return call(k.ops.lseek, k.priv, off, whence);
}

fn ko_readdir(ko as i64, out as i64) as i64 {
    if (ko == 0) { return abi.E_BADF; }
    let is *KObject as k = cast(*KObject, ko);
    if (cast(i64, k.ops) == 0) { return abi.E_BADF; }
    if (cast(i64, k.ops.readdir) == 0) { return abi.E_NOTDIR; }
    return call(k.ops.readdir, k.priv, out);
}

fn ko_mmap(ko as i64, aspace as i64, hint as i64, prot as i64) as i64 {
    if (ko == 0) { return abi.E_BADF; }
    let is *KObject as k = cast(*KObject, ko);
    if (cast(i64, k.ops) == 0) { return abi.E_BADF; }
    if (cast(i64, k.ops.mmap) == 0) { return abi.E_INVAL; }
    return call(k.ops.mmap, k.priv, aspace, hint, prot);
}

fn ko_present(ko as i64, x as i64, y as i64, w as i64, h as i64) as i64 {
    if (ko == 0) { return abi.E_BADF; }
    let is *KObject as k = cast(*KObject, ko);
    if (cast(i64, k.ops) == 0) { return abi.E_BADF; }
    if (cast(i64, k.ops.present) == 0) { return abi.E_INVAL; }
    return call(k.ops.present, k.priv, x, y, w, h);
}
