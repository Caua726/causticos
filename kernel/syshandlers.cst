// syshandlers.cst — concrete handlers for every causticos syscall
// number defined in abi.cst. Each handler unpacks its own args
// statically (no generic arg-tag interpreter), does whatever
// copy_from_user / copy_to_user it actually needs (no automatic
// policy in the dispatcher), and returns an i64 result.
//
// install_all() at the bottom wires them into syscall.dispatch_table
// via a fn-pointer indirection so the syscall ↔ syshandlers module
// pair stays acyclic.

use "serial.cst" as serial;
use "util.cst" as util;
use "abi.cst" as abi;
use "timer.cst" as timer;
use "sched.cst" as sched;
use "userspace.cst" as userspace;
use "vma.cst" as vma;
use "vfs.cst" as vfs;
use "kobject.cst" as kobject;
use "surface.cst" as surface;
use "channel.cst" as channel;
use "kbd.cst" as kbd;
use "process.cst" as proc;
use "heap.cst" as heap;

// ============================================================
// SYS_KERN_INFO(buf, buf_size) — fill `buf` with the static KernInfo
// probe (see abi.cst). Userspace calls this once at startup, never per
// call. Returns the number of bytes written (non-negative), or an errno.
//
//   buf_size == 0  → size probe: returns KERN_INFO_SIZE without writing,
//                    so a caller can allocate exactly the right buffer.
//   buf_size  > 0  → writes min(KERN_INFO_SIZE, buf_size) bytes. Copying
//                    only what fits is the append-only contract: an old
//                    binary with a smaller struct still gets a valid
//                    prefix. Returns the byte count written.
//
// No dynamic fields here — the clock lives in SYS_TIME_NOW_NS so a cached
// probe never goes stale.
// ============================================================

fn sys_kern_info(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as user_buf = a;
    let is i64 as buf_size = b;
    if (buf_size < 0) { return abi.E_INVAL; }
    if (buf_size == 0) { return abi.KERN_INFO_SIZE; }

    let is i64 as n with mut = abi.KERN_INFO_SIZE;
    if (buf_size < n) { n = buf_size; }

    let is i64 as pml4 = sched.thr_aspace_pml4(sched.current_tid());
    let is [64]u8 as kbuf;
    let is *u8 as p = cast(*u8, &kbuf[0]);
    let is *i64 as q = cast(*i64, p);
    q[0] = abi.KERN_INFO_SIZE;       // info_size
    q[1] = abi.ABI_MAJOR;            // abi_major
    q[2] = abi.ABI_MINOR;            // abi_minor
    q[3] = abi.SYS_COUNT;            // syscalls_max (probe ceiling)
    q[4] = 4096;                     // page_size
    q[5] = 0;                        // flags (reserved)

    let is i32 as rc = userspace.copy_to_user(pml4, user_buf, p, n);
    if (rc != 0) { return abi.E_FAULT; }
    return n;
}

// ============================================================
// SYS_TIME_NOW_NS — monotonic ns since boot.
// ============================================================

fn sys_time_now_ns(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    return timer.current_time_ns();
}

// ============================================================
// SYS_TIME_SLEEP_NS — block until at least `ns` from now.
// ============================================================

fn sys_time_sleep_ns(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    if (a < 0) { return abi.E_INVAL; }
    sched.sleep_for_ns(a);
    return abi.E_OK;
}

// ============================================================
// SYS_PROC_EXIT — terminate the current thread. Never returns.
// If the thread belongs to a Process, publish the zombie (exit code +
// reparent children) BEFORE scheduling away, so the parent's wait() can
// collect the status. Resource reclamation (kstack/aspace/struct) is the
// reaper's / wait()'s job — the thread still runs on its own kstack here.
// ============================================================

fn sys_proc_exit(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    serial.print("sys.proc_exit: code=", 20);
    util.print_num(a);
    serial.println("", 0);
    let is i64 as p = sched.thr_process_ptr(sched.current_tid());
    if (p != 0) { proc.zombify(p, a); }
    sched.exit_current_thread();
    return 0;
}

// ============================================================
// SYS_PROC_GETPID — current pid. A thread that belongs to a Process
// reports that Process's pid (pid != tid); a kernel-internal user thread
// with no Process (the pre-Process smokes) falls back to its tid.
// ============================================================

fn sys_proc_getpid(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as tid = sched.current_tid();
    let is i64 as p = sched.thr_process_ptr(tid);
    if (p != 0) { return proc.proc_pid(p); }
    return tid;
}

// ============================================================
// SYS_PROC_YIELD — voluntary preempt.
// ============================================================

fn sys_proc_yield(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    sched.yield_cpu();
    return abi.E_OK;
}

// ============================================================
// SYS_IO_WRITE_SERIAL — write `len` bytes from `buf` to the kernel
// serial console. fd-less; the only "channel" we have for stdout
// today. When we add a real fd table on top of VFS, this stays for
// kernel-level diagnostics; userspace stdout migrates to fd 1.
//
// Iterates one page at a time so a 1 MiB buffer doesn't force the
// kernel to allocate a 1 MiB staging area. No arbitrary limit at
// the ABI level — the user can chunk if they want.
// ============================================================

let is i64 as IO_PAGE_BYTES = 4096;

fn sys_io_write_serial(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as user_buf = a;
    let is i64 as len = b;
    if (len < 0) { return abi.E_INVAL; }
    if (len == 0) { return 0; }
    let is i64 as pml4 = sched.thr_aspace_pml4(sched.current_tid());
    let is [4096]u8 as kbuf;
    let is *u8 as kp = cast(*u8, &kbuf[0]);
    let is i64 as written with mut = 0;
    while (written < len) {
        let is i64 as remaining = len - written;
        let is i64 as chunk with mut = remaining;
        if (chunk > IO_PAGE_BYTES) { chunk = IO_PAGE_BYTES; }
        let is i32 as rc = userspace.copy_from_user(pml4, kp,
                                                     user_buf + written, chunk);
        if (rc != 0) {
            if (written > 0) { return written; }
            return abi.E_FAULT;
        }
        let is i64 as i with mut = 0;
        while (i < chunk) {
            serial.putc(cast(i64, kp[i]));
            i = i + 1;
        }
        written = written + chunk;
    }
    return written;
}

// ============================================================
// SYS_MMAP(hint, len, prot) — anonymous mapping in the caller's address
// space. hint == 0: the kernel picks a free range. hint != 0: the range
// is honoured exactly (VMA_FIXED), failing if it overlaps. Returns the
// base virtual address (always positive — user VAs are below
// 0x00007FFFFFFFFFFF), or an errno. v0 is anonymous + eager only: no fd,
// no offset, no demand paging (mmap_anon maps all pages up front).
// ============================================================

fn sys_mmap(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as hint = a;
    let is i64 as len = b;
    let is i64 as uprot = c;

    let is i64 as asp = sched.thr_aspace_ptr(sched.current_tid());
    if (asp == 0) { return abi.E_INVAL; }

    // ABI prot bits → PTE leaf bits. The mapping adds PTE_PRESENT|PTE_USER;
    // read is implied by present. WRITE → PTE_WRITE; no EXEC → PTE_NX.
    let is i64 as vprot with mut = vma.PROT_USER;
    if ((uprot & abi.MMAP_PROT_WRITE) != 0) { vprot = vprot | vma.PROT_WRITE; }
    if ((uprot & abi.MMAP_PROT_EXEC) == 0)  { vprot = vprot | vma.PROT_NX; }

    // fd-backed mapping (a surface backbuffer): the 4th arg is the fd; the
    // object provides the pages and decides the size, so `len` is ignored.
    if ((uprot & abi.MMAP_FD) != 0) {
        let is i64 as ko = vma.fd_get(cast(*vma.Aspace, asp), d);
        if (ko == 0) { return abi.E_BADF; }
        return kobject.ko_mmap(ko, asp, hint, vprot);
    }

    if (len <= 0) { return abi.E_INVAL; }
    let is i64 as flags with mut = vma.VMA_ANON;
    let is i64 as use_hint with mut = 0;
    if (hint != 0) { flags = flags | vma.VMA_FIXED; use_hint = hint; }

    let is i64 as va = vma.mmap_anon(cast(*vma.Aspace, asp),
                                     use_hint, len, vprot, flags);
    if (va < 0) { return abi.E_NOMEM; }   // mmap_anon returns -1 on failure
    return va;
}

// ============================================================
// SYS_MUNMAP(addr, len) — unmap a region. v0 only removes VMAs that fall
// entirely within [addr, addr+len); partial-range splitting isn't
// implemented (vma.munmap returns -1 if nothing matched). Returns 0 or errno.
// ============================================================

fn sys_munmap(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    if (b <= 0) { return abi.E_INVAL; }
    let is i64 as asp = sched.thr_aspace_ptr(sched.current_tid());
    if (asp == 0) { return abi.E_INVAL; }
    let is i32 as rc = vma.munmap(cast(*vma.Aspace, asp), a, b);
    if (rc != 0) { return abi.E_INVAL; }
    return abi.E_OK;
}

// ============================================================
// int-fd file I/O. open() resolves a path through the VFS and parks the
// resulting *VfsFile in the per-aspace fd table; read/write/close/lseek
// look the fd back up. fd is just an index into that table — no caps, no
// generation, no rights. See docs: the capability layers come only when a
// cross-aspace workload (spawn/IPC) needs them.
//
// The VFS returns its own negative error codes; map them to the causticos
// errno set so userspace sees one consistent scheme.
// ============================================================

// VFS_* → abi.E_* . The mapping table lives in vfs.cst (the FILE KObject
// wrappers need it too); this is a thin forward so the path-based metadata
// handlers below keep their call sites.
fn vfs_err_to_abi(rc as i64) as i64 {
    return vfs.err_to_abi(rc);
}

let is i64 as PATH_MAX = 255;

// SYS_OPEN(path, path_len, flags) — open/create a file, return its fd.
// NOTE: vfs.open only signals success/failure (a null handle), not which
// error, so a failed open reports E_NOENT generically. Surfacing the
// precise errno is a VFS-side improvement for later.
fn sys_open(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as path_len = b;
    if (path_len <= 0) { return abi.E_INVAL; }
    if (path_len > PATH_MAX) { return abi.E_INVAL; }
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);

    let is [256]u8 as kpath;
    let is *u8 as kp = cast(*u8, &kpath[0]);
    let is i32 as crc = userspace.copy_from_user(pml4, kp, a, path_len);
    if (crc != 0) { return abi.E_FAULT; }

    let is *vfs.VfsFile as fp = vfs.open(kp, path_len, cast(i32, c));
    if (cast(i64, fp) == 0) { return abi.E_NOENT; }

    // Wrap the open file in a KObject (the fd-table entry is a *KObject,
    // not a *VfsFile — an fd can back a file, surface, channel, or device).
    let is i64 as ko = vfs.make_file_kobject(fp);
    if (ko == 0) { vfs.close(fp); return abi.E_NOMEM; }

    let is i64 as fd = vma.fd_alloc(cast(*vma.Aspace, asp), ko);
    if (fd < 0) { kobject.ko_unref(ko); return abi.E_MFILE; }
    return fd;
}

// SYS_READ(fd, buf, n) — read up to n bytes into the user buffer. Loops a
// page at a time so a large n needs no large kernel staging area; stops at
// EOF (a short VFS read).
fn sys_read(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as n = c;
    if (n < 0) { return abi.E_INVAL; }
    if (n == 0) { return 0; }
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as ko = vma.fd_get(cast(*vma.Aspace, asp), a);
    if (ko == 0) { return abi.E_BADF; }
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);

    let is [4096]u8 as kbuf;
    let is *u8 as kp = cast(*u8, &kbuf[0]);
    let is i64 as total with mut = 0;
    while (total < n) {
        let is i64 as chunk with mut = n - total;
        if (chunk > IO_PAGE_BYTES) { chunk = IO_PAGE_BYTES; }
        let is i64 as got = kobject.ko_read(ko, cast(i64, kp), chunk);
        if (got < 0) {
            if (total > 0) { return total; }
            return got;                                  // already an abi errno
        }
        if (got == 0) { return total; }                 // EOF
        let is i32 as wrc = userspace.copy_to_user(pml4, b + total, kp, got);
        if (wrc != 0) {
            if (total > 0) { return total; }
            return abi.E_FAULT;
        }
        total = total + got;
        if (got < chunk) { return total; }               // short read = EOF
    }
    return total;
}

// SYS_WRITE(fd, buf, n) — write n bytes from the user buffer, page at a time.
fn sys_write(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as n = c;
    if (n < 0) { return abi.E_INVAL; }
    if (n == 0) { return 0; }
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as ko = vma.fd_get(cast(*vma.Aspace, asp), a);
    if (ko == 0) { return abi.E_BADF; }
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);

    let is [4096]u8 as kbuf;
    let is *u8 as kp = cast(*u8, &kbuf[0]);
    let is i64 as total with mut = 0;
    while (total < n) {
        let is i64 as chunk with mut = n - total;
        if (chunk > IO_PAGE_BYTES) { chunk = IO_PAGE_BYTES; }
        let is i32 as rrc = userspace.copy_from_user(pml4, kp, b + total, chunk);
        if (rrc != 0) {
            if (total > 0) { return total; }
            return abi.E_FAULT;
        }
        let is i64 as wrote = kobject.ko_write(ko, cast(i64, kp), chunk);
        if (wrote < 0) {
            if (total > 0) { return total; }
            return wrote;                                // already an abi errno
        }
        total = total + wrote;
        if (wrote < chunk) { return total; }              // short write
    }
    return total;
}

// SYS_CLOSE(fd) — drop the object's fd reference and free the slot. The
// last reference runs the object's close op (the file flushes, etc.).
fn sys_close(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as asp = sched.thr_aspace_ptr(sched.current_tid());
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as ko = vma.fd_get(cast(*vma.Aspace, asp), a);
    if (ko == 0) { return abi.E_BADF; }
    vma.fd_close(cast(*vma.Aspace, asp), a);             // clear the slot first
    kobject.ko_unref(ko);                                // then drop the reference
    return abi.E_OK;
}

// SYS_LSEEK(fd, off, whence) — reposition; returns the new absolute offset.
fn sys_lseek(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as asp = sched.thr_aspace_ptr(sched.current_tid());
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as ko = vma.fd_get(cast(*vma.Aspace, asp), a);
    if (ko == 0) { return abi.E_BADF; }
    return kobject.ko_lseek(ko, b, c);                   // already an abi errno on failure
}

// SYS_UNLINK(path, len) — remove a file. Thin forward to vfs.unlink.
fn sys_unlink(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    if (b <= 0 || b > PATH_MAX) { return abi.E_INVAL; }
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);
    let is [256]u8 as kpath;
    let is *u8 as kp = cast(*u8, &kpath[0]);
    if (userspace.copy_from_user(pml4, kp, a, b) != 0) { return abi.E_FAULT; }
    let is i32 as r = vfs.unlink(kp, b);
    if (r < 0) { return vfs_err_to_abi(cast(i64, r)); }
    return abi.E_OK;
}

// SYS_MKDIR(path, len) — create a directory. Thin forward to vfs.mkdir.
fn sys_mkdir(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    if (b <= 0 || b > PATH_MAX) { return abi.E_INVAL; }
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);
    let is [256]u8 as kpath;
    let is *u8 as kp = cast(*u8, &kpath[0]);
    if (userspace.copy_from_user(pml4, kp, a, b) != 0) { return abi.E_FAULT; }
    let is i32 as r = vfs.mkdir(kp, b);
    if (r < 0) { return vfs_err_to_abi(cast(i64, r)); }
    return abi.E_OK;
}

// SYS_RMDIR(path, len) — remove an empty directory. Thin forward to vfs.rmdir.
fn sys_rmdir(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    if (b <= 0 || b > PATH_MAX) { return abi.E_INVAL; }
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);
    let is [256]u8 as kpath;
    let is *u8 as kp = cast(*u8, &kpath[0]);
    if (userspace.copy_from_user(pml4, kp, a, b) != 0) { return abi.E_FAULT; }
    let is i32 as r = vfs.rmdir(kp, b);
    if (r < 0) { return vfs_err_to_abi(cast(i64, r)); }
    return abi.E_OK;
}

// SYS_RENAME(src, src_len, dst, dst_len) — rename/move. Forward to vfs.rename.
fn sys_rename(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    if (b <= 0 || b > PATH_MAX || d <= 0 || d > PATH_MAX) { return abi.E_INVAL; }
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);
    let is [256]u8 as ksrc;
    let is [256]u8 as kdst;
    let is *u8 as ksp = cast(*u8, &ksrc[0]);
    let is *u8 as kdp = cast(*u8, &kdst[0]);
    if (userspace.copy_from_user(pml4, ksp, a, b) != 0) { return abi.E_FAULT; }
    if (userspace.copy_from_user(pml4, kdp, c, d) != 0) { return abi.E_FAULT; }
    let is i32 as r = vfs.rename(ksp, b, kdp, d);
    if (r < 0) { return vfs_err_to_abi(cast(i64, r)); }
    return abi.E_OK;
}

// SYS_STAT(path, len, out) — fill the user's VfsStat. Forward to vfs.stat_path.
fn sys_stat(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    if (b <= 0 || b > PATH_MAX) { return abi.E_INVAL; }
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);
    let is [256]u8 as kpath;
    let is *u8 as kp = cast(*u8, &kpath[0]);
    if (userspace.copy_from_user(pml4, kp, a, b) != 0) { return abi.E_FAULT; }
    let is vfs.VfsStat as st;
    let is i32 as r = vfs.stat_path(kp, b, &st);
    if (r < 0) { return vfs_err_to_abi(cast(i64, r)); }
    if (userspace.copy_to_user(pml4, c, cast(*u8, &st), sizeof(vfs.VfsStat)) != 0) { return abi.E_FAULT; }
    return abi.E_OK;
}

// SYS_READDIR(fd, out) — next dir entry into the user's VfsDirEntry. Returns
// 0 when an entry is filled; a negative errno (E_NOENT) marks end-of-directory.
fn sys_readdir(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as ko = vma.fd_get(cast(*vma.Aspace, asp), a);
    if (ko == 0) { return abi.E_BADF; }
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);
    let is vfs.VfsDirEntry as de;
    let is i64 as r = kobject.ko_readdir(ko, cast(i64, &de));
    if (r != 0) { return r; }                            // already an abi errno
    if (userspace.copy_to_user(pml4, b, cast(*u8, &de), sizeof(vfs.VfsDirEntry)) != 0) { return abi.E_FAULT; }
    return abi.E_OK;
}

// ============================================================
// Registry — wire the implemented numbers into syscall.dispatch.
// Adding a new syscall = append one install() line + one fn above.
// ============================================================

// ============================================================
// SYS_SPAWN(img, len) — create a child PROCESS from an in-memory CSE
// image and start it. Returns the child pid (a "key" the parent holds),
// or an errno. The child's fd table starts EMPTY: authority is never
// ambient, and explicit fd handoff (the fd-actions list) is deferred
// until VfsFile carries a refcount — sharing a VfsFile across two fd
// tables without one is a use-after-close. Only a process may spawn.
// ============================================================

fn sys_spawn(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as img_uptr = a;
    let is i64 as img_len = b;
    let is i64 as fdacts_uptr = c;
    let is i64 as n_acts with mut = d;
    if (img_len <= 0) { return abi.E_INVAL; }
    if (img_len > 65536) { return abi.E_INVAL; }       // bound v0 image size
    if (n_acts < 0) { n_acts = 0; }
    if (n_acts > 16) { return abi.E_INVAL; }           // bound the fd-action list

    let is i64 as tid = sched.current_tid();
    let is i64 as parent = sched.thr_process_ptr(tid);
    if (parent == 0) { return abi.E_PERM; }            // only processes spawn
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);

    // Copy the fd-actions list up front (before creating a child) so a bad
    // pointer fails cleanly without orphaning one. Each action is a pair of
    // i64: {child_fd, src_fd} — install the KObject the parent holds at
    // src_fd into the child's table at child_fd. Authority is never ambient:
    // the child's table starts empty; fdacts is the only way it gets keys.
    let is [256]u8 as actbuf;                          // 16 * 16 bytes
    if (n_acts > 0) {
        if (fdacts_uptr == 0) { return abi.E_INVAL; }
        if (userspace.copy_from_user(pml4, cast(*u8, &actbuf[0]), fdacts_uptr, n_acts * 16) != 0) {
            return abi.E_FAULT;
        }
    }

    // Snapshot the image into a kernel buffer; proc_spawn copies it into
    // the child's fresh aspace, so the buffer is transient.
    let is i64 as kbuf = heap.kmalloc(img_len, cast(i32, 0));
    if (kbuf == 0) { return abi.E_NOMEM; }
    let is i32 as crc = userspace.copy_from_user(pml4, cast(*u8, kbuf), img_uptr, img_len);
    if (crc != 0) { heap.kfree(kbuf); return abi.E_FAULT; }

    let is i64 as child = userspace.proc_spawn(parent, cast(*u8, kbuf), img_len);
    heap.kfree(kbuf);
    if (child == 0) { return abi.E_NOMEM; }

    // Hand off the requested fds into the still-suspended child. ko_ref
    // keeps the shared KObject (e.g. a channel endpoint) alive across both
    // aspaces — the atomic refcount (Fatia 2a) sustains the double teardown.
    if (n_acts > 0) {
        let is i64 as parent_asp = sched.thr_aspace_ptr(tid);
        let is i64 as child_asp = proc.proc_aspace(child);
        let is *i64 as acts = cast(*i64, &actbuf[0]);
        let is i64 as ai with mut = 0;
        while (ai < n_acts) {
            let is i64 as child_fd = acts[ai * 2 + 0];
            let is i64 as src_fd   = acts[ai * 2 + 1];
            let is i64 as ko = vma.fd_get(cast(*vma.Aspace, parent_asp), src_fd);
            if (ko != 0) {
                kobject.ko_ref(ko);
                if (vma.fd_install(cast(*vma.Aspace, child_asp), child_fd, ko) != 0) {
                    kobject.ko_unref(ko);              // slot busy / oob — undo
                }
            }
            ai = ai + 1;
        }
    }

    userspace.proc_start(child);
    return proc.proc_pid(child);
}

// ============================================================
// SYS_WAIT(pid, status_ptr) — block until a child (pid>0; pid<=0 = any)
// exits, reap it, and return its exit code. If status_ptr != 0 the code
// is also written there (i64). Returns E_AGAIN if no such child exits
// within the wait window. Reaping (free aspace + Process struct) is
// race-free: proc_wait blocks until the deferred reaper has the thread
// off-cpu before tearing down the address space.
// ============================================================

fn sys_wait(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as pid = a;
    let is i64 as status_uptr = b;
    let is i64 as tid = sched.current_tid();
    let is i64 as parent = sched.thr_process_ptr(tid);
    if (parent == 0) { return abi.E_PERM; }

    let is i64 as code = userspace.proc_wait(parent, pid);
    if (code == abi.E_AGAIN) { return abi.E_AGAIN; }

    if (status_uptr != 0) {
        let is i64 as pml4 = sched.thr_aspace_pml4(tid);
        let is [1]i64 as sb;
        sb[0] = code;
        userspace.copy_to_user(pml4, status_uptr, cast(*u8, &sb[0]), 8);
    }
    return code;
}

// ============================================================
// SYS_DEV_OPEN(class, index, flags) — acquire a device by class, return an
// fd (a key). v0: DEV_FB → a surface over the framebuffer. The fd backs a
// KOBJ_SURFACE, not a VfsFile — the fd table is polymorphic. No /dev path,
// no capability monopoly: any program may ask (docs/architecture.md §6).
// ============================================================

fn sys_dev_open(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as class = a;
    let is i64 as asp = sched.thr_aspace_ptr(sched.current_tid());
    if (asp == 0) { return abi.E_INVAL; }

    let is i64 as ko with mut = 0;
    if (class == abi.DEV_FB)            { ko = surface.acquire_fb(); }
    else if (class == abi.DEV_KEYBOARD) { ko = kbd.kbd_acquire(); }
    else                                { return abi.E_INVAL; }
    if (ko == 0) { return abi.E_NOMEM; }

    let is i64 as fd = vma.fd_alloc(cast(*vma.Aspace, asp), ko);
    if (fd < 0) { kobject.ko_unref(ko); return abi.E_MFILE; }
    return fd;
}

// ============================================================
// SYS_PRESENT(fd, x, y, w, h) — publish a surface's dirty rectangle to the
// scanout. Honest per-type op (no ioctl): present only exists on a surface,
// so a non-surface fd returns E_INVAL via the null vtable slot.
// ============================================================

fn sys_present(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as asp = sched.thr_aspace_ptr(sched.current_tid());
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as ko = vma.fd_get(cast(*vma.Aspace, asp), a);
    if (ko == 0) { return abi.E_BADF; }
    return kobject.ko_present(ko, b, c, d, e);
}

// ============================================================
// SYS_CHANNEL_CREATE(out_ptr) — mint a connected channel pair, install
// both endpoints as fds in the caller, and write [fd_a, fd_b] (two i64) to
// out_ptr. The founding IPC primitive: the caller keeps one end and hands
// the other to a child at spawn (fdacts). read/write ride the existing
// SYS_READ/SYS_WRITE — a channel fd is just a KObject.
// ============================================================

fn sys_channel_create(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as out_uptr = a;
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }

    let is i64 as ko_a with mut = 0;
    let is i64 as ko_b with mut = 0;
    if (channel.channel_create(&ko_a, &ko_b) != 0) { return abi.E_NOMEM; }

    let is i64 as fd_a = vma.fd_alloc(cast(*vma.Aspace, asp), ko_a);
    if (fd_a < 0) { kobject.ko_unref(ko_a); kobject.ko_unref(ko_b); return abi.E_MFILE; }
    let is i64 as fd_b = vma.fd_alloc(cast(*vma.Aspace, asp), ko_b);
    if (fd_b < 0) {
        vma.fd_close(cast(*vma.Aspace, asp), fd_a);
        kobject.ko_unref(ko_a); kobject.ko_unref(ko_b);
        return abi.E_MFILE;
    }

    let is [2]i64 as fds;
    fds[0] = fd_a;
    fds[1] = fd_b;
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);
    if (userspace.copy_to_user(pml4, out_uptr, cast(*u8, &fds[0]), 16) != 0) {
        vma.fd_close(cast(*vma.Aspace, asp), fd_a);
        vma.fd_close(cast(*vma.Aspace, asp), fd_b);
        kobject.ko_unref(ko_a); kobject.ko_unref(ko_b);
        return abi.E_FAULT;
    }
    return abi.E_OK;
}

let is i64 as install_fn_addr with mut = 0;

fn install(nr as i64, fp as i64) as void {
    let is fn(i64,i64) as void as f =
        cast(fn(i64,i64) as void, install_fn_addr);
    if (cast(i64, f) == 0) { return; }
    call(f, nr, fp);
}

fn install_all() as void {
    install(abi.SYS_KERN_INFO,       cast(i64, fn_ptr(sys_kern_info)));
    install(abi.SYS_TIME_NOW_NS,     cast(i64, fn_ptr(sys_time_now_ns)));
    install(abi.SYS_TIME_SLEEP_NS,   cast(i64, fn_ptr(sys_time_sleep_ns)));
    install(abi.SYS_PROC_EXIT,       cast(i64, fn_ptr(sys_proc_exit)));
    install(abi.SYS_PROC_GETPID,     cast(i64, fn_ptr(sys_proc_getpid)));
    install(abi.SYS_PROC_YIELD,      cast(i64, fn_ptr(sys_proc_yield)));
    install(abi.SYS_IO_WRITE_SERIAL, cast(i64, fn_ptr(sys_io_write_serial)));
    install(abi.SYS_MMAP,            cast(i64, fn_ptr(sys_mmap)));
    install(abi.SYS_MUNMAP,          cast(i64, fn_ptr(sys_munmap)));
    install(abi.SYS_OPEN,            cast(i64, fn_ptr(sys_open)));
    install(abi.SYS_READ,            cast(i64, fn_ptr(sys_read)));
    install(abi.SYS_WRITE,           cast(i64, fn_ptr(sys_write)));
    install(abi.SYS_CLOSE,           cast(i64, fn_ptr(sys_close)));
    install(abi.SYS_LSEEK,           cast(i64, fn_ptr(sys_lseek)));
    install(abi.SYS_SPAWN,           cast(i64, fn_ptr(sys_spawn)));
    install(abi.SYS_WAIT,            cast(i64, fn_ptr(sys_wait)));
    install(abi.SYS_UNLINK,          cast(i64, fn_ptr(sys_unlink)));
    install(abi.SYS_MKDIR,           cast(i64, fn_ptr(sys_mkdir)));
    install(abi.SYS_RMDIR,           cast(i64, fn_ptr(sys_rmdir)));
    install(abi.SYS_RENAME,          cast(i64, fn_ptr(sys_rename)));
    install(abi.SYS_STAT,            cast(i64, fn_ptr(sys_stat)));
    install(abi.SYS_READDIR,         cast(i64, fn_ptr(sys_readdir)));
    install(abi.SYS_DEV_OPEN,        cast(i64, fn_ptr(sys_dev_open)));
    install(abi.SYS_PRESENT,         cast(i64, fn_ptr(sys_present)));
    install(abi.SYS_CHANNEL_CREATE,  cast(i64, fn_ptr(sys_channel_create)));
}
