// syshandlers.cst — concrete handlers for every causticos syscall
// number defined in abi.cst. Each handler unpacks its own args
// statically (no generic arg-tag interpreter), does whatever
// copy_from_user / copy_to_user it actually needs (no automatic
// policy in the dispatcher), and returns an i64 result.
//
// install_all() at the bottom wires them into syscall.dispatch_table
// via a fn-pointer indirection so the syscall ↔ syshandlers module
// pair stays acyclic.

use "serial.cst" as serial;
use "util.cst" as util;
use "abi.cst" as abi;
use "timer.cst" as timer;
use "sched.cst" as sched;
use "userspace.cst" as userspace;
use "vma.cst" as vma;
use "vfs.cst" as vfs;
use "kobject.cst" as kobject;
use "channel.cst" as channel;
use "driver.cst" as driver;
use "process.cst" as proc;
use "heap.cst" as heap;
use "vmm.cst" as vmm;
use "segment.cst" as segment;
use "pmm.cst" as pmm;
use "fat32.cst" as fat32;

// ============================================================
// SYS_KERN_INFO(buf, buf_size) — fill `buf` with the static KernInfo
// probe (see abi.cst). Userspace calls this once at startup, never per
// call. Returns the number of bytes written (non-negative), or an errno.
//
//   buf_size == 0  → size probe: returns KERN_INFO_SIZE without writing,
//                    so a caller can allocate exactly the right buffer.
//   buf_size  > 0  → writes min(KERN_INFO_SIZE, buf_size) bytes. Copying
//                    only what fits is the append-only contract: an old
//                    binary with a smaller struct still gets a valid
//                    prefix. Returns the byte count written.
//
// No dynamic fields here — the clock lives in SYS_TIME_NOW_NS so a cached
// probe never goes stale.
// ============================================================

fn sys_kern_info(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as user_buf = a;
    let is i64 as buf_size = b;
    if (buf_size < 0) { return abi.E_INVAL; }
    if (buf_size == 0) { return abi.KERN_INFO_SIZE; }

    let is i64 as n with mut = abi.KERN_INFO_SIZE;
    if (buf_size < n) { n = buf_size; }

    let is i64 as pml4 = sched.thr_aspace_pml4(sched.current_tid());
    let is [64]u8 as kbuf;
    let is *u8 as p = cast(*u8, &kbuf[0]);
    let is *i64 as q = cast(*i64, p);
    q[0] = abi.KERN_INFO_SIZE;       // info_size
    q[1] = abi.ABI_MAJOR;            // abi_major
    q[2] = abi.ABI_MINOR;            // abi_minor
    q[3] = abi.SYS_COUNT;            // syscalls_max (probe ceiling)
    q[4] = 4096;                     // page_size
    q[5] = 0;                        // flags (reserved)

    let is i32 as rc = userspace.copy_to_user(pml4, user_buf, p, n);
    if (rc != 0) { return abi.E_FAULT; }
    return n;
}

// ============================================================
// SYS_TIME_NOW_NS — monotonic ns since boot.
// ============================================================

fn sys_time_now_ns(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    return timer.current_time_ns();
}

// ============================================================
// SYS_TIME_SLEEP_NS — block until at least `ns` from now.
// ============================================================

fn sys_time_sleep_ns(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    if (a < 0) { return abi.E_INVAL; }
    sched.sleep_for_ns(a);
    return abi.E_OK;
}

// ============================================================
// SYS_PROC_EXIT — terminate the current thread. Never returns.
// If the thread belongs to a Process, publish the zombie (exit code +
// reparent children) BEFORE scheduling away, so the parent's wait() can
// collect the status. Resource reclamation (kstack/aspace/struct) is the
// reaper's / wait()'s job — the thread still runs on its own kstack here.
// ============================================================

fn sys_proc_exit(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    serial.print("sys.proc_exit: code=", 20);
    util.print_num(a);
    serial.println("", 0);
    let is i64 as p = sched.thr_process_ptr(sched.current_tid());
    if (p != 0) { proc.zombify(p, a); }
    // Close this process's fds NOW, at exit — not later at reap (aspace_destroy).
    // A channel/pipe peer must see EOF the moment the writer exits: a parent that
    // pumps a child's console channel to EOF and only THEN wait()s would otherwise
    // deadlock, since the write end stays open until reap, which comes after the
    // pump. fd_table_drain is idempotent (clears slots), so the reap-time drain is
    // a harmless no-op. (v0 is one-thread-per-process, so thread exit = proc exit.)
    let is i64 as asp = sched.thr_aspace_ptr(sched.current_tid());
    if (asp != 0) { vma.fd_table_drain(cast(*vma.Aspace, asp)); }
    sched.exit_current_thread();
    return 0;
}

// ============================================================
// SYS_PROC_GETPID — current pid. A thread that belongs to a Process
// reports that Process's pid (pid != tid); a kernel-internal user thread
// with no Process (the pre-Process smokes) falls back to its tid.
// ============================================================

fn sys_proc_getpid(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as tid = sched.current_tid();
    let is i64 as p = sched.thr_process_ptr(tid);
    if (p != 0) { return proc.proc_pid(p); }
    return tid;
}

// ============================================================
// SYS_PROC_YIELD — voluntary preempt.
// ============================================================

fn sys_proc_yield(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    sched.yield_cpu();
    return abi.E_OK;
}

// ============================================================
// SYS_IO_WRITE_SERIAL — write `len` bytes from `buf` to the kernel
// serial console. fd-less; the only "channel" we have for stdout
// today. When we add a real fd table on top of VFS, this stays for
// kernel-level diagnostics; userspace stdout migrates to fd 1.
//
// Iterates one page at a time so a 1 MiB buffer doesn't force the
// kernel to allocate a 1 MiB staging area. No arbitrary limit at
// the ABI level — the user can chunk if they want.
// ============================================================

let is i64 as IO_PAGE_BYTES = 4096;

fn sys_io_write_serial(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as user_buf = a;
    let is i64 as len = b;
    if (len < 0) { return abi.E_INVAL; }
    if (len == 0) { return 0; }
    let is i64 as tid = sched.current_tid();
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);
    let is i64 as iobuf = sched.thr_io_buf(tid);   // off-stack staging (was a [4096]u8 on the kstack)
    if (iobuf == 0) { return abi.E_NOMEM; }
    let is *u8 as kp = cast(*u8, iobuf);
    let is i64 as written with mut = 0;
    while (written < len) {
        let is i64 as remaining = len - written;
        let is i64 as chunk with mut = remaining;
        if (chunk > IO_PAGE_BYTES) { chunk = IO_PAGE_BYTES; }
        let is i32 as rc = userspace.copy_from_user(pml4, kp,
                                                     user_buf + written, chunk);
        if (rc != 0) {
            if (written > 0) { return written; }
            return abi.E_FAULT;
        }
        let is i64 as i with mut = 0;
        while (i < chunk) {
            serial.putc(cast(i64, kp[i]));
            i = i + 1;
        }
        written = written + chunk;
    }
    return written;
}

// ============================================================
// SYS_MMAP(hint, len, prot) — anonymous mapping in the caller's address
// space. hint == 0: the kernel picks a free range. hint != 0: the range
// is honoured exactly (VMA_FIXED), failing if it overlaps. Returns the
// base virtual address (always positive — user VAs are below
// 0x00007FFFFFFFFFFF), or an errno. v0 is anonymous + eager only: no fd,
// no offset, no demand paging (mmap_anon maps all pages up front).
// ============================================================

fn sys_mmap(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as hint = a;
    let is i64 as len = b;
    let is i64 as uprot = c;

    let is i64 as asp = sched.thr_aspace_ptr(sched.current_tid());
    if (asp == 0) { return abi.E_INVAL; }

    // ABI prot bits → PTE leaf bits. The mapping adds PTE_PRESENT|PTE_USER;
    // read is implied by present. WRITE → PTE_WRITE; no EXEC → PTE_NX.
    let is i64 as vprot with mut = vma.PROT_USER;
    if ((uprot & abi.MMAP_PROT_WRITE) != 0) { vprot = vprot | vma.PROT_WRITE; }
    if ((uprot & abi.MMAP_PROT_EXEC) == 0)  { vprot = vprot | vma.PROT_NX; }

    // fd-backed mapping (a surface backbuffer): the 4th arg is the fd; the
    // object provides the pages and decides the size, so `len` is ignored.
    if ((uprot & abi.MMAP_FD) != 0) {
        let is i64 as ko = vma.fd_get(cast(*vma.Aspace, asp), d);
        if (ko == 0) { return abi.E_BADF; }
        return kobject.ko_mmap(ko, asp, hint, vprot);
    }

    if (len <= 0) { return abi.E_INVAL; }
    let is i64 as flags with mut = vma.VMA_ANON;
    let is i64 as use_hint with mut = 0;
    if (hint != 0) { flags = flags | vma.VMA_FIXED; use_hint = hint; }

    // Strict reserve (MMAP_RESERVE): claim the VA, back nothing. Touching it
    // faults fatal until SYS_COMMIT. Without the flag: reserve+commit-eager.
    if ((uprot & abi.MMAP_RESERVE) != 0) {
        let is i64 as rva = vma.reserve(cast(*vma.Aspace, asp),
                                        use_hint, len, vprot, flags);
        if (rva < 0) { return abi.E_NOMEM; }
        return rva;
    }

    let is i64 as va = vma.mmap_anon(cast(*vma.Aspace, asp),
                                     use_hint, len, vprot, flags);
    if (va < 0) { return abi.E_NOMEM; }   // mmap_anon returns -1 on failure
    return va;
}

// ============================================================
// SYS_COMMIT(addr, len, prot) — back a reserved range with zero pages. prot
// uses the same MMAP_PROT_* bits as SYS_MMAP. The range must be covered by a
// reservation (E_INVAL otherwise); E_NOMEM if the frames don't exist. 0 on ok.
// ============================================================

fn sys_commit(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as addr = a;
    let is i64 as len = b;
    let is i64 as uprot = c;
    if (len <= 0) { return abi.E_INVAL; }
    let is i64 as asp = sched.thr_aspace_ptr(sched.current_tid());
    if (asp == 0) { return abi.E_INVAL; }

    let is i64 as vprot with mut = vma.PROT_USER;
    if ((uprot & abi.MMAP_PROT_WRITE) != 0) { vprot = vprot | vma.PROT_WRITE; }
    if ((uprot & abi.MMAP_PROT_EXEC) == 0)  { vprot = vprot | vma.PROT_NX; }

    let is i32 as rc = vma.commit(cast(*vma.Aspace, asp), addr, len, vprot);
    if (rc == cast(i32, 0)) { return abi.E_OK; }
    if (rc == cast(i32, abi.E_NOMEM)) { return abi.E_NOMEM; }
    return abi.E_INVAL;
}

// ============================================================
// SYS_DECOMMIT(addr, len) — drop the frames of a range, keep the reservation.
// Touching the range afterward faults again (refault). Always 0.
// ============================================================

fn sys_decommit(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as addr = a;
    let is i64 as len = b;
    if (len <= 0) { return abi.E_INVAL; }
    let is i64 as asp = sched.thr_aspace_ptr(sched.current_tid());
    if (asp == 0) { return abi.E_INVAL; }
    vma.decommit(cast(*vma.Aspace, asp), addr, len);
    return abi.E_OK;
}

// ============================================================
// SYS_SEG_CREATE(npages, flags) — mint a shareable RAM segment and return an fd
// naming it. attach = SYS_MMAP|MMAP_FD on the fd; share = pass the fd at spawn
// (fdacts). SYS_SEG_CLONE(fd) — a second fd/KObject for the same frames.
// ============================================================

fn sys_seg_create(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as npages = a;
    let is i64 as flags = b;
    if (npages <= 0) { return abi.E_INVAL; }
    let is i64 as asp = sched.thr_aspace_ptr(sched.current_tid());
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as ko = segment.seg_create(npages, flags);
    if (ko == 0) { return abi.E_NOMEM; }
    let is i64 as fd = vma.fd_alloc(cast(*vma.Aspace, asp), ko);
    if (fd < 0) { kobject.ko_unref(ko); return abi.E_NOMEM; }   // no free fd slot
    return fd;
}

fn sys_seg_clone(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as srcfd = a;
    let is i64 as asp = sched.thr_aspace_ptr(sched.current_tid());
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as ko = vma.fd_get(cast(*vma.Aspace, asp), srcfd);
    if (ko == 0) { return abi.E_BADF; }
    if (kobject.ko_type(ko) != kobject.KOBJ_SEGMENT) { return abi.E_INVAL; }
    let is i64 as ko2 = segment.seg_clone(ko);
    if (ko2 == 0) { return abi.E_NOMEM; }
    let is i64 as fd = vma.fd_alloc(cast(*vma.Aspace, asp), ko2);
    if (fd < 0) { kobject.ko_unref(ko2); return abi.E_NOMEM; }
    return fd;
}

// SYS_FD_SEND(chan_fd, fd) — pass a KObject reference (any fd) over a channel to
// the peer (SCM_RIGHTS analogue). The kernel ko_refs the object and parks it for
// the peer's recv; E_AGAIN if the direction's slot is occupied. SYS_FD_RECV
// (chan_fd) installs a pending reference at a fresh fd, or E_AGAIN if none.
fn sys_fd_send(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as chan_fd = a;
    let is i64 as src_fd = b;
    let is i64 as asp = sched.thr_aspace_ptr(sched.current_tid());
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as chan_ko = vma.fd_get(cast(*vma.Aspace, asp), chan_fd);
    if (chan_ko == 0) { return abi.E_BADF; }
    if (kobject.ko_type(chan_ko) != kobject.KOBJ_CHANNEL) { return abi.E_INVAL; }
    let is i64 as obj_ko = vma.fd_get(cast(*vma.Aspace, asp), src_fd);
    if (obj_ko == 0) { return abi.E_BADF; }

    kobject.ko_ref(obj_ko);
    let is i64 as rc = channel.chan_send_ko(kobject.ko_priv(chan_ko), obj_ko);
    if (rc != abi.E_OK) { kobject.ko_unref(obj_ko); return rc; }   // slot busy → undo the ref
    return abi.E_OK;
}

fn sys_fd_recv(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as chan_fd = a;
    let is i64 as asp = sched.thr_aspace_ptr(sched.current_tid());
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as chan_ko = vma.fd_get(cast(*vma.Aspace, asp), chan_fd);
    if (chan_ko == 0) { return abi.E_BADF; }
    if (kobject.ko_type(chan_ko) != kobject.KOBJ_CHANNEL) { return abi.E_INVAL; }
    let is i64 as obj_ko = channel.chan_recv_ko(kobject.ko_priv(chan_ko));
    if (obj_ko == 0) { return abi.E_AGAIN; }                       // nothing pending
    let is i64 as fd = vma.fd_alloc(cast(*vma.Aspace, asp), obj_ko);
    if (fd < 0) { kobject.ko_unref(obj_ko); return abi.E_NOMEM; }
    return fd;
}

// ============================================================
// SYS_PROC_KILL(pid) — forced termination of a CHILD. The spawn key is the
// kill authority: only the parent that holds the relationship may use it
// (no ambient pid namespace to attack). The scheduler half (thr_mark_kill /
// kill_finalize) guarantees the target never executes again before we touch
// its process state; teardown then runs FROM THIS CONTEXT — zombify(137),
// fd-table drain (peers see EOF/CLOSED immediately, exactly like a
// voluntary exit) — and the corpse goes to the deferred reaper. wait()
// collects the zombie as usual.
// ============================================================

fn sys_proc_kill(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as me = sched.thr_process_ptr(sched.current_tid());
    if (me == 0) { return abi.E_PERM; }
    let is i64 as child = proc.find_child(me, a);
    if (child == 0) { return abi.E_NOENT; }
    if (proc.proc_state(child) != proc.PROC_ALIVE) { return abi.E_OK; }   // already dying/dead
    let is i64 as tid = proc.proc_first_tid(child);
    if (tid < 0) { return abi.E_NOENT; }

    sched.thr_mark_kill(tid);
    // Wait for it to leave any cpu: the 1ms tick preempts even a pure user
    // spin, and the scheduler parks marked threads instead of resuming them.
    let is i64 as deadline = timer.current_time_ns() + 2000000000;
    while (sched.thr_is_running(tid) == 1) {
        if (timer.current_time_ns() >= deadline) { return abi.E_AGAIN; }
        sched.sleep_for_ns(1000000);
    }
    // Off-cpu and barred from ever returning: process teardown is safe here.
    proc.zombify(child, 137);
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp != 0) { vma.fd_table_drain(cast(*vma.Aspace, asp)); }
    // Scheduler-side finalize (detach from queues/sleepers, queue the reaper).
    let is i64 as tries with mut = 0;
    while (tries < 2000) {
        let is i64 as rc = sched.kill_finalize(tid);
        if (rc >= 0) { return abi.E_OK; }
        sched.sleep_for_ns(1000000);
        tries = tries + 1;
    }
    return abi.E_AGAIN;
}

// ============================================================
// SYS_PROC_LIST(entries_uptr, max) — snapshot the process tree into a
// caller array of ProcInfo (6 i64 each), up to `max`. Returns the TOTAL
// live count so a truncated snapshot is detectable. DFS from init over an
// explicit worklist (no kernel-stack recursion). Read-only and quick; like
// the other process paths it runs without a global proc lock (none exists
// yet) — a concurrent spawn/reap can make the snapshot momentarily
// inconsistent, acceptable for a monitor.
// ============================================================

fn sys_proc_list(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as uptr = a;
    let is i64 as maxn with mut = b;
    if (uptr == 0) { return abi.E_FAULT; }
    if (maxn < 0) { return abi.E_INVAL; }
    if (maxn > abi.PROC_LIST_MAX) { maxn = abi.PROC_LIST_MAX; }
    let is i64 as pml4 = sched.thr_aspace_pml4(sched.current_tid());
    let is [384]i64 as kbuf;            // PROC_LIST_MAX(64) * PROC_INFO_WORDS(6)
    let is [256]i64 as stk;             // DFS worklist of *Process
    let is i64 as sp with mut = 0;
    if (proc.init_proc != 0) { stk[0] = proc.init_proc; sp = 1; }
    let is i64 as total with mut = 0;
    let is i64 as n with mut = 0;
    while (sp > 0) {
        sp = sp - 1;
        let is i64 as p = stk[sp];
        if (p != 0) {
            total = total + 1;
            if (n < maxn) {
                let is i64 as base = n * 6;
                kbuf[base + 0] = proc.proc_pid(p);
                let is i64 as par = proc.proc_parent(p);
                if (par != 0) { kbuf[base + 1] = proc.proc_pid(par); } else { kbuf[base + 1] = 0; }
                kbuf[base + 2] = proc.proc_state(p);
                kbuf[base + 3] = proc.proc_exit_code(p);
                kbuf[base + 4] = proc.proc_thread_count(p);
                let is i64 as asp = proc.proc_aspace(p);
                if (asp != 0) {
                    let is *vma.Aspace as ap = cast(*vma.Aspace, asp);
                    kbuf[base + 5] = ap.committed_bytes;
                } else { kbuf[base + 5] = 0; }
                n = n + 1;
            }
            let is i64 as sib = proc.proc_next_sib(p);
            if (sib != 0 && sp < 256) { stk[sp] = sib; sp = sp + 1; }
            let is i64 as ch = proc.proc_first_child(p);
            if (ch != 0 && sp < 256) { stk[sp] = ch; sp = sp + 1; }
        }
    }
    if (n > 0) {
        if (userspace.copy_to_user(pml4, uptr, cast(*u8, &kbuf[0]), n * 48) != 0) { return abi.E_FAULT; }
    }
    return total;
}

// ============================================================
// SYS_MEM_INFO(out_uptr) — [total_pages, free_pages, page_size,
// committed_bytes_total]. Physical truth from the PMM; committed summed
// over the aspace tree (same walk as PROC_LIST).
// ============================================================

fn sys_mem_info(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as uptr = a;
    if (uptr == 0) { return abi.E_FAULT; }
    let is i64 as pml4 = sched.thr_aspace_pml4(sched.current_tid());
    let is [4]i64 as kbuf;
    let is i64 as total_bytes with mut = 0;
    let is i64 as i with mut = 0;
    let is i64 as rc = pmm.region_count();
    while (i < rc) { total_bytes = total_bytes + pmm.region_len(i); i = i + 1; }
    kbuf[0] = total_bytes / pmm.PAGE_SIZE;
    kbuf[1] = cast(i64, pmm.free_total);
    kbuf[2] = pmm.PAGE_SIZE;
    let is [256]i64 as stk;
    let is i64 as sp with mut = 0;
    if (proc.init_proc != 0) { stk[0] = proc.init_proc; sp = 1; }
    let is i64 as committed with mut = 0;
    while (sp > 0) {
        sp = sp - 1;
        let is i64 as p = stk[sp];
        if (p != 0) {
            let is i64 as asp = proc.proc_aspace(p);
            if (asp != 0) {
                let is *vma.Aspace as ap = cast(*vma.Aspace, asp);
                committed = committed + ap.committed_bytes;
            }
            let is i64 as sib = proc.proc_next_sib(p);
            if (sib != 0 && sp < 256) { stk[sp] = sib; sp = sp + 1; }
            let is i64 as ch = proc.proc_first_child(p);
            if (ch != 0 && sp < 256) { stk[sp] = ch; sp = sp + 1; }
        }
    }
    kbuf[3] = committed;
    if (userspace.copy_to_user(pml4, uptr, cast(*u8, &kbuf[0]), 32) != 0) { return abi.E_FAULT; }
    return abi.E_OK;
}

// ============================================================
// SYS_STATFS(out_uptr) — [total_bytes, free_bytes, block_size] for the
// mounted filesystem. fat32.statfs_fill counts free clusters via the
// FAT (cached), so the scan is cheap.
// ============================================================

fn sys_statfs(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as uptr = a;
    if (uptr == 0) { return abi.E_FAULT; }
    let is i64 as pml4 = sched.thr_aspace_pml4(sched.current_tid());
    let is [3]i64 as kbuf;
    if (fat32.statfs_fill(cast(*i64, &kbuf[0])) != 0) { return abi.E_IO; }
    if (userspace.copy_to_user(pml4, uptr, cast(*u8, &kbuf[0]), 24) != 0) { return abi.E_FAULT; }
    return abi.E_OK;
}

// ============================================================
// SYS_POLL(entries_uptr, n, timeout_ns) — wait-many readiness. The
// single-threaded event loop's only blocking point: sweep every watched fd
// through ko_poll (each object reports under its own lock, briefly), return
// as soon as anything is ready, else nap 1ms (the channel/kbd house style)
// and re-sweep until the HPET deadline. Entries are copied in once and the
// results copied out once; fds are re-resolved on every sweep so a peer's
// close shows up as CLOSED, not a stale pointer. No lock is ever held
// across the nap.
// ============================================================

fn sys_poll(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as uptr = a;
    let is i64 as n = b;
    let is i64 as timeout_ns = c;
    if (n <= 0) { return abi.E_INVAL; }            // a pure sleep is SYS_TIME_SLEEP_NS
    if (n > abi.POLL_MAX_ENTRIES) { return abi.E_INVAL; }
    if (uptr == 0) { return abi.E_FAULT; }
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);

    // 64 entries × 3 i64 = 1536 B on the kstack (32 KiB; sys_spawn stages
    // more). Layout per entry: [i*3+0]=fd, [i*3+1]=want, [i*3+2]=got.
    let is [192]i64 as ents;
    let is i64 as nbytes = n * 24;
    if (userspace.copy_from_user(pml4, cast(*u8, &ents[0]), uptr, nbytes) != 0) {
        return abi.E_FAULT;
    }

    let is i64 as infinite with mut = 0;
    let is i64 as deadline with mut = 0;
    if (timeout_ns < 0) { infinite = 1; }
    else if (timeout_ns > 0) {
        let is i64 as now = timer.current_time_ns();
        deadline = now + timeout_ns;
        if (deadline < now) { infinite = 1; }      // overflow saturates to forever
    }

    let is i64 as ready with mut = 0;
    let is i64 as sweeping with mut = 1;
    while (sweeping == 1) {
        ready = 0;
        let is i64 as i with mut = 0;
        while (i < n) {
            let is i64 as fd = ents[i*3+0];
            let is i64 as want = ents[i*3+1];
            let is i64 as got with mut = 0;
            let is i64 as ko = vma.fd_get(cast(*vma.Aspace, asp), fd);
            if (ko == 0) { got = abi.POLL_ERROR; }
            else {
                let is i64 as st = kobject.ko_poll(ko);
                if (st < 0) { got = abi.POLL_ERROR; }
                else { got = st & (want | abi.POLL_CLOSED | abi.POLL_ERROR); }
            }
            ents[i*3+2] = got;
            if (got != 0) { ready = ready + 1; }
            i = i + 1;
        }
        if (ready > 0) { sweeping = 0; }
        else if (timeout_ns == 0) { sweeping = 0; }
        else if (infinite == 0 && timer.current_time_ns() >= deadline) { sweeping = 0; }
        else { sched.sleep_for_ns(1000000); }
    }

    if (userspace.copy_to_user(pml4, uptr, cast(*u8, &ents[0]), nbytes) != 0) {
        return abi.E_FAULT;
    }
    return ready;
}

// SYS_SEG_COPY(fd, off, ubuf, len, dir) — random-access copy between a segment's
// bytes at [off,off+len) and the user buffer ubuf. dir 0 = read (seg→ubuf), 1 =
// write (ubuf→seg). NOT read/write (no cursor) — a pointed access without
// mapping. Chunks through a kernel buffer so it works for any backing.
fn sys_seg_copy(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as fd = a;
    let is i64 as off = b;
    let is i64 as ubuf = c;
    let is i64 as len = d;
    let is i64 as dir = e;
    if (len <= 0) { return abi.E_INVAL; }
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as ko = vma.fd_get(cast(*vma.Aspace, asp), fd);
    if (ko == 0) { return abi.E_BADF; }
    if (kobject.ko_type(ko) != kobject.KOBJ_SEGMENT) { return abi.E_INVAL; }
    let is i64 as priv = kobject.ko_priv(ko);
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);

    let is [512]u8 as kbuf;
    let is i64 as kb = cast(i64, &kbuf[0]);
    let is i64 as done with mut = 0;
    while (done < len) {
        let is i64 as chunk with mut = 512;
        if (chunk > len - done) { chunk = len - done; }
        if (dir != 0) {
            // write: user -> kbuf -> segment
            if (userspace.copy_from_user(pml4, cast(*u8, kb), ubuf + done, chunk) != 0) {
                return abi.E_FAULT;
            }
            let is i64 as rc = segment.seg_copy_range(priv, off + done, kb, chunk, 1);
            if (rc != abi.E_OK) { return rc; }
        } else {
            // read: segment -> kbuf -> user
            let is i64 as rc = segment.seg_copy_range(priv, off + done, kb, chunk, 0);
            if (rc != abi.E_OK) { return rc; }
            if (userspace.copy_to_user(pml4, ubuf + done, cast(*u8, kb), chunk) != 0) {
                return abi.E_FAULT;
            }
        }
        done = done + chunk;
    }
    return abi.E_OK;
}

// ============================================================
// SYS_MUNMAP(addr, len) — unmap a region. v0 only removes VMAs that fall
// entirely within [addr, addr+len); partial-range splitting isn't
// implemented (vma.munmap returns -1 if nothing matched). Returns 0 or errno.
// ============================================================

fn sys_munmap(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    if (b <= 0) { return abi.E_INVAL; }
    let is i64 as asp = sched.thr_aspace_ptr(sched.current_tid());
    if (asp == 0) { return abi.E_INVAL; }
    let is i32 as rc = vma.munmap(cast(*vma.Aspace, asp), a, b);
    if (rc != 0) { return abi.E_INVAL; }
    return abi.E_OK;
}

// ============================================================
// int-fd file I/O. open() resolves a path through the VFS and parks the
// resulting *VfsFile in the per-aspace fd table; read/write/close/lseek
// look the fd back up. fd is just an index into that table — no caps, no
// generation, no rights. See docs: the capability layers come only when a
// cross-aspace workload (spawn/IPC) needs them.
//
// The VFS returns its own negative error codes; map them to the causticos
// errno set so userspace sees one consistent scheme.
// ============================================================

// VFS_* → abi.E_* . The mapping table lives in vfs.cst (the FILE KObject
// wrappers need it too); this is a thin forward so the path-based metadata
// handlers below keep their call sites.
fn vfs_err_to_abi(rc as i64) as i64 {
    return vfs.err_to_abi(rc);
}

let is i64 as PATH_MAX = 255;

// SYS_OPEN(path, path_len, flags) — open/create a file, return its fd.
// NOTE: vfs.open only signals success/failure (a null handle), not which
// error, so a failed open reports E_NOENT generically. Surfacing the
// precise errno is a VFS-side improvement for later.
fn sys_open(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as path_len = b;
    if (path_len <= 0) { return abi.E_INVAL; }
    if (path_len > PATH_MAX) { return abi.E_INVAL; }
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);

    let is [256]u8 as kpath;
    let is *u8 as kp = cast(*u8, &kpath[0]);
    let is i32 as crc = userspace.copy_from_user(pml4, kp, a, path_len);
    if (crc != 0) { return abi.E_FAULT; }

    let is *vfs.VfsFile as fp = vfs.open(kp, path_len, cast(i32, c));
    if (cast(i64, fp) == 0) { return abi.E_NOENT; }

    // Wrap the open file in a KObject (the fd-table entry is a *KObject,
    // not a *VfsFile — an fd can back a file, surface, channel, or device).
    let is i64 as ko = vfs.make_file_kobject(fp);
    if (ko == 0) { vfs.close(fp); return abi.E_NOMEM; }

    let is i64 as fd = vma.fd_alloc(cast(*vma.Aspace, asp), ko);
    if (fd < 0) { kobject.ko_unref(ko); return abi.E_MFILE; }
    return fd;
}

// SYS_READ(fd, buf, n) — read up to n bytes into the user buffer. Loops a
// page at a time so a large n needs no large kernel staging area; stops at
// EOF (a short VFS read).
fn sys_read(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as n = c;
    if (n < 0) { return abi.E_INVAL; }
    if (n == 0) { return 0; }
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as ko = vma.fd_get(cast(*vma.Aspace, asp), a);
    if (ko == 0) { return abi.E_BADF; }
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);

    let is i64 as iobuf = sched.thr_io_buf(tid);   // off-stack staging (was a [4096]u8 on the kstack)
    if (iobuf == 0) { return abi.E_NOMEM; }
    let is *u8 as kp = cast(*u8, iobuf);
    let is i64 as total with mut = 0;
    while (total < n) {
        let is i64 as chunk with mut = n - total;
        if (chunk > IO_PAGE_BYTES) { chunk = IO_PAGE_BYTES; }
        let is i64 as got = kobject.ko_read(ko, cast(i64, kp), chunk);
        if (got < 0) {
            if (total > 0) { return total; }
            return got;                                  // already an abi errno
        }
        if (got == 0) { return total; }                 // EOF
        let is i32 as wrc = userspace.copy_to_user(pml4, b + total, kp, got);
        if (wrc != 0) {
            if (total > 0) { return total; }
            return abi.E_FAULT;
        }
        total = total + got;
        if (got < chunk) { return total; }               // short read = EOF
    }
    return total;
}

// SYS_WRITE(fd, buf, n) — write n bytes from the user buffer, page at a time.
fn sys_write(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as n = c;
    if (n < 0) { return abi.E_INVAL; }
    if (n == 0) { return 0; }
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as ko = vma.fd_get(cast(*vma.Aspace, asp), a);
    if (ko == 0) { return abi.E_BADF; }
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);

    let is i64 as iobuf = sched.thr_io_buf(tid);   // off-stack staging (was a [4096]u8 on the kstack)
    if (iobuf == 0) { return abi.E_NOMEM; }
    let is *u8 as kp = cast(*u8, iobuf);
    let is i64 as total with mut = 0;
    while (total < n) {
        let is i64 as chunk with mut = n - total;
        if (chunk > IO_PAGE_BYTES) { chunk = IO_PAGE_BYTES; }
        let is i32 as rrc = userspace.copy_from_user(pml4, kp, b + total, chunk);
        if (rrc != 0) {
            if (total > 0) { return total; }
            return abi.E_FAULT;
        }
        let is i64 as wrote = kobject.ko_write(ko, cast(i64, kp), chunk);
        if (wrote < 0) {
            if (total > 0) { return total; }
            return wrote;                                // already an abi errno
        }
        total = total + wrote;
        if (wrote < chunk) { return total; }              // short write
    }
    return total;
}

// SYS_CLOSE(fd) — drop the object's fd reference and free the slot. The
// last reference runs the object's close op (the file flushes, etc.).
fn sys_close(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as asp = sched.thr_aspace_ptr(sched.current_tid());
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as ko = vma.fd_get(cast(*vma.Aspace, asp), a);
    if (ko == 0) { return abi.E_BADF; }
    vma.fd_close(cast(*vma.Aspace, asp), a);             // clear the slot first
    kobject.ko_unref(ko);                                // then drop the reference
    return abi.E_OK;
}

// SYS_LSEEK(fd, off, whence) — reposition; returns the new absolute offset.
fn sys_lseek(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as asp = sched.thr_aspace_ptr(sched.current_tid());
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as ko = vma.fd_get(cast(*vma.Aspace, asp), a);
    if (ko == 0) { return abi.E_BADF; }
    return kobject.ko_lseek(ko, b, c);                   // already an abi errno on failure
}

// SYS_UNLINK(path, len) — remove a file. Thin forward to vfs.unlink.
fn sys_unlink(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    if (b <= 0 || b > PATH_MAX) { return abi.E_INVAL; }
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);
    let is [256]u8 as kpath;
    let is *u8 as kp = cast(*u8, &kpath[0]);
    if (userspace.copy_from_user(pml4, kp, a, b) != 0) { return abi.E_FAULT; }
    let is i32 as r = vfs.unlink(kp, b);
    if (r < 0) { return vfs_err_to_abi(cast(i64, r)); }
    return abi.E_OK;
}

// SYS_MKDIR(path, len) — create a directory. Thin forward to vfs.mkdir.
fn sys_mkdir(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    if (b <= 0 || b > PATH_MAX) { return abi.E_INVAL; }
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);
    let is [256]u8 as kpath;
    let is *u8 as kp = cast(*u8, &kpath[0]);
    if (userspace.copy_from_user(pml4, kp, a, b) != 0) { return abi.E_FAULT; }
    let is i32 as r = vfs.mkdir(kp, b);
    if (r < 0) { return vfs_err_to_abi(cast(i64, r)); }
    return abi.E_OK;
}

// SYS_RMDIR(path, len) — remove an empty directory. Thin forward to vfs.rmdir.
fn sys_rmdir(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    if (b <= 0 || b > PATH_MAX) { return abi.E_INVAL; }
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);
    let is [256]u8 as kpath;
    let is *u8 as kp = cast(*u8, &kpath[0]);
    if (userspace.copy_from_user(pml4, kp, a, b) != 0) { return abi.E_FAULT; }
    let is i32 as r = vfs.rmdir(kp, b);
    if (r < 0) { return vfs_err_to_abi(cast(i64, r)); }
    return abi.E_OK;
}

// SYS_RENAME(src, src_len, dst, dst_len) — rename/move. Forward to vfs.rename.
fn sys_rename(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    if (b <= 0 || b > PATH_MAX || d <= 0 || d > PATH_MAX) { return abi.E_INVAL; }
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);
    let is [256]u8 as ksrc;
    let is [256]u8 as kdst;
    let is *u8 as ksp = cast(*u8, &ksrc[0]);
    let is *u8 as kdp = cast(*u8, &kdst[0]);
    if (userspace.copy_from_user(pml4, ksp, a, b) != 0) { return abi.E_FAULT; }
    if (userspace.copy_from_user(pml4, kdp, c, d) != 0) { return abi.E_FAULT; }
    let is i32 as r = vfs.rename(ksp, b, kdp, d);
    if (r < 0) { return vfs_err_to_abi(cast(i64, r)); }
    return abi.E_OK;
}

// SYS_STAT(path, len, out) — fill the user's VfsStat. Forward to vfs.stat_path.
fn sys_stat(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    if (b <= 0 || b > PATH_MAX) { return abi.E_INVAL; }
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);
    let is [256]u8 as kpath;
    let is *u8 as kp = cast(*u8, &kpath[0]);
    if (userspace.copy_from_user(pml4, kp, a, b) != 0) { return abi.E_FAULT; }
    let is vfs.VfsStat as st;
    let is i32 as r = vfs.stat_path(kp, b, &st);
    if (r < 0) { return vfs_err_to_abi(cast(i64, r)); }
    if (userspace.copy_to_user(pml4, c, cast(*u8, &st), sizeof(vfs.VfsStat)) != 0) { return abi.E_FAULT; }
    return abi.E_OK;
}

// SYS_READDIR(fd, out) — next dir entry into the user's VfsDirEntry. Returns
// 0 when an entry is filled; a negative errno (E_NOENT) marks end-of-directory.
fn sys_readdir(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as ko = vma.fd_get(cast(*vma.Aspace, asp), a);
    if (ko == 0) { return abi.E_BADF; }
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);
    let is vfs.VfsDirEntry as de;
    let is i64 as r = kobject.ko_readdir(ko, cast(i64, &de));
    if (r != 0) { return r; }                            // already an abi errno
    if (userspace.copy_to_user(pml4, b, cast(*u8, &de), sizeof(vfs.VfsDirEntry)) != 0) { return abi.E_FAULT; }
    return abi.E_OK;
}

// ============================================================
// Registry — wire the implemented numbers into syscall.dispatch.
// Adding a new syscall = append one install() line + one fn above.
// ============================================================

// ============================================================
// SYS_SPAWN(img, len) — create a child PROCESS from an in-memory CSE
// image and start it. Returns the child pid (a "key" the parent holds),
// or an errno. The child's fd table starts EMPTY: authority is never
// ambient, and explicit fd handoff (the fd-actions list) is deferred
// until VfsFile carries a refcount — sharing a VfsFile across two fd
// tables without one is a use-after-close. Only a process may spawn.
// ============================================================

fn sys_spawn(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as params_uptr = a;                     // rdi = *SpawnParams
    let is i64 as tid = sched.current_tid();
    let is i64 as parent = sched.thr_process_ptr(tid);
    if (parent == 0) { return abi.E_PERM; }            // only processes spawn
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);

    // One copy of the whole parameter block (the 6 prior positional args + the
    // budget grant). All later validation/use reads sp.field.
    if (params_uptr == 0) { return abi.E_INVAL; }
    let is abi.SpawnParams as sp;
    if (userspace.copy_from_user(pml4, cast(*u8, &sp), params_uptr,
                                 sizeof(abi.SpawnParams)) != 0) {
        return abi.E_FAULT;
    }
    let is i64 as img_uptr = sp.img_uptr;
    let is i64 as img_len = sp.img_len;
    let is i64 as fdacts_uptr = sp.fdacts_uptr;
    let is i64 as n_acts with mut = sp.n_acts;
    if (img_len <= 0) { return abi.E_INVAL; }
    if (img_len > abi.SPAWN_IMG_MAX) { return abi.E_INVAL; }   // sanity bound on a spawned image (kvmap-staged, see below)
    if (n_acts < 0) { n_acts = 0; }
    if (n_acts > 16) { return abi.E_INVAL; }           // bound the fd-action list
    if (sp.budget < 0) { return abi.E_INVAL; }         // budget is a ceiling, not negative

    // Copy the fd-actions list up front (before creating a child) so a bad
    // pointer fails cleanly without orphaning one. Each action is a pair of
    // i64: {child_fd, src_fd} — install the KObject the parent holds at
    // src_fd into the child's table at child_fd. Authority is never ambient:
    // the child's table starts empty; fdacts is the only way it gets keys.
    let is [256]u8 as actbuf;                          // 16 * 16 bytes
    if (n_acts > 0) {
        if (fdacts_uptr == 0) { return abi.E_INVAL; }
        if (userspace.copy_from_user(pml4, cast(*u8, &actbuf[0]), fdacts_uptr, n_acts * 16) != 0) {
            return abi.E_FAULT;
        }
    }

    // Copy the argv vector up front too. argv is DATA, not authority
    // (architecture §2): the kernel copies the strings and later lays them on
    // the child's stack, but resolves NOTHING from them — a path in argv is
    // just bytes. Authority still travels only as fds (fdacts above). argc == 0
    // → the child gets the default argv = ["child"]. Bounded: ≤32 args, ≤256 B
    // each, ≤2048 B total.
    let is i64 as argv_uptr = sp.argv_uptr;
    let is i64 as argc with mut = sp.argc;
    let is [512]u8 as argdesc;                         // 32 × 16
    let is [2048]u8 as argstr;
    let is [32]i64 as argv_ptrs;
    let is [32]i64 as argv_lens;
    if (argc < 0) { argc = 0; }
    if (argc > 32) { return abi.E_INVAL; }
    if (argc > 0) {
        if (argv_uptr == 0) { return abi.E_INVAL; }
        if (userspace.copy_from_user(pml4, cast(*u8, &argdesc[0]), argv_uptr, argc * 16) != 0) {
            return abi.E_FAULT;
        }
        let is *i64 as descs = cast(*i64, &argdesc[0]);
        let is i64 as soff with mut = 0;
        let is i64 as ai with mut = 0;
        while (ai < argc) {
            let is i64 as sp = descs[ai * 2 + 0];
            let is i64 as sl with mut = descs[ai * 2 + 1];
            if (sl < 0) { sl = 0; }
            if (sl > 256) { return abi.E_INVAL; }
            if (soff + sl > 2048) { return abi.E_INVAL; }
            if (sl > 0) {
                if (sp == 0) { return abi.E_FAULT; }
                if (userspace.copy_from_user(pml4, cast(*u8, &argstr[soff]), sp, sl) != 0) {
                    return abi.E_FAULT;
                }
            }
            argv_ptrs[ai] = cast(i64, &argstr[soff]);
            argv_lens[ai] = sl;
            soff = soff + sl;
            ai = ai + 1;
        }
    }

    // Snapshot the image into a transient kernel buffer; proc_spawn copies it
    // into the child's fresh aspace. Staged via kvmap(KV_DATA) — scattered
    // frames behind a contiguous VA — NOT a contiguous kmalloc: a multi-MiB
    // image (the self-host compiler is >1 MiB) needs a 2 MiB+ buddy block that
    // a fragmented heap can lack even with ~1 GiB free, which spuriously
    // E_NOMEM'd the spawn. kvmap only needs free pages, not a contiguous run.
    let is i64 as kbuf = vmm.kvmap(img_len, vmm.KV_DATA, 0, 0);
    if (kbuf == 0) { return abi.E_NOMEM; }
    let is i32 as crc = userspace.copy_from_user(pml4, cast(*u8, kbuf), img_uptr, img_len);
    if (crc != 0) { vmm.kvunmap(kbuf); return abi.E_FAULT; }

    let is i64 as child with mut = 0;
    if (argc > 0) {
        child = userspace.proc_spawn_argv(parent, cast(*u8, kbuf), img_len,
                                          cast(*i64, &argv_ptrs[0]), cast(*i64, &argv_lens[0]), argc);
    } else {
        child = userspace.proc_spawn(parent, cast(*u8, kbuf), img_len);
    }
    vmm.kvunmap(kbuf);
    if (child == 0) { return abi.E_NOMEM; }

    // Hand off the requested fds into the still-suspended child. ko_ref
    // keeps the shared KObject (e.g. a channel endpoint) alive across both
    // aspaces — the atomic refcount (Fatia 2a) sustains the double teardown.
    if (n_acts > 0) {
        let is i64 as parent_asp = sched.thr_aspace_ptr(tid);
        let is i64 as child_asp = proc.proc_aspace(child);
        let is *i64 as acts = cast(*i64, &actbuf[0]);
        let is i64 as ai with mut = 0;
        while (ai < n_acts) {
            let is i64 as child_fd = acts[ai * 2 + 0];
            let is i64 as src_fd   = acts[ai * 2 + 1];
            let is i64 as ko = vma.fd_get(cast(*vma.Aspace, parent_asp), src_fd);
            if (ko != 0) {
                kobject.ko_ref(ko);
                if (vma.fd_install(cast(*vma.Aspace, child_asp), child_fd, ko) != 0) {
                    kobject.ko_unref(ko);              // slot busy / oob — undo
                }
            }
            ai = ai + 1;
        }
    }

    // Grant the child its memory budget (Phase G): the parent's chosen ceiling
    // on committed_bytes. 0 = unlimited (physical only). Written while the child
    // is still suspended, before it runs; commit (Phase E) enforces it. Explicit
    // authority, like fds via fdacts — without a grant, only the machine limits
    // the child, and a reserve-bomb is confined to itself (radius = the child).
    if (sp.budget > 0) {
        let is i64 as casp = proc.proc_aspace(child);
        if (casp != 0) {
            let is *vma.Aspace as ca = cast(*vma.Aspace, casp);
            ca.budget = sp.budget;
        }
    }

    userspace.proc_start(child);
    return proc.proc_pid(child);
}

// ============================================================
// SYS_WAIT(pid, status_ptr) — block until a child (pid>0; pid<=0 = any)
// exits, reap it, and return its exit code. If status_ptr != 0 the code
// is also written there (i64). Returns E_AGAIN if no such child exits
// within the wait window. Reaping (free aspace + Process struct) is
// race-free: proc_wait blocks until the deferred reaper has the thread
// off-cpu before tearing down the address space.
// ============================================================

fn sys_wait(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as pid = a;
    let is i64 as status_uptr = b;
    let is i64 as tid = sched.current_tid();
    let is i64 as parent = sched.thr_process_ptr(tid);
    if (parent == 0) { return abi.E_PERM; }

    let is i64 as code = userspace.proc_wait(parent, pid);
    if (code == abi.E_AGAIN) { return abi.E_AGAIN; }

    if (status_uptr != 0) {
        let is i64 as pml4 = sched.thr_aspace_pml4(tid);
        let is [1]i64 as sb;
        sb[0] = code;
        userspace.copy_to_user(pml4, status_uptr, cast(*u8, &sb[0]), 8);
    }
    return code;
}

// ============================================================
// SYS_DEV_OPEN(class, index, flags) — acquire a device by class, return an
// fd (a key). v0: DEV_FB → a surface over the framebuffer. The fd backs a
// KOBJ_SURFACE, not a VfsFile — the fd table is polymorphic. No /dev path,
// no capability monopoly: any program may ask (docs/architecture.md §6).
// ============================================================

fn sys_dev_open(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as class = a;
    let is i64 as index = b;
    let is i64 as asp = sched.thr_aspace_ptr(sched.current_tid());
    if (asp == 0) { return abi.E_INVAL; }

    // Resolve (class, index) through the device-class registry — whichever
    // driver announced this instance at bind time (the framebuffer at init).
    // No hardcoded switch: a new device is one more registration. The index is
    // REAL — dev_open(DEV_KEYBOARD, 1) with a single keyboard is E_NOENT, not a
    // silent alias of instance 0. acquire runs outside the registry lock.
    let is i64 as ctx with mut = 0;
    let is i64 as af = driver.device_resolve(class, index, &ctx);
    if (af == 0) { return abi.E_NOENT; }                // no such (class, index)
    let is fn(i64) as i64 as acquire = cast(fn(i64) as i64, af);
    let is i64 as ko = call(acquire, ctx);
    if (ko == 0) { return abi.E_NOMEM; }                // instance exists, acquire failed

    let is i64 as fd = vma.fd_alloc(cast(*vma.Aspace, asp), ko);
    if (fd < 0) { kobject.ko_unref(ko); return abi.E_MFILE; }
    return fd;
}

// SYS_DEV_COUNT(class) — how many instances of `class` are registered (>= 0).
// The enumeration counterpart of dev_open: a userspace device manager asks
// this, then dev_opens each index 0..count-1. Pure query, no aspace, no fault
// path; an unserved class is honestly 0, not an error.
fn sys_dev_count(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    return driver.device_count(a);
}

// ============================================================
// SYS_PRESENT(fd, x, y, w, h) — publish a surface's dirty rectangle to the
// scanout. Honest per-type op (no ioctl): present only exists on a surface,
// so a non-surface fd returns E_INVAL via the null vtable slot.
// ============================================================

fn sys_present(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as asp = sched.thr_aspace_ptr(sched.current_tid());
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as ko = vma.fd_get(cast(*vma.Aspace, asp), a);
    if (ko == 0) { return abi.E_BADF; }
    return kobject.ko_present(ko, b, c, d, e);
}

// SYS_SURFACE_INFO(fd, out) — the read-counterpart of present. `fd` must be a
// surface; copies {width, height, pitch, bpp_bytes, format} (5×i64 = 40 B) to
// `out` so the holder can index its mmap'd backbuffer (pitch != width×bpp when
// the row is padded). Type checked here, not via a KObjectOps slot — surface is
// the only kind that needs "info", so the shared vtable stays lean.
fn sys_surface_info(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as asp = sched.thr_aspace_ptr(sched.current_tid());
    if (asp == 0) { return abi.E_INVAL; }
    let is i64 as ko = vma.fd_get(cast(*vma.Aspace, asp), a);
    if (ko == 0) { return abi.E_BADF; }
    let is *kobject.KObject as kop = cast(*kobject.KObject, ko);
    if (kop.otype != kobject.KOBJ_SURFACE) { return abi.E_INVAL; }
    let is *surface.Surface as sfc = cast(*surface.Surface, kop.priv);
    let is [5]i64 as info;
    info[0] = sfc.width;
    info[1] = sfc.height;
    info[2] = sfc.pitch;
    info[3] = sfc.bpp_bytes;
    info[4] = abi.SURFACE_FMT_XRGB8888;
    let is i64 as pml4 = sched.thr_aspace_pml4(sched.current_tid());
    if (userspace.copy_to_user(pml4, b, cast(*u8, &info[0]), 40) != 0) { return abi.E_FAULT; }
    return abi.E_OK;
}

// ============================================================
// SYS_CHANNEL_CREATE(out_ptr) — mint a connected channel pair, install
// both endpoints as fds in the caller, and write [fd_a, fd_b] (two i64) to
// out_ptr. The founding IPC primitive: the caller keeps one end and hands
// the other to a child at spawn (fdacts). read/write ride the existing
// SYS_READ/SYS_WRITE — a channel fd is just a KObject.
// ============================================================

fn sys_channel_create(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64) as i64 {
    let is i64 as out_uptr = a;
    let is i64 as tid = sched.current_tid();
    let is i64 as asp = sched.thr_aspace_ptr(tid);
    if (asp == 0) { return abi.E_INVAL; }

    let is i64 as ko_a with mut = 0;
    let is i64 as ko_b with mut = 0;
    if (channel.channel_create(&ko_a, &ko_b) != 0) { return abi.E_NOMEM; }

    let is i64 as fd_a = vma.fd_alloc(cast(*vma.Aspace, asp), ko_a);
    if (fd_a < 0) { kobject.ko_unref(ko_a); kobject.ko_unref(ko_b); return abi.E_MFILE; }
    let is i64 as fd_b = vma.fd_alloc(cast(*vma.Aspace, asp), ko_b);
    if (fd_b < 0) {
        vma.fd_close(cast(*vma.Aspace, asp), fd_a);
        kobject.ko_unref(ko_a); kobject.ko_unref(ko_b);
        return abi.E_MFILE;
    }

    let is [2]i64 as fds;
    fds[0] = fd_a;
    fds[1] = fd_b;
    let is i64 as pml4 = sched.thr_aspace_pml4(tid);
    if (userspace.copy_to_user(pml4, out_uptr, cast(*u8, &fds[0]), 16) != 0) {
        vma.fd_close(cast(*vma.Aspace, asp), fd_a);
        vma.fd_close(cast(*vma.Aspace, asp), fd_b);
        kobject.ko_unref(ko_a); kobject.ko_unref(ko_b);
        return abi.E_FAULT;
    }
    return abi.E_OK;
}

let is i64 as install_fn_addr with mut = 0;

fn install(nr as i64, fp as i64) as void {
    let is fn(i64,i64) as void as f =
        cast(fn(i64,i64) as void, install_fn_addr);
    if (cast(i64, f) == 0) { return; }
    call(f, nr, fp);
}

fn install_all() as void {
    install(abi.SYS_KERN_INFO,       cast(i64, fn_ptr(sys_kern_info)));
    install(abi.SYS_TIME_NOW_NS,     cast(i64, fn_ptr(sys_time_now_ns)));
    install(abi.SYS_TIME_SLEEP_NS,   cast(i64, fn_ptr(sys_time_sleep_ns)));
    install(abi.SYS_PROC_EXIT,       cast(i64, fn_ptr(sys_proc_exit)));
    install(abi.SYS_PROC_GETPID,     cast(i64, fn_ptr(sys_proc_getpid)));
    install(abi.SYS_PROC_YIELD,      cast(i64, fn_ptr(sys_proc_yield)));
    install(abi.SYS_IO_WRITE_SERIAL, cast(i64, fn_ptr(sys_io_write_serial)));
    install(abi.SYS_MMAP,            cast(i64, fn_ptr(sys_mmap)));
    install(abi.SYS_MUNMAP,          cast(i64, fn_ptr(sys_munmap)));
    install(abi.SYS_OPEN,            cast(i64, fn_ptr(sys_open)));
    install(abi.SYS_READ,            cast(i64, fn_ptr(sys_read)));
    install(abi.SYS_WRITE,           cast(i64, fn_ptr(sys_write)));
    install(abi.SYS_CLOSE,           cast(i64, fn_ptr(sys_close)));
    install(abi.SYS_LSEEK,           cast(i64, fn_ptr(sys_lseek)));
    install(abi.SYS_SPAWN,           cast(i64, fn_ptr(sys_spawn)));
    install(abi.SYS_WAIT,            cast(i64, fn_ptr(sys_wait)));
    install(abi.SYS_UNLINK,          cast(i64, fn_ptr(sys_unlink)));
    install(abi.SYS_MKDIR,           cast(i64, fn_ptr(sys_mkdir)));
    install(abi.SYS_RMDIR,           cast(i64, fn_ptr(sys_rmdir)));
    install(abi.SYS_RENAME,          cast(i64, fn_ptr(sys_rename)));
    install(abi.SYS_STAT,            cast(i64, fn_ptr(sys_stat)));
    install(abi.SYS_READDIR,         cast(i64, fn_ptr(sys_readdir)));
    install(abi.SYS_DEV_OPEN,        cast(i64, fn_ptr(sys_dev_open)));
    install(abi.SYS_DEV_COUNT,       cast(i64, fn_ptr(sys_dev_count)));
    install(abi.SYS_PRESENT,         cast(i64, fn_ptr(sys_present)));
    install(abi.SYS_SURFACE_INFO,    cast(i64, fn_ptr(sys_surface_info)));
    install(abi.SYS_CHANNEL_CREATE,  cast(i64, fn_ptr(sys_channel_create)));
    install(abi.SYS_COMMIT,          cast(i64, fn_ptr(sys_commit)));
    install(abi.SYS_DECOMMIT,        cast(i64, fn_ptr(sys_decommit)));
    install(abi.SYS_SEG_CREATE,      cast(i64, fn_ptr(sys_seg_create)));
    install(abi.SYS_SEG_CLONE,       cast(i64, fn_ptr(sys_seg_clone)));
    install(abi.SYS_SEG_COPY,        cast(i64, fn_ptr(sys_seg_copy)));
    install(abi.SYS_FD_SEND,         cast(i64, fn_ptr(sys_fd_send)));
    install(abi.SYS_FD_RECV,         cast(i64, fn_ptr(sys_fd_recv)));
    install(abi.SYS_POLL,            cast(i64, fn_ptr(sys_poll)));
    install(abi.SYS_PROC_KILL,       cast(i64, fn_ptr(sys_proc_kill)));
    install(abi.SYS_PROC_LIST,       cast(i64, fn_ptr(sys_proc_list)));
    install(abi.SYS_MEM_INFO,        cast(i64, fn_ptr(sys_mem_info)));
    install(abi.SYS_STATFS,          cast(i64, fn_ptr(sys_statfs)));
}
