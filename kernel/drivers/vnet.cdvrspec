# virtio-net — paravirtual NIC (modern virtio over PCI: vendor 0x1AF4,
# device 0x1040+1 = 0x1041). Second consumer of the virtio.cst transport.
# Legacy INTx routed via IOAPIC; the transport windows come from the PCI
# vendor capabilities, so no fixed mmio BAR is declared.

driver "vnet" {
    match {
        bus: pci
        vendor: 0x1AF4
        device: 0x1041
    }
    capabilities {
        irq: auto
    }
    # Same class as the e1000: dev_count(DEV_NET) answers 2 on a machine with
    # both, and userspace picks by index without either driver knowing the
    # other exists.
    device {
        class: net
        acquire: netdev.net_acquire
    }
    lifecycle {
        on_bind: vnet.vnet_bind
        on_irq: vnet.vnet_irq
    }
}
