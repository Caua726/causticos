// pci.cst — PCI bus integration with the driver framework.
//
// Mechanism #1 config-space access + per-function Hardware allocation.
// A single BusNode is registered for bus 0; PCI-to-PCI bridges
// enumerate their secondary bus inline, attaching children to the
// bridge PciHardware rather than spawning new BusNodes.

use "port.cst" as port;
use "driver.cst" as driver;
use "heap.cst" as heap;
use "spec.cst" as spec;
use "serial.cst" as serial;
use "util.cst" as util;

let is i64 as CONFIG_ADDRESS = 0xCF8;
let is i64 as CONFIG_DATA    = 0xCFC;

fn pci_addr(bus as i32, dev as i32, func as i32, off as i32) as i64 {
    let is i64 as a with mut = 0x80000000;
    a = a | (cast(i64, bus)  << 16);
    a = a | (cast(i64, dev)  << 11);
    a = a | (cast(i64, func) << 8);
    a = a | (cast(i64, off)  & 0xFC);
    return a;
}

fn pci_config_read32(bus as i32, dev as i32, func as i32, off as i32) as i64 {
    port.outl(CONFIG_ADDRESS, pci_addr(bus, dev, func, off));
    return port.inl(CONFIG_DATA);
}

fn pci_config_read16(bus as i32, dev as i32, func as i32, off as i32) as i64 {
    let is i64 as dw = pci_config_read32(bus, dev, func, off);
    return (dw >> (cast(i64, (off & 2)) * 8)) & 0xFFFF;
}

fn pci_config_read8(bus as i32, dev as i32, func as i32, off as i32) as i64 {
    let is i64 as dw = pci_config_read32(bus, dev, func, off);
    return (dw >> (cast(i64, (off & 3)) * 8)) & 0xFF;
}

fn pci_config_write32(bus as i32, dev as i32, func as i32, off as i32, val as i64) as void {
    port.outl(CONFIG_ADDRESS, pci_addr(bus, dev, func, off));
    port.outl(CONFIG_DATA, val);
}

// All scalar fields are i64 — mixed-width struct layouts hit a codegen
// issue that caused adjacent fields to overlap.
//
// bar0 holds the decoded base address: low 32 bits for 32-bit BARs, full
// 64 bits with the high dword from offset 0x14 merged in for 64-bit BARs.
// Type/prefetch bits are masked off. Additional BARs (1,2,3,4,5) are not
// stored — add them when a driver actually needs one.
struct PciHardware {
    base as driver.Hardware;
    bus as i64;
    dev as i64;
    func as i64;
    vendor as i64;
    device_id as i64;
    class_code as i64;
    subclass as i64;
    prog_if as i64;
    revision as i64;
    header_type as i64;
    bar0 as i64;
}

let is driver.Bus     as pci_bt;
let is driver.BusNode as pci_bi0;

// spec.cst dispatches bus-specific scalar predicates here so spec matching
// stays decoupled from PciHardware's layout.
fn pci_get_match_field(hw as *driver.Hardware, kind as i64) as i64 {
    let is *PciHardware as pd = cast(*PciHardware, hw);
    if (kind == driver.MATCH_VENDOR)   { return pd.vendor; }
    if (kind == driver.MATCH_DEVICE)   { return pd.device_id; }
    if (kind == driver.MATCH_CLASS)    { return pd.class_code; }
    if (kind == driver.MATCH_SUBCLASS) { return pd.subclass; }
    if (kind == driver.MATCH_PROG_IF)  { return pd.prog_if; }
    return cast(i64, 0 - 1);
}

// Phase 3: resolve a BAR index into a physical address for the spec
// framework's MMIO capability. Only BAR0 is cached in PciHardware today
// (other BARs aren't needed by the current drivers); extending to 1..5
// is a layout change in PciHardware, not in this function's contract.
fn pci_get_bar_info(hw as *driver.Hardware, bar_index as i64, out_phys as *i64) as i32 {
    let is *PciHardware as pd = cast(*PciHardware, hw);
    if (bar_index < 0) { return cast(i32, 0 - 1); }
    if (bar_index > 5) { return cast(i32, 0 - 1); }
    // BAR0 is cached from enumeration; others are read on demand from
    // config space. Offset 0x10 + index*4 holds the BAR for indices
    // 0..5 on type 0 headers. 64-bit BARs span two consecutive slots;
    // the high dword comes from offset +4.
    let is i64 as raw with mut = 0;
    if (bar_index == 0) {
        raw = pd.bar0;
        if (raw == 0) { return cast(i32, 0 - 2); }
        *out_phys = raw;
        return 0;
    }
    let is i32 as off = cast(i32, 0x10 + bar_index * 4);
    let is i64 as bar_raw = pci_config_read32(cast(i32, pd.bus), cast(i32, pd.dev),
                                               cast(i32, pd.func), off);
    if ((bar_raw & 0x1) != 0) {
        raw = bar_raw & 0xFFFFFFFC;          // I/O BAR
    } else {
        let is i64 as base_lo = bar_raw & 0xFFFFFFF0;
        if (((bar_raw >> 1) & 0x3) == 0x2 && bar_index < 5) {
            let is i64 as bar_hi = pci_config_read32(cast(i32, pd.bus), cast(i32, pd.dev),
                                                      cast(i32, pd.func),
                                                      cast(i32, 0x10 + (bar_index + 1) * 4));
            raw = base_lo | (bar_hi << 32);
        } else {
            raw = base_lo;
        }
    }
    if (raw == 0) { return cast(i32, 0 - 2); }
    *out_phys = raw;
    return 0;
}

// Read PCI config space 0x3C (Interrupt Line register) to get the
// hardware IRQ line the BIOS/firmware wired this device to. Returns
// the line (0-15 for legacy IRQ), or -1 if the device has no IRQ
// (BIOS wrote 0xFF) — typical for non-interrupting devices.
fn pci_get_irq_line(hw as *driver.Hardware) as i64 {
    let is *PciHardware as pd = cast(*PciHardware, hw);
    let is i64 as line = pci_config_read8(cast(i32, pd.bus), cast(i32, pd.dev),
                                           cast(i32, pd.func), cast(i32, 0x3C));
    if (line == 0xFF) { return cast(i64, 0 - 1); }
    return line;
}

// Enable bits in the PCI Command register (config space 0x04, low 16
// bits). Writes back the full 32-bit dword at 0x04 — the high 16 bits
// hold the Status register which is W1C, so preserving the just-read
// value does not clear any status bits. Common bits:
//   0x01 — I/O space enable
//   0x02 — Memory space enable
//   0x04 — Bus Master Enable (required for DMA)
// Firmware normally sets the memory + BME bits for boot devices but
// OEM BIOSes and hotplug paths occasionally leave them clear. Drivers
// that DMA must call this at bind time.
fn pci_set_command_bits(hw as *driver.Hardware, bits as i64) as void {
    let is *PciHardware as pd = cast(*PciHardware, hw);
    let is i64 as cur = pci_config_read32(cast(i32, pd.bus), cast(i32, pd.dev),
                                           cast(i32, pd.func), cast(i32, 0x04));
    let is i64 as new_val = cur | (bits & 0xFFFF);
    if (new_val != cur) {
        pci_config_write32(cast(i32, pd.bus), cast(i32, pd.dev),
                           cast(i32, pd.func), cast(i32, 0x04), new_val);
    }
}

fn pci_enable_bus_master(hw as *driver.Hardware) as void {
    pci_set_command_bits(hw, 0x06);   // Memory Space Enable | Bus Master Enable
}

// Walks one PCI bus, registering every present function as a child of `parent`.
// Bridges (class=0x06, subclass=0x04) recurse into their secondary bus, placing
// children under the bridge PciHardware so the framework's DFS probe visits them
// in topological order.
fn enumerate_bus(parent as *driver.Hardware, bus as i32) as void {
    let is i32 as d with mut = cast(i32, 0);
    while (d < 32) {
        let is i64 as ven = pci_config_read16(bus, d, cast(i32, 0), cast(i32, 0));
        if (ven != 0xFFFF) {
            let is i64 as ht0 = pci_config_read8(bus, d, cast(i32, 0), cast(i32, 0x0E));
            let is i32 as nfn with mut = cast(i32, 1);
            if ((ht0 & 0x80) != 0) { nfn = cast(i32, 8); }
            let is i32 as f with mut = cast(i32, 0);
            while (f < nfn) {
                let is i64 as fven = pci_config_read16(bus, d, f, cast(i32, 0));
                if (fven != 0xFFFF) {
                    enumerate_function(parent, bus, d, f, fven);
                }
                f = f + cast(i32, 1);
            }
        }
        d = d + cast(i32, 1);
    }
}

fn enumerate_function(parent as *driver.Hardware, bus as i32, d as i32, f as i32, fven as i64) as void {
    let is i64 as pd_addr = cast(i64, driver.hardware_alloc(sizeof(PciHardware), 8));
    if (pd_addr == 0) {
        serial.println("pci: hardware_alloc failed", 24);
        return;
    }
    let is *PciHardware as pd = cast(*PciHardware, pd_addr);

    let is i64 as fdev = pci_config_read16(bus, d, f, cast(i32, 2));
    let is i64 as cls  = pci_config_read32(bus, d, f, cast(i32, 8));
    let is i64 as ht   = pci_config_read8(bus, d, f, cast(i32, 0x0E));
    let is i64 as cc   = (cls >> 24) & 0xFF;
    let is i64 as sc   = (cls >> 16) & 0xFF;
    let is i64 as pif  = (cls >> 8)  & 0xFF;
    let is i64 as rev  = cls & 0xFF;

    pd.bus         = cast(i64, bus);
    pd.dev         = cast(i64, d);
    pd.func        = cast(i64, f);
    pd.vendor      = fven;
    pd.device_id   = fdev;
    pd.revision    = rev;
    pd.prog_if     = pif;
    pd.subclass    = sc;
    pd.class_code  = cc;
    pd.header_type = ht & 0x7F;

    // Both Type 0 and Type 1 headers have BAR0 at offset 0x10.
    let is i64 as bar0_raw = pci_config_read32(bus, d, f, cast(i32, 0x10));
    if ((bar0_raw & 0x1) != 0) {
        // I/O BAR: low 2 bits are type, rest is port base.
        pd.bar0 = bar0_raw & 0xFFFFFFFC;
    } else {
        // Memory BAR: low 4 bits are type+prefetch. Type bits [2:1]:
        //   0b10 = 64-bit BAR, next slot holds high 32 bits.
        let is i64 as base_lo = bar0_raw & 0xFFFFFFF0;
        if (((bar0_raw >> 1) & 0x3) == 0x2) {
            let is i64 as bar1_raw = pci_config_read32(bus, d, f, cast(i32, 0x14));
            pd.bar0 = base_lo | (bar1_raw << 32);
        } else {
            pd.bar0 = base_lo;
        }
    }

    pd.base.name[0] = cast(u8, 112); // 'p'
    pd.base.name[1] = cast(u8, 99);  // 'c'
    pd.base.name[2] = cast(u8, 105); // 'i'
    pd.base.bus = &pci_bt;

    let is *driver.Hardware as as_dev = cast(*driver.Hardware, pd);
    let is i32 as rc = driver.hardware_register(as_dev, parent);
    if (rc != driver.OK) {
        serial.println("pci: hardware_register failed", 27);
        heap.kfree(pd_addr);
        return;
    }

    serial.print("pci: ", 5);
    util.print_num(cast(i64, bus));
    serial.putc(58);
    util.print_num(cast(i64, d));
    serial.putc(46);
    util.print_num(cast(i64, f));
    serial.print(" ven=", 5);
    util.print_hex(fven);
    serial.print(" dev=", 5);
    util.print_hex(fdev);
    serial.print(" class=", 7);
    util.print_hex(cc);
    serial.putc(58);
    util.print_hex(sc);
    serial.println("", 0);

    // PCI-to-PCI bridge: walk secondary bus under this device.
    if (cc == 0x06 && sc == 0x04) {
        let is i64 as sec = pci_config_read8(bus, d, f, cast(i32, 0x19));
        enumerate_bus(as_dev, cast(i32, sec));
    }
}

fn pci_enumerate(bi as *driver.BusNode) as void {
    serial.println("pci: enumerate bus 0", 20);
    enumerate_bus(cast(*driver.Hardware, bi), cast(i32, 0));
}

fn register() as void {
    pci_bt.name[0] = cast(u8, 112); // 'p'
    pci_bt.name[1] = cast(u8, 99);  // 'c'
    pci_bt.name[2] = cast(u8, 105); // 'i'
    pci_bt.enumerate_node = fn_ptr(pci_enumerate);
    pci_bt.get_match_field = fn_ptr(pci_get_match_field);
    pci_bt.get_bar_info = fn_ptr(pci_get_bar_info);
    pci_bt.get_irq_line = fn_ptr(pci_get_irq_line);
    driver.bus_register(&pci_bt);

    pci_bi0.base.bus = &pci_bt;
    pci_bi0.base.name[0] = cast(u8, 112);
    pci_bi0.base.name[1] = cast(u8, 99);
    pci_bi0.base.name[2] = cast(u8, 105);
    pci_bi0.base.name[3] = cast(u8, 48); // '0'
    driver.bus_node_register(&pci_bi0, driver.get_root());

    serial.println("pci: registered", 15);
}
