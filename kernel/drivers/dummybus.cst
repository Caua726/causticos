// dummybus.cst — end-to-end integration test for the driver framework.
//
// Declares a synthetic Bus plus one BusNode that enumerates a single
// child Hardware. The spec + lifecycle live in kernel/dummy.cdvrspec,
// parsed at boot by specparse; the only code here is the callback
// (dummy_bind, which runs the smoke tests) and the ksym registration
// that lets the parser resolve it by name.

use "driver.cst" as driver;
use "spec.cst" as spec;
use "ksym.cst" as ksym;
use "serial.cst" as serial;
use "util.cst" as util;
use "smoke.cst" as smoke;

// Statically-allocated storage. Zero-initialized by virtue of living in .bss.
let is driver.Bus as dummy_bt;
let is driver.BusNode as dummy_bi;

// Phase 2.3: kernel symbol entry for dummy_bind so the .cdvrspec parser
// can resolve `on_bind: dummybus.dummy_bind` by name at boot. Populated
// in register() below.
let is ksym.KSym as ksym_dummy_bind;

fn dummy_enumerate(bi as *driver.BusNode) as void {
    serial.println("dummybus: enumerate", 19);
    let is *driver.Hardware as d = driver.hardware_alloc(sizeof(driver.Hardware), 8);
    if (cast(i64, d) == 0) {
        serial.println("dummybus: hardware_alloc failed", 29);
        return;
    }
    // Name: "dummy-dev"
    d.name[0] = cast(u8, 100);
    d.name[1] = cast(u8, 117);
    d.name[2] = cast(u8, 109);
    d.name[3] = cast(u8, 109);
    d.name[4] = cast(u8, 121);
    d.name[5] = cast(u8, 45);
    d.name[6] = cast(u8, 100);
    d.name[7] = cast(u8, 101);
    d.name[8] = cast(u8, 118);
    let is i32 as rc = driver.hardware_register(d, cast(*driver.Hardware, bi));
    if (rc != driver.OK) {
        serial.println("dummybus: hardware_register failed", 32);
    }
}

// Phase-2 lifecycle callback. Fires once per (dummy_spec, Hardware) pair
// after match_all runs. Also exercises the MMIO + IRQ framework for both
// hardwares (BusNode + dummy-dev child) as a smoke test — the second
// run's irq_register legitimately returns ALREADY_EXISTS, which is the
// expected idempotency signal.
fn dummy_bind(b as *spec.Binding) as i32 {
    serial.print("dummy_spec: bound to hw=", 24);
    util.print_hex(cast(i64, b.hardware));
    serial.println("", 0);
    smoke.run_mmio(b.hardware);
    smoke.run_irq(b.hardware);
    smoke.run_io(b.hardware);

    // A2c: the framework resolved `dma: 4096, 1` into a page-aligned,
    // below-4G, zeroed buffer in b.caps — verify vaddr/phys are sane and
    // the buffer is actually zeroed.
    if (cast(i64, b.caps.dma_pool) == 0) {
        serial.println("dummy.dma: FAIL no buffer", 25);
    } else {
        let is i64 as dphys = b.caps.dma_phys;
        let is *u8 as dp = b.caps.dma_pool;
        let is i32 as ok with mut = cast(i32, 1);
        if (dphys <= 0) { ok = cast(i32, 0); }
        if (dphys >= 4294967296) { ok = cast(i32, 0); }    // below 4 GiB
        if (dp[0] != cast(u8, 0)) { ok = cast(i32, 0); }
        if (dp[4095] != cast(u8, 0)) { ok = cast(i32, 0); }
        if (ok == cast(i32, 1)) {
            serial.print("dummy.dma: PASS phys=", 21);
            util.print_hex(dphys);
            serial.print(" size=", 6);
            util.print_num(b.caps.dma_size);
            serial.println("", 0);
        } else {
            serial.println("dummy.dma: FAIL checks", 22);
        }
    }
    return driver.OK;
}

// Called from _kernel_start during Phase 1. Populates the three static
// entries and registers them with the framework.
fn register() as void {
    // Bus: name "dummy"
    dummy_bt.name[0] = cast(u8, 100);
    dummy_bt.name[1] = cast(u8, 117);
    dummy_bt.name[2] = cast(u8, 109);
    dummy_bt.name[3] = cast(u8, 109);
    dummy_bt.name[4] = cast(u8, 121);
    dummy_bt.enumerate_node = fn_ptr(dummy_enumerate);
    driver.bus_register(&dummy_bt);

    // BusNode: caller presets base.bus (spec fix #15) before register.
    dummy_bi.base.bus = &dummy_bt;
    dummy_bi.base.name[0] = cast(u8, 100);
    dummy_bi.base.name[1] = cast(u8, 117);
    dummy_bi.base.name[2] = cast(u8, 109);
    dummy_bi.base.name[3] = cast(u8, 109);
    dummy_bi.base.name[4] = cast(u8, 121);
    dummy_bi.base.name[5] = cast(u8, 48);    // '0'
    driver.bus_node_register(&dummy_bi, driver.get_root());

    // Spec for the dummy driver is declared in kernel/dummy.cdvrspec and
    // loaded by specparse.init(). We only need to publish dummy_bind in
    // the kernel symbol table so the parser can resolve
    // `on_bind: dummybus.dummy_bind`.
    ksym_dummy_bind.name_ptr = cast(*u8, "dummybus.dummy_bind");
    ksym_dummy_bind.name_len = 19;
    ksym_dummy_bind.addr     = cast(i64, fn_ptr(dummy_bind));
    ksym_dummy_bind.kind     = ksym.KIND_FUNC;
    ksym.register(&ksym_dummy_bind);

    serial.println("dummybus: registered", 20);
}
