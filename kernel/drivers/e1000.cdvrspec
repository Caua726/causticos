# e1000.cdvrspec — Intel 82540EM gigabit ethernet controller
driver "e1000" {
    match {
        bus: pci
        vendor: 0x8086
        device: 0x100E
    }
    capabilities {
        # mmio: <bar_index>, <size_bytes>
        mmio: 0, 0x20000
        # legacy PCI INTx routed via IOAPIC; framework reads PCI 0x3C.
        irq: auto
    }
    # One declaration is all it takes for dev_open(DEV_NET, n) to reach this
    # card: the framework registers the instance after a successful bind, and
    # netdev.net_acquire matches it back to the port by its Hardware node. A
    # second NIC of any make needs no syscall-layer edit, only its own block.
    device {
        class: net
        acquire: netdev.net_acquire
    }
    lifecycle {
        on_bind: e1000.e1000_bind
        on_irq:  e1000.e1000_irq
    }
}
