// fb.cst — Framebuffer rendering

use "limine.cst" as limine;
use "font8x8.cst" as font;
use "serial.cst" as serial;
use "util.cst" as util;
use "pmm.cst" as pmm;
use "vmm.cst" as vmm;

// ============================================================
// Module state
// ============================================================

let is i64 as fb_addr with mut = 0;       // virtual addr we draw through (Limine HHDM today)
let is i64 as fb_phys with mut = 0;       // physical scanout base (for an explicit WC remap, 1b-PAT)
let is i64 as fb_width with mut = 0;
let is i64 as fb_height with mut = 0;
let is i64 as fb_pitch with mut = 0;
let is i64 as fb_bpp_bytes with mut = 4;  // bytes per pixel = bpp / 8 (read from Limine, not assumed)

// ============================================================
// Functions
// ============================================================

fn init(fb as *limine.LimineFramebuffer) as void {
    fb_addr = cast(i64, fb.address);
    fb_width = fb.width;
    fb_height = fb.height;
    fb_pitch = fb.pitch;

    // Read the real pixel depth instead of assuming 32bpp. Drawing still
    // packs a 32-bit pixel; warn (don't pretend) on anything else.
    let is i64 as bpp with mut = limine.fb_bpp(fb);
    if (bpp == 0) { bpp = 32; }
    fb_bpp_bytes = bpp / 8;
    if (bpp != 32) {
        serial.print("fb: WARNING bpp=", 16);
        util.print_num(bpp);
        serial.println(" (renderer assumes 32)", 22);
    }

    // Limine hands a higher-half HHDM virtual address; recover the physical
    // scanout base so 1b-PAT can map it explicitly with write-combining.
    // Defensive: if it's already a raw physical (below the HHDM window),
    // keep it as-is.
    if (fb_addr >= pmm.hhdm) { fb_phys = fb_addr - pmm.hhdm; }
    else                     { fb_phys = fb_addr; }

    // Draw through a write-combining mapping of the scanout instead of the
    // Limine HHDM (write-back) VA: WB on an MMIO framebuffer is not flushed
    // to the device without an explicit barrier, while WC coalesces and
    // posts the pixel writes. Falls back to the HHDM VA if the WC map fails.
    let is i64 as wc = vmm.kvmap(fb_height * fb_pitch, vmm.KV_WC, 0, fb_phys);
    if (wc != 0) { fb_addr = wc; }
}

// Scanout geometry — the surface object (KOBJ_SURFACE) reads these to size
// its backbuffer and blit on present.
fn scanout_virt() as i64 { return fb_addr; }
fn scanout_phys() as i64 { return fb_phys; }
fn width() as i64        { return fb_width; }
fn height() as i64       { return fb_height; }
fn pitch() as i64        { return fb_pitch; }
fn bpp_bytes() as i64    { return fb_bpp_bytes; }

fn put_pixel(x as i64, y as i64, color as i32) as void {
    if (x < 0) { return; }
    if (y < 0) { return; }
    if (x >= fb_width) { return; }
    if (y >= fb_height) { return; }
    let is i64 as offset = y * fb_pitch + x * fb_bpp_bytes;
    let is *i32 as pixel = cast(*i32, fb_addr + offset);
    pixel[0] = color;
}

fn draw_char(ch as i32, cx as i64, cy as i64, color as i32) as void {
    let is *u8 as glyph = font.get_glyph(ch);
    let is i64 as row with mut = 0;
    while (row < 8) {
        let is i64 as bits = cast(i64, glyph[row]);
        let is i64 as col with mut = 0;
        while (col < 8) {
            // MSB = leftmost pixel: bit 7 is col 0, bit 6 is col 1, etc.
            let is i64 as mask = 128 >> col;
            if ((bits & mask) != 0) {
                put_pixel(cx + col, cy + row, color);
            }
            col = col + 1;
        }
        row = row + 1;
    }
}

fn print(str as *u8, len as i64, x as i64, y as i64, color as i32) as void {
    let is i64 as i with mut = 0;
    while (i < len) {
        let is i32 as ch = cast(i32, str[i]);
        draw_char(ch, x + i * 8, y, color);
        i = i + 1;
    }
}

// Scaled glyph/string drawing — each font pixel becomes a scale×scale block.
// Used by the boot screen to draw a large centred title.
fn draw_char_scaled(ch as i32, cx as i64, cy as i64, color as i32, scale as i64) as void {
    let is *u8 as glyph = font.get_glyph(ch);
    let is i64 as row with mut = 0;
    while (row < 8) {
        let is i64 as bits = cast(i64, glyph[row]);
        let is i64 as col with mut = 0;
        while (col < 8) {
            if ((bits & (128 >> col)) != 0) {
                let is i64 as dy with mut = 0;
                while (dy < scale) {
                    let is i64 as dx with mut = 0;
                    while (dx < scale) {
                        put_pixel(cx + col * scale + dx, cy + row * scale + dy, color);
                        dx = dx + 1;
                    }
                    dy = dy + 1;
                }
            }
            col = col + 1;
        }
        row = row + 1;
    }
}
fn print_scaled(str as *u8, len as i64, x as i64, y as i64, color as i32, scale as i64) as void {
    let is i64 as i with mut = 0;
    while (i < len) {
        draw_char_scaled(cast(i32, str[i]), x + i * 8 * scale, y, color, scale);
        i = i + 1;
    }
}

fn clear(color as i32) as void {
    let is i64 as y with mut = 0;
    while (y < fb_height) {
        let is i64 as x with mut = 0;
        while (x < fb_width) {
            let is i64 as offset = y * fb_pitch + x * fb_bpp_bytes;
            let is *i32 as pixel = cast(*i32, fb_addr + offset);
            pixel[0] = color;
            x = x + 1;
        }
        y = y + 1;
    }
}

// ============================================================
// Panic screen
// ============================================================

// What the machine shows when the kernel stops. Before this a panic, a stalled
// cpu or a kernel fault printed to the serial port and halted — and on a screen
// nothing changed: the desktop froze mid-frame, indistinguishable from a hang,
// with the reason somewhere nobody was looking. Drawn straight into the
// scanout, over whatever the compositor last presented, by pmm.panic after the
// other cpus are stopped. Uses nothing that can sleep, allocate or lock.
fn panic_screen(msg as *u8, len as i64) as void {
    if (fb_addr == 0 || fb_width == 0) { return; }
    let is i32 as bg = cast(i32, 0x002a0a10);
    let is i32 as title = cast(i32, 0x00ffd0d0);
    let is i32 as text = cast(i32, 0x00f0e8e8);
    let is i32 as dim = cast(i32, 0x00b09090);
    clear(bg);
    let is i64 as x0 = 32;
    let is i64 as y with mut = 32;
    print_scaled(cast(*u8, "kernel panic"), 12, x0, y, title, 3);
    y = y + 40;
    // The message, wrapped to the screen width.
    let is i64 as cols with mut = (fb_width - 2 * x0) / 8;
    if (cols < 16) { cols = 16; }
    let is i64 as off with mut = 0;
    while (off < len) {
        let is i64 as n with mut = len - off;
        if (n > cols) { n = cols; }
        print(cast(*u8, cast(i64, msg) + off), n, x0, y, text);
        off = off + n;
        y = y + 12;
    }
    y = y + 12;
    print(cast(*u8, "The system has stopped. What the kernel said last:"), 50, x0, y, dim);
    y = y + 18;
    let is [120]u8 as line;
    let is i64 as hc = serial.history_count();
    let is i64 as k with mut = 0;
    while (k < hc && y + 10 < fb_height - 40) {
        let is i64 as n with mut = serial.history_line(k, cast(*u8, &line[0]));
        if (n > cols) { n = cols; }
        print(cast(*u8, &line[0]), n, x0, y, text);
        y = y + 11;
        k = k + 1;
    }
    print(cast(*u8, "The full log is on the serial console. Restart the machine to continue."),
          71, x0, fb_height - 28, dim);
}

fn panic_screen_ptr() as i64 { return cast(i64, fn_ptr(panic_screen)); }
