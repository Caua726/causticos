// driver.cst — Driver framework base.
//
// Post-Phase-2: Hardware tree + Bus registry + resource tracking
// (MMIO/IRQ/DMA). DriverImpl, bus_register_driver, and the old probe
// path are gone — driver matching and lifecycle now live entirely in
// spec.cst (declarative specs loaded from .cdvrspec text).

use "pmm.cst" as pmm;
use "heap.cst" as heap;
use "serial.cst" as serial;
use "sched.cst" as sched;
use "vmm.cst" as vmm;
use "lapic.cst" as lapic;
use "lock.cst" as lock;

// ============================================================
// DriverResult — OK=0, errors positive
// ============================================================

let is i32 as OK                       = 0;
let is i32 as OUT_OF_MEMORY            = 1;
let is i32 as PERMISSION_DENIED        = 2;
let is i32 as DEVICE_BUSY              = 3;
let is i32 as DEVICE_NOT_PRESENT       = 4;
let is i32 as INVALID_ARGUMENT         = 5;
let is i32 as NOT_SUPPORTED            = 6;
let is i32 as ALREADY_EXISTS           = 7;
let is i32 as NOT_FOUND                = 8;
let is i32 as DUPLICATE_DRIVER_NAME    = 9;
let is i32 as DUPLICATE_PRIORITY       = 10;
let is i32 as INVALID_MATCH_SPEC       = 11;
let is i32 as BUS_NOT_REGISTERED       = 12;
let is i32 as NO_DRIVER_MATCHED        = 13;
let is i32 as MMIO_ALREADY_MAPPED      = 14;
let is i32 as MMIO_INVALID_INDEX       = 15;
let is i32 as NO_IRQ_VECTORS           = 16;
let is i32 as IRQ_INVALID_VECTOR       = 17;
let is i32 as DMA_OUT_OF_MEMORY        = 18;
let is i32 as DMA_ADDRESS_CONSTRAINT   = 19;

// ============================================================
// Resource list nodes
// ============================================================

// Per project memory (feedback_caustic_mixed_struct_widths.md): scalar
// fields are i64 to avoid mixed-width aliasing with adjacent pointers
// in the Caustic compiler's packed-struct layout.
struct MmioRegion {
    phys as i64;
    size as i64;
    flags as i64;
    mapped_at as *u8;
    next as *MmioRegion;
}

struct IrqBinding {
    vector as i64;
    kind as i64;
    handler as fn(*Hardware, *u8) as i32;
    context as *u8;
    dev as *Hardware;
    next as *IrqBinding;             // per-device list (dev.irq_list)
    chain_next as *IrqBinding;       // per-vector dispatch chain
}

struct DmaBuffer {
    virt as *u8;
    phys as i64;
    size as i64;
    order as i64;       // buddy order (for free_pages)
    next as *DmaBuffer;
}

// ============================================================
// Core structs
// ============================================================

struct Bus {
    name as [32]u8;
    enumerate_node as fn(*BusNode) as void;
    get_match_field as fn(*Hardware, i64) as i64;
    // Phase 3: capability resolvers. Buses implement these to translate a
    // spec's CapabilityRequest into concrete hardware parameters (BAR
    // addresses, MSI/MSI-X vectors, port ranges). get_bar_info takes a
    // BAR index and writes phys address into out_phys; returns 0 on
    // success, non-zero if the BAR doesn't exist. get_irq_line returns
    // the hardware IRQ line the device is wired to (PCI config 0x3C
    // for PCI; platform bus maps Hardware name → IRQ line), or a
    // negative value if the bus has no notion of IRQ line (spec must
    // then use irq: N explicitly).
    get_bar_info as fn(*Hardware, i64, *i64) as i32;
    get_irq_line as fn(*Hardware) as i64;
    node_count as i64;
    nodes as *BusNode;
    lock as i64;
    next as *Bus;
}

// Phase 5: lifecycle is now structural (a Hardware is alive iff it's
// linked into the parent's first_child chain; a Binding is alive iff
// it's linked into spec.bindings). No explicit state field, no
// state-machine transitions.
struct Hardware {
    name as [32]u8;
    parent as *Hardware;
    first_child as *Hardware;
    next_sibling as *Hardware;
    prev_sibling as *Hardware;
    bus as *Bus;
    private as *u8;
    lock as i64;                 // spinlock stub; single-CPU for now
    mmio_list as *MmioRegion;
    irq_list as *IrqBinding;
    dma_list as *DmaBuffer;
}

struct BusNode {
    base as Hardware;
    next as *BusNode;
}

// ============================================================
// Globals
// ============================================================

let is i64 as root_hardware with mut = 0;
let is i64 as buses with mut = 0;
let is i32 as bus_count with mut = 0;
let is i32 as driver_tree_lock with mut = 0;

// ============================================================
// Init
// ============================================================

fn init() as void {
    serial.print("driver: init ", 13);
    let is i64 as addr = heap.kmalloc(sizeof(Hardware), 0);
    if (addr == 0) {
        pmm.panic("driver: root alloc failed", 25);
    }
    let is *Hardware as root = cast(*Hardware, addr);
    // Zero the struct
    let is *u8 as p = cast(*u8, addr);
    let is i64 as i with mut = 0;
    while (i < sizeof(Hardware)) {
        p[i] = cast(u8, 0);
        i = i + 1;
    }
    root.name[0] = cast(u8, 114); // 'r'
    root.name[1] = cast(u8, 111); // 'o'
    root.name[2] = cast(u8, 111); // 'o'
    root.name[3] = cast(u8, 116); // 't'
    root_hardware = addr;
    serial.println("ok", 2);
}

fn get_root() as *Hardware {
    return cast(*Hardware, root_hardware);
}

// ============================================================
// Userspace device-class registry. A driver announces, when it binds
// (its `on_bind` callback), which userspace device class it serves
// (`dev_open(class)`) and the acquire fn that mints a KObject for it.
// Boot-provided pseudo-devices that never enter the Hardware tree — the
// Limine framebuffer — register the same way at init. `sys_dev_open` is
// then a lookup here, not a hardcoded switch: one device mechanism,
// extended by registration, not edited in the core. (Adding mouse/disk =
// one more on_bind, kernel untouched.)
// ============================================================

let is i64 as MAX_DEVICES = 16;

// One entry per device INSTANCE — not per class. Several entries may share a
// class (two keyboards = two entries, same class, two ctx). The index in
// dev_open(class, index) selects among the entries of that class.
struct DeviceEntry {
    in_use as i64;
    class as i64;          // abi.DEV_FB / DEV_KEYBOARD / ...
    acquire as i64;        // fn(ctx as i64) as i64 — mints a fresh *KObject (0 = fail)
    ctx as i64;            // instance discriminator handed to acquire (device-state ptr, or 0)
}

let is [16]DeviceEntry as device_table with mut;
let is lock.TicketLock as device_table_lk;

// Announce one device INSTANCE of `class`, served by acquire(ctx). Each call
// is a distinct instance: a driver with two keyboards registers twice (two
// ctx), and dev_open(class, 0) / (class, 1) resolve to each. Re-announcing the
// same (class, ctx) is idempotent — it updates the handler instead of
// appending, so a re-bind can't inflate the count. OK, or OUT_OF_MEMORY when
// the table is full.
fn device_register(class as i64, acquire as i64, ctx as i64) as i32 {
    let is i64 as fl = lock.acquire_irq(&device_table_lk);
    let is i64 as i with mut = 0;
    while (i < MAX_DEVICES) {
        if (device_table[i].in_use != 0 && device_table[i].class == class
            && device_table[i].ctx == ctx) {
            device_table[i].acquire = acquire;          // same instance — replace handler
            lock.release_irq(&device_table_lk, fl);
            return OK;
        }
        i = i + 1;
    }
    i = 0;
    while (i < MAX_DEVICES) {
        if (device_table[i].in_use == 0) {
            device_table[i].in_use = 1;
            device_table[i].class = class;
            device_table[i].acquire = acquire;
            device_table[i].ctx = ctx;
            lock.release_irq(&device_table_lk, fl);
            return OK;
        }
        i = i + 1;
    }
    lock.release_irq(&device_table_lk, fl);
    return OUT_OF_MEMORY;
}

// Number of registered instances of `class` (>= 0). The userspace device
// manager calls this (via SYS_DEV_COUNT) to learn how many it can dev_open.
fn device_count(class as i64) as i64 {
    let is i64 as fl = lock.acquire_irq(&device_table_lk);
    let is i64 as n with mut = 0;
    let is i64 as i with mut = 0;
    while (i < MAX_DEVICES) {
        if (device_table[i].in_use != 0 && device_table[i].class == class) { n = n + 1; }
        i = i + 1;
    }
    lock.release_irq(&device_table_lk, fl);
    return n;
}

// Resolve (class, index) to its acquire fn + ctx (written to *out_ctx) WITHOUT
// minting — the caller invokes acquire(ctx) outside the lock (acquire kmallocs
// / alloc_pages and must not run under the IRQ-off table lock). Returns the
// acquire address, or 0 when there is no index-th instance of the class
// (unserved class OR index >= count). The index is REAL: dev_open(kbd, 1) with
// a single keyboard resolves to nothing — it does NOT alias instance 0.
//
// v0 never removes an entry (no unbind / no hotplug yet), so the (acquire, ctx)
// captured here stay valid after the lock drops. When unbind lands, an entry
// refcount will guard this window.
fn device_resolve(class as i64, index as i64, out_ctx as *i64) as i64 {
    let is i64 as fl = lock.acquire_irq(&device_table_lk);
    let is i64 as seen with mut = 0;
    let is i64 as acquire with mut = 0;
    let is i64 as ctx with mut = 0;
    let is i64 as i with mut = 0;
    while (i < MAX_DEVICES) {
        if (device_table[i].in_use != 0 && device_table[i].class == class) {
            if (seen == index) {
                acquire = device_table[i].acquire;
                ctx = device_table[i].ctx;
                i = MAX_DEVICES;
            } else {
                seen = seen + 1;
                i = i + 1;
            }
        } else {
            i = i + 1;
        }
    }
    lock.release_irq(&device_table_lk, fl);
    *out_ctx = ctx;
    return acquire;
}

// Kernel-side convenience: resolve (class, index) and mint its KObject, or 0
// when there is no such instance / acquire failed. The syscall layer uses
// device_resolve directly so it can tell 'no such device' (E_NOENT) from
// 'acquire OOM' (E_NOMEM); a caller that doesn't care uses this.
fn device_open(class as i64, index as i64) as i64 {
    let is i64 as ctx with mut = 0;
    let is i64 as af = device_resolve(class, index, &ctx);
    if (af == 0) { return 0; }
    let is fn(i64) as i64 as acquire = cast(fn(i64) as i64, af);
    return call(acquire, ctx);
}

// ============================================================
// Tree lock — single-CPU: block preemption, don't touch IRQ flag.
// Composable: preempt_count is a counter, nested locks are safe.
// Lock ordering (for future bus-type lock): always acquire tree_lock
// BEFORE any bus-specific lock.
// ============================================================

fn tree_lock() as void {
    sched.preempt_disable();
    driver_tree_lock = 1;
}

fn tree_unlock() as void {
    driver_tree_lock = 0;
    sched.preempt_enable();
}

// ============================================================
// Hardware allocation + lifecycle
// ============================================================

// kmalloc's second arg is flags, not alignment. The current kernel has no
// alignment-aware allocator; kmalloc slabs are naturally pointer-aligned
// (8 bytes), which satisfies every Hardware-sized allocation today. The
// align parameter is kept in the signature per spec for forward-compat.
fn hardware_alloc(size as i64, align as i64) as *Hardware {
    let is i64 as addr = heap.kmalloc(size, 0);
    if (addr == 0) { return cast(*Hardware, 0); }
    let is *u8 as p = cast(*u8, addr);
    let is i64 as i with mut = 0;
    while (i < size) {
        p[i] = cast(u8, 0);
        i = i + 1;
    }
    let is *Hardware as d = cast(*Hardware, addr);
    return d;
}

// Links dev into parent's child list. Caller must have populated dev's
// bus-specific fields (and dev.bus if dev is a BusNode).
// Returns OK, INVALID_ARGUMENT. Panics on double-registration.
fn hardware_register(dev as *Hardware, parent as *Hardware) as i32 {
    if (cast(i64, dev) == 0) { return INVALID_ARGUMENT; }
    if (cast(i64, dev.parent) != 0) {
        pmm.panic("hardware_register: already registered", 35);
    }

    tree_lock();

    dev.parent = parent;
    dev.first_child = cast(*Hardware, 0);
    dev.next_sibling = cast(*Hardware, 0);
    dev.prev_sibling = cast(*Hardware, 0);

    if (cast(i64, parent) != 0) {
        // Inherit bus from parent unless caller already set it
        // (BusNode pre-sets its own bus per spec fix #15).
        if (cast(i64, dev.bus) == 0) {
            dev.bus = parent.bus;
        }
        let is *Hardware as old_head = parent.first_child;
        dev.next_sibling = old_head;
        if (cast(i64, old_head) != 0) {
            old_head.prev_sibling = dev;
        }
        parent.first_child = dev;
    }

    tree_unlock();
    return OK;
}

// Unlinks dev from the parent's child chain and frees it. Panics if dev
// still has children — caller is expected to have torn down the subtree
// first. Resources tracked on the device (MMIO/IRQ/DMA lists) are
// released before kfree.
fn hardware_unregister(dev as *Hardware) as void {
    if (cast(i64, dev) == 0) {
        pmm.panic("hardware_unregister: null dev", 27);
    }

    tree_lock();

    if (cast(i64, dev.first_child) != 0) {
        pmm.panic("hardware_unregister: has children", 31);
    }

    if (cast(i64, dev.parent) != 0) {
        let is *Hardware as parent = dev.parent;
        if (cast(i64, dev.prev_sibling) == 0) {
            parent.first_child = dev.next_sibling;
        } else {
            dev.prev_sibling.next_sibling = dev.next_sibling;
        }
        if (cast(i64, dev.next_sibling) != 0) {
            dev.next_sibling.prev_sibling = dev.prev_sibling;
        }
    }

    tree_unlock();

    release_all_resources(dev);
    heap.kfree(cast(i64, dev));
}

// ============================================================
// Bus + BusNode registration
// ============================================================

// Links bt into the global buses list. Rejects re-registration by
// pointer identity. bt's drivers/nodes/counters are expected to be
// zero-initialized by the caller (static .buses entries satisfy this).
// Lookup a registered Bus by name, byte-compared up to the caller's
// declared length or the stored null terminator. Returns null if no match.
// Decouples bus-type registration from direct symbol references — a driver
// can ask for "pci" without importing the PCI module's static.
fn bus_by_name(name as *u8, name_len as i32) as *Bus {
    let is *Bus as bt with mut = cast(*Bus, buses);
    while (cast(i64, bt) != 0) {
        let is i32 as i with mut = 0;
        let is i32 as matched with mut = 1;
        while (i < name_len && i < 32) {
            if (bt.name[i] != name[i]) { matched = 0; i = name_len; }
            i = i + 1;
        }
        if (matched == 1) {
            let is i32 as terminates with mut = 0;
            if (name_len == 32) { terminates = 1; }
            else if (cast(i64, bt.name[name_len]) == 0) { terminates = 1; }
            if (terminates == 1) { return bt; }
        }
        bt = bt.next;
    }
    return cast(*Bus, 0);
}

fn bus_register(bt as *Bus) as i32 {
    if (cast(i64, bt) == 0) { return INVALID_ARGUMENT; }

    tree_lock();
    let is *Bus as cur with mut = cast(*Bus, buses);
    while (cast(i64, cur) != 0) {
        if (cast(i64, cur) == cast(i64, bt)) {
            tree_unlock();
            return ALREADY_EXISTS;
        }
        cur = cur.next;
    }
    bt.next = cast(*Bus, buses);
    buses = cast(i64, bt);
    bus_count = bus_count + 1;
    tree_unlock();
    return OK;
}

// Registers a BusNode in the device tree and in its Bus's flat
// instance list. Caller must set bi.base.bus before calling (spec
// fix #15). Lock ordering: hardware_register acquires the tree lock; the
// bus-type lock is acquired strictly after tree operations complete.
fn bus_node_register(bi as *BusNode, parent as *Hardware) as i32 {
    if (cast(i64, bi) == 0) { return INVALID_ARGUMENT; }
    if (cast(i64, bi.base.bus) == 0) { return INVALID_ARGUMENT; }
    let is *Bus as bt = bi.base.bus;

    let is i32 as rc = hardware_register(cast(*Hardware, bi), parent);
    if (rc != OK) { return rc; }

    // Single-CPU: preempt_disable doubles as bt.lock.
    sched.preempt_disable();
    bi.next = bt.nodes;
    bt.nodes = bi;
    bt.node_count = bt.node_count + cast(u32, 1);
    sched.preempt_enable();

    return OK;
}

// ============================================================
// Resource subsystems: MMIO / IRQ / DMA
//
// Resources are tracked per-device in three singly-linked lists. The lists
// start empty (null). Allocations prepend; releases scan-and-unlink.
// hardware_unregister drains all three in order IRQ -> DMA -> MMIO
// per spec §Cleanup Ordering.
//
// Limitations for V1:
//   - dma_alloc supports up to one page (PAGE_SIZE = 4096). Multi-page
//     contiguous allocations need alloc_pages with order>0; added later.
//   - irq_register tracks the binding but does not yet program the IDT or
//     LAPIC — that wiring lives in the IRQ subsystem commit.
// ============================================================

fn mmio_map(dev as *Hardware, phys as u64, size as u64, flags as u32, out as **u8) as i32 {
    if (cast(i64, dev) == 0) { return INVALID_ARGUMENT; }
    if (cast(i64, out) == 0) { return INVALID_ARGUMENT; }
    if (cast(i64, size) == 0) { return INVALID_ARGUMENT; }

    let is i64 as vaddr = vmm.kvmap(cast(i64, size), vmm.KV_MMIO, 0, cast(i64, phys));
    if (vaddr == 0) { return OUT_OF_MEMORY; }

    let is i64 as node_addr = heap.kmalloc(sizeof(MmioRegion), 0);
    if (node_addr == 0) {
        vmm.kvunmap(vaddr);
        return OUT_OF_MEMORY;
    }
    let is *MmioRegion as r = cast(*MmioRegion, node_addr);
    r.phys = cast(i64, phys);
    r.size = cast(i64, size);
    r.flags = cast(i64, flags);
    r.mapped_at = cast(*u8, vaddr);

    sched.preempt_disable();
    r.next = dev.mmio_list;
    dev.mmio_list = r;
    sched.preempt_enable();

    *out = r.mapped_at;
    return OK;
}

fn mmio_unmap(dev as *Hardware, region as *MmioRegion) as void {
    if (cast(i64, dev) == 0) { return; }
    if (cast(i64, region) == 0) { return; }

    sched.preempt_disable();
    let is *MmioRegion as cur with mut = dev.mmio_list;
    let is *MmioRegion as prev with mut = cast(*MmioRegion, 0);
    while (cast(i64, cur) != 0) {
        if (cast(i64, cur) == cast(i64, region)) {
            if (cast(i64, prev) == 0) { dev.mmio_list = cur.next; }
            else                       { prev.next = cur.next; }
            sched.preempt_enable();
            vmm.kvunmap(cast(i64, cur.mapped_at));
            heap.kfree(cast(i64, cur));
            return;
        }
        prev = cur;
        cur = cur.next;
    }
    sched.preempt_enable();
}

// Compute smallest buddy order (power-of-2 pages) that fits `size` bytes.
// Order 0 = 1 page (4KB), order 1 = 2 pages, ..., capped by pmm's
// MAX_BLOCK_ORDER. Returns -1 if size is larger than the allocator can
// produce contiguously.
fn dma_order_for(size as i64) as i32 {
    if (size <= 0) { return cast(i32, 0 - 1); }
    let is i64 as pages = (size + pmm.PAGE_SIZE - 1) / pmm.PAGE_SIZE;
    let is i32 as order with mut = cast(i32, 0);
    let is i64 as capacity with mut = 1;
    while (capacity < pages) {
        capacity = capacity * 2;
        order = order + cast(i32, 1);
        if (cast(i64, order) > cast(i64, pmm.MAX_BLOCK_ORDER)) {
            return cast(i32, 0 - 1);
        }
    }
    return order;
}

fn dma_alloc(dev as *Hardware, size as u64, align as u64, flags as u32, out as **DmaBuffer) as i32 {
    if (cast(i64, dev) == 0) { return INVALID_ARGUMENT; }
    if (cast(i64, out) == 0) { return INVALID_ARGUMENT; }
    if (cast(i64, size) == 0) { return INVALID_ARGUMENT; }

    let is i32 as order = dma_order_for(cast(i64, size));
    if (order < 0) { return NOT_SUPPORTED; }

    let is i32 as alloc_flags with mut = pmm.ALLOC_ZERO;
    if ((flags & cast(u32, 1)) != cast(u32, 0)) {          // DMA_32BIT_ONLY
        alloc_flags = alloc_flags | pmm.ALLOC_BELOW_4G;
    }

    let is i32 as pfn = pmm.alloc_pages(alloc_flags, order, pmm.USAGE_KERNEL, cast(i32, 0));
    if (pfn == pmm.PFN_NONE) { return DMA_OUT_OF_MEMORY; }
    let is i64 as phys = pmm.pfn_to_phys(pfn);

    let is i64 as node_addr = heap.kmalloc(sizeof(DmaBuffer), 0);
    if (node_addr == 0) {
        pmm.free_pages(pfn, order);
        return OUT_OF_MEMORY;
    }
    let is *DmaBuffer as b = cast(*DmaBuffer, node_addr);
    b.virt = cast(*u8, pmm.hhdm + phys);
    b.phys = phys;
    b.size = cast(i64, size);
    b.order = cast(i64, order);

    sched.preempt_disable();
    b.next = dev.dma_list;
    dev.dma_list = b;
    sched.preempt_enable();

    *out = b;
    return OK;
}

fn dma_free(dev as *Hardware, buffer as *DmaBuffer) as void {
    if (cast(i64, dev) == 0) { return; }
    if (cast(i64, buffer) == 0) { return; }

    sched.preempt_disable();
    let is *DmaBuffer as cur with mut = dev.dma_list;
    let is *DmaBuffer as prev with mut = cast(*DmaBuffer, 0);
    while (cast(i64, cur) != 0) {
        if (cast(i64, cur) == cast(i64, buffer)) {
            if (cast(i64, prev) == 0) { dev.dma_list = cur.next; }
            else                       { prev.next = cur.next; }
            sched.preempt_enable();
            let is i32 as pfn = cast(i32, cast(i64, cur.phys) / pmm.PAGE_SIZE);
            pmm.free_pages(pfn, cast(i32, cur.order));
            heap.kfree(cast(i64, cur));
            return;
        }
        prev = cur;
        cur = cur.next;
    }
    sched.preempt_enable();
}

// Per-vector dispatch chain. Each vector slot holds the head of a
// chain of IrqBinding nodes (one per registered handler). Multiple
// devices on a shared PCI line all map to the same IOAPIC vector —
// the chain walk gives every handler a chance to ack its device.
//
// Declared as [256]i64 of pointer-shaped slots so accesses are
// 8-byte aligned without relying on Caustic's global-array
// alignment guarantees.
let is [256]i64 as irq_chain_head;

// IRQ table lock. driver_irq_dispatch reads the chain head from IRQ
// context; irq_register / irq_unregister mutate the chain from
// thread context. Without a lock a thread-context write could tear
// across a concurrent IRQ-context read and hand the dispatcher a
// half-linked node. acquire_irq disables IRQs on the local cpu so
// the dispatch can't reentrantly take the lock; cross-cpu dispatch
// still serialises through the ticket lock.
let is lock.TicketLock as irq_tbl_lock with mut;

fn irq_tbl_get(base as *i64, v as i64) as i64 {
    return base[v];
}

fn irq_tbl_set(base as *i64, v as i64, val as i64) as void {
    base[v] = val;
}

// Called from the asm stub with the vector number in rdi. Walks the
// chain head for `vector` and invokes every registered handler.
// Each handler is expected to be self-aware (read its own status
// register; bail out cheaply if the IRQ wasn't from it). EOI is
// emitted exactly once at the end, after every chained handler has
// run.
fn driver_irq_dispatch(vector as i64) as void {
    if (vector < 0) { return; }
    if (vector > 255) { return; }

    let is *IrqBinding as cur with mut =
        cast(*IrqBinding, irq_tbl_get(&irq_chain_head[0], vector));
    while (cast(i64, cur) != 0) {
        if (cast(i64, cur.handler) != 0) {
            call(cur.handler, cur.dev, cur.context);
        }
        cur = cur.chain_next;
    }
    lapic.eoi();
}

// True if `vector` already has at least one chained handler. The
// spec framework uses this so two devices wired to the same hardware
// IRQ line can share a single allocated vector — second registration
// joins the chain instead of overwriting the IOAPIC routing.
fn irq_vector_in_use(vector as i64) as i32 {
    if (vector < 0) { return 0; }
    if (vector > 255) { return 0; }
    let is i64 as flags = lock.acquire_irq(&irq_tbl_lock);
    let is i64 as head = irq_tbl_get(&irq_chain_head[0], vector);
    lock.release_irq(&irq_tbl_lock, flags);
    if (head != 0) { return 1; }
    return 0;
}

fn irq_register(dev as *Hardware, vector as u32, kind as i32,
                handler as fn(*Hardware, *u8) as i32, context as *u8) as i32 {
    if (cast(i64, dev) == 0) { return INVALID_ARGUMENT; }
    let is i64 as v = cast(i64, vector);
    if (v < 0) { return IRQ_INVALID_VECTOR; }
    if (v > 255) { return IRQ_INVALID_VECTOR; }

    let is i64 as node_addr = heap.kmalloc(sizeof(IrqBinding), 0);
    if (node_addr == 0) { return OUT_OF_MEMORY; }
    let is *IrqBinding as b = cast(*IrqBinding, node_addr);
    b.vector = v;
    b.kind = cast(i64, kind);
    b.handler = handler;
    b.context = context;
    b.dev = dev;
    b.next = cast(*IrqBinding, 0);
    b.chain_next = cast(*IrqBinding, 0);

    let is i64 as flags = lock.acquire_irq(&irq_tbl_lock);
    // Reject a *duplicate* registration from the same device on the
    // same vector; everything else is permitted (sharing).
    let is *IrqBinding as scan with mut =
        cast(*IrqBinding, irq_tbl_get(&irq_chain_head[0], v));
    while (cast(i64, scan) != 0) {
        if (cast(i64, scan.dev) == cast(i64, dev)) {
            lock.release_irq(&irq_tbl_lock, flags);
            heap.kfree(node_addr);
            return ALREADY_EXISTS;
        }
        scan = scan.chain_next;
    }
    // Push to chain head + per-device list.
    b.chain_next = cast(*IrqBinding,
                        irq_tbl_get(&irq_chain_head[0], v));
    irq_tbl_set(&irq_chain_head[0], v, cast(i64, b));
    b.next = dev.irq_list;
    dev.irq_list = b;
    lock.release_irq(&irq_tbl_lock, flags);
    return OK;
}

fn irq_unregister(dev as *Hardware, vector as u32) as void {
    if (cast(i64, dev) == 0) { return; }
    let is i64 as v = cast(i64, vector);
    if (v < 0) { return; }
    if (v > 255) { return; }

    let is i64 as flags = lock.acquire_irq(&irq_tbl_lock);
    let is *IrqBinding as cur with mut = dev.irq_list;
    let is *IrqBinding as prev with mut = cast(*IrqBinding, 0);
    while (cast(i64, cur) != 0) {
        if (cur.vector == v) {
            // Remove from per-device list.
            if (cast(i64, prev) == 0) { dev.irq_list = cur.next; }
            else                       { prev.next = cur.next; }
            // Remove from per-vector chain.
            let is *IrqBinding as ch with mut =
                cast(*IrqBinding, irq_tbl_get(&irq_chain_head[0], v));
            let is *IrqBinding as chp with mut = cast(*IrqBinding, 0);
            while (cast(i64, ch) != 0) {
                if (cast(i64, ch) == cast(i64, cur)) {
                    if (cast(i64, chp) == 0) {
                        irq_tbl_set(&irq_chain_head[0], v,
                                    cast(i64, ch.chain_next));
                    } else {
                        chp.chain_next = ch.chain_next;
                    }
                    ch = cast(*IrqBinding, 0);
                } else {
                    chp = ch;
                    ch = ch.chain_next;
                }
            }
            lock.release_irq(&irq_tbl_lock, flags);
            heap.kfree(cast(i64, cur));
            return;
        }
        prev = cur;
        cur = cur.next;
    }
    lock.release_irq(&irq_tbl_lock, flags);
}

// Drains all tracked resources in spec-mandated order IRQ -> DMA -> MMIO.
// Idempotent: called from hardware_unregister; safe on empty lists.
fn release_all_resources(dev as *Hardware) as void {
    while (cast(i64, dev.irq_list) != 0) {
        let is *IrqBinding as head = dev.irq_list;
        irq_unregister(dev, head.vector);
    }
    while (cast(i64, dev.dma_list) != 0) {
        let is *DmaBuffer as head = dev.dma_list;
        dma_free(dev, head);
    }
    while (cast(i64, dev.mmio_list) != 0) {
        let is *MmioRegion as head = dev.mmio_list;
        mmio_unmap(dev, head);
    }
}

// ============================================================
// Enumeration
//
// For each registered Bus, invoke its enumerate_node hook on every
// BusNode attached to it. The hook populates the Hardware tree with
// children representing the actual hardware under that bus (PCI
// functions, platform-fixed devices, etc). Called once at kernel
// startup from _kernel_start; the spec framework (spec.cst) then
// walks the tree to match declarative Specs against Hardware.
// ============================================================

fn driver_enumerate_all() as void {
    let is *Bus as bt with mut = cast(*Bus, buses);
    while (cast(i64, bt) != 0) {
        if (cast(i64, bt.enumerate_node) != 0) {
            let is *BusNode as bi with mut = bt.nodes;
            while (cast(i64, bi) != 0) {
                call(bt.enumerate_node, bi);
                bi = bi.next;
            }
        }
        bt = bt.next;
    }
}

// ============================================================
// BusNode unregistration
//
// Unlinks `bi` from its Bus's node list and removes it from the
// Hardware tree. Caller is responsible for having unregistered every
// child hardware first — hardware_unregister panics on non-empty
// children.
// ============================================================

fn bus_node_unregister(bi as *BusNode) as i32 {
    if (cast(i64, bi) == 0) { return INVALID_ARGUMENT; }
    let is *Hardware as d = cast(*Hardware, bi);
    if (cast(i64, d.first_child) != 0) { return DEVICE_BUSY; }
    let is *Bus as bt = d.bus;
    if (cast(i64, bt) == 0) { return INVALID_ARGUMENT; }

    sched.preempt_disable();
    let is *BusNode as cur with mut = bt.nodes;
    let is *BusNode as prev with mut = cast(*BusNode, 0);
    let is i32 as found with mut = 0;
    while (cast(i64, cur) != 0) {
        if (cast(i64, cur) == cast(i64, bi)) {
            if (cast(i64, prev) == 0) { bt.nodes = cur.next; }
            else { prev.next = cur.next; }
            cur.next = cast(*BusNode, 0);
            bt.node_count = bt.node_count - cast(u32, 1);
            found = 1;
            cur = cast(*BusNode, 0);
        } else {
            prev = cur;
            cur = cur.next;
        }
    }
    sched.preempt_enable();
    if (found == 0) { return NOT_FOUND; }

    hardware_unregister(d);
    return OK;
}
