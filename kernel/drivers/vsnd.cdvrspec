# virtio-sound — paravirtual audio (virtio spec §5.14). Device type 25, so
# the modern PCI id is 0x1040 + 25 = 0x1059. Third consumer of the virtio.cst
# transport, and the first to use descriptor chains.
#
# The transport windows come from the PCI vendor capabilities, so no fixed
# mmio BAR is declared; the interrupt is legacy INTx through the IOAPIC.
#
# NO `device` BLOCK, on purpose. That block binds one bind to one device
# class, and one sound card is a playback stream and a capture stream — two
# classes, and a codec with more converters would be more still. How many
# instances a bind provides is something the driver learns from the device,
# not something a spec can state, so audio.cst does the device_register for
# each stream it ends up with. See the note above audio.register.

driver "vsnd" {
    match {
        bus: pci
        vendor: 0x1AF4
        device: 0x1059
    }
    capabilities {
        irq: auto
    }
    lifecycle {
        on_bind: vsnd.vsnd_bind
        on_irq: vsnd.vsnd_irq
    }
}
