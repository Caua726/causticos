// vnet.cst — virtio-net driver (virtio spec §5.1), the SECOND consumer of
// the modern PCI transport in virtio.cst. Where vtablet proved the transport
// on a one-queue input device, this uses receive, transmit and control queues:
// the device fills receive buffers, reads outgoing frames, and acknowledges
// receive-filter changes. Each data frame starts with a 12-byte
// virtio_net_hdr. Same netdev.NetDevice vtable the e1000 fills, so it is a
// drop-in alternative NIC — the framework wires whichever devices the machine
// presents, and up to four of them.
//
// Modern-only (VERSION_1 negotiated in virtio.cst). We do NOT negotiate
// MRG_RXBUF or CSUM/GSO offloads, so the header is the plain 12-byte form
// and num_buffers is always 1. MAC and receive-filter control are negotiated
// explicitly; absent filter control means the receive mode is unknown.

use "pci.cst" as pci;
use "driver.cst" as driver;
use "spec.cst" as spec;
use "ksym.cst" as ksym;
use "serial.cst" as serial;
use "lock.cst" as lock;
use "mutex.cst" as mutex;
use "sched.cst" as sched;
use "timer.cst" as timer;
use "util.cst" as util;
use "virtio.cst" as virtio;
use "netdev.cst" as netdev;

// NOTE: the modern (VERSION_1) header is 12 bytes — flags(1) gso_type(1)
// hdr_len(2) gso_size(2) csum_start(2) csum_offset(2) num_buffers(2).
let is i64 as HDR = 12;
let is i64 as FRAME_CAP = 2048;        // hdr + a full ethernet frame, padded
let is i64 as SLOT_SZ = 2048;
let is i64 as NQ = 16;                 // ring slots we drive per queue (<= device max)

// device config offsets (struct virtio_net_config): mac[6] then status le16
let is i64 as CFG_MAC = 0;
let is i64 as F_MAC = 32;
let is i64 as F_CTRL_VQ = 131072;
let is i64 as F_CTRL_RX = 262144;
let is i64 as VQ_CONTROL = 2;          // one RX/TX pair; no multiqueue feature

// Up to four adapters. Same reasoning as e1000: a static array, no free path,
// and two of the same device stops being a case the driver refuses. It used to
// be one set of globals plus a `vnet_present` flag, and vnet_bind turned the
// second card away.
let is i64 as MAX_NICS = 4;

struct VnetCtx {
    present     as i64;
    tx_inflight as i64;      // posted to the device, not yet reclaimed
    port_index  as i64;      // handed back by netdev.register
    vdev as virtio.VirtioDev;
    rxq  as virtio.VirtQueue;
    txq  as virtio.VirtQueue;
    ctlq as virtio.VirtQueue;
    ctl_lock as mutex.Mutex;
    ctl_enabled as i64;
    ctl_failed as i64;
    promisc as i64;          // last acknowledged mode, -1 until known
    lk   as lock.TicketLock;
    mac  as [8]u8;           // 6 used
}

let is [4]VnetCtx as ctxs with mut;
let is [4]netdev.NetDevice as nds with mut;
let is i64 as nctx with mut = 0;

fn ctx_at(i as i64) as *VnetCtx {
    if (i == 0) { return &ctxs[0]; }
    if (i == 1) { return &ctxs[1]; }
    if (i == 2) { return &ctxs[2]; }
    return &ctxs[3];
}

fn nd_at(i as i64) as *netdev.NetDevice {
    if (i == 0) { return &nds[0]; }
    if (i == 1) { return &nds[1]; }
    if (i == 2) { return &nds[2]; }
    return &nds[3];
}
let is ksym.KSym as ksym_bind;
let is ksym.KSym as ksym_irq;

// ---- the netdev.NetDevice vtable ----

// Transmit one frame: stage [12-byte zero header][frame] into a tx slot,
// describe it as device-readable, and publish. Never waits on the wire.
//
// The previous version computed its slot as avail_shadow % qsize and wrote it
// unconditionally. After qsize sends that overwrites a descriptor the device
// may still be reading — invisible while a smoke test sent one ARP every boot,
// certain to corrupt under a TCP stack. Explicit accounting now: reclaim what
// the device has finished, and report a full ring honestly instead of
// scribbling over it.
fn nd_send(priv as *u8, frame as *u8, len as i64) as i64 {
    let is *VnetCtx as c = cast(*VnetCtx, priv);
    if (c.present == 0) { return 0 - 2; }
    if (len < 14) { return 0 - 3; }
    if (len + HDR > SLOT_SZ) { return 0 - 3; }
    let is i64 as fl = lock.acquire_irq(&c.lk);
    tx_reclaim_locked(c);
    if (c.tx_inflight >= c.txq.qsize) {
        lock.release_irq(&c.lk, fl);
        return netdev.NET_TX_BUSY;
    }
    let is i64 as slot = c.txq.avail_shadow - (c.txq.avail_shadow / c.txq.qsize) * c.txq.qsize;
    let is i64 as base = c.txq.buf_va + slot * SLOT_SZ;
    let is i64 as z with mut = 0;
    while (z < HDR) { let is *u8 as h = cast(*u8, base + z); h[0] = cast(u8, 0); z = z + 1; }
    let is i64 as i with mut = 0;
    while (i < len) {
        let is *u8 as d = cast(*u8, base + HDR + i);
        d[0] = frame[i];
        i = i + 1;
    }
    // Describe a DEVICE-READABLE buffer (no WRITE flag) of hdr+len bytes.
    let is i64 as desc = c.txq.desc + slot * 16;
    virtio.wr64(desc, c.txq.buf_phys + slot * SLOT_SZ);
    virtio.wr32(desc + 8, HDR + len);
    virtio.wr16(desc + 12, 0);              // flags 0 = device reads
    virtio.wr16(desc + 14, 0);
    let is i64 as ring_slot = c.txq.avail_shadow - (c.txq.avail_shadow / c.txq.qsize) * c.txq.qsize;
    virtio.wr16(c.txq.avail + 4 + ring_slot * 2, slot);
    c.txq.avail_shadow = c.txq.avail_shadow + 1;
    c.tx_inflight = c.tx_inflight + 1;
    virtio.vio_publish(&c.vdev, &c.txq, 1);
    lock.release_irq(&c.lk, fl);
    return len;
}

// Take back every transmit descriptor the device has finished with. Caller
// holds the adapter's lock.
fn tx_reclaim_locked(c as *VnetCtx) as void {
    let is i64 as r with mut = 0;
    while (r >= 0) {
        r = virtio.vio_next_used(&c.txq);
        if (r >= 0 && c.tx_inflight > 0) { c.tx_inflight = c.tx_inflight - 1; }
    }
    return;
}

fn nd_tx_free(priv as *u8) as i64 {
    let is *VnetCtx as c = cast(*VnetCtx, priv);
    if (c.present == 0) { return 0; }
    let is i64 as fl = lock.acquire_irq(&c.lk);
    tx_reclaim_locked(c);
    let is i64 as free with mut = c.txq.qsize - c.tx_inflight;
    lock.release_irq(&c.lk, fl);
    if (free < 0) { free = 0; }
    return free;
}

// Move up to `budget` received frames into the port ring. netdev holds the
// port lock across this call; the rx queue itself is only ever touched from
// here, so no second lock is taken.
fn nd_poll_rx(priv as *u8, budget as i64) as i64 {
    let is *VnetCtx as c = cast(*VnetCtx, priv);
    if (c.present == 0) { return 0; }
    let is i64 as taken with mut = 0;
    let is i64 as refilled with mut = 0;
    while (taken < budget) {
        let is i64 as id = virtio.vio_next_used(&c.rxq);
        if (id < 0) {
            if (refilled > 0) { virtio.vio_publish(&c.vdev, &c.rxq, 0); }
            return taken;
        }
        // The device wrote a 12-byte virtio_net_hdr and then the frame;
        // used_len covers both, so the frame is what is left.
        let is i64 as flen with mut = c.rxq.last_used_len - HDR;
        if (flen < 0) { flen = 0; }
        if (flen > 0) {
            netdev.rx_push(c.port_index, c.rxq.buf_va + id * SLOT_SZ + HDR, flen);
        }
        virtio.vio_repost(&c.rxq, id);
        refilled = refilled + 1;
        taken = taken + 1;
    }
    if (refilled > 0) { virtio.vio_publish(&c.vdev, &c.rxq, 0); }
    return taken;
}

fn nd_mac(priv as *u8, out6 as *u8) as i64 {
    let is *VnetCtx as c = cast(*VnetCtx, priv);
    let is i64 as i with mut = 0;
    while (i < 6) { out6[i] = c.mac[i]; i = i + 1; }
    return 0;
}

fn nd_promisc(priv as *u8) as i64 {
    let is *VnetCtx as c = cast(*VnetCtx, priv);
    return c.promisc;
}

// One transaction owns the request, response and descriptor chain until the
// device returns it. The mutex may sleep; the IRQ handler never consumes ctlq.
fn nd_set_promisc(priv as *u8, on as i64) as i64 {
    let is *VnetCtx as c = cast(*VnetCtx, priv);
    mutex.acquire(&c.ctl_lock);
    if (c.ctl_enabled == 0 || c.ctl_failed != 0) {
        mutex.release(&c.ctl_lock);
        return 0 - 1;
    }
    let is i64 as head = virtio.vio_desc_alloc(&c.ctlq);
    let is i64 as ack = virtio.vio_desc_alloc(&c.ctlq);
    if (head < 0 || ack < 0) {
        if (head >= 0) { virtio.vio_desc_free_chain(&c.ctlq, head); }
        if (ack >= 0) { virtio.vio_desc_free_chain(&c.ctlq, ack); }
        mutex.release(&c.ctl_lock);
        return 0 - 1;
    }
    let is i64 as mode with mut = 0;
    if (on != 0) { mode = 1; }
    // virtio_net_ctrl_hdr { RX=0, PROMISC=0 }, then the one-byte setting.
    virtio.wr8(c.ctlq.buf_va, 0);
    virtio.wr8(c.ctlq.buf_va + 1, 0);
    virtio.wr8(c.ctlq.buf_va + 2, mode);
    virtio.wr8(c.ctlq.buf_va + 16, 255);
    virtio.vio_desc_set(&c.ctlq, head, c.ctlq.buf_phys, 3, virtio.DESC_F_NEXT, ack);
    virtio.vio_desc_set(&c.ctlq, ack, c.ctlq.buf_phys + 16, 1, virtio.DESC_F_WRITE, 0);
    virtio.vio_avail_push(&c.ctlq, head);
    virtio.vio_publish(&c.vdev, &c.ctlq, VQ_CONTROL);
    let is i64 as deadline = timer.current_time_ns() + 1000000000;
    let is i64 as got with mut = 0 - 1;
    while (got < 0 && timer.current_time_ns() < deadline) {
        got = virtio.vio_next_used(&c.ctlq);
        if (got < 0) { sched.sleep_for_ns(200000); }
    }
    if (got != head) {
        // No completion means the device may still own the DMA buffers.
        // Quarantine this queue, never reuse its chain after a timeout.
        c.ctl_failed = 1; c.promisc = 0 - 1;
        mutex.release(&c.ctl_lock);
        return 0 - 1;
    }
    let is i64 as written = c.ctlq.last_used_len;
    let is i64 as status = virtio.rd8(c.ctlq.buf_va + 16);
    virtio.vio_desc_free_chain(&c.ctlq, head);
    if (written != 1 || status != 0) {
        c.promisc = 0 - 1;
        mutex.release(&c.ctl_lock);
        return 0 - 1;
    }
    c.promisc = mode;
    mutex.release(&c.ctl_lock);
    return 0;
}

// virtio-net has no link register: if the device is here it is up. The
// STATUS field exists only when VIRTIO_NET_F_STATUS is negotiated, and we
// do not negotiate it — reporting a fact we did not ask for would be a
// guess dressed as a reading.
fn nd_link_up(priv as *u8) as i64 {
    let is *VnetCtx as c = cast(*VnetCtx, priv);
    return c.present;
}

fn nd_mtu(priv as *u8) as i64 {
    return 1500;
}

// IRQ handler: read-clear the ISR, then drain a bounded batch into the port
// ring and wake any reader.
//
// The framework hands this the *Binding as context, and the binding carries
// our per-adapter state. With a global it would have read card 0's ISR while
// card 1 kept its INTx line asserted — and on a shared line that is a wedge,
// not a slowdown.
fn vnet_irq(hw as *driver.Hardware, ctx as *u8) as i32 {
    let is *spec.Binding as b = cast(*spec.Binding, ctx);
    if (cast(i64, b) == 0) { return 0; }
    let is *VnetCtx as c = cast(*VnetCtx, b.private);
    if (cast(i64, c) == 0) { return 0; }
    if (c.present == 0) { return 0; }
    let is i64 as isr = virtio.vio_isr_read(&c.vdev);
    if ((isr & 1) == 0) { return 0; }          // not ours (shared INTx)
    if (c.port_index >= 0) { netdev.irq_drain(c.port_index); }
    return 0;
}

// ---- bind ----
fn vnet_bind(b as *spec.Binding) as i32 {
    if (nctx >= MAX_NICS) {
        serial.println("vnet: no free instance slot", 27);
        return cast(i32, 0 - 99);
    }
    let is *VnetCtx as c = ctx_at(nctx);
    let is *netdev.NetDevice as nd = nd_at(nctx);
    b.private = cast(*u8, c);
    let is i64 as hw = cast(i64, b.hardware);
    c.port_index = 0 - 1; c.promisc = 0 - 1;
    c.ctl_enabled = 0; c.ctl_failed = 0;
    mutex.name(&c.ctl_lock, cast(*u8, "vnet receive filter"), 19);
    if (virtio.vio_setup(hw, &c.vdev) != 0) {
        serial.println("vnet: no modern virtio caps", 27);
        return 1;
    }
    if (virtio.vio_negotiate_features(&c.vdev, F_MAC | F_CTRL_VQ | F_CTRL_RX, 0) != 0) {
        serial.println("vnet: feature negotiation FAIL", 30);
        return 1;
    }
    if ((c.vdev.features_lo & F_MAC) == 0 || c.vdev.devcfg == 0 || c.vdev.devcfg_len < 6) {
        serial.println("vnet: MAC configuration unavailable", 35);
        return 1;
    }
    // rx = queue 0, tx = queue 1
    if (virtio.vio_queue_setup(&c.vdev, 0, NQ, SLOT_SZ, &c.rxq) != 0) {
        serial.println("vnet: rxq setup FAIL", 20);
        return 1;
    }
    if (virtio.vio_queue_setup(&c.vdev, 1, NQ, SLOT_SZ, &c.txq) != 0) {
        serial.println("vnet: txq setup FAIL", 20);
        return 1;
    }
    if ((c.vdev.features_lo & F_CTRL_VQ) != 0) {
        if (virtio.vio_queue_setup(&c.vdev, VQ_CONTROL, 4, 16, &c.ctlq) != 0
            || c.ctlq.qsize < 2) {
            serial.println("vnet: control queue setup failed", 32);
            return 1;
        }
        if ((c.vdev.features_lo & F_CTRL_RX) != 0) { c.ctl_enabled = 1; }
    }
    // hand every rx buffer to the device (device-WRITABLE)
    let is i64 as i with mut = 0;
    while (i < c.rxq.qsize) {
        virtio.vio_post(&c.rxq, i, SLOT_SZ);
        i = i + 1;
    }
    // read the MAC from device config
    let is i64 as m with mut = 0;
    while (m < 6) {
        c.mac[m] = cast(u8, virtio.rd8(c.vdev.devcfg + CFG_MAC + m) & 0xFF);
        m = m + 1;
    }
    c.tx_inflight = 0;
    c.present = 1;
    virtio.vio_driver_ok(&c.vdev);
    if (c.ctl_enabled != 0 && nd_set_promisc(cast(*u8, c), 0) != 0) {
        serial.println("vnet: receive filter command failed", 35);
        c.present = 0;
        virtio.wr8(c.vdev.common + virtio.C_STATUS, virtio.ST_FAILED);
        return 1;
    }
    virtio.vio_publish(&c.vdev, &c.rxq, 0);
    serial.print("vnet: virtio-net up mac=", 24);
    print_mac(c);
    serial.println("", 0);

    nd.name[0] = cast(u8, 118); nd.name[1] = cast(u8, 110);     // "vnet"
    nd.name[2] = cast(u8, 101); nd.name[3] = cast(u8, 116);
    nd.name[4] = cast(u8, 0);
    nd.send        = fn_ptr(nd_send);
    nd.poll_rx     = fn_ptr(nd_poll_rx);
    nd.tx_free     = fn_ptr(nd_tx_free);
    nd.mac         = fn_ptr(nd_mac);
    nd.link_up     = fn_ptr(nd_link_up);
    nd.mtu         = fn_ptr(nd_mtu);
    nd.promisc     = fn_ptr(nd_promisc);
    nd.set_promisc = cast(fn(*u8, i64) as i64, 0);
    if (c.ctl_enabled != 0) { nd.set_promisc = fn_ptr(nd_set_promisc); }
    // And no notion of line rate at all: there is no wire. Reporting a number
    // would be inventing one.
    nd.speed       = cast(fn(*u8) as i64, 0);
    nd.priv        = cast(*u8, c);
    nd.next        = cast(*netdev.NetDevice, 0);
    let is i64 as pi = netdev.register(nd, hw);
    if (pi < 0) {
        serial.println("vnet: netdev.register failed", 28);
        return cast(i32, 0 - 5);
    }
    c.port_index = pi;
    nctx = nctx + 1;
    return 0;
}

fn print_mac(c as *VnetCtx) as void {
    let is i64 as i with mut = 0;
    while (i < 6) {
        if (i > 0) { serial.putc(58); }
        util.print_hex(cast(i64, c.mac[i]));
        i = i + 1;
    }
    return;
}

fn register() as void {
    ksym_bind.name_ptr = cast(*u8, "vnet.vnet_bind");  ksym_bind.name_len = 14;
    ksym_bind.addr = cast(i64, fn_ptr(vnet_bind));     ksym_bind.kind = ksym.KIND_FUNC;
    ksym.register(&ksym_bind);
    ksym_irq.name_ptr = cast(*u8, "vnet.vnet_irq");    ksym_irq.name_len = 13;
    ksym_irq.addr = cast(i64, fn_ptr(vnet_irq));       ksym_irq.kind = ksym.KIND_FUNC;
    ksym.register(&ksym_irq);
    serial.println("vnet: registered", 16);
}
