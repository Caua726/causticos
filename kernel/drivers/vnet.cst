// vnet.cst — virtio-net driver (virtio spec §5.1), the SECOND consumer of
// the modern PCI transport in virtio.cst. Where vtablet proved the transport
// on a one-queue input device, this proves it on a two-queue DMA device:
// a receiveq the device fills with incoming frames and a transmitq the
// driver fills with outgoing ones, each frame prefixed by a 12-byte
// virtio_net_hdr. Same NetworkController interface the e1000 implements, so
// it is a drop-in alternative NIC — the framework wires whichever device the
// hardware presents.
//
// Modern-only (VERSION_1 negotiated in virtio.cst). We do NOT negotiate
// MRG_RXBUF or CSUM/GSO offloads, so the header is the plain 12-byte form
// and num_buffers is always 1. The MAC comes from device config (the
// VIRTIO_NET_F_MAC feature QEMU always offers); we read it without
// negotiating the bit, which is fine — config is readable regardless and we
// only USE the address.

use "pci.cst" as pci;
use "driver.cst" as driver;
use "spec.cst" as spec;
use "ksym.cst" as ksym;
use "serial.cst" as serial;
use "lock.cst" as lock;
use "sched.cst" as sched;
use "timer.cst" as timer;
use "util.cst" as util;
use "virtio.cst" as virtio;

let is i64 as NET_HDR_LEN = 10;        // virtio_net_hdr, no MRG_RXBUF (legacy-compat 10 bytes... )
// NOTE: the modern (VERSION_1) header is 12 bytes — flags(1) gso_type(1)
// hdr_len(2) gso_size(2) csum_start(2) csum_offset(2) num_buffers(2).
let is i64 as HDR = 12;
let is i64 as FRAME_CAP = 2048;        // hdr + a full ethernet frame, padded
let is i64 as SLOT_SZ = 2048;
let is i64 as NQ = 16;                 // ring slots we drive per queue (<= device max)

// device config offsets (struct virtio_net_config): mac[6] then status le16
let is i64 as CFG_MAC = 0;

let is virtio.VirtioDev as vdev;
let is virtio.VirtQueue as rxq;
let is virtio.VirtQueue as txq;
let is i64 as vnet_present with mut = 0;
let is [6]u8 as vnet_mac with mut;

let is lock.TicketLock as tx_lock;
let is lock.TicketLock as rx_lock;
let is i64 as rx_waiter_tid with mut = 0 - 1;

let is ksym.KSym as ksym_bind;
let is ksym.KSym as ksym_irq;
let is ksym.KSym as ksym_send;
let is ksym.KSym as ksym_recv;
let is ksym.KSym as ksym_mac;
let is ksym.KSym as ksym_smoke;

// ---- the NetworkController vtable methods ----

// Transmit one ethernet frame: stage [12-byte zero hdr][frame] into a tx
// slot, post it, publish, then reclaim used tx descriptors (the device
// consumed earlier frames). Bounded wait for THIS frame's completion.
fn vnet_send(packet as *u8, len as i64) as i32 {
    if (vnet_present == 0) { return driver.NOT_SUPPORTED; }
    if (len < 14) { return driver.INVALID_ARGUMENT; }
    if (len + HDR > SLOT_SZ) { return driver.INVALID_ARGUMENT; }
    let is i64 as fl = lock.acquire_irq(&tx_lock);
    // reclaim completed tx buffers so the ring doesn't wedge
    let is i64 as r with mut = 0;
    while (r >= 0) { r = virtio.vio_next_used(&txq); }
    let is i64 as slot = txq.avail_shadow - (txq.avail_shadow / txq.qsize) * txq.qsize;
    let is i64 as base = txq.buf_va + slot * SLOT_SZ;
    let is i64 as z with mut = 0;
    while (z < HDR) { let is *u8 as h = cast(*u8, base + z); h[0] = cast(u8, 0); z = z + 1; }
    let is i64 as i with mut = 0;
    while (i < len) {
        let is *u8 as d = cast(*u8, base + HDR + i);
        d[0] = packet[i];
        i = i + 1;
    }
    // describe a DEVICE-READABLE buffer (no WRITE flag) of hdr+len bytes
    let is i64 as desc = txq.desc + slot * 16;
    virtio.wr64(desc, txq.buf_phys + slot * SLOT_SZ);
    virtio.wr32(desc + 8, HDR + len);
    virtio.wr16(desc + 12, 0);              // flags 0 = device reads
    virtio.wr16(desc + 14, 0);
    let is i64 as ring_slot = txq.avail_shadow - (txq.avail_shadow / txq.qsize) * txq.qsize;
    virtio.wr16(txq.avail + 4 + ring_slot * 2, slot);
    txq.avail_shadow = txq.avail_shadow + 1;
    virtio.vio_publish(&vdev, &txq, 1);
    lock.release_irq(&tx_lock, fl);
    return 0;
}

// Receive: harvest one used rx buffer if present, copy the frame (past the
// 12-byte header) into the caller's buffer, repost the slot. Non-blocking;
// returns bytes (>0), 0 if nothing pending, or a negative driver code.
fn vnet_recv(packet as i64, max_len as i64) as i32 {
    if (vnet_present == 0) { return driver.NOT_SUPPORTED; }
    let is i64 as fl = lock.acquire_irq(&rx_lock);
    let is i64 as id = virtio.vio_next_used(&rxq);
    if (id < 0) { lock.release_irq(&rx_lock, fl); return cast(i32, 0); }
    // used.len isn't surfaced by vio_next_used; re-read it from the used ring
    // is awkward, so trust the frame: the device wrote hdr+frame, and the
    // ethernet frame length is bounded by SLOT_SZ. We copy up to max_len
    // starting past the header; the caller knows ethernet framing.
    let is i64 as base = rxq.buf_va + id * SLOT_SZ;
    let is i64 as used_len = rxq.last_used_len;     // set by vio_next_used
    let is i64 as flen with mut = used_len - HDR;
    if (flen < 0) { flen = 0; }
    if (flen > max_len) { flen = max_len; }
    let is i64 as i with mut = 0;
    while (i < flen) {
        let is *u8 as s = cast(*u8, base + HDR + i);
        let is *u8 as d = cast(*u8, packet + i);
        d[0] = s[0];
        i = i + 1;
    }
    virtio.vio_repost(&rxq, id);
    virtio.vio_publish(&vdev, &rxq, 0);
    lock.release_irq(&rx_lock, fl);
    return cast(i32, flen);
}

fn vnet_mac() as *u8 {
    return cast(*u8, &vnet_mac[0]);
}

// IRQ handler: read-clear the ISR and wake any rx waiter (the actual
// harvest happens in vnet_recv, driven by the consumer).
fn vnet_irq(hw as *driver.Hardware, ctx as *u8) as i32 {
    if (vnet_present == 0) { return 0; }
    let is i64 as isr = virtio.vio_isr_read(&vdev);
    if ((isr & 1) == 0) { return 0; }
    if (rx_waiter_tid >= 0) { sched.wakeup_thread(rx_waiter_tid); }
    return 0;
}

// ---- bind ----
fn vnet_bind(b as *spec.Binding) as i32 {
    if (vnet_present != 0) {
        serial.println("vnet: skipping 2nd nic", 22);
        return cast(i32, 0 - 99);
    }
    let is i64 as hw = cast(i64, b.hardware);
    if (virtio.vio_setup(hw, &vdev) != 0) {
        serial.println("vnet: no modern virtio caps", 27);
        return 1;
    }
    if (virtio.vio_negotiate(&vdev) != 0) {
        serial.println("vnet: feature negotiation FAIL", 30);
        return 1;
    }
    // rx = queue 0, tx = queue 1
    if (virtio.vio_queue_setup(&vdev, 0, NQ, SLOT_SZ, &rxq) != 0) {
        serial.println("vnet: rxq setup FAIL", 20);
        return 1;
    }
    if (virtio.vio_queue_setup(&vdev, 1, NQ, SLOT_SZ, &txq) != 0) {
        serial.println("vnet: txq setup FAIL", 20);
        return 1;
    }
    // hand every rx buffer to the device (device-WRITABLE)
    let is i64 as i with mut = 0;
    while (i < rxq.qsize) {
        virtio.vio_post(&rxq, i, SLOT_SZ);
        i = i + 1;
    }
    // read the MAC from device config
    if (vdev.devcfg != 0) {
        let is i64 as m with mut = 0;
        while (m < 6) {
            vnet_mac[m] = cast(u8, virtio.rd8(vdev.devcfg + CFG_MAC + m) & 0xFF);
            m = m + 1;
        }
    }
    virtio.vio_driver_ok(&vdev);
    virtio.vio_publish(&vdev, &rxq, 0);
    vnet_present = 1;
    serial.print("vnet: virtio-net up mac=", 24);
    print_mac();
    serial.println("", 0);
    // Run the ARP smoke inline (like the e1000 bind), exercising the second
    // virtio consumer's TX + RX path once before bind returns.
    smoke_thread();
    return 0;
}

fn print_mac() as void {
    let is i64 as i with mut = 0;
    while (i < 6) {
        if (i > 0) { serial.putc(58); }
        util.print_hex(cast(i64, vnet_mac[i]));
        i = i + 1;
    }
    return;
}

// ---- ARP smoke (mirrors the e1000 one: send a request, await SLIRP's reply) ----
fn store_be16(out as *u8, off as i64, v as i64) as void {
    out[off] = cast(u8, (v >> 8) & 0xFF);
    out[off + 1] = cast(u8, v & 0xFF);
    return;
}

fn build_arp(out as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (i < 6) { out[i] = cast(u8, 0xFF); i = i + 1; }
    let is i64 as j with mut = 0;
    while (j < 6) { out[6 + j] = vnet_mac[j]; j = j + 1; }
    store_be16(out, 12, 0x0806);
    store_be16(out, 14, 0x0001);
    store_be16(out, 16, 0x0800);
    out[18] = cast(u8, 6); out[19] = cast(u8, 4);
    store_be16(out, 20, 0x0001);
    let is i64 as k with mut = 0;
    while (k < 6) { out[22 + k] = vnet_mac[k]; k = k + 1; }
    out[28] = cast(u8, 10); out[29] = cast(u8, 0); out[30] = cast(u8, 2); out[31] = cast(u8, 15);
    let is i64 as l with mut = 0;
    while (l < 6) { out[32 + l] = cast(u8, 0); l = l + 1; }
    out[38] = cast(u8, 10); out[39] = cast(u8, 0); out[40] = cast(u8, 2); out[41] = cast(u8, 2);
    return 42;
}

fn smoke_thread() as void {
    if (vnet_present == 0) {
        serial.println("vnet.smoke: not bound", 21);
        return;
    }
    serial.println("vnet.smoke: start", 17);
    let is [64]u8 as arp;
    let is i64 as alen = build_arp(&arp[0]);
    if (vnet_send(&arp[0], alen) != 0) {
        serial.println("vnet.smoke: send FAIL", 21);
        return;
    }
    serial.println("vnet.smoke: sent ARP", 20);
    rx_waiter_tid = sched.current_tid();
    let is [128]u8 as rxbuf;
    let is i64 as deadline = timer.current_time_ns() + 2000000000;
    while (timer.current_time_ns() < deadline) {
        let is i32 as rc = vnet_recv(cast(i64, &rxbuf[0]), 128);
        if (rc > 0) {
            serial.print("vnet.smoke: rx ", 15);
            util.print_num(cast(i64, rc));
            serial.print("B type=", 7);
            util.print_hex(cast(i64, rxbuf[12]));
            util.print_hex(cast(i64, rxbuf[13]));
            serial.println("", 0);
            rx_waiter_tid = cast(i64, 0 - 1);
            serial.println("vnet.smoke: PASS", 16);
            return;
        }
        sched.sleep_for_ns(20000000);
    }
    rx_waiter_tid = cast(i64, 0 - 1);
    serial.println("vnet.smoke: no reply in 2s FAIL", 31);
    return;
}

fn register() as void {
    ksym_bind.name_ptr = cast(*u8, "vnet.vnet_bind");  ksym_bind.name_len = 14;
    ksym_bind.addr = cast(i64, fn_ptr(vnet_bind));     ksym_bind.kind = ksym.KIND_FUNC;
    ksym.register(&ksym_bind);
    ksym_irq.name_ptr = cast(*u8, "vnet.vnet_irq");    ksym_irq.name_len = 13;
    ksym_irq.addr = cast(i64, fn_ptr(vnet_irq));       ksym_irq.kind = ksym.KIND_FUNC;
    ksym.register(&ksym_irq);
    ksym_send.name_ptr = cast(*u8, "vnet.vnet_send");  ksym_send.name_len = 14;
    ksym_send.addr = cast(i64, fn_ptr(vnet_send));     ksym_send.kind = ksym.KIND_FUNC;
    ksym.register(&ksym_send);
    ksym_recv.name_ptr = cast(*u8, "vnet.vnet_recv");  ksym_recv.name_len = 14;
    ksym_recv.addr = cast(i64, fn_ptr(vnet_recv));     ksym_recv.kind = ksym.KIND_FUNC;
    ksym.register(&ksym_recv);
    ksym_mac.name_ptr = cast(*u8, "vnet.vnet_mac");    ksym_mac.name_len = 13;
    ksym_mac.addr = cast(i64, fn_ptr(vnet_mac));       ksym_mac.kind = ksym.KIND_FUNC;
    ksym.register(&ksym_mac);
    ksym_smoke.name_ptr = cast(*u8, "vnet.smoke_thread"); ksym_smoke.name_len = 17;
    ksym_smoke.addr = cast(i64, fn_ptr(smoke_thread));    ksym_smoke.kind = ksym.KIND_FUNC;
    ksym.register(&ksym_smoke);
    serial.println("vnet: registered", 16);
}
