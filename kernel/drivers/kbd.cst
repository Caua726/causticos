// kbd.cst — PS/2 keyboard driver, spec-framework style.
// Declares match + CAP_IRQ in kernel/kbd.cdvrspec. The framework allocates
// the vector, programs the IOAPIC redirection, and registers the handler.
//
// The keyboard is a DEVICE that yields RAW events (docs/architecture.md §8):
// the IRQ handler decodes the PS/2 set-1 protocol only as far as the device
// itself defines it — scancode + down/up + the 0xE0 "extended" prefix — and
// enqueues a 2-byte event. It applies NO keymap: layout, "Ctrl+C", which
// scancode is which char — all userspace policy. dev_open(DEV_KEYBOARD)
// hands back a KOBJ_DEVICE whose read drains the raw-event ring (lossless;
// the holder sees presses AND releases). Mechanism in the kernel, policy out.
//
// The one thing a holder tells the keyboard is which LEDs to light. CapsLock
// being on is a fact of the layout, which is userspace's; the keyboard only
// shows what it is told. write() on the device takes that byte.

use "driver.cst" as driver;
use "spec.cst" as spec;
use "ksym.cst" as ksym;
use "port.cst" as port;
use "serial.cst" as serial;
use "kobject.cst" as kobject;
use "lock.cst" as lock;
use "sched.cst" as sched;
use "abi.cst" as abi;
use "i8042.cst" as i8042;
use "grab.cst" as grab;
use "timer.cst" as timer;
use "util.cst" as util;

// 2-byte events: [scancode, flags]. flags bit0 = pressed (1) / released (0),
// bit1 = extended (0xE0-prefixed). 256-byte ring = 128 events.
let is i64 as KBD_CAP  = 256;
let is i64 as KBD_MASK = 255;

let is [256]u8 as kbd_buf with mut;
let is i64 as kbd_head with mut = 0;
let is i64 as kbd_tail with mut = 0;
let is i64 as kbd_count with mut = 0;
let is i64 as kbd_e0 with mut = 0;            // 0xE0 prefix pending
// Events the ring had no room for, since the last time the reader was told.
// Said in words on the next read: a lost key is otherwise invisible — the
// holder just sees a command line with letters missing.
let is i64 as kbd_dropped with mut = 0;
// LED command in flight. The keyboard answers each command byte with ACK
// (0xFA) or RESEND (0xFE), and those come in on IRQ1 like keys do — but 0xFE
// is also the release of key 0x7E (ABNT2's keypad point), so a byte is taken
// as an answer only while one is awaited.
let is i64 as kbd_want with mut = 0;          // 1 = a command byte awaits its answer
let is i64 as kbd_answer with mut = 0;        // 0xFA, 0xFE, or 0 = nothing yet
let is i64 as kbd_leds with mut = 0;          // what the LEDs show: bit0 Scroll, bit1 Num, bit2 Caps
let is lock.TicketLock as kbd_lk;

let is ksym.KSym as ksym_handler;
let is ksym.KSym as ksym_acquire;
let is ksym.KSym as ksym_bind;
let is kobject.KObjectOps as KBD_OPS with mut;

// Preemptible exclusivity (architecture.md §6): each open holds a token on
// the grab stack; only the TOP holder's reads/polls see events. priv IS the
// token (a monotonic id — 0 is reserved for "nobody").
let is grab.GrabStack as kbd_gs;
let is i64 as kbd_next_token with mut = 1;

// --- i8042 bring-up (shared controller module: kernel/i8042.cst) ---
// Limine hands us a minimal machine; the firmware does not leave IRQ1 armed.
// Without enabling it in the controller config byte the keyboard never raises
// an interrupt, so the IOAPIC redirection the framework programs has nothing to
// deliver — keypresses vanish. (The kbd_smoke only ever used inject_event, so
// the real IRQ path was never exercised: hence the old "QEMU has no input".)
//
// on_bind: arm the controller's KEYBOARD port so keypresses raise IRQ1.
// Touches only kbd-side state — the aux (mouse) port belongs to the mouse
// driver; disabling or reconfiguring it here would clobber a mouse that
// bound first. config_update preserves the aux/translation bits, so kbd and
// mouse can bind in either order.
fn kbd_bind(b as *spec.Binding) as i32 {
    i8042.lock_ctl();
    i8042.flush();                                   // drain any stale output byte
    if (i8042.cmd(i8042.CMD_KBD_DISABLE) != 0) {
        i8042.report_fail("kbd", 3, 1);
        i8042.unlock_ctl();
        return 1;
    }
    i8042.flush();
    // bit0=1: IRQ1 on; bit4=0: kbd clock on. Aux bits (1/5) and translation
    // (bit6) pass through untouched.
    if (i8042.config_update(i8042.CFG_KBD_IRQ, i8042.CFG_KBD_CLK_OFF) != 0) {
        i8042.report_fail("kbd", 3, 2);
        i8042.unlock_ctl();
        return 1;
    }
    if (i8042.cmd(i8042.CMD_KBD_ENABLE) != 0) {
        i8042.report_fail("kbd", 3, 3);
        i8042.unlock_ctl();
        return 1;
    }
    i8042.flush();
    i8042.unlock_ctl();
    // Drop anything the bring-up enqueued (an ACK/spurious byte that fired the
    // now-armed IRQ) so the first real keypress — and the kbd_smoke — start on a
    // clean ring, with no phantom event.
    let is i64 as flr = lock.acquire_irq(&kbd_lk);
    kbd_head = 0; kbd_tail = 0; kbd_count = 0; kbd_e0 = 0;
    lock.release_irq(&kbd_lk, flr);
    serial.println("kbd: i8042 init (IRQ1 on)", 25);
    return 0;
}

// Every holder waits on the one ring, named by its grab stack: priv is only a
// token, the same small number another device hands out too.
fn kbd_wait_key(priv as i64) as i64 { return cast(i64, &kbd_gs); }

fn kbd_init() as void {
    KBD_OPS.read  = fn_ptr(kbd_read);
    KBD_OPS.close = fn_ptr(kbd_close);
    KBD_OPS.poll  = fn_ptr(kbd_poll);
    KBD_OPS.wait_key = fn_ptr(kbd_wait_key);
    KBD_OPS.write = fn_ptr(kbd_write);
    // mmap/present/lseek/readdir stay null — a keyboard is a raw-event stream
    // with LEDs, not a byte file, not a surface.
}

// Readiness for SYS_POLL: READABLE when at least one whole 2-byte event is
// queued AND this holder owns the grab. Never WRITABLE — write is a null op
// here, and "writable" must mean "a write would make progress".
fn kbd_poll(priv as i64) as i64 {
    if (grab.top(&kbd_gs) != priv) { return 0; }    // preempted: quiet
    let is i64 as fl = lock.acquire_irq(&kbd_lk);
    let is i64 as c = kbd_count;
    lock.release_irq(&kbd_lk, fl);
    if (c >= 2) { return abi.POLL_READABLE; }
    return 0;
}

// Enqueue one 2-byte raw event. Full buffer drops the event (bounded; a
// reader that vanishes can't make us grow without limit). Caller must NOT
// hold kbd_lk.
fn kbd_enqueue(sc as i64, flags as i64) as void {
    let is i64 as fl = lock.acquire_irq(&kbd_lk);
    let is i64 as pushed with mut = 0;
    if (kbd_count + 2 <= KBD_CAP) {
        kbd_buf[kbd_tail] = cast(u8, sc & 0xFF);
        kbd_tail = (kbd_tail + 1) & KBD_MASK;
        kbd_buf[kbd_tail] = cast(u8, flags & 0xFF);
        kbd_tail = (kbd_tail + 1) & KBD_MASK;
        kbd_count = kbd_count + 2;
        pushed = 1;
    } else {
        kbd_dropped = kbd_dropped + 1;
    }
    lock.release_irq(&kbd_lk, fl);
    // Woken AFTER the ring lock is dropped: the woken reader takes that same
    // lock, and holding it across the wake would hand it a lock we still own.
    if (pushed == 1) { sched.poll_wake_key(cast(i64, &kbd_gs)); }
}

// IRQ handler: drain keyboard bytes, decode the set-1 protocol (down/up +
// the 0xE0 extended prefix), enqueue raw events. No keymap, no logging.
// The status byte is sampled BEFORE 0x60: stop when the buffer is empty
// (spurious IRQ → no blind read), and never consume a byte flagged ST_AUX —
// the controller FIFO is shared and that byte belongs to the mouse driver's
// IRQ12 handler (the classic i8042 cross-steal).
fn handler(dev as *driver.Hardware, ctx as *u8) as i32 {
    while (1 == 1) {
        let is i64 as st = port.inb(0x64);
        if ((st & i8042.ST_OBF) == 0) { return 0; }
        if ((st & i8042.ST_AUX) != 0) { return 0; }
        let is i64 as byte = port.inb(0x60);
        let is i64 as fa = lock.acquire_irq(&kbd_lk);
        let is i64 as answered with mut = 0;
        if (kbd_want == 1 && (byte == 0xFA || byte == 0xFE)) {
            kbd_answer = byte;
            kbd_want = 0;
            answered = 1;
        }
        lock.release_irq(&kbd_lk, fa);
        if (answered == 1) {
            // the answer to an LED command, not a key
        } else if (byte == 0xE0) {
            let is i64 as fl = lock.acquire_irq(&kbd_lk);
            kbd_e0 = 1;
            lock.release_irq(&kbd_lk, fl);
        } else {
            let is i64 as pressed with mut = 1;
            if ((byte & 0x80) != 0) { pressed = 0; }
            let is i64 as sc = byte & 0x7F;
            let is i64 as fl2 = lock.acquire_irq(&kbd_lk);
            let is i64 as e0 = kbd_e0;
            kbd_e0 = 0;
            lock.release_irq(&kbd_lk, fl2);
            let is i64 as flags with mut = pressed;
            if (e0 != 0) { flags = flags | 2; }
            kbd_enqueue(sc, flags);
        }
    }
    return 0;
}

// Test hook: inject a synthetic raw event (same path the IRQ uses), so the
// device can be exercised without physical key presses (QEMU has no input).
fn inject_event(sc as i64, flags as i64) as void {
    kbd_enqueue(sc, flags);
}

// Wipe the event ring — events buffered for one holder must never leak to
// the next when the grab changes hands.
fn kbd_ring_clear() as void {
    let is i64 as fl = lock.acquire_irq(&kbd_lk);
    kbd_head = 0; kbd_tail = 0; kbd_count = 0; kbd_e0 = 0;
    lock.release_irq(&kbd_lk, fl);
    return;
}

// Device read op: drain raw-event bytes from the ring. Blocks (polling, like
// the channel) until at least one byte is available — there is no EOF for a
// keyboard. A holder that is not the grab-stack TOP is quiet: its read
// keeps blocking until ownership returns (architecture.md §6).
fn kbd_read(priv as i64, buf as i64, n as i64) as i64 {
    if (n <= 0) { return 0; }
    let is i64 as done with mut = 0;
    let is i64 as result with mut = 0;
    while (done == 0) {
        if (grab.top(&kbd_gs) != priv) {
            if (sched.sleep_interruptible(2000000) != 0) { return abi.E_INTR; }
        } else {
            let is i64 as fl = lock.acquire_irq(&kbd_lk);
            let is i64 as avail = kbd_count;
            let is i64 as take with mut = n;
            if (take > avail) { take = avail; }
            let is i64 as i with mut = 0;
            while (i < take) {
                let is *u8 as d = cast(*u8, buf + i);
                d[0] = kbd_buf[kbd_head];
                kbd_head = (kbd_head + 1) & KBD_MASK;
                i = i + 1;
            }
            kbd_count = kbd_count - take;
            let is i64 as lost = kbd_dropped;
            kbd_dropped = 0;
            lock.release_irq(&kbd_lk, fl);
            if (lost > 0) {
                serial.print("kbd: ", 5);
                util.print_num(lost);
                serial.println(" key events lost: the ring was full (the reader fell behind)", 60);
            }
            if (take > 0) { result = take; done = 1; }
            else { if (sched.sleep_interruptible(2000000) != 0) { return abi.E_INTR; } }      // 2 ms, no events yet
        }
    }
    return result;
}

// Send one command byte to the keyboard and wait for its ACK, sending it again
// when the keyboard asks (RESEND), three times at most. 0 = acknowledged;
// -1 = the controller would not take the byte, -2 = no answer in 50 ms,
// -3 = still RESEND after three tries. Called with the controller lock held.
fn _kbd_send(byte as i64) as i64 {
    let is i64 as tries with mut = 0;
    while (tries < 3) {
        let is i64 as fl = lock.acquire_irq(&kbd_lk);
        kbd_want = 1;
        kbd_answer = 0;
        lock.release_irq(&kbd_lk, fl);
        if (i8042.write_data(byte) != 0) {
            let is i64 as f2 = lock.acquire_irq(&kbd_lk);
            kbd_want = 0;
            lock.release_irq(&kbd_lk, f2);
            return 0 - 1;
        }
        // A keyboard answers in well under a millisecond; 50 ms is for one
        // that is busy scanning. Tight first, then 1 ms naps.
        let is i64 as start = timer.current_time_ns();
        let is i64 as got with mut = 0;
        while (got == 0) {
            let is i64 as f3 = lock.acquire_irq(&kbd_lk);
            got = kbd_answer;
            lock.release_irq(&kbd_lk, f3);
            if (got == 0) {
                let is i64 as now = timer.current_time_ns();
                if (now - start >= 50000000) { break; }
                if (now - start >= 200000) { sched.sleep_for_ns(1000000); }
            }
        }
        let is i64 as f4 = lock.acquire_irq(&kbd_lk);
        kbd_want = 0;
        lock.release_irq(&kbd_lk, f4);
        if (got == 0xFA) { return 0; }
        if (got == 0) { return 0 - 2; }
        tries = tries + 1;                                   // RESEND
    }
    return 0 - 3;
}

// Device write op: the LEDs. The last byte written is what holds — bit 0
// Scroll Lock, bit 1 Num Lock, bit 2 Caps Lock, the keyboard's own order; the
// other bits must be 0. Only the holder on top of the grab stack lights them
// (the one being typed at); one that is preempted gets E_AGAIN. A keyboard
// that does not acknowledge is E_IO, and the serial line says how it failed.
fn kbd_write(priv as i64, buf as i64, n as i64) as i64 {
    if (n <= 0) { return 0; }
    if (grab.top(&kbd_gs) != priv) { return abi.E_AGAIN; }
    let is *u8 as b = cast(*u8, buf + n - 1);
    let is i64 as mask = cast(i64, b[0]);
    if ((mask & 0xF8) != 0) { return abi.E_INVAL; }
    if (mask == kbd_leds) { return n; }
    i8042.lock_ctl();
    let is i64 as rc with mut = _kbd_send(0xED);
    if (rc == 0) {
        rc = _kbd_send(mask);
        // The keyboard took 0xED and still waits for its argument. A command
        // in its place ends the wait; enable-scanning (0xF4) is one it always
        // takes and that changes nothing.
        if (rc != 0) { _kbd_send(0xF4); }
    }
    i8042.unlock_ctl();
    if (rc != 0) {
        serial.print("kbd: LED command failed (", 25);
        if (rc == 0 - 1) { serial.print("controller busy", 15); }
        else if (rc == 0 - 2) { serial.print("no answer in 50 ms", 18); }
        else { serial.print("RESEND three times", 18); }
        serial.println(")", 1);
        return abi.E_IO;
    }
    kbd_leds = mask;
    return n;
}

fn kbd_close(priv as i64) as i64 {
    let is i64 as newtop = grab.remove(&kbd_gs, priv);
    // hand the device back clean: the restored holder starts from silence
    if (newtop != 0) { kbd_ring_clear(); }
    return abi.E_OK;
}

// dev_open(DEV_KEYBOARD) → a KOBJ_DEVICE over the raw-event ring. Each open
// pushes a holder token on the grab stack and becomes the active owner —
// preempting (muting) whoever held it before; closing restores them. ctx is
// the keyboard's Hardware node (the instance discriminator) — unused since
// the PS/2 controller has one keyboard port and one global ring.
fn kbd_acquire(ctx as i64) as i64 {
    kbd_next_token = kbd_next_token + 1;
    let is i64 as token = kbd_next_token;
    if (grab.push(&kbd_gs, token) != 0) { return 0; }   // stack full → open fails
    kbd_ring_clear();                                   // new owner starts clean
    let is i64 as ko = kobject.ko_alloc(kobject.KOBJ_DEVICE, &KBD_OPS, token);
    if (ko == 0) { grab.remove(&kbd_gs, token); return 0; }
    return ko;
}

// The DEV_KEYBOARD class is declared in kbd.cdvrspec (`device { class: keyboard;
// acquire: kbd.kbd_acquire }`) — the framework device_register's this acquire
// after the bind, so there is no on_bind glue here. The spec text is the single
// source of truth for "what class this driver provides".

fn register() as void {
    ksym_handler.name_ptr = cast(*u8, "kbd.handler");
    ksym_handler.name_len = 11;
    ksym_handler.addr     = cast(i64, fn_ptr(handler));
    ksym_handler.kind     = ksym.KIND_FUNC;
    ksym.register(&ksym_handler);
    ksym_acquire.name_ptr = cast(*u8, "kbd.kbd_acquire");
    ksym_acquire.name_len = 15;
    ksym_acquire.addr     = cast(i64, fn_ptr(kbd_acquire));
    ksym_acquire.kind     = ksym.KIND_FUNC;
    ksym.register(&ksym_acquire);
    ksym_bind.name_ptr = cast(*u8, "kbd.kbd_bind");
    ksym_bind.name_len = 12;
    ksym_bind.addr     = cast(i64, fn_ptr(kbd_bind));
    ksym_bind.kind     = ksym.KIND_FUNC;
    ksym.register(&ksym_bind);
    serial.println("kbd: registered", 15);
}
