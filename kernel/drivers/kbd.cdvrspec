# PS/2 keyboard driver — legacy, routed through the platform bus.
# IRQ line 1 on the IOAPIC; framework allocates the driver vector
# and wires the redirection entry.

driver "kbd" {
    match {
        bus: platform
        name: kbd
    }
    capabilities {
        irq: auto
    }
    device {
        class: keyboard
        acquire: kbd.kbd_acquire
    }
    lifecycle {
        on_bind: kbd.kbd_bind
        on_irq: kbd.handler
    }
}
