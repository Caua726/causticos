# dummy.cdvrspec — driver spec for the synthetic dummy bus
driver "dummy" {
    match {
        bus: dummy
    }
    capabilities {
        # dma: <size_bytes>, <flags>  (flag bit 0 = 32-bit-only -> below 4 GiB)
        dma: 4096, 1
        # portio: <base_port>, <count>; memory: <zeroed pool size in bytes>
        portio: 0x80, 16
        memory: 4096
    }
    lifecycle {
        on_bind: dummybus.dummy_bind
    }
}
