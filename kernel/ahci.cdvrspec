# AHCI SATA controller. PCI class 0x01 / subclass 0x06. BAR5 (ABAR)
# holds the HBA memory-mapped registers. IRQ line comes from PCI
# config 0x3C; Phase E1 polls instead of using the vector, so on_irq
# is omitted here and wired in E2 when submit_io lands.

driver "ahci" {
    match {
        bus: pci
        class: 0x01
        subclass: 0x06
    }
    capabilities {
        mmio: 5, 0x2000
    }
    lifecycle {
        on_bind: ahci.ahci_bind
    }
}
