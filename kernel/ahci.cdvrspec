# AHCI SATA controller. PCI class 0x01 / subclass 0x06. BAR5 (ABAR)
# holds the HBA memory-mapped registers. IRQ line comes from PCI
# config 0x3C via the bus vtable (irq: auto).

driver "ahci" {
    match {
        bus: pci
        class: 0x01
        subclass: 0x06
    }
    capabilities {
        mmio: 5, 0x2000
        irq: auto
    }
    lifecycle {
        on_bind: ahci.ahci_bind
        on_irq: ahci.ahci_irq
    }
}
