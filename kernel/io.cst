// io.cst — framework-owned I/O queue infrastructure.
//
// Drivers don't implement read_lba/write_lba as blocking vtable methods.
// They provide two primitives:
//
//   submit_io(req)   — translate the request into a hardware command,
//                      kick off the transfer, return immediately.
//   harvest_io(out)  — called from the IRQ handler; drain any completed
//                      hardware commands and return the BlockRequest
//                      that corresponds to each.
//
// Callers interact through io.read_sync / io.write_sync (blocking) or
// io.submit / io.wait_complete (async). The framework owns the queue
// between caller and driver, handles the scheduler wait/wake, and
// carries the request lifecycle. Drivers stay stateless per-request.

use "heap.cst" as heap;
use "sched.cst" as sched;
use "serial.cst" as serial;
use "util.cst" as util;
use "driver.cst" as driver;
use "lock.cst" as lock;

// ============================================================
// Request model
// ============================================================

// Operation kinds. Extended as new device classes arrive (network TX/RX,
// GPU transfer, etc.) — pattern stays the same.
let is i64 as OP_READ  = 1;
let is i64 as OP_WRITE = 2;
let is i64 as OP_FLUSH = 3;

// Lifecycle states. Framework owns transitions; driver is stateless.
let is i64 as REQ_INIT      = 0;
let is i64 as REQ_PENDING   = 1;   // in submit queue, not yet dispatched
let is i64 as REQ_SUBMITTED = 2;   // driver owns it, waiting on hardware
let is i64 as REQ_COMPLETE  = 3;   // hardware done, ready for harvest
let is i64 as REQ_CANCELLED = 4;   // caller died or timed out

struct BlockRequest {
    op as i64;              // OP_READ / OP_WRITE / OP_FLUSH
    state as i64;           // REQ_*
    port as i64;            // port/lane index (AHCI port, NVMe queue)
    lba as i64;             // logical block address
    count as i64;           // number of blocks
    buf as *u8;             // caller-owned buffer
    // status is i64 (not i32) — Caustic miscompiles mixed-width
    // adjacent struct fields, an i32 followed by an i64 lets the
    // i32 store bleed into the i64 slot (or vice versa). Keeping
    // every scalar at 8 bytes is the project-wide convention. The
    // wider value is harmless: callers cast (i32, status) at the
    // boundary, drivers store small ints (0 / -1) in it.
    status as i64;          // 0=OK, nonzero=error (set by driver on complete)
    waiter_tid as i64;      // thread to wake on completion (-1 if async)
    driver_slot as i64;     // opaque; driver can stash HW slot index here
    next as *BlockRequest;  // queue link
}

// ============================================================
// Per-device queue
// ============================================================

// A BlockIOProvider is a handle the driver registers with io.register
// during its on_bind callback. The framework stores submit / harvest
// fn pointers plus a private pointer so the driver can find its state.
struct BlockIOProvider {
    device as *driver.Hardware;    // identifies the provider
    submit_io as fn(*BlockIOProvider, *BlockRequest) as i32;
    harvest_io as fn(*BlockIOProvider, **BlockRequest) as i32;
    private as *u8;                 // driver-owned state pointer
    pending_head as *BlockRequest;  // submitted, awaiting completion
    pending_count as i64;
    next as *BlockIOProvider;       // global provider list
    // Per-provider lock protecting the pending_head linked list
    // and pending_count. Under SMP the old `preempt_disable` guard
    // prevented re-entry on the same cpu but not cross-cpu races:
    // two cpus concurrently doing pending_push/pending_remove could
    // lose entries or corrupt the chain. Ticket lock serialises.
    pending_lock as lock.TicketLock;
}

let is i64 as providers with mut = 0;
let is i64 as provider_count with mut = 0;

// Called by drivers in on_bind. The provider struct is typically
// .bss-allocated by the driver and passed by pointer here so we can
// populate fn pointers and link it into the global list.
fn register(p as *BlockIOProvider) as i32 {
    if (cast(i64, p) == 0) { return driver.INVALID_ARGUMENT; }
    if (cast(i64, p.submit_io) == 0) { return driver.INVALID_ARGUMENT; }
    if (cast(i64, p.harvest_io) == 0) { return driver.INVALID_ARGUMENT; }

    sched.preempt_disable();
    p.next = cast(*BlockIOProvider, providers);
    providers = cast(i64, p);
    provider_count = provider_count + 1;
    sched.preempt_enable();

    serial.print("io: block provider registered dev=", 34);
    util.print_hex(cast(i64, p.device));
    serial.println("", 0);
    return driver.OK;
}

// Find the first provider bound to a given Hardware. For V1 there is
// at most one block provider per device; this becomes a hash later.
fn find_provider(dev as *driver.Hardware) as *BlockIOProvider {
    let is *BlockIOProvider as p with mut = cast(*BlockIOProvider, providers);
    while (cast(i64, p) != 0) {
        if (cast(i64, p.device) == cast(i64, dev)) { return p; }
        p = p.next;
    }
    return cast(*BlockIOProvider, 0);
}

// ============================================================
// Framework-owned lifecycle
// ============================================================

fn new_request(op as i64, port as i64, lba as i64, count as i64,
               buf as *u8) as *BlockRequest {
    let is i64 as addr = heap.kmalloc(sizeof(BlockRequest), 0);
    if (addr == 0) { return cast(*BlockRequest, 0); }
    let is *BlockRequest as r = cast(*BlockRequest, addr);
    r.op = op;
    r.state = REQ_INIT;
    r.port = port;
    r.lba = lba;
    r.count = count;
    r.buf = buf;
    r.status = 0;
    r.waiter_tid = cast(i64, 0 - 1);
    r.driver_slot = 0;
    r.next = cast(*BlockRequest, 0);
    return r;
}

fn free_request(r as *BlockRequest) as void {
    if (cast(i64, r) == 0) { return; }
    heap.kfree(cast(i64, r));
}

// Push request into provider's pending chain. Caller is responsible for
// preempt locking around this if needed.
fn pending_push(p as *BlockIOProvider, r as *BlockRequest) as void {
    r.next = p.pending_head;
    p.pending_head = r;
    p.pending_count = p.pending_count + 1;
}

// Remove request from pending chain by pointer identity. Returns 1 if
// found and unlinked, 0 otherwise.
fn pending_remove(p as *BlockIOProvider, r as *BlockRequest) as i32 {
    let is *BlockRequest as prev with mut = cast(*BlockRequest, 0);
    let is *BlockRequest as cur with mut = p.pending_head;
    while (cast(i64, cur) != 0) {
        if (cast(i64, cur) == cast(i64, r)) {
            if (cast(i64, prev) == 0) { p.pending_head = cur.next; }
            else { prev.next = cur.next; }
            cur.next = cast(*BlockRequest, 0);
            p.pending_count = p.pending_count - 1;
            return 1;
        }
        prev = cur;
        cur = cur.next;
    }
    return 0;
}

// ============================================================
// Async submission
// ============================================================

// Enqueue request with the driver. Returns 0 on accept, nonzero on
// reject (e.g. hardware queue full, device not bound). On accept the
// request is owned by the driver/framework until it completes.
fn submit(p as *BlockIOProvider, r as *BlockRequest) as i32 {
    if (cast(i64, p) == 0) { return driver.INVALID_ARGUMENT; }
    if (cast(i64, r) == 0) { return driver.INVALID_ARGUMENT; }

    r.state = REQ_PENDING;
    let is i64 as pflags = lock.acquire_irq(&p.pending_lock);
    pending_push(p, r);
    lock.release_irq(&p.pending_lock, pflags);

    r.state = REQ_SUBMITTED;
    let is i32 as rc = call(p.submit_io, p, r);
    if (rc != 0) {
        let is i64 as pf2 = lock.acquire_irq(&p.pending_lock);
        pending_remove(p, r);
        lock.release_irq(&p.pending_lock, pf2);
        r.state = REQ_INIT;
        return rc;
    }
    return 0;
}

// Called by the driver's IRQ path (or a harvest thread). Pulls one
// completion out of the hardware and hands it back for waiter wakeup /
// callback dispatch. Returns 1 if a request was completed, 0 if none.
fn harvest_one(p as *BlockIOProvider) as i32 {
    let is *BlockRequest as r with mut = cast(*BlockRequest, 0);
    let is i32 as rc = call(p.harvest_io, p, &r);
    if (rc != 1) { return 0; }
    if (cast(i64, r) == 0) { return 0; }

    let is i64 as pflags = lock.acquire_irq(&p.pending_lock);
    pending_remove(p, r);
    lock.release_irq(&p.pending_lock, pflags);

    r.state = REQ_COMPLETE;
    if (r.waiter_tid >= 0) {
        sched.wakeup_thread(r.waiter_tid);
    }
    return 1;
}

// Harvest loop — drivers call this from IRQ handler until it returns 0.
fn harvest_all(p as *BlockIOProvider) as i64 {
    let is i64 as n with mut = 0;
    while (harvest_one(p) == 1) { n = n + 1; }
    return n;
}

// ============================================================
// Sync wrappers
// ============================================================

// Race-free wait for r.state == REQ_COMPLETE.
//
// The pre-SMP version leaned on `cli` to mask the completing IRQ,
// but under SMP an IRQ on another cpu is not masked by our local
// `cli`. The lost-wakeup window is:
//
//   CPU A:  r.state != COMPLETE  → call sleep_thread
//   CPU B:  IRQ fires, state=COMPLETE, wakeup_thread(A)
//              (A is still RUNNING; wakeup is a no-op)
//   CPU A:  sleep_thread → state=SLEEPING, never woken
//
// Fix: hold sched_lock across the predicate check + SLEEPING
// transition. wakeup_thread acquires the same lock, so if the
// completer fires while we're in the check it blocks until we
// either see COMPLETE (and bail out of the loop) or transition
// to SLEEPING — in which case wakeup now observes SLEEPING and
// re-queues us correctly. sched.sleep_locked_and_yield drops the
// lock atomically with the hand-off to schedule().
fn wait_complete(r as *BlockRequest) as void {
    let is i64 as flags with mut = sched.take_lock();
    while (r.state != REQ_COMPLETE) {
        sched.sleep_locked_and_yield(flags);
        flags = sched.take_lock();
    }
    sched.drop_lock(flags);
}

// Blocking read. Creates a request, submits, and sleeps the caller
// until the driver completes it. Returns the status from the driver
// (0 = OK). buf must have room for count * sector_size bytes; sector
// size is driver-specific and opaque here.
fn read_sync(dev as *driver.Hardware, port as i64, lba as i64,
             count as i64, buf as *u8) as i32 {
    let is *BlockIOProvider as p = find_provider(dev);
    if (cast(i64, p) == 0) { return driver.DEVICE_NOT_PRESENT; }

    let is *BlockRequest as r = new_request(OP_READ, port, lba, count, buf);
    if (cast(i64, r) == 0) { return driver.OUT_OF_MEMORY; }
    r.waiter_tid = sched.current_tid();

    let is i32 as rc = submit(p, r);
    if (rc != 0) { free_request(r); return rc; }

    wait_complete(r);
    let is i32 as status = cast(i32, r.status);
    free_request(r);
    return status;
}

fn write_sync(dev as *driver.Hardware, port as i64, lba as i64,
              count as i64, buf as *u8) as i32 {
    let is *BlockIOProvider as p = find_provider(dev);
    if (cast(i64, p) == 0) { return driver.DEVICE_NOT_PRESENT; }

    let is *BlockRequest as r = new_request(OP_WRITE, port, lba, count, buf);
    if (cast(i64, r) == 0) { return driver.OUT_OF_MEMORY; }
    r.waiter_tid = sched.current_tid();

    let is i32 as rc = submit(p, r);
    if (rc != 0) { free_request(r); return rc; }

    wait_complete(r);
    let is i32 as status = cast(i32, r.status);
    free_request(r);
    return status;
}

fn flush_sync(dev as *driver.Hardware, port as i64) as i32 {
    let is *BlockIOProvider as p = find_provider(dev);
    if (cast(i64, p) == 0) { return driver.DEVICE_NOT_PRESENT; }

    let is *BlockRequest as r = new_request(OP_FLUSH, port, 0, 0, cast(*u8, 0));
    if (cast(i64, r) == 0) { return driver.OUT_OF_MEMORY; }
    r.waiter_tid = sched.current_tid();

    let is i32 as rc = submit(p, r);
    if (rc != 0) { free_request(r); return rc; }

    wait_complete(r);
    let is i32 as status = cast(i32, r.status);
    free_request(r);
    return status;
}
