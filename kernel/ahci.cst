// ahci.cst — AHCI SATA controller driver.
//
// Phase E1 (this commit): HBA detection, port 0 init, IDENTIFY DEVICE
// via polling, model string print. No I/O framework integration yet;
// io.BlockIOProvider wiring and submit_io/harvest_io arrive in E2.
//
// Matches PCI class 0x01 / subclass 0x06 (SATA). BAR5 is ABAR (HBA
// memory registers). IRQ line comes from PCI config 0x3C via the bus
// vtable (irq: auto in the .cdvrspec).

use "driver.cst" as driver;
use "spec.cst" as spec;
use "ksym.cst" as ksym;
use "serial.cst" as serial;
use "util.cst" as util;
use "heap.cst" as heap;
use "timer.cst" as timer;
use "io.cst" as io;
use "pmm.cst" as pmm;
use "pci.cst" as pci;
use "storage.cst" as storage;

// HBA register offsets (ABAR + N)
let is i64 as HBA_CAP  = 0x00;
let is i64 as HBA_GHC  = 0x04;
let is i64 as HBA_IS   = 0x08;
let is i64 as HBA_PI   = 0x0C;
let is i64 as HBA_VS   = 0x10;
let is i64 as HBA_PORTS = 0x100;

// CAP bits
let is i64 as CAP_S64A = 0x80000000;   // 64-bit addressing supported
let is i64 as CAP_SSS  = 0x08000000;   // staggered spin-up supported

// GHC bits
let is i64 as GHC_HR = 1;            // HBA reset
let is i64 as GHC_IE = 2;            // interrupt enable
let is i64 as GHC_AE = 0x80000000;   // AHCI enable

// Timeouts (ns). tick_count increments at 1ms; the clock resolution
// is 1ms, so a 1ms deadline can fire as soon as the next tick lands
// — budgets below are conservative.
let is i64 as TIMEOUT_HBA_RESET_NS = 1000000000;      //  1 s
let is i64 as TIMEOUT_LINK_NS      = 1000000000;      //  1 s
let is i64 as TIMEOUT_PORT_IDLE_NS =  500000000;      // 500 ms
let is i64 as TIMEOUT_COMMAND_NS   = 30000000000;     // 30 s (ATA IDENTIFY can be slow)

// Port register offsets (relative to port base = ABAR + 0x100 + port*0x80)
let is i64 as PX_CLB  = 0x00;
let is i64 as PX_CLBU = 0x04;
let is i64 as PX_FB   = 0x08;
let is i64 as PX_FBU  = 0x0C;
let is i64 as PX_IS   = 0x10;
let is i64 as PX_IE   = 0x14;
let is i64 as PX_CMD  = 0x18;
let is i64 as PX_TFD  = 0x20;
let is i64 as PX_SIG  = 0x24;
let is i64 as PX_SSTS = 0x28;
let is i64 as PX_SCTL = 0x2C;
let is i64 as PX_SERR = 0x30;
let is i64 as PX_CI   = 0x38;

// Port CMD bits
let is i64 as CMD_ST  = 1;
let is i64 as CMD_FRE = 0x10;
let is i64 as CMD_FR  = 0x4000;
let is i64 as CMD_CR  = 0x8000;

// Port TFD bits
let is i64 as TFD_ERR = 1;
let is i64 as TFD_DRQ = 8;
let is i64 as TFD_BSY = 0x80;

// SATA commands
let is i64 as ATA_CMD_IDENTIFY        = 0xEC;
let is i64 as ATA_CMD_READ_DMA_EX     = 0x25;    // READ DMA EXT, 48-bit LBA
let is i64 as ATA_CMD_WRITE_DMA_EX    = 0x35;    // WRITE DMA EXT, 48-bit LBA
let is i64 as ATA_CMD_FLUSH_CACHE_EX  = 0xEA;    // FLUSH CACHE EXT (48-bit)

// Per-sector size. AHCI doesn't know this; we infer from IDENTIFY
// word 106 when available, default to 512.
let is i64 as DEFAULT_SECTOR_SIZE = 512;

// Max command slots the HBA can have (AHCI spec: up to 32).
let is i64 as MAX_SLOTS = 32;

// Port IE bits we enable. Ready-to-receive + DMA setup + SDB + task
// file error + host bus fatal/data/cold presence.
let is i64 as PX_IE_BITS = 0xFDC000FF;

// Per-HBA state. One singleton today (V1 supports a single AHCI
// controller). Extending to multiple HBAs means moving this into
// Binding.private and allocating per-bind via heap.
struct AhciCtx {
    abar as *u8;                        // ABAR virtual (from b.caps.mmio)
    port as i64;                        // first active port (0 today)
    ncs as i64;                         // command slots available (CAP.NCS + 1)
    sector_size as i64;                 // from IDENTIFY word 106 or default
    sector_count as i64;                // from IDENTIFY words 100-103 (LBA48)
    cmd_list as *driver.DmaBuffer;      // 1KB command list (32 × 32B headers)
    fis_base as *driver.DmaBuffer;      // 256-byte received FIS area
    cmd_tables as *driver.DmaBuffer;    // 32 × 1024B command tables (per slot)
    id_buf as *driver.DmaBuffer;        // 512B IDENTIFY result
    // Per-slot BlockRequest pointers stored as i64. Caustic struct
    // arrays of pointers trip the mixed-width layout convention; i64
    // is the canonical carrier. slot_requests_raw is indexed directly.
    slot_requests_raw as [32]i64;
    provider as io.BlockIOProvider;     // embedded; registered with io
    binding as *spec.Binding;           // kept so on_irq can find the provider
    storage_dev as storage.StorageDevice; // embedded; registered with storage
}

let is AhciCtx as ctx;
// V1 supports a single HBA. Subsequent bind attempts (e.g. a second
// AHCI controller present on the board) are refused so they don't
// stomp the shared ctx and wedge the first HBA's IRQ wiring.
let is i32 as ctx_bound with mut = 0;

// ksym publishing for spec framework
let is ksym.KSym as ksym_bind;
let is ksym.KSym as ksym_irq;

// ============================================================
// MMIO helpers
// ============================================================

fn mmio_read32(base as *u8, off as i64) as i64 {
    let is *u32 as p = cast(*u32, cast(i64, base) + off);
    return cast(i64, *p) & 0xFFFFFFFF;
}

fn mmio_write32(base as *u8, off as i64, val as i64) as void {
    let is *u32 as p = cast(*u32, cast(i64, base) + off);
    *p = cast(u32, val & 0xFFFFFFFF);
}

fn port_base(abar as *u8, port as i64) as *u8 {
    return cast(*u8, cast(i64, abar) + HBA_PORTS + port * 0x80);
}

// ============================================================
// Real-time timeouts via timer.current_time_ns. Prefer these over
// spin-count loops — a 10M iteration spin completes in microseconds
// on a fast CPU but a real HBA may take hundreds of ms for link
// negotiation or drive spin-up.
// ============================================================

fn deadline_ns(budget as i64) as i64 {
    return timer.current_time_ns() + budget;
}

fn deadline_expired(deadline as i64) as i32 {
    if (timer.current_time_ns() >= deadline) { return 1; }
    return 0;
}

// ============================================================
// HBA reset — scrub any state left by firmware. GHC.HR self-clears
// when the HBA is ready again; spec allows up to 1s.
// ============================================================

fn hba_reset(abar as *u8) as i32 {
    let is i64 as ghc = mmio_read32(abar, HBA_GHC);
    mmio_write32(abar, HBA_GHC, ghc | GHC_AE | GHC_HR);
    let is i64 as dl = deadline_ns(TIMEOUT_HBA_RESET_NS);
    while (deadline_expired(dl) == 0) {
        if ((mmio_read32(abar, HBA_GHC) & GHC_HR) == 0) { return 0; }
    }
    return cast(i32, 0 - 1);
}

// ============================================================
// Port init / IDENTIFY
// ============================================================

// Stop the port: clear CMD.ST, wait CR=0; clear CMD.FRE, wait FR=0.
// Returns 0 on success, -1 on timeout. Safe to call on an already
// stopped port — bits already clear, loop exits immediately.
fn port_stop(pb as *u8) as i32 {
    let is i64 as cmd with mut = mmio_read32(pb, PX_CMD);
    mmio_write32(pb, PX_CMD, cmd & (0 - 1 - CMD_ST));
    let is i64 as dl1 with mut = deadline_ns(TIMEOUT_PORT_IDLE_NS);
    while (deadline_expired(dl1) == 0) {
        if ((mmio_read32(pb, PX_CMD) & CMD_CR) == 0) { dl1 = 0 - 1; }
    }
    if ((mmio_read32(pb, PX_CMD) & CMD_CR) != 0) { return cast(i32, 0 - 1); }
    cmd = mmio_read32(pb, PX_CMD);
    mmio_write32(pb, PX_CMD, cmd & (0 - 1 - CMD_FRE));
    let is i64 as dl2 with mut = deadline_ns(TIMEOUT_PORT_IDLE_NS);
    while (deadline_expired(dl2) == 0) {
        if ((mmio_read32(pb, PX_CMD) & CMD_FR) == 0) { dl2 = 0 - 1; }
    }
    if ((mmio_read32(pb, PX_CMD) & CMD_FR) != 0) { return cast(i32, 0 - 1); }
    return 0;
}

fn port_start(pb as *u8) as i32 {
    // Must have CR=0 (port not running) before setting FRE/ST.
    let is i64 as dl with mut = deadline_ns(TIMEOUT_PORT_IDLE_NS);
    while (deadline_expired(dl) == 0) {
        if ((mmio_read32(pb, PX_CMD) & CMD_CR) == 0) { dl = 0 - 1; }
    }
    if ((mmio_read32(pb, PX_CMD) & CMD_CR) != 0) { return cast(i32, 0 - 1); }
    let is i64 as cmd = mmio_read32(pb, PX_CMD);
    mmio_write32(pb, PX_CMD, cmd | CMD_FRE | CMD_ST);
    return 0;
}

// Wait for SSTS.DET == 3 (device present and phy communication
// established). Returns 0 if link came up within TIMEOUT_LINK_NS,
// -1 on timeout, -2 if port isn't implemented in PI.
fn port_wait_link(abar as *u8, port as i64) as i32 {
    let is i64 as pi = mmio_read32(abar, HBA_PI);
    if ((pi & (cast(i64, 1) << port)) == 0) { return cast(i32, 0 - 2); }
    let is *u8 as pb = port_base(abar, port);
    let is i64 as dl = deadline_ns(TIMEOUT_LINK_NS);
    while (deadline_expired(dl) == 0) {
        if ((mmio_read32(pb, PX_SSTS) & 0xF) == 3) { return 0; }
    }
    return cast(i32, 0 - 1);
}

// Build IDENTIFY command table in slot 0's command-table area.
// FIS type 0x27 (H2D register), command byte 0xEC, device 0xA0,
// single-PRDT pointing at id_buf.
fn build_identify_ct(c as *AhciCtx) as void {
    let is *u8 as ct = slot_ct_virt(c, 0);
    let is i64 as zi with mut = 0;
    while (zi < 144) { ct[zi] = cast(u8, 0); zi = zi + 1; }
    ct[0] = cast(u8, 0x27);         // FIS_TYPE_REG_H2D
    ct[1] = cast(u8, 0x80);         // C=1 (command)
    ct[2] = cast(u8, ATA_CMD_IDENTIFY);
    ct[7] = cast(u8, 0xA0);
    let is *u32 as dba = cast(*u32, cast(i64, ct) + 0x80);
    *dba = cast(u32, c.id_buf.phys & 0xFFFFFFFF);
    let is *u32 as dbau = cast(*u32, cast(i64, ct) + 0x84);
    *dbau = cast(u32, (c.id_buf.phys >> 32) & 0xFFFFFFFF);
    let is *u32 as dbc = cast(*u32, cast(i64, ct) + 0x8C);
    *dbc = cast(u32, (512 - 1) | 0x80000000);
}

// Wait until BSY + DRQ clear. Polling; AHCI irq not yet wired here.
fn wait_ready(pb as *u8) as i32 {
    let is i64 as dl = deadline_ns(TIMEOUT_PORT_IDLE_NS);
    while (deadline_expired(dl) == 0) {
        let is i64 as tfd = mmio_read32(pb, PX_TFD);
        if ((tfd & (TFD_BSY | TFD_DRQ)) == 0) { return 0; }
    }
    return cast(i32, 0 - 1);
}

fn wait_ci_clear(pb as *u8, slot as i64) as i32 {
    let is i64 as mask = cast(i64, 1) << slot;
    let is i64 as dl = deadline_ns(TIMEOUT_COMMAND_NS);
    while (deadline_expired(dl) == 0) {
        let is i64 as ci = mmio_read32(pb, PX_CI);
        if ((ci & mask) == 0) { return 0; }
        let is i64 as tfd = mmio_read32(pb, PX_TFD);
        if ((tfd & TFD_ERR) != 0) { return cast(i32, 0 - 2); }
    }
    return cast(i32, 0 - 1);
}

// Allocate any free command slot by scanning (SACT | CI). AHCI spec
// requires finding the first slot where both are clear. CAP.NCS tells
// us how many slots the HBA supports (N+1 in bits 8-12).
fn alloc_slot(abar as *u8, pb as *u8) as i64 {
    let is i64 as cap = mmio_read32(abar, HBA_CAP);
    let is i64 as ncs = ((cap >> 8) & 0x1F) + 1;
    let is i64 as used = mmio_read32(pb, PX_CI) | mmio_read32(pb, 0x34);  // 0x34 = SACT
    let is i64 as s with mut = 0;
    while (s < ncs) {
        if ((used & (cast(i64, 1) << s)) == 0) { return s; }
        s = s + 1;
    }
    return cast(i64, 0 - 1);
}

// IDENTIFY stores model name at words 27..46 (bytes 54..93). Each 16-bit
// word is big-endian in character order but little-endian in memory, so
// bytes are swapped per-pair: print id[55],id[54],id[57],id[56],...
fn print_identify_model(id as *u8) as void {
    serial.print("ahci: model=", 12);
    let is i64 as i with mut = 0;
    while (i < 40) {
        serial.putc(cast(i64, id[54 + i + 1]));
        serial.putc(cast(i64, id[54 + i]));
        i = i + 2;
    }
    serial.println("", 0);
}

// ============================================================
// Lifecycle
// ============================================================

fn ahci_bind(b as *spec.Binding) as i32 {
    if (ctx_bound != 0) {
        serial.println("ahci: skipping 2nd HBA (single-HBA build)", 41);
        return cast(i32, 0 - 99);
    }
    let is *u8 as abar = b.caps.mmio;
    if (cast(i64, abar) == 0) {
        serial.println("ahci: no mmio", 13);
        return cast(i32, 0 - 1);
    }
    ctx.abar = abar;

    // Memory Space Enable + Bus Master Enable in the PCI Command
    // register. Firmware usually sets these but cheap OEM BIOSes and
    // hotplug rebinds can leave BME clear — DMA then fails silently.
    pci.pci_enable_bus_master(b.hardware);

    serial.print("ahci: abar=", 11);
    util.print_hex(cast(i64, abar));
    serial.println("", 0);

    // Take ownership of AE before reset so the HBA processes the HR
    // bit in AHCI-aware mode (spec §10.4.3).
    let is i64 as ghc0 = mmio_read32(abar, HBA_GHC);
    mmio_write32(abar, HBA_GHC, ghc0 | GHC_AE);
    if (hba_reset(abar) != 0) {
        serial.println("ahci: HBA reset timeout", 23);
        return cast(i32, 0 - 2);
    }
    // GHC.HR self-cleared but AE may have reset too; re-assert.
    mmio_write32(abar, HBA_GHC, mmio_read32(abar, HBA_GHC) | GHC_AE);
    // Clear any HBA-level pending interrupt status.
    mmio_write32(abar, HBA_IS, cast(i64, 0 - 1));

    let is i64 as cap = mmio_read32(abar, HBA_CAP);
    let is i64 as pi  = mmio_read32(abar, HBA_PI);
    serial.print("ahci: cap=", 10);
    util.print_hex(cap);
    serial.print(" pi=", 4);
    util.print_hex(pi);
    serial.println("", 0);

    // S64A capability: if the HBA doesn't support 64-bit addressing
    // we must keep all DMA structures below 4GB. Our dma_alloc already
    // passes the DMA32 flag unconditionally, but log for visibility
    // and future conditional behaviour.
    if ((cap & CAP_S64A) == 0) {
        serial.println("ahci: 32-bit-only HBA (S64A=0)", 30);
    }

    // Find first port with an implemented slot that has a live link.
    // port_wait_link gives the phy up to TIMEOUT_LINK_NS to come up.
    let is i64 as port with mut = cast(i64, 0 - 1);
    let is i64 as pp with mut = 0;
    while (pp < 32) {
        if ((pi & (cast(i64, 1) << pp)) != 0) {
            if (port_wait_link(abar, pp) == 0) {
                port = pp;
                pp = 32;
            } else {
                pp = pp + 1;
            }
        } else {
            pp = pp + 1;
        }
    }
    if (port < 0) {
        serial.println("ahci: no device linked on any port", 34);
        return 0;
    }
    ctx.port = port;
    serial.print("ahci: device on port ", 21);
    util.print_num(port);
    serial.println("", 0);

    let is *u8 as pb = port_base(abar, port);
    if (port_stop(pb) != 0) {
        serial.println("ahci: port_stop timeout", 23);
        return cast(i32, 0 - 3);
    }

    // Clear PxSERR (W1C) and PxIS so we start fresh.
    mmio_write32(pb, PX_SERR, cast(i64, 0 - 1));
    mmio_write32(pb, PX_IS, cast(i64, 0 - 1));

    // NCS from CAP bits 8-12; cap at MAX_SLOTS.
    ctx.ncs = ((cap >> 8) & 0x1F) + 1;
    if (ctx.ncs > MAX_SLOTS) { ctx.ncs = MAX_SLOTS; }
    ctx.sector_size = DEFAULT_SECTOR_SIZE;
    ctx.binding = b;

    // Zero the slot->request table so harvest never sees stale entries.
    let is i64 as si with mut = 0;
    while (si < MAX_SLOTS) { ctx.slot_requests_raw[si] = 0; si = si + 1; }

    // Command list (1KB, 1KB-aligned per spec), FIS area (256B, 256-aligned),
    // IDENTIFY buffer (512B), and one command table per slot (1KB each,
    // 128-aligned per spec; we allocate ncs * 1024 contiguously). All in
    // ZONE_DMA32 so HBAs without CAP.S64A can address them directly.
    let is i32 as rc1 = driver.dma_alloc(b.hardware, cast(u64, 1024), cast(u64, 1024),
                                          cast(u32, 1), &ctx.cmd_list);
    if (rc1 != driver.OK) { serial.println("ahci: cmd_list alloc fail", 25); return rc1; }
    let is i32 as rc2 = driver.dma_alloc(b.hardware, cast(u64, 256), cast(u64, 256),
                                          cast(u32, 1), &ctx.fis_base);
    if (rc2 != driver.OK) { serial.println("ahci: fis alloc fail", 20); return rc2; }
    let is u64 as ct_total = cast(u64, ctx.ncs) * cast(u64, 1024);
    let is i32 as rc3 = driver.dma_alloc(b.hardware, ct_total, cast(u64, 128),
                                          cast(u32, 1), &ctx.cmd_tables);
    if (rc3 != driver.OK) { serial.println("ahci: ct alloc fail", 19); return rc3; }
    let is i32 as rc4 = driver.dma_alloc(b.hardware, cast(u64, 512), cast(u64, 2),
                                          cast(u32, 1), &ctx.id_buf);
    if (rc4 != driver.OK) { serial.println("ahci: id alloc fail", 19); return rc4; }

    // Zero command list (32 × 32 bytes) and FIS area
    let is i64 as zi with mut = 0;
    let is *u8 as cl = cast(*u8, ctx.cmd_list.virt);
    while (zi < 1024) { cl[zi] = cast(u8, 0); zi = zi + 1; }
    zi = 0;
    let is *u8 as fa = cast(*u8, ctx.fis_base.virt);
    while (zi < 256) { fa[zi] = cast(u8, 0); zi = zi + 1; }

    // Program CLB / FB. On S64A=0 HBAs the upper-32 registers still
    // exist but must be zero — our DMA32 allocation keeps that true.
    mmio_write32(pb, PX_CLB,  ctx.cmd_list.phys & 0xFFFFFFFF);
    mmio_write32(pb, PX_CLBU, (ctx.cmd_list.phys >> 32) & 0xFFFFFFFF);
    mmio_write32(pb, PX_FB,   ctx.fis_base.phys & 0xFFFFFFFF);
    mmio_write32(pb, PX_FBU,  (ctx.fis_base.phys >> 32) & 0xFFFFFFFF);

    if (port_start(pb) != 0) {
        serial.println("ahci: port_start failed (CR stayed set)", 39);
        return cast(i32, 0 - 4);
    }

    // IDENTIFY: must catch the port idle after start (firmware FIS
    // traffic can keep BSY set briefly).
    if (wait_ready(pb) != 0) {
        let is i64 as tfd = mmio_read32(pb, PX_TFD);
        serial.print("ahci: port busy pre-identify tfd=", 33);
        util.print_hex(tfd);
        serial.println("", 0);
        return cast(i32, 0 - 5);
    }

    let is i64 as slot = alloc_slot(abar, pb);
    if (slot < 0) {
        serial.println("ahci: no free command slot", 26);
        return cast(i32, 0 - 6);
    }

    build_identify_ct(&ctx);
    fill_slot_header(&ctx, 0, 0, 1);    // slot 0, read, 1 PRDT entry

    mmio_write32(pb, PX_CI, cast(i64, 1) << slot);

    let is i32 as wrc = wait_ci_clear(pb, slot);
    if (wrc != 0) {
        let is i64 as tfd = mmio_read32(pb, PX_TFD);
        let is i64 as serr = mmio_read32(pb, PX_SERR);
        serial.print("ahci: identify failed rc=", 25);
        util.print_num(cast(i64, wrc));
        serial.print(" tfd=", 5);
        util.print_hex(tfd);
        serial.print(" serr=", 6);
        util.print_hex(serr);
        serial.println("", 0);
        return wrc;
    }

    print_identify_model(cast(*u8, ctx.id_buf.virt));

    // Infer sector size from IDENTIFY word 106: if bit 14 set and
    // bit 12 set, words 117-118 carry logical sector size in 16-bit
    // word units. Otherwise 512. Most QEMU and commodity drives
    // report 512.
    let is *u8 as id = cast(*u8, ctx.id_buf.virt);
    let is *u16 as id16 = cast(*u16, id);
    let is i64 as word106 = cast(i64, id16[106]) & 0xFFFF;
    if ((word106 & 0x4000) == 0x4000 && (word106 & 0x1000) != 0) {
        let is i64 as sw = cast(i64, id16[117]) | (cast(i64, id16[118]) << 16);
        if (sw > 0) { ctx.sector_size = sw * 2; }
    }

    // Total sectors: IDENTIFY words 100-103 = 48-bit LBA total count.
    // For drives without LBA48 support, fall back to word 60-61
    // (32-bit LBA28 count).
    let is i64 as lba48 = cast(i64, id16[100])
                        | (cast(i64, id16[101]) << 16)
                        | (cast(i64, id16[102]) << 32)
                        | (cast(i64, id16[103]) << 48);
    if (lba48 > 0) {
        ctx.sector_count = lba48;
    } else {
        ctx.sector_count = cast(i64, id16[60]) | (cast(i64, id16[61]) << 16);
    }

    serial.print("ahci: sector_size=", 18);
    util.print_num(ctx.sector_size);
    serial.print(" sectors=", 9);
    util.print_num(ctx.sector_count);
    serial.println("", 0);

    // Register the block I/O provider and enable per-port + HBA interrupts.
    ctx.provider.device      = b.hardware;
    ctx.provider.submit_io   = fn_ptr(ahci_submit);
    ctx.provider.harvest_io  = fn_ptr(ahci_harvest);
    ctx.provider.private     = cast(*u8, &ctx);
    ctx.provider.pending_head = cast(*io.BlockRequest, 0);
    ctx.provider.pending_count = 0;
    ctx.provider.next         = cast(*io.BlockIOProvider, 0);
    let is i32 as prc = io.register(&ctx.provider);
    if (prc != driver.OK) {
        serial.println("ahci: io.register failed", 24);
        return prc;
    }

    mmio_write32(pb, PX_IE, PX_IE_BITS);
    let is i64 as ghc_final = mmio_read32(abar, HBA_GHC);
    mmio_write32(abar, HBA_GHC, ghc_final | GHC_IE);

    // Publish this port as an abstract StorageDevice for filesystems.
    let is i32 as src = register_storage_device(&ctx);
    if (src != 0) {
        serial.print("ahci: storage.register failed rc=", 33);
        util.print_num(cast(i64, src));
        serial.println("", 0);
        return cast(i32, 0 - 7);
    }

    // End-to-end self-test: write pattern / flush / read / verify.
    // Exercises all three op kinds (OP_WRITE/OP_FLUSH/OP_READ), the
    // PRDT/no-PRDT command table variants, and the race-free
    // wait_complete path.
    self_test_io(&ctx);
    ctx_bound = 1;
    return driver.OK;
}

// ============================================================
// READ / WRITE DMA EXT — build FIS H2D + single-PRDT command table
// ============================================================

fn slot_ct_virt(c as *AhciCtx, slot as i64) as *u8 {
    return cast(*u8, cast(i64, c.cmd_tables.virt) + slot * 1024);
}

fn slot_ct_phys(c as *AhciCtx, slot as i64) as i64 {
    return c.cmd_tables.phys + slot * 1024;
}

// Build H2D FIS for READ/WRITE DMA EXT (48-bit LBA, up to 65536
// sectors per command). Overwrites the first 128 bytes of the
// command table (FIS + ATAPI area + reserved).
fn build_rw_fis(ct as *u8, is_write as i64, lba as i64, count as i64) as void {
    let is i64 as zi with mut = 0;
    while (zi < 128) { ct[zi] = cast(u8, 0); zi = zi + 1; }
    ct[0] = cast(u8, 0x27);                      // FIS_TYPE_REG_H2D
    ct[1] = cast(u8, 0x80);                      // C=1 (command)
    if (is_write == 1) {
        ct[2] = cast(u8, ATA_CMD_WRITE_DMA_EX);
    } else {
        ct[2] = cast(u8, ATA_CMD_READ_DMA_EX);
    }
    ct[3] = cast(u8, 0);                         // features (low)
    ct[4] = cast(u8, lba & 0xFF);
    ct[5] = cast(u8, (lba >> 8)  & 0xFF);
    ct[6] = cast(u8, (lba >> 16) & 0xFF);
    ct[7] = cast(u8, 0x40);                      // device = LBA mode
    ct[8] = cast(u8, (lba >> 24) & 0xFF);
    ct[9] = cast(u8, (lba >> 32) & 0xFF);
    ct[10] = cast(u8, (lba >> 40) & 0xFF);
    ct[11] = cast(u8, 0);                        // features (high)
    ct[12] = cast(u8, count & 0xFF);
    ct[13] = cast(u8, (count >> 8) & 0xFF);
    ct[14] = cast(u8, 0);                        // ICC
    ct[15] = cast(u8, 0);                        // control
}

// Build H2D FIS for FLUSH CACHE EXT. No LBA, no count, no PRDT —
// durability barrier that tells the drive to evict its write cache
// to persistent media. ATA/ATAPI-8 §7.8.
fn build_flush_fis(ct as *u8) as void {
    let is i64 as zi with mut = 0;
    while (zi < 128) { ct[zi] = cast(u8, 0); zi = zi + 1; }
    ct[0] = cast(u8, 0x27);                      // FIS_TYPE_REG_H2D
    ct[1] = cast(u8, 0x80);                      // C=1
    ct[2] = cast(u8, ATA_CMD_FLUSH_CACHE_EX);
    ct[7] = cast(u8, 0x40);                      // device
}

// Single-PRDT entry at offset 0x80. AHCI spec §4.2.3: DBC is
// (byte_count - 1) in bits 0-21, bit 31 is interrupt-on-complete.
// byte_count must be even.
fn build_prdt_one(ct as *u8, phys as i64, byte_count as i64) as void {
    let is *u32 as dba = cast(*u32, cast(i64, ct) + 0x80);
    *dba = cast(u32, phys & 0xFFFFFFFF);
    let is *u32 as dbau = cast(*u32, cast(i64, ct) + 0x84);
    *dbau = cast(u32, (phys >> 32) & 0xFFFFFFFF);
    let is *u32 as rsvd = cast(*u32, cast(i64, ct) + 0x88);
    *rsvd = cast(u32, 0);
    let is *u32 as dbc = cast(*u32, cast(i64, ct) + 0x8C);
    *dbc = cast(u32, (byte_count - 1) | 0x80000000);
}

// Command header at list[slot]. CFL=5 dwords (H2D register FIS).
// PRDTL is the caller-supplied count — 1 for read/write, 0 for
// FLUSH (no data transfer). W bit set for writes.
fn fill_slot_header(c as *AhciCtx, slot as i64, is_write as i64, prdtl as i64) as void {
    let is *u8 as h = cast(*u8, cast(i64, c.cmd_list.virt) + slot * 32);
    let is i64 as flags with mut = 5;
    if (is_write == 1) { flags = flags | 0x40; }
    flags = flags | (prdtl << 16);
    let is *u32 as dw0 = cast(*u32, h);
    *dw0 = cast(u32, flags);
    let is *u32 as prdbc = cast(*u32, cast(i64, h) + 4);
    *prdbc = cast(u32, 0);
    let is i64 as ct_phys = slot_ct_phys(c, slot);
    let is *u32 as ctba = cast(*u32, cast(i64, h) + 8);
    *ctba = cast(u32, ct_phys & 0xFFFFFFFF);
    let is *u32 as ctbau = cast(*u32, cast(i64, h) + 12);
    *ctbau = cast(u32, (ct_phys >> 32) & 0xFFFFFFFF);
}

// ============================================================
// Slot request table (pointer ↔ slot mapping)
// ============================================================

fn slot_request_get(c as *AhciCtx, slot as i64) as *io.BlockRequest {
    return cast(*io.BlockRequest, c.slot_requests_raw[slot]);
}

fn slot_request_set(c as *AhciCtx, slot as i64, r as *io.BlockRequest) as void {
    c.slot_requests_raw[slot] = cast(i64, r);
}

// ============================================================
// io.BlockIOProvider — submit / harvest
// ============================================================

fn ahci_submit(p as *io.BlockIOProvider, r as *io.BlockRequest) as i32 {
    let is *AhciCtx as c = cast(*AhciCtx, p.private);
    let is *u8 as pb = port_base(c.abar, c.port);

    let is i64 as is_write with mut = 0;
    let is i64 as is_data with mut = 0;
    if (r.op == io.OP_READ)       { is_data = 1; }
    else if (r.op == io.OP_WRITE) { is_data = 1; is_write = 1; }
    else if (r.op == io.OP_FLUSH) { is_data = 0; }
    else                          { return cast(i32, driver.NOT_SUPPORTED); }

    let is i64 as buf_phys with mut = 0;
    let is i64 as byte_count with mut = 0;

    if (is_data == 1) {
        // Translate buf virtual → physical. Upper layer contract: buf
        // is HHDM-mapped kernel virtual (typical for dma_alloc'd or
        // direct pmm-backed buffers). kvalloc addresses don't satisfy
        // this and are rejected here; scatter-gather path for non-
        // contiguous allocations is a future extension.
        //
        // Both endpoints of the transfer must lie in installed RAM —
        // is_hhdm_valid checks the start, is_phys_valid validates
        // the tail. An out-of-range phys would make the HBA DMA to
        // stale or unmapped memory.
        let is i64 as buf_virt = cast(i64, r.buf);
        byte_count = r.count * c.sector_size;
        if (byte_count <= 0)             { return cast(i32, driver.INVALID_ARGUMENT); }
        if ((byte_count & 1) != 0)       { return cast(i32, driver.INVALID_ARGUMENT); }
        if (pmm.is_hhdm_valid(buf_virt) == 0) {
            serial.println("ahci: buf not in HHDM", 21);
            return cast(i32, driver.INVALID_ARGUMENT);
        }
        buf_phys = buf_virt - pmm.hhdm;
        if (pmm.is_phys_valid(buf_phys + byte_count - 1) == 0) {
            serial.println("ahci: buf tail beyond installed RAM", 35);
            return cast(i32, driver.INVALID_ARGUMENT);
        }
    }

    // Reserve a slot. Scans SACT|CI plus the driver's slot_requests
    // table so a free HW slot that's still mid-book-keeping can't be
    // double-assigned.
    sched.preempt_disable();
    let is i64 as slot with mut = cast(i64, 0 - 1);
    let is i64 as used_mask = mmio_read32(pb, PX_CI) | mmio_read32(pb, 0x34);
    let is i64 as s with mut = 0;
    while (s < c.ncs) {
        let is i64 as used_bit = (used_mask >> s) & 1;
        if (used_bit == 0) {
            if (slot_request_get(c, s) == cast(*io.BlockRequest, 0)) {
                slot = s;
                s = c.ncs;
            } else {
                s = s + 1;
            }
        } else {
            s = s + 1;
        }
    }
    if (slot < 0) {
        sched.preempt_enable();
        return cast(i32, driver.DEVICE_BUSY);
    }
    slot_request_set(c, slot, r);
    r.driver_slot = slot;
    sched.preempt_enable();

    // Build command table + header. FLUSH has no PRDT (PRDTL=0); R/W
    // always use a single PRDT entry (scatter-gather would bump this).
    let is *u8 as ct = slot_ct_virt(c, slot);
    let is i64 as prdtl with mut = 0;
    if (is_data == 1) {
        build_rw_fis(ct, is_write, r.lba, r.count);
        build_prdt_one(ct, buf_phys, byte_count);
        prdtl = 1;
    } else {
        build_flush_fis(ct);
    }
    fill_slot_header(c, slot, is_write, prdtl);

    // Kick: set the corresponding bit in PX_CI. Single-writer from
    // this context; safe without read-modify-write.
    mmio_write32(pb, PX_CI, cast(i64, 1) << slot);
    return 0;
}

// Per-port error recovery when TFES fires. AHCI §6.2.2.1: after a
// task-file error the port stops accepting commands; all outstanding
// slots are orphaned and must be drained. Spec-required recovery:
//   1. Clear PxCMD.ST and wait for CR=0 (port_stop handles this).
//   2. Write-1-clear PxSERR so the error bit doesn't re-trigger.
//   3. Re-enable CMD.FRE and CMD.ST (port_start).
// Remaining slots (CI bits that are still set) are reported with an
// error status to their waiters — they will never complete naturally
// because the HBA dropped them when the error occurred. port_stop /
// port_start are time-bound (500ms each) so total recovery latency is
// ≤ ~1s even if one side misbehaves. If the restart itself fails we
// log and leave the port stopped; future submits will get DEVICE_BUSY
// until a driver-level reset is wired in.
fn recover_tfes(c as *AhciCtx, pb as *u8) as void {
    serial.println("ahci: TFES — port recovery", 26);
    if (port_stop(pb) != 0) {
        serial.println("ahci: recovery port_stop timeout", 31);
    }
    mmio_write32(pb, PX_SERR, cast(i64, 0 - 1));
    mmio_write32(pb, PX_IS,   cast(i64, 0 - 1));
    if (port_start(pb) != 0) {
        serial.println("ahci: recovery port_start failed", 32);
    }
}

fn ahci_harvest(p as *io.BlockIOProvider, out as **io.BlockRequest) as i32 {
    let is *AhciCtx as c = cast(*AhciCtx, p.private);
    let is *u8 as pb = port_base(c.abar, c.port);
    let is i64 as ci = mmio_read32(pb, PX_CI);
    let is i64 as tfd = mmio_read32(pb, PX_TFD);
    let is i64 as pxis = mmio_read32(pb, PX_IS);
    // TFES is bit 30 of PxIS; falls back to TFD.ERR for HBAs that
    // don't assert PxIS.TFES on every error path.
    let is i64 as has_err with mut = 0;
    if ((tfd & TFD_ERR) != 0)          { has_err = 1; }
    if ((pxis & 0x40000000) != 0)      { has_err = 1; }

    let is i64 as slot with mut = 0;
    while (slot < c.ncs) {
        let is *io.BlockRequest as r = slot_request_get(c, slot);
        if (cast(i64, r) != 0) {
            let is i64 as bit = (ci >> slot) & 1;
            let is i32 as return_this with mut = 0;
            if (has_err == 1) {
                // Every outstanding slot on this port is orphaned —
                // the HBA won't finish them. Drain them all as failed.
                return_this = 1;
                r.status = cast(i32, 0 - 1);
            } else if (bit == 0) {
                return_this = 1;
                r.status = 0;
            }
            if (return_this == 1) {
                slot_request_set(c, slot, cast(*io.BlockRequest, 0));
                *out = r;
                // If this was the last error-triggered completion to
                // drain, do the port restart now so the next submit
                // finds a live port. We detect "last" by re-scanning
                // after clearing the slot; if nothing else pending,
                // recover. This keeps recovery latency paid once.
                if (has_err == 1) {
                    let is i64 as scan with mut = 0;
                    let is i32 as any_left with mut = 0;
                    while (scan < c.ncs) {
                        if (cast(i64, slot_request_get(c, scan)) != 0) {
                            any_left = 1;
                            scan = c.ncs;
                        } else {
                            scan = scan + 1;
                        }
                    }
                    if (any_left == 0) { recover_tfes(c, pb); }
                }
                return 1;
            }
        }
        slot = slot + 1;
    }
    *out = cast(*io.BlockRequest, 0);
    return 0;
}

// ============================================================
// IRQ entry — framework hands us *Hardware + Binding-as-ctx
// ============================================================

fn ahci_irq(hw as *driver.Hardware, context as *u8) as i32 {
    // Shared-IRQ guard: legacy PCI IRQs can be wired to multiple
    // devices. Confirm HBA.IS has our port's bit set before touching
    // anything — otherwise we'd be eating some other driver's
    // interrupt (and clearing its IS). AHCI §10.1.2 guarantees the
    // HBA sets the per-port bit whenever any port IRQ source fires.
    let is i64 as hba_is = mmio_read32(ctx.abar, HBA_IS);
    if ((hba_is & (cast(i64, 1) << ctx.port)) == 0) { return 0; }

    let is *spec.Binding as b = cast(*spec.Binding, context);
    let is *io.BlockIOProvider as p = io.find_provider(b.hardware);
    if (cast(i64, p) != 0) {
        io.harvest_all(p);
    }
    // Clear port IS then HBA IS in that order per AHCI spec §10.1.2.
    let is *u8 as pb = port_base(ctx.abar, ctx.port);
    mmio_write32(pb, PX_IS, cast(i64, 0 - 1));
    mmio_write32(ctx.abar, HBA_IS, cast(i64, 1) << ctx.port);
    return 0;
}

// ============================================================
// Post-IDENTIFY self-test: write known pattern, flush, read back,
// verify. Exercises submit/harvest/wait_complete for all three op
// kinds (OP_WRITE, OP_FLUSH, OP_READ) and the AHCI FIS builders.
//
// Uses LBA 100 so we don't stomp on anything a real disk image would
// keep at LBA 0 (MBR / GPT header). For the 1MB build/disk.img this
// is well inside bounds; callers pointing at a different image with
// less than ~52KB should tune the LBA.
// ============================================================

fn self_test_io(c as *AhciCtx) as void {
    let is i64 as TEST_LBA = 100;
    let is i64 as SECTOR   = c.sector_size;

    let is *driver.DmaBuffer as wbuf;
    let is *driver.DmaBuffer as rbuf;
    let is i32 as rc1 = driver.dma_alloc(c.binding.hardware, cast(u64, SECTOR),
                                          cast(u64, 2), cast(u32, 1), &wbuf);
    if (rc1 != driver.OK) {
        serial.println("ahci.self_test: dma_alloc wbuf fail", 35);
        return;
    }
    let is i32 as rc2 = driver.dma_alloc(c.binding.hardware, cast(u64, SECTOR),
                                          cast(u64, 2), cast(u32, 1), &rbuf);
    if (rc2 != driver.OK) {
        serial.println("ahci.self_test: dma_alloc rbuf fail", 35);
        driver.dma_free(c.binding.hardware, wbuf);
        return;
    }

    // Fill wbuf with a rotating pattern and rbuf with an inverted
    // sentinel so a failed read is trivially distinguishable.
    let is *u8 as wp = cast(*u8, wbuf.virt);
    let is *u8 as rp = cast(*u8, rbuf.virt);
    let is i64 as i with mut = 0;
    while (i < SECTOR) {
        wp[i] = cast(u8, (i * 31 + 7) & 0xFF);
        rp[i] = cast(u8, 0xA5);
        i = i + 1;
    }

    let is i32 as wrc = io.write_sync(c.binding.hardware, c.port, TEST_LBA, 1, wp);
    serial.print("ahci.self_test: write LBA 100 status=", 37);
    util.print_num(cast(i64, wrc));
    serial.println("", 0);
    if (wrc != 0) { driver.dma_free(c.binding.hardware, wbuf); driver.dma_free(c.binding.hardware, rbuf); return; }

    let is i32 as frc = io.flush_sync(c.binding.hardware, c.port);
    serial.print("ahci.self_test: flush status=", 29);
    util.print_num(cast(i64, frc));
    serial.println("", 0);
    if (frc != 0) { driver.dma_free(c.binding.hardware, wbuf); driver.dma_free(c.binding.hardware, rbuf); return; }

    let is i32 as rrc = io.read_sync(c.binding.hardware, c.port, TEST_LBA, 1, rp);
    serial.print("ahci.self_test: read LBA 100 status=", 36);
    util.print_num(cast(i64, rrc));
    serial.println("", 0);
    if (rrc != 0) { driver.dma_free(c.binding.hardware, wbuf); driver.dma_free(c.binding.hardware, rbuf); return; }

    // Verify byte-for-byte.
    let is i64 as mismatches with mut = 0;
    let is i64 as first_bad with mut = cast(i64, 0 - 1);
    i = 0;
    while (i < SECTOR) {
        if (wp[i] != rp[i]) {
            mismatches = mismatches + 1;
            if (first_bad < 0) { first_bad = i; }
        }
        i = i + 1;
    }
    if (mismatches == 0) {
        serial.println("ahci.self_test: write/read/verify OK", 36);
    } else {
        serial.print("ahci.self_test: verify FAIL mismatches=", 39);
        util.print_num(mismatches);
        serial.print(" first_bad=", 11);
        util.print_num(first_bad);
        serial.println("", 0);
    }

    driver.dma_free(c.binding.hardware, wbuf);
    driver.dma_free(c.binding.hardware, rbuf);
}

// ============================================================
// storage.StorageDevice adapters — thin wrappers around io.read_sync /
// write_sync / flush_sync that unpack the AhciCtx from the priv
// pointer and forward to the queue. These are what filesystems like
// FAT32 call through — they have no dependency on AHCI internals.
// ============================================================

fn stor_read(priv as *u8, lba as i64, count as i64, buf as *u8) as i32 {
    let is *AhciCtx as c = cast(*AhciCtx, priv);
    return io.read_sync(c.binding.hardware, c.port, lba, count, buf);
}

fn stor_write(priv as *u8, lba as i64, count as i64, buf as *u8) as i32 {
    let is *AhciCtx as c = cast(*AhciCtx, priv);
    return io.write_sync(c.binding.hardware, c.port, lba, count, buf);
}

fn stor_flush(priv as *u8) as i32 {
    let is *AhciCtx as c = cast(*AhciCtx, priv);
    return io.flush_sync(c.binding.hardware, c.port);
}

fn stor_sector_size(priv as *u8) as i64 {
    let is *AhciCtx as c = cast(*AhciCtx, priv);
    return c.sector_size;
}

fn stor_sector_count(priv as *u8) as i64 {
    let is *AhciCtx as c = cast(*AhciCtx, priv);
    return c.sector_count;
}

// Populate AhciCtx.storage_dev and register it with the storage
// registry. Called after IDENTIFY has set sector_size + sector_count
// and after the BlockIOProvider is registered.
fn register_storage_device(c as *AhciCtx) as i32 {
    // Name: "ahci-pN" where N is the port index (0-31, so 1 or 2 digits)
    c.storage_dev.name[0] = cast(u8, 97);   // 'a'
    c.storage_dev.name[1] = cast(u8, 104);  // 'h'
    c.storage_dev.name[2] = cast(u8, 99);   // 'c'
    c.storage_dev.name[3] = cast(u8, 105);  // 'i'
    c.storage_dev.name[4] = cast(u8, 45);   // '-'
    c.storage_dev.name[5] = cast(u8, 112);  // 'p'
    let is i64 as pos with mut = 6;
    if (c.port >= 10) {
        c.storage_dev.name[pos] = cast(u8, 48 + (c.port / 10));
        pos = pos + 1;
    }
    c.storage_dev.name[pos] = cast(u8, 48 + (c.port % 10));
    pos = pos + 1;
    c.storage_dev.name[pos] = cast(u8, 0);

    c.storage_dev.read_lba     = fn_ptr(stor_read);
    c.storage_dev.write_lba    = fn_ptr(stor_write);
    c.storage_dev.flush        = fn_ptr(stor_flush);
    c.storage_dev.sector_size  = fn_ptr(stor_sector_size);
    c.storage_dev.sector_count = fn_ptr(stor_sector_count);
    c.storage_dev.priv         = cast(*u8, c);
    c.storage_dev.next         = cast(*storage.StorageDevice, 0);

    return storage.register(&c.storage_dev);
}

fn register() as void {
    ksym_bind.name_ptr = cast(*u8, "ahci.ahci_bind");
    ksym_bind.name_len = 14;
    ksym_bind.addr     = cast(i64, fn_ptr(ahci_bind));
    ksym_bind.kind     = ksym.KIND_FUNC;
    ksym.register(&ksym_bind);

    ksym_irq.name_ptr = cast(*u8, "ahci.ahci_irq");
    ksym_irq.name_len = 13;
    ksym_irq.addr     = cast(i64, fn_ptr(ahci_irq));
    ksym_irq.kind     = ksym.KIND_FUNC;
    ksym.register(&ksym_irq);

    serial.println("ahci: registered", 16);
}
