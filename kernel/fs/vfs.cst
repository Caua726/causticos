// vfs.cst — Virtual File System layer.
//
// Sits between callers ("give me /docs/readme.md") and filesystem
// drivers (FAT32 today, tmpfs/nvme later). The VFS owns:
//   - Mount table: paths like "/" or "/boot" → FileSystemOps vtable + priv
//   - Open-file pool: stateful handles carrying offset, flags, refcount
//   - Path resolution: split mount prefix, forward the rest to the FS
//
// Design choices tuned to causticos philosophy:
//   - No heap: static arrays for mount table (8 slots) + file pool (64
//     slots). Fits every realistic single-user kernel, heap can come
//     later if we grow past it.
//   - Filesystems expose a narrow vtable. Every write/metadata op is
//     path-based at the interface so the VFS doesn't need to translate
//     FS-specific inode layouts.
//   - Open() caches (parent_cluster, first_cluster, size) on the
//     handle so subsequent read/write/seek skip re-traversal of the
//     directory tree. Persist-back on write_at happens through
//     update_entry in the same request.
//   - Sync writes: every mutation flushes the device. No write-back
//     cache yet — when we add one it'll live under the FS, invisible
//     to the VFS.

use "serial.cst" as serial;
use "util.cst"   as util;
use "sched.cst"  as sched;
use "timer.cst"  as timer;
use "abi.cst"    as abi;
use "kobject.cst" as kobject;
use "lock.cst"    as lock;
use "vfswatch.cst" as vfswatch;
use "mutex.cst"   as mutex;
use "heap.cst"    as heap;

// Serialises filesystem operations. The backing FS (fat32) keeps shared
// scratch buffers with no internal lock, so two processes doing file I/O on
// different cpus would race on them; this coarse lock (one mount today) makes
// every public VFS op mutually exclusive. The op bodies are X_inner; the public
// X wraps acquire/inner/release so multiple internal returns can't leak the
// lock. The fat32 self-test bypasses VFS but runs exclusively before vfs.mount,
// so it needs no lock. lseek is purely local (VfsFile offset) and stays unlocked.
//
// A MUTEX, not a spinlock: it is held across disk I/O, and a holder waiting on
// the disk sleeps. As a ticket spinlock every other file operation on the
// machine spun a cpu while it waited, and on the holder's own cpu a spinner
// that outranked it kept it from running at all — the disk-root freeze.
let is mutex.Mutex as fs_lock with mut;

// ============================================================
// Error codes. Negative to play nice with syscalls that return -errno.
// ============================================================

let is i32 as VFS_OK        = cast(i32, 0);
let is i32 as VFS_ENOENT    = cast(i32, 0 - 2);
let is i32 as VFS_EIO       = cast(i32, 0 - 5);
let is i32 as VFS_ENOMEM    = cast(i32, 0 - 12);
let is i32 as VFS_EBADF     = cast(i32, 0 - 9);
let is i32 as VFS_ENOTDIR   = cast(i32, 0 - 20);
let is i32 as VFS_EISDIR    = cast(i32, 0 - 21);
let is i32 as VFS_EINVAL    = cast(i32, 0 - 22);
let is i32 as VFS_EMFILE    = cast(i32, 0 - 24);
let is i32 as VFS_ENOSPC    = cast(i32, 0 - 28);
let is i32 as VFS_ENOSYS    = cast(i32, 0 - 38);
let is i32 as VFS_ENOTEMPTY = cast(i32, 0 - 39);
let is i32 as VFS_EEXIST    = cast(i32, 0 - 17);
let is i32 as VFS_EXDEV     = cast(i32, 0 - 18);
// A live process was loaded from this file. Same number Linux gives ETXTBSY,
// and the same reason: its text is executing out of pages the kernel holds.
let is i32 as VFS_ETXTBSY   = cast(i32, 0 - 26);

// ============================================================
// open() flags (POSIX-ish). Bitmask.
// ============================================================

let is i32 as O_RDONLY = 0x0000;
let is i32 as O_WRONLY = 0x0001;
let is i32 as O_RDWR   = 0x0002;
let is i32 as O_ACCMODE = 0x0003;
let is i32 as O_CREAT  = 0x0040;
let is i32 as O_EXCL   = 0x0080;
let is i32 as O_TRUNC  = 0x0200;
let is i32 as O_APPEND = 0x0400;

// seek whence values
let is i32 as SEEK_SET = 0;
let is i32 as SEEK_CUR = 1;
let is i32 as SEEK_END = 2;

// File-type bit inside VfsStat.attr / FileSystemOps attrs.
let is i32 as ATTR_FILE      = 0x01;
let is i32 as ATTR_DIR       = 0x10;

// ============================================================
// Public types
// ============================================================

struct VfsStat {
    size as i64;
    first_cluster as i64;   // FS-specific identifier; FAT32 stores the chain head here
    attr as i64;            // bitmask: ATTR_DIR etc. (i64 for layout consistency)
    is_dir as i64;
}

// Populated by readdir(). Name is zero-terminated up to name_len.
struct VfsDirEntry {
    name as [256]u8;
    name_len as i64;
    first_cluster as i64;
    size as i64;
    attr as i64;
    is_dir as i64;
}

// Thin per-entry result the FS layer writes into. Kept separate from
// VfsDirEntry so the filesystem adapter doesn't need to know about the
// VFS's own 256-byte name buffer — we pass the buffer as a *u8 + cap.
struct ReaddirOut {
    name_len as i64;
    attr as i64;
    first_cluster as i64;
    size as i64;
}

// Filesystem vtable. Every op takes `priv` (the FS-private state) as
// its first argument so a single vtable instance can serve multiple
// mounted volumes of the same type.
//
// Paths handed to the FS are *already stripped* of the mount prefix:
// for mount "/boot" a caller's "/boot/kernel.elf" becomes the FS-
// relative "/kernel.elf". Mount root is always a leading '/'.
struct FileSystemOps {
    // resolve path → parent_cluster + first_cluster + size + attr, plus
    // the entry's stable slot location (ent_cluster, ent_off) for later
    // update_entry. Used by open() to cache handle state.
    resolve as fn(*u8, *u8, i64,
                  *i64, *i64, *i64, *i32, *i64, *i64) as i32;
    // Stat: lighter resolve variant, doesn't need parent. Path based.
    stat as fn(*u8, *u8, i64, *VfsStat) as i32;
    // Statx: same as stat but fills an extended struct including mtime.
    // NULL for filesystems that don't track timestamps; the dispatcher
    // (sys_statx) returns E_NOSYS in that case so old callers that don't
    // care about mtime keep using SYS_STAT untouched.
    statx as fn(*u8, *u8, i64, *abi.Statx) as i32;
    // read/write by first_cluster + size, plus the open file's position
    // cursor (VfsFile.hint0..3): opaque to the VFS, kept by the filesystem so
    // sequential I/O does not re-walk the file from its start on every call.
    read as fn(*u8, i64, i64, i64, *u8, i64, *i64) as i64;
    // write_at may relocate the head (empty file → allocated chain)
    // and always returns the new file size. *out_first_cluster is set
    // even on success so callers can detect relocation.
    write_at as fn(*u8, i64, i64, i64, *u8, i64, *i64, *i64) as i64;
    // truncate to exactly new_size. May shrink by freeing clusters or
    // grow by allocating zeroed clusters. *out_first_cluster reflects
    // the (possibly new) head.
    truncate as fn(*u8, i64, i64, i64, *i64) as i32;
    // Persist a new (first_cluster, size) into the directory entry at the
    // stable slot location (ent_cluster, ent_off) captured by resolve.
    // Called after write_at or truncate reshapes the chain. Keyed by slot,
    // not by first_cluster, so it is correct even after O_TRUNC zeroes it.
    //   args: (priv, ent_cluster, ent_off, new_first_cluster, new_size)
    update_entry as fn(*u8, i64, i64, i64, i64) as i32;
    // Metadata operations, all path-based. create makes an empty
    // regular file, unlink removes a regular file, mkdir/rmdir for
    // directories, rename is cross-parent aware.
    create as fn(*u8, *u8, i64) as i32;
    unlink as fn(*u8, *u8, i64) as i32;
    mkdir  as fn(*u8, *u8, i64) as i32;
    rmdir  as fn(*u8, *u8, i64) as i32;
    rename as fn(*u8, *u8, i64, *u8, i64) as i32;
    // readdir by parent first_cluster (caller passes first_cluster
    // from stat/resolve). idx is 0-based; -1 on end, -2 on I/O.
    readdir as fn(*u8, i64, i64,
                  *u8, i64, *ReaddirOut) as i32;
    // Fsync: barrier on the underlying device.
    sync as fn(*u8) as i32;
}

struct VfsMount {
    path as [32]u8;
    path_len as i64;
    ops as *FileSystemOps;
    priv as *u8;
    next as *VfsMount;
}

// Open file handle. VFS owns the state machine; FS ops are stateless
// w.r.t. offset and flags.
struct VfsFile {
    // All scalars i64 — Caustic miscompiles mixed widths between
    // adjacent fields (the i32s next to *VfsMount were aliasing
    // mount's low half on -smp 4, resulting in indirect calls
    // that landed on data symbols).
    in_use as i64;
    ref_count as i64;
    flags as i64;
    // Filesystem pointers.
    mount as *VfsMount;
    parent_cluster as i64;   // used for update_entry after writes
    // Stable physical location of this file's directory entry (FS cluster
    // + 32-byte slot offset), captured at open. update_entry patches THIS
    // slot — surviving O_TRUNC zeroing first_cluster (see fat32 found_ent_*).
    ent_cluster as i64;
    ent_off as i64;
    first_cluster as i64;
    size as i64;
    offset as i64;
    attr as i64;
    is_dir as i64;
    // readdir cursor — only meaningful for directories.
    readdir_idx as i64;
    // The filesystem's cursor into this file (see FileSystemOps.read). Four
    // consecutive words, passed as &hint0; zeroed at open.
    hint0 as i64;
    hint1 as i64;
    hint2 as i64;
    hint3 as i64;
    // Write-behind (see wb_flush). `size` above is the size the file has
    // once its waiting bytes land; disk_size is what the filesystem holds now.
    wb_err as i64;           // a deferred write that failed, not yet reported
    disk_size as i64;
}

// ============================================================
// Static pools
// ============================================================

let is i32 as MAX_MOUNTS = 8;
let is i32 as MAX_OPEN_FILES = 64;

let is [8]VfsMount as mount_pool with mut;
let is i64 as mount_pool_used with mut = 0;
let is *VfsMount as mount_head_var with mut = cast(*VfsMount, 0);

fn mount_head() as *VfsMount { return mount_head_var; }
fn set_mount_head(p as *VfsMount) as void { mount_head_var = p; }

let is [64]VfsFile as file_pool with mut;

// The path each file opened for writing was opened by, so closing it can tell
// SYS_WATCH which path changed (vfswatch.cst). Indexed like file_pool; length
// 0 for a file opened read-only. 256 bytes a slot: the syscalls' PATH_MAX.
let is [16384]u8 as wpath with mut;
let is [64]i64 as wpath_len with mut;

fn _pool_index(f as *VfsFile) as i64 {
    return (cast(i64, f) - cast(i64, &file_pool[0])) / sizeof(VfsFile);
}

// ============================================================
// Init
// ============================================================

fn init() as void {
    let is i64 as i with mut = 0;
    while (i < cast(i64, MAX_OPEN_FILES)) {
        file_pool[i].in_use = 0;
        file_pool[i].ref_count = 0;
        i = i + 1;
    }
    mount_pool_used = 0;
    set_mount_head(cast(*VfsMount, 0));
    file_ops_init();
    mutex.name(&fs_lock, "vfs.fs_lock", 11);
    serial.println("vfs: ready", 10);
}

// ============================================================
// Mount / unmount
// ============================================================

fn mount(path as *u8, path_len as i64,
         ops as *FileSystemOps, priv as *u8) as i32 {
    if (path_len <= 0 || path_len >= 32) { return VFS_EINVAL; }
    if (path[0] != cast(u8, 47))          { return VFS_EINVAL; }   // must start with '/'
    if (cast(i64, ops) == 0)              { return VFS_EINVAL; }
    if (mount_pool_used >= cast(i64, MAX_MOUNTS)) { return VFS_ENOSPC; }

    // Reject duplicate mount at same path.
    let is *VfsMount as m with mut = mount_head();
    while (cast(i64, m) != 0) {
        if (m.path_len == path_len) {
            let is i64 as k with mut = 0;
            let is i32 as eq with mut = 1;
            while (k < path_len) {
                if (m.path[k] != path[k]) { eq = 0; k = path_len; }
                else { k = k + 1; }
            }
            if (eq == 1) { return VFS_EEXIST; }
        }
        m = m.next;
    }

    let is *VfsMount as slot = &mount_pool[mount_pool_used];
    mount_pool_used = mount_pool_used + 1;
    let is i64 as k with mut = 0;
    while (k < path_len) { slot.path[k] = path[k]; k = k + 1; }
    while (k < 32)       { slot.path[k] = cast(u8, 0); k = k + 1; }
    slot.path_len = path_len;
    slot.ops = ops;
    slot.priv = priv;
    slot.next = mount_head();
    set_mount_head(slot);

    serial.print("vfs: mounted ", 13);
    let is i64 as j with mut = 0;
    while (j < path_len) { serial.putc(cast(i64, path[j])); j = j + 1; }
    serial.println("", 0);
    return VFS_OK;
}

// Resolve which mount serves `path`. Longest-prefix-match. Returns the
// VfsMount plus the offset where the FS-relative path starts. "/" is
// always that offset-0 in the returned string. On no match returns
// null.
//
// Matching rules:
//   - Mount "/" matches every absolute path.
//   - Mount "/boot" matches "/boot" and "/boot/..." but not "/boots".
fn resolve_mount(path as *u8, path_len as i64,
                 out_rel_off as *i64) as *VfsMount {
    if (path_len <= 0) { return cast(*VfsMount, 0); }
    let is *VfsMount as best with mut = cast(*VfsMount, 0);
    let is i64 as best_len with mut = 0 - 1;

    let is *VfsMount as m with mut = mount_head();
    while (cast(i64, m) != 0) {
        if (m.path_len <= path_len) {
            let is i32 as prefix_ok with mut = 1;
            let is i64 as k with mut = 0;
            while (k < m.path_len) {
                if (m.path[k] != path[k]) { prefix_ok = 0; k = m.path_len; }
                else { k = k + 1; }
            }
            if (prefix_ok == 1) {
                // Additional boundary check: the char right after must
                // be '/' or end-of-string, otherwise "/boot" would
                // match "/booted".
                let is i32 as boundary with mut = 0;
                if (m.path_len == 1 && m.path[0] == cast(u8, 47)) {
                    boundary = 1;   // '/' is a universal prefix
                } else if (m.path_len == path_len) {
                    boundary = 1;
                } else if (path[m.path_len] == cast(u8, 47)) {
                    boundary = 1;
                }
                if (boundary == 1 && m.path_len > best_len) {
                    best = m;
                    best_len = m.path_len;
                }
            }
        }
        m = m.next;
    }
    if (cast(i64, best) == 0) { return cast(*VfsMount, 0); }
    if (best.path_len == 1) { *out_rel_off = 0; }   // mount "/" sees full path
    else                    { *out_rel_off = best.path_len; }
    return best;
}

// ============================================================
// File pool helpers
// ============================================================

fn pool_alloc() as *VfsFile {
    let is i64 as i with mut = 0;
    while (i < cast(i64, MAX_OPEN_FILES)) {
        if (file_pool[i].in_use == 0) {
            file_pool[i].in_use = 1;
            file_pool[i].ref_count = 1;
            file_pool[i].flags = 0;
            file_pool[i].mount = cast(*VfsMount, 0);
            file_pool[i].parent_cluster = 0;
            file_pool[i].first_cluster = 0;
            file_pool[i].size = 0;
            file_pool[i].offset = 0;
            file_pool[i].attr = 0;
            file_pool[i].is_dir = 0;
            file_pool[i].readdir_idx = 0;
            file_pool[i].hint0 = 0;
            file_pool[i].hint1 = 0;
            file_pool[i].hint2 = 0;
            file_pool[i].hint3 = 0;
            file_pool[i].wb_err = 0;
            file_pool[i].disk_size = 0;
            return &file_pool[i];
        }
        i = i + 1;
    }
    return cast(*VfsFile, 0);
}

fn pool_release(f as *VfsFile) as void {
    if (cast(i64, f) == 0) { return; }
    f.ref_count = f.ref_count - 1;
    if (f.ref_count <= 0) {
        if (wb_file == cast(i64, f)) { wb_flush(); }
        f.in_use = 0;
        f.mount = cast(*VfsMount, 0);
    }
}

// ============================================================
// Write-behind
// ============================================================
//
// Every write went straight to the filesystem: for FAT32 a read-modify-write of
// the cluster and a rewrite of the directory entry, per call. A program that
// prints a number at a time into a file (`seq 1 300000 > f`: 600,000 writes of
// one to seven bytes) paid that 600,000 times. Small writes that continue where
// the last one stopped now collect in a buffer and reach the filesystem a
// buffer at a time.
//
// Nobody can observe the difference. There is one buffer, and the bytes in it
// belong to one open file at a time (wb_file). They are written out when the
// buffer is full, when that file does anything but another contiguous small
// write (a read, a large or out-of-place write, close), and before any other
// operation at all — a read or write through another handle, open, stat,
// readdir, unlink, rename, mkdir, rmdir — so every other view of the file sees
// them, and in the order they were written. A deferred write that fails is
// kept on its file and returned by that file's next read, write, or close,
// which is where a program finds out on any system that buffers. Shutdown
// writes them out first.
let is i64 as WB_CAP = 4096;
let is i64 as WB_SMALL = 1024;           // larger writes go straight through
let is i64 as wb_file with mut = 0;      // *VfsFile whose bytes are waiting; 0 = none
let is i64 as wb_buf with mut = 0;       // WB_CAP-byte kmalloc, allocated on first use
let is i64 as wb_off with mut = 0;       // file offset of wb_buf[0]
let is i64 as wb_len with mut = 0;       // bytes waiting

// The waiting bytes, if any, to the filesystem. A failure is recorded on the
// file they belong to (wb_err) and returned. Caller holds fs_lock.
fn wb_flush() as i64 {
    if (wb_file == 0) { return 0; }
    let is *VfsFile as f = cast(*VfsFile, wb_file);
    let is i64 as len = wb_len;
    wb_file = 0;
    wb_len = 0;
    let is i64 as new_first with mut = f.first_cluster;
    let is i64 as new_size = call(f.mount.ops.write_at,
                                  f.mount.priv,
                                  f.first_cluster, f.disk_size,
                                  wb_off, cast(*u8, wb_buf), len, &new_first, &f.hint0);
    if (new_size < 0) {
        if (f.wb_err == 0) { f.wb_err = new_size; }
        return new_size;
    }
    let is i32 as ue = call(f.mount.ops.update_entry,
                            f.mount.priv, f.ent_cluster, f.ent_off,
                            new_first, new_size);
    f.first_cluster = new_first;
    f.disk_size = new_size;
    if (ue != 0) {
        if (f.wb_err == 0) { f.wb_err = cast(i64, ue); }
        return cast(i64, ue);
    }
    return 0;
}

// Before f reads or writes: everything waiting reaches the filesystem first —
// f's own bytes only when `own` is 1. Returns f's deferred-write error, once
// (it is cleared as it is reported); another file's error stays with that
// file. Caller holds fs_lock.
fn wb_settle(f as *VfsFile, own as i64) as i64 {
    if (wb_file != 0 && (wb_file != cast(i64, f) || own == 1)) { wb_flush(); }
    let is i64 as e = f.wb_err;
    f.wb_err = 0;
    return e;
}

// Every write made so far to the filesystem, for a caller about to use f's
// identity (first cluster, size) straight from its handle. Returns f's
// deferred-write error, if it had one.
fn flush(f as *VfsFile) as i64 {
    if (cast(i64, f) == 0 || f.in_use == 0) { return cast(i64, VFS_EBADF); }
    mutex.acquire(&fs_lock);
    let is i64 as e = wb_settle(f, 1);
    mutex.release(&fs_lock);
    return e;
}

// Shutdown: whatever is waiting to the filesystem, and each filesystem's own
// state (FAT32's FSInfo) to its disk — and from then on, no change at all.
// Processes are still running when the machine powers off, and one writing a
// file after the last sync (a terminal saving its history) changed the FAT or
// a directory on its way to a power cut: the disk came up with what fsck
// calls a damaged volume. After this, an operation that would change the disk
// fails with E_IO; reading still works. Set under fs_lock, so an operation
// already inside finishes first and is in the sync.
let is i64 as frozen with mut = 0;

fn shutdown() as void {
    mutex.acquire(&fs_lock);
    wb_flush();
    let is *VfsMount as m with mut = mount_head();
    while (cast(i64, m) != 0) {
        if (cast(i64, m.ops) != 0 && cast(i64, m.ops.sync) != 0) { call(m.ops.sync, m.priv); }
        m = m.next;
    }
    frozen = 1;
    mutex.release(&fs_lock);
}

// ============================================================
// open/close/read/write/seek/stat
// ============================================================

// Set by main.cst to imgcache.is_live. A function pointer rather than an import
// because imgcache reads files THROUGH the VFS, so a `use` back would close a
// cycle the compiler dies on. Composition lives in main, as it does for every
// other cycle here. Absent (0) = nothing is cached, so nothing is busy.
let is i64 as img_live_fn with mut = 0;
let is i64 as img_stale_fn with mut = 0;

fn set_img_live(fp as i64) as void { img_live_fn = fp; }
fn set_img_stale(fp as i64) as void { img_stale_fn = fp; }

// The bytes behind this cluster are about to change: retire any cached image
// built from them. Called only after img_busy said no, so nothing is executing
// out of it — this drops a cache entry, it never pulls the rug from a process.
fn img_invalidate(first_cluster as i64) as void {
    if (img_stale_fn == 0) { return; }
    if (first_cluster == 0) { return; }
    call(cast(fn(i64) as void, img_stale_fn), first_cluster);
}

// Is a live image loaded from this file? The ETXTBSY question, asked before any
// change to the bytes behind a running program's text.
fn img_busy(first_cluster as i64) as i32 {
    if (img_live_fn == 0) { return 0; }
    if (first_cluster == 0) { return 0; }
    return call(cast(fn(i64) as i32, img_live_fn), first_cluster);
}

fn open_inner(path as *u8, path_len as i64, flags as i32) as *VfsFile {
    if (path_len <= 0) { return cast(*VfsFile, 0); }
    let is i64 as rel_off with mut = 0;
    let is *VfsMount as mnt = resolve_mount(path, path_len, &rel_off);
    if (cast(i64, mnt) == 0) { return cast(*VfsFile, 0); }

    let is *u8 as rel = cast(*u8, cast(i64, path) + rel_off);
    let is i64 as rel_len = path_len - rel_off;
    // Mount root lookup always needs at least "/".
    let is i64 as effective_len with mut = rel_len;
    let is *u8 as effective_path with mut = rel;
    if (rel_len == 0) {
        effective_path = cast(*u8, "/");
        effective_len = 1;
    }

    let is i64 as parent_cluster with mut = 0;
    let is i64 as first_cluster with mut = 0;
    let is i64 as size with mut = 0;
    let is i32 as attr with mut = 0;
    let is i64 as ent_cluster with mut = 0;
    let is i64 as ent_off with mut = 0;
    let is i32 as rc with mut = call(mnt.ops.resolve,
                                     mnt.priv, effective_path, effective_len,
                                     &parent_cluster, &first_cluster, &size, &attr,
                                     &ent_cluster, &ent_off);

    if (rc != 0) {
        if ((flags & O_CREAT) == 0) { return cast(*VfsFile, 0); }
        // Create path requested — attempt file creation (empty), then
        // resolve again (the second resolve captures the new entry's slot).
        let is i32 as cc = call(mnt.ops.create,
                                mnt.priv, effective_path, effective_len);
        if (cc != 0) { return cast(*VfsFile, 0); }
        rc = call(mnt.ops.resolve,
                  mnt.priv, effective_path, effective_len,
                  &parent_cluster, &first_cluster, &size, &attr,
                  &ent_cluster, &ent_off);
        if (rc != 0) { return cast(*VfsFile, 0); }
    } else {
        // Exists; honour O_EXCL.
        if ((flags & (O_CREAT | O_EXCL)) == (O_CREAT | O_EXCL)) {
            return cast(*VfsFile, 0);
        }
    }

    // Opening for WRITE a file a live process was loaded from: refuse. The
    // image cache holds the frames that program's text is executing out of and
    // keys them by (first_cluster, size); rewriting the file would leave the
    // cache describing bytes that are gone. Checked here, before O_TRUNC below
    // gets a chance to shorten it. Read-only opens are always fine — reading a
    // running program is what `cp` does.
    if ((flags & O_ACCMODE) != O_RDONLY || (flags & O_TRUNC) != 0) {
        if (img_busy(first_cluster) != 0) { return cast(*VfsFile, 0); }
        img_invalidate(first_cluster);
    }

    let is *VfsFile as f = pool_alloc();
    if (cast(i64, f) == 0) { return cast(*VfsFile, 0); }

    f.flags = flags;
    f.mount = mnt;
    f.parent_cluster = parent_cluster;
    f.ent_cluster = ent_cluster;
    f.ent_off = ent_off;
    f.first_cluster = first_cluster;
    f.size = size;
    f.disk_size = size;
    f.attr = attr;
    if ((attr & ATTR_DIR) != 0) { f.is_dir = 1; } else { f.is_dir = 0; }
    f.offset = 0;

    // O_TRUNC: reset file to zero length (only makes sense on regular
    // files opened for writing).
    if ((flags & O_TRUNC) != 0 && f.is_dir == 0 &&
        (flags & O_ACCMODE) != O_RDONLY) {
        let is i64 as new_first with mut = 0;
        let is i32 as tc = call(mnt.ops.truncate,
                                mnt.priv,
                                f.first_cluster, f.size, cast(i64, 0),
                                &new_first);
        if (tc == 0) {
            // Always, even when the file was already empty: opening with
            // O_TRUNC is a modification, and the entry is where its time is.
            call(mnt.ops.update_entry,
                 mnt.priv, f.ent_cluster, f.ent_off,
                 new_first, cast(i64, 0));
            f.first_cluster = new_first;
            f.size = 0;
            f.disk_size = 0;
        } else {
            pool_release(f);
            return cast(*VfsFile, 0);
        }
    }

    // O_APPEND starts offset at the end.
    if ((flags & O_APPEND) != 0) { f.offset = f.size; }

    return f;
}

fn close_inner(f as *VfsFile) as i32 {
    if (cast(i64, f) == 0) { return VFS_EBADF; }
    if (f.in_use == 0)     { return VFS_EBADF; }
    let is i64 as deferred = wb_settle(f, 1);
    // Reader/writer synchronisation barrier — let the FS flush any
    // per-mount caches before the handle dissolves.
    if (cast(i64, f.mount) != 0 && cast(i64, f.mount.ops.sync) != 0) {
        call(f.mount.ops.sync, f.mount.priv);
    }
    pool_release(f);
    if (deferred != 0) { return cast(i32, deferred); }
    return VFS_OK;
}

fn read_inner(f as *VfsFile, buf as *u8, n as i64) as i64 {
    if (cast(i64, f) == 0 || f.in_use == 0) { return cast(i64, VFS_EBADF); }
    if (f.is_dir == 1)                       { return cast(i64, VFS_EISDIR); }
    if ((f.flags & O_ACCMODE) == O_WRONLY)   { return cast(i64, VFS_EBADF); }
    if (n <= 0)                              { return 0; }
    let is i64 as werr = wb_settle(f, 1);
    if (werr < 0)                            { return werr; }
    if (f.offset >= f.size)                  { return 0; }
    let is i64 as to_read with mut = n;
    if (f.offset + to_read > f.size) { to_read = f.size - f.offset; }
    let is i64 as got = call(f.mount.ops.read,
                             f.mount.priv,
                             f.first_cluster, f.size, f.offset,
                             buf, to_read, &f.hint0);
    if (got < 0) { return got; }
    f.offset = f.offset + got;
    return got;
}

fn write_inner(f as *VfsFile, buf as *u8, n as i64) as i64 {
    if (cast(i64, f) == 0 || f.in_use == 0)    { return cast(i64, VFS_EBADF); }
    if (f.is_dir == 1)                          { return cast(i64, VFS_EISDIR); }
    if ((f.flags & O_ACCMODE) == O_RDONLY)      { return cast(i64, VFS_EBADF); }
    if (n <= 0)                                 { return 0; }

    let is i64 as write_off with mut = f.offset;
    if ((f.flags & O_APPEND) != 0) { write_off = f.size; }

    // A small write that continues f's buffered run joins it; anything else
    // lands after whatever is waiting.
    let is i64 as joins with mut = 0;
    if (n <= WB_SMALL && wb_file == cast(i64, f)
        && write_off == wb_off + wb_len && wb_len + n <= WB_CAP) { joins = 1; }
    let is i64 as werr = wb_settle(f, 1 - joins);
    if (werr < 0) { return werr; }

    if (n <= WB_SMALL) {
        if (wb_buf == 0) { wb_buf = heap.kmalloc(WB_CAP, 0); }
        if (wb_buf != 0) {
            if (wb_file == 0) {
                wb_file = cast(i64, f);
                wb_off = write_off;
                wb_len = 0;
            }
            let is *u8 as wb = cast(*u8, wb_buf + wb_len);
            let is i64 as k with mut = 0;
            while (k < n) { wb[k] = buf[k]; k = k + 1; }
            wb_len = wb_len + n;
            f.offset = write_off + n;
            if (f.offset > f.size) { f.size = f.offset; }
            return n;
        }
    }

    let is i64 as new_first with mut = f.first_cluster;
    let is i64 as new_size = call(f.mount.ops.write_at,
                                  f.mount.priv,
                                  f.first_cluster, f.disk_size,
                                  write_off, buf, n, &new_first, &f.hint0);
    if (new_size < 0) { return new_size; }

    // Persist the new (first_cluster, size) into our directory entry's
    // stable slot — correct even when first_cluster was 0 before this write.
    let is i32 as ue = call(f.mount.ops.update_entry,
                            f.mount.priv, f.ent_cluster, f.ent_off,
                            new_first, new_size);
    if (ue != 0) { return cast(i64, ue); }

    f.first_cluster = new_first;
    f.disk_size = new_size;
    if (new_size > f.size) { f.size = new_size; }
    f.offset = write_off + n;
    return n;
}

fn lseek(f as *VfsFile, off as i64, whence as i32) as i64 {
    if (cast(i64, f) == 0 || f.in_use == 0) { return cast(i64, VFS_EBADF); }
    let is i64 as new_off with mut = 0;
    if (whence == SEEK_SET) { new_off = off; }
    else if (whence == SEEK_CUR) { new_off = f.offset + off; }
    else if (whence == SEEK_END) { new_off = f.size + off; }
    else { return cast(i64, VFS_EINVAL); }
    if (new_off < 0) { return cast(i64, VFS_EINVAL); }
    f.offset = new_off;
    return new_off;
}

fn stat_path_inner(path as *u8, path_len as i64, out as *VfsStat) as i32 {
    if (path_len <= 0)        { return VFS_EINVAL; }
    let is i64 as rel_off with mut = 0;
    let is *VfsMount as mnt = resolve_mount(path, path_len, &rel_off);
    if (cast(i64, mnt) == 0)  { return VFS_ENOENT; }
    let is *u8 as rel = cast(*u8, cast(i64, path) + rel_off);
    let is i64 as rel_len = path_len - rel_off;
    let is i64 as ef_len with mut = rel_len;
    let is *u8 as ef_path with mut = rel;
    if (rel_len == 0) { ef_path = cast(*u8, "/"); ef_len = 1; }
    return call(mnt.ops.stat, mnt.priv, ef_path, ef_len, out);
}

// ============================================================
// Metadata dispatch
// ============================================================

// Would this path's bytes be pulled out from under a running program? Resolves
// the entry to get its cluster, then asks the image cache. A path that does not
// resolve is not busy — the op below will fail on its own terms, and answering
// "busy" for a file that is not there would be a lie.
fn _busy_or_retire(mnt as *VfsMount, path as *u8, path_len as i64) as i32 {
    if (img_live_fn == 0) { return 0; }
    let is i64 as parent_cluster with mut = 0;
    let is i64 as first_cluster with mut = 0;
    let is i64 as size with mut = 0;
    let is i32 as attr with mut = 0;
    let is i64 as ent_cluster with mut = 0;
    let is i64 as ent_off with mut = 0;
    if (call(mnt.ops.resolve, mnt.priv, path, path_len,
             &parent_cluster, &first_cluster, &size, &attr,
             &ent_cluster, &ent_off) != 0) { return 0; }
    if (img_busy(first_cluster) != 0) { return 1; }
    img_invalidate(first_cluster);
    return 0;
}

fn unlink_inner(path as *u8, path_len as i64) as i32 {
    let is i64 as rel_off with mut = 0;
    let is *VfsMount as mnt = resolve_mount(path, path_len, &rel_off);
    if (cast(i64, mnt) == 0) { return VFS_ENOENT; }
    let is *u8 as rel = cast(*u8, cast(i64, path) + rel_off);
    let is i64 as rel_len = path_len - rel_off;
    let is i64 as ef_len with mut = rel_len;
    let is *u8 as ef_path with mut = rel;
    if (rel_len == 0) { ef_path = cast(*u8, "/"); ef_len = 1; }
    if (_busy_or_retire(mnt, ef_path, ef_len) != 0) { return VFS_ETXTBSY; }
    return call(mnt.ops.unlink, mnt.priv, ef_path, ef_len);
}

fn mkdir_inner(path as *u8, path_len as i64) as i32 {
    let is i64 as rel_off with mut = 0;
    let is *VfsMount as mnt = resolve_mount(path, path_len, &rel_off);
    if (cast(i64, mnt) == 0) { return VFS_ENOENT; }
    let is *u8 as rel = cast(*u8, cast(i64, path) + rel_off);
    let is i64 as rel_len = path_len - rel_off;
    let is i64 as ef_len with mut = rel_len;
    let is *u8 as ef_path with mut = rel;
    if (rel_len == 0) { ef_path = cast(*u8, "/"); ef_len = 1; }
    return call(mnt.ops.mkdir, mnt.priv, ef_path, ef_len);
}

fn rmdir_inner(path as *u8, path_len as i64) as i32 {
    let is i64 as rel_off with mut = 0;
    let is *VfsMount as mnt = resolve_mount(path, path_len, &rel_off);
    if (cast(i64, mnt) == 0) { return VFS_ENOENT; }
    let is *u8 as rel = cast(*u8, cast(i64, path) + rel_off);
    let is i64 as rel_len = path_len - rel_off;
    let is i64 as ef_len with mut = rel_len;
    let is *u8 as ef_path with mut = rel;
    if (rel_len == 0) { ef_path = cast(*u8, "/"); ef_len = 1; }
    return call(mnt.ops.rmdir, mnt.priv, ef_path, ef_len);
}

fn rename_inner(src as *u8, src_len as i64,
          dst as *u8, dst_len as i64) as i32 {
    let is i64 as src_off with mut = 0;
    let is *VfsMount as m1 = resolve_mount(src, src_len, &src_off);
    let is i64 as dst_off with mut = 0;
    let is *VfsMount as m2 = resolve_mount(dst, dst_len, &dst_off);
    if (cast(i64, m1) == 0 || cast(i64, m2) == 0) { return VFS_ENOENT; }
    if (cast(i64, m1) != cast(i64, m2))           { return VFS_EXDEV; }
    let is *u8 as rs = cast(*u8, cast(i64, src) + src_off);
    let is *u8 as rd = cast(*u8, cast(i64, dst) + dst_off);
    // Both ends: renaming the source moves a running program's bytes, and
    // renaming ONTO the destination replaces them.
    if (_busy_or_retire(m1, rs, src_len - src_off) != 0) { return VFS_ETXTBSY; }
    if (_busy_or_retire(m1, rd, dst_len - dst_off) != 0) { return VFS_ETXTBSY; }
    return call(m1.ops.rename, m1.priv,
                rs, src_len - src_off,
                rd, dst_len - dst_off);
}

fn readdir_inner(f as *VfsFile, out as *VfsDirEntry) as i32 {
    if (cast(i64, f) == 0 || f.in_use == 0) { return VFS_EBADF; }
    if (f.is_dir == 0) { return VFS_ENOTDIR; }
    let is ReaddirOut as ro;
    let is i32 as rc = call(f.mount.ops.readdir,
                            f.mount.priv, f.first_cluster, f.readdir_idx,
                            cast(*u8, &out.name[0]), cast(i64, 256), &ro);
    if (rc != 0) { return rc; }
    out.name_len = ro.name_len;
    out.first_cluster = ro.first_cluster;
    out.size = ro.size;
    out.attr = ro.attr;
    if ((ro.attr & ATTR_DIR) != 0) { out.is_dir = 1; } else { out.is_dir = 0; }
    f.readdir_idx = f.readdir_idx + 1;
    return VFS_OK;
}

// ============================================================
// KObject (file kind) — a VfsFile is the `priv` of a KOBJ_FILE. These
// wrappers give the typed vfs ops the uniform i64 signature the KObject
// vtable expects, and map the VFS errno dialect to the abi.E_* set so
// every fd-backed object speaks one error language. The fd table itself
// already stores an opaque i64; sys_open mints one of these and parks it.
// ============================================================

// VFS_* → abi.E_* . Single source of truth (the metadata syscalls call
// this too, via vfs.err_to_abi).
fn err_to_abi(rc as i64) as i64 {
    if (rc == cast(i64, VFS_ENOENT))    { return abi.E_NOENT; }
    if (rc == cast(i64, VFS_EBADF))     { return abi.E_BADF; }
    if (rc == cast(i64, VFS_EINVAL))    { return abi.E_INVAL; }
    if (rc == cast(i64, VFS_EISDIR))    { return abi.E_ISDIR; }
    if (rc == cast(i64, VFS_ENOTDIR))   { return abi.E_NOTDIR; }
    if (rc == cast(i64, VFS_EEXIST))    { return abi.E_EXIST; }
    if (rc == cast(i64, VFS_ENOTEMPTY)) { return abi.E_NOTEMPTY; }
    if (rc == cast(i64, VFS_EMFILE))    { return abi.E_MFILE; }
    if (rc == cast(i64, VFS_ENOSPC))    { return abi.E_NOSPC; }
    if (rc == cast(i64, VFS_EIO))       { return abi.E_IO; }
    if (rc == cast(i64, VFS_ENOMEM))    { return abi.E_NOMEM; }
    if (rc == cast(i64, VFS_ETXTBSY))   { return abi.E_TXTBSY; }
    return abi.E_INVAL;
}

// ============================================================
// Public op wrappers — acquire fs_lock, run the _inner body, release. One
// acquire/release per op regardless of the body's internal returns, so the
// shared fat32 scratch buffers are never touched by two cpus at once.
// ============================================================
fn open(path as *u8, path_len as i64, flags as i32) as *VfsFile {
    mutex.acquire(&fs_lock);
    if (frozen != 0 && (flags & (O_CREAT | O_TRUNC)) != 0) {
        mutex.release(&fs_lock);
        return cast(*VfsFile, 0);
    }
    wb_flush();
    let is *VfsFile as r = open_inner(path, path_len, flags);
    if (cast(i64, r) != 0) {
        let is i64 as k = _pool_index(r);
        wpath_len[k] = 0;
        let is i64 as writes with mut = 0;
        if ((flags & O_ACCMODE) != O_RDONLY || (flags & (O_CREAT | O_TRUNC)) != 0) { writes = 1; }
        if (writes == 1 && path_len > 0 && path_len <= 256) {
            let is i64 as i with mut = 0;
            while (i < path_len) { wpath[k * 256 + i] = path[i]; i = i + 1; }
            wpath_len[k] = path_len;
        }
    }
    mutex.release(&fs_lock);
    return r;
}
fn close(f as *VfsFile) as i32 {
    mutex.acquire(&fs_lock);
    // The path a write open came from, kept until the close is done: the
    // watchers hear of the change once the bytes are on the volume.
    let is [256]u8 as cp;
    let is i64 as cl with mut = 0;
    if (cast(i64, f) != 0 && f.in_use != 0) {
        let is i64 as k = _pool_index(f);
        cl = wpath_len[k];
        let is i64 as i with mut = 0;
        while (i < cl) { cp[i] = wpath[k * 256 + i]; i = i + 1; }
        wpath_len[k] = 0;
    }
    let is i32 as r = close_inner(f);
    mutex.release(&fs_lock);
    if (cl > 0) { vfswatch.notify(cast(*u8, &cp[0]), cl); }
    return r;
}
fn read(f as *VfsFile, buf as *u8, n as i64) as i64 {
    mutex.acquire(&fs_lock);
    let is i64 as r = read_inner(f, buf, n);
    mutex.release(&fs_lock);
    return r;
}
fn write(f as *VfsFile, buf as *u8, n as i64) as i64 {
    mutex.acquire(&fs_lock);
    if (frozen != 0) { mutex.release(&fs_lock); return cast(i64, VFS_EIO); }
    let is i64 as r = write_inner(f, buf, n);
    mutex.release(&fs_lock);
    return r;
}
fn stat_path(path as *u8, path_len as i64, out as *VfsStat) as i32 {
    mutex.acquire(&fs_lock);
    wb_flush();
    let is i32 as r = stat_path_inner(path, path_len, out);
    mutex.release(&fs_lock);
    return r;
}

// statx_path: extended stat. Walks the same mount lookup as stat_path_inner
// but dispatches to fs_ops.statx (NULL = E_NOSYS) so filesystems without
// timestamp support (or new ones in development) keep working.
fn statx_path(path as *u8, path_len as i64, out as *abi.Statx) as i32 {
    mutex.acquire(&fs_lock);
    wb_flush();
    let is i32 as r = statx_path_inner(path, path_len, out);
    mutex.release(&fs_lock);
    return r;
}

fn statx_path_inner(path as *u8, path_len as i64, out as *abi.Statx) as i32 {
    if (path_len <= 0)        { return VFS_EINVAL; }
    let is i64 as rel_off with mut = 0;
    let is *VfsMount as mnt = resolve_mount(path, path_len, &rel_off);
    if (cast(i64, mnt) == 0)  { return VFS_ENOENT; }
    let is *u8 as rel = cast(*u8, cast(i64, path) + rel_off);
    let is i64 as rel_len = path_len - rel_off;
    let is i64 as ef_len with mut = rel_len;
    let is *u8 as ef_path with mut = rel;
    if (rel_len == 0) { ef_path = cast(*u8, "/"); ef_len = 1; }
    if (cast(i64, mnt.ops) == 0)        { return VFS_EIO; }
    if (cast(i64, mnt.ops.statx) == 0)  { return VFS_ENOSYS; }
    return call(mnt.ops.statx, mnt.priv, ef_path, ef_len, out);
}
fn unlink(path as *u8, path_len as i64) as i32 {
    mutex.acquire(&fs_lock);
    if (frozen != 0) { mutex.release(&fs_lock); return VFS_EIO; }
    wb_flush();
    let is i32 as r = unlink_inner(path, path_len);
    mutex.release(&fs_lock);
    if (r == 0) { vfswatch.notify(path, path_len); }
    return r;
}
fn mkdir(path as *u8, path_len as i64) as i32 {
    mutex.acquire(&fs_lock);
    if (frozen != 0) { mutex.release(&fs_lock); return VFS_EIO; }
    wb_flush();
    let is i32 as r = mkdir_inner(path, path_len);
    mutex.release(&fs_lock);
    if (r == 0) { vfswatch.notify(path, path_len); }
    return r;
}
fn rmdir(path as *u8, path_len as i64) as i32 {
    mutex.acquire(&fs_lock);
    if (frozen != 0) { mutex.release(&fs_lock); return VFS_EIO; }
    wb_flush();
    let is i32 as r = rmdir_inner(path, path_len);
    mutex.release(&fs_lock);
    if (r == 0) { vfswatch.notify(path, path_len); }
    return r;
}
fn rename(src as *u8, src_len as i64, dst as *u8, dst_len as i64) as i32 {
    mutex.acquire(&fs_lock);
    if (frozen != 0) { mutex.release(&fs_lock); return VFS_EIO; }
    wb_flush();
    let is i32 as r = rename_inner(src, src_len, dst, dst_len);
    mutex.release(&fs_lock);
    if (r == 0) {
        vfswatch.notify(src, src_len);
        vfswatch.notify(dst, dst_len);
    }
    return r;
}
fn readdir(f as *VfsFile, out as *VfsDirEntry) as i32 {
    mutex.acquire(&fs_lock);
    wb_flush();
    let is i32 as r = readdir_inner(f, out);
    mutex.release(&fs_lock);
    return r;
}

// Expose fs_lock acquire/release so the FAT32 driver can serialise the FEW
// entry points that touch its shared FAT cache + scratch pages but do NOT go
// through a VfsFile op — notably statfs (counts free clusters by walking the
// whole FAT). Without this, a btop polling SYS_STATFS on one cpu walks the FAT
// (rewriting fat_cache_virt/lba in a tight loop) while another cpu is mid
// dir_find under fs_lock, corrupting the cached FAT sector and making an
// EXISTING file resolve as "not found". The lock is the single FS-wide mutex;
// every fat32 buffer-touching path must hold it. (fat32 imports vfs already,
// so these accessors avoid an import cycle — vfs must not import fat32.)
fn fs_lock_acquire() as void { mutex.acquire(&fs_lock); }
fn fs_lock_release() as void { mutex.release(&fs_lock); }

fn file_op_read(priv as i64, buf as i64, n as i64) as i64 {
    let is i64 as r = read(cast(*VfsFile, priv), cast(*u8, buf), n);
    if (r < 0) { return err_to_abi(r); }
    return r;
}

fn file_op_write(priv as i64, buf as i64, n as i64) as i64 {
    let is i64 as r = write(cast(*VfsFile, priv), cast(*u8, buf), n);
    if (r < 0) { return err_to_abi(r); }
    return r;
}

fn file_op_close(priv as i64) as i64 {
    let is i32 as r = close(cast(*VfsFile, priv));
    if (r != 0) { return err_to_abi(cast(i64, r)); }
    return abi.E_OK;
}

fn file_op_lseek(priv as i64, off as i64, whence as i64) as i64 {
    let is i64 as r = lseek(cast(*VfsFile, priv), off, cast(i32, whence));
    if (r < 0) { return err_to_abi(r); }
    return r;
}

fn file_op_readdir(priv as i64, out as i64) as i64 {
    let is i32 as r = readdir(cast(*VfsFile, priv), cast(*VfsDirEntry, out));
    if (r != 0) { return err_to_abi(cast(i64, r)); }
    return abi.E_OK;
}

// The single FILE vtable; filled in init() (fn pointers don't const-init
// cleanly). mmap/present stay null (a file is a byte stream, not a
// surface), so ko_mmap/ko_present on a file fd return E_INVAL — honest.
let is kobject.KObjectOps as FILE_OPS with mut;

fn file_ops_init() as void {
    FILE_OPS.read    = fn_ptr(file_op_read);
    FILE_OPS.write   = fn_ptr(file_op_write);
    FILE_OPS.close   = fn_ptr(file_op_close);
    FILE_OPS.lseek   = fn_ptr(file_op_lseek);
    FILE_OPS.readdir = fn_ptr(file_op_readdir);
}

// Wrap an open *VfsFile in a fresh KOBJ_FILE. Returns the *KObject as i64
// (0 on OOM). The caller installs it in the fd table; ko_unref closes the
// file when the last fd drops.
fn make_file_kobject(f as *VfsFile) as i64 {
    if (cast(i64, f) == 0) { return 0; }
    return kobject.ko_alloc(kobject.KOBJ_FILE, &FILE_OPS, cast(i64, f));
}

// ============================================================
// Self-test — exercises every hot path of the VFS surface through a
// real filesystem underneath. Assumes someone has already mounted "/",
// typically by the FAT32 worker thread after disk binding completes.
//
// Coverage:
//   - stat_path on file + directory
//   - open read-only, read, seek, stat (via handle), close
//   - open O_CREAT|O_RDWR on a fresh path, write, seek, read-back
//   - append semantics (O_APPEND forces offset = size)
//   - truncate via O_TRUNC
//   - mkdir, readdir enumeration, rmdir
//   - unlink + verify ENOENT
//   - rename across parents
// ============================================================

let is [4096]u8 as test_buf with mut;
let is [64]u8 as test_payload with mut;

fn bytes_equal(a as *u8, b as *u8, n as i64) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn print_name(e as *VfsDirEntry) as void {
    let is i64 as i with mut = 0;
    while (i < e.name_len) {
        serial.putc(cast(i64, e.name[i]));
        i = i + 1;
    }
}

fn test_fail(what as *u8, len as i64) as void {
    serial.print("vfs.test: FAIL ", 15);
    serial.println(what, len);
}

fn self_test() as void {
    serial.println("vfs.test: start", 15);

    // --- stat, read, seek on a file every root image ships ---
    //
    // Nothing here assumes what /hello.txt SAYS. The test used to expect the
    // 27 bytes of one old version of it; the profile changed the text, the
    // test stopped at its first check printing "stat size unexpected=58" —
    // no FAIL anywhere — and everything after it, the whole write half, had
    // not run since. The checks are now about the file agreeing with itself:
    // stat, reads, seeks and the end of file all tell the same story.
    let is VfsStat as st;
    if (stat_path(cast(*u8, "/hello.txt"), 10, &st) != 0) {
        test_fail("stat /hello.txt", 15);
        return;
    }
    let is i64 as size = st.size;
    if (st.is_dir != 0 || size < 12 || size > 4096) {
        serial.print("vfs.test: /hello.txt size=", 26);
        util.print_num(size); serial.println("", 0);
        test_fail("stat /hello.txt: want a file of 12..4096 bytes", 46);
        return;
    }
    serial.println("vfs.test: stat /hello.txt OK", 28);

    let is *VfsFile as f = open(cast(*u8, "/hello.txt"), 10, O_RDONLY);
    if (cast(i64, f) == 0) {
        test_fail("open /hello.txt", 15);
        return;
    }
    // The whole file in one pass: exactly `size` bytes, then end of file.
    let is i64 as total with mut = 0;
    let is i64 as n with mut = 1;
    while (n > 0 && total <= size) {
        n = read(f, cast(*u8, cast(i64, &test_buf[0]) + total), 64);
        if (n > 0) { total = total + n; }
    }
    if (n < 0 || total != size) {
        serial.print("vfs.test: read total=", 21);
        util.print_num(total); serial.print(" stat size=", 11);
        util.print_num(size); serial.println("", 0);
        test_fail("reading to the end gives the stat size", 38);
        return;
    }
    // Seek into the middle: the bytes there are the ones the full read saw.
    if (lseek(f, cast(i64, 6), SEEK_SET) != 6) {
        test_fail("lseek SEEK_SET", 14);
        return;
    }
    n = read(f, cast(*u8, &test_payload[0]), 5);
    if (n != 5 || bytes_equal(cast(*u8, &test_payload[0]),
                              cast(*u8, cast(i64, &test_buf[0]) + 6), 5) == 0) {
        test_fail("read after seek returns the same bytes", 38);
        return;
    }
    serial.println("vfs.test: seek+read OK", 22);
    if (lseek(f, cast(i64, 0), SEEK_END) != size) {
        test_fail("lseek SEEK_END lands on the size", 32);
        return;
    }
    if (read(f, cast(*u8, &test_payload[0]), 5) != 0) {
        test_fail("read past the end returns 0", 27);
        return;
    }
    close(f);

    // --- O_CREAT + write + read back ---
    let is *VfsFile as w = open(cast(*u8, "/vfs-created.bin"), 16,
                                O_RDWR | O_CREAT | O_TRUNC);
    if (cast(i64, w) == 0) {
        test_fail("open O_CREAT", 12);
        return;
    }
    let is i64 as i with mut = 0;
    while (i < 64) { test_payload[i] = cast(u8, (i * 5 + 1) & 0xFF); i = i + 1; }
    let is i64 as wn = write(w, cast(*u8, &test_payload[0]), 64);
    if (wn != 64) {
        serial.print("vfs.test: write n=", 18);
        util.print_num(wn); serial.println(" expected 64", 12);
        test_fail("write of 64 bytes", 17);
        return;
    }
    // Seek back, re-read, byte-check.
    lseek(w, cast(i64, 0), SEEK_SET);
    if (read(w, cast(*u8, &test_buf[0]), 64) != 64) {
        test_fail("read-back size mismatch", 23);
        return;
    }
    if (bytes_equal(cast(*u8, &test_payload[0]),
                    cast(*u8, &test_buf[0]), 64) == 0) {
        test_fail("read-back pattern mismatch", 26);
        return;
    }
    // Write at offset 32 to exercise partial overwrite.
    lseek(w, cast(i64, 32), SEEK_SET);
    let is i64 as j with mut = 0;
    while (j < 16) { test_payload[j] = cast(u8, 0xAA); j = j + 1; }
    write(w, cast(*u8, &test_payload[0]), 16);
    // Verify
    lseek(w, cast(i64, 32), SEEK_SET);
    read(w, cast(*u8, &test_buf[0]), 16);
    let is i32 as ok with mut = 1;
    j = 0;
    while (j < 16) {
        if (test_buf[j] != cast(u8, 0xAA)) { ok = 0; j = 16; }
        else { j = j + 1; }
    }
    if (ok == 0) {
        test_fail("offset write verify", 19);
        return;
    }
    serial.println("vfs.test: O_CREAT+write+seek+read+offset-write OK", 49);
    close(w);

    // --- O_APPEND ---
    let is *VfsFile as a = open(cast(*u8, "/vfs-created.bin"), 16,
                                O_RDWR | O_APPEND);
    if (cast(i64, a) == 0) {
        test_fail("open O_APPEND", 13);
        return;
    }
    let is i64 as ss = a.size;
    let is *u8 as tail = cast(*u8, "APPENDED");
    write(a, tail, 8);
    if (a.size != ss + 8) {
        serial.print("vfs.test: append size=", 22);
        util.print_num(a.size); serial.print(" expected=", 10);
        util.print_num(ss + 8); serial.println("", 0);
        test_fail("O_APPEND grows the file by what was written", 43);
        return;
    }
    close(a);
    serial.println("vfs.test: O_APPEND OK", 21);

    // --- a write past the end leaves a hole that reads as zeros ---
    let is *VfsFile as hf = open(cast(*u8, "/vfs-hole.bin"), 13, O_RDWR | O_CREAT | O_TRUNC);
    if (cast(i64, hf) == 0) { test_fail("open /vfs-hole.bin", 18); return; }
    lseek(hf, cast(i64, 3000), SEEK_SET);
    let is *u8 as tailb = cast(*u8, "END");
    if (write(hf, tailb, 3) != 3 || hf.size != 3003) { test_fail("write past the end", 18); return; }
    lseek(hf, cast(i64, 0), SEEK_SET);
    let is i64 as holebad with mut = 0;
    let is i64 as hoff with mut = 0;
    while (hoff < 3000) {
        let is i64 as hn = read(hf, cast(*u8, &test_buf[0]), 1000);
        if (hn != 1000) { holebad = holebad + 1; hoff = 3000; }
        else {
            let is i64 as hk with mut = 0;
            while (hk < 1000) { if (test_buf[hk] != cast(u8, 0)) { holebad = holebad + 1; } hk = hk + 1; }
            hoff = hoff + 1000;
        }
    }
    if (holebad != 0) { test_fail("a hole reads as zeros", 21); return; }
    close(hf);
    unlink(cast(*u8, "/vfs-hole.bin"), 13);
    serial.println("vfs.test: hole reads zeros OK", 29);

    // --- many small sequential writes read back whole ---
    let is *VfsFile as sf = open(cast(*u8, "/vfs-seq.bin"), 12, O_RDWR | O_CREAT | O_TRUNC);
    if (cast(i64, sf) == 0) { test_fail("open /vfs-seq.bin", 17); return; }
    let is i64 as si with mut = 0;
    while (si < 4000) {
        test_payload[0] = cast(u8, si & 0xFF);
        test_payload[1] = cast(u8, (si >> 8) & 0xFF);
        test_payload[2] = cast(u8, 0x5A);
        if (write(sf, cast(*u8, &test_payload[0]), 3) != 3) { test_fail("small sequential write", 22); return; }
        si = si + 1;
    }
    lseek(sf, cast(i64, 0), SEEK_SET);
    let is i64 as seqbad with mut = 0;
    si = 0;
    while (si < 4000) {
        if (read(sf, cast(*u8, &test_payload[0]), 3) != 3) { seqbad = seqbad + 1; si = 4000; }
        else {
            if (test_payload[0] != cast(u8, si & 0xFF) || test_payload[1] != cast(u8, (si >> 8) & 0xFF)
                || test_payload[2] != cast(u8, 0x5A)) { seqbad = seqbad + 1; }
            si = si + 1;
        }
    }
    if (seqbad != 0 || sf.size != 12000) { test_fail("small sequential writes read back whole", 39); return; }
    close(sf);
    unlink(cast(*u8, "/vfs-seq.bin"), 12);
    serial.println("vfs.test: small sequential writes OK", 36);

    // --- two handles on one file see each other's writes, in order ---
    let is *VfsFile as wa = open(cast(*u8, "/vfs-two.bin"), 12, O_RDWR | O_CREAT | O_TRUNC);
    if (cast(i64, wa) == 0) { test_fail("open /vfs-two.bin", 17); return; }
    if (write(wa, cast(*u8, "........"), 8) != 8) { test_fail("write /vfs-two.bin", 18); return; }
    let is *VfsFile as wb2 = open(cast(*u8, "/vfs-two.bin"), 12, O_RDWR);
    if (cast(i64, wb2) == 0) { test_fail("second open /vfs-two.bin", 24); return; }
    lseek(wa, cast(i64, 0), SEEK_SET);
    write(wa, cast(*u8, "AAAA"), 4);
    // B reads what A wrote, though A has not closed or read.
    if (read(wb2, cast(*u8, &test_buf[0]), 8) != 8
        || bytes_equal(cast(*u8, &test_buf[0]), cast(*u8, "AAAA...."), 8) == 0) {
        test_fail("a second handle reads the first one's write", 43); return;
    }
    // A's bytes, then B's over part of them, then A's again: the last one wins.
    lseek(wa, cast(i64, 4), SEEK_SET);
    write(wa, cast(*u8, "CC"), 2);
    lseek(wb2, cast(i64, 5), SEEK_SET);
    write(wb2, cast(*u8, "DD"), 2);
    lseek(wa, cast(i64, 6), SEEK_SET);
    write(wa, cast(*u8, "E"), 1);
    close(wb2);
    close(wa);
    let is *VfsFile as wc = open(cast(*u8, "/vfs-two.bin"), 12, O_RDONLY);
    if (cast(i64, wc) == 0) { test_fail("reopen /vfs-two.bin", 19); return; }
    if (read(wc, cast(*u8, &test_buf[0]), 8) != 8
        || bytes_equal(cast(*u8, &test_buf[0]), cast(*u8, "AAAACDE."), 8) == 0) {
        test_fail("writes through two handles land in order", 40); return;
    }
    close(wc);
    unlink(cast(*u8, "/vfs-two.bin"), 12);
    serial.println("vfs.test: two handles OK", 24);

    // --- mkdir + readdir + rmdir ---
    if (mkdir(cast(*u8, "/vfs-dir"), 8) != 0) {
        test_fail("mkdir /vfs-dir", 14);
        return;
    }
    let is *VfsFile as d = open(cast(*u8, "/vfs-dir"), 8, O_RDONLY);
    if (cast(i64, d) == 0 || d.is_dir == 0) {
        test_fail("open /vfs-dir", 13);
        return;
    }
    let is VfsDirEntry as de;
    let is i64 as saw with mut = 0;
    while (readdir(d, &de) == 0) {
        serial.print("vfs.test: /vfs-dir entry: ", 26);
        print_name(&de); serial.println("", 0);
        saw = saw + 1;
    }
    // Freshly made dir has exactly '.' and '..'.
    if (saw != 2) {
        serial.print("vfs.test: readdir saw ", 22);
        util.print_num(saw); serial.println(" entries (expected 2)", 21);
        test_fail("a new directory lists exactly . and ..", 38);
        return;
    }
    close(d);
    if (rmdir(cast(*u8, "/vfs-dir"), 8) != 0) {
        test_fail("rmdir", 5);
        return;
    }
    serial.println("vfs.test: mkdir/readdir/rmdir OK", 32);

    // --- rename across parents ---
    if (mkdir(cast(*u8, "/vfs-box"), 8) != 0) {
        test_fail("mkdir /vfs-box", 14);
        return;
    }
    if (rename(cast(*u8, "/vfs-created.bin"), 16,
               cast(*u8, "/vfs-box/moved.bin"), 18) != 0) {
        test_fail("rename", 6);
        return;
    }
    if (stat_path(cast(*u8, "/vfs-box/moved.bin"), 18, &st) != 0) {
        test_fail("moved file missing", 18);
        return;
    }
    serial.println("vfs.test: cross-parent rename OK", 32);

    // --- unlink + ENOENT ---
    if (unlink(cast(*u8, "/vfs-box/moved.bin"), 18) != 0) {
        test_fail("unlink", 6);
        return;
    }
    if (stat_path(cast(*u8, "/vfs-box/moved.bin"), 18, &st) == 0) {
        test_fail("unlinked file still visible!", 28);
        return;
    }
    rmdir(cast(*u8, "/vfs-box"), 8);
    serial.println("vfs.test: unlink+ENOENT OK", 26);

    serial.println("vfs.test: ALL PASS", 18);
    boot_selftest_done = 1;
}

// Set once the boot self-tests (FAT32 phase-6 + this VFS test) finish, so
// the userspace smoke thread waits for the bring-up to settle instead of
// racing the AHCI bind for cpus (which stretched boot past the verify
// window under smp 4). Pure tooling — production has no smoke thread.
let is i64 as boot_selftest_done with mut = 0;
// Boot readiness = the root filesystem is MOUNTED, not that the dev self-test
// finished. Gating the production boot on boot_selftest_done made init wait the
// full 12 s timeout whenever the self-test was slow or failed (e.g. a hello.txt
// size mismatch), even though the disk mounts in ~0.6 s. The self-test still
// runs in parallel on its own thread — it just no longer holds up /init.
fn boot_ready() as i64 {
    if (cast(i64, mount_head()) != 0) { return 1; }
    return 0;
}

// Maximum wait for a VFS mount. Budget includes fat32.mount_thread's
// own wait for storage (5 s) + the FS self-test matrix + the actual
// vfs.mount call. Uniprocessor completes the whole chain well under
// 10 s; 30 s is plenty while still failing fast on a real bug.
let is i64 as VFS_MOUNT_WAIT_NS = 30000000000;

// Thread entry — yields until mount_head is populated, then runs the
// self-test. Scheduler starts it after phase 2 fires fat32.mount_thread
// which in turn publishes the mount.
fn self_test_thread() as void {
    let is i64 as deadline = timer.current_time_ns() + VFS_MOUNT_WAIT_NS;
    while (cast(i64, mount_head()) == 0 && timer.current_time_ns() < deadline) {
        // sleep_for_ns instead of yield_cpu so QOS_NORMAL test threads
        // sharing this cpu (B in main.cst) get a chance to run while
        // the mount publishes. Yielding inside QOS_ACTIVE just re-picks
        // this same thread, starving lower bands.
        sched.sleep_for_ns(1000000);   // 1 ms
    }
    if (cast(i64, mount_head()) == 0) {
        test_fail("no mount within 30 s", 20);
        return;
    }
    self_test();
}
