// fat32.cst — the FAT32 file system as the VFS sees it: the FileSystemOps
// table whose adapters translate VFS contracts into the fat32_* layers, and
// the mount thread that finds the root device, mounts it and publishes it at
// "/".
//
// The layers below: fat32_vol.cst (the volume, the FAT, cluster chains),
// fat32_dir.cst (names, lookup, readdir), fat32_file.cst (file data) and
// fat32_ent.cst (creating, removing and renaming entries).

use "storage.cst" as storage;
use "ramvol.cst"  as ramvol;
use "cmdline.cst" as cmdline;
use "serial.cst"  as serial;
use "util.cst"    as util;
use "sched.cst"   as sched;
use "vfs.cst"     as vfs;
use "timer.cst"   as timer;
use "rtc.cst"     as rtc;
use "abi.cst"     as abi;
use "fat32_vol.cst" as fatvol;
use "fat32_dir.cst" as fatdir;
use "fat32_file.cst" as fatfile;
use "fat32_ent.cst" as fatent;
use "fat32_test.cst" as fat32_test;

// ============================================================
// VFS adapter functions — exposed to vfs.cst through a populated
// FileSystemOps-shaped vtable. priv is always a *Fat32Volume.
//
// The adapters translate VFS contracts into the fat32_* primitives:
//   - resolve/stat use path_lookup + path_split_parent so the parent
//     cluster is available for later write-path update_entry calls.
//   - read/write_at/truncate operate directly on (first_cluster, size)
//     so open() → read()/write() skips directory re-traversal.
//   - create uses file_create with an empty payload; update_entry
//     patches the dir slot written by create once the new data lands.
// ============================================================

// Preserve typed semantic errors; the remaining legacy mutation codes describe
// allocation or I/O failures, never lookup failures. Translate lookups where
// they occur so their -1/-4 codes cannot alias unrelated mutation failures.
fn _mutate_err(rc as i32) as i32 {
    if (rc == cast(i32, 0)) { return 0; }
    if (rc == vfs.VFS_ENOENT) { return vfs.VFS_ENOENT; }
    if (rc == vfs.VFS_ENOTDIR) { return vfs.VFS_ENOTDIR; }
    if (rc == vfs.VFS_EEXIST) { return vfs.VFS_EEXIST; }
    if (rc == vfs.VFS_EISDIR) { return vfs.VFS_EISDIR; }
    if (rc == vfs.VFS_ENOTEMPTY) { return vfs.VFS_ENOTEMPTY; }
    if (rc == vfs.VFS_EINVAL) { return vfs.VFS_EINVAL; }
    if (rc == vfs.VFS_ENOSPC) { return vfs.VFS_ENOSPC; }
    if (rc == vfs.VFS_ENOMEM) { return vfs.VFS_ENOMEM; }
    return vfs.VFS_EIO;
}

fn vfs_resolve(priv as *u8, path as *u8, path_len as i64,
               out_parent_cluster as *i64,
               out_first_cluster as *i64,
               out_size as *i64,
               out_attr as *i32,
               out_ent_cluster as *i64,
               out_ent_off as *i64) as i32 {
    let is *fatvol.Fat32Volume as v = cast(*fatvol.Fat32Volume, priv);
    if (cast(i64, v) == 0 || v.is_mounted == 0) { return vfs.VFS_EIO; }
    // Default: no patchable slot (root, or any path with no SFN entry).
    *out_ent_cluster = 0;
    *out_ent_off     = 0;

    // Special-case the root directory: parent is itself, first cluster
    // is root_cluster, no size, attr=DIRECTORY.
    if (path_len == 1 && path[0] == cast(u8, 47)) {
        *out_parent_cluster = v.root_cluster;
        *out_first_cluster  = v.root_cluster;
        *out_size           = 0;
        *out_attr           = fatdir.ATTR_DIRECTORY;
        return 0;
    }

    // Parent resolution: split off the leaf, look the parent up.
    let is i64 as leaf_off with mut = 0;
    let is i64 as leaf_len with mut = 0;
    let is i64 as parent_end with mut = 0;
    if (fatent.path_split_parent(path, path_len,
                          &leaf_off, &leaf_len, &parent_end) != 0) {
        return vfs.VFS_EINVAL;
    }

    let is i64 as parent_c with mut = v.root_cluster;
    let is i64 as psz with mut = 0;
    let is i32 as pattr with mut = 0;
    if (parent_end > 0) {
        let is i32 as rp = fatdir.path_lookup(v, path, parent_end,
                                       &parent_c, &psz, &pattr);
        if (rp != 0) { return fatdir._lookup_err(rp); }
        if ((pattr & fatdir.ATTR_DIRECTORY) == 0) { return vfs.VFS_ENOTDIR; }
    }

    let is *u8 as leaf_ptr = cast(*u8, cast(i64, path) + leaf_off);
    let is i64 as fc with mut = 0;
    let is i64 as fs with mut = 0;
    let is i32 as fa with mut = 0;
    let is i32 as rf = fatdir.dir_find(v, parent_c, leaf_ptr, leaf_len,
                                &fc, &fs, &fa);
    if (rf != 0) { return fatdir._lookup_err(rf); }
    *out_parent_cluster = parent_c;
    *out_first_cluster  = fc;
    *out_size           = fs;
    *out_attr           = fa;
    // dir_find stashed the matched SFN slot location — hand it back so the
    // open handle can update this exact entry later (see found_ent_*).
    *out_ent_cluster = fatdir.found_ent_cluster;
    *out_ent_off     = fatdir.found_ent_off;
    return 0;
}

fn vfs_stat(priv as *u8, path as *u8, path_len as i64,
            out as *vfs.VfsStat) as i32 {
    let is i64 as pc with mut = 0;
    let is i64 as fc with mut = 0;
    let is i64 as sz with mut = 0;
    let is i32 as at with mut = 0;
    let is i64 as ec with mut = 0;   // entry slot location — unused by stat
    let is i64 as eo with mut = 0;
    let is i32 as rc = vfs_resolve(priv, path, path_len,
                                   &pc, &fc, &sz, &at, &ec, &eo);
    if (rc != 0) { return rc; }
    out.size = sz;
    out.first_cluster = fc;
    out.attr = at;
    if ((at & fatdir.ATTR_DIRECTORY) != 0) { out.is_dir = 1; } else { out.is_dir = 0; }
    return 0;
}

// statx_fill: same as vfs_stat but also returns the mtime (Unix epoch s)
// in the caller's Statx. The DOS wdate/wtime come from dir_find's globals
// — the SFN buffer is read once during resolve, no extra disk hit.
//   Returns 0 on success, -1 if nothing mounted / resolve failed.
//   *out_mtime is set to 0 for the root directory (dir_find isn't run) or
//   for entries whose SFN still has wdate=wtime=0 (pre-RTC fixtures).
fn statx_fill(priv as *u8, path as *u8, path_len as i64,
              out as *abi.Statx) as i32 {
    let is i64 as pc with mut = 0;
    let is i64 as fc with mut = 0;
    let is i64 as sz with mut = 0;
    let is i32 as at with mut = 0;
    let is i64 as ec with mut = 0;
    let is i64 as eo with mut = 0;
    let is i32 as rc = vfs_resolve(priv, path, path_len,
                                   &pc, &fc, &sz, &at, &ec, &eo);
    if (rc != 0) { return rc; }
    out.size = sz;
    out.first_cluster = fc;
    out.attr = at;
    if ((at & fatdir.ATTR_DIRECTORY) != 0) { out.is_dir = 1; } else { out.is_dir = 0; }
    // The root '/' case: vfs_resolve returns early without calling dir_find,
    // so found_ent_wdate/wtime stay 0 — which is the honest "no mtime for
    // the mount root" answer (Linux does the same: stat / shows mtime 0).
    out.mtime = rtc.epoch_seconds(fatdir.found_ent_wdate, fatdir.found_ent_wtime);
    return 0;
}

// Offset-based read that pulls only the requested window — avoids
// file_read's copy-from-start model so seek + read stays O(n) in
// bytes requested, not file size.
fn vfs_read(priv as *u8, first_cluster as i64, size as i64,
            offset as i64, dst as *u8, n as i64, h as *i64) as i64 {
    let is *fatvol.Fat32Volume as v = cast(*fatvol.Fat32Volume, priv);
    if (cast(i64, v) == 0) { return 0 - 1; }
    if (offset >= size || n <= 0 || first_cluster < 2) { return 0; }

    if (fatvol.ensure_scratch() != 0) { return 0 - 2; }
    let is i64 as cbytes = v.cluster_size_bytes;
    let is i64 as cluster_idx with mut = offset / cbytes;
    let is i64 as in_off with mut = offset % cbytes;
    let is i64 as cluster with mut = fatvol.walk_to(v, first_cluster, cluster_idx, h, 0);
    if (cluster < 2) { return 0 - 3; }

    let is i64 as want with mut = n;
    if (offset + want > size) { want = size - offset; }
    let is *u8 as buf = cast(*u8, fatvol.clus_scratch_virt);
    let is i64 as copied with mut = 0;

    let is i64 as going with mut = 1;
    while (going == 1 && copied < want) {
        if (fatvol.cluster_read(v, cluster, buf) != 0) { return 0 - 4; }
        let is i64 as chunk with mut = cbytes - in_off;
        if (chunk > want - copied) { chunk = want - copied; }
        let is i64 as j with mut = 0;
        while (j < chunk) {
            dst[copied + j] = buf[in_off + j];
            j = j + 1;
        }
        copied = copied + chunk;
        in_off = 0;   // subsequent clusters start fresh
        if (copied < want) {
            let is i64 as nxt = fatvol.fat_read(v, cluster);
            if (nxt < 0) { return 0 - 5; }
            if (fatvol.cluster_is_eof(nxt) == 1) { going = 0; }
            else {
                cluster = nxt;
                cluster_idx = cluster_idx + 1;
            }
        }
    }
    fatvol.hint_set(h, first_cluster, cluster_idx, cluster);
    return copied;
}

fn vfs_write_at(priv as *u8, first_cluster as i64, size as i64,
                offset as i64, data as *u8, data_len as i64,
                out_first_cluster as *i64, h as *i64) as i64 {
    let is *fatvol.Fat32Volume as v = cast(*fatvol.Fat32Volume, priv);
    return fatfile.file_write_at(v, first_cluster, size, offset,
                         data, data_len, out_first_cluster, h);
}

fn vfs_truncate(priv as *u8, first_cluster as i64, old_size as i64,
                new_size as i64, out_first_cluster as *i64) as i32 {
    let is *fatvol.Fat32Volume as v = cast(*fatvol.Fat32Volume, priv);
    return fatfile.file_truncate(v, first_cluster, old_size, new_size,
                         out_first_cluster);
}

// Patch the first-cluster (hi/lo), size and write-time fields of the SFN slot
// at a KNOWN physical location (ent_cluster:ent_off, captured by dir_find at
// resolve time). O(1): one cluster read + one write, no directory scan,
// no first_cluster matching — so it is immune to the empty-file (fc==0)
// ambiguity that bit the old by-cluster scan when several entries shared
// first_cluster==0 (e.g. an O_TRUNC'd file alongside another empty one).
// ent_cluster < 2 means "no slot" (root / unresolved) → no-op success.
//
// The VFS calls this for every change to a file's contents — a write reaching
// the disk, a truncation — so this is where the modification time moves. It
// used to be set at creation only: a file rewritten later kept the time it
// was created at. The creation time (bytes 14..17) is left alone.
fn dir_update_entry_at(v as *fatvol.Fat32Volume, ent_cluster as i64, ent_off as i64,
                       new_first_cluster as i64, new_size as i64) as i32 {
    if (cast(i64, v) == 0) { return vfs.VFS_EINVAL; }
    if (ent_cluster < 2) { return 0; }
    if (fatvol.ensure_scratch() != 0) { return vfs.VFS_ENOMEM; }
    let is *u8 as buf = cast(*u8, fatvol.clus_scratch_virt);
    if (fatvol.cluster_read(v, ent_cluster, buf) != 0) { return vfs.VFS_EIO; }
    let is i64 as hi = (new_first_cluster >> 16) & 0xFFFF;
    let is i64 as lo = new_first_cluster & 0xFFFF;
    buf[ent_off + 20] = cast(u8, hi & 0xFF);
    buf[ent_off + 21] = cast(u8, (hi >> 8) & 0xFF);
    buf[ent_off + 26] = cast(u8, lo & 0xFF);
    buf[ent_off + 27] = cast(u8, (lo >> 8) & 0xFF);
    buf[ent_off + 28] = cast(u8, new_size & 0xFF);
    buf[ent_off + 29] = cast(u8, (new_size >> 8) & 0xFF);
    buf[ent_off + 30] = cast(u8, (new_size >> 16) & 0xFF);
    buf[ent_off + 31] = cast(u8, (new_size >> 24) & 0xFF);
    let is i64 as now_date with mut = 0;
    let is i64 as now_time with mut = 0;
    rtc.now_dos(&now_date, &now_time);
    buf[ent_off + 22] = cast(u8, now_time & 0xFF);
    buf[ent_off + 23] = cast(u8, (now_time >> 8) & 0xFF);
    buf[ent_off + 24] = cast(u8, now_date & 0xFF);
    buf[ent_off + 25] = cast(u8, (now_date >> 8) & 0xFF);
    if (fatvol.cluster_write(v, ent_cluster, buf) != 0) { return vfs.VFS_EIO; }
    return 0;
}

// update_entry adapter — the first two i64 params are the entry's stable
// slot location (ent_cluster, ent_off) captured at open via vfs_resolve,
// NOT (parent_cluster, old_first) as in the original by-cluster design.
fn vfs_update_entry(priv as *u8, ent_cluster as i64,
                    ent_off as i64, new_first as i64,
                    new_size as i64) as i32 {
    let is *fatvol.Fat32Volume as v = cast(*fatvol.Fat32Volume, priv);
    return dir_update_entry_at(v, ent_cluster, ent_off, new_first, new_size);
}

fn vfs_create(priv as *u8, path as *u8, path_len as i64) as i32 {
    let is *fatvol.Fat32Volume as v = cast(*fatvol.Fat32Volume, priv);
    return _mutate_err(fatent.file_create(v, path, path_len, cast(*u8, 0), cast(i64, 0)));
}

fn vfs_unlink(priv as *u8, path as *u8, path_len as i64) as i32 {
    let is *fatvol.Fat32Volume as v = cast(*fatvol.Fat32Volume, priv);
    return _mutate_err(fatent.file_unlink(v, path, path_len));
}

fn vfs_mkdir(priv as *u8, path as *u8, path_len as i64) as i32 {
    let is *fatvol.Fat32Volume as v = cast(*fatvol.Fat32Volume, priv);
    return _mutate_err(fatent.dir_create(v, path, path_len));
}

fn vfs_rmdir(priv as *u8, path as *u8, path_len as i64) as i32 {
    let is *fatvol.Fat32Volume as v = cast(*fatvol.Fat32Volume, priv);
    return _mutate_err(fatent.dir_remove(v, path, path_len));
}

fn vfs_rename(priv as *u8,
              src as *u8, src_len as i64,
              dst as *u8, dst_len as i64) as i32 {
    let is *fatvol.Fat32Volume as v = cast(*fatvol.Fat32Volume, priv);
    return fatent.path_rename(v, src, src_len, dst, dst_len);
}

fn vfs_readdir(priv as *u8, dir_cluster as i64, idx as i64,
               name_buf as *u8, name_cap as i64,
               out as *vfs.ReaddirOut) as i32 {
    let is *fatvol.Fat32Volume as v = cast(*fatvol.Fat32Volume, priv);
    // dir_readdir has its own -1/-2/-3 dialect; do not let those numbers
    // masquerade as unrelated VFS errors at the syscall boundary.
    let is i32 as rc = fatdir.dir_readdir(v, dir_cluster, idx, name_buf, name_cap, out);
    if (rc == 0) { return vfs.VFS_OK; }
    if (rc == cast(i32, 0 - 1)) { return vfs.VFS_ENOENT; }
    if (rc == cast(i32, 0 - 2)) { return vfs.VFS_EIO; }
    return vfs.VFS_EINVAL;
}

fn vfs_sync(priv as *u8) as i32 {
    let is *fatvol.Fat32Volume as v = cast(*fatvol.Fat32Volume, priv);
    if (cast(i64, v) == 0 || v.is_mounted == 0) { return cast(i32, 0 - 1); }
    fatvol.fsinfo_write(v);
    return storage.flush(v.dev);
}

// Populated once at startup; vfs.mount stores a pointer to this so
// every op dispatches through a predictable vtable.
let is vfs.FileSystemOps as ops_vtable;

fn vfs_ops_init() as void {
    ops_vtable.resolve      = fn_ptr(vfs_resolve);
    ops_vtable.stat         = fn_ptr(vfs_stat);
    ops_vtable.statx        = fn_ptr(statx_fill);
    ops_vtable.read         = fn_ptr(vfs_read);
    ops_vtable.write_at     = fn_ptr(vfs_write_at);
    ops_vtable.truncate     = fn_ptr(vfs_truncate);
    ops_vtable.update_entry = fn_ptr(vfs_update_entry);
    ops_vtable.create       = fn_ptr(vfs_create);
    ops_vtable.unlink       = fn_ptr(vfs_unlink);
    ops_vtable.mkdir        = fn_ptr(vfs_mkdir);
    ops_vtable.rmdir        = fn_ptr(vfs_rmdir);
    ops_vtable.rename       = fn_ptr(vfs_rename);
    ops_vtable.readdir      = fn_ptr(vfs_readdir);
    ops_vtable.sync         = fn_ptr(vfs_sync);
}

fn ops() as *vfs.FileSystemOps { return &ops_vtable; }

// ============================================================
// Mount thread — yields until a storage device appears in the
// registry, then tries to mount it as FAT32. Intended to be
// started after driver phase 2 has kicked off probing.
// ============================================================

// Maximum wall-clock wait for a block device to register before we
// give up. 5 seconds covers AHCI self-test (write + flush + read
// round-trip, each one IRQ-driven) on qemu-kvm + real hardware with
// slack; anything past that is a real binding failure, not a timing
// accident. Unlike a yield-count budget, this threshold is
// independent of scheduler slice length and CPU speed.
let is i64 as MOUNT_WAIT_NS = 5000000000;

fn mount_thread() as void {
    let is i64 as deadline = timer.current_time_ns() + MOUNT_WAIT_NS;

    // Which device backs "/" is a decision, not an accident. `root=` on the
    // kernel command line wins outright; otherwise storage.root_pick() ranks
    // the candidates by declared priority, so the live root beats a disk that
    // merely happens to be plugged in. The old code took storage.head() — the
    // most recently registered device — which is a race, not a policy.
    let is *u8 as want = cmdline.root_name();
    let is i64 as want_len = cmdline.root_name_len();

    let is *storage.StorageDevice as d with mut = cast(*storage.StorageDevice, 0);
    if (want_len > 0) { d = storage.find(want, want_len); }
    else              { d = storage.root_pick(); }

    while (cast(i64, d) == 0 && timer.current_time_ns() < deadline) {
        // sleep_for_ns instead of yield_cpu — see vfs.self_test_thread
        // for the rationale (avoid same-band starvation of A/B).
        sched.sleep_for_ns(1000000);   // 1 ms
        if (want_len > 0) { d = storage.find(want, want_len); }
        else              { d = storage.root_pick(); }
    }
    if (cast(i64, d) == 0) {
        // Say what was actually seen. "It waited and gave up" is not a
        // diagnosis; "there were 2 devices and none of them was ram0" is.
        if (want_len > 0) {
            serial.print("fat32: root=", 12);
            let is i64 as wi with mut = 0;
            while (wi < want_len) { serial.putc(cast(i64, want[wi])); wi = wi + 1; }
            serial.print(" not found after 5s (", 21);
        } else {
            serial.print("fat32: no root volume after 5s (", 32);
        }
        util.print_num(storage.count());
        serial.print(" storage devices, live root=", 28);
        util.print_num(ramvol.present());
        serial.println(")", 1);
        return;
    }
    let is *fatvol.Fat32Volume as v = fatvol.mount(d);
    if (cast(i64, v) == 0) { return; }

    // Say which volume the system is actually running on, and whether anything
    // written to it will survive a reboot. A live root is volatile by design;
    // that has to be stated, not discovered.
    // serial buffers per cpu and flushes on newline, so these separate calls
    // still reach the log as one unbroken line.
    serial.print("root: ", 6);
    let is i64 as ni with mut = 0;
    while (ni < 32 && d.name[ni] != cast(u8, 0)) {
        serial.putc(cast(i64, d.name[ni]));
        ni = ni + 1;
    }
    if (d.is_volatile == 1) {
        serial.println(" (live, volatile)", 17);
    } else {
        serial.println(" (disk, persistent)", 19);
    }

    // The phase-6 gauntlet WRITES to the volume it is handed: it creates
    // /data, renames over files, removes directories. On a production boot
    // that is scribbling on the user's root, so it is opt-in via the command
    // line rather than something every boot does.
    if (cmdline.selftest() != 0) {
        fat32_test.self_test_read(v);
    }

    // Publish the FAT32 volume through the VFS at "/". Done after the
    // FS self-tests so any failures there don't point the VFS at a
    // half-initialised volume. fat32's internal state isn't
    // SMP-safe across concurrent ops from VFS + our own self-tests,
    // so the tests must complete before we expose the volume.
    let is i32 as mr = vfs.mount(cast(*u8, "/"), cast(i64, 1),
                                  ops(), cast(*u8, v));
    if (mr != 0) {
        serial.print("fat32: vfs.mount failed rc=", 27);
        util.print_num(cast(i64, mr));
        serial.println("", 0);
    }
}
