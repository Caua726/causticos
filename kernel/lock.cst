// lock.cst — SMP-safe synchronisation primitives.
//
// Ticket spinlock: FIFO-fair, busy-wait, no heap. Two 32-bit halves
// packed into one 64-bit word so the atomic `lock xadd` on the
// acquire side updates both the ticket counter and lets us read the
// serving counter in the same instruction.
//
// Layout (low → high 64 bits):
//   [0..32]  now_serving — incremented by whoever holds the lock
//                          on release
//   [32..64] next_ticket — incremented atomically on acquire; the
//                          acquirer's ticket number is the old value
//
// The acquirer spins reading `now_serving` until it matches its
// own ticket. Each release publishes the next ticket by incrementing
// `now_serving`, which another spinner reads and proceeds.
//
// Fairness: FIFO in request order. Prevents starvation under
// contention — unlike a bare `xchg` "test-and-set" spinlock where
// the fastest cache line wins.
//
// Usage:
//   let is lock.TicketLock as my_lock;   // zero-initialised is fine
//   lock.acquire(&my_lock);
//   /* critical section */
//   lock.release(&my_lock);
//
// IRQ safety: acquire_irq / release_irq save+disable then restore
// the IF bit. Use these when the lock can be taken from both thread
// and IRQ context — otherwise a thread holding the lock can be
// preempted by an IRQ that tries to re-acquire and deadlock.

// ============================================================
// Types
// ============================================================

// Single 64-bit word; zero-init = unlocked state. Kept as i64 rather
// than a struct so `lock xadd` compiles to a single atomic op against
// the low half (our ticket increment) without field-offset gymnastics.
struct TicketLock {
    word as i64;
}

// ============================================================
// Atomic ops written in inline asm. Caustic doesn't expose atomic
// intrinsics; these are the minimum needed for a correct spinlock.
// ============================================================

// Atomic primitives forwarded to smp_asm.s. Output-pointer pattern
// so Caustic's spill-offset vagaries never leak into the asm.
fn fetch_add_ticket_into(p as *i64, out as *i64) as void {
    asm("call smp_fetch_add_ticket_into\n");
}

fn fetch_add_ticket(p as *i64) as i64 {
    let is i64 as v with mut = 0;
    fetch_add_ticket_into(p, &v);
    return v;
}

// Atomic add-and-return-previous. `atomic_add(p, 1)` / `atomic_add(p, -1)`
// are the refcount primitives (KObject sharing across aspaces). Output-
// pointer pattern, same as fetch_add_ticket_into, so Caustic's spill
// offsets never leak into the asm.
fn atomic_add_into(p as *i64, delta as i64, out as *i64) as void {
    asm("call smp_atomic_add_into\n");
}

fn atomic_add(p as *i64, delta as i64) as i64 {
    let is i64 as old with mut = 0;
    atomic_add_into(p, delta, &old);
    return old;
}

fn load_word(p as *i64) as i64 {
    return *p;
}

fn inc_serving(p as *i64) as void {
    asm("call smp_inc_serving\n");
}

// ============================================================
// Public API
// ============================================================

fn acquire(l as *TicketLock) as void {
    let is i64 as ticket_word = fetch_add_ticket(&l.word);
    // My ticket is the upper 32 bits of the value that was there
    // before my increment.
    let is i64 as my_ticket = (ticket_word >> 32) & 0xFFFFFFFF;
    while (1 == 1) {
        let is i64 as w = load_word(&l.word);
        if ((w & 0xFFFFFFFF) == my_ticket) { return; }
        asm(".byte 0xF3, 0x90\n");   // pause — polite spin
    }
}

fn release(l as *TicketLock) as void {
    inc_serving(&l.word);
}

// ============================================================
// IRQ-safe variants. Use these whenever the lock is reachable from
// an interrupt handler. Returns the pre-disable IF flag as a cookie
// the matching release_irq restores.
// ============================================================

fn save_cli_into(out as *i64) as void {
    asm("call smp_save_cli_into\n");
}

fn acquire_irq(l as *TicketLock) as i64 {
    let is i64 as flags with mut = 0;
    save_cli_into(&flags);
    acquire(l);
    return flags;
}

// Pass `flags` through rdi by positioning it as the first argument of
// a trivial wrapper. Caustic keeps rdi = arg0 live at entry so the
// direct `call smp_restore` gets the right value.
fn restore_flags(flags as i64) as void {
    asm("call smp_restore\n");
}

fn release_irq(l as *TicketLock, flags as i64) as void {
    release(l);
    restore_flags(flags);
}

// ============================================================
// Test-only: expose the current state so smoke tests can assert
// counters. Not called from hot paths.
// ============================================================

fn is_contended(l as *TicketLock) as i32 {
    let is i64 as w = load_word(&l.word);
    let is i64 as serving = w & 0xFFFFFFFF;
    let is i64 as next    = (w >> 32) & 0xFFFFFFFF;
    if (next - serving > 1) { return 1; }
    return 0;
}
