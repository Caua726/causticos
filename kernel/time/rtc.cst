// rtc.cst — the kernel's only job in the clock: read the CMOS/RTC (ports
// 0x70/0x71, privileged port I/O that ring-3 can't touch) and hand back the
// raw fields. It does NOT keep a wall clock and does NOT do calendar work
// (no weekday, no epoch) — that's userspace policy (the `date` app). The QEMU
// CMOS holds the host time, UTC by default.
use "port.cst" as port;

fn cmos_read(reg as i64) as i64 { port.outb(0x70, reg); return port.inb(0x71); }
fn bcd2bin(v as i64) as i64 { return (v & 0x0F) + ((v >> 4) * 10); }

// Read [year, month, day, hour, minute, second] into out[0..5]. Reads twice and
// retries until two reads agree, so we never latch a value caught mid-update.
fn rtc_read(out as *i64) as void {
    let is i64 as ps with mut = 0 - 1; let is i64 as pm with mut = 0 - 1; let is i64 as ph with mut = 0 - 1;
    let is i64 as pd with mut = 0 - 1; let is i64 as pmo with mut = 0 - 1; let is i64 as py with mut = 0 - 1;
    let is i64 as tries with mut = 0;
    while (tries < 100) {
        while ((cmos_read(0x0A) & 0x80) != 0) { }                 // wait: not update-in-progress
        let is i64 as sec with mut = cmos_read(0x00); let is i64 as min with mut = cmos_read(0x02); let is i64 as hr with mut = cmos_read(0x04);
        let is i64 as day with mut = cmos_read(0x07); let is i64 as mon with mut = cmos_read(0x08); let is i64 as yr with mut = cmos_read(0x09);
        let is i64 as regB = cmos_read(0x0B);
        if ((regB & 0x04) == 0) {                                  // BCD → binary
            sec = bcd2bin(sec); min = bcd2bin(min);
            let is i64 as pmflag = hr & 0x80; hr = bcd2bin(hr & 0x7F) | pmflag;
            day = bcd2bin(day); mon = bcd2bin(mon); yr = bcd2bin(yr);
        }
        if ((regB & 0x02) == 0 && (hr & 0x80) != 0) { hr = ((hr & 0x7F) + 12) - (((hr & 0x7F) + 12) / 24) * 24; }   // 12h → 24h
        if (sec == ps && min == pm && hr == ph && day == pd && mon == pmo && yr == py) {
            let is i64 as fy with mut = yr; if (fy < 70) { fy = fy + 2000; } else { fy = fy + 1900; }
            out[0] = fy; out[1] = mon; out[2] = day; out[3] = hr; out[4] = min; out[5] = sec;
            return;
        }
        ps = sec; pm = min; ph = hr; pd = day; pmo = mon; py = yr; tries = tries + 1;
    }
    out[0] = 1970; out[1] = 1; out[2] = 1; out[3] = 0; out[4] = 0; out[5] = 0;
}
