# PS/2 mouse driver — aux port of the i8042, routed through the platform
# bus. IRQ line 12 on the IOAPIC; framework allocates the driver vector
# and wires the redirection entry.

driver "mouse" {
    match {
        bus: platform
        name: mouse
    }
    capabilities {
        irq: auto
    }
    device {
        class: mouse
        acquire: mouse.mouse_acquire
    }
    lifecycle {
        on_bind: mouse.mouse_bind
        on_irq: mouse.handler
    }
}
