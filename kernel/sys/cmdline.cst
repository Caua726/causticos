// cmdline.cst — the kernel command line, as handed over by the bootloader.
//
// Boot behaviour that used to be a compile-time `let` is decided here instead.
// That distinction matters more than it looks: with a compile-time switch, the
// kernel that runs the regression suite is a DIFFERENT BINARY from the kernel
// that ships, so the suite never tested what anyone actually boots. One binary,
// two behaviours, selected by a word in limine.conf.
//
// Recognised today:
//   smoke              run the in-kernel smoke suite + VFS self-test instead of
//                      launching /init
//   root=<name>        mount that named storage device at "/" (e.g. ram0,
//                      ahci-p0). Without it, storage.root_pick() decides.
//   selftest           run the FAT32 read/write gauntlet against the root
//                      volume. It WRITES, so it is opt-in: on a normal boot
//                      that would be scribbling on the user's root.
//
// The parser is deliberately tiny — space-separated words, `key=value` split on
// the first '='. There is no quoting and no escaping, because nothing here needs
// them, and a boot-time parser is a bad place to grow a grammar.

use "limine.cst" as limine;
use "serial.cst" as serial;

let is i64 as MAX_VAL = 64;

let is i64 as parsed with mut = 0;
let is [64]u8 as root_val with mut;
let is i64 as root_len with mut = 0;
let is i64 as flag_smoke with mut = 0;
let is i64 as flag_selftest with mut = 0;

fn _streq(p as *u8, off as i64, n as i64, lit as *u8, lit_len as i64) as i64 {
    if (n != lit_len) { return 0; }
    let is i64 as i with mut = 0;
    while (i < n) {
        if (p[off + i] != lit[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// Parse once, on first use. Nothing here allocates: the only value we keep is a
// device name, and 64 bytes is more than any of them.
fn init() as void {
    if (parsed != 0) { return; }
    parsed = 1;
    root_len = 0;
    flag_smoke = 0;
    flag_selftest = 0;

    let is *u8 as cl = limine.get_cmdline();
    if (cast(i64, cl) == 0) { return; }

    let is i64 as i with mut = 0;
    while (i < 512 && cl[i] != cast(u8, 0)) {
        // Skip separators.
        while (i < 512 && (cl[i] == cast(u8, 32) || cl[i] == cast(u8, 9))) { i = i + 1; }
        if (cl[i] == cast(u8, 0)) { i = 512; }
        else {
            let is i64 as start = i;
            while (i < 512 && cl[i] != cast(u8, 0)
                   && cl[i] != cast(u8, 32) && cl[i] != cast(u8, 9)) {
                i = i + 1;
            }
            let is i64 as tok_len = i - start;

            // key=value?
            let is i64 as eq with mut = 0 - 1;
            let is i64 as k with mut = 0;
            while (k < tok_len) {
                if (cl[start + k] == cast(u8, 61)) { eq = k; k = tok_len; }
                else { k = k + 1; }
            }

            if (eq < 0) {
                if (_streq(cl, start, tok_len, cast(*u8, "smoke"), 5) == 1) {
                    flag_smoke = 1;
                } else if (_streq(cl, start, tok_len, cast(*u8, "selftest"), 8) == 1) {
                    flag_selftest = 1;
                }
            } else {
                if (_streq(cl, start, eq, cast(*u8, "root"), 4) == 1) {
                    let is i64 as vlen with mut = tok_len - eq - 1;
                    if (vlen > MAX_VAL - 1) { vlen = MAX_VAL - 1; }
                    let is i64 as j with mut = 0;
                    while (j < vlen) {
                        root_val[j] = cl[start + eq + 1 + j];
                        j = j + 1;
                    }
                    root_val[vlen] = cast(u8, 0);
                    root_len = vlen;
                }
            }
        }
    }

    serial.print("cmdline: ", 9);
    let is i64 as c with mut = 0;
    while (c < 256 && cl[c] != cast(u8, 0)) {
        serial.putc(cast(i64, cl[c]));
        c = c + 1;
    }
    serial.println("", 0);
}

fn smoke() as i64 {
    init();
    return flag_smoke;
}

fn selftest() as i64 {
    init();
    return flag_selftest;
}

// The requested root device name, or null when the command line named none.
fn root_name() as *u8 {
    init();
    if (root_len == 0) { return cast(*u8, 0); }
    return cast(*u8, &root_val[0]);
}

fn root_name_len() as i64 {
    init();
    return root_len;
}
