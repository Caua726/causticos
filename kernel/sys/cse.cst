// cse.cst — loading a Caustic Standard Executable into an address space.
//
// The format itself, the segment-to-frame work, the shared-library resolution
// and the image cache all live in imgcache.cst. What is left here is the step
// above them: take an image, map it into a fresh aspace, build the System V
// initial stack, and report the entry point.
//
// The split is not cosmetic. Mapping an image is a CACHED operation — the
// frames a program's text lives in are built once and shared by every process
// running it — while building a stack is per-process by definition. Keeping
// them in one file is what made the executable the odd one out for so long:
// libraries went through the cache and programs were copied.
//
// The two public entry points differ only in argv: load_cse gives the child a
// single argv[0], load_cse_argv gives it the vector its spawner passed. Both
// mirror elf.load_elf's signature so either loader drops into proc_spawn.

use "serial.cst" as serial;
use "util.cst" as util;
use "vma.cst" as vma;
use "elf.cst" as elf;
use "vfs.cst" as vfs;
use "imgcache.cst" as imgcache;

// Map a cached image into `a` and report its entry point. The aspace takes a
// reference to the image (released in aspace_destroy, via the hook main wires
// up) — the frames it now maps belong to the cache, not to it.
fn attach_image(a as *vma.Aspace, slot as i64, out_entry as *i64) as i32 {
    if (slot < 0) { return cast(i32, 0 - 2); }
    let is i32 as rc = imgcache.map(slot, a);
    if (rc != 0) {
        imgcache.release(slot);
        return rc;
    }
    a.img_ref = slot + 1;              // +1 so a zeroed Aspace means "none"
    *out_entry = imgcache.entry_point(slot);
    return 0;
}

// Load an image already held as bytes (a boot-embedded smoke) and build the
// child's initial stack with a single argv[0] = the program name.
fn load_cse(a as *vma.Aspace, buf as *u8, size as i64,
            argv0 as *u8, argv0_len as i64,
            out_entry as *i64, out_user_rsp as *i64) as i32 {
    let is i64 as slot = imgcache.acquire_bytes(buf, size);
    if (slot < 0) { return cast(i32, 0 - 2); }
    let is i64 as entry with mut = 0;
    let is i32 as rc = attach_image(a, slot, &entry);
    if (rc != 0) { return rc; }
    let is i32 as ssrc = elf.build_initial_stack_named(a, entry, argv0, argv0_len, out_user_rsp);
    if (ssrc != 0) { return ssrc; }
    *out_entry = entry;
    return 0;
}

// Same, with a full argv (argc >= 1). The spawner hands the child its argument
// vector; the kernel only lays the bytes on the stack, never resolves them
// (docs/architecture.md §2 — argv is data, authority is fds).
fn load_cse_argv(a as *vma.Aspace, buf as *u8, size as i64,
                 argv_ptrs as *i64, argv_lens as *i64, argc as i64,
                 out_entry as *i64, out_user_rsp as *i64) as i32 {
    let is i64 as slot = imgcache.acquire_bytes(buf, size);
    if (slot < 0) { return cast(i32, 0 - 2); }
    let is i64 as entry with mut = 0;
    let is i32 as rc = attach_image(a, slot, &entry);
    if (rc != 0) { return rc; }
    let is i32 as ssrc = elf.build_initial_stack(a, entry, argv_ptrs, argv_lens, argc, out_user_rsp);
    if (ssrc != 0) { return ssrc; }
    *out_entry = entry;
    return 0;
}

// Load straight from an open file — no buffer anywhere in the caller, and the
// image is shared with every other process running the same file. This is the
// path SYS_SPAWN uses once it names a source instead of carrying bytes.
fn load_cse_file(a as *vma.Aspace, f as *vfs.VfsFile,
                 argv_ptrs as *i64, argv_lens as *i64, argc as i64,
                 out_entry as *i64, out_user_rsp as *i64) as i32 {
    let is i64 as slot = imgcache.acquire_file(f);
    if (slot < 0) { return cast(i32, 0 - 2); }
    let is i64 as entry with mut = 0;
    let is i32 as rc = attach_image(a, slot, &entry);
    if (rc != 0) { return rc; }
    let is i32 as ssrc with mut = 0;
    if (argc > 0) {
        ssrc = elf.build_initial_stack(a, entry, argv_ptrs, argv_lens, argc, out_user_rsp);
    } else {
        ssrc = elf.build_initial_stack_named(a, entry, cast(*u8, "child"), 5, out_user_rsp);
    }
    if (ssrc != 0) { return ssrc; }
    *out_entry = entry;
    return 0;
}
