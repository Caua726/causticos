// cse.cst — loader for the Caustic Standard Executable (CSE / "CST"), v2.
//
// CSE is causticos' own executable format. Static only: no relocation, no
// dynamic linking — the loader maps segments and jumps. All little-endian,
// x86_64.
//
// v2 layout (the format the toolchain emits today; v1 was a flat single
// image and is gone):
//
//   [ header 32B ] [ segment table: seg_count * 24B ] [ segment bytes ]
//   [ optional NUL-terminated version string ]
//
//   Header (32B @0):
//     0x00  magic           "CST_"
//     0x04  version  u16     = 2
//     0x06  arch     u8      = 1 (x86_64)
//     0x07  flags    u8      = 0
//     0x08  entry_point u64  absolute vaddr to jump to
//     0x10  base_addr   u64  0x400000 (informative; segments carry abs vaddrs)
//     0x18  seg_count   u32
//     0x1C  app_version_off u32  offset of NUL-term version string (0 = none)
//
//   Segment (24B, from @0x20):
//     +0x00  vaddr     u64   (page-aligned)
//     +0x08  file_off  u32   offset in the file (0 if pure bss)
//     +0x0C  file_size u32   bytes to copy
//     +0x10  mem_size  u32   bytes in memory; > file_size => zero-fill (bss)
//     +0x14  perms     u32   bit0=R, bit1=W, bit2=X
//
// Load model: each segment is mapped anonymously (file_off is NOT congruent
// to vaddr mod page, so we can't flat-map) and its file bytes copied in;
// the bss tail (mem_size - file_size) is left zeroed (mmap_anon zeroes).
// Pages get the segment's own perms. The linker page-aligns each segment's
// vaddr and keeps .text alone on its pages, so per-segment mapping never
// double-maps a page for the binaries it produces. (If a future binary
// packs two segments into one page, the second mmap would overlap and we
// fail loudly — to be handled with perm-OR if it ever happens.)
//
// Container: a pure .cse is the CST image at offset 0; a polyglot .cse.exe
// (MZ) carries it behind a "CST*" mini-header at 0x40. causticos-target
// binaries are pure .cse; we handle both.
//
// Reuses elf.cst for the byte readers, the page-copy, and the System V
// initial-stack builder — the entry ABI is identical, only the container
// differs.

use "serial.cst" as serial;
use "util.cst" as util;
use "vma.cst" as vma;
use "elf.cst" as elf;

let is i64 as CSE_VERSION = 2;
let is i64 as CSE_MAX_SEGS = 16;

// Header field offsets.
let is i64 as H_MAGIC      = 0x00;
let is i64 as H_VERSION    = 0x04;
let is i64 as H_ARCH       = 0x06;
let is i64 as H_FLAGS      = 0x07;   // v3 flags byte: bit0 = dynamic stack growth
let is i64 as H_ENTRY      = 0x08;
let is i64 as H_SEGCOUNT   = 0x18;
let is i64 as H_STACKSIZE  = 0x2C;   // v3 only: user-stack bytes the program declares
let is i64 as H_SIZE       = 0x20;

// Segment field offsets (within a 24-byte entry).
let is i64 as S_VADDR = 0x00;
let is i64 as S_FOFF  = 0x08;
let is i64 as S_FSZ   = 0x0C;
let is i64 as S_MSZ   = 0x10;
let is i64 as S_PERMS = 0x14;
let is i64 as S_SIZE  = 24;

// perms bits.
let is i64 as PERM_R = 1;
let is i64 as PERM_W = 2;
let is i64 as PERM_X = 4;

// Polyglot mini-header ("CST*") at 0x40.
let is i64 as MINI_OFF        = 0x40;
let is i64 as MINI_OFF_BODY   = 0x48;     // u64: file offset of CST image
let is i64 as MINI_OFF_BODYSZ = 0x50;     // u64: size of CST image

fn page_align_up(x as i64) as i64 {
    return (x + 0xFFF) & (cast(i64, 0 - 1) - 0xFFF);
}

fn page_align_down(x as i64) as i64 {
    return x & (cast(i64, 0 - 1) - 0xFFF);
}

// CSE perms (R=1,W=2,X=4) -> vma protection bits. Read is implied by
// PROT_USER. No X bit => set NX. W bit => writable.
fn perms_to_prot(perms as i64) as i64 {
    let is i64 as prot with mut = vma.PROT_USER;
    if ((perms & PERM_W) != 0) { prot = prot | vma.PROT_WRITE; }
    if ((perms & PERM_X) == 0) { prot = prot | vma.PROT_NX; }
    return prot;
}

// ============================================================
// Locate the CST image inside the container -> (out_off, out_size).
// ============================================================

fn locate_cst(buf as *u8, size as i64, out_off as *i64, out_size as *i64) as i32 {
    if (size < H_SIZE) { return cast(i32, 0 - 1); }

    // Pure: magic "CST_" at offset 0.
    if (cast(i64, buf[0]) == 0x43 && cast(i64, buf[1]) == 0x53
        && cast(i64, buf[2]) == 0x54 && cast(i64, buf[3]) == 0x5F) {
        *out_off = 0;
        *out_size = size;
        return 0;
    }

    // Polyglot: "MZ" -> read the "CST*" mini-header at 0x40.
    if (cast(i64, buf[0]) == 0x4D && cast(i64, buf[1]) == 0x5A) {
        if (size < MINI_OFF + 0x20) { return cast(i32, 0 - 2); }
        if (cast(i64, buf[MINI_OFF + 0]) != 0x43 || cast(i64, buf[MINI_OFF + 1]) != 0x53
            || cast(i64, buf[MINI_OFF + 2]) != 0x54 || cast(i64, buf[MINI_OFF + 3]) != 0x2A) {
            return cast(i32, 0 - 3);
        }
        let is i64 as body_off = elf.read_u64_le(buf, MINI_OFF_BODY);
        let is i64 as body_sz with mut = elf.read_u64_le(buf, MINI_OFF_BODYSZ);
        if (body_off < 0) { return cast(i32, 0 - 4); }
        if (body_sz < H_SIZE) { body_sz = size - body_off; }   // fallback if size absent
        if (body_off + body_sz > size) { return cast(i32, 0 - 5); }
        *out_off = body_off;
        *out_size = body_sz;
        return 0;
    }

    return cast(i32, 0 - 6);
}

// ============================================================
// Top-level entry. buf/size = container bytes (pure .cse or polyglot).
// On success: *out_entry = entry_point, *out_user_rsp = stack pointer.
// Signature mirrors elf.load_elf for drop-in use.
// ============================================================

// Load the CSE image's segments into the aspace and report its entry point —
// no stack. The two public loaders (load_cse / load_cse_argv) add the System V
// initial stack on top, differing only in argv.
fn load_cse_image(a as *vma.Aspace, buf as *u8, size as i64,
                  out_entry as *i64) as i32 {
    let is i64 as cst_off with mut = 0;
    let is i64 as cst_size with mut = 0;
    let is i32 as lrc = locate_cst(buf, size, &cst_off, &cst_size);
    if (lrc != 0) {
        serial.print("cse: locate rc=", 15);
        util.print_num(cast(i64, lrc));
        serial.println("", 0);
        return lrc;
    }

    let is *u8 as img = cast(*u8, &buf[cst_off]);
    if (cast(i64, img[0]) != 0x43 || cast(i64, img[1]) != 0x53
        || cast(i64, img[2]) != 0x54 || cast(i64, img[3]) != 0x5F) {
        return cast(i32, 0 - 7);
    }
    let is i64 as cse_ver = elf.read_u16_le(img, H_VERSION);
    // v2 = compact 32-byte header; v3 = 48-byte header (adds import-table fields
    // the kernel ignores — it loads static segments, not dynamic imports). The
    // toolchain emits v3 for every .cse; the hand-built smokes use v2.
    if (cse_ver != 2 && cse_ver != 3) {
        serial.print("cse: bad version ", 17);
        util.print_num(cse_ver);
        serial.println("", 0);
        return cast(i32, 0 - 8);
    }
    let is i64 as hsize with mut = H_SIZE;      // v2 header = 0x20
    if (cse_ver == 3) { hsize = 0x30; }         // v3 header = 0x30 (32 + 16 import-field bytes)
    if (cast(i64, img[H_ARCH]) != 1) { return cast(i32, 0 - 9); }

    // v3 declares its worst-case user-stack at 0x2C (computed by the toolchain
    // from the call graph, or set with --stack-size for recursive programs). The
    // initial stack is eager-committed to exactly this — no OS default. 0 (v2 /
    // undeclared hand-built images) leaves a.stack_size 0 → elf's legacy default.
    if (cse_ver == 3) {
        let is i64 as decl_stack = elf.read_u32_le(img, H_STACKSIZE);
        if (decl_stack > 0) { a.stack_size = decl_stack; }
        // Header flags byte (0x07). bit0 = dynamic stack growth: stack_size is
        // the reserve ceiling, the loader commits only an initial window, and
        // the program's prologue probes grow it via SYS_COMMIT. Strict (0) =
        // eager-commit stack_size in full, the legacy wall.
        let is i64 as hflags = cast(i64, img[H_FLAGS]);
        if ((hflags & 1) != 0) { a.stack_dynamic = 1; }
    }

    let is i64 as entry = elf.read_u64_le(img, H_ENTRY);
    let is i64 as nseg  = elf.read_u32_le(img, H_SEGCOUNT);
    if (entry == 0) { return cast(i32, 0 - 10); }
    if (nseg <= 0 || nseg > CSE_MAX_SEGS) { return cast(i32, 0 - 11); }
    if (hsize + nseg * S_SIZE > cst_size) { return cast(i32, 0 - 12); }

    // Map each segment and copy its file bytes.
    let is i64 as i with mut = 0;
    while (i < nseg) {
        let is i64 as e     = hsize + i * S_SIZE;
        let is i64 as vaddr = elf.read_u64_le(img, e + S_VADDR);
        let is i64 as foff  = elf.read_u32_le(img, e + S_FOFF);
        let is i64 as fsz   = elf.read_u32_le(img, e + S_FSZ);
        let is i64 as msz   = elf.read_u32_le(img, e + S_MSZ);
        let is i64 as perms = elf.read_u32_le(img, e + S_PERMS);

        if (msz < fsz) { return cast(i32, 0 - 13); }
        if (fsz > 0 && foff + fsz > cst_size) { return cast(i32, 0 - 14); }

        let is i64 as p0  = page_align_down(vaddr);
        let is i64 as end = page_align_up(vaddr + msz);
        if (end > p0) {
            let is i64 as prot = perms_to_prot(perms);
            let is i64 as got = vma.mmap_anon(a, p0, end - p0, prot, vma.VMA_FIXED);
            if (got != p0) {
                serial.print("cse: seg map fail i=", 20);
                util.print_num(i);
                serial.println("", 0);
                return cast(i32, 0 - 15);
            }
        }
        if (fsz > 0) {
            // copy goes through the physical pages, so a R-X/R-only
            // segment's protection doesn't block this kernel-side write.
            let is i32 as crc = elf.copy_segment_into_aspace(a, vaddr, buf,
                                                             cst_off + foff, fsz, fsz);
            if (crc != 0) { return cast(i32, 0 - 16); }
        }
        i = i + 1;
    }

    *out_entry = entry;
    return 0;
}

// Load a CSE and build its initial stack with a single argv[0] = the program
// name. Drop-in for the existing smokes / proc_spawn (no real argv).
fn load_cse(a as *vma.Aspace, buf as *u8, size as i64,
            argv0 as *u8, argv0_len as i64,
            out_entry as *i64, out_user_rsp as *i64) as i32 {
    let is i64 as entry with mut = 0;
    let is i32 as rc = load_cse_image(a, buf, size, &entry);
    if (rc != 0) { return rc; }
    let is i32 as ssrc = elf.build_initial_stack_named(a, entry, argv0, argv0_len, out_user_rsp);
    if (ssrc != 0) { return ssrc; }
    *out_entry = entry;
    return 0;
}

// Load a CSE and build its initial stack with a full argv (argc >= 1). Used by
// SYS_SPAWN's argv path (proc_spawn_argv): the spawner hands the child its
// argument vector; the kernel only lays the bytes on the stack, never resolves
// them (docs/architecture.md §2 — argv is data, authority is fds).
fn load_cse_argv(a as *vma.Aspace, buf as *u8, size as i64,
                 argv_ptrs as *i64, argv_lens as *i64, argc as i64,
                 out_entry as *i64, out_user_rsp as *i64) as i32 {
    let is i64 as entry with mut = 0;
    let is i32 as rc = load_cse_image(a, buf, size, &entry);
    if (rc != 0) { return rc; }
    let is i32 as ssrc = elf.build_initial_stack(a, entry, argv_ptrs, argv_lens, argc, out_user_rsp);
    if (ssrc != 0) { return ssrc; }
    *out_entry = entry;
    return 0;
}
