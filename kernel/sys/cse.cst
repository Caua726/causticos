// cse.cst — loader for the Caustic Standard Executable (CSE / "CST"), v2.
//
// CSE is causticos' own executable format. Static only: no relocation, no
// dynamic linking — the loader maps segments and jumps. All little-endian,
// x86_64.
//
// v2 layout (the format the toolchain emits today; v1 was a flat single
// image and is gone):
//
//   [ header 32B ] [ segment table: seg_count * 24B ] [ segment bytes ]
//   [ optional NUL-terminated version string ]
//
//   Header (32B @0):
//     0x00  magic           "CST_"
//     0x04  version  u16     = 2
//     0x06  arch     u8      = 1 (x86_64)
//     0x07  flags    u8      = 0
//     0x08  entry_point u64  absolute vaddr to jump to
//     0x10  base_addr   u64  0x400000 (informative; segments carry abs vaddrs)
//     0x18  seg_count   u32
//     0x1C  app_version_off u32  offset of NUL-term version string (0 = none)
//
//   Segment (24B, from @0x20):
//     +0x00  vaddr     u64   (page-aligned)
//     +0x08  file_off  u32   offset in the file (0 if pure bss)
//     +0x0C  file_size u32   bytes to copy
//     +0x10  mem_size  u32   bytes in memory; > file_size => zero-fill (bss)
//     +0x14  perms     u32   bit0=R, bit1=W, bit2=X
//
// Load model: each segment is mapped anonymously (file_off is NOT congruent
// to vaddr mod page, so we can't flat-map) and its file bytes copied in;
// the bss tail (mem_size - file_size) is left zeroed (mmap_anon zeroes).
// Pages get the segment's own perms. The linker page-aligns each segment's
// vaddr and keeps .text alone on its pages, so per-segment mapping never
// double-maps a page for the binaries it produces. (If a future binary
// packs two segments into one page, the second mmap would overlap and we
// fail loudly — to be handled with perm-OR if it ever happens.)
//
// Container: a pure .cse is the CST image at offset 0; a polyglot .cse.exe
// (MZ) carries it behind a "CST*" mini-header at 0x40. causticos-target
// binaries are pure .cse; we handle both.
//
// Reuses elf.cst for the byte readers, the page-copy, and the System V
// initial-stack builder — the entry ABI is identical, only the container
// differs.

use "serial.cst" as serial;
use "util.cst" as util;
use "vma.cst" as vma;
use "elf.cst" as elf;
use "vfs.cst" as vfs;
use "heap.cst" as heap;
use "pmm.cst" as pmm;
use "vmm.cst" as vmm;
use "abi.cst" as abi;

let is i64 as CSE_VERSION = 2;
let is i64 as CSE_MAX_SEGS = 16;

// Header field offsets.
let is i64 as H_MAGIC      = 0x00;
let is i64 as H_VERSION    = 0x04;
let is i64 as H_ARCH       = 0x06;
let is i64 as H_FLAGS      = 0x07;   // v3 flags byte: bit0 = dynamic stack growth
let is i64 as H_ENTRY      = 0x08;
let is i64 as H_SEGCOUNT   = 0x18;
let is i64 as H_IMPORT_OFF   = 0x20; // v3.2: import-table file offset (0 = none)
let is i64 as H_IMPORT_COUNT = 0x28; // v3.2: number of imports
let is i64 as H_STACKSIZE  = 0x2C;   // v3 only: user-stack bytes the program declares
let is i64 as H_SIZE       = 0x20;

// Segment field offsets (within a 24-byte entry).
let is i64 as S_VADDR = 0x00;
let is i64 as S_FOFF  = 0x08;
let is i64 as S_FSZ   = 0x0C;
let is i64 as S_MSZ   = 0x10;
let is i64 as S_PERMS = 0x14;
let is i64 as S_SIZE  = 24;

// perms bits.
let is i64 as PERM_R = 1;
let is i64 as PERM_W = 2;
let is i64 as PERM_X = 4;

// Polyglot mini-header ("CST*") at 0x40, written by caustic-ld's
// write_cse_combine_ape. It sits inside the shell-quoted region of the APE
// header, so v2 stores both numbers as 12-digit zero-padded ASCII decimal:
// the v1 raw-u64 encoding could place a 0x27 (') there, close the quote early
// and make /bin/sh execute the binary payload as script.
//   0x40 4  "CST*"   0x44 2 version   0x46 2 reserved
//   0x48 12 body offset (ASCII)       0x54 12 body size (ASCII)
// Arch codes in the CST_ header at 0x06, matching src/codegen/target.cst's
// ARCH_* constants. CSE_ARCH_NATIVE is the one this kernel build can execute;
// __target_is_aarch64 is the compiler's own parse-time target literal, so the
// kernel always compares against the machine it was compiled for.
// CST_ v4 multi-arch container (see cse_writer.cst:write_cse_fat).
//   0x06 1 image_count   0x08 4 index_off
//   index entry, 8 bytes: +0x00 arch, +0x04 image_off
let is i64 as FAT_COUNT      = 0x06;
let is i64 as FAT_INDEX_OFF  = 0x08;
let is i64 as FAT_ENTRY      = 8;
let is i64 as FAT_MAX        = 8;

let is i64 as CSE_ARCH_X86_64  = 1;
let is i64 as CSE_ARCH_AARCH64 = 2;
let is i64 as CSE_ARCH_NATIVE  = 1 * __target_is_x86_64 + 2 * __target_is_aarch64;

// ============================================================
// Shared libraries (.csl) — the dynamic half.
//
// A v3.2 image imports symbols instead of bundling them. Its import table says
// which libraries it needs, and for each symbol which of them exports it:
//
//   u32 import_count
//   u32 lib_count
//   lib_count * lib_name          (NUL-terminated, e.g. "libcaustic.csl")
//   import_count * { u32 rtype, u32 lib_idx, u64 site_vaddr, sym_name }
//
// The loader opens /lib/<name> for each, maps its segments into the child, and
// patches each site with the address the library exports the symbol at.
//
// The patch is one rule for both relocation kinds, and it is not a
// simplification: caustic-ld resolves these sites against address ZERO, so a
// PC32 site already holds `0 - (site+4) + addend` and a 64-bit site already
// holds the addend. Adding S is therefore exactly right in both cases, with no
// per-type arithmetic to get wrong.
//
// CSL_ v2 header (44 bytes), as written by cse_writer.cst:cse_emit_csl_image:
//   0x00 4 "CSL_"  0x04 2 version=2  0x06 1 arch  0x07 1 flags
//   0x08 8 base_addr  0x10 4 seg_count  0x14 4 export_count  0x18 8 export_off
//   0x20 8 kimport_off  0x28 4 kimport_count
//   then seg_count * 24 (vaddr, file_off, file_size, mem_size, perms),
//   then the packed segment bytes, then export_count * 12 (name_off u32,
//   vaddr u64) at export_off with an absolute-offset string blob.
// ============================================================
let is i64 as CSL_HDR_SIZE   = 44;
let is i64 as CSL_VERSION     = 2;
let is i64 as CSL_ARCH        = 0x06;
let is i64 as CSL_SEGCOUNT    = 0x10;
let is i64 as CSL_EXPCOUNT    = 0x14;
let is i64 as CSL_EXPOFF      = 0x18;
let is i64 as CSL_EXP_ENTRY   = 12;
let is i64 as CSL_MAX_SEGS    = 16;

// Relocation types, from the x86_64 psABI. Only the two the linker emits for
// an undefined call or data reference.
let is i64 as R_X86_64_64    = 1;
let is i64 as R_X86_64_PC32  = 2;
let is i64 as R_X86_64_PLT32 = 4;

// Libraries stay resident once read: a shell spawning forty programs would
// otherwise read the same file forty times off the volume. The cache is keyed
// by name and never evicted — a .csl is small, there are a handful of them, and
// they are exactly what every program needs.
//
// This is also where the RAM win will come from: the image is read once, so the
// frames behind it can be mapped into several address spaces rather than
// copied. Today each aspace gets its own copy; the cache is the part that has
// to exist first.
let is i64 as CSL_CACHE_MAX  = 8;
let is i64 as CSL_NAME_MAX   = 32;
let is [8]i64 as _csl_buf with mut;
let is [8]i64 as _csl_size with mut;
let is [256]u8 as _csl_name with mut;
let is i64 as _csl_count with mut = 0;

let is i64 as MINI_OFF        = 0x40;
let is i64 as MINI_OFF_VER    = 0x44;     // u16: mini-header version
let is i64 as MINI_OFF_BODY   = 0x48;     // 12 ASCII digits: file offset of CST image
let is i64 as MINI_OFF_BODYSZ = 0x54;     // 12 ASCII digits: size of CST image
let is i64 as MINI_FIELD_LEN  = 12;
let is i64 as MINI_VERSION    = 2;

// Parse `len` ASCII decimal digits at `off`. Returns -1 on any non-digit.
fn read_ascii_num(buf as *u8, off as i64, len as i64) as i64 {
    let is i64 as v with mut = 0;
    let is i64 as i with mut = 0;
    while (i < len) {
        let is i64 as c = cast(i64, buf[off + i]);
        if (c < 48 || c > 57) { return cast(i64, 0 - 1); }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}

fn page_align_up(x as i64) as i64 {
    return (x + 0xFFF) & (cast(i64, 0 - 1) - 0xFFF);
}

fn page_align_down(x as i64) as i64 {
    return x & (cast(i64, 0 - 1) - 0xFFF);
}

// CSE perms (R=1,W=2,X=4) -> vma protection bits. Read is implied by
// PROT_USER. No X bit => set NX. W bit => writable.
fn perms_to_prot(perms as i64) as i64 {
    let is i64 as prot with mut = vma.PROT_USER;
    if ((perms & PERM_W) != 0) { prot = prot | vma.PROT_WRITE; }
    if ((perms & PERM_X) == 0) { prot = prot | vma.PROT_NX; }
    return prot;
}

// ============================================================
// Shared-library loading
// ============================================================

// Byte-compare a NUL-terminated cache name against a length-delimited one.
fn _csl_name_eq(slot as i64, nm as *u8, nl as i64) as i32 {
    let is i64 as base = slot * CSL_NAME_MAX;
    let is i64 as i with mut = 0;
    while (i < nl) {
        if (_csl_name[base + i] == cast(u8, 0)) { return 0; }
        if (_csl_name[base + i] != nm[i]) { return 0; }
        i = i + 1;
    }
    if (_csl_name[base + nl] != cast(u8, 0)) { return 0; }
    return 1;
}

// Read /lib/<name> once and keep it. Returns the cache slot, or -1.
fn _csl_open(nm as *u8, nl as i64) as i64 {
    let is i64 as k with mut = 0;
    while (k < _csl_count) {
        if (_csl_name_eq(k, nm, nl) == 1) { return k; }
        k = k + 1;
    }
    if (_csl_count >= CSL_CACHE_MAX) {
        serial.println("cse: too many shared libraries", 30);
        return 0 - 1;
    }
    if (nl <= 0 || nl >= CSL_NAME_MAX) { return 0 - 1; }

    // "/lib/" + name. Built here rather than taken from the image: the path is
    // the kernel's policy, and a library name out of a file must never be able
    // to name a path.
    let is [64]u8 as path;
    let is *u8 as pfx = "/lib/";
    let is i64 as i with mut = 0;
    while (i < 5) { path[i] = pfx[i]; i = i + 1; }
    let is i64 as j with mut = 0;
    while (j < nl) {
        // A name is a file name, never a path: a '/' in it would escape /lib.
        if (nm[j] == cast(u8, 47)) { return 0 - 1; }
        path[5 + j] = nm[j];
        j = j + 1;
    }
    path[5 + nl] = cast(u8, 0);

    let is *vfs.VfsFile as f = vfs.open(cast(*u8, &path[0]), 5 + nl, cast(i32, abi.O_RDONLY));
    if (cast(i64, f) == 0) {
        serial.print("cse: /lib/", 10);
        serial.print(nm, nl);
        serial.println(" not found", 10);
        return 0 - 1;
    }
    let is i64 as sz = f.size;
    if (sz < CSL_HDR_SIZE || sz > abi.SPAWN_IMG_MAX) { vfs.close(f); return 0 - 1; }
    let is i64 as buf = heap.kmalloc(sz, cast(i32, 0));
    if (buf == 0) { vfs.close(f); return 0 - 1; }
    let is i64 as got = vfs.read(f, cast(*u8, buf), sz);
    vfs.close(f);
    if (got != sz) { return 0 - 1; }

    let is *u8 as b = cast(*u8, buf);
    if (b[0] != cast(u8, 67) || b[1] != cast(u8, 83)
        || b[2] != cast(u8, 76) || b[3] != cast(u8, 95)) {       // "CSL_"
        serial.println("cse: not a CSL_ image", 21);
        return 0 - 1;
    }
    if (elf.read_u16_le(b, 4) != CSL_VERSION) {
        serial.println("cse: CSL version unsupported", 28);
        return 0 - 1;
    }
    if (cast(i64, b[CSL_ARCH]) != CSE_ARCH_NATIVE) {
        serial.println("cse: CSL is for another arch", 28);
        return 0 - 1;
    }
    let is i64 as ecount = elf.read_u32_le(b, CSL_EXPCOUNT);
    let is i64 as eoff   = elf.read_u64_le(b, CSL_EXPOFF);
    if (eoff < CSL_HDR_SIZE || eoff + ecount * CSL_EXP_ENTRY > sz) {
        serial.println("cse: CSL export table out of bounds", 35);
        return 0 - 1;
    }

    let is i64 as slot = _csl_count;
    _csl_buf[slot] = buf;
    _csl_size[slot] = sz;
    let is i64 as nb = slot * CSL_NAME_MAX;
    let is i64 as c with mut = 0;
    while (c < nl) { _csl_name[nb + c] = nm[c]; c = c + 1; }
    _csl_name[nb + nl] = cast(u8, 0);
    _csl_count = _csl_count + 1;
    return slot;
}

// Map a library's segments into `a` at the vaddrs it was linked for. The build
// gives each library a distinct base, so two of them never overlap and neither
// lands on the program at 0x400000.
fn _csl_map(a as *vma.Aspace, slot as i64) as i32 {
    let is *u8 as b = cast(*u8, _csl_buf[slot]);
    let is i64 as sz = _csl_size[slot];
    let is i64 as nseg = elf.read_u32_le(b, CSL_SEGCOUNT);
    if (nseg <= 0 || nseg > CSL_MAX_SEGS) { return cast(i32, 0 - 40); }
    let is i64 as i with mut = 0;
    while (i < nseg) {
        let is i64 as e = CSL_HDR_SIZE + i * S_SIZE;
        let is i64 as vaddr = elf.read_u64_le(b, e + S_VADDR);
        let is i64 as foff  = elf.read_u32_le(b, e + S_FOFF);
        let is i64 as fsz   = elf.read_u32_le(b, e + S_FSZ);
        let is i64 as msz   = elf.read_u32_le(b, e + S_MSZ);
        let is i64 as perms = elf.read_u32_le(b, e + S_PERMS);
        if (msz < fsz) { return cast(i32, 0 - 41); }
        if (fsz > 0 && foff + fsz > sz) { return cast(i32, 0 - 42); }
        let is i64 as p0  = page_align_down(vaddr);
        let is i64 as end = page_align_up(vaddr + msz);
        if (end > p0) {
            // Writable while we copy; the library's own perms are what the
            // segment table asks for, and a text segment is R-X.
            let is i64 as prot = perms_to_prot(perms) | vma.PROT_WRITE;
            let is i64 as got = vma.mmap_anon(a, p0, end - p0, prot, vma.VMA_FIXED);
            if (got != p0) { return cast(i32, 0 - 43); }
        }
        if (fsz > 0) {
            let is i32 as crc = elf.copy_segment_into_aspace(a, vaddr, b, foff, fsz, fsz);
            if (crc != 0) { return cast(i32, 0 - 44); }
        }
        i = i + 1;
    }
    return 0;
}

// The vaddr `sym` is exported at, or -1.
fn _csl_sym(slot as i64, sym as *u8, slen as i64) as i64 {
    let is *u8 as b = cast(*u8, _csl_buf[slot]);
    let is i64 as ecount = elf.read_u32_le(b, CSL_EXPCOUNT);
    let is i64 as eoff   = elf.read_u64_le(b, CSL_EXPOFF);
    let is i64 as i with mut = 0;
    while (i < ecount) {
        let is i64 as ent = eoff + i * CSL_EXP_ENTRY;
        let is i64 as noff = elf.read_u32_le(b, ent);
        if (noff > 0 && noff < _csl_size[slot]) {
            let is i64 as k with mut = 0;
            let is i64 as hit with mut = 1;
            while (k < slen) {
                if (b[noff + k] == cast(u8, 0) || b[noff + k] != sym[k]) { hit = 0; k = slen; }
                else { k = k + 1; }
            }
            if (hit == 1 && b[noff + slen] == cast(u8, 0)) {
                return elf.read_u64_le(b, ent + 4);
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

// Add `s` to the value already at `site` in `a` — see the header comment: the
// linker resolved these against address 0, so this one rule serves both PC32
// and 64-bit sites. width is 4 or 8.
fn _patch_site(a as *vma.Aspace, site as i64, s as i64, width as i64) as i32 {
    // A site straddling a page boundary would need two walks; the linker never
    // emits one (relocation fields are naturally aligned within an
    // instruction), and silently patching half of it would be far worse than
    // refusing.
    if ((site & 0xFFF) + width > pmm.PAGE_SIZE) { return cast(i32, 0 - 45); }
    let is i64 as page_va = page_align_down(site);
    let is i64 as phys = vmm.virt_to_phys_walk(a.pml4_phys, page_va);
    if (phys == 0) { return cast(i32, 0 - 46); }
    let is i64 as kv = pmm.phys_to_virt(phys) + (site & 0xFFF);
    if (width == 8) {
        let is *i64 as p = cast(*i64, kv);
        *p = *p + s;
        return 0;
    }
    let is *i32 as p32 = cast(*i32, kv);
    *p32 = cast(i32, cast(i64, *p32) + s);
    return 0;
}

// Resolve every import of a v3.2 image: load each library it names, map it into
// the child, and patch each site with the address its symbol lives at.
fn resolve_imports(a as *vma.Aspace, img as *u8, cst_size as i64,
                   imp_off as i64, imp_count as i64) as i32 {
    if (imp_off + 8 > cst_size) { return cast(i32, 0 - 47); }
    let is i64 as n     = elf.read_u32_le(img, imp_off);
    let is i64 as nlibs = elf.read_u32_le(img, imp_off + 4);
    if (n != imp_count) { return cast(i32, 0 - 48); }
    if (nlibs <= 0 || nlibs > CSL_CACHE_MAX) { return cast(i32, 0 - 49); }

    // Library table, then the entries. Both are variable-length strings, so the
    // cursor walks once and every read is bounds-checked against the image.
    let is [8]i64 as slots;
    let is i64 as cur with mut = imp_off + 8;
    let is i64 as li with mut = 0;
    while (li < nlibs) {
        let is i64 as start = cur;
        while (cur < cst_size && img[cur] != cast(u8, 0)) { cur = cur + 1; }
        if (cur >= cst_size) { return cast(i32, 0 - 50); }
        let is i64 as slot = _csl_open(cast(*u8, &img[start]), cur - start);
        if (slot < 0) { return cast(i32, 0 - 51); }
        let is i32 as mrc = _csl_map(a, slot);
        if (mrc != 0) { return mrc; }
        slots[li] = slot;
        cur = cur + 1;
        li = li + 1;
    }

    let is i64 as i with mut = 0;
    while (i < n) {
        if (cur + 16 > cst_size) { return cast(i32, 0 - 52); }
        let is i64 as rtype   = elf.read_u32_le(img, cur);
        let is i64 as lib_idx = elf.read_u32_le(img, cur + 4);
        let is i64 as site    = elf.read_u64_le(img, cur + 8);
        cur = cur + 16;
        let is i64 as sstart = cur;
        while (cur < cst_size && img[cur] != cast(u8, 0)) { cur = cur + 1; }
        if (cur >= cst_size) { return cast(i32, 0 - 53); }
        let is i64 as slen = cur - sstart;
        cur = cur + 1;

        if (lib_idx < 0 || lib_idx >= nlibs) { return cast(i32, 0 - 54); }
        let is i64 as sv = _csl_sym(slots[lib_idx], cast(*u8, &img[sstart]), slen);
        if (sv < 0) {
            serial.print("cse: unresolved import ", 23);
            serial.print(cast(*u8, &img[sstart]), slen);
            serial.println("", 0);
            return cast(i32, 0 - 55);
        }
        let is i64 as width with mut = 4;
        if (rtype == R_X86_64_64) { width = 8; }
        else if (rtype != R_X86_64_PC32 && rtype != R_X86_64_PLT32) {
            serial.print("cse: unsupported reloc type ", 28);
            util.print_num(rtype);
            serial.println("", 0);
            return cast(i32, 0 - 56);
        }
        let is i32 as prc = _patch_site(a, site, sv, width);
        if (prc != 0) { return prc; }
        i = i + 1;
    }
    return 0;
}

// ============================================================
// Locate the CST image inside the container -> (out_off, out_size).
// ============================================================

fn locate_cst(buf as *u8, size as i64, out_off as *i64, out_size as *i64) as i32 {
    if (size < H_SIZE) { return cast(i32, 0 - 1); }

    // Pure: magic "CST_" at offset 0.
    if (cast(i64, buf[0]) == 0x43 && cast(i64, buf[1]) == 0x53
        && cast(i64, buf[2]) == 0x54 && cast(i64, buf[3]) == 0x5F) {
        *out_off = 0;
        *out_size = size;
        return 0;
    }

    // Polyglot: "MZ" -> read the "CST*" mini-header at 0x40.
    if (cast(i64, buf[0]) == 0x4D && cast(i64, buf[1]) == 0x5A) {
        if (size < MINI_OFF + 0x20) { return cast(i32, 0 - 2); }
        if (cast(i64, buf[MINI_OFF + 0]) != 0x43 || cast(i64, buf[MINI_OFF + 1]) != 0x53
            || cast(i64, buf[MINI_OFF + 2]) != 0x54 || cast(i64, buf[MINI_OFF + 3]) != 0x2A) {
            return cast(i32, 0 - 3);
        }
        let is i64 as mini_ver = elf.read_u16_le(buf, MINI_OFF_VER);
        // v3 appends the ARM64 PE locator after the fields we read; both are fine.
        if (mini_ver != 2 && mini_ver != 3) { return cast(i32, 0 - 3); }
        let is i64 as body_off = read_ascii_num(buf, MINI_OFF_BODY, MINI_FIELD_LEN);
        let is i64 as body_sz with mut = read_ascii_num(buf, MINI_OFF_BODYSZ, MINI_FIELD_LEN);
        if (body_off < 0 || body_sz < 0) { return cast(i32, 0 - 4); }
        if (body_sz < H_SIZE) { body_sz = size - body_off; }   // fallback if size absent
        if (body_off + body_sz > size) { return cast(i32, 0 - 5); }
        *out_off = body_off;
        *out_size = body_sz;
        return 0;
    }

    return cast(i32, 0 - 6);
}

// ============================================================
// Top-level entry. buf/size = container bytes (pure .cse or polyglot).
// On success: *out_entry = entry_point, *out_user_rsp = stack pointer.
// Signature mirrors elf.load_elf for drop-in use.
// ============================================================

// Load the CSE image's segments into the aspace and report its entry point —
// no stack. The two public loaders (load_cse / load_cse_argv) add the System V
// initial stack on top, differing only in argv.
fn load_cse_image(a as *vma.Aspace, buf as *u8, size as i64,
                  out_entry as *i64) as i32 {
    let is i64 as cst_off with mut = 0;
    let is i64 as cst_size with mut = 0;
    let is i32 as lrc = locate_cst(buf, size, &cst_off, &cst_size);
    if (lrc != 0) {
        serial.print("cse: locate rc=", 15);
        util.print_num(cast(i64, lrc));
        serial.println("", 0);
        return lrc;
    }

    let is *u8 as img with mut = cast(*u8, &buf[cst_off]);
    if (cast(i64, img[0]) != 0x43 || cast(i64, img[1]) != 0x53
        || cast(i64, img[2]) != 0x54 || cast(i64, img[3]) != 0x5F) {
        return cast(i32, 0 - 7);
    }
    // Version is major.minor in two bytes. minor 1 marks a container indexing
    // N images; minor 0 is a plain image, which is what every slice inside one
    // is. Reading it as a u16 would conflate them.
    let is i64 as cse_ver with mut = cast(i64, img[H_VERSION]);
    let is i64 as cse_minor with mut = cast(i64, img[H_VERSION + 1]);

    // v4 = multi-arch container: a 16-byte header plus an 8-byte index entry per
    // embedded image. Select the entry matching this machine and fall through to
    // the v3 path on the image it points at — the payloads are ordinary v3
    // images, byte-identical to a single-target link, so nothing below changes.
    if (cse_ver == 3 && cse_minor == 1) {
        let is i64 as img_count = cast(i64, img[FAT_COUNT]);
        let is i64 as index_off = elf.read_u32_le(img, FAT_INDEX_OFF);
        if (img_count <= 0 || img_count > FAT_MAX) { return cast(i32, 0 - 17); }
        if (index_off + img_count * FAT_ENTRY > cst_size) { return cast(i32, 0 - 18); }
        let is i64 as picked with mut = 0 - 1;
        let is i64 as k with mut = 0;
        while (k < img_count) {
            let is i64 as e = index_off + k * FAT_ENTRY;
            if (cast(i64, img[e]) == CSE_ARCH_NATIVE) {
                picked = elf.read_u32_le(img, e + 4);
                k = img_count;
            } else { k = k + 1; }
        }
        if (picked < 0) {
            serial.println("cse: fat image has no slice for this arch", 41);
            return cast(i32, 0 - 19);
        }
        if (picked + H_SIZE > cst_size) { return cast(i32, 0 - 20); }
        // Re-base onto the selected slice; every offset below is image-relative.
        cst_off = cst_off + picked;
        cst_size = cst_size - picked;
        img = cast(*u8, &buf[cst_off]);
        if (cast(i64, img[0]) != 0x43 || cast(i64, img[1]) != 0x53
            || cast(i64, img[2]) != 0x54 || cast(i64, img[3]) != 0x5F) {
            return cast(i32, 0 - 21);
        }
        cse_ver = cast(i64, img[H_VERSION]);
        cse_minor = cast(i64, img[H_VERSION + 1]);
        // minor 0 = static image, 2 = one that imports from .csl libraries.
        // Only 1 is refused, and that is the container itself: a fat image
        // inside a fat image is the nesting this rejects.
        if (cse_minor != 0 && cse_minor != 2) { return cast(i32, 0 - 22); }
    }
    // v2 = compact 32-byte header; v3 = 48-byte header, whose import fields are
    // read when the minor says they are there. The toolchain emits v3 for every
    // .cse; the hand-built smokes use v2.
    //
    // Minor: 0 = static, 2 = imports from .csl libraries. 1 is the fat
    // container, which is unwrapped above and never reaches here as an image.
    if ((cse_ver != 2 && cse_ver != 3) || (cse_minor != 0 && cse_minor != 2)) {
        serial.print("cse: bad version ", 17);
        util.print_num(cse_ver);
        serial.print(".", 1);
        util.print_num(cse_minor);
        serial.println("", 0);
        return cast(i32, 0 - 8);
    }
    let is i64 as hsize with mut = H_SIZE;      // v2 header = 0x20
    if (cse_ver == 3) { hsize = 0x30; }         // v3 header = 0x30 (32 + 16 import-field bytes)
    // Arch byte: 1 = x86_64, 2 = aarch64. The writer used to hardcode 1, so this
    // compared against a literal; it now checks the image against the machine we
    // are actually running on, which is what makes a multi-arch container safe.
    if (cast(i64, img[H_ARCH]) != CSE_ARCH_NATIVE) { return cast(i32, 0 - 9); }

    // v3 declares its worst-case user-stack at 0x2C (computed by the toolchain
    // from the call graph, or set with --stack-size for recursive programs). The
    // initial stack is eager-committed to exactly this — no OS default. 0 (v2 /
    // undeclared hand-built images) leaves a.stack_size 0 → elf's legacy default.
    if (cse_ver == 3) {
        let is i64 as decl_stack = elf.read_u32_le(img, H_STACKSIZE);
        if (decl_stack > 0) { a.stack_size = decl_stack; }
        // Header flags byte (0x07). bit0 = dynamic stack growth: stack_size is
        // the reserve ceiling, the loader commits only an initial window, and
        // the program's prologue probes grow it via SYS_COMMIT. Strict (0) =
        // eager-commit stack_size in full, the legacy wall.
        let is i64 as hflags = cast(i64, img[H_FLAGS]);
        if ((hflags & 1) != 0) { a.stack_dynamic = 1; }
    }

    let is i64 as entry = elf.read_u64_le(img, H_ENTRY);
    let is i64 as nseg  = elf.read_u32_le(img, H_SEGCOUNT);
    if (entry == 0) { return cast(i32, 0 - 10); }
    if (nseg <= 0 || nseg > CSE_MAX_SEGS) { return cast(i32, 0 - 11); }
    if (hsize + nseg * S_SIZE > cst_size) { return cast(i32, 0 - 12); }

    // Map each segment and copy its file bytes.
    let is i64 as i with mut = 0;
    while (i < nseg) {
        let is i64 as e     = hsize + i * S_SIZE;
        let is i64 as vaddr = elf.read_u64_le(img, e + S_VADDR);
        let is i64 as foff  = elf.read_u32_le(img, e + S_FOFF);
        let is i64 as fsz   = elf.read_u32_le(img, e + S_FSZ);
        let is i64 as msz   = elf.read_u32_le(img, e + S_MSZ);
        let is i64 as perms = elf.read_u32_le(img, e + S_PERMS);

        if (msz < fsz) { return cast(i32, 0 - 13); }
        if (fsz > 0 && foff + fsz > cst_size) { return cast(i32, 0 - 14); }

        let is i64 as p0  = page_align_down(vaddr);
        let is i64 as end = page_align_up(vaddr + msz);
        if (end > p0) {
            let is i64 as prot = perms_to_prot(perms);
            let is i64 as got = vma.mmap_anon(a, p0, end - p0, prot, vma.VMA_FIXED);
            if (got != p0) {
                serial.print("cse: seg map fail i=", 20);
                util.print_num(i);
                serial.println("", 0);
                return cast(i32, 0 - 15);
            }
        }
        if (fsz > 0) {
            // copy goes through the physical pages, so a R-X/R-only
            // segment's protection doesn't block this kernel-side write.
            let is i32 as crc = elf.copy_segment_into_aspace(a, vaddr, buf,
                                                             cst_off + foff, fsz, fsz);
            if (crc != 0) { return cast(i32, 0 - 16); }
        }
        i = i + 1;
    }

    // Dynamic imports, if this image has any. After the segments, because the
    // sites being patched live in them.
    if (cse_ver == 3 && cse_minor == 2) {
        let is i64 as imp_off   = elf.read_u64_le(img, H_IMPORT_OFF);
        let is i64 as imp_count = elf.read_u32_le(img, H_IMPORT_COUNT);
        if (imp_count > 0) {
            if (imp_off <= 0 || imp_off >= cst_size) { return cast(i32, 0 - 57); }
            let is i32 as irc = resolve_imports(a, img, cst_size, imp_off, imp_count);
            if (irc != 0) { return irc; }
        }
    }

    *out_entry = entry;
    return 0;
}

// Load a CSE and build its initial stack with a single argv[0] = the program
// name. Drop-in for the existing smokes / proc_spawn (no real argv).
fn load_cse(a as *vma.Aspace, buf as *u8, size as i64,
            argv0 as *u8, argv0_len as i64,
            out_entry as *i64, out_user_rsp as *i64) as i32 {
    let is i64 as entry with mut = 0;
    let is i32 as rc = load_cse_image(a, buf, size, &entry);
    if (rc != 0) { return rc; }
    let is i32 as ssrc = elf.build_initial_stack_named(a, entry, argv0, argv0_len, out_user_rsp);
    if (ssrc != 0) { return ssrc; }
    *out_entry = entry;
    return 0;
}

// Load a CSE and build its initial stack with a full argv (argc >= 1). Used by
// SYS_SPAWN's argv path (proc_spawn_argv): the spawner hands the child its
// argument vector; the kernel only lays the bytes on the stack, never resolves
// them (docs/architecture.md §2 — argv is data, authority is fds).
fn load_cse_argv(a as *vma.Aspace, buf as *u8, size as i64,
                 argv_ptrs as *i64, argv_lens as *i64, argc as i64,
                 out_entry as *i64, out_user_rsp as *i64) as i32 {
    let is i64 as entry with mut = 0;
    let is i32 as rc = load_cse_image(a, buf, size, &entry);
    if (rc != 0) { return rc; }
    let is i32 as ssrc = elf.build_initial_stack(a, entry, argv_ptrs, argv_lens, argc, out_user_rsp);
    if (ssrc != 0) { return ssrc; }
    *out_entry = entry;
    return 0;
}
