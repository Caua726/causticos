// userspace.cst — ring 3: entering it, copying across it, putting a program
// there, and the boot handing the machine to the first one.
//
//   - enter_user / user_thread_trampoline: the first instructions of every
//     user thread (the iretq itself is smp_asm.s:smp_enter_user).
//   - copy_from_user / copy_to_user: how a syscall touches user memory, every
//     page checked against the page tables first.
//   - proc_spawn* / proc_start / proc_wait*: a process is created suspended,
//     configured from outside, started, waited for and reaped. No fork.
//   - init_thread: wait for the disk and the input devices, launch /init.cse,
//     then answer the power button for the life of the machine.
//
// The ring-3 smoke tests of all this live in kernel/test (user_smoke.cst runs
// them on a smoke boot).

use "serial.cst" as serial;
use "util.cst" as util;
use "pmm.cst" as pmm;
use "vmm.cst" as vmm;
use "vma.cst" as vma;
use "sched.cst" as sched;
use "thread.cst" as thread;
use "runq.cst" as runq;
use "acpi.cst" as acpi;
use "storage.cst" as storage;
use "ioapic.cst" as ioapic;
use "lapic.cst" as lapic;
use "timer.cst" as timer;
use "vfs.cst" as vfs;
use "cse.cst" as cse;
use "imgcache.cst" as imgcache;
use "abi.cst" as abi;
use "process.cst" as proc;
use "lifecycle.cst" as lifecycle;
use "fb.cst" as fb;
use "driver.cst" as driver;

// ----------------------------------------------------------------
// Ring-3 entry: smp_asm.s:smp_enter_user builds the iretq frame
// (RIP, CS 0x2B, RFLAGS 0x202 = IF, RSP, SS 0x23) from its argument
// registers, zeroes every other general register so no kernel pointer
// leaks into user state, and iretqs. GS is left alone: loading it in
// 64-bit mode would clobber GSBASE (the per-cpu pointer).
//
// It is hand assembly taking its arguments in registers, not a Caustic
// body staging them through module globals as it used to: those globals
// were shared by every cpu, so two threads starting at once — or one
// preempted between the stores and the asm that read them — could enter
// ring 3 at another thread's entry point on another thread's stack.
// ----------------------------------------------------------------
fn enter_user(rip as i64, rsp as i64, arg as i64) as void {
    asm("call smp_enter_user\n");
}

// First instructions of every ring-3 thread. Runs in ring 0 with
// the thread's aspace_pml4 already loaded by the context switch,
// then iretq's into ring 3 with the entry/rsp the spawner stashed.
fn user_thread_trampoline() as void {
    let is i64 as tid = runq.current_tid();
    let is i64 as rip = thread.thr_user_entry(tid);
    let is i64 as rsp = thread.thr_user_rsp(tid);
    if (rip == 0) {
        serial.println("userspace: trampoline tid has no user_entry", 43);
        return;
    }
    // A thread killed before it ever ran (its process was terminated while it
    // was still suspended) leaves here, at its first instruction.
    lifecycle.at_user_boundary();
    enter_user(rip, rsp, thread.thr_initial_rdi(tid));   // rdi = 0 for a main thread
}

// ============================================================
// copy_from_user / copy_to_user
//
// The kernel side of "safe access to user memory". Caller passes
// the user thread's aspace pml4_phys and a user virtual address;
// we validate every covered page against the pml4 (PRESENT + USER,
// plus WRITE for copy_to_user) before touching it. Validation +
// copy are split because pte_lookup walks 4 cache lines per page
// — doing the walk first means the actual copy can run inline
// without per-byte branching.
//
// Returns 0 on full copy, -1 on any range / mapping / overflow
// problem. The kernel side of the copy assumes CR3 already points
// at `pml4_phys` (i.e. the caller is running on the user thread's
// kernel stack with the user aspace mapped). syscall handlers, the
// upcoming on-fault path, and the exit-cleanup path all satisfy
// this; cross-aspace copies go through walk + HHDM instead.
// ============================================================

let is i64 as USER_VA_MAX = 0x00007FFFFFFFFFFF;

fn user_range_ok(pml4 as i64, va as i64, n as i64, need_write as i32) as i32 {
    if (n < 0) { return 0; }
    if (n == 0) { return 1; }
    if (va < 0) { return 0; }
    let is i64 as end = va + n;
    if (end < va) { return 0; }                 // overflow
    if (end > USER_VA_MAX) { return 0; }

    let is i64 as page_mask = cast(i64, 0 - 1) - 0xFFF;
    let is i64 as p with mut = va & page_mask;
    let is i64 as last = (end - 1) & page_mask;
    while (p <= last) {
        let is i64 as pte = vmm.pte_lookup(pml4, p);
        if (pte == 0) { return 0; }
        if ((pte & vmm.PTE_USER) == 0) { return 0; }
        if (need_write == 1 && (pte & vmm.PTE_WRITE) == 0) { return 0; }
        p = p + pmm.PAGE_SIZE;
    }
    return 1;
}

fn copy_from_user(pml4 as i64, dst as *u8, user_va as i64, n as i64) as i32 {
    if (user_range_ok(pml4, user_va, n, cast(i32, 0)) == 0) {
        return cast(i32, 0 - 1);
    }
    let is *u8 as src = cast(*u8, user_va);
    let is i64 as i with mut = 0;
    while (i < n) {
        dst[i] = src[i];
        i = i + 1;
    }
    return 0;
}

fn copy_to_user(pml4 as i64, user_va as i64, src as *u8, n as i64) as i32 {
    if (user_range_ok(pml4, user_va, n, cast(i32, 1)) == 0) {
        return cast(i32, 0 - 1);
    }
    let is *u8 as dst = cast(*u8, user_va);
    let is i64 as i with mut = 0;
    while (i < n) {
        dst[i] = src[i];
        i = i + 1;
    }
    return 0;
}

// ----------------------------------------------------------------
// Process spawn orchestration (Process != Thread).
//
// proc_spawn implements the create-suspended primitive: fresh aspace,
// load image, create the Process object, then a SUSPENDED main thread
// bound to it. The child's fd table starts EMPTY — authority is never
// ambient; the caller installs handles explicitly (fd handoff) before
// proc_start makes the thread runnable. No fork: the parent never runs
// code in the child; it configures the child from the outside and starts
// it. Image loading + thread creation live here (not in process.cst) so
// that module stays free of sched/vma/loader imports.
// ----------------------------------------------------------------
// Shared tail: turn a freshly loaded aspace (entry + user_rsp already set) into
// a suspended child Process. Destroys the aspace and returns 0 on failure.
fn proc_from_loaded(parent as i64, a as *vma.Aspace, entry as i64, user_rsp as i64) as i64 {
    let is i64 as p = proc.process_create(parent, cast(i64, a), 0);
    if (p == 0) {
        vma.aspace_destroy(a);
        return 0;
    }
    let is i64 as tid = sched.create_user_thread_ex(
        cast(i64, fn_ptr(user_thread_trampoline)),
        thread.QOS_NORMAL,
        a.pml4_phys, entry, user_rsp, cast(i64, a),
        p, 1                                   // process_ptr, suspended
    );
    // Its fs base is the block the loader wrote above its stack.
    thread.thr_set_user_fs(tid, a.main_block);
    proc.attach_main_thread(p, tid);
    return p;
}

fn proc_spawn(parent as i64, img as *u8, img_len as i64) as i64 {
    let is *vma.Aspace as a = vma.aspace_create();
    if (cast(i64, a) == 0) { return 0; }
    let is i64 as entry with mut = 0;
    let is i64 as user_rsp with mut = 0;
    let is i32 as rc = cse.load_cse(a, img, img_len, cast(*u8, "child"), 5,
                                     &entry, &user_rsp);
    if (rc != 0) { vma.aspace_destroy(a); return 0; }
    return proc_from_loaded(parent, a, entry, user_rsp);
}

// Spawn from an OPEN FILE — what SYS_SPAWN does. The file is borrowed, not
// consumed: the image cache reads it if this is the first load and maps the
// frames it already holds if it is not, so a second process running the same
// program costs its writable data and nothing else. The caller closes the file.
//
// argv_ptrs/argv_lens are KERNEL pointers; argc 0 gives the child the default
// argv. argv is data laid on the child's stack, never resolved by the kernel
// (architecture §2) — authority travels only as fds.
fn proc_spawn_file(parent as i64, f as *vfs.VfsFile,
                   argv_ptrs as *i64, argv_lens as *i64, argc as i64) as i64 {
    return proc_spawn_slot(parent, imgcache.acquire_file(f), argv_ptrs, argv_lens, argc);
}

// The same, from an image already acquired from the cache — a file, a segment,
// whatever named it. The reference is consumed: it passes to the child's aspace
// on success and is dropped on failure.
fn proc_spawn_slot(parent as i64, slot as i64,
                   argv_ptrs as *i64, argv_lens as *i64, argc as i64) as i64 {
    if (slot < 0) { return 0; }
    let is *vma.Aspace as a = vma.aspace_create();
    if (cast(i64, a) == 0) { imgcache.release(slot); return 0; }
    let is i64 as entry with mut = 0;
    let is i64 as user_rsp with mut = 0;
    let is i32 as rc = cse.load_cse_slot(a, slot, argv_ptrs, argv_lens, argc,
                                         &entry, &user_rsp);
    if (rc != 0) {
        // The caller only learns "spawn failed"; the code says WHICH of the
        // twenty ways it can fail this was, and a load that dies inside the
        // dynamic loader is otherwise indistinguishable from a bad image.
        serial.print("spawn: load_cse rc=", 19);
        util.print_num(cast(i64, rc));
        serial.println("", 0);
        vma.aspace_destroy(a);
        return 0;
    }
    return proc_from_loaded(parent, a, entry, user_rsp);
}

// argv-aware spawn: same as proc_spawn but the child receives a full argument
// vector (argv_ptrs/argv_lens are KERNEL pointers, argc >= 1). Used by the
// in-kernel smokes, whose images are bytes the kernel already holds.
fn proc_spawn_argv(parent as i64, img as *u8, img_len as i64,
                   argv_ptrs as *i64, argv_lens as *i64, argc as i64) as i64 {
    let is *vma.Aspace as a = vma.aspace_create();
    if (cast(i64, a) == 0) { return 0; }
    let is i64 as entry with mut = 0;
    let is i64 as user_rsp with mut = 0;
    let is i32 as rc = cse.load_cse_argv(a, img, img_len, argv_ptrs, argv_lens, argc,
                                          &entry, &user_rsp);
    if (rc != 0) {
        // The caller only learns "spawn failed"; the code says WHICH of the
        // twenty ways it can fail this was, and a load that dies inside the
        // dynamic loader is otherwise indistinguishable from a bad image.
        serial.print("spawn: load_cse rc=", 19);
        util.print_num(cast(i64, rc));
        serial.println("", 0);
        vma.aspace_destroy(a);
        return 0;
    }
    return proc_from_loaded(parent, a, entry, user_rsp);
}

// Start a spawned (suspended) process: make its main thread runnable.
fn proc_start(p as i64) as void {
    sched.make_runnable(proc.proc_first_tid(p));
}

// Wait for a child PROCESS (pid>0; pid<=0 = any) to exit, then REAP it
// race-free. A zombie is published at exit, but its thread may still be
// finishing its last schedule() on its own kstack/CR3 — so we block until
// the deferred reaper has freed the thread (thr_exists == 0). Only then is
// it off-cpu and the aspace safe to tear down. Frees the aspace + Process
// struct and detaches from the parent. Returns the exit code, or E_AGAIN.
fn proc_wait(parent as i64, pid as i64) as i64 {
    return lifecycle.wait_child(parent, pid, 5000000000);
}

fn proc_wait_info(parent as i64, pid as i64, out as *i64) as i64 {
    return lifecycle.wait_child_info(parent, pid, 5000000000, out);
}

// ============================================================
// Boot → userspace handoff: launch /init.cse from the FAT32 disk.
//
// The disk-loaded image is the first userspace program: open("/init.cse") →
// read → proc_spawn → proc_start. "Everything is a key / just a file" — init is
// not special, it is a .cse on the disk you can swap without recompiling the
// kernel (the real terminal, Fatia 4, replaces the stub with no kernel change).
//
// Production semantics: spawn + start, then return — init owns the machine from
// here (the terminal runs forever, holding the surface + keyboard) and the boot
// path does NOT wait on it. The stub proves the path by writing a serial marker
// from ring 3 before it exits.
//
// init_thread waits for VFS readiness with a deadline before reaching this point.
// Every failure below logs to serial and replaces the splash with a boot error;
// a missing, short or unspawnable /init.cse is a real boot fault.
// ============================================================
// What ps calls the first process: the program /init.cse is, as the root
// names it in /etc/init (mkroot writes it beside /init.cse), or "init" — what
// the file is — when the root does not say. It used to be "compositor"
// whatever the profile booted, and the shell profile's shell was listed as
// the compositor. The first word of the file, at most `cap` bytes.
fn init_label(out as *u8, cap as i64) as i64 {
    let is i64 as n with mut = 0;
    let is *vfs.VfsFile as f = vfs.open(cast(*u8, "/etc/init"), 9, cast(i32, abi.O_RDONLY));
    if (cast(i64, f) != 0) {
        let is i64 as got = vfs.read(f, out, cap);
        vfs.close(f);
        while (n < got && out[n] != cast(u8, 10) && out[n] != cast(u8, 13)
               && out[n] != cast(u8, 32) && out[n] != cast(u8, 9) && out[n] != cast(u8, 0)) {
            n = n + 1;
        }
    }
    if (n > 0) { return n; }
    out[0] = cast(u8, 105); out[1] = cast(u8, 110); out[2] = cast(u8, 105); out[3] = cast(u8, 116);   // i n i t
    return 4;
}

fn spawn_init_from_disk() as void {
    serial.println("boot: open /init.cse", 20);
    let is *vfs.VfsFile as f = vfs.open(cast(*u8, "/init.cse"), 9, cast(i32, abi.O_RDONLY));
    if (cast(i64, f) == 0) {
        serial.println("boot: /init.cse open FAIL", 25);
        fb.boot_error_screen(cast(*u8, "Could not open /init.cse. See serial log."), 41);
        return;
    }
    let is i64 as sz = f.size;
    if (sz <= 0 || sz > abi.SPAWN_IMG_MAX) {
        serial.print("boot: /init.cse bad size", 24);
        serial.println("", 0);
        fb.boot_error_screen(cast(*u8, "Invalid /init.cse image. See serial log."), 40);
        vfs.close(f);
        return;
    }
    // Straight from the open file: the image cache reads it into the frames the
    // child maps, with no staging buffer or second image copy.
    let is i64 as child = proc_spawn_file(proc.root_proc, f, cast(*i64, 0), cast(*i64, 0), 0);
    vfs.close(f);
    if (child == 0) {
        serial.println("boot: /init.cse spawn FAIL", 26);
        fb.boot_error_screen(cast(*u8, "Could not start /init.cse. See serial log."), 42);
        return;
    }
    // Boot has no argv; this is a display label, never authority.
    let is [32]u8 as label;
    let is i64 as llen = init_label(cast(*u8, &label[0]), 32);
    proc.proc_set_name(child, cast(*u8, &label[0]), llen);
    proc_start(child);
    serial.print("boot: /init.cse launched pid=", 29);
    util.print_num(proc.proc_pid(child));
    serial.println("", 0);
}

// What the image cache is holding and what it saved. Printed on demand rather
// than every boot: it is a measurement, and a number nobody reads is noise.
//
// `saved` is the honest figure — pages a spawn did NOT have to allocate or copy
// because the image was already resident. Under the old byte-carrying spawn
// every one of them was a per-process copy.
fn imgcache_report() as void {
    let is [3]i64 as st;
    imgcache.stats(cast(*i64, &st[0]));
    serial.print("imgcache: images=", 17);
    util.print_num(st[0]);
    serial.print(" resident_kb=", 13);
    util.print_num(st[1] * 4);
    serial.print(" shared_kb=", 11);
    util.print_num(st[2] * 4);
    serial.print(" hits=", 6);
    util.print_num(imgcache.hits());
    serial.print(" misses=", 8);
    util.print_num(imgcache.misses());
    serial.print(" saved_kb=", 10);
    util.print_num(imgcache.saved_pages() * 4);
    serial.println("", 0);
}

// Wait for the FS to mount (bounded), then settle. Shared by init_thread and
// smoke_init — both need a mounted disk before they touch files / spawn.
fn wait_boot_ready() as void {
    let is i64 as deadline = timer.current_time_ns() + 12000000000;
    let is i64 as waiting with mut = 1;
    while (waiting == 1) {
        if (vfs.boot_ready() != 0)                    { waiting = 0; }
        else if (timer.current_time_ns() >= deadline) { waiting = 0; }
        else { sched.sleep_for_ns(20000000); }
    }
    sched.sleep_for_ns(100000000);     // let the bind/mount settle
}

// Wait for the INPUT drivers to register before launching /init (bounded).
//
// The input drivers (keyboard, mouse) bind on the SAME phase-2 thread as the
// disk drivers — but BEHIND them, so their device_register lands AFTER the FS
// has already mounted. wait_boot_ready() returns the instant mount_head is
// populated, which can be well before the i8042 keyboard/mouse have registered.
// The /init compositor dev_open()s DEV_KEYBOARD/MOUSE the moment it starts, so
// without this gate it races the bind and loses ("comp: no keyboard/mouse") —
// deterministically under KVM headless, where boot is fast and the disk bind
// finishes first. Gating /init on the input classes appearing in the registry
// makes the launch happen only once its devices exist: the compositor's
// dev_open then always succeeds. (The framebuffer is registered in phase 1, so
// it is never the racy one; the tablet is optional — virtio-input may be absent
// — so we do NOT block on it.) Bounded + fail-loud: real hardware without a
// keyboard still boots (the compositor logs "no keyboard" and runs), it just
// can't deadlock the launch waiting forever.
fn wait_input_ready() as void {
    let is i64 as deadline = timer.current_time_ns() + 4000000000;
    let is i64 as waiting with mut = 1;
    while (waiting == 1) {
        if (driver.device_count(abi.DEV_KEYBOARD) > 0
            && driver.device_count(abi.DEV_MOUSE) > 0)  { waiting = 0; }
        else if (timer.current_time_ns() >= deadline)   { waiting = 0; }
        else { sched.sleep_for_ns(20000000); }
    }
    if (driver.device_count(abi.DEV_KEYBOARD) == 0) {
        serial.println("boot: WARN no keyboard registered before /init", 46);
    }
    if (driver.device_count(abi.DEV_MOUSE) == 0) {
        serial.println("boot: WARN no mouse registered before /init", 43);
    }
}

// The shutdown / reboot sequence — the kernel-side MECHANISM: the VFS writes out
// what it holds (write-behind bytes, each filesystem's own state) and stops
// accepting changes, every disk flushes its write cache, then ACPI soft-off /
// machine reset (which paints the notice screen and cuts power). Userspace POLICY — asking windows to close gracefully — runs
// before this point and is the WM's job.
fn system_poweroff() as void {
    vfs.shutdown();        // 2. files and filesystems to disk; no change after this
    storage.sync_all();    // 3. flush every disk's write cache
    ioapic.mask_all();     // 5. quiesce drivers — no more device IRQs/DMA completions
    lapic.halt_aps();      // 6. park the secondary CPUs (INIT IPI)
    acpi.poweroff();       // 7. ACPI S5 soft-off (does not return)
}
fn system_reboot() as void {
    vfs.shutdown();
    storage.sync_all();
    ioapic.mask_all();
    lapic.halt_aps();
    acpi.reboot();
}
// The power going the way that was asked of it (abi.POWER_*).
fn system_power(kind as i64) as void {
    if (kind == abi.POWER_REBOOT) { system_reboot(); }
    system_poweroff();
}

// The real boot→userspace handoff: wait for mount, launch /init.cse. No
// smokes — this is the clean production path. The smokes run on their own
// thread (kernel/test/user_smoke.cst), only on a smoke boot.
fn init_thread() as void {
    wait_boot_ready();
    wait_input_ready();                // keyboard/mouse must be registered first
    acpi.power_init();                 // arm the ACPI power button
    spawn_init_from_disk();
    // Done launching — this thread never returns; it becomes the power-button
    // poller.
    //
    // The image-cache report rides the SAME loop rather than a sleep before it.
    // A 3-second sleep here is 3 seconds in which a press of the power button is
    // not noticed, which is a real cost for a line of diagnostics.
    // A press asks for the power to go off (acpi.power_ask). The desktop,
    // polling SYS_POWER_PENDING, runs the graceful shutdown — close windows,
    // paint its notice — then calls SYS_POWEROFF, or calls the request off
    // when a window will not close. With no desktop listening, or on a second
    // press, it goes down at once; a desktop that stops answering is overridden
    // past the deadline, so the box never refuses to die. It used to wait 5 s
    // and power off whatever the windows were doing.
    let is i64 as ticks with mut = 0;
    while (1 == 1) {
        if (acpi.power_button_pressed() == 1) {
            serial.println("power: button", 13);
            if (acpi.power_ask(abi.POWER_OFF, timer.current_time_ns()) == 1) {
                system_power(acpi.power_pending());
            }
        }
        if (acpi.power_due(timer.current_time_ns()) == 1) {
            serial.println("power: the desktop did not answer; going down", 45);
            system_power(acpi.power_pending());
        }
        sched.sleep_for_ns(200000000);
        // Report the image cache once the desktop has settled — 15 ticks in,
        // from inside this loop rather than from a sleep before it, so the
        // button stays answered the whole time.
        ticks = ticks + 1;
        if (ticks == 15) { imgcache_report(); }
    }
}
