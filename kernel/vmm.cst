// vmm.cst — Virtual Memory Manager
// x86_64 4-level paging: PML4 → PDPT → PD → PT → 4KB page
// Based on causticos_vmm_spec_v1

use "serial.cst" as serial;
use "pmm.cst" as pmm;
use "heap.cst" as heap;
use "util.cst" as util;
use "lock.cst" as lock;

// ============================================================
// PTE flags
// ============================================================

let is i64 as PTE_PRESENT   = 1;
let is i64 as PTE_WRITE     = 2;
let is i64 as PTE_USER      = 4;
let is i64 as PTE_PWT       = 8;
let is i64 as PTE_PCD       = 16;
let is i64 as PTE_ACCESSED  = 32;
let is i64 as PTE_DIRTY     = 64;
let is i64 as PTE_HUGE      = 128;
let is i64 as PTE_GLOBAL    = 256;
// Bits 9-11 are software-available (AVL) in a leaf PTE. PTE_COW (bit 9) marks
// a page mapped read-only-for-copy-on-write: a write-fault clones the frame and
// drops the bit. Defined here for Phase D; its consumer is writable CoW / fork,
// future work outside A-G. Unused today — no path sets or tests it.
let is i64 as PTE_COW       = 512;
let is i64 as PTE_NX with mut = 0;
let is i64 as PTE_ADDR_MASK with mut = 0;

// Common flag combos (set at init)
let is i64 as PTE_TABLE with mut = 0;       // PRESENT | WRITE | NX
let is i64 as PTE_TABLE_USER with mut = 0;  // PRESENT | WRITE | USER | NX
let is i64 as KMAP_DATA with mut = 0;       // PRESENT | WRITE | NX
let is i64 as KMAP_MMIO with mut = 0;       // PRESENT | WRITE | NX | PCD | PWT (UC, = PAT entry PA3)
let is i64 as KMAP_WC with mut = 0;         // PRESENT | WRITE | NX | PWT (write-combining, = PA1)

// IA32_PAT (MSR 0x277). Default is 0x0007040600070406 (PA0..PA7 =
// WB,WT,UC-,UC,WB,WT,UC-,UC). We reprogram PA1 (selected by PWT=1,PCD=0,
// PAT=0) from WT (0x04) to WC (0x01) — a 4 KiB PTE with only PWT set then
// maps write-combining. PA1 avoids touching the PTE PAT bit (bit 7), which
// aliases the page-size bit on huge entries. Per-CPU MSR: set on the BSP
// and every AP.
let is i64 as IA32_PAT_MSR = 0x277;
let is i64 as PAT_VALUE     = 0x0007040600070106;
let is i64 as pat_shuttle with mut = 0;

// Address space layout
let is i64 as USER_SPACE_END with mut = 0;
let is i64 as PML4_KERNEL_START = 256;
let is i64 as PML4_KERNEL_END  = 511;

// ============================================================
// kvmap — unified kernel VA allocator (Phase C, L3)
//
// One coalescing free-list of VA *extents* over a single kernel window.
// Caching is per-extent via `kind` (DATA / MMIO-UC / WC), so ONE window
// serves all three — no separate kvalloc/mmio/iomap_wc ranges. This both
// removes the kvalloc 256-range cap + 32 KiB bitmap AND fixes the mmio bump's
// VA leak: kvunmap returns the VA to the free-list (coalescing), so a
// map/unmap churn reuses VA instead of marching a cursor off the window.
//
// Extent nodes are OUT-OF-LINE (a kpool), never stored inside the VA they
// describe — that VA may be unmapped (MMIO) or about to be (free). The
// alloc/coalesce algorithm is freelist.cst's (first-fit + split; free =
// address-ordered insert + coalesce fwd/bwd), adapted to out-of-line nodes.
//
// This replaced the kvalloc bitmap+range allocator, the leaking mmio bump,
// and vmm.dma_alloc (deleted in sub-phase 2 — DMA goes through driver.dma_alloc
// straight to the PMM + HHDM).
// ============================================================
let is i64 as KVMAP_BASE = 0xFFFFC00000000000;   // single kernel-VA window
let is i64 as KVMAP_SIZE = 0x40000000;           // 1 GiB of kernel VA

// kind tags (0 = a FREE extent)
let is i64 as KV_DATA = 1;   // anon RAM, zeroed, KMAP_DATA; kvunmap frees the frames
let is i64 as KV_MMIO = 2;   // caller's device phys, KMAP_MMIO (UC); frames are the device's
let is i64 as KV_WC   = 3;   // caller's device phys, KMAP_WC (write-combining framebuffer)

// kvmap `flags` bit. KV_GUARD wraps a KV_DATA allocation in one unmapped page
// on each side (overrun/underrun trips a #PF instead of silently corrupting a
// neighbour) — the one good idea kept from kvalloc. The same bit is stored in
// the extent's `kind` (KV_DATA | KV_GUARD) so kvunmap knows to skip the guards.
// High bit so it never collides with KV_DATA/KV_MMIO/KV_WC in the `kind` field.
let is i64 as KV_GUARD = 256;

// All-i64 (mixed-width struct fields miscompile). 5 fields = 40 bytes.
struct KvExtent {
    va_start as i64;
    len      as i64;     // bytes, page-multiple
    kind     as i64;     // KV_DATA|KV_MMIO|KV_WC (0 = free)
    pfns     as i64;     // *i64 array of page pfns (KV_DATA); 0 for MMIO/WC/free
    next     as i64;     // *KvExtent
}

let is i64 as kv_node_pool with mut = 0;       // kpool handle for KvExtent nodes
let is i64 as kv_free_head with mut = 0;       // FREE extents, address-ordered, coalescing
let is i64 as kv_used_head with mut = 0;       // ALLOCATED extents, looked up by va on unmap
let is i64 as kvmap_result_phys with mut = 0;  // 2nd return of kvmap: physical base (Caustic has no multi-return)

// ============================================================
// Paging index extraction
// ============================================================

fn pml4_index(v as i64) as i64 { return (v >> 39) & 511; }
fn pdpt_index(v as i64) as i64 { return (v >> 30) & 511; }
fn pd_index(v as i64) as i64   { return (v >> 21) & 511; }
fn pt_index(v as i64) as i64   { return (v >> 12) & 511; }

// ============================================================
// CR3 / TLB
// ============================================================

let is i64 as cr3_val with mut = 0;

fn read_cr3() as i64 {
    asm(".byte 0x0F, 0x20, 0xD8\n");  // mov rax, cr3
    asm("lea rbx, [rip+_kernel_vmm_cst_cr3_val]\n");
    asm("mov QWORD PTR [rbx], rax\n");
    return cr3_val;
}

// Faulting linear address of the last #PF. CR2 holds it from the #PF until the
// next one, so the exception handler reads it here as the FIRST op of its
// vector==14 branch — before any call that could itself fault and overwrite
// CR2. Same shuttle pattern as read_cr3 (Caustic overwrites rax with the
// return expression after the asm block). mov rax, cr2 = 0x0F 0x20 0xD0.
let is i64 as cr2_val with mut = 0;
fn read_cr2() as i64 {
    asm(".byte 0x0F, 0x20, 0xD0\n");  // mov rax, cr2
    asm("lea rbx, [rip+_kernel_vmm_cst_cr2_val]\n");
    asm("mov QWORD PTR [rbx], rax\n");
    return cr2_val;
}

fn write_cr3(val as i64) as void {
    asm(".byte 0x0F, 0x22, 0xDF\n");  // mov cr3, rdi
}

fn invlpg(vaddr as i64) as void {
    asm(".byte 0x0F, 0x01, 0x3F\n");  // invlpg [rdi]
}

fn flush_tlb_full() as void {
    let is i64 as c = read_cr3();
    write_cr3(c);
}

// Reload CR3 only when the requested PML4 phys differs from the
// current one — avoids a needless TLB flush on every kernel-thread
// context switch (they all share kas_pml4 today). Called from the
// scheduler's switch path; must be lock-free and side-effect free
// outside the actual write.
fn cr3_load_if_different(new_pml4_phys as i64) as void {
    let is i64 as cur = read_cr3();
    // CR3 carries optional PCID/flags in the low bits; mask to the
    // 4 KiB-aligned PML4 base before comparing.
    if ((cur & 0xFFFFFFFFFFFFF000) != (new_pml4_phys & 0xFFFFFFFFFFFFF000)) {
        write_cr3(new_pml4_phys);
    }
}

fn flush_tlb_range(vaddr as i64, count as i64) as void {
    let is i64 as i with mut = 0;
    while (i < count) {
        invlpg(vaddr + i * pmm.PAGE_SIZE);
        i = i + 1;
    }
}

// ============================================================
// VMM lock
//
// Protects the kvmap free-list / used-list and kernel_pml4_sync / as_create.
// Pre-SMP this was a stash-IF-and-cli pair over a module-global
// `vmm_saved_flags` word. Two cpus simultaneously racing kvmap on
// phase2_thread + fat32 mount would trash each other's saved flags and
// mis-restore IF on exit, plus corrupt the extent lists with half-writes. A
// ticket lock with acquire_irq/release_irq gives per-cpu IF preservation AND
// mutual exclusion for the shared data structures. Ordering: sched_lock >
// vmm_lock > heap_lock > pmm_lock. kvmap takes vmm_lock first, then reaches
// the kpool/pmm which take heap_lock/pmm_lock; never the other way round.
let is lock.TicketLock as vmm_lock with mut;

// ============================================================
// PTE helpers
// ============================================================

fn pte_read(tphys as i64, idx as i64) as i64 {
    let is *i64 as t = cast(*i64, pmm.phys_to_virt(tphys));
    return t[idx];
}

fn pte_write(tphys as i64, idx as i64, val as i64) as void {
    let is *i64 as t = cast(*i64, pmm.phys_to_virt(tphys));
    t[idx] = val;
}

fn pte_addr(pte as i64) as i64 { return pte & PTE_ADDR_MASK; }
fn pte_present(pte as i64) as i64 { return pte & PTE_PRESENT; }

fn alloc_table_page(owner as i32) as i64 {
    let is i32 as pfn = pmm.alloc_pages(
        pmm.ALLOC_ZERO,
        cast(i32, 0), pmm.USAGE_PAGE_TABLE, owner
    );
    if (pfn == pmm.PFN_NONE) {
        pmm.panic("vmm: alloc_table_page OOM", 25);
    }
    return pmm.pfn_to_phys(pfn);
}

// ============================================================
// Kernel address space
// ============================================================

// Kernel AS: pml4_phys, pml4_virt, as_id=0
let is i64 as kas_pml4_phys with mut = 0;
let is i64 as kas_pml4_virt with mut = 0;

// User AS list (for kernel PML4 sync)
// Simple array of pml4_virt pointers
let is i64 as MAX_USER_AS = 64;
let is [512]u8 as user_as_pml4s_raw;  // 64 * i64
let is i64 as user_as_count with mut = 0;

fn user_as_get(idx as i64) as i64 {
    let is *i64 as p = cast(*i64, &user_as_pml4s_raw);
    return p[idx];
}

fn user_as_set(idx as i64, v as i64) as void {
    let is *i64 as p = cast(*i64, &user_as_pml4s_raw);
    p[idx] = v;
}

// ============================================================
// Kernel PML4 sync — propagate new kernel PML4 entries to all user ASes
// ============================================================

fn kernel_pml4_sync(index as i64) as void {
    let is i64 as flags = lock.acquire_irq(&vmm_lock);
    let is *i64 as ksrc = cast(*i64, kas_pml4_virt);
    let is i64 as entry = ksrc[index];
    let is i64 as i with mut = 0;
    while (i < user_as_count) {
        let is i64 as upml4 = user_as_get(i);
        if (upml4 != 0) {
            let is *i64 as udst = cast(*i64, upml4);
            udst[index] = entry;
        }
        i = i + 1;
    }
    lock.release_irq(&vmm_lock, flags);
}

// ============================================================
// ensure_table — create intermediate page table if missing
// Returns physical address of next-level table
// ============================================================

fn ensure_table(tphys as i64, tvirt as i64, idx as i64, flags as i64, is_kernel_as as i64) as i64 {
    let is i64 as pte = pte_read(tphys, idx);
    if (pte_present(pte) != 0) {
        return pte_addr(pte);
    }

    // Guard: user AS must not create page tables in kernel PML4 range
    if (is_kernel_as == 0) {
        if (tvirt != 0) {
            // This is a PML4-level insert (tvirt != 0 means we passed the PML4 virt)
            if (idx >= PML4_KERNEL_START) {
                pmm.panic("ensure_table: user AS creating kernel PT", 40);
            }
        }
    }

    let is i64 as new_phys = alloc_table_page(cast(i32, 0));
    pte_write(tphys, idx, new_phys | flags);

    // Sync if this is a new kernel PML4 entry
    if (is_kernel_as != 0) {
        if (tvirt != 0) {
            if (idx >= PML4_KERNEL_START) {
                if (idx <= PML4_KERNEL_END) {
                    kernel_pml4_sync(idx);
                }
            }
        }
    }
    return new_phys;
}

// ============================================================
// vmm_map_page — map 4KB page in a given PML4
// ============================================================

fn vmm_map_page(pml4_phys as i64, vaddr as i64, phys as i64, flags as i64) as i64 {
    let is i64 as p4 = pml4_index(vaddr);
    let is i64 as p3 = pdpt_index(vaddr);
    let is i64 as p2 = pd_index(vaddr);
    let is i64 as p1 = pt_index(vaddr);

    let is i64 as pml4_virt = pmm.phys_to_virt(pml4_phys);
    let is i64 as is_kas with mut = 0;
    if (pml4_phys == kas_pml4_phys) {
        is_kas = 1;
    }

    // Table flags: user-space addresses need PTE_USER at every level
    let is i64 as tflags with mut = PTE_TABLE;
    if (vaddr <= USER_SPACE_END) {
        tflags = PTE_TABLE_USER;
    }

    let is i64 as pdpt = ensure_table(pml4_phys, pml4_virt, p4, tflags, is_kas);
    let is i64 as pd = ensure_table(pdpt, 0, p3, tflags, is_kas);
    let is i64 as pt = ensure_table(pd, 0, p2, tflags, is_kas);

    // Check double-map
    let is i64 as existing = pte_read(pt, p1);
    if (pte_present(existing) != 0) {
        pmm.panic("vmm_map_page: already mapped", 28);
    }

    pte_write(pt, p1, (phys & PTE_ADDR_MASK) | flags);
    return 0;
}

// ============================================================
// vmm_unmap_page — unmap 4KB page, return old phys addr
// ============================================================

fn vmm_unmap_page(pml4_phys as i64, vaddr as i64) as i64 {
    let is i64 as pte4 = pte_read(pml4_phys, pml4_index(vaddr));
    if (pte_present(pte4) == 0) { return 0; }

    let is i64 as pte3 = pte_read(pte_addr(pte4), pdpt_index(vaddr));
    if (pte_present(pte3) == 0) { return 0; }

    let is i64 as pte2 = pte_read(pte_addr(pte3), pd_index(vaddr));
    if (pte_present(pte2) == 0) { return 0; }

    let is i64 as pt_phys = pte_addr(pte2);
    let is i64 as p1 = pt_index(vaddr);
    let is i64 as pte1 = pte_read(pt_phys, p1);
    if (pte_present(pte1) == 0) { return 0; }

    let is i64 as old_phys = pte_addr(pte1);
    pte_write(pt_phys, p1, 0);
    invlpg(vaddr);
    return old_phys;
}

// ============================================================
// vmm_remap_page — change flags without unmap
// ============================================================

fn vmm_remap_page(pml4_phys as i64, vaddr as i64, new_flags as i64) as void {
    let is i64 as pte4 = pte_read(pml4_phys, pml4_index(vaddr));
    if (pte_present(pte4) == 0) { pmm.panic("remap: pml4 absent", 18); }
    let is i64 as pte3 = pte_read(pte_addr(pte4), pdpt_index(vaddr));
    if (pte_present(pte3) == 0) { pmm.panic("remap: pdpt absent", 18); }
    let is i64 as pte2 = pte_read(pte_addr(pte3), pd_index(vaddr));
    if (pte_present(pte2) == 0) { pmm.panic("remap: pd absent", 16); }

    let is i64 as pt_phys = pte_addr(pte2);
    let is i64 as p1 = pt_index(vaddr);
    let is i64 as pte1 = pte_read(pt_phys, p1);
    if (pte_present(pte1) == 0) { pmm.panic("remap: pt absent", 16); }

    let is i64 as phys = pte_addr(pte1);
    pte_write(pt_phys, p1, phys | new_flags);
    invlpg(vaddr);
}

// ============================================================
// vmm_map_range — map N contiguous pages
// ============================================================

fn vmm_map_range(pml4_phys as i64, vaddr as i64, phys as i64, count as i64, flags as i64) as i64 {
    let is i64 as i with mut = 0;
    while (i < count) {
        let is i64 as r = vmm_map_page(pml4_phys,
            vaddr + i * pmm.PAGE_SIZE,
            phys + i * pmm.PAGE_SIZE,
            flags);
        if (r != 0) {
            // Rollback
            let is i64 as j with mut = 0;
            while (j < i) {
                vmm_unmap_page(pml4_phys, vaddr + j * pmm.PAGE_SIZE);
                j = j + 1;
            }
            return 0 - 1;
        }
        i = i + 1;
    }
    return 0;
}

// ============================================================
// virt_to_phys_walk — full page walk with huge page support
// ============================================================

fn virt_to_phys_walk(pml4_phys as i64, vaddr as i64) as i64 {
    let is i64 as pte4 = pte_read(pml4_phys, pml4_index(vaddr));
    if (pte_present(pte4) == 0) { return 0; }

    let is i64 as pte3 = pte_read(pte_addr(pte4), pdpt_index(vaddr));
    if (pte_present(pte3) == 0) { return 0; }
    if ((pte3 & PTE_HUGE) != 0) {
        return pte_addr(pte3) + (vaddr & 0x3FFFFFFF);
    }

    let is i64 as pte2 = pte_read(pte_addr(pte3), pd_index(vaddr));
    if (pte_present(pte2) == 0) { return 0; }
    if ((pte2 & PTE_HUGE) != 0) {
        return pte_addr(pte2) + (vaddr & 0x1FFFFF);
    }

    let is i64 as pte1 = pte_read(pte_addr(pte2), pt_index(vaddr));
    if (pte_present(pte1) == 0) { return 0; }
    return pte_addr(pte1) + (vaddr & 0xFFF);
}

// Like virt_to_phys_walk but returns the leaf PTE itself (address +
// flags) rather than the flat phys address. Returns 0 when any
// level is non-present, so the caller can both check existence and
// inspect the USER / WRITE / NX bits in one go.
fn pte_lookup(pml4_phys as i64, vaddr as i64) as i64 {
    let is i64 as pte4 = pte_read(pml4_phys, pml4_index(vaddr));
    if (pte_present(pte4) == 0) { return 0; }
    let is i64 as pte3 = pte_read(pte_addr(pte4), pdpt_index(vaddr));
    if (pte_present(pte3) == 0) { return 0; }
    if ((pte3 & PTE_HUGE) != 0) { return pte3; }
    let is i64 as pte2 = pte_read(pte_addr(pte3), pd_index(vaddr));
    if (pte_present(pte2) == 0) { return 0; }
    if ((pte2 & PTE_HUGE) != 0) { return pte2; }
    let is i64 as pte1 = pte_read(pte_addr(pte2), pt_index(vaddr));
    if (pte_present(pte1) == 0) { return 0; }
    return pte1;
}

// ============================================================
// User address space create/destroy/switch
// ============================================================

fn as_create() as i64 {
    let is i64 as pml4_phys = alloc_table_page(cast(i32, 0));
    let is i64 as pml4_virt = pmm.phys_to_virt(pml4_phys);

    // Lock: copy kernel entries + register atomically to prevent
    // race with kernel_pml4_sync (new entry could be missed otherwise)
    let is i64 as flags = lock.acquire_irq(&vmm_lock);

    // Copy kernel entries (256-511) from kernel AS
    let is *i64 as ksrc = cast(*i64, kas_pml4_virt);
    let is *i64 as udst = cast(*i64, pml4_virt);
    let is i64 as i with mut = PML4_KERNEL_START;
    while (i <= PML4_KERNEL_END) {
        udst[i] = ksrc[i];
        i = i + 1;
    }

    // Register for sync
    if (user_as_count < MAX_USER_AS) {
        user_as_set(user_as_count, pml4_virt);
        user_as_count = user_as_count + 1;
    }

    lock.release_irq(&vmm_lock, flags);

    return pml4_phys;
}

// Validate that a physical page is actually a page table page before freeing
fn validate_pt_page(phys as i64) as void {
    let is i32 as pfn = pmm.phys_to_pfn(phys);
    if (pmm.page_present(pfn) != cast(i32, 0)) {
        let is i32 as usage = pmm.page_usage(pfn);
        if (usage != cast(i32, pmm.USAGE_PAGE_TABLE)) {
            pmm.panic("as_free: not a PT page", 22);
        }
    }
}

fn free_pt_page(phys as i64) as void {
    validate_pt_page(phys);
    pmm.free_pages(pmm.phys_to_pfn(phys), cast(i32, 0));   // page tables are single pages
}

fn as_free_user_tables(pml4_phys as i64) as void {
    let is i64 as p4 with mut = 0;
    while (p4 < PML4_KERNEL_START) {
        let is i64 as pte4 = pte_read(pml4_phys, p4);
        if (pte_present(pte4) != 0) {
            let is i64 as pdpt_phys = pte_addr(pte4);
            let is i64 as p3 with mut = 0;
            while (p3 < 512) {
                let is i64 as pte3 = pte_read(pdpt_phys, p3);
                if (pte_present(pte3) != 0) {
                    if ((pte3 & PTE_HUGE) == 0) {
                        let is i64 as pd_phys = pte_addr(pte3);
                        let is i64 as p2 with mut = 0;
                        while (p2 < 512) {
                            let is i64 as pte2 = pte_read(pd_phys, p2);
                            if (pte_present(pte2) != 0) {
                                if ((pte2 & PTE_HUGE) == 0) {
                                    free_pt_page(pte_addr(pte2));
                                }
                            }
                            p2 = p2 + 1;
                        }
                        free_pt_page(pd_phys);
                    }
                }
                p3 = p3 + 1;
            }
            free_pt_page(pdpt_phys);
        }
        p4 = p4 + 1;
    }
}

fn as_destroy(pml4_phys as i64) as void {
    as_free_user_tables(pml4_phys);
    // Free PML4 page itself
    pmm.free_pages(pmm.phys_to_pfn(pml4_phys), cast(i32, 0));

    // Remove from sync list
    let is i64 as pml4_virt = pmm.phys_to_virt(pml4_phys);
    let is i64 as i with mut = 0;
    while (i < user_as_count) {
        if (user_as_get(i) == pml4_virt) {
            // Shift remaining entries
            let is i64 as j with mut = i;
            while (j < user_as_count - 1) {
                user_as_set(j, user_as_get(j + 1));
                j = j + 1;
            }
            user_as_count = user_as_count - 1;
            return;
        }
        i = i + 1;
    }
}

fn as_switch(pml4_phys as i64) as void {
    write_cr3(pml4_phys);
}

// ============================================================
// User mapping helpers
// ============================================================

fn vmm_map_user_page(pml4_phys as i64, vaddr as i64, phys as i64, flags as i64) as i64 {
    if (vaddr > USER_SPACE_END) {
        pmm.panic("map_user: not user addr", 23);
    }
    return vmm_map_page(pml4_phys, vaddr, phys, flags);
}

fn vmm_alloc_user_page(pml4_phys as i64, vaddr as i64, flags as i64) as i64 {
    let is i32 as pfn = pmm.alloc_pages(
        pmm.ALLOC_ZERO,
        cast(i32, 0), pmm.USAGE_KERNEL, cast(i32, 0)
    );
    if (pfn == pmm.PFN_NONE) { return 0 - 1; }

    let is i64 as r = vmm_map_user_page(pml4_phys, vaddr, pmm.pfn_to_phys(pfn), flags);
    if (r != 0) {
        pmm.free_pages(pfn, cast(i32, 0));   // user pages are single pages
        return 0 - 1;
    }
    return 0;
}

// Smallest order (power-of-2 pages) whose block covers `v` pages. A generic
// helper, kept on the vmm (surface.acquire_fb sizes its contiguous backbuffer
// with it); unrelated to the deleted region allocators it used to sit next to.
fn ceil_log2(v as i64) as i32 {
    if (v <= 1) { return cast(i32, 0); }
    let is i32 as n with mut = 0;
    let is i64 as x with mut = v - 1;
    while (x > 0) {
        n = n + cast(i32, 1);
        x = x >> 1;
    }
    return n;
}

// Program IA32_PAT so PA1 = write-combining. Per-CPU MSR: called on the
// BSP at the end of vmm.init and on every AP from smp.ap_entry. Done early,
// before any WC mapping exists, so a TLB flush is enough (no cache line
// holds the old memory type yet). Shuttles the value through a global to
// avoid relying on the arg register surviving the prologue (same pattern
// as read_cr3); clobbers rax/rbx/rcx/rdx (caller-saved here).
fn pat_init() as void {
    pat_shuttle = PAT_VALUE;
    asm("lea rbx, [rip+_kernel_vmm_cst_pat_shuttle]\n");
    asm("mov rax, QWORD PTR [rbx]\n");   // full value
    asm("mov rdx, rax\n");
    asm("shr rdx, 32\n");                // edx = high 32, eax = low 32
    asm("mov ecx, 0x277\n");             // IA32_PAT
    asm(".byte 0x0F, 0x30\n");           // wrmsr
    flush_tlb_full();
}

// ============================================================
// kvmap implementation
//
// Lock discipline (ordering sched > vmm > heap > pmm): the free-list/used-list
// mutations run under vmm_lock; kvx_new/kvx_free reach the kpool (heap_lock)
// from inside vmm_lock — never the inverse. vmm_map_page may re-take vmm_lock
// via kernel_pml4_sync, so all mapping happens OUTSIDE the lock (same rule the
// old kvalloc followed).
// ============================================================

// Out-of-line extent node alloc/free (kpool-backed). Callers hold vmm_lock;
// the kpool is self-locking on heap_lock, so the nesting is vmm > heap.
fn kvx_new() as i64 {
    let is i64 as n = heap.kpool_alloc(kv_node_pool);
    if (n == 0) { pmm.panic("kvmap: node pool OOM", 20); }
    return n;
}

fn kvx_free(n as i64) as void {
    heap.kpool_free(kv_node_pool, n);
}

// Caller holds vmm_lock. First-fit a free extent >= span, split it: shrink
// from the front (keeps the list address-ordered) or, if consumed whole,
// unlink and recycle the node. Returns the base VA, or 0 if the window can't
// satisfy the request (exhausted / too fragmented).
fn kv_va_reserve(span as i64) as i64 {
    let is i64 as prev with mut = 0;
    let is i64 as cur with mut = kv_free_head;
    while (cur != 0) {
        let is *KvExtent as c = cast(*KvExtent, cur);
        if (c.len >= span) {
            let is i64 as base = c.va_start;
            if (c.len == span) {
                if (prev == 0) { kv_free_head = c.next; }
                else { let is *KvExtent as p = cast(*KvExtent, prev); p.next = c.next; }
                kvx_free(cur);
            } else {
                c.va_start = c.va_start + span;
                c.len = c.len - span;
            }
            return base;
        }
        prev = cur;
        cur = c.next;
    }
    return 0;
}

// Caller holds vmm_lock. Return [base, base+span) to the free-list: insert in
// address order, then coalesce forward (with the next extent) and backward
// (with the prev extent) — the freelist.cst algorithm, at most two merges.
fn kv_va_release(base as i64, span as i64) as void {
    let is i64 as bend = base + span;

    // prev = last free extent strictly before base; cur = first at/after base.
    let is i64 as prev with mut = 0;
    let is i64 as cur with mut = kv_free_head;
    while (cur != 0) {
        let is *KvExtent as c = cast(*KvExtent, cur);
        if (c.va_start >= base) { break; }
        prev = cur;
        cur = c.next;
    }

    // Link a fresh node for the freed range between prev and cur.
    let is i64 as node = kvx_new();
    let is *KvExtent as nb = cast(*KvExtent, node);
    nb.va_start = base;
    nb.len = span;
    nb.kind = 0;
    nb.pfns = 0;
    nb.next = cur;
    if (prev == 0) { kv_free_head = node; }
    else { let is *KvExtent as p = cast(*KvExtent, prev); p.next = node; }

    // Coalesce forward: freed block's end meets cur's start.
    if (cur != 0) {
        let is *KvExtent as c = cast(*KvExtent, cur);
        if (bend == c.va_start) {
            nb.len = nb.len + c.len;
            nb.next = c.next;
            kvx_free(cur);
        }
    }

    // Coalesce backward: prev's end meets the freed block's start.
    if (prev != 0) {
        let is *KvExtent as p = cast(*KvExtent, prev);
        if (p.va_start + p.len == base) {
            p.len = p.len + nb.len;
            p.next = nb.next;
            kvx_free(node);
        }
    }
}

// Caller holds vmm_lock. Prepend an allocated extent to the used-list.
fn kv_used_insert(base as i64, span as i64, kind as i64, pfns as i64) as void {
    let is i64 as node = kvx_new();
    let is *KvExtent as e = cast(*KvExtent, node);
    e.va_start = base;
    e.len = span;
    e.kind = kind;
    e.pfns = pfns;
    e.next = kv_used_head;
    kv_used_head = node;
}

// kvmap — map `size` bytes into the kernel window with the memory type dictated
// by `kind`, returning the virtual base (and the physical base in
// kvmap_result_phys). KV_DATA allocates + zeroes fresh anon frames; KV_MMIO /
// KV_WC map the caller's `phys` as-is (device frames), honouring a sub-page
// phys offset. KV_GUARD (in `flags`, KV_DATA only) brackets the data with an
// unmapped guard page on each side. Returns 0 on failure, with every partial
// allocation rolled back.
fn kvmap(size as i64, kind as i64, flags as i64, phys as i64) as i64 {
    if (size <= 0) { kvmap_result_phys = 0; return 0; }

    // Guard pages apply to KV_DATA only (MMIO/WC map device-owned phys).
    let is i64 as guard with mut = 0;
    if (kind == KV_DATA) {
        if ((flags & KV_GUARD) != 0) { guard = 1; }
    }

    let is i64 as phys_aligned with mut = 0;
    let is i64 as phys_offset  with mut = 0;
    let is i64 as span with mut = 0;
    if (kind == KV_DATA) {
        // span = data pages + one guard page on each side (when guarded).
        span = pmm.align_up(size, pmm.PAGE_SIZE) + guard * 2 * pmm.PAGE_SIZE;
    } else {
        phys_aligned = phys & ~(pmm.PAGE_SIZE - 1);
        phys_offset  = phys - phys_aligned;
        span = pmm.align_up(size + phys_offset, pmm.PAGE_SIZE);
    }
    let is i64 as pages = span / pmm.PAGE_SIZE;

    // 1. Reserve VA under vmm_lock.
    let is i64 as vflags with mut = lock.acquire_irq(&vmm_lock);
    let is i64 as base = kv_va_reserve(span);
    lock.release_irq(&vmm_lock, vflags);
    if (base == 0) { kvmap_result_phys = 0; return 0; }

    // 2. Back + map OUTSIDE vmm_lock.
    if (kind == KV_DATA) {
        // Data occupies the inner pages; the guards (if any) at base and the
        // last page stay unmapped, so an overrun/underrun faults.
        let is i64 as data_pages = pages - guard * 2;
        let is i64 as data_base  = base + guard * pmm.PAGE_SIZE;

        let is i64 as pfn_array = heap.kmalloc(data_pages * 8, cast(i32, 0));
        if (pfn_array == 0) {
            vflags = lock.acquire_irq(&vmm_lock);
            kv_va_release(base, span);
            lock.release_irq(&vmm_lock, vflags);
            kvmap_result_phys = 0;
            return 0;
        }
        let is *i64 as pfns = cast(*i64, pfn_array);
        let is i64 as i with mut = 0;
        while (i < data_pages) {
            let is i32 as pfn = pmm.alloc_pages(
                pmm.ALLOC_ZERO, cast(i32, 0), pmm.USAGE_KERNEL, cast(i32, 0));
            if (pfn == pmm.PFN_NONE) {
                // Rollback the pages mapped so far, the array, then the VA.
                let is i64 as j with mut = 0;
                while (j < i) {
                    vmm_unmap_page(kas_pml4_phys, data_base + j * pmm.PAGE_SIZE);
                    pmm.free_pages(cast(i32, pfns[j]), cast(i32, 0));
                    j = j + 1;
                }
                flush_tlb_range(data_base, i);
                heap.kfree(pfn_array);
                vflags = lock.acquire_irq(&vmm_lock);
                kv_va_release(base, span);
                lock.release_irq(&vmm_lock, vflags);
                kvmap_result_phys = 0;
                return 0;
            }
            pfns[i] = cast(i64, pfn);
            vmm_map_page(kas_pml4_phys, data_base + i * pmm.PAGE_SIZE,
                pmm.pfn_to_phys(pfn), KMAP_DATA);
            i = i + 1;
        }
        flush_tlb_range(data_base, data_pages);

        // 3. Record the allocated extent under vmm_lock. The extent owns the
        //    whole span (guards included); kind carries the guard bit so
        //    kvunmap knows the data window sits one page in.
        let is i64 as storedkind with mut = KV_DATA;
        if (guard == 1) { storedkind = KV_DATA | KV_GUARD; }
        vflags = lock.acquire_irq(&vmm_lock);
        kv_used_insert(base, span, storedkind, pfn_array);
        lock.release_irq(&vmm_lock, vflags);

        kvmap_result_phys = 0;   // anon: no single contiguous phys
        return data_base;
    }

    // KV_MMIO / KV_WC: map the caller's device phys with the right memory type.
    let is i64 as mflags with mut = KMAP_MMIO;
    if (kind == KV_WC) { mflags = KMAP_WC; }
    let is i64 as k with mut = 0;
    while (k < pages) {
        vmm_map_page(kas_pml4_phys, base + k * pmm.PAGE_SIZE,
            phys_aligned + k * pmm.PAGE_SIZE, mflags);
        k = k + 1;
    }
    flush_tlb_range(base, pages);

    vflags = lock.acquire_irq(&vmm_lock);
    kv_used_insert(base, span, kind, 0);
    lock.release_irq(&vmm_lock, vflags);

    kvmap_result_phys = phys_aligned;
    return base + phys_offset;
}

// kvunmap — tear down a mapping created by kvmap, given any VA inside it (the
// returned base, with or without the MMIO sub-page offset). KV_DATA frees its
// frames; MMIO/WC leave the device frames alone. The VA returns to the
// free-list (coalescing) — this is the fix for the old MMIO VA leak.
fn kvunmap(vaddr as i64) as void {
    if (vaddr == 0) { return; }

    // Unlink the extent from the used-list under vmm_lock; snapshot its fields
    // before dropping the lock (unmap re-takes vmm_lock via kernel_pml4_sync).
    let is i64 as vflags with mut = lock.acquire_irq(&vmm_lock);
    let is i64 as prev with mut = 0;
    let is i64 as cur with mut = kv_used_head;
    while (cur != 0) {
        let is *KvExtent as c = cast(*KvExtent, cur);
        if (vaddr >= c.va_start && vaddr < c.va_start + c.len) { break; }
        prev = cur;
        cur = c.next;
    }
    if (cur == 0) {
        lock.release_irq(&vmm_lock, vflags);
        pmm.panic("kvunmap: unknown vaddr", 22);
    }
    let is *KvExtent as e = cast(*KvExtent, cur);
    let is i64 as base = e.va_start;
    let is i64 as span = e.len;
    let is i64 as kind = e.kind;
    let is i64 as pfns = e.pfns;
    if (prev == 0) { kv_used_head = e.next; }
    else { let is *KvExtent as p = cast(*KvExtent, prev); p.next = e.next; }
    kvx_free(cur);
    lock.release_irq(&vmm_lock, vflags);

    // Decode the guard bit: a guarded KV_DATA extent has its data one page in
    // and two fewer mapped pages (the guards were never mapped).
    let is i64 as basekind with mut = kind;
    let is i64 as data_off with mut = 0;
    let is i64 as map_pages with mut = span / pmm.PAGE_SIZE;
    if ((kind & KV_GUARD) != 0) {
        basekind = kind - KV_GUARD;
        data_off = 1;
        map_pages = map_pages - 2;
    }
    let is i64 as data_base = base + data_off * pmm.PAGE_SIZE;

    // Unmap the mapped pages (guard pages were never present).
    let is i64 as i with mut = 0;
    while (i < map_pages) {
        vmm_unmap_page(kas_pml4_phys, data_base + i * pmm.PAGE_SIZE);
        i = i + 1;
    }
    flush_tlb_range(data_base, map_pages);

    // Free the backing frames only for KV_DATA (MMIO/WC frames are the device's).
    if (basekind == KV_DATA) {
        if (pfns != 0) {
            let is *i64 as pa = cast(*i64, pfns);
            let is i64 as f with mut = 0;
            while (f < map_pages) {
                pmm.free_pages(cast(i32, pa[f]), cast(i32, 0));
                f = f + 1;
            }
            heap.kfree(pfns);
        }
    }

    // Return the whole span (guards included) to the free-list (coalescing).
    vflags = lock.acquire_irq(&vmm_lock);
    kv_va_release(base, span);
    lock.release_irq(&vmm_lock, vflags);
}

// Initialize the kvmap window: a kpool for the out-of-line nodes plus one free
// extent spanning the whole window. Runs once on the BSP in vmm.init, after
// heap.init (main.cst ordering) so the kpool is available. APs share the
// window (protected by vmm_lock); they never re-init it.
fn kvmap_init() as void {
    kv_node_pool = heap.kpool_create(sizeof(KvExtent), 1);   // debug=1: double-free gate
    kv_free_head = 0;
    kv_used_head = 0;
    let is i64 as node = heap.kpool_alloc(kv_node_pool);
    if (node == 0) { pmm.panic("kvmap_init: node pool OOM", 25); }
    let is *KvExtent as e = cast(*KvExtent, node);
    e.va_start = KVMAP_BASE;
    e.len = KVMAP_SIZE;
    e.kind = 0;
    e.pfns = 0;
    e.next = 0;
    kv_free_head = node;
}

// kvmap_smoke — replaces the kvalloc/dma self-tests in vmm.init. Proves the
// three kinds round-trip, that KV_GUARD leaves the guard pages unmapped, and,
// critically, that KV_MMIO unmap RECLAIMS VA (the bug Phase C fixes): map+unmap
// the same phys N times must reuse the VA, not march a cursor off the window.
// Single-threaded at boot; pat_init already ran for the BSP (KV_WC needs
// PA1=WC). Fail-loud.
fn kvmap_smoke() as void {
    serial.println("kvmap_smoke: start", 18);
    let is i32 as ok with mut = cast(i32, 1);

    // 1. KV_DATA round-trip: write/read a sentinel through a fresh anon page.
    let is i64 as d = kvmap(4096, KV_DATA, 0, 0);
    if (d == 0) { ok = cast(i32, 0); }
    else {
        let is *i64 as dp = cast(*i64, d);
        dp[0] = 0xCAFEBABE;
        if (dp[0] != 0xCAFEBABE) { ok = cast(i32, 0); }
        kvunmap(d);
    }

    // 2. KV_MMIO no-leak: map+unmap the LAPIC page (0xFEE00000, UC; present on
    //    QEMU + real hw, never dereferenced) 64x. With the old bump cursor each
    //    map consumed a fresh span; with the free-list the released VA coalesces
    //    back to the window front, so every returned VA equals the first.
    let is i64 as first with mut = 0;
    let is i64 as reused with mut = 1;
    let is i64 as n with mut = 0;
    while (n < 64) {
        let is i64 as m = kvmap(4096, KV_MMIO, 0, 0xFEE00000);
        if (m == 0) { ok = cast(i32, 0); n = 64; }
        else {
            if (n == 0) { first = m; }
            else { if (m != first) { reused = 0; } }
            kvunmap(m);
        }
        n = n + 1;
    }
    if (reused == 0) { ok = cast(i32, 0); }

    // 3. KV_WC round-trip on the same phys (write-combining map path).
    let is i64 as w = kvmap(4096, KV_WC, 0, 0xFEE00000);
    if (w == 0) { ok = cast(i32, 0); }
    else { kvunmap(w); }

    // 4. KV_GUARD: a guarded KV_DATA page is mapped, but the page on each side
    //    is NOT (an overrun/underrun would #PF). We assert via the page walk
    //    rather than faulting: data page resolves, both guards resolve to 0.
    let is i64 as g = kvmap(4096, KV_DATA, KV_GUARD, 0);
    if (g == 0) { ok = cast(i32, 0); }
    else {
        let is *i64 as gp = cast(*i64, g);
        gp[0] = 0xFEEDFACE;
        if (gp[0] != 0xFEEDFACE) { ok = cast(i32, 0); }
        if (virt_to_phys_walk(kas_pml4_phys, g) == 0) { ok = cast(i32, 0); }            // data mapped
        if (virt_to_phys_walk(kas_pml4_phys, g - 4096) != 0) { ok = cast(i32, 0); }     // lower guard unmapped
        if (virt_to_phys_walk(kas_pml4_phys, g + 4096) != 0) { ok = cast(i32, 0); }     // upper guard unmapped
        kvunmap(g);
    }

    // 5. After all the churn the window is whole again: one free extent over the
    //    entire span (every reserve was released + coalesced), nothing allocated.
    if (kv_free_head == 0) { ok = cast(i32, 0); }
    else {
        let is *KvExtent as fh = cast(*KvExtent, kv_free_head);
        if (fh.va_start != KVMAP_BASE) { ok = cast(i32, 0); }
        if (fh.len != KVMAP_SIZE) { ok = cast(i32, 0); }
        if (fh.next != 0) { ok = cast(i32, 0); }
    }
    if (kv_used_head != 0) { ok = cast(i32, 0); }

    if (ok == cast(i32, 1)) { serial.println("kvmap_smoke: PASS", 17); }
    else { pmm.panic("kvmap_smoke FAILED", 18); }
}

// ============================================================
// Init
// ============================================================

fn init() as void {
    serial.println("vmm: init", 9);

    // Init constants
    PTE_ADDR_MASK = 0x000FFFFFFFFFF000;
    PTE_NX = 1 << 63;
    PTE_TABLE = PTE_PRESENT | PTE_WRITE | PTE_NX;
    // User-space intermediate tables intentionally OMIT NX. NX in a
    // non-leaf entry forces every page reachable through it to be
    // non-executable, regardless of the leaf flag — that would make
    // any user code page faulting on instruction-fetch even when the
    // mapping itself permits exec. Leaving NX on the leaf only is
    // the right choice; per-page NX still works for data pages
    // because the leaf carries it.
    PTE_TABLE_USER = PTE_PRESENT | PTE_WRITE | PTE_USER;
    KMAP_DATA = PTE_PRESENT | PTE_WRITE | PTE_NX;
    KMAP_MMIO = PTE_PRESENT | PTE_WRITE | PTE_NX | PTE_PCD | PTE_PWT;
    KMAP_WC   = PTE_PRESENT | PTE_WRITE | PTE_NX | PTE_PWT;   // PA1 reprogrammed to WC
    USER_SPACE_END = 0x00007FFFFFFFFFFF;

    // Read Limine's PML4
    let is i64 as limine_pml4 = read_cr3() & PTE_ADDR_MASK;
    serial.print("  limine cr3=", 13);
    util.print_hex(limine_pml4);
    serial.println("", 0);

    // Allocate kernel PML4
    kas_pml4_phys = alloc_table_page(cast(i32, 0));
    kas_pml4_virt = pmm.phys_to_virt(kas_pml4_phys);

    // Deep clone Limine's kernel page table tree (entries 256-511).
    // Limine's PT pages may reside in bootloader-reclaimable memory
    // which the PMM treats as usable. If we only copy PML4 entries
    // (shallow clone), the underlying PDPT/PD/PT pages could be
    // overwritten by buddy allocations. We must allocate our own
    // copies of the entire tree.
    let is *i64 as lsrc = cast(*i64, pmm.phys_to_virt(limine_pml4));
    let is *i64 as kdst = cast(*i64, kas_pml4_virt);
    let is i64 as i with mut = PML4_KERNEL_START;
    while (i <= PML4_KERNEL_END) {
        let is i64 as pml4e = lsrc[i];
        if (pte_present(pml4e) != 0) {
            // Clone PDPT
            let is i64 as old_pdpt = pte_addr(pml4e);
            let is i64 as new_pdpt = alloc_table_page(cast(i32, 0));
            let is *i64 as osrc = cast(*i64, pmm.phys_to_virt(old_pdpt));
            let is *i64 as ndst = cast(*i64, pmm.phys_to_virt(new_pdpt));
            let is i64 as j with mut = 0;
            while (j < 512) {
                let is i64 as pdpte = osrc[j];
                if (pte_present(pdpte) != 0) {
                    if ((pdpte & PTE_HUGE) != 0) {
                        // 1GB huge page — keep as-is (points to data, not a table)
                        ndst[j] = pdpte;
                    } else {
                        // Clone PD
                        let is i64 as old_pd = pte_addr(pdpte);
                        let is i64 as new_pd = alloc_table_page(cast(i32, 0));
                        let is *i64 as pd_src = cast(*i64, pmm.phys_to_virt(old_pd));
                        let is *i64 as pd_dst = cast(*i64, pmm.phys_to_virt(new_pd));
                        let is i64 as k with mut = 0;
                        while (k < 512) {
                            let is i64 as pde = pd_src[k];
                            if (pte_present(pde) != 0) {
                                if ((pde & PTE_HUGE) != 0) {
                                    // 2MB huge page — keep as-is
                                    pd_dst[k] = pde;
                                } else {
                                    // Clone PT
                                    let is i64 as old_pt = pte_addr(pde);
                                    let is i64 as new_pt = alloc_table_page(cast(i32, 0));
                                    let is *i64 as pt_src = cast(*i64, pmm.phys_to_virt(old_pt));
                                    let is *i64 as pt_dst = cast(*i64, pmm.phys_to_virt(new_pt));
                                    let is i64 as m with mut = 0;
                                    while (m < 512) {
                                        pt_dst[m] = pt_src[m];
                                        m = m + 1;
                                    }
                                    // Rewrite PD entry to point to cloned PT
                                    pd_dst[k] = new_pt | (pde & 0xFFF);
                                }
                            }
                            k = k + 1;
                        }
                        // Rewrite PDPT entry to point to cloned PD
                        ndst[j] = new_pd | (pdpte & 0xFFF);
                    }
                }
                j = j + 1;
            }
            // Rewrite PML4 entry to point to cloned PDPT
            kdst[i] = new_pdpt | (pml4e & 0xFFF);
        }
        i = i + 1;
    }

    // Switch to our fully-cloned PML4
    write_cr3(kas_pml4_phys);
    serial.print("  kernel cr3=", 13);
    util.print_hex(kas_pml4_phys);
    serial.println("", 0);

    // Self-test: page walk.
    let is i64 as tv = cast(i64, &kas_pml4_phys);
    let is i64 as tp = virt_to_phys_walk(kas_pml4_phys, tv);
    serial.print("  walk: ", 8);
    util.print_hex(tv);
    serial.print("->", 2);
    util.print_hex(tp);
    serial.println("", 0);

    // Seed the kvmap window (kpool + one free extent) before any kvmap use.
    kvmap_init();

    // Write-combining PAT entry for the BSP. APs run pat_init() themselves
    // from ap_entry, after they load this PML4. Must precede kvmap_smoke's
    // KV_WC test (PA1=WC).
    pat_init();

    // Exercise kvmap (KV_DATA/KV_MMIO/KV_WC + the MMIO no-leak proof). Replaces
    // the old kvalloc + dma self-tests.
    kvmap_smoke();

    serial.println("vmm: ready", 10);
}
