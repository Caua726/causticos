// vma.cst — virtual memory area tracker for user address spaces.
//
// Keeps the per-aspace bookkeeping that vmm.cst's raw page-table API
// can't hold on its own: which VA ranges have been claimed, what
// protection they carry, which file (eventually) backs them, etc.
// vmm.cst owns the page tables; vma.cst owns the higher-level
// "is this address mapped?" answer.
//
// Aspace = pml4_phys (the kernel page-table handle from vmm) + a
// sorted list of Vma nodes. mmap_anon and munmap go through the
// aspace, which maintains both the VMA list and the page-table
// mappings together. Existing low-level callers (`vmm.vmm_map_page`)
// still work — they just bypass VMA tracking.
//
// VMA list is a simple doubly-linked sorted-by-start list. Number
// of VMAs per process is small (text, data, bss, stack, a few
// mmap'd regions), so O(N) insert/find is fine for now. Future
// large workloads can swap in an rb-tree without changing the
// public API.

use "serial.cst" as serial;
use "util.cst" as util;
use "heap.cst" as heap;
use "pmm.cst" as pmm;
use "vmm.cst" as vmm;
use "lock.cst" as lock;
use "kobject.cst" as kobject;
use "abi.cst" as abi;
use "sched.cst" as sched;

// ============================================================
// Constants — flags + helpers
// ============================================================

// Prot is the leaf-PTE bit set the VMA carries. Stored as the same
// PTE_* values vmm.cst uses so consumers can pass it straight into
// vmm_map_page without translation.
let is i64 as PROT_NONE   = 0;                          // not mapped
let is i64 as PROT_READ   = 1;                          // PTE_PRESENT
let is i64 as PROT_WRITE  = 2;                          // PTE_WRITE
let is i64 as PROT_USER   = 4;                          // PTE_USER
let is i64 as PROT_NX     = 0x8000000000000000;         // PTE_NX (bit 63)

// vma.flags semantic bits — independent of the PTE leaf bits.
let is i64 as VMA_ANON    = 1;                          // backed by zero pages
let is i64 as VMA_FILE    = 2;                          // file-backed (future)
let is i64 as VMA_FIXED   = 4;                          // hint must be honoured
let is i64 as VMA_GROWSDOWN = 8;                        // user stack

let is i64 as USER_VA_MAX = 0x00007FFFFFFFFFFF;

// ============================================================
// Data model
// ============================================================

struct Vma {
    start as i64;            // inclusive, page-aligned
    end as i64;              // exclusive, page-aligned
    prot as i64;             // PTE leaf flags
    flags as i64;            // VMA_* bitmask
    file_offset as i64;      // 0 for VMA_ANON
    file_handle as i64;      // 0 for VMA_ANON (later: *VfsFile)
    ko as i64;               // KObject this mapping holds a reference to, or 0
    next as *Vma;
    prev as *Vma;
    // (A reserved `pager` field for a userspace-pager / AUTOFILL endpoint was
    // here; removed — demand paging is rejected by the strict design. The fault
    // policy is fixed in mem_handle_fault, not delegated per-VMA.)
}

// Per-aspace file descriptor table: small int → KObject. The first
// FD_TABLE_CAP slots are inline in the Aspace, which is all most processes
// ever use; past them the table moves to the kernel heap and doubles as it
// fills (fd_grow). It was a fixed 64, and a shell running a dozen jobs —
// three or four channels each — ran out of descriptors, which it had to
// report as a full job table. What bounds it now is what bounds everything
// else a process holds: memory, charged to the process (bookkeeping_bytes)
// and checked against its budget like any other.
let is i64 as FD_TABLE_CAP = 64;
let is i64 as FD_INDEX_LIMIT = 67108864;    // 2^26 slots = 512 MiB of table

struct Aspace {
    pml4_phys as i64;
    vma_head as *Vma;
    vma_count as i64;
    lk as lock.TicketLock;
    // FD table: the first FD_TABLE_CAP slots inline; index is the fd
    // number, value is the KObject cast to i64 (0 = closed). Once it grows,
    // the whole table lives at fd_ext (see fd_grow) and this one is unused.
    fd_count as i64;
    fd_entries as [64]i64;
    // Accounting (Phase E), NOT a quota. committed_bytes = anon RAM backed;
    // bookkeeping_bytes = VMAs * sizeof(Vma) (lives in the kernel but charged
    // to the process); budget = self-imposed ceiling (0 = unlimited until a
    // parent grants one at spawn, Phase G). commit/reserve pre-check against
    // budget AND the real pmm free count. Appended last — existing offsets
    // unchanged. Zeroed by aspace_create's ALLOC_ZERO.
    committed_bytes as i64;
    bookkeeping_bytes as i64;
    budget as i64;
    // Initial user-stack size for this aspace's main thread, granted by the
    // spawner (Phase G pattern, like budget). 0 = use elf.USER_STACK_SIZE
    // default. Eager-committed at spawn (strict reserve/commit — no growing
    // stack, no demand paging); overflowing it past the grant is a fatal bug,
    // exactly like touching any reserved-not-committed page. Appended last.
    stack_size as i64;
    // Stack-growth mode for caustic dynamic-stack programs. 0 = strict eager
    // commit (above): stack_size is committed in full and that's the wall.
    // 1 = explicit growth: stack_size is the RESERVE CEILING; the loader
    // reserves it but commits only elf.INITIAL_STACK_COMMIT at the top, and the
    // program's prologue probes commit more via SYS_COMMIT as the call chain
    // descends — program-driven growth, NOT demand paging (a fault on
    // reserved-not-committed stack is still fatal; the probe just commits
    // first). Set from the CSE header flags byte (0x07 bit0). Appended last.
    stack_dynamic as i64;
    // The cached image this aspace was loaded from (imgcache slot + 1, so a
    // zeroed Aspace means "none"). Its read-only frames are mapped here and
    // owned by the cache; teardown drops the reference so the cache can
    // eventually take them back. Appended last.
    img_ref as i64;
    // The fd table once it has outgrown fd_entries: a kernel-heap array of
    // fd_ext_cap slots (0 = still inline). Charged to bookkeeping_bytes.
    // Appended last.
    fd_ext as i64;
    fd_ext_cap as i64;
    // Where the loader put the first thread's block (elf.THREAD_BLOCK_*), in
    // this aspace's top stack page; that thread's fs base. 0 = none (an
    // aspace built by hand, not loaded). Appended last.
    main_block as i64;
}

fn lk_ptr(a as *Aspace) as *lock.TicketLock {
    return &a.lk;
}

// Set by main.cst to imgcache.release. A function pointer rather than an
// import because vma is BELOW imgcache (imgcache maps through vma), and a
// `use` back up would close a cycle — which segfaults the compiler with no
// diagnostic. Composition lives in main, the way every other cycle here is
// broken.
let is i64 as img_release_fn with mut = 0;

fn set_img_release(fp as i64) as void { img_release_fn = fp; }

// ============================================================
// Aspace alloc / free
// ============================================================

fn aspace_create() as *Aspace {
    let is i64 as addr = heap.kmalloc(sizeof(Aspace), pmm.ALLOC_ZERO);
    if (addr == 0) { return cast(*Aspace, 0); }
    let is *Aspace as a = cast(*Aspace, addr);
    a.pml4_phys = vmm.as_create();
    if (a.pml4_phys == 0) {
        heap.kfree(addr);
        return cast(*Aspace, 0);
    }
    a.vma_head = cast(*Vma, 0);
    a.vma_count = 0;
    return a;
}

fn aspace_pml4(a as *Aspace) as i64 {
    if (cast(i64, a) == 0) { return 0; }
    return a.pml4_phys;
}

// aspace_rss_bytes — the HONEST resident set: every page this aspace actually
// has mapped, counted by walking the VMA list and probing each page's PTE.
// Unlike committed_bytes (anon-only), this includes VMA_FILE regions — a
// surface's backbuffer (DEV_FB) and shared segments (KOBJ_SEGMENT) — so a
// compositor's RSS shows the 4 MiB it maps instead of that RAM vanishing into
// "the kernel". A shared page (surface/segment mapped by N holders) counts in
// each holder's RSS, so summed RSS can exceed physical RAM — that is correct
// for a resident-set metric. O(pages) but the VMA count + page count per user
// aspace is small; the monitor calls this at human cadence. Caller need not
// hold the lock (read-only PTE probes; a racing map/unmap only skews a snapshot
// a monitor already tolerates), but we take it for a coherent VMA walk.
fn aspace_rss_bytes(a as *Aspace) as i64 {
    if (cast(i64, a) == 0) { return 0; }
    lock.acquire(lk_ptr(a));
    let is i64 as present with mut = 0;
    let is *Vma as cur with mut = a.vma_head;
    while (cast(i64, cur) != 0) {
        let is i64 as p with mut = cur.start;
        while (p < cur.end) {
            if (vmm.pte_lookup(a.pml4_phys, p) != 0) { present = present + 1; }
            p = p + pmm.PAGE_SIZE;
        }
        cur = cur.next;
    }
    lock.release(lk_ptr(a));
    return present * pmm.PAGE_SIZE;
}

// Tear down every VMA + every backing page + the user page tables
// + the Aspace struct itself. Caller is responsible for guaranteeing
// no thread is currently running against this aspace (i.e. it isn't
// the active CR3 on any cpu) — that's the job of the future
// process-exit path; this function just does the bookkeeping.
fn aspace_destroy(a as *Aspace) as void {
    if (cast(i64, a) == 0) { return; }
    // Close every fd still open before tearing down memory: a process
    // that exits with open fds must not leak its KObjects. The drain runs
    // first so a surface's close op (which frees its backbuffer pages) and
    // a file's (which returns the VfsFile to the pool) happen while the
    // aspace is still coherent. No concurrency: the contract is that no
    // thread runs against this aspace anymore.
    fd_table_drain(a);
    lock.acquire(lk_ptr(a));
    let is *Vma as v with mut = a.vma_head;
    while (cast(i64, v) != 0) {
        let is *Vma as next = v.next;
        unmap_vma_pages(a.pml4_phys, v, cast(i32, 0));   // dying aspace: no remote TLB
        if (v.ko != 0) { kobject.ko_unref(v.ko); }       // the pages are unmapped: let go
        heap.kpool_free(vma_pool, cast(i64, v));
        v = next;
    }
    a.vma_head = cast(*Vma, 0);
    a.vma_count = 0;
    lock.release(lk_ptr(a));
    vmm.as_destroy(a.pml4_phys);
    // Drop the image reference AFTER the mappings are gone: while a page table
    // still points at the cache's frames, the cache must not be free to reuse
    // them. VMA_FILE already kept the teardown above from freeing them.
    if (a.img_ref != 0 && img_release_fn != 0) {
        call(cast(fn(i64) as void, img_release_fn), a.img_ref - 1);
    }
    heap.kfree(cast(i64, a));
}

// ============================================================
// VMA list ops (caller holds aspace lock)
// ============================================================

// Typed pool (Phase B sub-phase 2). Created lazily on the first vma_alloc.
let is i64 as vma_pool with mut = 0;

fn vma_alloc(start as i64, end as i64, prot as i64, flags as i64) as *Vma {
    // No ALLOC_ZERO needed: all nine fields are set below.
    let is i64 as addr = heap.kpool_alloc_ensure(cast(i64, &vma_pool), sizeof(Vma), 1);
    if (addr == 0) { return cast(*Vma, 0); }
    let is *Vma as v = cast(*Vma, addr);
    v.start = start;
    v.end = end;
    v.prot = prot;
    v.flags = flags;
    v.file_offset = 0;
    v.file_handle = 0;
    v.ko = 0;
    v.next = cast(*Vma, 0);
    v.prev = cast(*Vma, 0);
    return v;
}

// Insert v into a's list, keeping it sorted by start ascending.
// Caller has already guaranteed v doesn't overlap any existing VMA.
fn vma_insert_sorted(a as *Aspace, v as *Vma) as void {
    let is *Vma as cur with mut = a.vma_head;
    let is *Vma as prev with mut = cast(*Vma, 0);
    while (cast(i64, cur) != 0) {
        if (cur.start >= v.end) { cur = cast(*Vma, 0); }
        else {
            prev = cur;
            cur = cur.next;
        }
    }
    // Insert v after prev (or at head if prev is null).
    if (cast(i64, prev) == 0) {
        v.next = a.vma_head;
        v.prev = cast(*Vma, 0);
        if (cast(i64, a.vma_head) != 0) { a.vma_head.prev = v; }
        a.vma_head = v;
    } else {
        v.next = prev.next;
        v.prev = prev;
        if (cast(i64, prev.next) != 0) { prev.next.prev = v; }
        prev.next = v;
    }
    a.vma_count = a.vma_count + 1;
}

fn vma_unlink(a as *Aspace, v as *Vma) as void {
    if (cast(i64, v.prev) == 0) { a.vma_head = v.next; }
    else                         { v.prev.next = v.next; }
    if (cast(i64, v.next) != 0) { v.next.prev = v.prev; }
    a.vma_count = a.vma_count - 1;
}

// Returns the Vma covering `va`, or null if no Vma covers it.
fn vma_find(a as *Aspace, va as i64) as *Vma {
    let is *Vma as cur with mut = a.vma_head;
    while (cast(i64, cur) != 0) {
        if (va >= cur.start && va < cur.end) { return cur; }
        if (cur.start > va) { return cast(*Vma, 0); }
        cur = cur.next;
    }
    return cast(*Vma, 0);
}

// True iff the half-open range [start, end) overlaps any existing VMA.
fn vma_range_overlaps(a as *Aspace, start as i64, end as i64) as i32 {
    let is *Vma as cur with mut = a.vma_head;
    while (cast(i64, cur) != 0) {
        if (start < cur.end && cur.start < end) { return 1; }
        if (cur.start >= end) { return 0; }
        cur = cur.next;
    }
    return 0;
}

// Pick the lowest user VA ≥ hint where a `len`-byte window fits
// without overlapping any existing VMA. Returns -1 if no fit found.
fn vma_find_free_va(a as *Aspace, hint as i64, len as i64) as i64 {
    let is i64 as start with mut = hint;
    if (start < pmm.PAGE_SIZE) { start = pmm.PAGE_SIZE; }   // never give va 0
    let is *Vma as cur with mut = a.vma_head;
    while (cast(i64, cur) != 0) {
        if (start + len <= cur.start) { return start; }
        if (cur.end > start) { start = cur.end; }
        cur = cur.next;
    }
    if (start + len <= USER_VA_MAX) { return start; }
    return cast(i64, 0 - 1);
}

// ============================================================
// Page-table backing
// ============================================================

fn page_align_down(v as i64) as i64 {
    return v & cast(i64, 0 - 1) - 0xFFF;
}

fn page_align_up(v as i64) as i64 {
    return (v + 0xFFF) & (cast(i64, 0 - 1) - 0xFFF);
}

// Allocate one zero-filled page and map it into pml4 at va with the
// VMA's prot bits + the always-required PRESENT/USER flags. Returns
// 0 on success, -1 on allocator / mapper failure.
fn back_anon_page(pml4 as i64, va as i64, prot as i64) as i32 {
    let is i32 as pfn = pmm.alloc_pages(
        pmm.ALLOC_ZERO,
        cast(i32, 0), pmm.USAGE_KERNEL, cast(i32, 0)
    );
    if (pfn == pmm.PFN_NONE) { return cast(i32, 0 - 1); }
    let is i64 as phys = pmm.pfn_to_phys(pfn);
    let is i64 as full = vmm.PTE_PRESENT | vmm.PTE_USER | prot;
    let is i64 as rc = vmm.vmm_map_range(pml4, va, phys, 1, full);
    if (rc != 0) {
        pmm.free_pages(pfn, cast(i32, 0));
        return cast(i32, 0 - 1);
    }
    return 0;
}

// Frames per TLB-shootdown batch. The frames freed by one unmap pass are
// buffered, the whole chunk unmapped (local invlpg per page), ONE shootdown
// fires for the chunk, then the chunk's frames free — so a freed frame is never
// reused while a stale remote TLB entry points at it, but we pay one IPI per
// chunk instead of per page. 64 i64 = 512 B on the stack.
let is i64 as TLB_BATCH = 64;

// Unmap npages from `start`, freeing the present anon frames (is_file==0 →
// VMA_FILE frames belong to the owner, unmap only). Batched: per chunk, unmap +
// collect phys, one shootdown if any anon frame will be freed (and
// do_shootdown), then free. Returns the anon page count freed (committed_bytes
// delta). do_shootdown=0 for a dying aspace (no cpu holds its CR3).
fn tlb_batch_unmap_free(pml4 as i64, start as i64, npages as i64,
                        is_file as i64, do_shootdown as i32) as i64 {
    let is [64]i64 as phys_buf;
    let is i64 as freed with mut = 0;
    let is i64 as done with mut = 0;
    while (done < npages) {
        let is i64 as chunk with mut = npages - done;
        if (chunk > TLB_BATCH) { chunk = TLB_BATCH; }
        let is i64 as nfree with mut = 0;
        let is i64 as i with mut = 0;
        while (i < chunk) {
            let is i64 as old = vmm.vmm_unmap_page(pml4, start + (done + i) * pmm.PAGE_SIZE);
            if (old != 0 && is_file == 0) {
                phys_buf[nfree] = old;
                nfree = nfree + 1;
            }
            i = i + 1;
        }
        if (nfree > 0 && do_shootdown == cast(i32, 1)) {
            sched.tlb_shootdown(pml4, start + done * pmm.PAGE_SIZE, chunk);
        }
        let is i64 as f with mut = 0;
        while (f < nfree) {
            pmm.free_pages(pmm.phys_to_pfn(phys_buf[f]), cast(i32, 0));
            f = f + 1;
        }
        freed = freed + nfree;
        done = done + chunk;
    }
    return freed;
}

// Unmap a whole VMA's pages, freeing its anon frames. Returns the anon page
// count freed (the committed_bytes delta in release_locked). do_shootdown=0 for
// aspace_destroy (dying aspace is no cpu's active CR3).
fn unmap_vma_pages(pml4 as i64, v as *Vma, do_shootdown as i32) as i64 {
    let is i64 as is_file = v.flags & VMA_FILE;
    let is i64 as npages = (v.end - v.start) / pmm.PAGE_SIZE;
    return tlb_batch_unmap_free(pml4, v.start, npages, is_file, do_shootdown);
}

// ============================================================
// reserve / commit / decommit / release — the strict split (Phase E)
//
// reserve = the VMA's existence (VA claimed, ZERO pages backed). commit = back
// the absent pages with fresh zero frames. "committed" is STRUCTURAL: a page is
// committed iff its PTE is present; there is no per-page state field. decommit
// drops the frames but keeps the reservation; release (munmap) removes the VMA.
// The legacy SYS_MMAP path = reserve+commit-eager in one shot (mmap_anon below).
// The *_locked primitives assume the caller holds the aspace lock.
// ============================================================

// reserve_locked: claim a `len`-byte VA window at `va_hint` (VMA_FIXED) or the
// first free spot (else), create the VMA, and return its start VA — backing
// NOTHING. Returns -1 on overlap / no-fit / OOM.
fn reserve_locked(a as *Aspace, va_hint as i64, len as i64,
                  prot as i64, flags as i64) as i64 {
    let is i64 as start with mut = page_align_down(va_hint);
    let is i64 as size = page_align_up(len);

    if ((flags & VMA_FIXED) != 0) {
        if (vma_range_overlaps(a, start, start + size) != 0) {
            return cast(i64, 0 - 1);
        }
    } else {
        let is i64 as picked = vma_find_free_va(a, start, size);
        if (picked < 0) { return cast(i64, 0 - 1); }
        start = picked;
    }

    // Budget pre-check: the new VMA's bookkeeping must fit (0 = unlimited).
    if (a.budget != 0) {
        if (a.committed_bytes + a.bookkeeping_bytes + sizeof(Vma) > a.budget) {
            return cast(i64, 0 - 1);
        }
    }

    let is *Vma as v = vma_alloc(start, start + size, prot, flags | VMA_ANON);
    if (cast(i64, v) == 0) { return cast(i64, 0 - 1); }
    vma_insert_sorted(a, v);
    a.bookkeeping_bytes = a.bookkeeping_bytes + sizeof(Vma);
    return start;
}

// commit_locked: back every not-yet-present page in [vaddr, vaddr+len) with a
// fresh zero frame. Every page must fall inside a reserved VMA (else E_INVAL).
// Already-present pages are skipped (idempotent; avoids the double-map panic).
// Returns 0 / E_INVAL / E_NOMEM. On allocator failure the pages this call
// backed are rolled back (the range is reserved-and-absent by construction:
// reserve backs nothing, commit is the only backer).
fn commit_locked(a as *Aspace, vaddr as i64, len as i64, prot as i64) as i32 {
    if (len <= 0) { return cast(i32, abi.E_INVAL); }
    let is i64 as start = page_align_down(vaddr);
    let is i64 as end = page_align_up(vaddr + len);

    // Coverage check + count the absent pages this call would back. Every page
    // must be inside a reserved VMA (else E_INVAL).
    let is i64 as absent with mut = 0;
    let is i64 as c with mut = start;
    while (c < end) {
        if (cast(i64, vma_find(a, c)) == 0) { return cast(i32, abi.E_INVAL); }
        if (vmm.pte_lookup(a.pml4_phys, c) == 0) { absent = absent + 1; }
        c = c + pmm.PAGE_SIZE;
    }
    if (absent == 0) { return 0; }   // fully committed already (idempotent)
    let is i64 as need_bytes = absent * pmm.PAGE_SIZE;

    // PRE-CHECK before touching anything → honest E_NOMEM with no rollback on
    // the normal path. Budget (if set) AND the real physical free count. The
    // pmm.free_total read races other allocators, but it's only a fast reject;
    // back_anon_page under pmm_lock is the authority and rolls back on failure.
    if (a.budget != 0) {
        if (a.committed_bytes + a.bookkeeping_bytes + need_bytes > a.budget) {
            return cast(i32, abi.E_NOMEM);
        }
    }
    if (cast(i64, pmm.free_total) < absent) { return cast(i32, abi.E_NOMEM); }

    let is i64 as p with mut = start;
    while (p < end) {
        if (vmm.pte_lookup(a.pml4_phys, p) == 0) {
            if (back_anon_page(a.pml4_phys, p, prot) != 0) {
                // Roll back the pages backed so far in this call.
                let is i64 as q with mut = start;
                while (q < p) {
                    let is i64 as old = vmm.vmm_unmap_page(a.pml4_phys, q);
                    if (old != 0) { pmm.free_pages(pmm.phys_to_pfn(old), cast(i32, 0)); }
                    q = q + pmm.PAGE_SIZE;
                }
                return cast(i32, abi.E_NOMEM);
            }
        }
        p = p + pmm.PAGE_SIZE;
    }
    a.committed_bytes = a.committed_bytes + need_bytes;
    return 0;
}

// decommit_locked: drop the frames backing [vaddr, vaddr+len), keeping the
// reservation (the VMA stays). All anon, so the batch helper frees every present
// page with a batched cross-cpu shootdown before reuse.
fn decommit_locked(a as *Aspace, vaddr as i64, len as i64) as void {
    let is i64 as start = page_align_down(vaddr);
    let is i64 as end = page_align_up(vaddr + len);
    let is i64 as npages = (end - start) / pmm.PAGE_SIZE;
    let is i64 as dropped = tlb_batch_unmap_free(a.pml4_phys, start, npages, 0, cast(i32, 1));
    a.committed_bytes = a.committed_bytes - dropped * pmm.PAGE_SIZE;
}

// unmap_range_pages: unmap [os, oe) of a live aspace (partial-overlap munmap),
// freeing the present anon frames (VMA_FILE frames belong to the owner). Thin
// wrapper over the batch helper. Returns the anon page count freed.
fn unmap_range_pages(pml4 as i64, os as i64, oe as i64, is_file as i64) as i64 {
    let is i64 as npages = (oe - os) / pmm.PAGE_SIZE;
    return tlb_batch_unmap_free(pml4, os, npages, is_file, cast(i32, 1));
}

// release_locked: unmap [start, end) — the real munmap. A VMA may be wholly
// inside the range (removed), straddle one end (trimmed head or tail), or
// contain the range (split in two). Only the overlapping pages are decommitted;
// the surviving VMA halves keep their pages. Returns 1 if anything changed.
fn release_locked(a as *Aspace, start as i64, end as i64) as i32 {
    let is *Vma as cur with mut = a.vma_head;
    let is i32 as changed with mut = 0;
    while (cast(i64, cur) != 0) {
        let is i64 as vs = cur.start;
        let is i64 as ve = cur.end;
        if (vs >= end) { cur = cast(*Vma, 0); }        // sorted: past the range, stop
        else {
            let is *Vma as next = cur.next;
            if (ve <= start) {                          // entirely before the range
                cur = next;
            } else {
                // Overlap [os, oe). Decommit just those pages.
                let is i64 as os with mut = vs;
                if (start > os) { os = start; }
                let is i64 as oe with mut = ve;
                if (end < oe) { oe = end; }
                let is i64 as is_file = cur.flags & VMA_FILE;
                let is i64 as freed = unmap_range_pages(a.pml4_phys, os, oe, is_file);
                a.committed_bytes = a.committed_bytes - freed * pmm.PAGE_SIZE;
                changed = 1;

                if (vs >= start) {
                    if (ve <= end) {
                        // wholly inside → remove the VMA
                        a.bookkeeping_bytes = a.bookkeeping_bytes - sizeof(Vma);
                        vma_unlink(a, cur);
                        // Unmapped above (and shot down), so the object may now
                        // free what it backed. Its close op takes no aspace lock.
                        if (cur.ko != 0) { kobject.ko_unref(cur.ko); }
                        heap.kpool_free(vma_pool, cast(i64, cur));
                    } else {
                        cur.start = end;                // straddles the low end → trim head
                    }
                } else {
                    if (ve <= end) {
                        cur.end = start;                // straddles the high end → trim tail
                    } else {
                        // range in the middle → split into [vs,start) and [end,ve)
                        let is *Vma as nv = vma_alloc(end, ve, cur.prot, cur.flags);
                        if (cast(i64, nv) != 0) {
                            nv.file_handle = cur.file_handle;
                            nv.file_offset = cur.file_offset + (end - vs);
                            // Two mappings now, each holding the object.
                            nv.ko = cur.ko;
                            if (nv.ko != 0) { kobject.ko_ref(nv.ko); }
                            cur.end = start;
                            vma_insert_sorted(a, nv);
                            a.bookkeeping_bytes = a.bookkeeping_bytes + sizeof(Vma);
                        } else {
                            cur.end = start;            // OOM: keep the head; tail reservation lost
                        }
                    }
                }
                cur = next;
            }
        }
    }
    return changed;
}

// ============================================================
// Public mmap / munmap
// ============================================================

// mmap_anon: the legacy eager path = reserve + commit in one shot, under a
// single lock so it stays atomic (rollback removes the reservation on commit
// failure). `prot` already carries PTE_USER/PTE_WRITE/PTE_NX (no PTE_PRESENT —
// back_anon_page adds it). VMA_FIXED honours the exact hint or fails.
// Returns the start VA, or -1 on overlap / OOM.
fn mmap_anon(a as *Aspace, va_hint as i64, len as i64,
             prot as i64, flags as i64) as i64 {
    if (cast(i64, a) == 0) { return cast(i64, 0 - 1); }
    if (len <= 0) { return cast(i64, 0 - 1); }

    let is i64 as size = page_align_up(len);
    lock.acquire(lk_ptr(a));

    let is i64 as start = reserve_locked(a, va_hint, len, prot, flags);
    if (start < 0) {
        lock.release(lk_ptr(a));
        return cast(i64, 0 - 1);
    }

    if (commit_locked(a, start, size, prot) != cast(i32, 0)) {
        // Undo the reservation (and any partial backing) and fail.
        release_locked(a, start, start + size);
        lock.release(lk_ptr(a));
        return cast(i64, 0 - 1);
    }

    lock.release(lk_ptr(a));
    return start;
}

// munmap = release: drop every VMA fully inside [va, va+len). Partial-overlap
// split is left for later; today's user code only unmaps whole regions.
fn munmap(a as *Aspace, va as i64, len as i64) as i32 {
    if (cast(i64, a) == 0) { return cast(i32, 0 - 1); }
    let is i64 as start = page_align_down(va);
    let is i64 as end = page_align_up(va + len);
    lock.acquire(lk_ptr(a));
    let is i32 as removed = release_locked(a, start, end);
    lock.release(lk_ptr(a));
    if (removed == 0) { return cast(i32, 0 - 1); }
    return 0;
}

// reserve: claim a VA window, back nothing. Returns start VA or -1.
fn reserve(a as *Aspace, va_hint as i64, len as i64,
           prot as i64, flags as i64) as i64 {
    if (cast(i64, a) == 0) { return cast(i64, 0 - 1); }
    if (len <= 0) { return cast(i64, 0 - 1); }
    lock.acquire(lk_ptr(a));
    let is i64 as start = reserve_locked(a, va_hint, len, prot, flags);
    lock.release(lk_ptr(a));
    return start;
}

// commit: back [vaddr, vaddr+len) with zero frames. Returns 0 / E_INVAL / E_NOMEM.
fn commit(a as *Aspace, vaddr as i64, len as i64, prot as i64) as i32 {
    if (cast(i64, a) == 0) { return cast(i32, abi.E_INVAL); }
    lock.acquire(lk_ptr(a));
    let is i32 as rc = commit_locked(a, vaddr, len, prot);
    lock.release(lk_ptr(a));
    return rc;
}

// decommit: drop the frames for [vaddr, vaddr+len), keep the reservation.
fn decommit(a as *Aspace, vaddr as i64, len as i64) as i32 {
    if (cast(i64, a) == 0) { return cast(i32, abi.E_INVAL); }
    lock.acquire(lk_ptr(a));
    decommit_locked(a, vaddr, len);
    lock.release(lk_ptr(a));
    return 0;
}

// mmap_phys: map an existing physically-contiguous range
// [phys, phys + npages*PAGE) into the aspace as ONE VMA_FILE region. The
// backing object (passed as `owner`, kept on the VMA for reference) owns
// the pages; this VMA only maps them, so munmap/teardown unmaps without
// freeing (see unmap_vma_pages). Used by surface mmap to expose a
// kernel-allocated backbuffer to its holder. Returns the user VA, or -1.
// The mapping at `va` (made just now by an object's mmap op) holds a reference
// to that object from here on, dropped when the mapping goes. A surface or a
// segment owns the pages its mappings point at and frees them when its last
// reference goes; while only the fd counted, closing the fd of a still-mapped
// surface freed pages the process could go on reading and writing — pages the
// allocator was free to hand to anyone else. 0, or -1 if no mapping starts at va.
fn attach_object(a as *Aspace, va as i64, ko as i64) as i32 {
    if (cast(i64, a) == 0 || ko == 0) { return cast(i32, 0 - 1); }
    lock.acquire(lk_ptr(a));
    let is *Vma as v with mut = a.vma_head;
    while (cast(i64, v) != 0) {
        if (v.start == va) {
            if (v.ko == 0) {
                kobject.ko_ref(ko);
                v.ko = ko;
            }
            lock.release(lk_ptr(a));
            return 0;
        }
        v = v.next;
    }
    lock.release(lk_ptr(a));
    return cast(i32, 0 - 1);
}

fn mmap_phys(a as *Aspace, phys as i64, npages as i64,
             prot as i64, owner as i64) as i64 {
    if (cast(i64, a) == 0) { return cast(i64, 0 - 1); }
    if (npages <= 0) { return cast(i64, 0 - 1); }
    let is i64 as size = npages * pmm.PAGE_SIZE;
    lock.acquire(lk_ptr(a));

    let is i64 as start = vma_find_free_va(a, pmm.PAGE_SIZE, size);
    if (start < 0) {
        lock.release(lk_ptr(a));
        return cast(i64, 0 - 1);
    }
    let is *Vma as v = vma_alloc(start, start + size, prot, VMA_FILE);
    if (cast(i64, v) == 0) {
        lock.release(lk_ptr(a));
        return cast(i64, 0 - 1);
    }
    v.file_handle = owner;
    // A VMA is a VMA: it lives in the kernel and is charged to the process, the
    // same as one from reserve. These two mappers were the ones not charging,
    // which mattered little for a surface but not for an image — a program's
    // segments come in through here on every spawn.
    a.bookkeeping_bytes = a.bookkeeping_bytes + sizeof(Vma);

    let is i64 as full = vmm.PTE_PRESENT | vmm.PTE_USER | prot;
    let is i64 as rc = vmm.vmm_map_range(a.pml4_phys, start, phys, npages, full);
    if (rc != 0) {
        heap.kpool_free(vma_pool, cast(i64, v));
        a.bookkeeping_bytes = a.bookkeeping_bytes - sizeof(Vma);
        lock.release(lk_ptr(a));
        return cast(i64, 0 - 1);
    }
    vma_insert_sorted(a, v);
    lock.release(lk_ptr(a));
    return start;
}

// mmap_pages: like mmap_phys, but the frames are NON-contiguous — `pfns_ptr` is
// an array of `npages` page-frame numbers, mapped one-by-one to a contiguous VA
// window. Used by a page-list segment (>4 MiB or non-contiguous). VMA_FILE, so
// teardown unmaps without freeing (the segment owns the frames). Returns the VA.
fn mmap_pages(a as *Aspace, pfns_ptr as i64, npages as i64,
              prot as i64, owner as i64) as i64 {
    return mmap_pages_at(a, 0, pfns_ptr, npages, prot, owner);
}

// mmap_pages_at: mmap_pages with the VA named. `va_hint` 0 = pick one (what
// mmap_pages does); non-zero = honour it exactly or fail, the VMA_FIXED
// contract. A loaded image needs this: its segments carry the vaddrs the
// linker assigned, and its frames are a page LIST (allocated one at a time,
// so they are never physically contiguous). One VMA per segment instead of
// one per page — a 1 MiB image is 256 pages, and the bookkeeping is charged
// to the process.
fn mmap_pages_at(a as *Aspace, va_hint as i64, pfns_ptr as i64, npages as i64,
                 prot as i64, owner as i64) as i64 {
    if (cast(i64, a) == 0) { return cast(i64, 0 - 1); }
    if (npages <= 0) { return cast(i64, 0 - 1); }
    if (pfns_ptr == 0) { return cast(i64, 0 - 1); }
    let is i64 as size = npages * pmm.PAGE_SIZE;
    lock.acquire(lk_ptr(a));

    let is i64 as start with mut = va_hint;
    if (va_hint == 0) {
        start = vma_find_free_va(a, pmm.PAGE_SIZE, size);
    } else if (vma_range_overlaps(a, va_hint, va_hint + size) != 0) {
        // The window is already claimed. Honouring the hint "as close as
        // possible" would put a segment somewhere its own code does not
        // expect; failing is the only honest answer.
        start = cast(i64, 0 - 1);
    }
    if (start < 0) {
        lock.release(lk_ptr(a));
        return cast(i64, 0 - 1);
    }
    let is *Vma as v = vma_alloc(start, start + size, prot, VMA_FILE);
    if (cast(i64, v) == 0) {
        lock.release(lk_ptr(a));
        return cast(i64, 0 - 1);
    }
    v.file_handle = owner;
    a.bookkeeping_bytes = a.bookkeeping_bytes + sizeof(Vma);

    let is *i64 as pfns = cast(*i64, pfns_ptr);
    let is i64 as full = vmm.PTE_PRESENT | vmm.PTE_USER | prot;
    let is i64 as i with mut = 0;
    while (i < npages) {
        vmm.vmm_map_page(a.pml4_phys, start + i * pmm.PAGE_SIZE,
            pmm.pfn_to_phys(cast(i32, pfns[i])), full);
        i = i + 1;
    }
    vma_insert_sorted(a, v);
    lock.release(lk_ptr(a));
    return start;
}

// ============================================================
// File descriptor table — fd → *VfsFile (cast to i64). Each open
// VFS file in this aspace gets a small integer fd; user code passes
// fds across the syscall boundary; the kernel resolves fd → file.
//
// fd 0 / 1 / 2 are RESERVED for stdin/stdout/stderr, and reserved means
// reserved: fd_alloc never returns them, empty or not. Only fd_install —
// which names the index it wants, and is what a spawn's fdacts uses — can
// put anything there.
//
// This used to say "unless the slot is genuinely empty", which described
// the bug rather than the policy. A program launched as /init has no stdio
// installed, so those slots ARE empty, so the first fd it received landed
// on 1 — and from that moment every write to stdout went down whatever
// that descriptor was. The way it showed up: a test handed a daemon channel
// to a child, and the daemon started reading the test's own progress output
// as protocol messages. Nothing failed where the mistake was made.
//
// A program with no stdout still prints, because a write to an empty fd 1
// falls back to the serial console (std/os/causticos.cst). That fallback is
// what makes leaving the slot empty safe, and what makes filling it by
// accident silent.
// ============================================================

// The first descriptor a caller may be handed without asking for it.
let is i64 as FD_FIRST_DYNAMIC = 3;
// The shell maps this presence-only fd when stderr reaches a terminal.
let is i64 as FD_STDERR_TTY = 9;

// The table and how many slots it has, wherever it lives now. A table only
// moves under the aspace lock, so a caller reading either without it may only
// be one no other thread can race (a process being built, teardown).
fn _fdt(a as *Aspace) as *i64 {
    if (a.fd_ext != 0) { return cast(*i64, a.fd_ext); }
    return cast(*i64, &a.fd_entries[0]);
}
fn fd_capacity(a as *Aspace) as i64 {
    if (a.fd_ext != 0) { return a.fd_ext_cap; }
    return FD_TABLE_CAP;
}

// fd_grow — make the table hold slot `need`: double it (at least) onto the
// kernel heap, copy, and swap it in under the lock. Called WITHOUT the lock
// (the allocation can take time); a table some other thread grew meanwhile
// is fine as long as it now holds `need`. 0, or E_NOMEM — out of memory, or
// past the budget the process was granted.
fn fd_grow(a as *Aspace, need as i64) as i64 {
    let is i64 as cur = fd_capacity(a);
    if (need < cur) { return 0; }
    // A slot this far up would take a table of half a gigabyte: no machine
    // this runs on has that to give, and doubling toward it must not overflow.
    if (need >= FD_INDEX_LIMIT) { return abi.E_NOMEM; }
    let is i64 as ncap with mut = cur * 2;
    while (ncap <= need) { ncap = ncap * 2; }
    let is i64 as nbytes = ncap * 8;
    let is i64 as obytes with mut = 0;
    if (a.fd_ext != 0) { obytes = a.fd_ext_cap * 8; }
    if (a.budget != 0 && a.committed_bytes + a.bookkeeping_bytes + nbytes - obytes > a.budget) {
        return abi.E_NOMEM;
    }
    let is i64 as nt = heap.kmalloc(nbytes, pmm.ALLOC_ZERO);
    if (nt == 0) { return abi.E_NOMEM; }
    lock.acquire(lk_ptr(a));
    let is i64 as now_cap = fd_capacity(a);
    if (need < now_cap) {                            // grown meanwhile
        lock.release(lk_ptr(a));
        heap.kfree(nt);
        return 0;
    }
    let is *i64 as src = _fdt(a);
    let is *i64 as dst = cast(*i64, nt);
    let is i64 as i with mut = 0;
    while (i < now_cap) { dst[i] = src[i]; i = i + 1; }
    let is i64 as old = a.fd_ext;
    let is i64 as old_bytes with mut = 0;
    if (old != 0) { old_bytes = a.fd_ext_cap * 8; }
    a.fd_ext = nt;
    a.fd_ext_cap = ncap;
    a.bookkeeping_bytes = a.bookkeeping_bytes + nbytes - old_bytes;
    lock.release(lk_ptr(a));
    if (old != 0) { heap.kfree(old); }
    return 0;
}

// The object at `fd`, WITHOUT a reference: only for an aspace no other thread
// can be using (a process still being built, a smoke test). A syscall uses
// fd_hold or fd_take — between this load and the use, a sibling thread can
// close the fd and drop the last reference, and the kernel would be using a
// freed object.
fn fd_get(a as *Aspace, fd as i64) as i64 {
    if (cast(i64, a) == 0) { return 0; }
    if (fd < 0) { return 0; }
    if (fd >= fd_capacity(a)) { return 0; }
    let is *i64 as t = _fdt(a);
    return t[fd];
}

fn fd_set(a as *Aspace, fd as i64, file as i64) as void {
    if (cast(i64, a) == 0) { return; }
    if (fd < 0) { return; }
    if (fd >= fd_capacity(a)) { return; }
    let is *i64 as t = _fdt(a);
    t[fd] = file;
}

// The object at `fd` with a reference taken for the caller, under the table
// lock — so a close racing it either happens first (0, E_BADF) or leaves the
// object alive until the caller's kobject.ko_unref. 0 for an empty slot.
fn fd_take(a as *Aspace, fd as i64) as i64 {
    if (cast(i64, a) == 0) { return 0; }
    if (fd < 0) { return 0; }
    lock.acquire(lk_ptr(a));
    if (fd >= fd_capacity(a)) { lock.release(lk_ptr(a)); return 0; }
    let is *i64 as t = _fdt(a);
    let is i64 as ko = t[fd];
    if (ko != 0) { kobject.ko_ref(ko); }
    lock.release(lk_ptr(a));
    return ko;
}

// fd_take for the length of the current syscall: the reference is parked in
// the calling thread (THR_HELD0/1) and dropped by fd_release_held on the way
// back to ring 3 (lifecycle.at_user_boundary), so a handler with a dozen exits
// cannot leak it on one. Two per syscall (sys_fd_send needs a channel and the
// object it sends); asking for a third is a kernel bug and gets 0 — the
// caller's E_BADF — rather than an untracked reference.
fn fd_hold(a as *Aspace, fd as i64) as i64 {
    let is i64 as tid = sched.current_tid();
    let is i64 as slot with mut = 0;
    if (sched.thr_get(tid, sched.THR_HELD0) == 0) { slot = sched.THR_HELD0; }
    else if (sched.thr_get(tid, sched.THR_HELD1) == 0) { slot = sched.THR_HELD1; }
    else {
        serial.println("vma: fd_hold: a third fd held in one syscall - refused", 54);
        return 0;
    }
    let is i64 as ko = fd_take(a, fd);
    if (ko != 0) { sched.thr_set(tid, slot, ko); }
    return ko;
}

// Drop whatever the current syscall held. Two loads when there is nothing.
fn fd_release_held() as void {
    let is i64 as tid = sched.current_tid();
    let is i64 as k0 = sched.thr_get(tid, sched.THR_HELD0);
    if (k0 != 0) {
        sched.thr_set(tid, sched.THR_HELD0, 0);
        kobject.ko_unref(k0);
    }
    let is i64 as k1 = sched.thr_get(tid, sched.THR_HELD1);
    if (k1 != 0) {
        sched.thr_set(tid, sched.THR_HELD1, 0);
        kobject.ko_unref(k1);
    }
}

// Take the object out of `fd` and hand the caller the table's reference: the
// slot is emptied and the object returned in one hold of the lock. Two threads
// closing one fd used to both read the object, both clear the slot, and both
// drop "the" reference — one more than there was. 0 if the slot was empty.
fn fd_remove(a as *Aspace, fd as i64) as i64 {
    if (cast(i64, a) == 0) { return 0; }
    if (fd < 0) { return 0; }
    lock.acquire(lk_ptr(a));
    if (fd >= fd_capacity(a)) { lock.release(lk_ptr(a)); return 0; }
    let is *i64 as t = _fdt(a);
    let is i64 as ko = t[fd];
    if (ko != 0) {
        t[fd] = 0;
        a.fd_count = a.fd_count - 1;
    }
    lock.release(lk_ptr(a));
    return ko;
}

// Find the lowest empty slot at or above FD_FIRST_DYNAMIC, install `file`,
// return the fd — growing the table when every slot is taken. -1 when it
// cannot grow (no memory, or past the process's budget).
fn fd_alloc(a as *Aspace, file as i64) as i64 {
    if (cast(i64, a) == 0) { return cast(i64, 0 - 1); }
    if (file == 0) { return cast(i64, 0 - 1); }
    while (1 == 1) {
        lock.acquire(lk_ptr(a));
        let is *i64 as t = _fdt(a);
        let is i64 as cap = fd_capacity(a);
        let is i64 as i with mut = FD_FIRST_DYNAMIC;
        while (i < cap) {
            if (i != FD_STDERR_TTY && t[i] == 0) {
                t[i] = file;
                a.fd_count = a.fd_count + 1;
                lock.release(lk_ptr(a));
                return i;
            }
            i = i + 1;
        }
        lock.release(lk_ptr(a));
        if (fd_grow(a, cap) != 0) { return cast(i64, 0 - 1); }
    }
    return cast(i64, 0 - 1);
}

// Install at a specific fd; fails (returns -1) if the slot is
// already occupied or the index is out of range. Used by the loader
// to pin fd 0 / 1 / 2.
fn fd_install(a as *Aspace, fd as i64, file as i64) as i32 {
    if (cast(i64, a) == 0) { return cast(i32, 0 - 1); }
    if (fd < 0) { return cast(i32, 0 - 1); }
    if (fd_grow(a, fd) != 0) { return cast(i32, 0 - 1); }
    lock.acquire(lk_ptr(a));
    let is *i64 as t = _fdt(a);
    if (t[fd] != 0) {
        lock.release(lk_ptr(a));
        return cast(i32, 0 - 1);
    }
    t[fd] = file;
    a.fd_count = a.fd_count + 1;
    lock.release(lk_ptr(a));
    return 0;
}

fn fd_close(a as *Aspace, fd as i64) as i32 {
    if (cast(i64, a) == 0) { return cast(i32, 0 - 1); }
    if (fd < 0) { return cast(i32, 0 - 1); }
    lock.acquire(lk_ptr(a));
    if (fd >= fd_capacity(a)) { lock.release(lk_ptr(a)); return cast(i32, 0 - 1); }
    let is *i64 as t = _fdt(a);
    if (t[fd] == 0) {
        lock.release(lk_ptr(a));
        return cast(i32, 0 - 1);
    }
    t[fd] = 0;
    a.fd_count = a.fd_count - 1;
    lock.release(lk_ptr(a));
    return 0;
}

// Close every fd still open in this aspace: drop each KObject's fd
// reference. The last reference runs the object's close op — a file
// returns its VfsFile to the pool, a surface frees its backbuffer pages.
// Without this, a process that exits with open fds leaks the KObject (and,
// for a surface, framebuffer pages — worse than a VfsFile). Called by
// aspace_destroy on process teardown; no lock, since by then no thread
// runs against this aspace.
fn fd_table_drain(a as *Aspace) as void {
    if (cast(i64, a) == 0) { return; }
    let is *i64 as t = _fdt(a);
    let is i64 as cap = fd_capacity(a);
    let is i64 as i with mut = 0;
    while (i < cap) {
        if (t[i] != 0) {
            kobject.ko_unref(t[i]);
            t[i] = 0;
        }
        i = i + 1;
    }
    a.fd_count = 0;
    if (a.fd_ext != 0) {
        heap.kfree(a.fd_ext);
        a.bookkeeping_bytes = a.bookkeeping_bytes - a.fd_ext_cap * 8;
        a.fd_ext = 0;
        a.fd_ext_cap = 0;
    }
}

// ============================================================
// Debug
// ============================================================

fn dump(a as *Aspace) as void {
    if (cast(i64, a) == 0) { serial.println("aspace: <null>", 14); return; }
    lock.acquire(lk_ptr(a));
    serial.print("aspace pml4=", 12);
    util.print_hex(a.pml4_phys);
    serial.print(" vmas=", 6);
    util.print_num(a.vma_count);
    serial.println("", 0);
    let is *Vma as cur with mut = a.vma_head;
    while (cast(i64, cur) != 0) {
        serial.print("  vma [", 7);
        util.print_hex(cur.start);
        serial.print(", ", 2);
        util.print_hex(cur.end);
        serial.print(") prot=", 7);
        util.print_hex(cur.prot);
        serial.print(" flags=", 7);
        util.print_hex(cur.flags);
        serial.println("", 0);
        cur = cur.next;
    }
    lock.release(lk_ptr(a));
}

// ============================================================
// Fault dispatch — the L4 policy seam (fault-as-event)
// ============================================================

// mem_handle_fault — the single entry the #PF handler (idt.cst, vector==14)
// routes every page fault through, BEFORE the generic kill/panic path. Return:
//   0  = handled — the handler does iretq and the CPU re-executes the
//        faulting instruction over the now-valid mapping.
//   !=0 = fatal — the handler falls through to its existing kill (user) /
//        panic (kernel), now with cr2 in the log.
//
// This is the mechanism half of "memory as a driver": a fault becomes an event
// dispatched to the active policy. Policy #0 is `strict`, and under the current
// eager mmap (no RESERVED/COMMITTED state, no demand paging — those are Phase
// E) a #PF can only mean a genuine bug: a real null/wild deref, a stack overrun
// past the guard, a kernel pointer error. So strict returns fatal for every
// fault → behaviour is identical to pre-D, only now cr2 is captured and logged.
//
// Phase E fills this seam: look up the VMA covering cr2, and if its state is
// RESERVED (touched-but-not-committed) treat it as fatal, if COMMITTED it can't
// fault, and if it carries a `pager` endpoint delegate the fault to that
// userspace pager (AUTOFILL). The arguments and the return contract are already
// the shape E needs, so E changes only this function body, not its callers.
fn mem_handle_fault(cr2 as i64, errcode as i64, rip as i64,
                    fault_rsp as i64, cs as i64) as i32 {
    // Kernel-mode fault: never touch the aspace lock. The faulting kernel path
    // may itself hold that lock (e.g. a bug inside commit_locked), and this
    // handler runs on the SAME cpu — re-acquiring would deadlock. A kernel #PF
    // is always a bug under the strict model, so return fatal immediately.
    if ((cs & 3) != 3) { return cast(i32, 1); }

    // User-mode fault. Under the strict model it is fatal whatever covers cr2:
    // nothing is ever paged in, so a missing PTE in a reserved VMA is a bug
    // exactly like one outside any VMA. So there is nothing to look up — and
    // nothing to lock. This handler runs with interrupts off on the exception
    // stack, and the aspace lock is now held with interrupts ON while a TLB
    // shootdown waits for every cpu's acknowledgement; spinning for it here
    // could leave the holder waiting on this very cpu.
    return cast(i32, 1);
}
