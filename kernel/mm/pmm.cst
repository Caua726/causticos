// pmm.cst — Physical Memory Manager (buddy allocator)
// Based on causticos_pmm_spec_v1

use "serial.cst" as serial;
use "limine.cst" as limine;
use "util.cst" as util;
use "lock.cst" as lock;

// ============================================================
// Constants
// ============================================================

let is i64 as PAGE_SIZE         = 4096;
let is i64 as PAGE_SHIFT        = 12;
let is i32 as NUM_ORDERS        = 11;
let is i32 as MAX_BLOCK_ORDER   = 10;

let is i32 as SECTION_PAGE_SHIFT = 15;
let is i32 as SECTION_PAGE_MASK = 32767;
let is i32 as PAGES_PER_SECTION = 32768;
let is i32 as MAX_SECTIONS      = 32;

let is i32 as PFN_NONE with mut = 0;   // set to -1 (0xFFFFFFFF) in init

// Page states (i32)
let is i32 as PAGE_ABSENT       = 0;
let is i32 as PAGE_FREE         = 1;
let is i32 as PAGE_ALLOCATED    = 2;
let is i32 as PAGE_RESERVED     = 3;

// Page usage (i32)
let is i32 as USAGE_NONE        = 0;
let is i32 as USAGE_KERNEL      = 1;
let is i32 as USAGE_PAGE_TABLE  = 2;
let is i32 as USAGE_KERNEL_HEAP = 3;
let is i32 as USAGE_BOOT_RESERVED = 5;

// frame_meta[pfn] — one u8 per page (1 byte), down from the 12-byte
// PageInfo (12x less resident: ~384KB -> ~32KB in 128MB). The block's
// `order` no longer lives here — a free block carries it in its FreeNode,
// and free_pages takes the freed block's order from its caller — so an
// allocated page needs no order. What remains is what the buddy +
// vmm.validate_pt_page must recover from a pfn:
//   bits [1:0]  state  (ABSENT / FREE / ALLOCATED / RESERVED)
//   bit  [2]    head   (1 = head of a buddy block; 0 = tail)
//   bits [5:3]  usage  (NONE / KERNEL / PAGE_TABLE / KERNEL_HEAP / BOOT_RESERVED)
let is i32 as FM_STATE_SHIFT = 0;
let is i32 as FM_HEAD_SHIFT  = 2;
let is i32 as FM_USAGE_SHIFT = 3;
let is i32 as FM_STATE_MASK  = 3;
let is i32 as FM_USAGE_MASK  = 7;

// Free-list node magic, written into the body of every free page (see
// FreeNode helpers below). A wrong magic on remove means structural
// corruption or a double-free that slipped past the state check. The
// value can't be an i32 literal in global init, so it's set in init().
let is i32 as FREE_MAGIC with mut = 0;

// Single physical address space (zones collapsed in A2a). The only
// remaining low-memory distinction is a per-allocation flag,
// ALLOC_BELOW_4G, for 32-bit DMA — served by preferring blocks whose
// head pfn is below this limit. 4 GiB >> 12 = 1048576; set in init().
let is i32 as PFN_4G_LIMIT with mut = 0;

// Alloc flags
let is i32 as ALLOC_ZERO       = 1;
let is i32 as ALLOC_BELOW_4G   = 2;   // 32-bit DMA: the frame must be < 4 GiB
let is i32 as ALLOC_EMERGENCY  = 8;   // dip into the atomic reserve (IRQ/panic only)

// Reserves over the single free pool (i32 page counts)
let is i32 as min_reserve    with mut = 0;
let is i32 as atomic_reserve with mut = 0;

// Last allocation failure, recorded under the lock on every PFN_NONE
// return, for honest OOM reporting at the call site.
let is i32 as last_fail_order   with mut = 0;
let is i32 as last_fail_flags   with mut = 0;
let is i32 as last_fail_free    with mut = 0;
let is i32 as last_fail_largest with mut = 0;

// IRQ lock state
let is i64 as saved_flags with mut = 0;

// Per-cpu IRQ-context flag lives in smp.PerCpu. Reading it here
// goes through a raw asm stub (smp_in_irq_context → gs:[0x70]) with
// a shuttle scalar because `use "smp.cst"` would close a module
// cycle — smp.cst already depends on pmm.
let is i64 as irq_ctx_shuttle with mut = 0;

// Global PMM lock. The buddy allocator touches per-zone freelists,
// per-pfn bitmaps, the per-zone free counters, and emergency
// reserves — all shared state. With multiple cpus calling
// alloc_pages/free_pages concurrently (via heap.kmalloc, vmm
// table-page allocation, per-thread kstack alloc), concurrent
// updates corrupt the freelist and we take #PF inside
// alloc_pages. acquire_irq pairs with the IRQ paths (AHCI
// harvest allocates nothing today but kept IRQ-safe for future).
let is lock.TicketLock as pmm_lock with mut;

fn irq_context() as i64 {
    asm("call smp_in_irq_context\n");
    asm("lea rbx, [rip+_kernel_mm_pmm_cst_irq_ctx_shuttle]\n");
    asm("mov QWORD PTR [rbx], rax\n");
    return irq_ctx_shuttle;
}

// HHDM offset — physical-to-virtual: virt = phys + hhdm
let is i64 as hhdm with mut = 0;

// Exclusive upper bound on installed physical memory. Set by
// init_sections to max(base + length) across all usable memory-map
// entries. Drivers translating HHDM-mapped pointers back to physical
// addresses use this to sanity-check inputs before handing them to
// hardware (an out-of-range phys would DMA to nowhere or, worse, to
// something accidentally mapped).
let is i64 as phys_end with mut = 0;
// Highest address the memory map mentions AT ALL — usable, reserved,
// bootloader-reclaimable, framebuffer, everything. phys_end above stops at the
// end of usable RAM; this is the bound on what the HHDM actually maps.
let is i64 as phys_top with mut = 0;

fn phys_to_virt(phys as i64) as i64 {
    return phys + hhdm;
}

// True iff `phys` addresses a byte in installed RAM (i.e. could be
// the target of a valid DMA). Callers should check [phys, phys+size)
// entirely — they know the transfer length; this helper is the
// lower-level single-address test.
fn is_phys_valid(phys as i64) as i32 {
    if (phys < 0) { return 0; }
    if (phys >= phys_end) { return 0; }
    return 1;
}

// True iff the HHDM-mapped virtual address `virt` points into
// installed RAM. The two-sided check rejects addresses below the
// HHDM base (user / kvalloc / kernel-image virtuals) and above the
// last physical page.
fn is_hhdm_valid(virt as i64) as i32 {
    if (virt < hhdm) { return 0; }
    if (virt - hhdm >= phys_end) { return 0; }
    return 1;
}

// Is `virt` inside the bootloader's direct map at all?
//
// Distinct from is_hhdm_valid, and the distinction matters: phys_end covers
// only USABLE regions, so is_hhdm_valid answers "is this usable RAM". The HHDM
// also maps everything the memory map calls reserved — which is where the
// bootloader puts the modules it loaded for us (MMAP_KERNEL_AND_MODULES). Asking
// is_hhdm_valid about a module address gets a confident "no" about memory that
// is mapped, present, and holding exactly what we asked the bootloader to load.
fn is_hhdm_mapped(virt as i64) as i32 {
    if (virt < hhdm) { return 0; }
    if (phys_top <= 0) { return 0; }
    if (virt - hhdm >= phys_top) { return 0; }
    return 1;
}

// ============================================================
// frame_meta decode/encode (pure bit ops on a u16-valued i32)
// ============================================================

fn fm_state(m as i32) as i32 {
    return (m >> FM_STATE_SHIFT) & FM_STATE_MASK;
}

fn fm_usage(m as i32) as i32 {
    return (m >> FM_USAGE_SHIFT) & FM_USAGE_MASK;
}

fn fm_head(m as i32) as i32 {
    return (m >> FM_HEAD_SHIFT) & cast(i32, 1);
}

// `order` is accepted for call-site symmetry but NOT stored — it lives in
// the FreeNode (free blocks) / the caller (free_pages). Kept so mark_alloc/
// mark_free/seed need no change.
fn fm_build(state as i32, usage as i32, order as i32, head as i32) as i32 {
    return ((state & FM_STATE_MASK) << FM_STATE_SHIFT)
         | ((head  & cast(i32, 1))  << FM_HEAD_SHIFT)
         | ((usage & FM_USAGE_MASK) << FM_USAGE_SHIFT);
}

// ============================================================
// Section table
// ============================================================

struct MemSection {
    present as i32;
    base_pfn as i32;
    present_pages as i32;
    pad0 as i32;
    pages as i64;       // physical address of frame_meta array (u16/page)
}

// 32 sections * 20 bytes = 640 bytes (pad to 32*24=768 for alignment)
let is [768]u8 as section_table_raw;

fn section_get(idx as i32) as *MemSection {
    let is i64 as off = cast(i64, idx) * 24;
    return cast(*MemSection, cast(i64, &section_table_raw) + off);
}

// ============================================================
// Free lists — one head per order (NUM_ORDERS=11) over the single
// physical address space. Each entry is the head PFN of a doubly-linked
// list whose links live in the page bodies (FreeNode); PFN_NONE = empty.
// ============================================================

let is [11]i32 as free_list_heads;
let is i32 as free_total with mut = 0;

fn fl_get(order as i32) as i32 {
    let is *i32 as heads = cast(*i32, &free_list_heads);
    return heads[cast(i64, order)];
}

fn fl_set(order as i32, pfn as i32) as void {
    let is *i32 as heads = cast(*i32, &free_list_heads);
    heads[cast(i64, order)] = pfn;
}

// Pick a block off the order's list. Without the below-4G constraint,
// that's the LIFO head (O(1)). With it, walk the list for the first
// block whose head pfn is below the limit — an order-aligned block with
// head < PFN_4G_LIMIT lies entirely below 4 GiB. PFN_NONE if none.
fn fl_find(order as i32, below as i32) as i32 {
    let is i32 as head = fl_get(order);
    if (below == cast(i32, 0)) { return head; }
    let is i32 as cur with mut = head;
    while (cur != PFN_NONE) {
        if (cur < PFN_4G_LIMIT) { return cur; }
        cur = fn_next(cur);
    }
    return PFN_NONE;
}

// ============================================================
// Memblock — bootstrap allocator (i64 for addresses)
// ============================================================

let is i64 as MEMBLOCK_MAX = 64;

// Ranges: base(i64) + length(i64) = 16 bytes each, 64 entries = 1024 bytes
let is [1024]u8 as mb_mem_raw;
let is [1024]u8 as mb_res_raw;
let is i64 as mb_mem_count with mut = 0;
let is i64 as mb_res_count with mut = 0;
let is i64 as mb_frozen with mut = 0;

let is i64 as mb_bump with mut = 0;
let is i64 as mb_bump_end with mut = 0;

fn mb_mem_get(idx as i64, field as i64) as i64 {
    let is *i64 as p = cast(*i64, cast(i64, &mb_mem_raw) + idx * 16);
    return p[field];
}

// RAM region introspection — the usable map the PMM took from Limine.
// Exposed read-only so the memory bus (membus.cst) can enumerate RAM as
// nodes in the hardware tree. The memblock list is frozen after init.
fn region_count() as i64 { return mb_mem_count; }
fn region_base(idx as i64) as i64 { return mb_mem_get(idx, 0); }
fn region_len(idx as i64) as i64 { return mb_mem_get(idx, 1); }

// ============================================================
// Kernel memory accounting — honest "where did the RAM go" introspection.
// These walk read-only state already maintained by the allocator; they exist
// so a monitor can show the kernel's own footprint instead of it hiding in the
// gap between physical-used and the sum of process RSS.
// ============================================================

// Total bytes of ALLOCATED pages whose usage tag == `want` (USAGE_PAGE_TABLE,
// USAGE_KERNEL_HEAP, USAGE_KERNEL, ...). One linear pass over the present pfns
// of every section; reads frame_meta only (no lock — frame_meta bytes are
// written atomically per page, and a monitor tolerates a torn snapshot). This
// is the authority for "page tables" and "heap slabs" in the kernel breakdown.
fn usage_pages_bytes(want as i32) as i64 {
    let is i64 as count with mut = 0;
    let is i32 as sid with mut = cast(i32, 0);
    while (sid < MAX_SECTIONS) {
        let is *MemSection as sec = section_get(sid);
        if (sec.present != cast(i32, 0)) {
            let is i32 as bpfn = sec.base_pfn;
            let is i32 as p with mut = cast(i32, 0);
            while (p < PAGES_PER_SECTION) {
                let is i32 as pfn = bpfn + p;
                if (page_present(pfn) != cast(i32, 0)) {
                    let is i32 as m = frame_meta_read(pfn);
                    if (fm_state(m) == PAGE_ALLOCATED) {
                        if (fm_usage(m) == want) { count = count + 1; }
                    }
                }
                p = p + cast(i32, 1);
            }
        }
        sid = sid + cast(i32, 1);
    }
    return count * PAGE_SIZE;
}

// Resident bytes of the frame_meta arrays themselves (1 byte/page over every
// present section). This is the PMM's own fixed overhead — small, but real, and
// it must show up somewhere honest rather than nowhere.
fn frame_meta_bytes() as i64 {
    let is i64 as nsec with mut = 0;
    let is i32 as sid with mut = cast(i32, 0);
    while (sid < MAX_SECTIONS) {
        let is *MemSection as sec = section_get(sid);
        if (sec.present != cast(i32, 0)) { nsec = nsec + 1; }
        sid = sid + cast(i32, 1);
    }
    return nsec * cast(i64, PAGES_PER_SECTION);   // 1 byte/page
}

// Bytes Limine handed us as KERNEL_AND_MODULES (the loaded kernel image: code +
// rodata + data + bss). Recovered from the reserved-memblock ranges, which the
// kernel image is the only contributor to (parse_mmap adds only it as reserved).
fn kernel_image_bytes() as i64 {
    let is i64 as total with mut = 0;
    let is i64 as r with mut = 0;
    while (r < mb_res_count) {
        total = total + mb_res_get(r, 1);
        r = r + 1;
    }
    return total;
}

fn mb_mem_set(idx as i64, base as i64, len as i64) as void {
    let is *i64 as p = cast(*i64, cast(i64, &mb_mem_raw) + idx * 16);
    p[0] = base;
    p[1] = len;
}

fn mb_res_get(idx as i64, field as i64) as i64 {
    let is *i64 as p = cast(*i64, cast(i64, &mb_res_raw) + idx * 16);
    return p[field];
}

fn mb_res_set(idx as i64, base as i64, len as i64) as void {
    let is *i64 as p = cast(*i64, cast(i64, &mb_res_raw) + idx * 16);
    p[0] = base;
    p[1] = len;
}

fn mb_add_mem(base as i64, len as i64) as void {
    if (mb_mem_count < MEMBLOCK_MAX) {
        mb_mem_set(mb_mem_count, base, len);
        mb_mem_count = mb_mem_count + 1;
    }
}

fn mb_add_res(base as i64, len as i64) as void {
    if (mb_res_count < MEMBLOCK_MAX) {
        mb_res_set(mb_res_count, base, len);
        mb_res_count = mb_res_count + 1;
    }
}

fn align_up(addr as i64, align as i64) as i64 {
    return (addr + align - 1) & (0 - align);
}

fn panic(msg as *u8, len as i64) as void {
    // Whatever any cpu was midway through saying is evidence, and serial
    // output is buffered per line — without this the last thing each cpu was
    // writing when the world stopped dies in a buffer nobody flushes.
    serial.flush_all();
    serial.print("PANIC: ", 7);
    serial.println(msg, len);
    serial.flush();
    asm("cli\n");
    while (1 == 1) { asm(".byte 0xF4\n"); }
}

// IRQ save/restore for buddy ops (Bug #2 fix)
fn irq_save() as void {
    // pushfq=0x9C; pop rax; store to global; cli=0xFA
    asm(".byte 0x9C\n");       // pushfq
    asm("pop rax\n");
    asm("lea rbx, [rip+_kernel_mm_pmm_cst_saved_flags]\n");
    asm("mov QWORD PTR [rbx], rax\n");
    asm(".byte 0xFA\n");       // cli
}

fn irq_restore() as void {
    // load from global; push; popfq=0x9D
    asm("lea rbx, [rip+_kernel_mm_pmm_cst_saved_flags]\n");
    asm("mov rax, QWORD PTR [rbx]\n");
    asm("push rax\n");
    asm(".byte 0x9D\n");       // popfq
}

fn mb_alloc(size as i64) as i64 {
    if (mb_frozen != 0) {
        panic("mb_alloc after freeze", 21);
    }

    let is i64 as asize = align_up(size, PAGE_SIZE);

    // Init bump from largest usable region
    if (mb_bump == 0) {
        let is i64 as best_base with mut = 0;
        let is i64 as best_len with mut = 0;
        let is i64 as i with mut = 0;
        while (i < mb_mem_count) {
            let is i64 as len = mb_mem_get(i, 1);
            if (len > best_len) {
                best_base = mb_mem_get(i, 0);
                best_len = len;
            }
            i = i + 1;
        }
        mb_bump = align_up(best_base, PAGE_SIZE);
        mb_bump_end = best_base + best_len;
    }

    // Find non-overlapping slot
    let is i64 as addr with mut = mb_bump;
    let is i64 as found with mut = 0;
    while (found == 0) {
        if (addr + asize > mb_bump_end) {
            panic("mb_alloc OOM", 12);
        }
        let is i64 as overlap with mut = 0;
        let is i64 as r with mut = 0;
        while (r < mb_res_count) {
            let is i64 as rbase = mb_res_get(r, 0);
            let is i64 as rend = rbase + mb_res_get(r, 1);
            if (addr < rend) {
                if (addr + asize > rbase) {
                    addr = align_up(rend, PAGE_SIZE);
                    overlap = 1;
                }
            }
            r = r + 1;
        }
        if (overlap == 0) {
            found = 1;
        }
    }

    // Zero (must use virtual address via HHDM)
    let is *u8 as ptr = cast(*u8, phys_to_virt(addr));
    let is i64 as z with mut = 0;
    while (z < asize) {
        ptr[z] = 0;
        z = z + 1;
    }

    mb_add_res(addr, asize);
    mb_bump = addr + asize;
    return addr;
}

fn mb_freeze() as void {
    mb_frozen = 1;
}

// ============================================================
// Phase A: Parse Limine memory map
// ============================================================

fn parse_mmap() as void {
    if (limine.mmap_req_response == 0) {
        panic("no mmap response", 16);
    }

    let is *limine.LimineMmapResponse as resp = cast(*limine.LimineMmapResponse, limine.mmap_req_response);
    let is i64 as count = resp.entry_count;
    let is *i64 as eptrs = cast(*i64, resp.entries);

    serial.print("mmap: ", 6);
    util.print_num(count);
    serial.println(" entries", 8);

    let is i64 as i with mut = 0;
    while (i < count) {
        let is *limine.LimineMmapEntry as e = cast(*limine.LimineMmapEntry, eptrs[i]);
        let is i64 as base = e.base;
        let is i64 as len = e.length;
        let is i64 as t = e.entry_type;

        serial.print("  ", 2);
        util.print_hex(base);
        serial.print(" +", 2);
        util.print_hex(len);
        serial.print(" t=", 3);
        util.print_num(t);
        serial.println("", 0);

        // Every entry, whatever its type, bounds what the HHDM maps.
        if (base + len > phys_top) { phys_top = base + len; }

        if (t == limine.MMAP_USABLE) {
            mb_add_mem(base, len);
        }
        // NB: BOOTLOADER_RECLAIM is NOT added as usable memory. Limine
        // keeps live data there — at minimum the AP trampoline code and
        // each AP's stack used by its callback — for as long as the
        // kernel keeps any AP alive. Reclaiming those pages into the
        // PMM while APs are still executing causes silent corruption of
        // whatever we later allocated there (observed: LAPIC page-table
        // pages clobbered on -smp 4, producing #PF in lapic_write
        // during sched.init). A later phase that fully migrates APs off
        // Limine-provided stacks can reclaim this region by its own
        // explicit pass.
        if (t == limine.MMAP_KERNEL_AND_MODULES) {
            mb_add_res(base, len);
        }
        i = i + 1;
    }

    serial.print("memblock: ", 10);
    util.print_num(mb_mem_count);
    serial.print(" mem, ", 6);
    util.print_num(mb_res_count);
    serial.println(" res", 4);
}

// ============================================================
// PFN helpers
// ============================================================

fn pfn_to_phys(pfn as i32) as i64 {
    return cast(i64, pfn) << PAGE_SHIFT;
}

fn phys_to_pfn(addr as i64) as i32 {
    return cast(i32, addr >> PAGE_SHIFT);
}

fn frame_meta_ptr(pfn as i32) as *u8 {
    let is i32 as sid = pfn >> SECTION_PAGE_SHIFT;
    if (sid >= MAX_SECTIONS) {
        return cast(*u8, 0);
    }
    let is *MemSection as sec = section_get(sid);
    if (sec.present == cast(i32, 0)) {
        return cast(*u8, 0);
    }
    let is i64 as idx = cast(i64, pfn & SECTION_PAGE_MASK);
    return cast(*u8, phys_to_virt(sec.pages) + idx);
}

fn frame_meta_read(pfn as i32) as i32 {
    let is *u8 as p = frame_meta_ptr(pfn);
    if (cast(i64, p) == 0) { return cast(i32, 0); }   // absent → state ABSENT
    return cast(i32, p[0]);
}

fn frame_meta_write(pfn as i32, v as i32) as void {
    let is *u8 as p = frame_meta_ptr(pfn);
    if (cast(i64, p) != 0) { p[0] = cast(u8, v); }
}

// Per-pfn metadata accessors. These are also the external read API:
// heap.kfree and vmm.validate_pt_page call page_usage(pfn); the buddy
// reads order/state/head off them.
fn page_state(pfn as i32) as i32 { return fm_state(frame_meta_read(pfn)); }
fn page_usage(pfn as i32) as i32 { return fm_usage(frame_meta_read(pfn)); }
fn page_is_head(pfn as i32) as i32 { return fm_head(frame_meta_read(pfn)); }

fn page_set(pfn as i32, state as i32, usage as i32, order as i32, head as i32) as void {
    frame_meta_write(pfn, fm_build(state, usage, order, head));
}

// True iff `pfn` has backing frame_meta (its section is present).
fn page_present(pfn as i32) as i32 {
    if (cast(i64, frame_meta_ptr(pfn)) == 0) { return cast(i32, 0); }
    return cast(i32, 1);
}

// ============================================================
// FreeNode — intrusive free-list links living in the body of a free
// page (next_pfn, prev_pfn, magic, order), reached through the HHDM. A
// free page's body is otherwise unused, so the buddy owns these 16 bytes
// while the page sits on a free list. The block's `order` lives HERE (not
// in frame_meta): coalescing reads the buddy's order off its FreeNode, and
// free_pages takes the freed block's order from its caller — so an
// allocated page need store no order, letting frame_meta be 1 byte. magic
// catches structural corruption / double-free on remove.
// ============================================================

fn freenode(pfn as i32) as *i32 {
    return cast(*i32, phys_to_virt(pfn_to_phys(pfn)));
}

fn fn_next(pfn as i32) as i32 { let is *i32 as p = freenode(pfn); return p[0]; }
fn fn_prev(pfn as i32) as i32 { let is *i32 as p = freenode(pfn); return p[1]; }
fn fn_magic(pfn as i32) as i32 { let is *i32 as p = freenode(pfn); return p[2]; }
fn fn_order(pfn as i32) as i32 { let is *i32 as p = freenode(pfn); return p[3]; }
fn fn_set_next(pfn as i32, v as i32) as void { let is *i32 as p = freenode(pfn); p[0] = v; }
fn fn_set_prev(pfn as i32, v as i32) as void { let is *i32 as p = freenode(pfn); p[1] = v; }
fn fn_set_magic(pfn as i32, v as i32) as void { let is *i32 as p = freenode(pfn); p[2] = v; }
fn fn_set_order(pfn as i32, v as i32) as void { let is *i32 as p = freenode(pfn); p[3] = v; }

fn freenode_ok(pfn as i32) as i32 {
    if (fn_magic(pfn) != FREE_MAGIC) { return cast(i32, 0); }
    return cast(i32, 1);
}


// ============================================================
// Phase B+C: Create sections
// ============================================================

fn init_sections() as void {
    // Zero section table
    let is *u8 as st = cast(*u8, &section_table_raw);
    let is i64 as z with mut = 0;
    while (z < 768) {
        st[z] = 0;
        z = z + 1;
    }

    let is i64 as i with mut = 0;
    while (i < mb_mem_count) {
        let is i64 as base = mb_mem_get(i, 0);
        let is i64 as end = base + mb_mem_get(i, 1);
        if (end > phys_end) { phys_end = end; }
        let is i32 as start_pfn = phys_to_pfn(base);
        let is i32 as end_pfn = phys_to_pfn(align_up(end, PAGE_SIZE));

        let is i32 as pfn with mut = start_pfn;
        while (pfn < end_pfn) {
            let is i32 as sid = pfn >> SECTION_PAGE_SHIFT;
            if (sid < MAX_SECTIONS) {
                let is *MemSection as sec = section_get(sid);
                if (sec.present == cast(i32, 0)) {
                    let is i64 as pi_size = cast(i64, PAGES_PER_SECTION);   // 1 byte/page
                    let is i64 as pi_addr = mb_alloc(pi_size);
                    sec.present = cast(i32, 1);
                    sec.base_pfn = sid << SECTION_PAGE_SHIFT;
                    sec.present_pages = cast(i32, 0);
                    sec.pages = pi_addr;

                    serial.print("section ", 8);
                    util.print_num(cast(i64, sid));
                    serial.print(": pages@", 8);
                    util.print_hex(pi_addr);
                    serial.println("", 0);
                }
            }
            pfn = ((pfn >> SECTION_PAGE_SHIFT) + cast(i32, 1)) << SECTION_PAGE_SHIFT;
        }
        i = i + 1;
    }
}

// ============================================================
// Phase D: Mark frame_meta entries
// ============================================================

fn addr_in_reserved(phys as i64) as i32 {
    let is i64 as r with mut = 0;
    while (r < mb_res_count) {
        let is i64 as rbase = mb_res_get(r, 0);
        let is i64 as rend = rbase + mb_res_get(r, 1);
        if (phys >= rbase) {
            if (phys < rend) {
                return cast(i32, 1);
            }
        }
        r = r + 1;
    }
    return cast(i32, 0);
}

fn addr_in_usable(phys as i64) as i32 {
    let is i64 as m with mut = 0;
    while (m < mb_mem_count) {
        let is i64 as mbase = mb_mem_get(m, 0);
        let is i64 as mend = mbase + mb_mem_get(m, 1);
        if (phys >= mbase) {
            if (phys < mend) {
                return cast(i32, 1);
            }
        }
        m = m + 1;
    }
    return cast(i32, 0);
}

let is i64 as stat_free with mut = 0;
let is i64 as stat_reserved with mut = 0;

fn init_pageinfo() as void {
    let is i64 as free_n with mut = 0;
    let is i64 as res_n with mut = 0;

    let is i32 as sid with mut = 0;
    while (sid < MAX_SECTIONS) {
        let is *MemSection as sec = section_get(sid);
        if (sec.present != cast(i32, 0)) {
            let is i32 as bpfn = sec.base_pfn;
            let is i32 as ppages with mut = 0;

            let is i32 as p with mut = 0;
            while (p < PAGES_PER_SECTION) {
                let is i32 as pfn = bpfn + p;
                let is i64 as phys = pfn_to_phys(pfn);

                if (page_present(pfn) != cast(i32, 0)) {
                    if (addr_in_usable(phys) != cast(i32, 0)) {
                        ppages = ppages + cast(i32, 1);
                        if (addr_in_reserved(phys) != cast(i32, 0)) {
                            page_set(pfn, PAGE_RESERVED, USAGE_BOOT_RESERVED, cast(i32, 0), cast(i32, 0));
                            res_n = res_n + 1;
                        } else {
                            page_set(pfn, PAGE_FREE, USAGE_NONE, cast(i32, 0), cast(i32, 1));
                            free_n = free_n + 1;
                        }
                    }
                }
                p = p + cast(i32, 1);
            }
            sec.present_pages = ppages;
        }
        sid = sid + cast(i32, 1);
    }

    stat_free = free_n;
    stat_reserved = res_n;
    serial.print("pages: ", 7);
    util.print_num(free_n);
    serial.print(" free, ", 7);
    util.print_num(res_n);
    serial.println(" reserved", 9);
}

// ============================================================
// Free list operations
// ============================================================

fn insert_free(order as i32, pfn as i32) as void {
    let is i32 as old = fl_get(order);
    fn_set_next(pfn, old);
    fn_set_prev(pfn, PFN_NONE);
    fn_set_magic(pfn, FREE_MAGIC);
    fn_set_order(pfn, order);   // block order lives in the FreeNode (not frame_meta)
    if (old != PFN_NONE) {
        fn_set_prev(old, pfn);
    }
    fl_set(order, pfn);
}

fn remove_free(order as i32, pfn as i32) as void {
    // Structural integrity: a page on a free list must carry the magic.
    // A miss means corruption or a double-free that reached the list.
    if (freenode_ok(pfn) == cast(i32, 0)) {
        panic("freelist corrupt", 16);
    }
    let is i32 as nxt = fn_next(pfn);
    let is i32 as prv = fn_prev(pfn);
    if (prv != PFN_NONE) {
        fn_set_next(prv, nxt);
    } else {
        fl_set(order, nxt);
    }
    if (nxt != PFN_NONE) {
        fn_set_prev(nxt, prv);
    }
    // Clear magic so the (now-allocated) page can't masquerade as listed.
    fn_set_magic(pfn, cast(i32, 0));
}

// ============================================================
// Block marking
// ============================================================

fn mark_free(hpfn as i32, order as i32) as void {
    page_set(hpfn, PAGE_FREE, USAGE_NONE, order, cast(i32, 1));
    if (order > cast(i32, 0)) {
        let is i32 as cnt = cast(i32, 1) << order;
        let is i32 as i with mut = cast(i32, 1);
        while (i < cnt) {
            page_set(hpfn + i, PAGE_FREE, USAGE_NONE, cast(i32, 0), cast(i32, 0));
            i = i + cast(i32, 1);
        }
    }
}

// A1's 2-byte frame_meta drops refcount/owner — each subsystem owns
// what it allocated; refcount/owner return with CoW later. alloc_pages
// keeps its `owner` parameter (stable public API) but no longer threads
// it down here.
fn mark_alloc(hpfn as i32, order as i32, usage as i32) as void {
    page_set(hpfn, PAGE_ALLOCATED, usage, order, cast(i32, 1));
    if (order > cast(i32, 0)) {
        let is i32 as cnt = cast(i32, 1) << order;
        let is i32 as i with mut = cast(i32, 1);
        while (i < cnt) {
            page_set(hpfn + i, PAGE_ALLOCATED, usage, cast(i32, 0), cast(i32, 0));
            i = i + cast(i32, 1);
        }
    }
}

// ============================================================
// Phase E: Seed buddy
// ============================================================

fn ctz(val as i32) as i32 {
    if (val == cast(i32, 0)) { return cast(i32, 32); }
    let is i32 as n with mut = 0;
    let is i32 as v with mut = val;
    while ((v & cast(i32, 1)) == cast(i32, 0)) {
        n = n + cast(i32, 1);
        v = v >> cast(i32, 1);
    }
    return n;
}

fn floor_log2(val as i32) as i32 {
    if (val <= cast(i32, 0)) { return cast(i32, 0); }
    let is i32 as n with mut = 0;
    let is i32 as v with mut = val >> cast(i32, 1);
    while (v > cast(i32, 0)) {
        n = n + cast(i32, 1);
        v = v >> cast(i32, 1);
    }
    return n;
}

fn min3(a as i32, b as i32, c as i32) as i32 {
    let is i32 as m with mut = a;
    if (b < m) { m = b; }
    if (c < m) { m = c; }
    return m;
}

fn seed_range(start as i32, end as i32) as void {
    let is i32 as pfn with mut = start;

    while (pfn < end) {
        let is i32 as left = end - pfn;
        let is i32 as ord = min3(floor_log2(left), ctz(pfn), MAX_BLOCK_ORDER);
        let is i32 as bsize = cast(i32, 1) << ord;

        // Defensive check — all pages in block must be PAGE_FREE
        let is i32 as ok with mut = cast(i32, 1);
        let is i32 as chk with mut = 0;
        while (chk < bsize) {
            if (page_present(pfn + chk) == cast(i32, 0)) {
                ok = cast(i32, 0);
                chk = bsize;
            } else {
                if (page_state(pfn + chk) != PAGE_FREE) {
                    ok = cast(i32, 0);
                    chk = bsize;
                }
            }
            chk = chk + cast(i32, 1);
        }

        if (ok != cast(i32, 0)) {
            mark_free(pfn, ord);
            insert_free(ord, pfn);
            free_total = free_total + bsize;
        }
        pfn = pfn + bsize;
    }
}

fn seed_buddy() as void {
    // Init free lists to PFN_NONE
    let is *i32 as heads = cast(*i32, &free_list_heads);
    let is i64 as i with mut = 0;
    while (i < cast(i64, NUM_ORDERS)) {
        heads[i] = PFN_NONE;
        i = i + 1;
    }
    free_total = cast(i32, 0);

    serial.println("seeding buddy:", 14);

    // Scan sections for contiguous free runs. With zones gone there is no
    // boundary split — each run is seeded as one span over the single space.
    let is i32 as sid with mut = 0;
    while (sid < MAX_SECTIONS) {
        let is *MemSection as sec = section_get(sid);
        if (sec.present != cast(i32, 0)) {
            let is i32 as bpfn = sec.base_pfn;
            let is i32 as run with mut = PFN_NONE;

            let is i32 as p with mut = 0;
            while (p < PAGES_PER_SECTION) {
                let is i32 as pfn = bpfn + p;
                let is i32 as st = page_state(pfn);

                if (st == PAGE_FREE) {
                    if (run == PFN_NONE) {
                        run = pfn;
                    }
                } else {
                    if (run != PFN_NONE) {
                        seed_range(run, pfn);
                        run = PFN_NONE;
                    }
                }
                p = p + cast(i32, 1);
            }
            if (run != PFN_NONE) {
                let is i32 as ep = bpfn + PAGES_PER_SECTION;
                seed_range(run, ep);
            }
        }
        sid = sid + cast(i32, 1);
    }

    serial.print("  seeded ", 9);
    util.print_num(cast(i64, free_total));
    serial.println(" pages total", 12);
}

// Merge optimization: when absorbed buddy is upper, only rewrite
// the absorbed half's pages as tails. Existing tails are already correct.
fn extend_free_up(hpfn as i32, old_order as i32) as void {
    let is i32 as new_order = old_order + cast(i32, 1);
    // Update head's order
    page_set(hpfn, PAGE_FREE, USAGE_NONE, new_order, cast(i32, 1));
    // Mark only the absorbed upper half as tails
    let is i32 as buddy_start = hpfn + (cast(i32, 1) << old_order);
    let is i32 as count = cast(i32, 1) << old_order;
    let is i32 as i with mut = 0;
    while (i < count) {
        page_set(buddy_start + i, PAGE_FREE, USAGE_NONE, cast(i32, 0), cast(i32, 0));
        i = i + cast(i32, 1);
    }
}

// ============================================================
// Merge check
// ============================================================

fn can_merge(bpfn as i32, order as i32) as i32 {
    if (page_present(bpfn) == cast(i32, 0)) { return cast(i32, 0); }
    let is i32 as m = frame_meta_read(bpfn);
    if (fm_state(m) != PAGE_FREE) { return cast(i32, 0); }
    if (fm_head(m) == cast(i32, 0)) { return cast(i32, 0); }
    // A free head carries its order in its FreeNode (not frame_meta).
    if (fn_order(bpfn) != order) { return cast(i32, 0); }
    return cast(i32, 1);
}

// ============================================================
// Allocation
// ============================================================

// Budget check with reserves over the single free pool.
fn has_budget(flags as i32, need as i32) as i32 {
    let is i32 as avail with mut = free_total - min_reserve;
    if ((flags & ALLOC_EMERGENCY) != cast(i32, 0)) {
        avail = avail + atomic_reserve;
    }
    if (avail >= need) {
        return cast(i32, 1);
    }
    return cast(i32, 0);
}

// Record why an allocation failed, for honest reporting at the call site.
// Called under pmm_lock so free_total / the free lists are consistent.
fn record_fail(order as i32, flags as i32) as void {
    last_fail_order = order;
    last_fail_flags = flags;
    last_fail_free = free_total;
    let is i32 as largest with mut = cast(i32, 0 - 1);
    let is i32 as o with mut = MAX_BLOCK_ORDER;
    while (o >= cast(i32, 0)) {
        if (fl_get(o) != PFN_NONE) {
            largest = o;
            o = cast(i32, 0 - 1);
        }
        o = o - cast(i32, 1);
    }
    last_fail_largest = largest;
}

// owner is kept for API stability; A1 dropped per-page owner tracking
// (it returns with refcount/CoW later), so it is not threaded down here.
// ============================================================
// Pre-zeroed frame pool. A small cache of order-0 frames already wiped during
// idle time, so a commit's ALLOC_ZERO doesn't pay the per-page zeroing burst
// inline. Pooled frames are buddy-ALLOCATED (off the free list) but counted as
// available in free_total — the buddy-alloc decrement is cancelled by a +1 when
// pooled, so free_total = (buddy free) + (pool), and the budget pre-check stays
// honest. The idle loop calls pzero_refill_one; alloc_pages serves from here
// first for normal-zone order-0 zero allocs.
// ============================================================
let is i32 as PZERO_CAP = 64;            // 256 KiB cap
let is [64]i32 as pzero_pool;
let is i32 as pzero_count with mut = cast(i32, 0);

// Pop a pre-zeroed frame, re-tagged with the caller's usage, or PFN_NONE.
fn pzero_get(usage as i32) as i32 {
    let is i64 as pflags = lock.acquire_irq(&pmm_lock);
    if (pzero_count <= cast(i32, 0)) {
        lock.release_irq(&pmm_lock, pflags);
        return PFN_NONE;
    }
    pzero_count = pzero_count - cast(i32, 1);
    let is i32 as pfn = pzero_pool[pzero_count];
    free_total = free_total - cast(i32, 1);          // now truly used
    mark_alloc(pfn, cast(i32, 0), usage);            // re-tag usage (already alloc'd + zeroed)
    lock.release_irq(&pmm_lock, pflags);
    return pfn;
}

// Add one freshly-zeroed frame to the pool (called from the idle loop). Returns
// 1 if it added one, 0 if the pool is full or out of memory.
fn pzero_refill_one() as i32 {
    let is i64 as pf0 = lock.acquire_irq(&pmm_lock);
    let is i32 as full0 with mut = cast(i32, 0);
    if (pzero_count >= PZERO_CAP) { full0 = cast(i32, 1); }
    lock.release_irq(&pmm_lock, pf0);
    if (full0 != cast(i32, 0)) { return cast(i32, 0); }

    // Allocate a frame WITHOUT zeroing (buddy path decrements free_total).
    let is i32 as pfn = alloc_pages(cast(i32, 0), cast(i32, 0), USAGE_KERNEL, cast(i32, 0));
    if (pfn == PFN_NONE) { return cast(i32, 0); }
    let is i64 as ptr = phys_to_virt(pfn_to_phys(pfn));
    let is *u8 as zp = cast(*u8, ptr);
    let is i64 as zz with mut = 0;
    while (zz < PAGE_SIZE) { zp[zz] = cast(u8, 0); zz = zz + 1; }

    let is i64 as pflags = lock.acquire_irq(&pmm_lock);
    let is i32 as full1 with mut = cast(i32, 0);
    if (pzero_count >= PZERO_CAP) { full1 = cast(i32, 1); }
    else {
        pzero_pool[pzero_count] = pfn;
        pzero_count = pzero_count + cast(i32, 1);
        free_total = free_total + cast(i32, 1);      // count as available again
    }
    lock.release_irq(&pmm_lock, pflags);
    if (full1 != cast(i32, 0)) { free_pages(pfn, cast(i32, 0)); return cast(i32, 0); }  // race: pool filled
    return cast(i32, 1);
}

fn alloc_pages(flags as i32, order as i32, usage as i32, owner as i32) as i32 {
    if (order > MAX_BLOCK_ORDER) { return PFN_NONE; }

    // Fast path: a pre-zeroed order-0 frame for a normal-zone ALLOC_ZERO (the
    // common commit/back-page case). Skips the inline per-page wipe.
    if (order == cast(i32, 0)) {
        if ((flags & ALLOC_ZERO) != cast(i32, 0)) {
            if ((flags & ALLOC_BELOW_4G) == cast(i32, 0)) {
                let is i32 as pooled = pzero_get(usage);
                if (pooled != PFN_NONE) { return pooled; }
            }
        }
    }

    // ALLOC_EMERGENCY enforcement: panic if used outside permitted context
    if ((flags & ALLOC_EMERGENCY) != cast(i32, 0)) {
        if (irq_context() == 0) {
            panic("ALLOC_EMERGENCY outside IRQ/panic context", 41);
        }
    }

    let is i32 as below = flags & ALLOC_BELOW_4G;
    let is i32 as need = cast(i32, 1) << order;

    // Serialise the buddy allocator under pmm_lock. acquire_irq grabs the
    // lock AND saves RFLAGS on this stack frame (no shared saved_flags
    // slot), so concurrent cpus neither corrupt the freelist nor mis-
    // restore IF on exit.
    let is i64 as pflags = lock.acquire_irq(&pmm_lock);

    if (has_budget(flags, need) != cast(i32, 0)) {
        // Smallest order >= requested that has a block satisfying `below`.
        let is i32 as fo with mut = cast(i32, 0 - 1);
        let is i32 as pfn with mut = PFN_NONE;
        let is i32 as so with mut = order;
        while (so <= MAX_BLOCK_ORDER) {
            let is i32 as cand = fl_find(so, below);
            if (cand != PFN_NONE) {
                fo = so;
                pfn = cand;
                so = MAX_BLOCK_ORDER + cast(i32, 1);
            }
            so = so + cast(i32, 1);
        }

        if (fo >= cast(i32, 0)) {
            remove_free(fo, pfn);

            // Split down to the requested order. Sub-blocks stay below 4G
            // if the parent was (blocks are order-aligned), so the served
            // pfn keeps the below-4G guarantee.
            let is i32 as co with mut = fo;
            while (co > order) {
                co = co - cast(i32, 1);
                let is i32 as upper = pfn + (cast(i32, 1) << co);
                mark_free(upper, co);
                insert_free(co, upper);
            }

            mark_alloc(pfn, order, usage);
            free_total = free_total - need;

            lock.release_irq(&pmm_lock, pflags);

            // Zero OUTSIDE lock (spec section 16.1)
            if ((flags & ALLOC_ZERO) != cast(i32, 0)) {
                let is i64 as phys = pfn_to_phys(pfn);
                let is *u8 as ptr = cast(*u8, phys_to_virt(phys));
                let is i64 as zlen = cast(i64, need) << PAGE_SHIFT;
                let is i64 as zz with mut = 0;
                while (zz < zlen) {
                    ptr[zz] = 0;
                    zz = zz + 1;
                }
            }

            return pfn;
        }
    }

    // OOM (or no below-4G block of sufficient order): honest failure.
    record_fail(order, flags);
    lock.release_irq(&pmm_lock, pflags);
    return PFN_NONE;
}

// ============================================================
// Free with merge
// ============================================================

fn merge_insert(pfn as i32, order as i32) as void {
    let is i32 as cp with mut = pfn;
    let is i32 as co with mut = order;
    let is i32 as merging with mut = cast(i32, 1);

    while (merging != cast(i32, 0)) {
        if (co >= MAX_BLOCK_ORDER) {
            merging = cast(i32, 0);
        } else {
            let is i32 as buddy = cp ^ (cast(i32, 1) << co);
            if (can_merge(buddy, co) == cast(i32, 0)) {
                merging = cast(i32, 0);
            } else {
                remove_free(co, buddy);
                if (buddy < cp) {
                    // Absorbed buddy is LOWER — head moves down
                    // Must rewrite all tails because head_pfn changed
                    cp = buddy;
                    co = co + cast(i32, 1);
                    mark_free(cp, co);
                } else {
                    // Absorbed buddy is UPPER — head stays same
                    // Only rewrite the absorbed half (optimization)
                    extend_free_up(cp, co);
                    co = co + cast(i32, 1);
                }
            }
        }
    }

    insert_free(co, cp);
}

// `order` is supplied by the caller (the allocator no longer stores a freed
// page's order in frame_meta). The caller allocated the block, so it knows
// the order — directly (constant), from a tracking field, or from a table.
fn free_pages(pfn as i32, order as i32) as void {
    if (page_present(pfn) == cast(i32, 0)) { panic("free: bad pfn", 13); }
    let is i32 as m = frame_meta_read(pfn);
    // Double-free guard: a previously freed page is FREE, not ALLOCATED,
    // so this catches it (the freelist magic in remove_free catches the
    // structural variant). The old refcount!=1 panic is gone with aux0.
    if (fm_state(m) != PAGE_ALLOCATED) { panic("free: not alloc", 15); }
    if (fm_head(m) == cast(i32, 0)) { panic("free: not head", 14); }

    let is i64 as pflags = lock.acquire_irq(&pmm_lock);

    mark_free(pfn, order);
    free_total = free_total + (cast(i32, 1) << order);
    merge_insert(pfn, order);

    lock.release_irq(&pmm_lock, pflags);
}

// ============================================================
// Buddy self-test — run once at boot, after init(). Single-threaded
// (APs and the scheduler aren't up yet), so pmm_lock is uncontended.
// Exercises the new frame_meta + intrusive free-list end to end and
// returns the pool to its exact baseline (frees everything it takes).
// ============================================================

fn buddy_selftest() as void {
    serial.println("pmm.selftest: buddy", 19);

    let is i64 as base_total = cast(i64, free_total);
    let is i32 as fl = cast(i32, 0);

    // 1. Allocate blocks of varied orders.
    let is i32 as p0  = alloc_pages(fl, cast(i32, 0),  USAGE_KERNEL, cast(i32, 0));
    let is i32 as p1  = alloc_pages(fl, cast(i32, 1),  USAGE_KERNEL, cast(i32, 0));
    let is i32 as p2  = alloc_pages(fl, cast(i32, 2),  USAGE_KERNEL, cast(i32, 0));
    let is i32 as p5  = alloc_pages(fl, cast(i32, 5),  USAGE_KERNEL, cast(i32, 0));
    let is i32 as p10 = alloc_pages(fl, cast(i32, 10), USAGE_KERNEL, cast(i32, 0));
    if (p0  == PFN_NONE) { panic("selftest: alloc o0", 18); }
    if (p1  == PFN_NONE) { panic("selftest: alloc o1", 18); }
    if (p2  == PFN_NONE) { panic("selftest: alloc o2", 18); }
    if (p5  == PFN_NONE) { panic("selftest: alloc o5", 18); }
    if (p10 == PFN_NONE) { panic("selftest: alloc o10", 19); }

    // 2. Metadata round-trips through frame_meta (order is no longer stored
    //    on an allocated page — it's the caller's to track now).
    if (page_state(p5)  != PAGE_ALLOCATED)  { panic("selftest: state rt", 18); }
    if (page_is_head(p5) == cast(i32, 0))   { panic("selftest: head rt", 17); }
    if (page_usage(p5)  != USAGE_KERNEL)    { panic("selftest: usage rt", 18); }
    if (page_is_head(p5 + cast(i32, 1)) != cast(i32, 0)) { panic("selftest: tail head", 19); }

    // 3. Free in mixed order; no page may leak (the pool total returns
    //    to baseline once everything is freed and coalesced).
    free_pages(p5, cast(i32, 5));
    free_pages(p1, cast(i32, 1));
    free_pages(p10, cast(i32, 10));
    free_pages(p2, cast(i32, 2));
    free_pages(p0, cast(i32, 0));
    let is i64 as after_total = cast(i64, free_total);
    if (after_total != base_total) { panic("selftest: leak", 14); }

    // 4. Coalescing proof (deterministic): an order-10 block, once freed,
    //    is a coherent order-10 free block (it can't coalesce past the
    //    max order) sitting at the LIFO head, so re-allocating order 10
    //    returns the same pfn. A broken free/merge would not reproduce it.
    let is i32 as g = alloc_pages(fl, cast(i32, 10), USAGE_KERNEL, cast(i32, 0));
    if (g == PFN_NONE) { panic("selftest: alloc g", 17); }
    free_pages(g, cast(i32, 10));
    if (page_state(g) != PAGE_FREE)      { panic("selftest: g not free", 20); }
    if (fn_order(g) != cast(i32, 10))    { panic("selftest: g order", 17); }
    if (page_is_head(g) == cast(i32, 0)) { panic("selftest: g head", 16); }
    let is i32 as g2 = alloc_pages(fl, cast(i32, 10), USAGE_KERNEL, cast(i32, 0));
    if (g2 != g) { panic("selftest: g2!=g (coalesce)", 26); }

    // 5. Double-free / corruption detection, in isolation. We do NOT
    //    call free_pages twice (the real guard panics, which halts by
    //    design) — we verify the exact conditions those guards test:
    //    (a) state guard — after one free, the page is FREE not ALLOCATED,
    //        so a second free_pages() would trip "free: not alloc".
    free_pages(g2, cast(i32, 10));
    if (page_state(g2) == PAGE_ALLOCATED) { panic("selftest: dfree guard", 21); }
    //    (b) freelist magic — g2 is now a free-list head, body carries
    //        FREE_MAGIC. freenode_ok is the same predicate remove_free
    //        uses; corrupt it, confirm it's flagged, then restore so the
    //        allocator state stays consistent.
    if (freenode_ok(g2) == cast(i32, 0)) { panic("selftest: magic absent", 22); }
    fn_set_magic(g2, cast(i32, 0));
    if (freenode_ok(g2) != cast(i32, 0)) { panic("selftest: magic false-ok", 24); }
    fn_set_magic(g2, FREE_MAGIC);
    if (freenode_ok(g2) == cast(i32, 0)) { panic("selftest: magic false-bad", 25); }

    // 6. below-4G path: in 128MB every frame qualifies; confirm the flag
    //    returns a frame under the limit (fl_find), then free it back.
    let is i32 as b = alloc_pages(ALLOC_BELOW_4G | ALLOC_ZERO, cast(i32, 0), USAGE_KERNEL, cast(i32, 0));
    if (b == PFN_NONE) { panic("selftest: below4g alloc", 23); }
    if (b >= PFN_4G_LIMIT) { panic("selftest: below4g range", 23); }
    free_pages(b, cast(i32, 0));

    // Nothing left allocated; pool back to baseline.
    let is i64 as final_total = cast(i64, free_total);
    if (final_total != base_total) { panic("selftest: final leak", 20); }

    // Footprint: frame_meta (2 B/page) vs the old 12-byte PageInfo.
    let is i32 as nsec with mut = 0;
    let is i32 as sid with mut = 0;
    while (sid < MAX_SECTIONS) {
        let is *MemSection as sec = section_get(sid);
        if (sec.present != cast(i32, 0)) { nsec = nsec + cast(i32, 1); }
        sid = sid + cast(i32, 1);
    }
    let is i64 as fm_bytes = cast(i64, nsec) * cast(i64, PAGES_PER_SECTION);
    let is i64 as pi_bytes = cast(i64, nsec) * cast(i64, PAGES_PER_SECTION) * 12;
    serial.print("pmm.selftest: frame_meta=", 25);
    util.print_num(fm_bytes);
    serial.print(" B (PageInfo was ", 17);
    util.print_num(pi_bytes);
    serial.println(" B)", 3);
    serial.println("pmm.selftest: buddy PASS", 24);
}

// Pre-zeroed pool: refill a few frames, confirm an ALLOC_ZERO order-0 alloc is
// served from the pool (count drops) and is zeroed, then drain and confirm
// free_total round-tripped (pooled frames count as available throughout).
fn pzero_smoke() as void {
    serial.println("pmm.pzero_smoke: start", 22);
    let is i32 as ok with mut = cast(i32, 1);
    let is i32 as base = free_total;

    let is i32 as i with mut = cast(i32, 0);
    while (i < cast(i32, 4)) { pzero_refill_one(); i = i + cast(i32, 1); }
    if (pzero_count < cast(i32, 1)) { ok = cast(i32, 0); }
    let is i32 as cnt_before = pzero_count;

    let is i32 as got = alloc_pages(ALLOC_ZERO, cast(i32, 0), USAGE_KERNEL, cast(i32, 0));
    if (got == PFN_NONE) { ok = cast(i32, 0); }
    if (pzero_count != cnt_before - cast(i32, 1)) { ok = cast(i32, 0); }   // served from the pool
    let is *i64 as zp = cast(*i64, phys_to_virt(pfn_to_phys(got)));
    if (zp[0] != 0) { ok = cast(i32, 0); }
    if (zp[511] != 0) { ok = cast(i32, 0); }                                // last qword of the page
    free_pages(got, cast(i32, 0));

    while (pzero_count > cast(i32, 0)) {
        let is i32 as p = pzero_get(USAGE_KERNEL);
        if (p == PFN_NONE) { pzero_count = cast(i32, 0); }
        else { free_pages(p, cast(i32, 0)); }
    }
    if (free_total != base) { ok = cast(i32, 0); }

    if (ok != cast(i32, 0)) { serial.println("pmm.pzero_smoke: PASS", 21); }
    else { panic("pmm.pzero_smoke FAIL", 20); }
}

// ============================================================
// Init
// ============================================================

fn init() as void {
    // Init constants that can't use expressions in global scope
    PFN_NONE = cast(i32, 0 - 1);
    PFN_4G_LIMIT = cast(i32, 1048576);   // 4 GiB >> 12
    // FreeNode magic (0xF2EE600D, "free good"). Set before seed_buddy
    // writes any free page's body via insert_free.
    FREE_MAGIC = cast(i32, 0xF2EE600D);

    // Get HHDM offset from Limine
    if (limine.hhdm_req_response == 0) {
        panic("no hhdm response", 16);
    }
    let is *limine.LimineHhdmResponse as hresp = cast(*limine.LimineHhdmResponse, limine.hhdm_req_response);
    hhdm = hresp.offset;
    serial.print("hhdm: ", 6);
    util.print_hex(hhdm);
    serial.println("", 0);

    serial.println("pmm: init", 9);
    parse_mmap();
    init_sections();
    init_pageinfo();
    seed_buddy();
    mb_freeze();

    // Reserves over the single free pool (~0.8%, min 16 pages).
    let is i32 as res with mut = free_total >> cast(i32, 7);
    if (res < cast(i32, 16)) {
        res = cast(i32, 16);
    }
    if (res > free_total) {
        res = cast(i32, 0);
    }
    min_reserve = res;
    atomic_reserve = res >> cast(i32, 2);  // 1/4 of min

    serial.println("pmm: ready", 10);
}
